_programs\":null,\"background\":false,\"completed_at\":1793776374,\"error\":null,\"frequency_penalty\":0.0,\"image\":{\"context_compression\":\"disabled\"},\"incomplete_details\":null,\"instructions\":\"You\n+        are Records clerk. You never guess a code.\\nYour personal goal is: Report\n+        access codes exactly as the lookup tool returns them\",\"max_output_tokens\":null,\"max_tool_calls\":null,\"model\":\"gpt-6.1-sol\",\"moderation\":null,\"output\":[{\"id\":\"msg_01f089916ba916d7016aeadaf6b46887d09c2ac0062265abd9\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"VEGA-ZETA-7741\"}],\"phase\":\"final_answer\",\"role\":\"assistant\"}],\"parallel_tool_calls\":true,\"presence_penalty\":0.0,\"previous_response_id\":null,\"prompt_cache_key\":null,\"prompt_cache_retention\":\"24h\",\"reasoning\":{\"context\":\"all_turns\",\"effort\":\"medium\",\"mode\":\"standard\",\"summary\":null},\"safety_identifier\":null,\"service_tier\":\"default\",\"store\":false,\"temperature\":1.0,\"text\":{\"format\":{\"type\":\"text\"},\"verbosity\":\"medium\"},\"tool_choice\":\"auto\",\"tool_usage\":{\"image_gen\":{\"input_tokens\":0,\"input_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"output_tokens\":0,\"output_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"total_tokens\":0},\"web_search\":{\"num_requests\":0}},\"tools\":[{\"type\":\"function\",\"description\":\"Look\n+        up the access code for a project by name.\",\"name\":\"lookup_code\",\"output_schema\":null,\"parameters\":{\"properties\":{\"name\":{\"title\":\"Name\",\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\",\"additionalProperties\":false},\"strict\":true}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":{\"input_tokens\":172,\"input_tokens_details\":{\"cache_write_tokens\":0,\"cached_tokens\":0},\"output_tokens\":11,\"output_tokens_details\":{\"reasoning_tokens\":0},\"total_tokens\":183},\"user\":null,\"metadata\":{}},\"sequence_number\":14}\n+\n+\n+        '\n+    headers:\n+      access-control-expose-headers:\n+      - ACCESS-CONTROL-XXX\n+      alt-svc:\n+      - h3=\":443\"; ma=86400\n+      cf-cache-status:\n+      - DYNAMIC\n+      cf-ray:\n+      - CF-RAY-XXX\n+      connection:\n+      - keep-alive\n+      content-type:\n+      - text/event-stream; charset=utf-8\n+      date:\n+      - Wed, 04 Nov 2026 07:12:53 GMT\n+      openai-organization:\n+      - OPENAI-ORG-XXX\n+      openai-processing-ms:\n+      - '237'\n+      openai-project:\n+      - OPENAI-PROJECT-XXX\n+      openai-version:\n+      - '2020-10-01'\n+      server:\n+      - cloudflare\n+      strict-transport-security:\n+      - STS-XXX\n+      transfer-encoding:\n+      - chunked\n+      x-content-type-options:\n+      - X-CONTENT-TYPE-XXX\n+      x-ratelimit-limit-requests:\n+      - X-RATELIMIT-LIMIT-REQUESTS-XXX\n+      x-ratelimit-limit-tokens:\n+      - X-RATELIMIT-LIMIT-TOKENS-XXX\n+      x-ratelimit-remaining-requests:\n+      - X-RATELIMIT-REMAINING-REQUESTS-XXX\n+      x-ratelimit-remaining-tokens:\n+      - X-RATELIMIT-REMAINING-TOKENS-XXX\n+      x-ratelimit-reset-requests:\n+      - X-RATELIMIT-RESET-REQUESTS-XXX\n+      x-ratelimit-reset-tokens:\n+      - X-RATELIMIT-RESET-TOKENS-XXX\n+      x-request-id:\n+      - X-REQUEST-ID-XXX\n+    status:\n+      code: 200\n+      message: OK\n+version: 1\ndiff --git a/lib/crewai/tests/llms/openai/test_responses_only_models.py b/lib/crewai/tests/llms/openai/test_responses_only_models.py\nindex b46d5d7874..fce85b2ec0 100644\n--- a/lib/crewai/tests/llms/openai/test_responses_only_models.py\n+++ b/lib/crewai/tests/llms/openai/test_responses_only_models.py\n@@ -187,7 +187,7 @@ def test_learned_model_still_respects_custom_endpoint(self):\n         llm = build(\n             \"gpt-5-pro\", custom_openai=True, base_url=\"https://my-vllm.internal/v1\"\n         )\n-        completion_module._LEARNED_RESPONSES_ONLY_MODELS.add(\"gpt-5-pro\")\n+        completion_module._LEARNED_RESPONSES_ONLY_MODELS.add(llm._reasoning_effort_key())\n \n         assert llm._effective_api() == \"completions\"\n \ndiff --git a/lib/crewai/tests/llms/openai/test_tools_reasoning_effort_retry.py b/lib/crewai/tests/llms/openai/test_tools_reasoning_effort_retry.py\nindex f6a3e9aab7..42026c6972 100644\n--- a/lib/crewai/tests/llms/openai/test_tools_reasoning_effort_retry.py\n+++ b/lib/crewai/tests/llms/openai/test_tools_reasoning_effort_retry.py\n@@ -11,9 +11,22 @@\n So an ordinary agent with a tool fails on this model family and nothing else. The\n 400 is recovered by resending with an explicit \"none\"; no model list is involved,\n so a family OpenAI restricts later is handled without a release here.\n+\n+GPT-6 Astra and GPT-6.1 Sol offer \"none\" in the same 400 and then refuse it, so\n+their tools are served only by /v1/responses (live endpoint, 2026-11-03):\n+\n+    gpt-6.1-sol  tools, no reasoning_effort key   -> 400, offers \"none\"\n+    gpt-6.1-sol  tools, reasoning_effort=\"none\"   -> 400, unsupported value\n+    gpt-6.1-sol  tools on /v1/responses           -> OK\n+    gpt-6-luna   tools, reasoning_effort=\"none\"   -> OK (gpt-6.1-terra too)\n+\n+Those calls move to the Responses API, and the model is remembered so its later\n+calls go there directly.\n \"\"\"\n \n+import gzip\n import json\n+import logging\n from types import SimpleNamespace\n \n import httpx\n@@ -21,7 +34,10 @@\n from openai import BadRequestError\n \n from crewai import Agent, Crew, Task\n-from crewai.llms.providers.openai.completion import OpenAICompletion\n+from crewai.llms.providers.openai.completion import (\n+    _LEARNED_RESPONSES_ONLY_MODELS,\n+    OpenAICompletion,\n+)\n from crewai.tools import tool\n \n \n@@ -80,6 +96,46 @@ def unsupported_value_error() -> BadRequestError:\n     return _bad_request(\"Unsupported value: 'reasoning_effort' does not support 'none'.\")\n \n \n+def none_rejected_error() -> BadRequestError:\n+    \"\"\"GPT-6 Astra and GPT-6.1 Sol refusing the \"none\" retry (live wording).\"\"\"\n+    body = {\n+        \"error\": {\n+            \"message\": \"Unsupported value: 'reasoning_effort' does not support \"\n+            \"'none' with this model. Supported values are: 'low', 'medium', \"\n+            \"'high', and 'xhigh'.\",\n+            \"type\": \"invalid_request_error\",\n+            \"param\": \"reasoning_effort\",\n+            \"code\": \"unsupported_value\",\n+        }\n+    }\n+    return BadRequestError(\n+        body[\"error\"][\"message\"],\n+        response=httpx.Response(\n+            400,\n+            json=body,\n+            request=httpx.Request(\"POST\", \"https://api.openai.com/v1/chat/completions\"),\n+        ),\n+        body=body,\n+    )\n+\n+\n+def responses_only_tools_error() -> BadRequestError:\n+    \"\"\"GPT-6 Astra on Bedrock (live wording): no \"none\" way out, and it rejects it.\"\"\"\n+    return _bad_request(\n+        \"Function tools with reasoning_effort are not supported for \"\n+        \"us.openai.gpt-6-astra in /v1/chat/completions. To use function tools, use \"\n+        \"/v1/responses.\"\n+    )\n+\n+\n+@pytest.fixture(autouse=True)\n+def _clear_learned_models():\n+    \"\"\"Keep the process-wide learned set from leaking between tests.\"\"\"\n+    _LEARNED_RESPONSES_ONLY_MODELS.clear()\n+    yield\n+    _LEARNED_RESPONSES_ONLY_MODELS.clear()\n+\n+\n class TestErrorDetection:\n     def test_matches_the_tools_effort_400(self):\n         assert OpenAICompletion._rejects_reasoning_effort_with_tools(\n@@ -113,6 +169,34 @@ def test_ignores_unrelated_exceptions(self):\n             RuntimeError(\"boom\")\n         )\n \n+    @pytest.mark.parametrize(\n+        (\"error\", \"offers_none\"),\n+        [\n+            (tools_effort_error(\"gpt-6.1-sol\"), True),\n+            (responses_only_tools_error(), False),\n+        ],\n+        ids=[\"openai\", \"bedrock\"],\n+    )\n+    def test_spots_whether_the_tools_400_offers_none(self, error, offers_none):\n+        assert OpenAICompletion._offers_reasoning_effort_none(error) is offers_none\n+\n+    @pytest.mark.parametrize(\n+        (\"error\", \"rejects_none\"),\n+        [\n+            (none_rejected_error(), True),\n+            (unsupported_value_error(), True),\n+            (tools_effort_error(\"gpt-6.1-sol\"), False),\n+            (\n+                _bad_request(\"Unsupported value: 'temperature'.\", param=\"temperature\"),\n+                False,\n+            ),\n+            (RuntimeError(\"Unsupported value: 'reasoning_effort'\"), False),\n+        ],\n+        ids=[\"gpt-6\", \"flat-body\", \"tools-400\", \"other-param\", \"not-a-400\"],\n+    )\n+    def test_spots_the_none_retry_being_refused(self, error, rejects_none):\n+        assert OpenAICompletion._rejects_reasoning_effort_none(error) is rejects_none\n+\n \n class TestRetryParams:\n     def test_sets_an_explicit_none(self):\n@@ -185,7 +269,12 @@ def fail(params, **kwargs):\n \n         assert len(calls) == 1\n \n-    def test_recovered_call_reports_no_failure(self, monkeypatch):\n+    @pytest.mark.parametrize(\n+        \"rejection\",\n+        [tools_effort_error(), none_rejected_error()],\n+        ids=[\"tools-400\", \"none-refused\"],\n+    )\n+    def test_recovered_call_reports_no_failure(self, monkeypatch, rejection):\n         \"\"\"The retried attempt must not emit LLMCallFailedEvent.\"\"\"\n         llm = build()\n         emitted: list[str] = []\n@@ -197,7 +286,7 @@ def test_recovered_call_reports_no_failure(self, monkeypatch):\n \n         class FakeCompletions:\n             def create(self, **kwargs):\n-                raise tools_effort_error()\n+                raise rejection\n \n             @property\n             def with_raw_response(self):\n@@ -235,6 +324,448 @@ async def fake_handle(params, **kwargs):\n         assert seen[1][\"reasoning_effort\"] == \"none\"\n \n \n+def _rejects_tools_like_gpt_6_1_sol(params: dict, **kwargs):\n+    \"\"\"Chat completions as GPT-6.1 Sol serves it: no tool call ever succeeds.\"\"\"\n+    if params.get(\"reasoning_effort\") == \"none\":\n+        raise none_rejected_error()\n+    raise tools_effort_error(\"gpt-6.1-sol\")\n+\n+\n+TOOL_ROUND_TRIP = [\n+    {\"role\": \"user\", \"content\": \"What is 17 times 23?\"},\n+    {\n+        \"role\": \"assistant\",\n+        \"content\": None,\n+        \"tool_calls\": [\n+            {\n+                \"id\": \"call_1\",\n+                \"type\": \"function\",\n+                \"function\": {\"name\": \"multiply\", \"arguments\": '{\"a\": 17, \"b\": 23}'},\n+            }\n+        ],\n+    },\n+    {\"role\": \"tool\", \"tool_call_id\": \"call_1\", \"content\": \"391\"},\n+]\n+\n+\n+class TestToolsOnlyOnResponses:\n+    \"\"\"GPT-6 Astra and GPT-6.1 Sol: tool calls move to the Responses API.\"\"\"\n+\n+    def test_sync_call_moves_to_responses(self, monkeypatch):\n+        llm = build(\"gpt-6.1-sol\")\n+        chat: list[dict] = []\n+        responses: list[dict] = []\n+\n+        def fake_chat(params, **kwargs):\n+            chat.append(params)\n+            _rejects_tools_like_gpt_6_1_sol(params)\n+\n+        def fake_responses(params, **kwargs):\n+            responses.append(params)\n+            return \"391\"\n+\n+        monkeypatch.setattr(llm, \"_handle_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_handle_responses\", fake_responses)\n+\n+        assert llm._call_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert [p.get(\"reasoning_effort\") for p in chat] == [None, \"none\"]\n+        assert [t[\"name\"] for t in responses[0][\"tools\"]] == [\"multiply\"]\n+        assert responses[0][\"store\"] is False, \"chat completions stores nothing\"\n+        assert llm._effective_api() == \"responses\"\n+\n+    @pytest.mark.asyncio\n+    async def test_async_call_moves_to_responses(self, monkeypatch):\n+        llm = build(\"gpt-6-astra\")\n+        chat: list[dict] = []\n+        responses: list[dict] = []\n+\n+        async def fake_chat(params, **kwargs):\n+            chat.append(params)\n+            _rejects_tools_like_gpt_6_1_sol(params)\n+\n+        async def fake_responses(params, **kwargs):\n+            responses.append(params)\n+            return \"391\"\n+\n+        monkeypatch.setattr(llm, \"_ahandle_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_ahandle_responses\", fake_responses)\n+\n+        assert await llm._acall_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert [p.get(\"reasoning_effort\") for p in chat] == [None, \"none\"]\n+        assert [t[\"name\"] for t in responses[0][\"tools\"]] == [\"multiply\"]\n+        assert llm._effective_api() == \"responses\"\n+\n+    def test_sync_stream_moves_to_responses_stream(self, monkeypatch):\n+        llm = build(\"gpt-6.1-sol\", stream=True)\n+        responses: list[dict] = []\n+\n+        def fake_responses(params, **kwargs):\n+            responses.append(params)\n+            return \"391\"\n+\n+        monkeypatch.setattr(\n+            llm, \"_handle_streaming_completion\", _rejects_tools_like_gpt_6_1_sol\n+        )\n+        monkeypatch.setattr(llm, \"_handle_streaming_responses\", fake_responses)\n+\n+        assert llm._call_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert responses[0][\"stream\"] is True\n+        assert responses[0][\"tools\"]\n+\n+    @pytest.mark.asyncio\n+    async def test_async_stream_moves_to_responses_stream(self, monkeypatch):\n+        llm = build(\"gpt-6.1-sol\", stream=True)\n+        responses: list[dict] = []\n+\n+        async def fake_chat(params, **kwargs):\n+            _rejects_tools_like_gpt_6_1_sol(params)\n+\n+        async def fake_responses(params, **kwargs):\n+            responses.append(params)\n+            return \"391\"\n+\n+        monkeypatch.setattr(llm, \"_ahandle_streaming_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_ahandle_streaming_responses\", fake_responses)\n+\n+        assert await llm._acall_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert responses[0][\"stream\"] is True\n+        assert responses[0][\"tools\"]\n+\n+    def test_tool_result_turn_goes_straight_to_responses(self, monkeypatch):\n+        \"\"\"The turn after a tool runs pays no rejected chat call and keeps the result.\"\"\"\n+        llm = build(\"gpt-6.1-sol\")\n+        chat: list[dict] = []\n+        responses: list[dict] = []\n+\n+        def fake_chat(params, **kwargs):\n+            chat.append(params)\n+            _rejects_tools_like_gpt_6_1_sol(params)\n+\n+        def fake_responses(params, **kwargs):\n+            responses.append(params)\n+            return \"391\"\n+\n+        monkeypatch.setattr(llm, \"_handle_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_handle_responses\", fake_responses)\n+\n+        llm.call(MESSAGES, tools=TOOLS)\n+        chat.clear()\n+        assert llm.call(TOOL_ROUND_TRIP, tools=TOOLS) == \"391\"\n+\n+        assert chat == []\n+        items = responses[-1][\"input\"]\n+        assert {\"type\": \"function_call\", \"call_id\": \"call_1\"}.items() <= items[1].items()\n+        assert items[2] == {\n+            \"type\": \"function_call_output\",\n+            \"call_id\": \"call_1\",\n+            \"output\": \"391\",\n+        }\n+\n+    @pytest.mark.parametrize(\"model\", [\"gpt-6-luna\", \"gpt-6.1-terra\"])\n+    def test_models_that_accept_none_stay_on_chat(self, monkeypatch, model):\n+        llm = build(model)\n+        seen: list[dict] = []\n+\n+        def fake_chat(params, **kwargs):\n+            seen.append(params)\n+            if params.get(\"reasoning_effort\") != \"none\":\n+                raise tools_effort_error(model)\n+            return \"391\"\n+\n+        def no_responses(params, **kwargs):\n+            raise AssertionError(\"must not reach the Responses API\")\n+\n+        monkeypatch.setattr(llm, \"_handle_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_handle_responses\", no_responses)\n+\n+        assert llm._call_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert seen[-1][\"reasoning_effort\"] == \"none\"\n+        assert llm._effective_api() == \"completions\"\n+\n+    def test_a_retry_failing_for_another_reason_surfaces(self, monkeypatch):\n+        \"\"\"Only the refused \"none\" moves the call; anything else is the caller's.\"\"\"\n+        llm = build(\"gpt-6.1-sol\")\n+        calls: list[dict] = []\n+\n+        def fake_chat(params, **kwargs):\n+            calls.append(params)\n+            if params.get(\"reasoning_effort\") == \"none\":\n+                raise _bad_request(\"Invalid 'messages'.\", param=\"messages\")\n+            raise tools_effort_error(\"gpt-6.1-sol\")\n+\n+        def no_responses(params, **kwargs):\n+            raise AssertionError(\"must not reach the Responses API\")\n+\n+        monkeypatch.setattr(llm, \"_handle_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_handle_responses\", no_responses)\n+\n+        with pytest.raises(BadRequestError, match=\"Invalid 'messages'\"):\n+            llm._call_completions(MESSAGES, tools=TOOLS)\n+        assert len(calls) == 2\n+        assert llm._effective_api() == \"completions\"\n+\n+    @pytest.mark.parametrize(\"custom_openai\", [False, True])\n+    def test_skips_the_none_retry_when_it_is_not_offered(\n+        self, monkeypatch, custom_openai\n+    ):\n+        \"\"\"Bedrock names only /v1/responses, so that is where the call goes.\"\"\"\n+        llm = build(\n+            \"us.openai.gpt-6-astra\",\n+            custom_openai=custom_openai,\n+            base_url=\"https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1\",\n+        )\n+        seen: list[dict] = []\n+\n+        def fake_chat(params, **kwargs):\n+            seen.append(params)\n+            raise responses_only_tools_error()\n+\n+        monkeypatch.setattr(llm, \"_handle_completion\", fake_chat)\n+        monkeypatch.setattr(llm, \"_handle_responses\", lambda params, **kw: \"391\")\n+\n+        assert llm._call_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert len(seen) == 1, \"no reasoning_effort='none' retry\"\n+\n+    def test_a_compatible_server_is_not_remembered(self, monkeypatch):\n+        \"\"\"Its later calls still start on chat completions, as `api` asks.\"\"\"\n+        llm = build(\n+            \"us.openai.gpt-6-astra\",\n+            custom_openai=True,\n+            base_url=\"https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1\",\n+        )\n+        monkeypatch.setattr(llm, \"_handle_completion\", _rejects_tools_like_gpt_6_1_sol)\n+        monkeypatch.setattr(llm, \"_handle_responses\", lambda params, **kw: \"391\")\n+\n+        assert llm._call_completions(MESSAGES, tools=TOOLS) == \"391\"\n+        assert llm._effective_api() == \"completions\"\n+\n+\n+class TestLearnedPerEndpoint:\n+    \"\"\"What one endpoint taught never reroutes the same model name elsewhere.\"\"\"\n+\n+    GATEWAY = \"https://gateway.example/v1\"\n+\n+    def test_a_gateway_lesson_stays_on_that_gateway(self):\n+        build(\"gpt-6.1-sol\", base_url=self.GATEWAY)._remember_responses_only_model()\n+\n+        assert build(\"gpt-6.1-sol\", base_url=self.GATEWAY)._effective_api() == (\n+            \"responses\"\n+        )\n+        assert build(\"gpt-6.1-sol\")._effective_api() == \"completions\"\n+        assert (\n+            build(\"gpt-6.1-sol\", base_url=\"https://other.example/v1\")._effective_api()\n+            == \"completions\"\n+        )\n+\n+    def test_an_openai_lesson_does_not_reroute_a_gateway(self):\n+        build(\"gpt-6.1-sol\")._remember_responses_only_model()\n+\n+        assert build(\"gpt-6.1-sol\", base_url=self.GATEWAY)._effective_api() == (\n+            \"completions\"\n+        )\n+\n+\n+class TestStoreOnTheMoveToResponses:\n+    \"\"\"Chat completions stores nothing by default, and the move must not change that.\"\"\"\n+\n+    def test_an_implicit_move_asks_openai_not_to_store(self):\n+        params = build(\"gpt-6.1-sol\")._prepare_responses_params(MESSAGES)\n+\n+        assert params[\"store\"] is False\n+\n+    @pytest.mark.parametrize(\"store\", [True, False])\n+    def test_an_explicit_store_wins(self, store):\n+        params = build(\"gpt-6.1-sol\", store=store)._prepare_responses_params(MESSAGES)\n+\n+        assert params[\"store\"] is store\n+\n+    @pytest.mark.parametrize(\n+        \"kwargs\",\n+        [\n+            {\"api\": \"responses\"},\n+            {\"auto_chain\": True},\n+            {\"previous_response_id\": \"resp_1\"},\n+            {\"base_url\": \"https://gateway.example/v1\"},\n+        ],\n+        ids=[\"asked-for-responses\", \"auto-chain\", \"chained\", \"compatible-server\"],\n+    )\n+    def test_leaves_store_to_the_server_otherwise(self, kwargs):\n+        \"\"\"Chaining needs a stored response, and a gateway may not know the field.\"\"\"\n+        params = build(\"gpt-6.1-sol\", **kwargs)._prepare_responses_params(MESSAGES)\n+\n+        assert \"store\" not in params\n+\n+\n+def _streamed_function_call() -> list[SimpleNamespace]:\n+    \"\"\"The Responses API events for one streamed `multiply` call.\"\"\"\n+    item = SimpleNamespace(\n+        type=\"function_call\",\n+        call_id=\"call_1\",\n+        name=\"multiply\",\n+        arguments='{\"a\": 17, \"b\": 23}',\n+    )\n+    return [\n+        SimpleNamespace(type=\"response.created\", response=SimpleNamespace(id=\"resp_1\")),\n+        SimpleNamespace(type=\"response.output_item.done\", item=item),\n+    ]\n+\n+\n+class TestStreamedToolCalls:\n+    \"\"\"A native agent passes no `available_functions` and runs the calls itself.\"\"\"\n+\n+    def test_sync_stream_returns_the_tool_calls(self, monkeypatch):\n+        llm = build(\"gpt-6.1-sol\", api=\"responses\", stream=True)\n+        events = _streamed_function_call()\n+        monkeypatch.setattr(\n+            llm,\n+            \"_get_sync_client\",\n+            lambda: SimpleNamespace(\n+                responses=SimpleNamespace(create=lambda **kwargs: iter(events))\n+            ),\n+        )\n+\n+        result = llm._handle_streaming_responses({\"input\": MESSAGES})\n+\n+        assert result == [\n+            {\"id\": \"call_1\", \"name\": \"multiply\", \"arguments\": '{\"a\": 17, \"b\": 23}'}\n+        ]\n+\n+    @pytest.mark.asyncio\n+    async def test_async_stream_returns_the_tool_calls(self, monkeypatch):\n+        llm = build(\"gpt-6.1-sol\", api=\"responses\", stream=True)\n+        events = _streamed_function_call()\n+\n+        async def stream():\n+            for event in events:\n+                yield event\n+\n+        async def create(**kwargs):\n+            return stream()\n+\n+        monkeypatch.setattr(\n+            llm,\n+            \"_get_async_client\",\n+            lambda: SimpleNamespace(responses=SimpleNamespace(create=create)),\n+        )\n+\n+        result = await llm._ahandle_streaming_responses({\"input\": MESSAGES})\n+\n+        assert result == [\n+            {\"id\": \"call_1\", \"name\": \"multiply\", \"arguments\": '{\"a\": 17, \"b\": 23}'}\n+        ]\n+\n+    def test_given_the_functions_it_still_runs_them(self, monkeypatch):\n+        llm = build(\"gpt-6.1-sol\", api=\"responses\", stream=True)\n+        events = _streamed_function_call()\n+        monkeypatch.setattr(\n+            llm,\n+            \"_get_sync_client\",\n+            lambda: SimpleNamespace(\n+                responses=SimpleNamespace(create=lambda **kwargs: iter(events))\n+            ),\n+        )\n+\n+        result = llm._handle_streaming_responses(\n+            {\"input\": MESSAGES}, available_functions={\"multiply\": lambda a, b: a * b}\n+        )\n+\n+        assert result == \"391\"\n+\n+\n+@pytest.fixture(scope=\"module\")\n+def vcr_config(vcr_config):\n+    \"\"\"Record 400s too: the cassette below exists to show the recovery from two.\n+\n+    conftest skips recording any response >= 400. These carry only an error body,\n+    so they are kept with every header but the content type dropped.\n+    \"\"\"\n+    filter_response = vcr_config[\"before_record_response\"]\n+\n+    def keep_rejections(response):\n+        if response[\"status\"][\"code\"] != 400:\n+            return filter_response(response)\n+        body = response[\"body\"][\"string\"]\n+        if isinstance(body, bytes) and body.startswith(b\"\\x1f\\x8b\"):\n+            body = gzip.decompress(body).decode()\n+        return {\n+            **response,\n+            \"headers\": {\"content-type\": [\"application/json\"]},\n+            \"body\": {\"string\": body},\n+        }\n+\n+    return {**vcr_config, \"before_record_response\": keep_rejections}\n+\n+\n+@pytest.mark.vcr()\n+def test_gpt_6_1_sol_agent_runs_its_tool(caplog):\n+    \"\"\"Recorded live: two refused chat calls, then the tool round trip on /v1/responses.\"\"\"\n+\n+    looked_up: list[str] = []\n+\n+    @tool(\"lookup_code\")\n+    def lookup_code(name: str) -> str:\n+        \"\"\"Look up the access code for a project by name.\"\"\"\n+        looked_up.append(name)\n+        return f\"{name.upper()}-ZETA-7741\"\n+\n+    agent = Agent(\n+        role=\"Records clerk\",\n+        goal=\"Report access codes exactly as the lookup tool returns them\",\n+        backstory=\"You never guess a code.\",\n+        llm=OpenAICompletion(model=\"gpt-6.1-sol\"),\n+        tools=[lookup_code],\n+    )\n+    task = Task(\n+        description=\"What is the access code for the project named 'orion'?\",\n+        expected_output=\"The access code, exactly as the tool returned it\",\n+        agent=agent,\n+    )\n+\n+    with caplog.at_level(logging.ERROR):\n+        result = Crew(agents=[agent], tasks=[task]).kickoff()\n+\n+    # Cassettes match on path alone, so a reply could be played to the wrong\n+    # call; the tool having run is what proves the round trip.\n+    assert looked_up == [\"orion\"]\n+    assert \"ORION-ZETA-7741\" in str(result)\n+    assert caplog.records == [], \"a recovered call must not log an error\"\n+\n+\n+@pytest.mark.vcr()\n+def test_gpt_6_1_sol_streaming_agent_runs_its_tool(caplog):\n+    \"\"\"Recorded live with stream=True: the streamed tool call reaches the agent.\"\"\"\n+\n+    looked_up: list[str] = []\n+\n+    @tool(\"lookup_code\")\n+    def lookup_code(name: str) -> str:\n+        \"\"\"Look up the access code for a project by name.\"\"\"\n+        looked_up.append(name)\n+        return f\"{name.upper()}-ZETA-7741\"\n+\n+    agent = Agent(\n+        role=\"Records clerk\",\n+        goal=\"Report access codes exactly as the lookup tool returns them\",\n+        backstory=\"You never guess a code.\",\n+        llm=OpenAICompletion(model=\"gpt-6.1-sol\", stream=True),\n+        tools=[lookup_code],\n+    )\n+    task = Task(\n+        description=\"What is the access code for the project named 'vega'?\",\n+        expected_output=\"The access code, exactly as the tool returned it\",\n+        agent=agent,\n+    )\n+\n+    with caplog.at_level(logging.ERROR):\n+        result = Crew(agents=[agent], tasks=[task]).kickoff()\n+\n+    # Cassettes match on path alone, so a reply could be played to the wrong\n+    # call; the tool having run is what proves the round trip.\n+    assert looked_up == [\"vega\"]\n+    assert \"VEGA-ZETA-7741\" in str(result)\n+    assert caplog.records == [], \"a recovered call must not log an error\"\n+\n+\n class TestAgentDefinitions:\n     \"\"\"The bar: ordinary agent definitions run, with tools and with reasoning.\"\"\"\n \n", "problem_statement": "[BUG] GPT-6 Astra agents with tools fail on Bedrock's OpenAI-compatible API because the retry sends reasoning_effort 'none'\n### Description\n\nThanks for the tools + `reasoning_effort` recovery in #6660. It makes GPT-6 Sol and Luna agents with tools work through Bedrock's OpenAI-compatible endpoints.\n\nGPT-6 Astra's tools 400 on `/v1/chat/completions` offers only `/v1/responses`, and Astra rejects `\"none\"`. crewAI retries with `\"none\"`, so every Astra agent with a tool fails with `'none' is not supported`, a value nobody set. `api=\"responses\"` works.\n\n| `LLM(\"openai/<id>\", base_url=<Bedrock /openai/v1>)` + `Agent(tools=[...])` | main `7060bf8` | with the change below |\n|---|---|---|\n| GPT-6 Astra, bedrock-runtime us-east-1 (`us.`, `global.`) and bedrock-mantle us-west-2: `kickoff()`, `kickoff_async()` | \u274c 400 `'none' is not supported` | \u2705 answers |\n| same, `stream=True` | \u274c same 400 | \u274c empty response (#7497), \u2705 with #7502 on top |\n| GPT-6 Astra without tools | \u2705 | \u2705 unchanged |\n| GPT-6 Sol / Luna with tools (`\"none\"` retry) | \u2705 | \u2705 unchanged |\n| `api=\"responses\"` set explicitly | \u2705 | \u2705 unchanged |\n\n### Steps to Reproduce\n\n1. Export a Bedrock API key as `AWS_BEARER_TOKEN_BEDROCK`.\n2. Run the snippet below.\n3. With `us.openai.gpt-6-sol` it answers.\n\n### Expected behavior\n\nThe agent answers, as with GPT-6 Sol/Luna or `api=\"responses\"`.\n\n### Screenshots/Code snippets\n\n```python\nimport os\nfrom crewai import Agent, LLM\nfrom crewai.tools import tool\n\n\n@tool(\"get_weather\")\ndef get_weather(city: str) -> str:\n    \"\"\"Return the current weather for a city.\"\"\"\n    return f\"The weather in {city} is 21C and sunny.\"\n\n\nllm = LLM(\n    model=\"openai/us.openai.gpt-6-astra\",\n    base_url=\"https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1\",\n    api_key=os.environ[\"AWS_BEARER_TOKEN_BEDROCK\"],\n)\nagent = Agent(\n    role=\"Helper\",\n    goal=\"Answer briefly\",\n    backstory=\"You are concise.\",\n    llm=llm,\n    tools=[get_weather],\n)\ntry:\n    print(repr(agent.kickoff(\"What's the weather in Paris?\").raw))\nexcept Exception as e:\n    print(f\"{type(e).__name__}: {e}\")\n```\n\n```text\nBadRequestError: Error code: 400 - {'error': {'message': \"Unsupported value: 'none' is not supported with this model. Supported values are: 'low', 'medium', 'high', 'xhigh', and 'max'.\", 'type': 'invalid_request_error', 'param': 'reasoning_effort', 'code': 'unsupported_value'}}\n```\n\n### Operating System\n\nOther (macOS)\n\n### Python Version\n\n3.13\n\n### crewAI Version\n\n1.15.22 (main 7060bf8)\n\n### crewAI Tools Version\n\nnot installed\n\n### Virtual Environment\n\nVenv (uv)\n\n### Evidence\n\nRaw HTTP to bedrock-runtime us-east-1, no crewAI:\n\n```text\nus.openai.gpt-6-astra  chat + tools                          400 ... To use function tools, use /v1/responses.\nus.openai.gpt-6-astra  chat + tools, reasoning_effort=\"none\" 400 Unsupported value: 'none' is not supported with this model. ...\nus.openai.gpt-6-sol    chat + tools                          400 ... To use function tools, use /v1/responses or set reasoning_effort to 'none'.\nus.openai.gpt-6-sol    chat + tools, reasoning_effort=\"none\" 200 finish_reason tool_calls\nus.openai.gpt-6-astra  /responses + tools                    200 function_call get_weather {\"city\":\"Paris\"}\n```\n\n[`_call_completions` L691-L700](https://github.com/crewAIInc/crewAI/blob/7060bf858bdec450f8652aa7934a582ef5c10aaf/lib/crewai/src/crewai/llms/providers/openai/completion.py#L691-L700) retries with `\"none\"` on that 400 and raises the retry's 400. The #6656 Responses fallback at [L709](https://github.com/crewAIInc/crewAI/blob/7060bf858bdec450f8652aa7934a582ef5c10aaf/lib/crewai/src/crewai/llms/providers/openai/completion.py#L709) can't help either: `base_url` plus a non-OpenAI model id routes as `custom_openai` ([`llm.py` L601-L605](https://github.com/crewAIInc/crewAI/blob/7060bf858bdec450f8652aa7934a582ef5c10aaf/lib/crewai/src/crewai/llm.py#L601-L605)).\n\n<details><summary>HTTP calls per agent run, main vs the change (bedrock-runtime us-east-1 unless noted)</summary>\n\n```text\nmain 7060bf8\nus.openai.gpt-6-astra      Agent(tool)                FAIL 400 'none' is not supported   chat/completions:400 chat/completions:400\nus.openai.gpt-6-astra      Agent(tool) kickoff_async  FAIL same                          chat/completions:400 chat/completions:400\nus.openai.gpt-6-astra      Agent(tool, stream=True)   FAIL same                          chat/completions:400 chat/completions:400\nus.openai.gpt-6-astra      Agent(no tools)            OK 'pong'                          chat/completions:200\nglobal.openai.gpt-6-astra, openai.gpt-6-astra on mantle us-west-2: same four results\nus.openai.gpt-6-sol / us.openai.gpt-6-luna  Agent(tool), stream=True, kickoff_async  OK\n\nwith the change\nus.openai.gpt-6-astra      Agent(tool)                OK 'It\u2019s currently 21\u00b0C and sunny in Paris.'  chat/completions:400 responses:200 chat/completions:400 responses:200\nglobal.openai.gpt-6-astra  Agent(tool)                OK 'It\u2019s currently 21\u00b0C and sunny in Paris.'  (same calls)\nopenai.gpt-6-astra, mantle us-west-2  Agent(tool)     OK 'It\u2019s currently 21\u00b0C and sunny in Paris.'  (same calls)\n(all three)                Agent(tool) kickoff_async  OK\n(all three)                Agent(no tools)            OK 'pong'  chat/completions:200\n(all three)                Agent(tool, stream=True)   FAIL Invalid response from LLM call - None or empty.  chat/completions:400 responses:200\n(all three), with #7502    Agent(tool, stream=True)   OK 'It\u2019s currently 21\u00b0C and sunny in Oslo.'\nus.openai.gpt-6-sol        Agent(tool)                OK   chat/completions:400 chat/completions:200 chat/completions:400 chat/completions:200\nus.openai.gpt-6-luna       Agent(tool)                OK   (same calls as Sol, unchanged)\n```\n\nOn main, `api=\"responses\"` with `stream=True` and tools already returns the same empty response for Sol and Astra, which is #7497. Mantle us-east-1 has no Astra (`404 The model 'openai.gpt-6-astra' does not exist`), so the Mantle rows use us-west-2.\n\n</details>\n\n### Possible Solution\n\nWhen the 400 doesn't offer `\"none\"`, take the `/v1/responses` way out it names:\n\n```diff\n             if self._rejects_reasoning_effort_with_tools(cause):\n+                if self._is_responses_only_error(cause):\n+                    return self._call_responses(messages=messages, tools=tools, ...)\n                 retry_params = self._reasoning_effort_none_params(completion_params)\n...\n     def _is_responses_only_error(error: BaseException) -> bool:\n+        if OpenAICompletion._rejects_reasoning_effort_with_tools(error):\n+            return \"'none'\" not in str(error)\n```\n\nSame in `_acall_completions`. This also reroutes custom endpoints, since the server names `/v1/responses`; if you'd rather not, skipping the retry alone surfaces the server's own error. I have a branch with tests and will open a PR linking here.\n\n### Additional context\n\n`stream=True` also needs #7502 (fixes #7497).\n\nI used Claude Code for this report, so it needs the `llm-generated` label per CONTRIBUTING.md. I can't add labels myself.\n\n", "hints_text": "This issue is stale because it has been open for 30 days with no activity. Remove stale label or comment or this will be closed in 5 days.\nThanks for merging #7731 and #7733 this month. They came from the same GPT-6 batch as this issue, so I re-ran it on current main.\n\nIt still reproduces on main `38db11e`: a GPT-6 Astra agent with a tool fails with the same `'none' is not supported` 400. #7741 merges onto that commit without conflicts, and with it the agent answers.\n\n| `LLM(\"openai/<id>\", base_url=<bedrock-runtime us-east-1 /openai/v1>)` + `Agent(tools=[get_weather]).kickoff()` | main `38db11e` | #7741 merged onto `38db11e` |\n|---|---|---|\n| `us.openai.gpt-6-astra` | \u274c 400 `'none' is not supported` | \u2705 `'It\u2019s currently 21\u00b0C and sunny in Paris.'` |\n| `us.openai.gpt-6-sol` (`\"none\"` retry) | \u2705 same answer | \u2705 same answer, same HTTP calls |\n| the 6 new tests in #7741 | 4 failed, 2 passed | 6 passed |\n| `lib/crewai/tests/llms/openai/` | 293 passed, 6 failed\\*, 1 skipped | 299 passed, 6 failed\\*, 1 skipped |\n\n\\* `test_llm_accepts_every_documented_effort[...]` fails the same way in both runs because I didn't install the `litellm` extra.\n\n<details><summary>Live output and test commands</summary>\n\n```text\nmain 38db11e\nus.openai.gpt-6-astra  FAIL BadRequestError: Error code: 400 - {'error': {'message': \"Unsupported value: 'none' is not supported with this model. Supported values are: 'low', 'medium', 'high', 'xhigh', and 'max'.\", ...\n                       calls: chat/completions:400 chat/completions:400\nus.openai.gpt-6-sol    OK 'It\u2019s currently 21\u00b0C and sunny in Paris.'\n                       calls: chat/completions:400 chat/completions:200 chat/completions:400 chat/completions:200\n\n#7741 merged onto 38db11e\nus.openai.gpt-6-astra  OK 'It\u2019s currently 21\u00b0C and sunny in Paris.'\n                       calls: chat/completions:400 responses:200 chat/completions:400 responses:200\nus.openai.gpt-6-sol    OK 'It\u2019s currently 21\u00b0C and sunny in Paris.'\n                       calls: chat/completions:400 chat/completions:200 chat/completions:400 chat/completions:200\n```\n\n```text\n$ git merge 8abca09            # #7741 head into main 38db11e, no conflicts\n$ pytest lib/crewai/tests/llms/openai/test_tools_reasoning_effort_retry.py -p no:randomly \\\n    -k 'spots_the_400_only_responses_can_serve or goes_to_responses_when_none_is_not_offered or async_path_goes_to_responses_too'\nmerged tree:                              6 passed   (whole file: 21 passed)\ncompletion.py from 38db11e, tests kept:   4 failed, 2 passed\nE   openai.BadRequestError: Function tools with reasoning_effort are not supported for us.openai.gpt-6-astra in /v1/chat/completions. To use function tools, use /v1/responses.\n```\n\n</details>\n", "created_at": "2026-11-04T06:52:09Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8754, "instance_id": "crewAIInc__crewAI-8754", "issue_numbers": ["8131"], "base_commit": "1357d23aafb5d3a612a19562fe9b8e2b0c899307", "patch": "diff --git a/docs/edge/ar/tools/ai-ml/ragtool.mdx b/docs/edge/ar/tools/ai-ml/ragtool.mdx\nindex de1241149e..b2e27fa3b0 100644\n--- a/docs/edge/ar/tools/ai-ml/ragtool.mdx\n+++ b/docs/edge/ar/tools/ai-ml/ragtool.mdx\n@@ -49,6 +49,7 @@ def knowledge_expert(self) -> Agent:\n - \u0645\u0644\u0641\u0627\u062a PDF\n - \u0645\u0644\u0641\u0627\u062a CSV\n - \u0645\u0644\u0641\u0627\u062a JSON\n+- \u0645\u0644\u0641\u0627\u062a JSONL (`.jsonl` \u0648`.ndjson`)\n - \u0646\u0635\u0648\u0635\n - \u0645\u062c\u0644\u062f\u0627\u062a/\u0623\u062f\u0644\u0629\n - \u0635\u0641\u062d\u0627\u062a \u0648\u064a\u0628 HTML\n@@ -95,8 +96,17 @@ rag_tool.add(data_type=\"youtube_video\", url=\"https://www.youtube.com/watch?v=VID\n \n # Add a directory of files\n rag_tool.add(data_type=\"directory\", path=\"path/to/your/directory\")\n+\n+# Add a local JSONL file with an explicit type\n+rag_tool.add(data_type=\"jsonl\", path=\"path/to/your/records.jsonl\")\n+\n+# Auto-detect a local JSONL file by its extension\n+rag_tool.add(path=\"path/to/your/records.ndjson\")\n ```\n \n+\u062a\u062d\u062a\u0648\u064a \u0645\u0644\u0641\u0627\u062a JSONL \u0639\u0644\u0649 \u0642\u064a\u0645\u0629 JSON \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0643\u0644 \u0633\u0637\u0631. \u064a\u062f\u0639\u0645 \u0645\u064f\u062d\u0645\u0650\u0651\u0644 JSONL \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629\u061b\n+\u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 URL \u0644\u0645\u0644\u0641 JSONL \u0644\u0627 \u064a\u062c\u0644\u0628 \u0645\u062d\u062a\u0648\u0627\u0647.\n+\n ## \u0645\u062b\u0627\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0648\u0643\u064a\u0644\n \n \u0625\u0644\u064a\u0643 \u0643\u064a\u0641\u064a\u0629 \u062f\u0645\u062c `RagTool` \u0645\u0639 \u0648\u0643\u064a\u0644 CrewAI:\ndiff --git a/docs/edge/en/tools/ai-ml/ragtool.mdx b/docs/edge/en/tools/ai-ml/ragtool.mdx\nindex 6bedc82fb5..5d09414890 100644\n--- a/docs/edge/en/tools/ai-ml/ragtool.mdx\n+++ b/docs/edge/en/tools/ai-ml/ragtool.mdx\n@@ -49,6 +49,7 @@ The `RagTool` can be used with a wide variety of data sources, including:\n - \ud83d\udcf0 PDF files\n - \ud83d\udcca CSV files\n - \ud83d\udcc3 JSON files\n+- JSONL files (`.jsonl` and `.ndjson`)\n - \ud83d\udcdd Text\n - \ud83d\udcc1 Directories/Folders\n - \ud83c\udf10 HTML Web pages\n@@ -95,8 +96,17 @@ rag_tool.add(data_type=\"youtube_video\", url=\"https://www.youtube.com/watch?v=VID\n \n # Add a directory of files\n rag_tool.add(data_type=\"directory\", path=\"path/to/your/directory\")\n+\n+# Add a local JSONL file with an explicit type\n+rag_tool.add(data_type=\"jsonl\", path=\"path/to/your/records.jsonl\")\n+\n+# Auto-detect a local JSONL file by its extension\n+rag_tool.add(path=\"path/to/your/records.ndjson\")\n ```\n \n+JSONL files contain one JSON value per line. The JSONL loader supports local files;\n+recognizing a JSONL URL does not fetch its content.\n+\n ## Agent Integration Example\n \n Here's how to integrate the `RagTool` with a CrewAI agent:\ndiff --git a/docs/edge/ko/tools/ai-ml/ragtool.mdx b/docs/edge/ko/tools/ai-ml/ragtool.mdx\nindex e14d4d69ca..9e9c571165 100644\n--- a/docs/edge/ko/tools/ai-ml/ragtool.mdx\n+++ b/docs/edge/ko/tools/ai-ml/ragtool.mdx\n@@ -49,6 +49,7 @@ def knowledge_expert(self) -> Agent:\n - \ud83d\udcf0 PDF \ud30c\uc77c\n - \ud83d\udcca CSV \ud30c\uc77c\n - \ud83d\udcc3 JSON \ud30c\uc77c\n+- JSONL \ud30c\uc77c (`.jsonl` \ubc0f `.ndjson`)\n - \ud83d\udcdd \ud14d\uc2a4\ud2b8\n - \ud83d\udcc1 \ub514\ub809\ud130\ub9ac/\ud3f4\ub354\n - \ud83c\udf10 HTML \uc6f9 \ud398\uc774\uc9c0\n@@ -95,8 +96,17 @@ rag_tool.add(data_type=\"youtube_video\", url=\"https://www.youtube.com/watch?v=VID\n \n # Add a directory of files\n rag_tool.add(data_type=\"directory\", path=\"path/to/your/directory\")\n+\n+# Add a local JSONL file with an explicit type\n+rag_tool.add(data_type=\"jsonl\", path=\"path/to/your/records.jsonl\")\n+\n+# Auto-detect a local JSONL file by its extension\n+rag_tool.add(path=\"path/to/your/records.ndjson\")\n ```\n \n+JSONL \ud30c\uc77c\uc740 \uac01 \uc904\uc5d0 \ud558\ub098\uc758 JSON \uac12\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. JSONL \ub85c\ub354\ub294 \ub85c\uceec \ud30c\uc77c\uc744 \uc9c0\uc6d0\ud558\uba70,\n+JSONL URL\uc744 \uc778\uc2dd\ud558\ub354\ub77c\ub3c4 \ud574\ub2f9 \ucf58\ud150\uce20\ub97c \uac00\uc838\uc624\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4.\n+\n ## \uc5d0\uc774\uc804\ud2b8 \ud1b5\ud569 \uc608\uc2dc\n \n \uc544\ub798\ub294 `RagTool`\uc744 CrewAI \uc5d0\uc774\uc804\ud2b8\uc640 \ud1b5\ud569\ud558\ub294 \ubc29\ubc95\uc785\ub2c8\ub2e4:\ndiff --git a/docs/edge/pt-BR/tools/ai-ml/ragtool.mdx b/docs/edge/pt-BR/tools/ai-ml/ragtool.mdx\nindex 657ace26ec..eb35be54ab 100644\n--- a/docs/edge/pt-BR/tools/ai-ml/ragtool.mdx\n+++ b/docs/edge/pt-BR/tools/ai-ml/ragtool.mdx\n@@ -49,6 +49,7 @@ O `RagTool` pode ser utilizado com uma grande variedade de fontes de dados, incl\n - \ud83d\udcf0 Arquivos PDF\n - \ud83d\udcca Arquivos CSV\n - \ud83d\udcc3 Arquivos JSON\n+- Arquivos JSONL (`.jsonl` e `.ndjson`)\n - \ud83d\udcdd Texto\n - \ud83d\udcc1 Diret\u00f3rios/Pastas\n - \ud83c\udf10 P\u00e1ginas web em HTML\n@@ -95,8 +96,17 @@ rag_tool.add(data_type=\"youtube_video\", url=\"https://www.youtube.com/watch?v=VID\n \n # Add a directory of files\n rag_tool.add(data_type=\"directory\", path=\"path/to/your/directory\")\n+\n+# Add a local JSONL file with an explicit type\n+rag_tool.add(data_type=\"jsonl\", path=\"path/to/your/records.jsonl\")\n+\n+# Auto-detect a local JSONL file by its extension\n+rag_tool.add(path=\"path/to/your/records.ndjson\")\n ```\n \n+Arquivos JSONL cont\u00eam um valor JSON por linha. O carregador JSONL suporta arquivos locais;\n+reconhecer uma URL JSONL n\u00e3o busca seu conte\u00fado.\n+\n ## Exemplo de Integra\u00e7\u00e3o com Agente\n \n Veja como integrar o `RagTool` com um agente do CrewAI:\ndiff --git a/lib/crewai-tools/src/crewai_tools/adapters/crewai_rag_adapter.py b/lib/crewai-tools/src/crewai_tools/adapters/crewai_rag_adapter.py\nindex b0a655830f..23c12cb8b6 100644\n--- a/lib/crewai-tools/src/crewai_tools/adapters/crewai_rag_adapter.py\n+++ b/lib/crewai-tools/src/crewai_tools/adapters/crewai_rag_adapter.py\n@@ -184,6 +184,8 @@ def add(self, *args: ContentItem, **kwargs: Unpack[AddDocumentParams]) -> None:\n             \".txt\",\n             \".csv\",\n             \".json\",\n+            \".jsonl\",\n+            \".ndjson\",\n             \".xml\",\n             \".docx\",\n             \".mdx\",\n@@ -310,6 +312,7 @@ def add(self, *args: ContentItem, **kwargs: Unpack[AddDocumentParams]) -> None:\n                     DataType.DOCX,\n                     DataType.CSV,\n                     DataType.JSON,\n+                    DataType.JSONL,\n                     DataType.XML,\n                     DataType.MDX,\n                 ]:\ndiff --git a/lib/crewai-tools/src/crewai_tools/rag/data_types.py b/lib/crewai-tools/src/crewai_tools/rag/data_types.py\nindex 0fcf07e121..70e03b40d0 100644\n--- a/lib/crewai-tools/src/crewai_tools/rag/data_types.py\n+++ b/lib/crewai-tools/src/crewai_tools/rag/data_types.py\n@@ -15,6 +15,7 @@ class DataType(str, Enum):\n     TEXT_FILE = \"text_file\"\n     CSV = \"csv\"\n     JSON = \"json\"\n+    JSONL = \"jsonl\"\n     XML = \"xml\"\n     DOCX = \"docx\"\n     MDX = \"mdx\"\n@@ -39,6 +40,7 @@ def get_chunker(self) -> BaseChunker:\n             DataType.MDX: (\"text_chunker\", \"MdxChunker\"),\n             DataType.CSV: (\"structured_chunker\", \"CsvChunker\"),\n             DataType.JSON: (\"structured_chunker\", \"JsonChunker\"),\n+            DataType.JSONL: (\"structured_chunker\", \"JsonChunker\"),\n             DataType.XML: (\"structured_chunker\", \"XmlChunker\"),\n             DataType.WEBSITE: (\"web_chunker\", \"WebsiteChunker\"),\n             DataType.DIRECTORY: (\"text_chunker\", \"TextChunker\"),\n@@ -70,6 +72,7 @@ def get_loader(self) -> BaseLoader:\n             DataType.WEBSITE: (\"webpage_loader\", \"WebPageLoader\"),\n             DataType.MDX: (\"mdx_loader\", \"MDXLoader\"),\n             DataType.JSON: (\"json_loader\", \"JSONLoader\"),\n+            DataType.JSONL: (\"jsonl_loader\", \"JSONLLoader\"),\n             DataType.DOCX: (\"docx_loader\", \"DOCXLoader\"),\n             DataType.CSV: (\"csv_loader\", \"CSVLoader\"),\n             DataType.DIRECTORY: (\"directory_loader\", \"DirectoryLoader\"),\n@@ -120,6 +123,8 @@ def get_file_type(path: str) -> DataType | None:\n                 \".md\": DataType.MDX,\n                 \".docx\": DataType.DOCX,\n                 \".json\": DataType.JSON,\n+                \".jsonl\": DataType.JSONL,\n+                \".ndjson\": DataType.JSONL,\n                 \".xml\": DataType.XML,\n                 \".txt\": DataType.TEXT_FILE,\n             }\ndiff --git a/lib/crewai-tools/src/crewai_tools/rag/loaders/__init__.py b/lib/crewai-tools/src/crewai_tools/rag/loaders/__init__.py\nindex f6abce5207..f017b75ea8 100644\n--- a/lib/crewai-tools/src/crewai_tools/rag/loaders/__init__.py\n+++ b/lib/crewai-tools/src/crewai_tools/rag/loaders/__init__.py\n@@ -2,6 +2,7 @@\n from crewai_tools.rag.loaders.directory_loader import DirectoryLoader\n from crewai_tools.rag.loaders.docx_loader import DOCXLoader\n from crewai_tools.rag.loaders.json_loader import JSONLoader\n+from crewai_tools.rag.loaders.jsonl_loader import JSONLLoader\n from crewai_tools.rag.loaders.mdx_loader import MDXLoader\n from crewai_tools.rag.loaders.pdf_loader import PDFLoader\n from crewai_tools.rag.loaders.text_loader import TextFileLoader, TextLoader\n@@ -15,6 +16,7 @@\n     \"CSVLoader\",\n     \"DOCXLoader\",\n     \"DirectoryLoader\",\n+    \"JSONLLoader\",\n     \"JSONLoader\",\n     \"MDXLoader\",\n     \"PDFLoader\",\n", "test_patch": "diff --git a/lib/crewai-tools/tests/rag/test_data_types.py b/lib/crewai-tools/tests/rag/test_data_types.py\nindex edb3988011..aed96f299e 100644\n--- a/lib/crewai-tools/tests/rag/test_data_types.py\n+++ b/lib/crewai-tools/tests/rag/test_data_types.py\n@@ -1,6 +1,12 @@\n \"\"\"Tests for DataTypes content classification.\"\"\"\n \n+from pathlib import Path\n+\n+import pytest\n+\n+from crewai_tools.rag.chunkers.structured_chunker import JsonChunker\n from crewai_tools.rag.data_types import DataType, DataTypes\n+from crewai_tools.rag.loaders.jsonl_loader import JSONLLoader\n \n \n class TestDataTypesFromContentGitHub:\n@@ -30,3 +36,35 @@ def test_github_in_path_is_not_github(self) -> None:\n             DataTypes.from_content(\"https://example.com/github.com/repo\")\n             == DataType.WEBSITE\n         )\n+\n+\n+class TestDataTypesJSONL:\n+    \"\"\"JSONL uses the existing registry for explicit selection and discovery.\"\"\"\n+\n+    def test_explicit_type(self) -> None:\n+        assert DataType(\"jsonl\") is DataType.JSONL\n+        assert isinstance(DataType.JSONL.get_loader(), JSONLLoader)\n+        assert isinstance(DataType.JSONL.get_chunker(), JsonChunker)\n+\n+    @pytest.mark.parametrize(\n+        (\"extension\", \"expected\"),\n+        [(\".jsonl\", DataType.JSONL), (\".ndjson\", DataType.JSONL), (\".json\", DataType.JSON)],\n+    )\n+    @pytest.mark.parametrize(\"as_path\", [True, False])\n+    def test_file_extension(\n+        self, tmp_path: Path, extension: str, expected: DataType, as_path: bool\n+    ) -> None:\n+        path = tmp_path / f\"records{extension}\"\n+        path.write_text('{\"name\": \"first\"}\\n', encoding=\"utf-8\")\n+        assert DataTypes.from_content(path if as_path else str(path)) is expected\n+\n+    @pytest.mark.parametrize(\"extension\", [\".jsonl\", \".ndjson\"])\n+    @pytest.mark.parametrize(\"suffix\", [\"\", \"?download=1#records\"])\n+    def test_url_extension(self, extension: str, suffix: str) -> None:\n+        assert (\n+            DataTypes.from_content(f\"https://example.com/records{extension}{suffix}\")\n+            is DataType.JSONL\n+        )\n+\n+    def test_inline_content_remains_text_without_explicit_type(self) -> None:\n+        assert DataTypes.from_content('{\"a\": 1}\\n{\"b\": 2}') is DataType.TEXT\ndiff --git a/lib/crewai-tools/tests/rag/test_rag_core_jsonl.py b/lib/crewai-tools/tests/rag/test_rag_core_jsonl.py\nnew file mode 100644\nindex 0000000000..82e9495324\n--- /dev/null\n+++ b/lib/crewai-tools/tests/rag/test_rag_core_jsonl.py\n@@ -0,0 +1,147 @@\n+\"\"\"JSONL ingestion through the real loader and chunker, with no external services.\"\"\"\n+\n+import json\n+from pathlib import Path\n+from typing import Any\n+from unittest.mock import Mock, patch\n+\n+from crewai_tools.rag.core import RAG\n+from crewai_tools.rag.data_types import DataType\n+import pytest\n+\n+\n+class FakeEmbeddings:\n+    \"\"\"Return deterministic vectors and capture the embedded text.\"\"\"\n+\n+    def __init__(self) -> None:\n+        self.texts: list[str] = []\n+\n+    def embed_batch(self, texts: list[str]) -> list[list[float]]:\n+        self.texts.extend(texts)\n+        return [[1.0, 0.0] for _ in texts]\n+\n+\n+class FakeCollection:\n+    \"\"\"Capture stored documents without starting ChromaDB.\"\"\"\n+\n+    def __init__(self) -> None:\n+        self.documents: list[str] = []\n+        self.ids: list[str] = []\n+        self.embeddings: list[list[float]] = []\n+        self.metadatas: list[dict[str, Any]] = []\n+\n+    def get(self, *, where: dict[str, Any], limit: int) -> dict[str, Any]:\n+        return {\"metadatas\": []}\n+\n+    def add(\n+        self,\n+        *,\n+        ids: list[str],\n+        embeddings: list[list[float]],\n+        documents: list[str],\n+        metadatas: list[dict[str, Any]],\n+    ) -> None:\n+        self.ids.extend(ids)\n+        self.embeddings.extend(embeddings)\n+        self.documents.extend(documents)\n+        self.metadatas.extend(metadatas)\n+\n+\n+@pytest.fixture\n+def rag() -> tuple[RAG, FakeCollection, FakeEmbeddings]:\n+    \"\"\"Use real RAG initialization with fake storage and embeddings.\"\"\"\n+    collection = FakeCollection()\n+    embeddings = FakeEmbeddings()\n+    client = Mock()\n+    client.get_or_create_collection.return_value = collection\n+    with (\n+        patch(\"crewai_tools.rag.core.chromadb.Client\", return_value=client),\n+        patch(\"crewai_tools.rag.core.EmbeddingService\", return_value=embeddings),\n+    ):\n+        instance = RAG()\n+    return instance, collection, embeddings\n+\n+\n+@pytest.mark.parametrize(\n+    (\"extension\", \"data_type\"),\n+    [\n+        (\".jsonl\", None),\n+        (\".ndjson\", None),\n+        (\".txt\", \"jsonl\"),\n+        (\".txt\", DataType.JSONL),\n+    ],\n+)\n+def test_add_jsonl_stores_records(\n+    rag: tuple[RAG, FakeCollection, FakeEmbeddings],\n+    tmp_path: Path,\n+    extension: str,\n+    data_type: str | DataType | None,\n+) -> None:\n+    \"\"\"Explicit selection and discovery preserve JSON values and record order.\"\"\"\n+    instance, collection, embeddings = rag\n+    lines = ['{\"name\": \"caf\u00e9\", \"active\": true}', '{\"items\": [1, null]}', '\"last\"']\n+    path = tmp_path / f\"records{extension}\"\n+    path.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\n+\n+    instance.add(path, data_type=data_type, metadata={\"dataset\": \"example\"})\n+\n+    stored_lines = [\n+        line\n+        for document in collection.documents\n+        for line in document.splitlines()\n+        if line.strip()\n+    ]\n+    assert stored_lines == lines\n+    assert [json.loads(line) for line in stored_lines] == [\n+        {\"name\": \"caf\u00e9\", \"active\": True},\n+        {\"items\": [1, None]},\n+        \"last\",\n+    ]\n+    assert embeddings.texts == collection.documents\n+    assert collection.embeddings == [[1.0, 0.0]] * len(collection.documents)\n+    assert len(collection.ids) == len(collection.documents) > 0\n+    for index, metadata in enumerate(collection.metadatas):\n+        assert metadata[\"data_type\"] == \"jsonl\"\n+        assert metadata[\"source\"] == str(path)\n+        assert metadata[\"dataset\"] == \"example\"\n+        assert metadata[\"chunk_index\"] == index\n+        assert metadata[\"doc_id\"]\n+\n+\n+def test_add_inline_jsonl(\n+    rag: tuple[RAG, FakeCollection, FakeEmbeddings],\n+) -> None:\n+    \"\"\"Inline JSONL requires explicit selection, not a whole-document JSON parser.\"\"\"\n+    instance, collection, _ = rag\n+    instance.add('{\"a\": 1}\\n{\"b\": 2}', data_type=\"jsonl\")\n+    assert [\n+        json.loads(line)\n+        for document in collection.documents\n+        for line in document.splitlines()\n+        if line.strip()\n+    ] == [{\"a\": 1}, {\"b\": 2}]\n+\n+\n+def test_invalid_jsonl_is_not_stored(\n+    rag: tuple[RAG, FakeCollection, FakeEmbeddings], tmp_path: Path\n+) -> None:\n+    \"\"\"Malformed records fail before any embedding or storage.\"\"\"\n+    instance, collection, embeddings = rag\n+    path = tmp_path / \"invalid.jsonl\"\n+    path.write_text('{\"a\": 1}\\nnot json', encoding=\"utf-8\")\n+    with pytest.raises(ValueError, match=\"line 2\"):\n+        instance.add(path)\n+    assert collection.documents == []\n+    assert embeddings.texts == []\n+\n+\n+def test_empty_jsonl_is_not_stored(\n+    rag: tuple[RAG, FakeCollection, FakeEmbeddings], tmp_path: Path\n+) -> None:\n+    \"\"\"Empty loader output does not produce embeddings or documents.\"\"\"\n+    instance, collection, embeddings = rag\n+    path = tmp_path / \"empty.jsonl\"\n+    path.write_text(\"\", encoding=\"utf-8\")\n+    instance.add(path)\n+    assert collection.documents == []\n+    assert embeddings.texts == []\ndiff --git a/lib/crewai-tools/tests/tools/rag/test_rag_tool_add_data_type.py b/lib/crewai-tools/tests/tools/rag/test_rag_tool_add_data_type.py\nindex b1cf60bd9e..4bd0c5a176 100644\n--- a/lib/crewai-tools/tests/tools/rag/test_rag_tool_add_data_type.py\n+++ b/lib/crewai-tools/tests/tools/rag/test_rag_tool_add_data_type.py\n@@ -475,4 +475,81 @@ def test_metadata_passed_to_documents(\n             assert any(\n                 doc.get(\"metadata\", {}).get(\"custom_key\") == \"custom_value\"\n                 for doc in documents\n-            )\n\\ No newline at end of file\n+            )\n+\n+\n+class TestJSONLIngestion:\n+    \"\"\"JSONL registration works through the public RagTool API.\"\"\"\n+\n+    @pytest.mark.parametrize(\n+        (\"extension\", \"data_type\"),\n+        [\n+            (\".jsonl\", None),\n+            (\".ndjson\", None),\n+            (\".txt\", \"jsonl\"),\n+            (\".txt\", DataType.JSONL),\n+            (\".jsonl\", \"file\"),\n+        ],\n+    )\n+    def test_add_records(\n+        self,\n+        rag_tool: RagTool,\n+        mock_rag_client: MagicMock,\n+        tmp_path: Path,\n+        extension: str,\n+        data_type: str | DataType | None,\n+    ) -> None:\n+        \"\"\"Store the real loader's records and metadata, not just a mock result.\"\"\"\n+        lines = ['{\"name\": \"first\", \"active\": true}', '{\"items\": [1, null]}', '\"last\"']\n+        path = tmp_path / f\"records{extension}\"\n+        path.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\n+\n+        rag_tool.add(path, data_type=data_type, metadata={\"dataset\": \"example\"})\n+\n+        mock_rag_client.add_documents.assert_called_once()\n+        documents = mock_rag_client.add_documents.call_args.kwargs[\"documents\"]\n+        assert [\n+            line\n+            for document in documents\n+            for line in document[\"content\"].splitlines()\n+            if line.strip()\n+        ] == lines\n+        for document in documents:\n+            metadata = document[\"metadata\"]\n+            assert metadata[\"data_type\"] == str(DataType.JSONL)\n+            assert metadata[\"format\"] == \"jsonl\"\n+            assert metadata[\"record_count\"] == 3\n+            assert metadata[\"dataset\"] == \"example\"\n+            assert metadata[\"source\"] == str(path)\n+\n+    @pytest.mark.parametrize(\"extension\", [\".jsonl\", \".ndjson\"])\n+    @pytest.mark.parametrize(\"data_type\", [None, \"jsonl\", DataType.JSONL])\n+    def test_missing_file(\n+        self,\n+        rag_tool: RagTool,\n+        tmp_path: Path,\n+        extension: str,\n+        data_type: str | DataType | None,\n+    ) -> None:\n+        \"\"\"Missing JSONL paths fail consistently for explicit and inferred types.\"\"\"\n+        with pytest.raises(FileNotFoundError, match=\"File does not exist\"):\n+            rag_tool.add(path=tmp_path / f\"missing{extension}\", data_type=data_type)\n+\n+    def test_directory_discovers_jsonl(\n+        self, rag_tool: RagTool, mock_rag_client: MagicMock, tmp_path: Path\n+    ) -> None:\n+        \"\"\"Directory ingestion uses the same JSONL loader registry.\"\"\"\n+        path = tmp_path / \"records.ndjson\"\n+        path.write_text('{\"first\": 1}\\n{\"second\": 2}', encoding=\"utf-8\")\n+\n+        rag_tool.add(tmp_path)\n+\n+        mock_rag_client.add_documents.assert_called_once()\n+        documents = mock_rag_client.add_documents.call_args.kwargs[\"documents\"]\n+        assert [\n+            line\n+            for document in documents\n+            for line in document[\"content\"].splitlines()\n+            if line.strip()\n+        ] == ['{\"first\": 1}', '{\"second\": 2}']\n+        assert all(doc[\"metadata\"][\"record_count\"] == 2 for doc in documents)\n\\ No newline at end of file\n", "problem_statement": "[FEATURE] Wire JSONL into RAG DataType discovery and ingestion\n## Python PR scope\n\nIntegrate the JSONL loader into explicit DataType selection and .jsonl/.ndjson discovery, choosing an existing appropriate chunker where possible.\n\n**Difficulty:** medium. **Allocation index:** #8118. **Project:** #8119.\n\n## Cohort allocation\n\nThis ticket is reserved for maintainer-coordinated allocation to the Stanford semester collaboration. Please wait for @lorenzejay to confirm an assignee before implementing. A comment expresses interest; it does not establish ownership. Public `good first issue` / `help wanted` discovery labels will be considered after cohort allocation.\n\nGitHub usernames have not yet been supplied, so no individual assignment is implied.\n\n## Acceptance criteria\n\n- [ ] Add a DataType entry, loader mapping, and chunker mapping without a second detection framework.\n- [ ] Test explicit type selection and path/URL extension recognition without fetching real URLs.\n- [ ] Use fake embeddings and a fake collection to verify that add() stores the expected records/text.\n- [ ] Do not confuse a multi-line JSONL stream with one JSON document.\n- [ ] Coordinate existing case-insensitive detection work in #7828 rather than duplicating that fix.\n\n## Dependencies and coordination\n\n- Depends on #8130.\n\n## Starting points\n\n- [lib/crewai-tools/src/crewai_tools/rag/data_types.py](https://github.com/crewAIInc/crewAI/blob/main/lib/crewai-tools/src/crewai_tools/rag/data_types.py)\n- [lib/crewai-tools/src/crewai_tools/rag/core.py](https://github.com/crewAIInc/crewAI/blob/main/lib/crewai-tools/src/crewai_tools/rag/core.py)\n- [lib/crewai-tools/tests/rag/test_data_types.py](https://github.com/crewAIInc/crewAI/blob/main/lib/crewai-tools/tests/rag/test_data_types.py)\n- [lib/crewai-tools/tests/tools/rag](https://github.com/crewAIInc/crewAI/tree/main/lib/crewai-tools/tests/tools/rag)\n- [API/format reference](https://jsonlines.org/)\n\n## Submission\n\nThe contributor implements this scope and submits one focused PR linked to this open issue. Include full Python annotations, behavioral tests, and relevant quality checks. No paid API calls are required for the tests. Preserve existing APIs outside the scoped feature. For newly found defects, reproduce them and check active issues/PRs before fixing them. Docs edits, when needed, belong under `docs/edge/` and must sync ar, ko, pt-BR per `DOCS_TRANSLATIONS.md`. Follow [.github/CONTRIBUTING.md](https://github.com/crewAIInc/crewAI/blob/main/.github/CONTRIBUTING.md). Issue prepared with AI assistance.\n", "hints_text": "Hi @lorenzejay, I would like to take this issue. Could you please assign it to me? Thanks!\n@lorenzejay, I'm a part of the CS 146S class, and would love to work on this! \nUsername: aadeshsalecha", "created_at": "2026-10-29T01:53:11Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8678, "instance_id": "crewAIInc__crewAI-8678", "issue_numbers": ["8679"], "base_commit": "bc5728b8852ccb8ef768864fb6f8d640c4b9d9af", "patch": "diff --git a/lib/crewai/src/crewai/llm.py b/lib/crewai/src/crewai/llm.py\nindex 0eb6146228..76b0415184 100644\n--- a/lib/crewai/src/crewai/llm.py\n+++ b/lib/crewai/src/crewai/llm.py\n@@ -1048,6 +1048,16 @@ def _handle_streaming_response(\n                     if tool_arg.function.name\n                 ]\n                 if tool_calls_list:\n+                    self._handle_emit_call_events(\n+                        response=tool_calls_list,\n+                        call_type=LLMCallType.TOOL_CALL,\n+                        from_task=from_task,\n+                        from_agent=from_agent,\n+                        messages=params[\"messages\"],\n+                        usage=self._usage_to_dict(usage_info),\n+                        finish_reason=stream_finish_reason,\n+                        response_id=stream_response_id,\n+                    )\n                     return tool_calls_list\n \n             finish_reason, response_id_last = (\n@@ -1281,15 +1291,23 @@ def _handle_non_streaming_response(\n                 llm=self,\n             )\n             with model_call_hooks_dispatched():\n-                result = instructor_instance.to_pydantic()\n+                result, completion = instructor_instance.to_pydantic_with_completion()\n             structured_response = result.model_dump_json()\n+            usage_info = self._completion_usage(completion)\n+            if usage_info:\n+                self._track_token_usage_internal(usage_info)\n+            finish_reason, response_id = self._extract_finish_reason_and_response_id(\n+                completion\n+            )\n             self._handle_emit_call_events(\n                 response=structured_response,\n                 call_type=LLMCallType.LLM_CALL,\n                 from_task=from_task,\n                 from_agent=from_agent,\n                 messages=messages,\n-                usage=None,\n+                usage=self._usage_to_dict(usage_info),\n+                finish_reason=finish_reason,\n+                response_id=response_id,\n             )\n             return structured_response\n \n@@ -1364,6 +1382,16 @@ def _handle_non_streaming_response(\n         tool_calls = response_message.tool_calls or []\n \n         if tool_calls and not available_functions:\n+            self._handle_emit_call_events(\n+                response=tool_calls,\n+                call_type=LLMCallType.TOOL_CALL,\n+                from_task=from_task,\n+                from_agent=from_agent,\n+                messages=params[\"messages\"],\n+                usage=response_usage,\n+                finish_reason=finish_reason,\n+                response_id=response_id,\n+            )\n             return tool_calls\n \n         if not tool_calls and text_response:\n@@ -1440,15 +1468,23 @@ async def _ahandle_non_streaming_response(\n                 llm=self,\n             )\n             with model_call_hooks_dispatched():\n-                result = instructor_instance.to_pydantic()\n+                result, completion = instructor_instance.to_pydantic_with_completion()\n             structured_response = result.model_dump_json()\n+            usage_info = self._completion_usage(completion)\n+            if usage_info:\n+                self._track_token_usage_internal(usage_info)\n+            finish_reason, response_id = self._extract_finish_reason_and_response_id(\n+                completion\n+            )\n             self._handle_emit_call_events(\n                 response=structured_response,\n                 call_type=LLMCallType.LLM_CALL,\n                 from_task=from_task,\n                 from_agent=from_agent,\n                 messages=messages,\n-                usage=None,\n+                usage=self._usage_to_dict(usage_info),\n+                finish_reason=finish_reason,\n+                response_id=response_id,\n             )\n             return structured_response\n \n@@ -1520,6 +1556,16 @@ async def _ahandle_non_streaming_response(\n         tool_calls = response_message.tool_calls or []\n \n         if tool_calls and not available_functions:\n+            self._handle_emit_call_events(\n+                response=tool_calls,\n+                call_type=LLMCallType.TOOL_CALL,\n+                from_task=from_task,\n+                from_agent=from_agent,\n+                messages=params[\"messages\"],\n+                usage=response_usage,\n+                finish_reason=finish_reason,\n+                response_id=response_id,\n+            )\n             return tool_calls\n \n         if not tool_calls and text_response:\n@@ -1725,6 +1771,16 @@ async def _ahandle_streaming_response(\n                         if result is not None:\n                             return result\n                     else:\n+                        self._handle_emit_call_events(\n+                            response=tool_calls_list,\n+                            call_type=LLMCallType.TOOL_CALL,\n+                            from_task=from_task,\n+                            from_agent=from_agent,\n+                            messages=params.get(\"messages\"),\n+                            usage=self._usage_to_dict(usage_info),\n+                            finish_reason=stream_finish_reason,\n+                            response_id=stream_response_id,\n+                        )\n                         return tool_calls_list\n \n             usage_dict = self._usage_to_dict(usage_info)\n@@ -2137,6 +2193,17 @@ async def acall(\n                     )\n                     raise\n \n+    @staticmethod\n+    def _completion_usage(completion: Any) -> Any:\n+        \"\"\"Usage from a raw LiteLLM completion, read from ``model_extra``.\n+\n+        Avoids ``isinstance(..., ModelResponseBase)``: that name stays None\n+        until ``_ensure_litellm()`` runs, which an LLM built without\n+        ``__init__`` (e.g. restored) may not have done yet.\n+        \"\"\"\n+        extra = getattr(completion, \"model_extra\", None)\n+        return extra.get(\"usage\") if isinstance(extra, dict) else None\n+\n     @staticmethod\n     def _usage_to_dict(usage: Any) -> dict[str, Any] | None:\n         \"\"\"Convert a provider usage object to a plain dict and flatten the\ndiff --git a/lib/crewai/src/crewai/utilities/internal_instructor.py b/lib/crewai/src/crewai/utilities/internal_instructor.py\nindex 21020275a7..ea64041ad7 100644\n--- a/lib/crewai/src/crewai/utilities/internal_instructor.py\n+++ b/lib/crewai/src/crewai/utilities/internal_instructor.py\n@@ -147,6 +147,30 @@ def to_pydantic(self) -> T:\n                 the call by returning ``False``.\n             HookAborted: If a hook denied the call.\n         \"\"\"\n+        return self._client.chat.completions.create(  # type: ignore[no-any-return]\n+            **self._request_kwargs()\n+        )\n+\n+    def to_pydantic_with_completion(self) -> tuple[T, Any]:\n+        \"\"\"Generate structured output and return the raw provider completion too.\n+\n+        The completion carries the token usage of the call, summed across\n+        instructor's retries, which ``to_pydantic`` discards.\n+\n+        Returns:\n+            Tuple of the Pydantic model instance and the raw completion\n+\n+        Raises:\n+            ValueError: If LLM is not provided or invalid, or if a hook blocked\n+                the call by returning ``False``.\n+            HookAborted: If a hook denied the call.\n+        \"\"\"\n+        return self._client.chat.completions.create_with_completion(  # type: ignore[no-any-return]\n+            **self._request_kwargs()\n+        )\n+\n+    def _request_kwargs(self) -> dict[str, Any]:\n+        \"\"\"Validate the LLM, dispatch before-call hooks and build the request.\"\"\"\n         from crewai.llms.base_llm import BaseLLM\n \n         messages: list[LLMMessage] = [{\"role\": \"user\", \"content\": self.content}]\n@@ -166,6 +190,4 @@ def to_pydantic(self) -> T:\n             # layer would have dispatched are dispatched here instead.\n             self.llm._invoke_before_llm_call_hooks(messages, self.agent)\n \n-        return self._client.chat.completions.create(  # type: ignore[no-any-return]\n-            model=model_name, response_model=self.model, messages=messages\n-        )\n+        return {\"model\": model_name, \"response_model\": self.model, \"messages\": messages}\n", "test_patch": "diff --git a/lib/crewai/tests/hooks/test_model_call_hook_reach.py b/lib/crewai/tests/hooks/test_model_call_hook_reach.py\nindex ad89d92390..f465ed2db9 100644\n--- a/lib/crewai/tests/hooks/test_model_call_hook_reach.py\n+++ b/lib/crewai/tests/hooks/test_model_call_hook_reach.py\n@@ -118,7 +118,10 @@ class Answer(BaseModel):\n \n     client = SimpleNamespace(\n         chat=SimpleNamespace(\n-            completions=SimpleNamespace(create=lambda **_: Answer(text=\"ok\"))\n+            completions=SimpleNamespace(\n+                create=lambda **_: Answer(text=\"ok\"),\n+                create_with_completion=lambda **_: (Answer(text=\"ok\"), None),\n+            )\n         )\n     )\n     monkeypatch.setattr(instructor, \"from_litellm\", lambda *_, **__: client)\ndiff --git a/lib/crewai/tests/llms/test_structured_output_multimodal.py b/lib/crewai/tests/llms/test_structured_output_multimodal.py\nindex 2f73879e93..ee7ce8038b 100644\n--- a/lib/crewai/tests/llms/test_structured_output_multimodal.py\n+++ b/lib/crewai/tests/llms/test_structured_output_multimodal.py\n@@ -34,8 +34,8 @@ class FakeInstructor:\n         def __init__(self, *, content, model, llm):\n             captured[\"content\"] = content\n \n-        def to_pydantic(self):\n-            return Answer(text=\"ok\")\n+        def to_pydantic_with_completion(self):\n+            return Answer(text=\"ok\"), None\n \n     patcher = patch(\n         \"crewai.utilities.internal_instructor.InternalInstructor\", FakeInstructor\ndiff --git a/lib/crewai/tests/test_llm.py b/lib/crewai/tests/test_llm.py\nindex 0967c001a5..0e7c1b501a 100644\n--- a/lib/crewai/tests/test_llm.py\n+++ b/lib/crewai/tests/test_llm.py\n@@ -737,6 +737,7 @@ def test_handle_streaming_tool_calls_no_available_functions(\n \n     assert_event_count(\n         mock_emit=mock_emit,\n+        expected_completed_tool_call=1,\n         expected_stream_chunk=9,\n         expected_completed_llm_call=0,\n         expected_final_chunk_result='{\"location\":\"New York, NY\"}',\ndiff --git a/lib/crewai/tests/test_llm_litellm_usage_events.py b/lib/crewai/tests/test_llm_litellm_usage_events.py\nnew file mode 100644\nindex 0000000000..e2f9fb2a63\n--- /dev/null\n+++ b/lib/crewai/tests/test_llm_litellm_usage_events.py\n@@ -0,0 +1,208 @@\n+\"\"\"Regression: on the LiteLLM fallback path, two kinds of call reached the\n+platform without token usage, so traces showed requests with 0 tokens/$0.\n+\n+- Native tool-call turns (``available_functions`` is None, as the agent\n+  executor calls it) returned the tool calls without emitting\n+  ``LLMCallCompletedEvent`` at all.\n+- Structured output through Instructor (``response_model``) emitted the event\n+  with ``usage=None``.\n+\n+Native providers already emit a ``tool_call`` completion with usage; these\n+tests pin the same for LiteLLM.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+from typing import Any\n+from unittest.mock import AsyncMock, patch\n+\n+import pytest\n+from pydantic import BaseModel\n+\n+from crewai.events.event_bus import crewai_event_bus\n+from crewai.events.types.llm_events import LLMCallCompletedEvent, LLMCallType\n+from crewai.llm import LLM\n+\n+\n+USAGE = {\"prompt_tokens\": 11, \"completion_tokens\": 7, \"total_tokens\": 18}\n+TOOLS = [\n+    {\n+        \"type\": \"function\",\n+        \"function\": {\n+            \"name\": \"get_weather\",\n+            \"description\": \"Get the weather for a location\",\n+            \"parameters\": {\n+                \"type\": \"object\",\n+                \"properties\": {\"location\": {\"type\": \"string\"}},\n+                \"required\": [\"location\"],\n+            },\n+        },\n+    }\n+]\n+\n+\n+class Brief(BaseModel):\n+    title: str\n+\n+\n+@pytest.fixture\n+def mock_emit():\n+    with patch.object(crewai_event_bus, \"emit\") as mock:\n+        yield mock\n+\n+\n+def _completed_event(mock_emit) -> LLMCallCompletedEvent:\n+    matches = [\n+        call.kwargs[\"event\"]\n+        for call in mock_emit.call_args_list\n+        if isinstance(call.kwargs.get(\"event\"), LLMCallCompletedEvent)\n+    ]\n+    assert len(matches) == 1, f\"expected one completed event, got {len(matches)}\"\n+    return matches[0]\n+\n+\n+def _tool_call_response(name: str, arguments: str) -> Any:\n+    from litellm import ModelResponse\n+\n+    return ModelResponse(\n+        id=\"chatcmpl-tools-1\",\n+        choices=[\n+            {\n+                \"finish_reason\": \"tool_calls\",\n+                \"message\": {\n+                    \"role\": \"assistant\",\n+                    \"content\": None,\n+                    \"tool_calls\": [\n+                        {\n+                            \"id\": \"call_1\",\n+                            \"type\": \"function\",\n+                            \"function\": {\"name\": name, \"arguments\": arguments},\n+                        }\n+                    ],\n+                },\n+            }\n+        ],\n+        usage=USAGE,\n+    )\n+\n+\n+def _tool_call_stream() -> list[Any]:\n+    from litellm.types.utils import (\n+        ChatCompletionDeltaToolCall,\n+        Function,\n+        ModelResponseStream,\n+    )\n+\n+    return [\n+        {\n+            \"id\": \"chatcmpl-stream-tools\",\n+            \"choices\": [\n+                {\n+                    \"delta\": {\n+                        \"tool_calls\": [\n+                            ChatCompletionDeltaToolCall(\n+                                index=0,\n+                                id=\"call_1\",\n+                                function=Function(\n+                                    name=\"get_weather\",\n+                                    arguments='{\"location\": \"NYC\"}',\n+                                ),\n+                            )\n+                        ]\n+                    },\n+                    \"finish_reason\": \"tool_calls\",\n+                }\n+            ],\n+        },\n+        # LiteLLM's include_usage tail, as the real stream yields it.\n+        ModelResponseStream(id=\"chatcmpl-stream-tools\", choices=[], usage=USAGE),\n+    ]\n+\n+\n+def _assert_tool_call_usage(event: LLMCallCompletedEvent) -> None:\n+    assert event.call_type == LLMCallType.TOOL_CALL\n+    assert event.usage is not None\n+    assert event.usage[\"prompt_tokens\"] == 11\n+    assert event.usage[\"completion_tokens\"] == 7\n+\n+\n+def test_tool_call_turn_emits_completed_event_with_usage(mock_emit):\n+    llm = LLM(model=\"gpt-4o-mini\", is_litellm=True)\n+\n+    with patch(\n+        \"crewai.llm.litellm.completion\",\n+        return_value=_tool_call_response(\"get_weather\", '{\"location\": \"NYC\"}'),\n+    ):\n+        result = llm.call(\"What's the weather in NYC?\", tools=TOOLS)\n+\n+    assert result[0].function.name == \"get_weather\"\n+    event = _completed_event(mock_emit)\n+    _assert_tool_call_usage(event)\n+    assert event.finish_reason == \"tool_calls\"\n+    assert event.response_id == \"chatcmpl-tools-1\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_async_tool_call_turn_emits_completed_event_with_usage(mock_emit):\n+    llm = LLM(model=\"gpt-4o-mini\", is_litellm=True)\n+\n+    with patch(\n+        \"crewai.llm.litellm.acompletion\",\n+        new=AsyncMock(\n+            return_value=_tool_call_response(\"get_weather\", '{\"location\": \"NYC\"}')\n+        ),\n+    ):\n+        result = await llm.acall(\"What's the weather in NYC?\", tools=TOOLS)\n+\n+    assert result[0].function.name == \"get_weather\"\n+    _assert_tool_call_usage(_completed_event(mock_emit))\n+\n+\n+def test_streaming_tool_call_turn_emits_completed_event_with_usage(mock_emit):\n+    llm = LLM(model=\"gpt-4o-mini\", is_litellm=True, stream=True)\n+\n+    with patch(\"crewai.llm.litellm.completion\", return_value=iter(_tool_call_stream())):\n+        result = llm.call(\"What's the weather in NYC?\", tools=TOOLS)\n+\n+    assert result[0].function.name == \"get_weather\"\n+    event = _completed_event(mock_emit)\n+    _assert_tool_call_usage(event)\n+    assert event.response_id == \"chatcmpl-stream-tools\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_async_streaming_tool_call_turn_emits_completed_event_with_usage(\n+    mock_emit,\n+):\n+    llm = LLM(model=\"gpt-4o-mini\", is_litellm=True, stream=True)\n+\n+    async def _aiter():\n+        for chunk in _tool_call_stream():\n+            yield chunk\n+\n+    async def _acompletion(*_args, **_kwargs):\n+        return _aiter()\n+\n+    with patch(\"crewai.llm.litellm.acompletion\", side_effect=_acompletion):\n+        result = await llm.acall(\"What's the weather in NYC?\", tools=TOOLS)\n+\n+    assert result[0].function.name == \"get_weather\"\n+    _assert_tool_call_usage(_completed_event(mock_emit))\n+\n+\n+def test_structured_output_emits_completed_event_with_usage(mock_emit):\n+    llm = LLM(model=\"gpt-4o-mini\", is_litellm=True)\n+\n+    with patch(\n+        \"litellm.completion\",\n+        return_value=_tool_call_response(\"Brief\", '{\"title\": \"Usage matters\"}'),\n+    ):\n+        result = llm.call(\"Write a brief\", response_model=Brief)\n+\n+    assert Brief.model_validate_json(result).title == \"Usage matters\"\n+    event = _completed_event(mock_emit)\n+    assert event.call_type == LLMCallType.LLM_CALL\n+    assert event.usage is not None\n+    assert event.usage[\"prompt_tokens\"] == 11\n+    assert event.usage[\"completion_tokens\"] == 7\n+    assert llm.get_token_usage_summary().total_tokens == 18\n", "problem_statement": "[BUG] LiteLLM path drops token usage for tool-call turns and structured output (response_model)\n\ud83e\udd16 [agent on alexmarchenko-crewai's behalf]\n\n### Description\n\nWhen an `LLM` uses the LiteLLM fallback path, two kinds of call never report token usage. That covers `LLM(model=..., is_litellm=True)` and any model prefix that isn't a native provider, for example `litellm_proxy/...`.\n\n1. **Native tool-call turns.** These are calls with tools but no `available_functions`, which is how the agent executor makes them. They return the tool calls without emitting `LLMCallCompletedEvent`. This happens in sync and async handlers, streaming and non-streaming.\n2. **Structured output through Instructor** (`response_model`, e.g. a task with `output_pydantic`). `LLMCallCompletedEvent` is emitted with `usage=None`, and the tokens are never tracked.\n\nTracing still records these calls, so traces show requests with 0 tokens and $0 cost. The native OpenAI, Azure and Anthropic providers report usage for both cases.\n\n### Steps to Reproduce\n\n1. Create `LLM(model=\"anthropic/claude-sonnet-4-5\", is_litellm=True)`. Any LiteLLM-routed model shows the same behavior.\n2. Run a crew with a task that has `output_pydantic=SomeModel`, and a crew whose agent has one tool.\n3. Listen on `crewai_event_bus` for `LLMCallStartedEvent` and `LLMCallCompletedEvent`, and inspect `event.usage`.\n\n### Expected behavior\n\nEvery LLM call emits `LLMCallCompletedEvent` with `usage` populated, the same as on the native providers:\n- Tool-call turns should emit a `tool_call` completion.\n- Structured-output calls should carry the completion's token usage.\n\n### Screenshots/Code snippets\n\nObserved on 1.15.29 with the LiteLLM path:\n\n| Scenario | Started | Completed | Completed with usage |\n|---|---|---|---|\n| Plain task | 1 | 1 | 1 |\n| Task with `output_pydantic` | 1 | 1 | **0** (`usage=None`) |\n| Agent with a tool | 2 | **1** (the tool-call turn emits no completion) | 1 |\n\n### Operating System\n\nmacOS\n\n### Python Version\n\n3.12\n\n### crewAI Version\n\n1.15.29 (also present on `main` / 1.15.30)\n\n### crewAI Tools Version\n\nN/A\n\n### Virtual Environment\n\nuv\n\n### Evidence\n\nThe drop points are in `lib/crewai/src/crewai/llm.py`:\n- `if tool_calls and not available_functions: return tool_calls` in the four response handlers.\n- The `response_model and self.is_litellm` branch, which emits `usage=None`.\n\n### Possible Solution\n\n- Emit a `TOOL_CALL` completion with usage before returning tool calls, as the native providers do.\n- For structured output, get the raw completion from Instructor's `create_with_completion` and report its usage.\n\nImplemented in #8678.\n\n### Additional context\n\nNone.\n\n", "hints_text": "", "created_at": "2026-10-27T17:30:36Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8648, "instance_id": "crewAIInc__crewAI-8648", "issue_numbers": ["8647"], "base_commit": "bb4d892e684e9289422e816b8769e7976fdd451a", "patch": "diff --git a/lib/crewai/src/crewai/utilities/guardrail.py b/lib/crewai/src/crewai/utilities/guardrail.py\nindex bbe3d74409..c19ce1fb9d 100644\n--- a/lib/crewai/src/crewai/utilities/guardrail.py\n+++ b/lib/crewai/src/crewai/utilities/guardrail.py\n@@ -166,6 +166,7 @@ def process_guardrail(\n \n     try:\n         result = guardrail(output)\n+        guardrail_result = GuardrailResult.from_tuple(result)\n     except HookAborted as e:\n         # a deny ends the validation, so the started event above still needs a\n         # terminal one before it leaves\n@@ -202,8 +203,6 @@ def process_guardrail(\n         )\n         raise\n \n-    guardrail_result = GuardrailResult.from_tuple(result)\n-\n     crewai_event_bus.emit(\n         event_source,\n         LLMGuardrailCompletedEvent(\n", "test_patch": "diff --git a/lib/crewai/tests/test_guardrail_events_on_exception.py b/lib/crewai/tests/test_guardrail_events_on_exception.py\nindex 026c615bc0..7e75104326 100644\n--- a/lib/crewai/tests/test_guardrail_events_on_exception.py\n+++ b/lib/crewai/tests/test_guardrail_events_on_exception.py\n@@ -74,3 +74,69 @@ def raising_guardrail(_output: Any) -> tuple[bool, str]:\n                 output=task_output, guardrail=raising_guardrail, retry_count=1\n             )\n         wait_for_event_handlers()\n+\n+\n+@pytest.mark.parametrize(\n+    (\"returned\", \"error_type\"),\n+    [((False, 42), \"ValidationError\"), ((True, \"hi\", \"extra\"), \"ValueError\")],\n+    ids=[\"non-string-error\", \"three-tuple\"],\n+)\n+def test_a_malformed_guardrail_result_still_reports_the_validation_it_started(\n+    returned: Any, error_type: str\n+):\n+    task_output = TaskOutput(\n+        description=\"Say hi\", raw=\"hi\", agent=\"Doer\", expected_output=\"A greeting.\"\n+    )\n+\n+    def malformed_guardrail(_output: Any) -> Any:\n+        return returned\n+\n+    started: list[LLMGuardrailStartedEvent] = []\n+    completed: list[LLMGuardrailCompletedEvent] = []\n+\n+    with crewai_event_bus.scoped_handlers():\n+\n+        @crewai_event_bus.on(LLMGuardrailStartedEvent)\n+        def _on_started(_source: Any, event: LLMGuardrailStartedEvent) -> None:\n+            started.append(event)\n+\n+        @crewai_event_bus.on(LLMGuardrailCompletedEvent)\n+        def _on_completed(_source: Any, event: LLMGuardrailCompletedEvent) -> None:\n+            completed.append(event)\n+\n+        with pytest.raises(ValueError):\n+            process_guardrail(\n+                output=task_output, guardrail=malformed_guardrail, retry_count=0\n+            )\n+\n+        wait_for_event_handlers()\n+\n+    assert len(started) == 1\n+    assert len(completed) == 1\n+    assert completed[0].success is False\n+    assert (completed[0].error or \"\").startswith(error_type)\n+\n+\n+def test_a_valid_guardrail_result_reports_one_completed_event():\n+    task_output = TaskOutput(\n+        description=\"Say hi\", raw=\"hi\", agent=\"Doer\", expected_output=\"A greeting.\"\n+    )\n+\n+    completed: list[LLMGuardrailCompletedEvent] = []\n+\n+    with crewai_event_bus.scoped_handlers():\n+\n+        @crewai_event_bus.on(LLMGuardrailCompletedEvent)\n+        def _on_completed(_source: Any, event: LLMGuardrailCompletedEvent) -> None:\n+            completed.append(event)\n+\n+        result = process_guardrail(\n+            output=task_output, guardrail=lambda o: (False, \"too short\"), retry_count=0\n+        )\n+\n+        wait_for_event_handlers()\n+\n+    assert result.error == \"too short\"\n+    assert len(completed) == 1\n+    assert completed[0].success is False\n+    assert completed[0].error == \"too short\"\n", "problem_statement": "[BUG]A guardrail that returns a malformed result leaves LLMGuardrailStartedEvent without its completed event\n### Description\n\n`process_guardrail` emits `LLMGuardrailStartedEvent`, calls the guardrail, then converts its return value with\n`GuardrailResult.from_tuple`. #8403 put the guardrail call in a `try` so an exception still emits\n`LLMGuardrailCompletedEvent`, but the conversion runs after that block. A guardrail that returns the wrong shape,\nfor example `(False, 42)` (the error must be a string) or a three-item tuple, raises from `from_tuple` and no\ncompleted event is emitted.\n\nThe started scope stays on the event stack. `Agent.kickoff` logs an event pairing mismatch for\n`lite_agent_execution_error`, `Crew.kickoff` logs mismatches for `task_failed` and `crew_kickoff_failed`, and later\nevents in the same context get the wrong parent. The \"evaluate guardrail\" trace span is left open, the same symptom\n#8403 fixed for a guardrail that raises.\n\n### Steps to Reproduce\n\n1. Give an agent or a task a callable guardrail that returns `(False, 42)`.\n2. Run `agent.kickoff(\"hi\")` or `crew.kickoff()`.\n3. Listen for `LLMGuardrailStartedEvent` and `LLMGuardrailCompletedEvent`.\n\n### Expected behavior\n\nThe run fails with the same error as today, and the started event is closed by a `LLMGuardrailCompletedEvent` with\n`success=False`, as it is when the guardrail raises.\n\n### Screenshots/Code snippets\n\n```python\nfrom typing import Any\n\nfrom crewai import Agent\nfrom crewai.events.event_bus import crewai_event_bus\nfrom crewai.events.types.llm_guardrail_events import (\n    LLMGuardrailCompletedEvent,\n    LLMGuardrailStartedEvent,\n)\nfrom crewai.llms.base_llm import BaseLLM\n\n\nclass FinalLLM(BaseLLM):\n    def __init__(self) -> None:\n        super().__init__(model=\"offline\")\n\n    def supports_function_calling(self) -> bool:\n        return False\n\n    def call(self, messages: Any, **kwargs: Any) -> str:\n        return \"Thought: done\\nFinal Answer: ok\"\n\n    async def acall(self, messages: Any, **kwargs: Any) -> str:\n        return self.call(messages, **kwargs)\n\n\nseen = []\nwith crewai_event_bus.scoped_handlers():\n\n    @crewai_event_bus.on(LLMGuardrailStartedEvent)\n    def _started(_source: Any, _event: Any) -> None:\n        seen.append(\"started\")\n\n    @crewai_event_bus.on(LLMGuardrailCompletedEvent)\n    def _completed(_source: Any, _event: Any) -> None:\n        seen.append(\"completed\")\n\n    agent = Agent(\n        role=\"r\", goal=\"g\", backstory=\"b\", llm=FinalLLM(), guardrail=lambda o: (False, 42)\n    )\n    try:\n        agent.kickoff(\"hi\")\n    except Exception as e:\n        print(type(e).__name__)\n    crewai_event_bus.flush()\n\nprint(seen)\n```\n\n### Operating System\n\nmacOS Monterey\n\n### Python Version\n\n3.12\n\n### crewAI Version\n\n1.15.30 (main @ bb4d892e6)\n\n### crewAI Tools Version\n\n N/A (not used in the repro)\n\n### Virtual Environment\n\nVenv\n\n### Evidence\n\n```\n[CrewAIEventsBus] Warning: Event pairing mismatch. 'lite_agent_execution_error' ...\nValidationError\n['started']\n```\nA guardrail that raises instead prints `['started', 'completed']` since #8403.\n\n### Possible Solution\n\nCall `GuardrailResult.from_tuple(result)` inside the existing `try` block, so a conversion error takes the same\nterminal path as a guardrail that raises.\n\n\n### Additional context\n\nReproduced on Python 3.13 with a uv-managed venv (3.13 is not in the version dropdown). Follow-up to\n#8403.\n", "hints_text": "", "created_at": "2026-10-27T06:32:05Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8642, "instance_id": "crewAIInc__crewAI-8642", "issue_numbers": ["8641"], "base_commit": "00ef9ea1568f6ff5af9accc5ecfe7eb58f6fe8dd", "patch": "diff --git a/lib/crewai-files/src/crewai_files/cache/cleanup.py b/lib/crewai-files/src/crewai_files/cache/cleanup.py\nindex 8861ef8d48..a3fe01934d 100644\n--- a/lib/crewai-files/src/crewai_files/cache/cleanup.py\n+++ b/lib/crewai-files/src/crewai_files/cache/cleanup.py\n@@ -362,7 +362,8 @@ async def delete_single(target_file_id: str) -> bool:\n \n     if delete_all_from_provider:\n         try:\n-            files = uploader.list_files()\n+            # list_files() hits the provider API synchronously; keep it off the loop.\n+            files = await asyncio.to_thread(uploader.list_files)\n             tasks = []\n             for file_info in files:\n                 fid = file_info.get(\"id\") or file_info.get(\"name\")\n", "test_patch": "diff --git a/lib/crewai-files/tests/test_acleanup_listing_nonblocking.py b/lib/crewai-files/tests/test_acleanup_listing_nonblocking.py\nnew file mode 100644\nindex 0000000000..48830c7a55\n--- /dev/null\n+++ b/lib/crewai-files/tests/test_acleanup_listing_nonblocking.py\n@@ -0,0 +1,49 @@\n+\"\"\"acleanup_provider_files must not run the provider's synchronous listing on the event loop.\"\"\"\n+\n+import asyncio\n+import time\n+from typing import Any\n+\n+import crewai_files.cache.cleanup as cleanup_module\n+from crewai_files.cache.cleanup import acleanup_provider_files\n+\n+\n+class BlockingListUploader:\n+    \"\"\"Uploader whose sync listing stalls like a real network call.\"\"\"\n+\n+    def list_files(self) -> list[dict[str, Any]]:\n+        time.sleep(0.5)\n+        return [{\"id\": \"file-1\"}]\n+\n+    async def adelete(self, file_id: str) -> bool:\n+        return True\n+\n+\n+def test_acleanup_delete_all_listing_does_not_block_the_event_loop(monkeypatch):\n+    monkeypatch.setattr(\n+        cleanup_module, \"_uploader_or_none\", lambda provider: BlockingListUploader()\n+    )\n+\n+    ticks: list[float] = []\n+\n+    async def ticker() -> None:\n+        while True:\n+            ticks.append(time.monotonic())\n+            await asyncio.sleep(0.05)\n+\n+    async def scenario() -> int:\n+        ticker_task = asyncio.create_task(ticker())\n+        try:\n+            await asyncio.sleep(0.05)\n+            return await acleanup_provider_files(\n+                \"openai\", delete_all_from_provider=True\n+            )\n+        finally:\n+            ticker_task.cancel()\n+\n+    deleted = asyncio.run(scenario())\n+    assert deleted == 1\n+    # The listing takes 0.5s and the ticker fires every 0.05s. If the listing\n+    # runs on the loop the ticker freezes for its whole duration (~3 ticks\n+    # total); off the loop it keeps ticking (~12 in the same window).\n+    assert len(ticks) >= 6, f\"event loop was blocked during listing: {len(ticks)} ticks\"\n", "problem_statement": "acleanup_provider_files blocks the event loop on the provider listing\n## Description\n\n`acleanup_provider_files(..., delete_all_from_provider=True)` calls `uploader.list_files()` \u2014 the **synchronous** listing method that hits the provider's HTTP API \u2014 directly on the running event loop:\n\n```python\nif delete_all_from_provider:\n    try:\n        files = uploader.list_files()   # sync network I/O on the loop\n        tasks = []\n        for file_info in files:\n            ...\n        results = await asyncio.gather(*tasks, return_exceptions=True)\n```\n\nEvery uploader's `list_files()` performs network I/O (Anthropic/OpenAI files list API, Bedrock paginated `list_objects_v2`, Gemini files.list). The rest of the function was carefully made async \u2014 deletes run through `adelete` under a semaphore and are gathered \u2014 but the listing step was left synchronous, so a `delete_all_from_provider=True` cleanup freezes the whole event loop for the duration of the provider listing (potentially several paginated round-trips). While it runs, every other coroutine on the loop (agent streaming, other tool calls, timers) is stalled.\n\nThe sibling async cleanups are fine: `acleanup_uploaded_files` and `acleanup_expired_files` only use `aget_all_for_provider` / `adelete` / `aclear*`. There is no `alist_files` on the uploaders, so the listing has no async path today.\n\n## Steps to Reproduce\n\n1. Run `acleanup_provider_files(\"openai\", delete_all_from_provider=True)` inside a running event loop that also runs another coroutine ticking on a timer.\n2. The ticker freezes for the whole duration of `list_files()` (e.g. a stub whose `list_files` does `time.sleep(0.5)` yields ~3 ticks instead of ~12 in the same window).\n\n## Expected Behavior\n\nThe async API should not block the loop: the listing should run off-loop via `asyncio.to_thread(uploader.list_files)` (one-line fix, no uploader API change needed).\n\n## Actual Behavior\n\nThe loop is blocked for the full duration of the synchronous provider listing.\n\n## Environment\n\n- crewai-files @ main (bb4d892)\n- Python 3.12, macOS\n\nHappy to open a PR with a regression test.\n\n", "hints_text": "", "created_at": "2026-10-27T04:38:20Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8617, "instance_id": "crewAIInc__crewAI-8617", "issue_numbers": ["8616"], "base_commit": "f768613eff3b863f3d3b926c773366b88b81fd0f", "patch": "diff --git a/lib/crewai/src/crewai/crew.py b/lib/crewai/src/crewai/crew.py\nindex fe33471fe9..a060b54020 100644\n--- a/lib/crewai/src/crewai/crew.py\n+++ b/lib/crewai/src/crewai/crew.py\n@@ -2140,7 +2140,7 @@ def replay(self, task_id: str, inputs: dict[str, Any] | None = None) -> CrewOutp\n         if future is not None:\n             try:\n                 future.result()\n-            except Exception:  # noqa: BLE001,S110\n+            except Exception:  # noqa: S110\n                 pass\n \n         if self.process == Process.hierarchical:\n@@ -2243,6 +2243,13 @@ def copy(self) -> Crew:  # type: ignore[override]\n             \"knowledge\",\n             \"manager_agent\",\n             \"manager_llm\",\n+            # Checkpoint resume pointers describe the run the copy came\n+            # from; carried over they would make the copy resume that run\n+            # instead of executing (every task skipped, checkpointed\n+            # inputs shadowing the new ones).\n+            \"checkpoint_kickoff_event_id\",\n+            \"checkpoint_inputs\",\n+            \"checkpoint_train\",\n         }\n \n         cloned_agents = [agent.copy() for agent in self.agents]\ndiff --git a/lib/crewai/src/crewai/task.py b/lib/crewai/src/crewai/task.py\nindex 22ab6aaa49..71b75b8516 100644\n--- a/lib/crewai/src/crewai/task.py\n+++ b/lib/crewai/src/crewai/task.py\n@@ -1168,6 +1168,12 @@ def copy(  # type: ignore\n             \"agent\",\n             \"context\",\n             \"tools\",\n+            # Run artifacts of the run this task already had; a copy is\n+            # built for a fresh execution, and a carried output would\n+            # make a checkpointed crew's copy skip the task entirely.\n+            \"output\",\n+            \"checkpoint_original_description\",\n+            \"checkpoint_original_expected_output\",\n         }\n \n         copied_data = self.model_dump(exclude=exclude)\n", "test_patch": "diff --git a/lib/crewai/tests/test_crew_copy_resume_state.py b/lib/crewai/tests/test_crew_copy_resume_state.py\nnew file mode 100644\nindex 0000000000..9a4b06fe44\n--- /dev/null\n+++ b/lib/crewai/tests/test_crew_copy_resume_state.py\n@@ -0,0 +1,76 @@\n+\"\"\"Regression tests: Crew.copy() must not inherit checkpoint resume state.\n+\n+Saving a checkpoint syncs the live crew's private runtime state into its\n+public checkpoint fields (``_sync_checkpoint_fields``), and a completed\n+run leaves ``task.output`` set. ``Crew.copy()`` \u2014 used internally by\n+``kickoff_for_each``, ``test`` and ``train`` for fresh runs \u2014 carried\n+both into the copy, so the copy's kickoff resumed the old run instead of\n+executing: ``_get_execution_start_index`` saw the checkpoint pointer and\n+the stale outputs and skipped every task.\n+\"\"\"\n+\n+from typing import Any\n+\n+import pytest\n+\n+from crewai import Agent, Crew, Task\n+from crewai.tasks.task_output import TaskOutput\n+\n+\n+def _checkpointed_crew() -> tuple[Crew, Task]:\n+    \"\"\"One crew that has run once and saved a checkpoint.\n+\n+    Mirrors what ``_sync_checkpoint_fields`` plus a finished kickoff\n+    leave on the live object.\n+    \"\"\"\n+    agent = Agent(role=\"r\", goal=\"g\", backstory=\"b\", llm=\"gpt-4o-mini\")\n+    task = Task(description=\"d1\", expected_output=\"e1\", agent=agent)\n+    crew = Crew(agents=[agent], tasks=[task], name=\"C\")\n+\n+    task.output = TaskOutput(description=\"d1\", raw=\"first-run result\", agent=\"r\")\n+    task.checkpoint_original_description = \"d1\"\n+    task.checkpoint_original_expected_output = \"e1\"\n+    crew.checkpoint_kickoff_event_id = \"evt-1\"\n+    crew.checkpoint_inputs = {\"x\": 1}\n+    crew.checkpoint_train = False\n+    return crew, task\n+\n+\n+class TestCrewCopyResumesFresh:\n+    def test_copy_drops_checkpoint_resume_pointers(self) -> None:\n+        crew, _ = _checkpointed_crew()\n+\n+        copied = crew.copy()\n+\n+        assert copied.checkpoint_kickoff_event_id is None\n+        assert copied.checkpoint_inputs is None\n+        assert copied.checkpoint_train is None\n+\n+    def test_copy_task_drops_previous_run_output(self) -> None:\n+        crew, task = _checkpointed_crew()\n+\n+        copied = crew.copy()\n+\n+        assert copied.tasks[0] is not task\n+        assert copied.tasks[0].output is None\n+        assert copied.tasks[0].checkpoint_original_description is None\n+        assert copied.tasks[0].checkpoint_original_expected_output is None\n+\n+    def test_copy_would_execute_its_tasks_from_the_start(self) -> None:\n+        \"\"\"The copy must not resume: with the stale outputs inherited, the\n+        execution start index would equal len(tasks) and skip everything.\"\"\"\n+        crew, _ = _checkpointed_crew()\n+        copied = crew.copy()\n+\n+        assert copied._get_execution_start_index(copied.tasks) is None\n+\n+    def test_plain_copy_still_carries_configuration(self) -> None:\n+        agent = Agent(role=\"r\", goal=\"g\", backstory=\"b\", llm=\"gpt-4o-mini\")\n+        task = Task(description=\"d1\", expected_output=\"e1\", agent=agent)\n+        crew = Crew(agents=[agent], tasks=[task], name=\"C\", max_rpm=42)\n+\n+        copied = crew.copy()\n+\n+        assert copied.name == \"C\"\n+        assert copied.max_rpm == 42\n+        assert copied.tasks[0].description == \"d1\"\n", "problem_statement": "fix(crew): after one checkpointed run, kickoff_for_each() and test() silently return the old results without executing\n## Description\n\nSaving a checkpoint syncs the live crew's private runtime state into its **public** checkpoint fields (`_sync_checkpoint_fields` in `lib/crewai/src/crewai/state/runtime.py`: `checkpoint_kickoff_event_id`, `checkpoint_inputs`, `checkpoint_train`, plus each task's `checkpoint_original_description/expected_output`), and a completed run leaves `task.output` set on every task.\n\n`Crew.copy()` does not exclude any of these fields, and `Task.copy()` does not exclude `output` or the task-level checkpoint fields. So after a run that saved a checkpoint, `crew.copy()` produces a copy that **resumes the old run instead of executing**:\n\n- `_get_execution_start_index` sees `checkpoint_kickoff_event_id` set, scans for the first task without output, finds none (all carry the previous run's outputs) and returns `len(tasks)`;\n- `prepare_task_execution` then skips **every** task (`task_index < start_index`), and kickoff returns a `CrewOutput` built from the stale task outputs \u2014 zero execution, zero LLM calls;\n- `checkpoint_inputs` additionally shadows any new inputs passed to the copy (the restore path assigns `self._inputs = self.checkpoint_inputs`).\n\nSince `kickoff_for_each()`, `test()` and `train()` all run on `self.copy()`, one checkpointed run poisons every subsequent batch/evaluation call into silently replaying the checkpointed results.\n\nResume itself is unaffected by a fix here: resuming goes through `Crew.from_checkpoint`, not `copy()`.\n\n## Steps to Reproduce\n\n```python\nfrom crewai import Agent, Task, Crew\nfrom crewai.tasks.task_output import TaskOutput\n\nagent = Agent(role=\"r\", goal=\"g\", backstory=\"b\", llm=\"gpt-4o-mini\")\ntask = Task(description=\"d1\", expected_output=\"e1\", agent=agent)\ncrew = Crew(agents=[agent], tasks=[task])\n\n# ... run crew once with checkpointing enabled (RuntimeState.checkpoint /\n# checkpoint listener) \u2014 afterwards the live object holds:\ntask.output = TaskOutput(description=\"d1\", raw=\"first-run result\", agent=\"r\")\ncrew.checkpoint_kickoff_event_id = \"evt-1\"   # written by _sync_checkpoint_fields\n\ncopy = crew.copy()\ncopy._get_execution_start_index(copy.tasks)\n# \u2192 1 (== len(tasks)): the copy would skip every task and return\n#   \"first-run result\" for any input, without executing anything.\n```\n\n(`test_crew_copy_resume_state.py` in the attached PR asserts this end-to-end.)\n\nObserved: the copy inherits the resume pointer and stale outputs; its kickoff returns the previous run's results.\n\nExpected: `copy()` produces a fresh crew \u2014 no checkpoint pointers, no previous outputs \u2014 because every internal caller immediately kicks off a new run.\n\n## Environment\n\n- crewai 1.15.30 (current main, post-#8369)\n- Deterministic; no network needed\n\n## Impact\n\nAfter enabling checkpoints once, `kickoff_for_each()` returns the checkpointed run's output for **every** input and `test()` evaluates against stale results \u2014 both silently (no error, no log), with no LLM usage.\n\n", "hints_text": "", "created_at": "2026-10-26T12:28:26Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8582, "instance_id": "crewAIInc__crewAI-8582", "issue_numbers": ["8581"], "base_commit": "38db11e3324fa0e23beb5eecd0d87e8e31ca2bb0", "patch": "diff --git a/docs/edge/ar/learn/before-and-after-kickoff-hooks.mdx b/docs/edge/ar/learn/before-and-after-kickoff-hooks.mdx\nindex 0766a0f0db..c65df4ebbb 100644\n--- a/docs/edge/ar/learn/before-and-after-kickoff-hooks.mdx\n+++ b/docs/edge/ar/learn/before-and-after-kickoff-hooks.mdx\n@@ -11,8 +11,7 @@ mode: \"wide\"\n \u064a\u064f\u0646\u0641\u064e\u0651\u0630 \u062e\u0637\u0627\u0641 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0642\u0628\u0644 \u0623\u0646 \u064a\u0628\u062f\u0623 Crew \u0645\u0647\u0627\u0645\u0647. \u064a\u062a\u0644\u0642\u0649 \u0642\u0627\u0645\u0648\u0633 \u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a \u0648\u064a\u0645\u0643\u0646\u0647 \u062a\u0639\u062f\u064a\u0644\u0647 \u0642\u0628\u0644 \u062a\u0645\u0631\u064a\u0631\u0647 \u0625\u0644\u0649 Crew. \u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0627\u0641 \u0644\u0625\u0639\u062f\u0627\u062f \u0628\u064a\u0626\u062a\u0643 \u0623\u0648 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0623\u0648 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a \u0645\u0633\u0628\u0642\u064b\u0627.\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import before_kickoff\n+from crewai.project import CrewBase, before_kickoff\n \n @CrewBase\n class MyCrew:\n@@ -27,8 +26,7 @@ class MyCrew:\n \u064a\u064f\u0646\u0641\u064e\u0651\u0630 \u062e\u0637\u0627\u0641 \u0628\u0639\u062f \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0628\u0639\u062f \u0625\u062a\u0645\u0627\u0645 Crew \u0645\u0647\u0627\u0645\u0647. \u064a\u062a\u0644\u0642\u0649 \u0643\u0627\u0626\u0646 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0630\u064a \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u062e\u0631\u062c\u0627\u062a \u062a\u0646\u0641\u064a\u0630 Crew. \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0627\u0641 \u0645\u062b\u0627\u0644\u064a \u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0644\u0627\u062d\u0642\u064b\u0627 \u0645\u062b\u0644 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0623\u0648 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0648 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0625\u0636\u0627\u0641\u064a.\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import after_kickoff\n+from crewai.project import CrewBase, after_kickoff\n \n @CrewBase\n class MyCrew:\ndiff --git a/docs/edge/ar/learn/execution-hooks.mdx b/docs/edge/ar/learn/execution-hooks.mdx\nindex 1444eb58dc..8c1b6a4f1d 100644\n--- a/docs/edge/ar/learn/execution-hooks.mdx\n+++ b/docs/edge/ar/learn/execution-hooks.mdx\n@@ -49,8 +49,7 @@ def block_dangerous_tools(context):\n ### 2. \u062e\u0637\u0627\u0641\u0627\u062a \u0646\u0637\u0627\u0642 Crew\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import crew\n+from crewai.project import CrewBase, crew\n from crewai.hooks import before_llm_call_crew, after_tool_call_crew\n \n @CrewBase\ndiff --git a/docs/edge/en/learn/before-and-after-kickoff-hooks.mdx b/docs/edge/en/learn/before-and-after-kickoff-hooks.mdx\nindex a9ce1af6ef..707dba64d5 100644\n--- a/docs/edge/en/learn/before-and-after-kickoff-hooks.mdx\n+++ b/docs/edge/en/learn/before-and-after-kickoff-hooks.mdx\n@@ -13,8 +13,7 @@ The before kickoff hook is executed before the crew starts its tasks. It receive\n Here's an example of defining a before kickoff function in your `crew.py`:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import before_kickoff\n+from crewai.project import CrewBase, before_kickoff\n \n @CrewBase\n class MyCrew:\n@@ -36,8 +35,7 @@ The after kickoff hook is executed after the crew has completed its tasks. It re\n Here's how you can define an after kickoff function in your `crew.py`:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import after_kickoff\n+from crewai.project import CrewBase, after_kickoff\n \n @CrewBase\n class MyCrew:\ndiff --git a/docs/edge/en/learn/execution-hooks.mdx b/docs/edge/en/learn/execution-hooks.mdx\nindex 1c54dc8d23..0ee14aba21 100644\n--- a/docs/edge/en/learn/execution-hooks.mdx\n+++ b/docs/edge/en/learn/execution-hooks.mdx\n@@ -71,7 +71,7 @@ Applied to a method inside a `@CrewBase` class, `@on` registers a\n **crew-scoped** hook, active only while that crew runs:\n \n ```python\n-from crewai import CrewBase\n+from crewai.project import CrewBase\n from crewai.hooks import on, InterceptionPoint\n \n @CrewBase\ndiff --git a/docs/edge/ko/learn/before-and-after-kickoff-hooks.mdx b/docs/edge/ko/learn/before-and-after-kickoff-hooks.mdx\nindex 624a5e3a3d..8a16ac35c3 100644\n--- a/docs/edge/ko/learn/before-and-after-kickoff-hooks.mdx\n+++ b/docs/edge/ko/learn/before-and-after-kickoff-hooks.mdx\n@@ -13,8 +13,7 @@ CrewAI\ub294 crew\uc758 kickoff \uc804\ud6c4\uc5d0 \ucf54\ub4dc\ub97c \uc2e4\ud589\ud560 \uc218 \uc788\ub294 hook\uc744 \uc81c\n \ub2e4\uc74c\uc740 `crew.py`\uc5d0\uc11c \ud0a5\uc624\ud504 \uc774\uc804 \ud568\uc218\ub97c \uc815\uc758\ud558\ub294 \uc608\uc2dc\uc785\ub2c8\ub2e4:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import before_kickoff\n+from crewai.project import CrewBase, before_kickoff\n \n @CrewBase\n class MyCrew:\n@@ -36,8 +35,7 @@ class MyCrew:\n `crew.py`\uc5d0\uc11c \ud0a5\uc624\ud504 \ud6c4 \ud568\uc218\ub97c \uc815\uc758\ud558\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import after_kickoff\n+from crewai.project import CrewBase, after_kickoff\n \n @CrewBase\n class MyCrew:\n@@ -58,4 +56,4 @@ class MyCrew:\n \n ## \uacb0\ub860\n \n-CrewAI\uc758 kickoff \uc804\ud6c4 \ud6c5\uc740 crew \uc2e4\ud589\uc758 \uc0dd\uba85\uc8fc\uae30\uc5d0 \uac15\ub825\ud558\uac8c \uac1c\uc785\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud6c5\uc744 \uc774\ud574\ud558\uace0 \ud65c\uc6a9\ud568\uc73c\ub85c\uc368, AI agent\uc758 \uacac\uace0\uc131\uacfc \uc720\uc5f0\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\\ No newline at end of file\n+CrewAI\uc758 kickoff \uc804\ud6c4 \ud6c5\uc740 crew \uc2e4\ud589\uc758 \uc0dd\uba85\uc8fc\uae30\uc5d0 \uac15\ub825\ud558\uac8c \uac1c\uc785\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud6c5\uc744 \uc774\ud574\ud558\uace0 \ud65c\uc6a9\ud568\uc73c\ub85c\uc368, AI agent\uc758 \uacac\uace0\uc131\uacfc \uc720\uc5f0\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4.\ndiff --git a/docs/edge/ko/learn/execution-hooks.mdx b/docs/edge/ko/learn/execution-hooks.mdx\nindex fd722eb026..cceb44b08d 100644\n--- a/docs/edge/ko/learn/execution-hooks.mdx\n+++ b/docs/edge/ko/learn/execution-hooks.mdx\n@@ -84,8 +84,7 @@ def log_tool_result(context):\n \ud2b9\uc815 \ud06c\ub8e8 \uc778\uc2a4\ud134\uc2a4\uc5d0\ub9cc \ud6c5\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import crew\n+from crewai.project import CrewBase, crew\n from crewai.hooks import before_llm_call_crew, after_tool_call_crew\n \n @CrewBase\ndiff --git a/docs/edge/pt-BR/learn/before-and-after-kickoff-hooks.mdx b/docs/edge/pt-BR/learn/before-and-after-kickoff-hooks.mdx\nindex 0855b2abbd..58d6a89d54 100644\n--- a/docs/edge/pt-BR/learn/before-and-after-kickoff-hooks.mdx\n+++ b/docs/edge/pt-BR/learn/before-and-after-kickoff-hooks.mdx\n@@ -13,8 +13,7 @@ O hook antes do kickoff \u00e9 executado antes da crew iniciar suas tarefas. Ele rec\n Aqui est\u00e1 um exemplo de como definir uma fun\u00e7\u00e3o antes do kickoff em seu `crew.py`:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import before_kickoff\n+from crewai.project import CrewBase, before_kickoff\n \n @CrewBase\n class MinhaEquipe:\n@@ -36,8 +35,7 @@ O hook depois do kickoff \u00e9 executado ap\u00f3s a crew completar suas tarefas. Ele r\n Veja como voc\u00ea pode definir uma fun\u00e7\u00e3o depois do kickoff em seu `crew.py`:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import after_kickoff\n+from crewai.project import CrewBase, after_kickoff\n \n @CrewBase\n class MinhaEquipe:\n@@ -58,4 +56,4 @@ Ambos os hooks podem ser usados juntos para oferecer um processo completo de pre\n \n ## Conclus\u00e3o\n \n-Os hooks antes e depois do kickoff em CrewAI oferecem formas poderosas de interagir com o ciclo de vida da execu\u00e7\u00e3o de uma crew. Ao entender e utilizar esses hooks, voc\u00ea pode aumentar significativamente a robustez e flexibilidade dos seus agentes de IA.\n\\ No newline at end of file\n+Os hooks antes e depois do kickoff em CrewAI oferecem formas poderosas de interagir com o ciclo de vida da execu\u00e7\u00e3o de uma crew. Ao entender e utilizar esses hooks, voc\u00ea pode aumentar significativamente a robustez e flexibilidade dos seus agentes de IA.\ndiff --git a/docs/edge/pt-BR/learn/execution-hooks.mdx b/docs/edge/pt-BR/learn/execution-hooks.mdx\nindex 649819d5c6..8526ab6969 100644\n--- a/docs/edge/pt-BR/learn/execution-hooks.mdx\n+++ b/docs/edge/pt-BR/learn/execution-hooks.mdx\n@@ -84,8 +84,7 @@ def log_tool_result(context):\n Aplica hooks apenas a inst\u00e2ncias espec\u00edficas de crew:\n \n ```python\n-from crewai import CrewBase\n-from crewai.project import crew\n+from crewai.project import CrewBase, crew\n from crewai.hooks import before_llm_call_crew, after_tool_call_crew\n \n @CrewBase\n", "test_patch": "", "problem_statement": "[BUG] docs: Incorrect CrewBase import in hook documentation examples\n### Description\n\n\n### Description\n\nThe examples in the following documentation pages import `CrewBase` directly from `crewai`:\n\n- `docs/v1.15.30/en/learn/before-and-after-kickoff-hooks.mdx`\n- `docs/v1.15.30/en/learn/execution-hooks.mdx`\n\nHowever, attempting this import with CrewAI v1.15.30 raises an `ImportError`. It appears that `CrewBase` is not re-exported from the top-level `crewai` package, so the documented examples cannot run as written.\n\n### Steps to Reproduce\n\n1. install crewai\n2. execute `from crewai import CrewBase`\n\n### Expected behavior\n\nThe examples should use the correct import path for `CrewBase`, or the package should re-export `CrewBase` if importing it from `crewai` is intended to be supported.\n\n### Screenshots/Code snippets\n\n```python\nfrom crewai import CrewBase\n```\n\n### Operating System\n\nmacOS Big Sur\n\n### Python Version\n\n3.12\n\n### crewAI Version\n\nv1.15.30\n\n### crewAI Tools Version\n\nNone\n\n### Virtual Environment\n\nConda\n\n### Evidence\n\nImportError: cannot import name 'CrewBase' from 'crewai'\n\n### Possible Solution\n\nUpdate the import statements in both documentation pages to use the correct import path for CrewBase.\n\n### Additional context\n\nNone\n", "hints_text": "", "created_at": "2026-10-26T02:55:03Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8572, "instance_id": "crewAIInc__crewAI-8572", "issue_numbers": ["8571"], "base_commit": "8177dd4df7050efb70ff5d91f17b8755b3bd7be7", "patch": "diff --git a/lib/crewai/src/crewai/memory/storage/qdrant_edge_storage.py b/lib/crewai/src/crewai/memory/storage/qdrant_edge_storage.py\nindex 1fdacb47d6..2c497c8276 100644\n--- a/lib/crewai/src/crewai/memory/storage/qdrant_edge_storage.py\n+++ b/lib/crewai/src/crewai/memory/storage/qdrant_edge_storage.py\n@@ -27,6 +27,7 @@\n     FacetRequest,\n     FieldCondition,\n     Filter,\n+    MatchAny,\n     MatchValue,\n     PayloadSchemaType,\n     Point,\n@@ -330,7 +331,17 @@ def search(\n                 self._vector_dim, len(query_embedding)\n             )\n         filt = self._build_scope_filter(scope_prefix)\n-        fetch_limit = limit * 3 if (categories or metadata_filter) else limit\n+        if categories:\n+            # Match categories server-side so they are filtered BEFORE the ANN\n+            # fetch limit; a client-side post-filter would silently miss\n+            # matching records ranked below limit*3 non-matching neighbours.\n+            category_cond = FieldCondition(\n+                key=\"categories\", match=MatchAny(any=list(categories))\n+            )\n+            must = list(filt.must) if filt is not None and filt.must else []\n+            must.append(category_cond)\n+            filt = Filter(must=must)\n+        fetch_limit = limit * 3 if metadata_filter else limit\n         all_scored: list[tuple[dict[str, Any], float, bool]] = []\n \n         for shard_path in (self._central_path, self._local_path):\n", "test_patch": "diff --git a/lib/crewai/tests/memory/test_qdrant_search_categories.py b/lib/crewai/tests/memory/test_qdrant_search_categories.py\nnew file mode 100644\nindex 0000000000..201393d56f\n--- /dev/null\n+++ b/lib/crewai/tests/memory/test_qdrant_search_categories.py\n@@ -0,0 +1,90 @@\n+\"\"\"Regression tests for server-side category filtering in QdrantEdgeStorage.search().\n+\n+Categories were applied only AFTER the ANN fetch (limit*3 oversample), so\n+matching records ranked below the oversampled fetch were silently missed.\n+Categories now ride the server-side Filter; metadata_filter keeps the\n+client-side post-filter with oversampling.\n+\"\"\"\n+\n+import importlib.util\n+from pathlib import Path\n+\n+import pytest\n+\n+from crewai.memory.storage.qdrant_edge_storage import QdrantEdgeStorage\n+from crewai.memory.types import MemoryRecord\n+\n+pytestmark = pytest.mark.skipif(\n+    importlib.util.find_spec(\"qdrant_edge\") is None,\n+    reason=\"qdrant-edge-py not installed\",\n+)\n+\n+DIM = 4\n+NEAR = [1.0, 0.0, 0.0, 0.0]\n+FAR = [0.0, 0.0, 0.0, 1.0]\n+\n+\n+def _record(rid: str, categories: list[str], metadata: dict | None = None) -> MemoryRecord:\n+    return MemoryRecord(\n+        id=rid,\n+        content=f\"content {rid}\",\n+        scope=\"/proj\",\n+        categories=categories,\n+        metadata=metadata or {},\n+        embedding=FAR,\n+    )\n+\n+\n+def _storage(tmp_path: Path) -> QdrantEdgeStorage:\n+    return QdrantEdgeStorage(path=str(tmp_path / \"edge\"), vector_dim=DIM)\n+\n+\n+def test_matches_below_ann_fetch_limit_are_found(tmp_path: Path) -> None:\n+    storage = _storage(tmp_path)\n+    records = [\n+        MemoryRecord(\n+            id=f\"noise-{i}\",\n+            content=f\"noise {i}\",\n+            scope=\"/proj\",\n+            categories=[\"other\"],\n+            embedding=NEAR,\n+        )\n+        for i in range(8)\n+    ]\n+    records += [_record(f\"target-{i}\", [\"target\"]) for i in range(2)]\n+    storage.save(records)\n+\n+    hits = storage.search(NEAR, categories=[\"target\"], limit=2)\n+\n+    ids = sorted(record.id for record, _ in hits)\n+    assert ids == [\"target-0\", \"target-1\"]\n+\n+\n+def test_categories_limit_respected(tmp_path: Path) -> None:\n+    storage = _storage(tmp_path)\n+    records = [_record(f\"target-{i}\", [\"target\"]) for i in range(5)]\n+    storage.save(records)\n+\n+    hits = storage.search(FAR, categories=[\"target\"], limit=2)\n+\n+    assert len(hits) == 2\n+    assert all(record.id.startswith(\"target-\") for record, _ in hits)\n+\n+\n+def test_metadata_filter_with_categories_still_applies(tmp_path: Path) -> None:\n+    storage = _storage(tmp_path)\n+    records = [\n+        _record(\"target-a\", [\"target\"], metadata={\"kind\": \"keep\"}),\n+        _record(\"target-b\", [\"target\"], metadata={\"kind\": \"drop\"}),\n+        _record(\"noise\", [\"other\"], metadata={\"kind\": \"keep\"}),\n+    ]\n+    storage.save(records)\n+\n+    hits = storage.search(\n+        FAR,\n+        categories=[\"target\"],\n+        metadata_filter={\"kind\": \"keep\"},\n+        limit=5,\n+    )\n+\n+    assert [record.id for record, _ in hits] == [\"target-a\"]\n", "problem_statement": "QdrantEdgeStorage.search() silently misses category matches ranked below the ANN fetch limit\n### Description\n\n`QdrantEdgeStorage.search()` applies `categories` and `metadata_filter` **after** the ANN fetch, but only oversamples the fetch by `limit * 3` (`lib/crewai/src/crewai/memory/storage/qdrant_edge_storage.py`, `search()`):\n\n```python\nfilt = self._build_scope_filter(scope_prefix)\nfetch_limit = limit * 3 if (categories or metadata_filter) else limit\n...\nresults = shard.query(QueryRequest(..., filter=filt, limit=fetch_limit, ...))\n...\nfor payload, score in ranked:          # post-filter\n    if categories and not any(c in record.categories for c in categories):\n        continue\n```\n\nWhen more than `limit * 3` non-matching records rank above the matching ones, the matching records are **silently missed**: the fetch returns only noise, the post-filter discards all of it, and the caller gets an empty (or truncated) result even though matching records exist. `categories` is a server-side-filterable payload field (Keyword array), so unlike `metadata_filter` it can be pushed into the query `Filter` and matched **before** the ANN limit.\n\n### Steps to reproduce\n\n```python\nfrom crewai.memory.storage.qdrant_edge_storage import QdrantEdgeStorage\nfrom crewai.memory.types import MemoryRecord\n\nDIM = 4\nNEAR = [1.0, 0.0, 0.0, 0.0]\nFAR = [0.0, 0.0, 0.0, 1.0]\n\nstorage = QdrantEdgeStorage(path=\"./edge-repro\", vector_dim=DIM)\nrecords = [\n    MemoryRecord(id=f\"noise-{i}\", content=f\"noise {i}\", scope=\"/proj\",\n                 categories=[\"other\"], embedding=NEAR)\n    for i in range(8)\n] + [\n    MemoryRecord(id=f\"target-{i}\", content=f\"target {i}\", scope=\"/proj\",\n                 categories=[\"target\"], embedding=FAR)\n    for i in range(2)\n]\nstorage.save(records)\n\nhits = storage.search(NEAR, categories=[\"target\"], limit=2)\nprint(hits)  # [] \u2014 both target records exist but are never fetched\n```\n\n### Expected behavior\n\n`search(..., categories=[\"target\"], limit=2)` returns the 2 target records. Category matching should happen server-side, before the ANN fetch limit, so results cannot be silently truncated by non-matching neighbors.\n\n### Environment\n\n- crewAI `main` @ 38db11e33\n- qdrant-edge-py\n\n**AI assistance disclosure:** this bug report was prepared with the assistance of an AI agent (Claude Code) under human review. Please apply the `llm-generated` label if that is project policy for AI-assisted contributions.\n\n", "hints_text": "", "created_at": "2026-10-25T10:13:39Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8570, "instance_id": "crewAIInc__crewAI-8570", "issue_numbers": ["8569"], "base_commit": "d29a4a0ac13a027084a3aeb38363cff6647f8913", "patch": "diff --git a/lib/crewai/src/crewai/utilities/guardrail.py b/lib/crewai/src/crewai/utilities/guardrail.py\nindex e0dfa8659f..bbe3d74409 100644\n--- a/lib/crewai/src/crewai/utilities/guardrail.py\n+++ b/lib/crewai/src/crewai/utilities/guardrail.py\n@@ -3,7 +3,7 @@\n from typing import TYPE_CHECKING, Any\n import warnings\n \n-from pydantic import BaseModel, Field, field_validator\n+from pydantic import BaseModel, Field, model_validator\n from typing_extensions import Self\n \n from crewai.utilities.guardrail_types import GuardrailCallable\n@@ -78,29 +78,24 @@ class GuardrailResult(BaseModel):\n         default=None, description=\"Error message if validation failed\"\n     )\n \n-    @field_validator(\"result\", \"error\")\n-    @classmethod\n-    def validate_result_error_exclusivity(cls, v: Any, info: Any) -> Any:\n+    @model_validator(mode=\"after\")\n+    def validate_result_error_exclusivity(self) -> Self:\n         \"\"\"Ensure that result and error are mutually exclusive based on success.\n \n-        Args:\n-          v: The value being validated (either result or error)\n-          info: Validation info containing the entire model data\n+        Runs on the fully constructed instance: a per-field validator cannot\n+        see fields declared after the one being validated, so the success=True\n+        case could never observe a non-empty ``error``.\n \n         Returns:\n-          The original value if validation passes\n+          The validated instance.\n         \"\"\"\n-        values = info.data\n-        if \"success\" in values:\n-            if values[\"success\"] and v and \"error\" in values and values[\"error\"]:\n+        if self.result and self.error:\n+            if self.success:\n                 raise ValueError(\n                     \"Cannot have both result and error when success is True\"\n                 )\n-            if not values[\"success\"] and v and \"result\" in values and values[\"result\"]:\n-                raise ValueError(\n-                    \"Cannot have both result and error when success is False\"\n-                )\n-        return v\n+            raise ValueError(\"Cannot have both result and error when success is False\")\n+        return self\n \n     @classmethod\n     def from_tuple(cls, result: tuple[bool, Any | str]) -> Self:\n", "test_patch": "diff --git a/lib/crewai/tests/utilities/test_guardrail_result_exclusivity.py b/lib/crewai/tests/utilities/test_guardrail_result_exclusivity.py\nnew file mode 100644\nindex 0000000000..b9993b602a\n--- /dev/null\n+++ b/lib/crewai/tests/utilities/test_guardrail_result_exclusivity.py\n@@ -0,0 +1,47 @@\n+\"\"\"Regression tests for GuardrailResult result/error exclusivity validation.\n+\n+The exclusivity rule was implemented as a per-field validator, but pydantic v2's\n+``info.data`` only contains *previously validated* fields (declaration order:\n+success, result, error). Validating ``result`` could never see ``error``, so\n+``GuardrailResult(success=True, result=..., error=...)`` validated silently.\n+The rule now runs as a model-level validator on the complete instance.\n+\"\"\"\n+\n+import pytest\n+from pydantic import ValidationError\n+\n+from crewai.utilities.guardrail import GuardrailResult\n+\n+\n+def test_success_true_with_both_result_and_error_rejected() -> None:\n+    with pytest.raises(ValidationError, match=\"success is True\"):\n+        GuardrailResult(success=True, result=\"answer\", error=\"boom\")\n+\n+\n+def test_success_false_with_both_result_and_error_rejected() -> None:\n+    with pytest.raises(ValidationError, match=\"success is False\"):\n+        GuardrailResult(success=False, result=\"answer\", error=\"boom\")\n+\n+\n+def test_success_true_with_result_only_accepted() -> None:\n+    result = GuardrailResult(success=True, result=\"answer\")\n+    assert result.result == \"answer\" and result.error is None\n+\n+\n+def test_success_false_with_error_only_accepted() -> None:\n+    result = GuardrailResult(success=False, error=\"boom\")\n+    assert result.error == \"boom\" and result.result is None\n+\n+\n+def test_from_tuple_still_works_for_both_directions() -> None:\n+    ok = GuardrailResult.from_tuple((True, \"answer\"))\n+    assert ok.success and ok.result == \"answer\" and ok.error is None\n+\n+    bad = GuardrailResult.from_tuple((False, \"boom\"))\n+    assert not bad.success and bad.error == \"boom\" and bad.result is None\n+\n+\n+def test_empty_strings_do_not_trigger_exclusivity() -> None:\n+    \"\"\"Falsy values never triggered the rule before; keep that behavior.\"\"\"\n+    result = GuardrailResult(success=True, result=\"answer\", error=\"\")\n+    assert result.error == \"\"\n", "problem_statement": "GuardrailResult result/error exclusivity validator is dead code for the success=True case\n### Description\n\n`GuardrailResult.validate_result_error_exclusivity` is implemented as a `@field_validator(\"result\", \"error\")` (`lib/crewai/src/crewai/utilities/guardrail.py`). In pydantic v2, a field validator's `info.data` only contains **previously validated** fields (declaration order: `success`, `result`, `error`), so:\n\n- validating `result` (the case that should catch `success=True` + both set) can never see `error` \u2014 the check `\"error\" in values and values[\"error\"]` is always False. **`GuardrailResult(success=True, result=\"answer\", error=\"boom\")` validates silently**, even though the model documents result/error as mutually exclusive;\n- the `success=False` direction only fires by accident (by the time `error` is validated, `result` is already in `values`).\n\nThe guardrail contract \u2014 \"result on success, error on failure, never both\" \u2014 is therefore not enforced in exactly the direction where a misbehaving guardrail function would produce both.\n\n### Steps to reproduce\n\n```python\nfrom crewai.utilities.guardrail import GuardrailResult\n\ncase = GuardrailResult(success=True, result=\"ok answer\", error=\"some error\")\nprint(case.result, case.error)\n# ('ok answer', 'some error') \u2014 validated, despite the exclusivity rule\n```\n\n### Expected behavior\n\nConstructing a `GuardrailResult` with both a non-empty `result` and a non-empty `error` should raise `ValidationError`, in either success direction.\n\n### Environment\n\n- crewAI `main` @ 38db11e33\n- pydantic v2\n\n**AI assistance disclosure:** this bug report was prepared with the assistance of an AI agent (Claude Code) under human review. Please apply the `llm-generated` label if that is project policy for AI-assisted contributions.\n\n", "hints_text": "", "created_at": "2026-10-25T10:02:03Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8568, "instance_id": "crewAIInc__crewAI-8568", "issue_numbers": ["8567"], "base_commit": "217894ac741d150ebc9567a47a0556b451a26dce", "patch": "diff --git a/lib/crewai/src/crewai/memory/encoding_flow.py b/lib/crewai/src/crewai/memory/encoding_flow.py\nindex 1f197191e9..ad071160a5 100644\n--- a/lib/crewai/src/crewai/memory/encoding_flow.py\n+++ b/lib/crewai/src/crewai/memory/encoding_flow.py\n@@ -250,10 +250,26 @@ def parallel_analyze(self) -> None:\n                 None,\n             )\n             scope_search_root = active_root if active_root else \"/\"\n-            existing_scopes = self._storage.list_scopes(scope_search_root) or [\"/\"]\n-            existing_categories = list(\n-                self._storage.list_categories(scope_prefix=active_root).keys()\n-            )\n+            try:\n+                existing_scopes = self._storage.list_scopes(scope_search_root) or [\"/\"]\n+            except Exception:\n+                logger.warning(\n+                    \"Storage scope listing failed in parallel_analyze, \"\n+                    \"falling back to the root scope only\",\n+                    exc_info=True,\n+                )\n+                existing_scopes = [\"/\"]\n+            try:\n+                existing_categories = list(\n+                    self._storage.list_categories(scope_prefix=active_root).keys()\n+                )\n+            except Exception:\n+                logger.warning(\n+                    \"Storage category listing failed in parallel_analyze, \"\n+                    \"continuing without category suggestions\",\n+                    exc_info=True,\n+                )\n+                existing_categories = []\n \n         save_futures: dict[int, Future[MemoryAnalysis]] = {}\n         consol_futures: dict[int, Future[ConsolidationPlan]] = {}\n", "test_patch": "diff --git a/lib/crewai/tests/memory/test_encoding_flow_analyze_fallback.py b/lib/crewai/tests/memory/test_encoding_flow_analyze_fallback.py\nnew file mode 100644\nindex 0000000000..276d983dc7\n--- /dev/null\n+++ b/lib/crewai/tests/memory/test_encoding_flow_analyze_fallback.py\n@@ -0,0 +1,87 @@\n+\"\"\"Regression tests for storage-listing failures in EncodingFlow.parallel_analyze.\n+\n+The scope/category listings only feed LLM *suggestion* lists. The sibling step\n+``parallel_find_similar`` already treats storage failures as \"treat item as\n+new\"; ``parallel_analyze`` must likewise degrade gracefully instead of crashing\n+the whole save pipeline.\n+\"\"\"\n+\n+from pathlib import Path\n+from unittest.mock import MagicMock\n+\n+from crewai.memory.encoding_flow import EncodingFlow, ItemState\n+from crewai.memory.types import MemoryConfig\n+\n+\n+def _flow(storage: MagicMock) -> EncodingFlow:\n+    return EncodingFlow(\n+        storage=storage,\n+        llm=MagicMock(),\n+        embedder=lambda texts: [[0.1] * 4 for _ in texts],\n+        config=MemoryConfig(),\n+    )\n+\n+\n+def _item_needing_fields() -> ItemState:\n+    return ItemState(\n+        content=\"user prefers dark mode\",\n+        scope=None,\n+        categories=None,\n+        importance=None,\n+        embedding=[0.1, 0.2, 0.3, 0.4],\n+    )\n+\n+\n+def test_scope_listing_failure_still_analyzes(tmp_path: Path) -> None:\n+    storage = MagicMock()\n+    storage.list_scopes.side_effect = RuntimeError(\"transient storage read failure\")\n+    storage.list_categories.return_value = {}\n+    flow = _flow(storage)\n+    item = _item_needing_fields()\n+    flow.state.items = [item]\n+\n+    flow.parallel_analyze()\n+\n+    assert item.plan is not None and item.plan.insert_new\n+    storage.list_categories.assert_called_once()\n+\n+\n+def test_category_listing_failure_still_analyzes(tmp_path: Path) -> None:\n+    storage = MagicMock()\n+    storage.list_scopes.return_value = [\"/projects\"]\n+    storage.list_categories.side_effect = RuntimeError(\"transient storage read failure\")\n+    flow = _flow(storage)\n+    item = _item_needing_fields()\n+    flow.state.items = [item]\n+\n+    flow.parallel_analyze()\n+\n+    assert item.plan is not None and item.plan.insert_new\n+\n+\n+def test_both_listing_failures_still_analyze(tmp_path: Path) -> None:\n+    storage = MagicMock()\n+    storage.list_scopes.side_effect = RuntimeError(\"transient storage read failure\")\n+    storage.list_categories.side_effect = RuntimeError(\"transient storage read failure\")\n+    flow = _flow(storage)\n+    item = _item_needing_fields()\n+    flow.state.items = [item]\n+\n+    flow.parallel_analyze()\n+\n+    assert item.plan is not None and item.plan.insert_new\n+    assert item.resolved_scope  # defaults applied, item still persisted-able\n+\n+\n+def test_kickoff_survives_listing_failure(tmp_path: Path) -> None:\n+    \"\"\"End-to-end: the whole save pipeline completes despite the listing failure.\"\"\"\n+    storage = MagicMock()\n+    storage.search.return_value = []\n+    storage.list_scopes.side_effect = RuntimeError(\"transient storage read failure\")\n+    storage.list_categories.side_effect = RuntimeError(\"transient storage read failure\")\n+    flow = _flow(storage)\n+\n+    flow.kickoff(inputs={\"items\": [{\"content\": \"user prefers dark mode\"}]})\n+\n+    assert flow.state.items[0].result_record is not None\n+    storage.save.assert_called_once()\n", "problem_statement": "EncodingFlow.parallel_analyze crashes the whole save pipeline on transient storage listing failures\n### Description\n\n`EncodingFlow.parallel_analyze()` calls `storage.list_scopes()` and `storage.list_categories()` unguarded (`lib/crewai/src/crewai/memory/encoding_flow.py`):\n\n```python\nexisting_scopes = self._storage.list_scopes(scope_search_root) or [\"/\"]\nexisting_categories = list(self._storage.list_categories(scope_prefix=active_root).keys())\n```\n\nThese two results are only used to build **suggestion lists** for the LLM field-resolution prompts (existing scopes/categories the model may pick from). When the storage read fails transiently, the whole save pipeline dies: the listener raises, `memory.remember()` re-raises, and the memory is never persisted.\n\nThe sibling step `parallel_find_similar` already handles the same class of failure gracefully \u2014 each per-item `storage.search()` is wrapped in `try/except`, logging *\"Storage search failed in parallel_find_similar, treating item as new\"* and continuing. The recall-side counterpart had the same asymmetry fixed in #8557.\n\n### Steps to reproduce\n\n```python\nfrom unittest.mock import MagicMock\n\nfrom crewai.memory.encoding_flow import EncodingFlow\nfrom crewai.memory.types import MemoryConfig\n\nclass FlakyStorage:\n    def search(self, embedding, scope_prefix=None, categories=None, limit=5, min_score=0.0):\n        return []\n    def list_scopes(self, root=\"/\"):\n        raise RuntimeError(\"transient storage read failure\")\n    def list_categories(self, scope_prefix=None):\n        raise RuntimeError(\"transient storage read failure\")\n\nflow = EncodingFlow(\n    storage=FlakyStorage(),\n    llm=MagicMock(),\n    embedder=lambda texts: [[1.0, 0.0, 0.0, 0.0] for _ in texts],\n    config=MemoryConfig(),\n)\n\n# item has no scope/categories/importance -> field resolution path is taken\nflow.kickoff(inputs={\"items\": [{\"content\": \"user prefers dark mode\"}]})\n# -> RuntimeError: transient storage read failure (whole save pipeline aborted)\n```\n\n### Expected behavior\n\nA transient failure of the *suggestion* listings should degrade the quality of LLM suggestions (fall back to `[\"/\"]` / no categories), not abort the save \u2014 matching `parallel_find_similar`'s defensive pattern.\n\n### Environment\n\n- crewAI `main` @ 38db11e33\n\n**AI assistance disclosure:** this bug report was prepared with the assistance of an AI agent (Claude Code) under human review. Please apply the `llm-generated` label if that is project policy for AI-assisted contributions.\n\n", "hints_text": "", "created_at": "2026-10-25T09:47:33Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8561, "instance_id": "crewAIInc__crewAI-8561", "issue_numbers": ["8560"], "base_commit": "a0991cc0d145a4a4b3af40ca1dc56504ec464b24", "patch": "diff --git a/lib/crewai/src/crewai/utilities/prompts.py b/lib/crewai/src/crewai/utilities/prompts.py\nindex c379b91810..55bf51e1f2 100644\n--- a/lib/crewai/src/crewai/utilities/prompts.py\n+++ b/lib/crewai/src/crewai/utilities/prompts.py\n@@ -233,16 +233,21 @@ def _build_prompt(\n             ]\n             prompt = \"\".join(prompt_parts)\n         else:\n+            task_slices = {\"task\", \"native_task\", \"task_no_tools\"}\n+            task_component = next(\n+                (component for component in components if component in task_slices),\n+                \"task\",\n+            )\n             template_parts: list[str] = [\n                 I18N_DEFAULT.slice(component)\n                 for component in components\n-                if component != \"task\"\n+                if component not in task_slices\n             ]\n             system: str = system_template.replace(\n                 \"{{ .System }}\", \"\".join(template_parts)\n             )\n             prompt = prompt_template.replace(\n-                \"{{ .Prompt }}\", \"\".join(I18N_DEFAULT.slice(\"task\"))\n+                \"{{ .Prompt }}\", \"\".join(I18N_DEFAULT.slice(task_component))\n             )\n             if response_template:\n                 response: str = response_template.split(\"{{ .Response }}\")[0]\n", "test_patch": "diff --git a/lib/crewai/tests/utilities/test_prompts_custom_templates.py b/lib/crewai/tests/utilities/test_prompts_custom_templates.py\nnew file mode 100644\nindex 0000000000..f9412a6822\n--- /dev/null\n+++ b/lib/crewai/tests/utilities/test_prompts_custom_templates.py\n@@ -0,0 +1,65 @@\n+\"\"\"Tests for task-slice selection with custom prompt templates.\"\"\"\n+\n+from __future__ import annotations\n+\n+import pytest\n+\n+from crewai.utilities.prompts import Prompts\n+\n+\n+class _Agent:\n+    goal = \"the goal\"\n+    role = \"the role\"\n+    backstory = \"the backstory\"\n+\n+\n+def _build(**kwargs: object) -> str:\n+    prompts = Prompts(\n+        has_tools=kwargs.pop(\"has_tools\", False),\n+        use_native_tool_calling=kwargs.pop(\"use_native_tool_calling\", False),\n+        system_template=\"SYSTEM>>> {{ .System }}\",\n+        prompt_template=\"USER>>> {{ .Prompt }}\",\n+        agent=_Agent(),\n+        **kwargs,\n+    )\n+    return prompts.task_execution().prompt\n+\n+\n+def test_native_tool_calling_uses_native_task_slice_in_prompt_slot():\n+    prompt = _build(has_tools=True, use_native_tool_calling=True)\n+\n+    system, user = prompt.split(\"USER>>>\")\n+    # the prompt slot carries the clean native task slice\n+    assert \"Current Task: {input}\" in user\n+    # ... not the ReAct instructions, and the task text is not duplicated\n+    # into the system section\n+    assert \"Thought:\" not in user\n+    assert \"Begin!\" not in user\n+    assert \"Current Task:\" not in system\n+\n+\n+def test_no_tools_uses_task_no_tools_slice_in_prompt_slot():\n+    prompt = _build(has_tools=False)\n+\n+    system, user = prompt.split(\"USER>>>\")\n+    assert \"Provide your complete response:\" in user\n+    # a tool-less agent must not be told to use tools\n+    assert \"use the tools available\" not in user\n+    assert \"Current Task:\" not in system\n+\n+\n+def test_react_tools_keep_classic_task_slice_in_prompt_slot():\n+    prompt = _build(has_tools=True)\n+\n+    system, user = prompt.split(\"USER>>>\")\n+    assert \"Begin!\" in user\n+    assert \"Current Task:\" not in system\n+\n+\n+@pytest.mark.parametrize(\"use_native\", [False, True])\n+def test_system_section_holds_persona_not_task(use_native: bool):\n+    prompt = _build(has_tools=True, use_native_tool_calling=use_native)\n+\n+    system, _ = prompt.split(\"USER>>>\")\n+    assert \"You are the role.\" in system\n+    assert \"Your personal goal is: the goal\" in system\n", "problem_statement": "Custom system/prompt templates always inject the ReAct task slice, ignoring native-tool-calling and no-tools modes\n## Description\n\n`Prompts.task_execution()` (`lib/crewai/src/crewai/utilities/prompts.py`) appends one of three task slices to the prompt components, depending on the agent's mode:\n\n- `\"task\"` \u2014 ReAct format (has tools, no native function calling)\n- `\"native_task\"` \u2014 native function calling\n- `\"task_no_tools\"` \u2014 agent without tools\n\nWhen the agent is configured with custom `system_template` / `prompt_template` (the LangGraph-style `{{ .System }}` / `{{ .Prompt }}` placeholders), `_build_prompt` assembles the sections like this:\n\n```python\ntemplate_parts = [\n    I18N_DEFAULT.slice(component)\n    for component in components\n    if component != \"task\"          # only filters the exact string \"task\"\n]\nsystem = system_template.replace(\"{{ .System }}\", \"\".join(template_parts))\nprompt = prompt_template.replace(\n    \"{{ .Prompt }}\", \"\".join(I18N_DEFAULT.slice(\"task\"))   # always the ReAct slice\n)\n```\n\nThe filter only excludes the exact string `\"task\"`, and the `{{ .Prompt }}` slot always receives the ReAct `task` slice. For the other two modes this corrupts the assembled prompt:\n\n- **Native function calling**: `native_task` is *not* filtered, so the task text leaks into the `{{ .System }}` section (duplicated context), while `{{ .Prompt }}` receives the ReAct slice \u2014 *\"Begin! ... use the tools available ... Thought:\"* \u2014 instructions for a response format the model isn't using.\n- **No tools**: `task_no_tools` is not filtered either, and `{{ .Prompt }}` tells the tool-less agent to *\"use the tools available\"* \u2014 actively wrong.\n\nOnly the classic ReAct mode (custom templates + non-native tools) happens to work.\n\n## Steps to reproduce\n\n```python\nfrom crewai.utilities.prompts import Prompts\n\nclass FakeAgent:\n    goal = \"the goal\"; role = \"the role\"; backstory = \"the backstory\"\n\nprompts = Prompts(\n    has_tools=False,                      # a tool-less agent\n    system_template=\"SYSTEM>>> {{ .System }}\",\n    prompt_template=\"USER>>> {{ .Prompt }}\",\n    agent=FakeAgent(),\n)\nprint(prompts.task_execution().prompt)\n# USER>>> section contains:\n#   \"Begin! This is VERY important to you, use the tools available ...\"\n#   \"Thought:\"\n# \u2014 ReAct tool-use instructions for an agent that has no tools.\n```\n\n## Expected behavior\n\nWhichever task slice was selected for the agent's mode should be excluded from the `{{ .System }}` parts and substituted into `{{ .Prompt }}`:\n\n- native function calling \u2192 `{{ .Prompt }}` gets the clean `Current Task: {input}` slice;\n- no tools \u2192 `{{ .Prompt }}` gets `Provide your complete response:`;\n- ReAct (unchanged) \u2192 `{{ .Prompt }}` keeps the classic `Begin! ... Thought:` slice.\n\n## Actual behavior\n\n`{{ .Prompt }}` always gets the ReAct `task` slice, and for native/no-tools agents the mode-specific task slice additionally leaks into `{{ .System }}`.\n\n## Environment\n\n- OS: Windows 11\n- crewAI version: current `main` (38db11e33)\n- Python version: 3.13\n\n", "hints_text": "", "created_at": "2026-10-25T07:44:30Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8521, "instance_id": "crewAIInc__crewAI-8521", "issue_numbers": ["8520"], "base_commit": "aed2a7ea93542a68f04e018254e5429a0129952a", "patch": "diff --git a/lib/crewai-files/src/crewai_files/uploaders/bedrock.py b/lib/crewai-files/src/crewai_files/uploaders/bedrock.py\nindex af0a0a5384..b3ac59ad1c 100644\n--- a/lib/crewai-files/src/crewai_files/uploaders/bedrock.py\n+++ b/lib/crewai-files/src/crewai_files/uploaders/bedrock.py\n@@ -123,7 +123,8 @@ def __init__(\n             prefix: S3 key prefix for uploaded files (default: \"crewai-files\").\n             region: AWS region. Uses AWS_REGION or AWS_DEFAULT_REGION if not provided.\n             client: Optional pre-instantiated boto3 S3 client.\n-            async_client: Optional pre-instantiated aioboto3 S3 client.\n+            async_client: Optional pre-instantiated aioboto3 Session for async\n+                uploads; one is created on first use when omitted.\n         \"\"\"\n         self._bucket_name = bucket_name or os.environ.get(\"CREWAI_BEDROCK_S3_BUCKET\")\n         self._bucket_owner = bucket_owner or os.environ.get(\n@@ -171,18 +172,18 @@ def _get_client(self) -> Any:\n         return self._client\n \n     def _get_async_client(self) -> Any:\n-        \"\"\"Get or create the async S3 client.\"\"\"\n+        \"\"\"Get or create the aioboto3 session.\"\"\"\n         if self._async_client is None:\n             try:\n                 import aioboto3  # type: ignore[import-not-found]\n \n-                self._session = aioboto3.Session()\n+                self._async_client = aioboto3.Session()\n             except ImportError as e:\n                 raise ImportError(\n                     \"aioboto3 is required for async Bedrock S3 file uploads. \"\n                     \"Install with: pip install aioboto3\"\n                 ) from e\n-        return self._session\n+        return self._async_client\n \n     def _generate_s3_key(self, file: FileInput, content: bytes | None = None) -> str:\n         \"\"\"Generate a unique S3 key for the file.\n", "test_patch": "diff --git a/lib/crewai-files/tests/test_bedrock_async_client.py b/lib/crewai-files/tests/test_bedrock_async_client.py\nnew file mode 100644\nindex 0000000000..e37ba1167a\n--- /dev/null\n+++ b/lib/crewai-files/tests/test_bedrock_async_client.py\n@@ -0,0 +1,103 @@\n+\"\"\"Tests for BedrockFileUploader's async session handling.\"\"\"\n+\n+from __future__ import annotations\n+\n+import sys\n+from types import ModuleType\n+from typing import Any\n+\n+from crewai_files import FileBytes, ImageFile\n+from crewai_files.uploaders.bedrock import BedrockFileUploader\n+import pytest\n+\n+\n+MINIMAL_PNG = b\"\\x89PNG\\r\\n\\x1a\\n\"  # magic header is all content-type detection needs\n+\n+\n+class _StubS3Client:\n+    def __init__(self) -> None:\n+        self.uploaded: list[tuple[str, str]] = []\n+        self.deleted: list[str] = []\n+\n+    async def upload_fileobj(\n+        self, fileobj: Any, bucket: str, key: str, **kwargs: Any\n+    ) -> None:\n+        self.uploaded.append((bucket, key))\n+\n+    async def delete_object(self, Bucket: str, Key: str) -> None:  # noqa: N803\n+        self.deleted.append((Bucket, Key))\n+\n+\n+class _StubClientContext:\n+    def __init__(self, client: _StubS3Client) -> None:\n+        self._client = client\n+\n+    async def __aenter__(self) -> _StubS3Client:\n+        return self._client\n+\n+    async def __aexit__(self, *exc: object) -> None:\n+        return None\n+\n+\n+class _StubSession:\n+    \"\"\"Stands in for an aioboto3 Session.\"\"\"\n+\n+    def __init__(self) -> None:\n+        self.s3 = _StubS3Client()\n+        self.requested: list[tuple[str, dict[str, Any]]] = []\n+\n+    def client(self, service_name: str, **kwargs: Any) -> _StubClientContext:\n+        self.requested.append((service_name, kwargs))\n+        return _StubClientContext(self.s3)\n+\n+\n+def _image_file() -> ImageFile:\n+    return ImageFile(source=FileBytes(data=MINIMAL_PNG, filename=\"test.png\"))\n+\n+\n+@pytest.fixture(autouse=True)\n+def _no_boto3_runtime(monkeypatch: pytest.MonkeyPatch) -> None:\n+    \"\"\"Keep the tests hermetic: boto3 is not a runtime dependency of the\n+    crewai-files test environment, so stub out the TransferConfig lookup.\"\"\"\n+    monkeypatch.setattr(\n+        BedrockFileUploader, \"_get_transfer_config\", staticmethod(lambda: None)\n+    )\n+\n+\n+@pytest.mark.asyncio\n+async def test_aupload_uses_injected_async_session() -> None:\n+    session = _StubSession()\n+    uploader = BedrockFileUploader(bucket_name=\"test-bucket\", async_client=session)\n+\n+    result = await uploader.aupload(_image_file())\n+\n+    assert result.provider == \"bedrock\"\n+    assert result.file_uri == f\"s3://test-bucket/{result.file_id}\"\n+    assert session.s3.uploaded == [(\"test-bucket\", result.file_id)]\n+    assert session.requested[0][0] == \"s3\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_adelete_uses_injected_async_session() -> None:\n+    session = _StubSession()\n+    uploader = BedrockFileUploader(bucket_name=\"test-bucket\", async_client=session)\n+\n+    assert await uploader.adelete(\"some/key.png\") is True\n+    assert session.s3.deleted == [(\"test-bucket\", \"some/key.png\")]\n+\n+\n+@pytest.mark.asyncio\n+async def test_aupload_creates_session_when_none_injected(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    created: list[_StubSession] = []\n+    fake_module = ModuleType(\"aioboto3\")\n+    fake_module.Session = lambda: created.append(_StubSession()) or created[-1]  # type: ignore[attr-defined]\n+    monkeypatch.setitem(sys.modules, \"aioboto3\", fake_module)\n+\n+    uploader = BedrockFileUploader(bucket_name=\"test-bucket\")\n+\n+    result = await uploader.aupload(_image_file())\n+\n+    assert len(created) == 1\n+    assert created[0].s3.uploaded == [(\"test-bucket\", result.file_id)]\n", "problem_statement": "fix(files): BedrockFileUploader ignores an injected async_client and crashes on a phantom _session attribute\n## Description\n\n`BedrockFileUploader._get_async_client` in `lib/crewai-files/src/crewai_files/uploaders/bedrock.py` never uses the `async_client` the constructor accepts (and that `get_uploader` forwards from its `BedrockOpts`/`AllOptions` kwargs):\n\n```python\ndef _get_async_client(self) -> Any:\n    if self._async_client is None:\n        try:\n            import aioboto3\n            self._session = aioboto3.Session()   # phantom attribute\n        except ImportError as e:\n            ...\n    return self._session                        # never _async_client\n```\n\n`__init__` never defines `self._session`. So:\n\n- **With an injected `async_client`** (the documented configuration path): `self._async_client` is not None, the creation block is skipped, and `return self._session` raises `AttributeError: 'BedrockFileUploader' object has no attribute '_session'`. `aupload`'s catch-all wraps it into a misleading `TransientUploadError` (\"S3 upload failed: ... no attribute '_session'\"), which the resolver then retries three times before failing; `adelete` logs a delete failure and returns `False`.\n- **Without one**, the auto-created session works, but only by virtue of the same phantom attribute \u2014 `_async_client` stays None forever and the parameter remains dead.\n\nThe sync twin `_get_client` handles its injected `client` correctly; only the async path is broken.\n\nAlso, the `__init__` docstring calls the parameter an \"aioboto3 S3 client\", but `aupload`/`adelete` call `session.client(\"s3\", ...)` on it \u2014 the expected object is an **aioboto3 Session**.\n\n## Steps to Reproduce\n\n```python\nimport asyncio\nfrom types import SimpleNamespace\n\n# any object standing in for an aioboto3 Session\nclass Ctx:\n    async def __aenter__(self): return SimpleNamespace()\n    async def __aexit__(self, *a): return None\nsession = SimpleNamespace(client=lambda *a, **k: Ctx())\n\nfrom crewai_files import FileBytes, ImageFile\nfrom crewai_files.uploaders.bedrock import BedrockFileUploader\n\nuploader = BedrockFileUploader(bucket_name=\"my-bucket\", async_client=session)\nasyncio.run(uploader.aupload(ImageFile(source=FileBytes(data=b\"\\x89PNG\\r\\n\\x1a\\n\", filename=\"x.png\"))))\n# TransientUploadError: S3 upload failed: ... object has no attribute '_session'\n```\n\nObserved: `TransientUploadError` wrapping `AttributeError` (no network involved).\n\nExpected: the injected session is used for the upload, as the sync path does with `client`.\n\n## Environment\n\n- crewai-files 1.15.30 (current main)\n- Deterministic; no AWS credentials or aioboto3 install needed to hit the crash\n\n## Impact\n\nAny user or integrator configuring Bedrock uploads through the factory's `async_client` option gets a 100%-failure async path that misreports as a transient (retryable) S3 error.\n\n", "hints_text": "", "created_at": "2026-10-24T14:49:17Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8474, "instance_id": "crewAIInc__crewAI-8474", "issue_numbers": ["8472"], "base_commit": "2cc84c5a692d8709b820e5b039fe042b9b8fe511", "patch": "diff --git a/docs/edge/en/concepts/cli.mdx b/docs/edge/en/concepts/cli.mdx\nindex 5427b57de7..345e5ad8a1 100644\n--- a/docs/edge/en/concepts/cli.mdx\n+++ b/docs/edge/en/concepts/cli.mdx\n@@ -378,7 +378,7 @@ crewai org switch <organization_id>\n   ```\n   This shows the help message for the CrewAI Deploy CLI.\n \n-Watch this video tutorial for a step-by-step demonstration of deploying your crew to [CrewAI AMP](http://app.crewai.com) using the CLI.\n+Watch this video tutorial for a step-by-step demonstration of deploying your crew to [CrewAI AMP](https://app.crewai.com) using the CLI.\n \n <iframe\n   className=\"w-full aspect-video rounded-xl\"\ndiff --git a/docs/edge/ko/concepts/cli.mdx b/docs/edge/ko/concepts/cli.mdx\nindex ae10e987af..b5ea812513 100644\n--- a/docs/edge/ko/concepts/cli.mdx\n+++ b/docs/edge/ko/concepts/cli.mdx\n@@ -326,7 +326,7 @@ crewai org switch <organization_id>\n   ```\n   \uc774 \uba85\ub839\uc740 CrewAI Deploy CLI\uc5d0 \ub300\ud55c \ub3c4\uc6c0\ub9d0 \uba54\uc2dc\uc9c0\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.\n \n-CLI\ub97c \uc0ac\uc6a9\ud558\uc5ec [CrewAI AMP](http://app.crewai.com)\uc5d0 crew\ub97c \ubc30\ud3ec\ud558\ub294 \ub2e8\uacc4\ubcc4 \uc2dc\uc5f0\uc740 \uc544\ub798 \ube44\ub514\uc624 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ucc38\uc870\ud558\uc2ed\uc2dc\uc624.\n+CLI\ub97c \uc0ac\uc6a9\ud558\uc5ec [CrewAI AMP](https://app.crewai.com)\uc5d0 crew\ub97c \ubc30\ud3ec\ud558\ub294 \ub2e8\uacc4\ubcc4 \uc2dc\uc5f0\uc740 \uc544\ub798 \ube44\ub514\uc624 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ucc38\uc870\ud558\uc2ed\uc2dc\uc624.\n \n <iframe\n   className=\"w-full aspect-video rounded-xl\"\ndiff --git a/docs/edge/pt-BR/concepts/cli.mdx b/docs/edge/pt-BR/concepts/cli.mdx\nindex ef69d5d045..6226d4451e 100644\n--- a/docs/edge/pt-BR/concepts/cli.mdx\n+++ b/docs/edge/pt-BR/concepts/cli.mdx\n@@ -347,7 +347,7 @@ crewai org switch <organization_id>\n   ```\n   Isto exibe a mensagem de ajuda para o CLI CrewAI Deploy.\n \n-Assista ao v\u00eddeo tutorial para uma demonstra\u00e7\u00e3o passo-a-passo de implanta\u00e7\u00e3o do seu crew no [CrewAI AMP](http://app.crewai.com) usando o CLI.\n+Assista ao v\u00eddeo tutorial para uma demonstra\u00e7\u00e3o passo-a-passo de implanta\u00e7\u00e3o do seu crew no [CrewAI AMP](https://app.crewai.com) usando o CLI.\n \n <iframe\n   className=\"w-full aspect-video rounded-xl\"\n", "test_patch": "", "problem_statement": "docs: use HTTPS for CrewAI AMP link in CLI concept doc\n### Description\r\n\r\nThe CLI concept doc links to CrewAI AMP over plain HTTP:\r\n\r\n```md\r\n[CrewAI AMP](http://app.crewai.com)\r\n```\r\n\r\n`http://app.crewai.com` times out in some environments (verified via `urllib`/`curl` with a 15s timeout -> `URLError: timed out`), while `https://app.crewai.com` responds (302 -> `login.crewai.com`). Some browsers auto-upgrade HTTP->HTTPS via HSTS, which can mask the problem, but the plain-HTTP URL is unreliable and insecure, so it is safer to point at the HTTPS version.\r\n\r\nThis was partially addressed by PR #3524 (\"docs: fix insecure HTTP links to use HTTPS\"), but that PR was closed unmerged and only touched the legacy `docs/en/` paths - the `docs/edge/` locales were never updated.\r\n\r\n### Affected files\r\n- `docs/edge/en/concepts/cli.mdx`\r\n- `docs/edge/ko/concepts/cli.mdx`\r\n- `docs/edge/pt-BR/concepts/cli.mdx`\r\n\r\n(ar locale is not affected; `docs/edge/*/quickstart.mdx` already use HTTPS or have no link.)\r\n\r\n### Proposed change\r\nReplace `http://app.crewai.com` -> `https://app.crewai.com` in the three files above. No code or test changes.\r\n\r\n### Additional context\r\n- Versioned docs under `docs/v1.x.x/` are frozen snapshots and are intentionally left untouched.\r\n- Prepared with AI assistance.\r\n\n", "hints_text": "", "created_at": "2026-10-23T17:33:40Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 8456, "instance_id": "crewAIInc__crewAI-8456", "issue_numbers": ["8455"], "base_commit": "424c0477704f86875c8bd1189dd891b52c995744", "patch": "diff --git a/docs/edge/ar/concepts/llms.mdx b/docs/edge/ar/concepts/llms.mdx\nindex 6da174f9e0..e7c002a03a 100644\n--- a/docs/edge/ar/concepts/llms.mdx\n+++ b/docs/edge/ar/concepts/llms.mdx\n@@ -1088,7 +1088,7 @@ mode: \"wide\"\n     ```\n \n     <Tip>\n-      [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627](/ar/concepts/event-listener#event-listeners) \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\n+      [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627](/ar/concepts/event-listener#\u0625\u0646\u0634\u0627\u0621-\u0645\u0633\u062a\u0645\u0639-\u0623\u062d\u062f\u0627\u062b-\u0645\u062e\u0635\u0635) \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\n     </Tip>\n   </Tab>\n \ndiff --git a/docs/edge/ar/concepts/production-architecture.mdx b/docs/edge/ar/concepts/production-architecture.mdx\nindex 11c902c95a..8431d0da9a 100644\n--- a/docs/edge/ar/concepts/production-architecture.mdx\n+++ b/docs/edge/ar/concepts/production-architecture.mdx\n@@ -84,7 +84,7 @@ class ProductionFlow(Flow[AppState]):\n \u0627\u0633\u062a\u0641\u062f \u0645\u0646 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0641\u064a CrewAI \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u062a\u0627\u0646\u0629 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0625\u0644\u0649 \u0623\u0637\u0642\u0645\u0643.\n \n ### 1. \u062d\u0648\u0627\u062c\u0632 \u0627\u0644\u0645\u0647\u0627\u0645\n-\u0627\u0633\u062a\u062e\u062f\u0645 [\u062d\u0648\u0627\u062c\u0632 \u0627\u0644\u0645\u0647\u0627\u0645](/ar/concepts/tasks#task-guardrails) \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u062e\u0631\u062c\u0627\u062a \u0627\u0644\u0645\u0647\u0627\u0645 \u0642\u0628\u0644 \u0642\u0628\u0648\u0644\u0647\u0627. \u064a\u0636\u0645\u0646 \u0647\u0630\u0627 \u0623\u0646 \u0648\u0643\u0644\u0627\u0621\u0643 \u064a\u0646\u062a\u062c\u0648\u0646 \u0646\u062a\u0627\u0626\u062c \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629.\n+\u0627\u0633\u062a\u062e\u062f\u0645 [\u062d\u0648\u0627\u062c\u0632 \u0627\u0644\u0645\u0647\u0627\u0645](/ar/concepts/tasks#\u062d\u0631\u0627\u0633-\u0627\u0644\u0645\u0647\u0627\u0645) \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u062e\u0631\u062c\u0627\u062a \u0627\u0644\u0645\u0647\u0627\u0645 \u0642\u0628\u0644 \u0642\u0628\u0648\u0644\u0647\u0627. \u064a\u0636\u0645\u0646 \u0647\u0630\u0627 \u0623\u0646 \u0648\u0643\u0644\u0627\u0621\u0643 \u064a\u0646\u062a\u062c\u0648\u0646 \u0646\u062a\u0627\u0626\u062c \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629.\n \n ```python\n def validate_content(result: TaskOutput) -> Tuple[bool, Any]:\ndiff --git a/docs/edge/ar/guides/crews/first-crew.mdx b/docs/edge/ar/guides/crews/first-crew.mdx\nindex 68f66dae11..5794b72c09 100644\n--- a/docs/edge/ar/guides/crews/first-crew.mdx\n+++ b/docs/edge/ar/guides/crews/first-crew.mdx\n@@ -12,7 +12,7 @@ mode: \"wide\"\n ### \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a\n \n 1. \u062a\u062b\u0628\u064a\u062a CrewAI \u0645\u0646 [\u062f\u0644\u064a\u0644 \u0627\u0644\u062a\u062b\u0628\u064a\u062a](/ar/installation)\n-2. \u0625\u0639\u062f\u0627\u062f \u0645\u0641\u062a\u0627\u062d LLM \u0645\u0646 [\u062f\u0644\u064a\u0644 LLMs](/ar/concepts/llms#setting-up-your-llm)\n+2. \u0625\u0639\u062f\u0627\u062f \u0645\u0641\u062a\u0627\u062d LLM \u0645\u0646 [\u062f\u0644\u064a\u0644 LLMs](/ar/concepts/llms#\u0625\u0639\u062f\u0627\u062f-llm-\u0627\u0644\u062e\u0627\u0635-\u0628\u0643)\n 3. \u0645\u0641\u062a\u0627\u062d [Serper.dev](https://serper.dev/) \u0625\u0630\u0627 \u0623\u0631\u062f\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u062d\u062b \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628\n \n ## \u0627\u0644\u062e\u0637\u0648\u0629 1: \u0625\u0646\u0634\u0627\u0621 Crew \u062c\u062f\u064a\u062f\u0629\ndiff --git a/docs/edge/ar/guides/flows/first-flow.mdx b/docs/edge/ar/guides/flows/first-flow.mdx\nindex ac3cee4e02..16debc3674 100644\n--- a/docs/edge/ar/guides/flows/first-flow.mdx\n+++ b/docs/edge/ar/guides/flows/first-flow.mdx\n@@ -26,7 +26,7 @@ mode: \"wide\"\n \u0642\u0628\u0644 \u0627\u0644\u0628\u062f\u0621\u060c \u062a\u0623\u0643\u062f \u0645\u0646:\n \n 1. \u062a\u062b\u0628\u064a\u062a CrewAI \u0628\u0627\u062a\u0628\u0627\u0639 [\u062f\u0644\u064a\u0644 \u0627\u0644\u062a\u062b\u0628\u064a\u062a](/ar/installation)\n-2. \u0625\u0639\u062f\u0627\u062f \u0645\u0641\u062a\u0627\u062d API \u0644\u0646\u0645\u0648\u0630\u062c LLM \u0641\u064a \u0628\u064a\u0626\u062a\u0643\u060c \u0628\u0627\u062a\u0628\u0627\u0639 [\u062f\u0644\u064a\u0644 \u0625\u0639\u062f\u0627\u062f LLM](/ar/concepts/llms#setting-up-your-llm)\n+2. \u0625\u0639\u062f\u0627\u062f \u0645\u0641\u062a\u0627\u062d API \u0644\u0646\u0645\u0648\u0630\u062c LLM \u0641\u064a \u0628\u064a\u0626\u062a\u0643\u060c \u0628\u0627\u062a\u0628\u0627\u0639 [\u062f\u0644\u064a\u0644 \u0625\u0639\u062f\u0627\u062f LLM](/ar/concepts/llms#\u0625\u0639\u062f\u0627\u062f-llm-\u0627\u0644\u062e\u0627\u0635-\u0628\u0643)\n 3. \u0641\u0647\u0645 \u0623\u0633\u0627\u0633\u064a \u0644\u0640 Python\n \n ## \u0627\u0644\u062e\u0637\u0648\u0629 1: \u0625\u0646\u0634\u0627\u0621 \u0645\u0634\u0631\u0648\u0639 CrewAI Flow \u062c\u062f\u064a\u062f\n@@ -42,7 +42,7 @@ cd guide_creator_flow\n \n ## \u0627\u0644\u062e\u0637\u0648\u0629 2: \u0641\u0647\u0645 \u0647\u064a\u0643\u0644 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\n \n-\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0640 crew \u0627\u0644\u0645\u0628\u062f\u0626\u064a \u0627\u0644\u0645\u0636\u0645\u0651\u0646 \u0641\u064a \u0645\u0634\u0631\u0648\u0639 Flow \u0628\u0646\u064a\u0629 Python/YAML \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629. \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 crew \u0628\u0646\u0645\u0637 JSON-first \u062f\u0627\u062e\u0644 Flow\u060c \u0623\u0646\u0634\u0626 `crew.jsonc` \u0648 `agents/*.jsonc` \u062f\u0627\u062e\u0644 \u0645\u062c\u0644\u062f \u0627\u0644\u0640 crew \u0648\u062d\u0645\u0651\u0644\u0647 \u0639\u0628\u0631 `crewai.project.load_crew` \u0643\u0645\u0627 \u0641\u064a [Flows](/ar/concepts/flows#building-your-crews).\n+\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0640 crew \u0627\u0644\u0645\u0628\u062f\u0626\u064a \u0627\u0644\u0645\u0636\u0645\u0651\u0646 \u0641\u064a \u0645\u0634\u0631\u0648\u0639 Flow \u0628\u0646\u064a\u0629 Python/YAML \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629. \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 crew \u0628\u0646\u0645\u0637 JSON-first \u062f\u0627\u062e\u0644 Flow\u060c \u0623\u0646\u0634\u0626 `crew.jsonc` \u0648 `agents/*.jsonc` \u062f\u0627\u062e\u0644 \u0645\u062c\u0644\u062f \u0627\u0644\u0640 crew \u0648\u062d\u0645\u0651\u0644\u0647 \u0639\u0628\u0631 `crewai.project.load_crew` \u0643\u0645\u0627 \u0641\u064a [Flows](/ar/concepts/flows#\u0628\u0646\u0627\u0621-\u0641\u0631\u0642-crew-\u0627\u0644\u062e\u0627\u0635\u0629-\u0628\u0643).\n \n ```\n guide_creator_flow/\n@@ -153,7 +153,7 @@ def kickoff_content_crew(inputs: dict):\n \n ## \u0627\u0644\u062e\u0637\u0648\u0629 6: \u0625\u0639\u062f\u0627\u062f \u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0628\u064a\u0626\u0629\n \n-\u0623\u0646\u0634\u0626 \u0645\u0644\u0641 `.env` \u0641\u064a \u062c\u0630\u0631 \u0645\u0634\u0631\u0648\u0639\u0643 \u0628\u0645\u0641\u0627\u062a\u064a\u062d API. \u0631\u0627\u062c\u0639 [\u062f\u0644\u064a\u0644 \u0625\u0639\u062f\u0627\u062f LLM](/ar/concepts/llms#setting-up-your-llm) \u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0645\u0632\u0648\u062f.\n+\u0623\u0646\u0634\u0626 \u0645\u0644\u0641 `.env` \u0641\u064a \u062c\u0630\u0631 \u0645\u0634\u0631\u0648\u0639\u0643 \u0628\u0645\u0641\u0627\u062a\u064a\u062d API. \u0631\u0627\u062c\u0639 [\u062f\u0644\u064a\u0644 \u0625\u0639\u062f\u0627\u062f LLM](/ar/concepts/llms#\u0625\u0639\u062f\u0627\u062f-llm-\u0627\u0644\u062e\u0627\u0635-\u0628\u0643) \u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0645\u0632\u0648\u062f.\n \n ```sh .env\n OPENAI_API_KEY=your_openai_api_key\ndiff --git a/docs/edge/ar/learn/human-feedback-in-flows.mdx b/docs/edge/ar/learn/human-feedback-in-flows.mdx\nindex 89a74d8c48..c503bcd96b 100644\n--- a/docs/edge/ar/learn/human-feedback-in-flows.mdx\n+++ b/docs/edge/ar/learn/human-feedback-in-flows.mdx\n@@ -98,7 +98,7 @@ class ReviewFlow(Flow):\n \n - [\u0646\u0638\u0631\u0629 \u0639\u0627\u0645\u0629 \u0639\u0644\u0649 Flows](/ar/concepts/flows)\n - [\u0625\u062f\u0627\u0631\u0629 \u062d\u0627\u0644\u0629 Flow](/ar/guides/flows/mastering-flow-state)\n-- [\u062d\u0641\u0638 Flow](/ar/concepts/flows#persistence)\n-- [\u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0645\u0639 @router](/ar/concepts/flows#router)\n+- [\u062d\u0641\u0638 Flow](/ar/concepts/flows#\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629-\u0627\u0644\u062a\u062f\u0641\u0642)\n+- [\u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0645\u0639 @router](/ar/concepts/flows#\u0627\u0644\u0645\u0648\u062c\u0651\u0647)\n - [\u0625\u062f\u062e\u0627\u0644 \u0628\u0634\u0631\u064a \u0639\u0646\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630](/ar/learn/human-input-on-execution)\n - [\u0627\u0644\u0630\u0627\u0643\u0631\u0629](/ar/concepts/memory)\ndiff --git a/docs/edge/ar/learn/llm-connections.mdx b/docs/edge/ar/learn/llm-connections.mdx\nindex 3e33ded0ba..a09fd05a66 100644\n--- a/docs/edge/ar/learn/llm-connections.mdx\n+++ b/docs/edge/ar/learn/llm-connections.mdx\n@@ -46,7 +46,7 @@ mode: \"wide\"\n   ```bash\n   uv add 'crewai[litellm]'\n   ```\n-  \u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0632\u0648\u062f\u0648\u0646 \u0627\u0644\u0623\u0635\u0644\u064a\u0648\u0646 (OpenAI\u060c Anthropic\u060c Google Gemini\u060c Azure\u060c AWS Bedrock) \u0625\u0636\u0627\u0641\u0627\u062a SDK \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0645 \u2014 \u0631\u0627\u062c\u0639 [\u0623\u0645\u062b\u0644\u0629 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0632\u0648\u062f\u064a\u0646](/ar/concepts/llms#provider-configuration-examples).\n+  \u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0632\u0648\u062f\u0648\u0646 \u0627\u0644\u0623\u0635\u0644\u064a\u0648\u0646 (OpenAI\u060c Anthropic\u060c Google Gemini\u060c Azure\u060c AWS Bedrock) \u0625\u0636\u0627\u0641\u0627\u062a SDK \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0645 \u2014 \u0631\u0627\u062c\u0639 [\u0623\u0645\u062b\u0644\u0629 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0632\u0648\u062f\u064a\u0646](/ar/concepts/llms#\u0623\u0645\u062b\u0644\u0629-\u0625\u0639\u062f\u0627\u062f-\u0627\u0644\u0645\u0632\u0648\u062f\u064a\u0646).\n </Info>\n \n ## \u062a\u063a\u064a\u064a\u0631 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0643\u0628\u064a\u0631\ndiff --git a/docs/edge/ar/mcp/dsl-integration.mdx b/docs/edge/ar/mcp/dsl-integration.mdx\nindex 392570e1f7..8179d406ea 100644\n--- a/docs/edge/ar/mcp/dsl-integration.mdx\n+++ b/docs/edge/ar/mcp/dsl-integration.mdx\n@@ -12,7 +12,7 @@ mode: \"wide\"\n <Info>\n   \u0647\u0630\u0627 \u0647\u0648 **\u0627\u0644\u0646\u0647\u062c \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647** \u0644\u0645\u0639\u0638\u0645 \u062d\u0627\u0644\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 MCP. \u0644\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648\u0647\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629\n   \u0627\u0644\u062a\u064a \u062a\u062a\u0637\u0644\u0628 \u0625\u062f\u0627\u0631\u0629 \u0627\u062a\u0635\u0627\u0644 \u064a\u062f\u0648\u064a\u0629\u060c \u0631\u0627\u062c\u0639\n-  [MCPServerAdapter](/ar/mcp/overview#advanced-mcpserveradapter).\n+  [MCPServerAdapter](/ar/mcp/overview#\u0645\u062a\u0642\u062f\u0645-mcpserveradapter).\n </Info>\n \n ## \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\ndiff --git a/docs/edge/ar/quickstart.mdx b/docs/edge/ar/quickstart.mdx\nindex d8f22343fd..94319a8945 100644\n--- a/docs/edge/ar/quickstart.mdx\n+++ b/docs/edge/ar/quickstart.mdx\n@@ -20,7 +20,7 @@ mode: \"wide\"\n ## \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629\n \n - \u0628\u064a\u0626\u0629 Python \u0648\u0648\u0627\u062c\u0647\u0629 \u0633\u0637\u0631 \u0623\u0648\u0627\u0645\u0631 CrewAI (\u0631\u0627\u062c\u0639 [\u0627\u0644\u062a\u062b\u0628\u064a\u062a](/ar/installation))\n-- \u0646\u0645\u0648\u0630\u062c \u0644\u063a\u0648\u064a \u0645\u0647\u064a\u0623 \u0628\u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u2014 \u0631\u0627\u062c\u0639 [LLMs](/ar/concepts/llms#setting-up-your-llm)\n+- \u0646\u0645\u0648\u0630\u062c \u0644\u063a\u0648\u064a \u0645\u0647\u064a\u0623 \u0628\u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u2014 \u0631\u0627\u062c\u0639 [LLMs](/ar/concepts/llms#\u0625\u0639\u062f\u0627\u062f-llm-\u0627\u0644\u062e\u0627\u0635-\u0628\u0643)\n - \u0645\u0641\u062a\u0627\u062d API \u0645\u0646 [Serper.dev](https://serper.dev/) (`SERPER_API_KEY`) \u0644\u0644\u0628\u062d\u062b \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062f\u0631\u0633\n \n ## \u0627\u0628\u0646\u0650 \u0623\u0648\u0644 Flow \u0644\u0643\n@@ -155,7 +155,7 @@ mode: \"wide\"\n   \u0641\u064a \u062c\u0630\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u060c \u0636\u0628\u0637 `.env`:\n \n     - `SERPER_API_KEY` \u2014 \u0645\u0646 [Serper.dev](https://serper.dev/)\n-    - \u0645\u0641\u0627\u062a\u064a\u062d \u0645\u0632\u0648\u0651\u062f \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u062c\u0629 \u2014 \u0631\u0627\u062c\u0639 [\u0625\u0639\u062f\u0627\u062f LLM](/ar/concepts/llms#setting-up-your-llm)\n+    - \u0645\u0641\u0627\u062a\u064a\u062d \u0645\u0632\u0648\u0651\u062f \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u062c\u0629 \u2014 \u0631\u0627\u062c\u0639 [\u0625\u0639\u062f\u0627\u062f LLM](/ar/concepts/llms#\u0625\u0639\u062f\u0627\u062f-llm-\u0627\u0644\u062e\u0627\u0635-\u0628\u0643)\n   </Step>\n \n   <Step title=\"\u0627\u0644\u062a\u062b\u0628\u064a\u062a \u0648\u0627\u0644\u062a\u0634\u063a\u064a\u0644\">\n@@ -198,7 +198,7 @@ mode: \"wide\"\n 2. **\u0627\u0644\u0637\u0627\u0642\u0645** \u2014 \u064a\u062d\u0645\u0651\u0644 `kickoff_content_crew` \u0645\u0644\u0641 `crew.jsonc` \u0648\u064a\u0634\u063a\u0651\u0644 \u0645\u0647\u0645\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u0648\u0643\u064a\u0644 \u0648\u0627\u062d\u062f: \u0627\u0644\u0628\u0627\u062d\u062b \u064a\u0633\u062a\u062e\u062f\u0645 **Serper** \u0644\u0644\u0628\u062d\u062b \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628 \u062b\u0645 \u064a\u0643\u062a\u0628 \u0627\u0644\u062a\u0642\u0631\u064a\u0631.\n 3. **\u0627\u0644\u0645\u064f\u062e\u0631\u064e\u062c** \u2014 \u064a\u0643\u062a\u0628 `output_file` \u0644\u0644\u0645\u0647\u0645\u0629 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0641\u064a `output/report.md`.\n \n-\u0644\u0644\u062a\u0639\u0645\u0642 \u0641\u064a \u0623\u0646\u0645\u0627\u0637 Flow (\u0627\u0644\u062a\u0648\u062c\u064a\u0647\u060c \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629\u060c \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0641\u064a \u0627\u0644\u062d\u0644\u0642\u0629)\u060c \u0631\u0627\u062c\u0639 [\u0627\u0628\u0646\u0650 \u0623\u0648\u0644 Flow](/ar/guides/flows/first-flow) \u0648[Flows](/ar/concepts/flows). \u0644\u0644\u0637\u0648\u0627\u0642\u0645 \u062f\u0648\u0646 Flow\u060c \u0631\u0627\u062c\u0639 [Crews](/ar/concepts/crews). \u0644\u0648\u0643\u064a\u0644 `Agent` \u0648\u0627\u062d\u062f \u0648`kickoff()` \u0628\u0644\u0627 \u0645\u0647\u0627\u0645\u060c \u0631\u0627\u062c\u0639 [Agents](/ar/concepts/agents#direct-agent-interaction-with-kickoff).\n+\u0644\u0644\u062a\u0639\u0645\u0642 \u0641\u064a \u0623\u0646\u0645\u0627\u0637 Flow (\u0627\u0644\u062a\u0648\u062c\u064a\u0647\u060c \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629\u060c \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0641\u064a \u0627\u0644\u062d\u0644\u0642\u0629)\u060c \u0631\u0627\u062c\u0639 [\u0627\u0628\u0646\u0650 \u0623\u0648\u0644 Flow](/ar/guides/flows/first-flow) \u0648[Flows](/ar/concepts/flows). \u0644\u0644\u0637\u0648\u0627\u0642\u0645 \u062f\u0648\u0646 Flow\u060c \u0631\u0627\u062c\u0639 [Crews](/ar/concepts/crews). \u0644\u0648\u0643\u064a\u0644 `Agent` \u0648\u0627\u062d\u062f \u0648`kickoff()` \u0628\u0644\u0627 \u0645\u0647\u0627\u0645\u060c \u0631\u0627\u062c\u0639 [Agents](/ar/concepts/agents).\n \n <Check>\n \u0623\u0635\u0628\u062d \u0644\u062f\u064a\u0643 Flow \u0643\u0627\u0645\u0644 \u0645\u0639 \u0637\u0627\u0642\u0645 \u0648\u0643\u064a\u0644 \u0648\u062a\u0642\u0631\u064a\u0631 \u0645\u062d\u0641\u0648\u0638 \u2014 \u0642\u0627\u0639\u062f\u0629 \u0642\u0648\u064a\u0629 \u0644\u0625\u0636\u0627\u0641\u0629 \u062e\u0637\u0648\u0627\u062a \u0623\u0648 \u0637\u0648\u0627\u0642\u0645 \u0623\u0648 \u0623\u062f\u0648\u0627\u062a.\ndiff --git a/docs/edge/ar/tools/ai-ml/codeinterpretertool.mdx b/docs/edge/ar/tools/ai-ml/codeinterpretertool.mdx\nindex bbaea809b4..1145739d82 100644\n--- a/docs/edge/ar/tools/ai-ml/codeinterpretertool.mdx\n+++ b/docs/edge/ar/tools/ai-ml/codeinterpretertool.mdx\n@@ -30,7 +30,7 @@ mode: \"wide\"\n ### \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u063a\u064a\u0631 \u0627\u0644\u0622\u0645\u0646\n \n **\u063a\u064a\u0631 \u0645\u0648\u0635\u0649 \u0628\u0647 \u0644\u0644\u0625\u0646\u062a\u0627\u062c**\n-\u064a\u0633\u0645\u062d \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639 \u0628\u062a\u0646\u0641\u064a\u0630 \u0623\u064a \u0643\u0648\u062f Python\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0627\u0633\u062a\u062f\u0639\u0627\u0621\u0627\u062a \u0627\u0644\u062e\u0637\u064a\u0631\u0629 \u0644\u0640 `sys, os..` \u0648\u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629. [\u0627\u0637\u0644\u0639 \u0639\u0644\u0649](/ar/tools/ai-ml/codeinterpretertool#enabling-unsafe-mode) \u0643\u064a\u0641\u064a\u0629 \u062a\u0641\u0639\u064a\u0644 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639\n+\u064a\u0633\u0645\u062d \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639 \u0628\u062a\u0646\u0641\u064a\u0630 \u0623\u064a \u0643\u0648\u062f Python\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0627\u0633\u062a\u062f\u0639\u0627\u0621\u0627\u062a \u0627\u0644\u062e\u0637\u064a\u0631\u0629 \u0644\u0640 `sys, os..` \u0648\u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629. [\u0627\u0637\u0644\u0639 \u0639\u0644\u0649](/ar/tools/ai-ml/codeinterpretertool) \u0643\u064a\u0641\u064a\u0629 \u062a\u0641\u0639\u064a\u0644 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639\n \n ## \u0627\u0644\u062a\u0633\u062c\u064a\u0644\n \ndiff --git a/docs/edge/en/concepts/llms.mdx b/docs/edge/en/concepts/llms.mdx\nindex 084c60082a..2e87187068 100644\n--- a/docs/edge/en/concepts/llms.mdx\n+++ b/docs/edge/en/concepts/llms.mdx\n@@ -1231,7 +1231,7 @@ CrewAI supports streaming responses from LLMs, allowing your application to rece\n     ```\n \n     <Tip>\n-      [Click here](/en/concepts/event-listener#event-listeners) for more details\n+      [Click here](/en/concepts/event-listener#creating-a-custom-event-listener) for more details\n     </Tip>\n   </Tab>\n \ndiff --git a/docs/edge/en/learn/human-feedback-in-flows.mdx b/docs/edge/en/learn/human-feedback-in-flows.mdx\nindex 180c3b80c6..64b6edf90e 100644\n--- a/docs/edge/en/learn/human-feedback-in-flows.mdx\n+++ b/docs/edge/en/learn/human-feedback-in-flows.mdx\n@@ -707,7 +707,7 @@ class ArticleReviewFlow(Flow):\n \n - [Flows Overview](/en/concepts/flows) - Learn about CrewAI Flows\n - [Flow State Management](/en/guides/flows/mastering-flow-state) - Managing state in flows\n-- [Flow Persistence](/en/concepts/flows#persistence) - Persisting flow state\n+- [Flow Persistence](/en/concepts/flows#flow-persistence) - Persisting flow state\n - [Routing with @router](/en/concepts/flows#router) - More about conditional routing\n - [Human Input on Execution](/en/learn/human-input-on-execution) - Task-level human input\n - [Memory](/en/concepts/memory) - The unified memory system used by HITL learning\ndiff --git a/docs/edge/en/tools/ai-ml/codeinterpretertool.mdx b/docs/edge/en/tools/ai-ml/codeinterpretertool.mdx\nindex 660c98a608..3f01bf76c0 100644\n--- a/docs/edge/en/tools/ai-ml/codeinterpretertool.mdx\n+++ b/docs/edge/en/tools/ai-ml/codeinterpretertool.mdx\n@@ -30,7 +30,7 @@ This environment is very limited, with strict restrictions on many modules and b\n ### Unsafe Execution\n \n **NOT RECOMMENDED FOR PRODUCTION**\n-This mode allows execution of any Python code, including dangerous calls to `sys, os..` and similar modules. [Check out](/en/tools/ai-ml/codeinterpretertool#enabling-unsafe-mode) how to enable this mode\n+This mode allows execution of any Python code, including dangerous calls to `sys, os..` and similar modules. [Check out](/en/tools/ai-ml/codeinterpretertool#enabling-unsafe_mode) how to enable this mode\n \n ## Logging\n \ndiff --git a/docs/edge/ko/concepts/llms.mdx b/docs/edge/ko/concepts/llms.mdx\nindex df477da702..7d20290764 100644\n--- a/docs/edge/ko/concepts/llms.mdx\n+++ b/docs/edge/ko/concepts/llms.mdx\n@@ -831,7 +831,7 @@ CrewAI\ub294 LLM\uc758 \uc2a4\ud2b8\ub9ac\ubc0d \uc751\ub2f5\uc744 \uc9c0\uc6d0\ud558\uc5ec, \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc774 \ucd9c\n     ```\n \n     <Tip>\n-      [\uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5ec\uae30\ub97c \ud074\ub9ad\ud558\uc138\uc694](/ko/concepts/event-listener#event-listeners)\n+      [\uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5ec\uae30\ub97c \ud074\ub9ad\ud558\uc138\uc694](/ko/concepts/event-listener#\ucee4\uc2a4\ud140-\uc774\ubca4\ud2b8-\ub9ac\uc2a4\ub108-\uc0dd\uc131\ud558\uae30)\n     </Tip>\n   </Tab>\n \ndiff --git a/docs/edge/ko/concepts/production-architecture.mdx b/docs/edge/ko/concepts/production-architecture.mdx\nindex d089a18032..438e16a250 100644\n--- a/docs/edge/ko/concepts/production-architecture.mdx\n+++ b/docs/edge/ko/concepts/production-architecture.mdx\n@@ -84,7 +84,7 @@ Pydantic \ubaa8\ub378\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0c1\ud0dc\ub97c \uc815\uc758\ud558\uc138\uc694. \uc774\ub294 \ud0c0\uc785 \uc548\uc804\n CrewAI\uc758 Control Primitives\ub97c \ud65c\uc6a9\ud558\uc5ec Crew\uc5d0 \uacac\uace0\ud568\uacfc \uc81c\uc5b4\ub825\uc744 \ub354\ud558\uc138\uc694.\n \n ### 1. Task Guardrails\n-[Task Guardrails](/ko/concepts/tasks#task-guardrails)\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc791\uc5c5 \uacb0\uacfc\uac00 \uc218\ub77d\ub418\uae30 \uc804\uc5d0 \uc720\ud6a8\uc131\uc744 \uac80\uc0ac\ud558\uc138\uc694. \uc774\ub97c \ud1b5\ud574 agent\uac00 \uace0\ud488\uc9c8 \uacb0\uacfc\ub97c \uc0dd\uc131\ud558\ub3c4\ub85d \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n+[Task Guardrails](/ko/concepts/tasks#\uc791\uc5c5-\uac00\ub4dc\ub808\uc77c)\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc791\uc5c5 \uacb0\uacfc\uac00 \uc218\ub77d\ub418\uae30 \uc804\uc5d0 \uc720\ud6a8\uc131\uc744 \uac80\uc0ac\ud558\uc138\uc694. \uc774\ub97c \ud1b5\ud574 agent\uac00 \uace0\ud488\uc9c8 \uacb0\uacfc\ub97c \uc0dd\uc131\ud558\ub3c4\ub85d \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n \n ```python\n def validate_content(result: TaskOutput) -> Tuple[bool, Any]:\ndiff --git a/docs/edge/ko/guides/crews/first-crew.mdx b/docs/edge/ko/guides/crews/first-crew.mdx\nindex aa279bede9..03c6c2bee5 100644\n--- a/docs/edge/ko/guides/crews/first-cr