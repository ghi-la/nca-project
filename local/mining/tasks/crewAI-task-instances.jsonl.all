   elif \"key_name\" in details:\n                     prompt = details[\"prompt\"]\n                     key_name = details[\"key_name\"]\n-                    api_key_value = click.prompt(prompt, default=\"\", show_default=False)\n+                    # Hidden input goes through getpass, which reads the\n+                    # terminal and not piped stdin, so hide it only at a terminal.\n+                    api_key_value = click.prompt(\n+                        prompt,\n+                        default=\"\",\n+                        show_default=False,\n+                        hide_input=details.get(\"secret\", True) and sys.stdin.isatty(),\n+                    )\n \n                     if api_key_value.strip():\n                         env_vars[key_name] = api_key_value\n \n+        missing = missing_provider_keys(selected_provider, env_vars)\n         if env_vars:\n             write_env_file(folder_path, env_vars)\n+        if missing:\n+            echo_missing_keys(folder_path, missing)\n+        elif env_vars:\n             click.secho(\"API keys and model saved to .env file\", fg=\"green\")\n         else:\n             click.secho(\ndiff --git a/lib/cli/src/crewai_cli/create_json_crew.py b/lib/cli/src/crewai_cli/create_json_crew.py\nindex 08608a2cc9..4b053a8af2 100644\n--- a/lib/cli/src/crewai_cli/create_json_crew.py\n+++ b/lib/cli/src/crewai_cli/create_json_crew.py\n@@ -36,10 +36,12 @@\n from crewai_cli.tui_picker import pick_many, pick_one\n from crewai_cli.utils import (\n     copy_assistant_instructions,\n+    echo_missing_keys,\n     enable_prompt_line_editing,\n     get_or_create_project_id,\n     is_dmn_mode_enabled,\n     load_env_vars,\n+    missing_provider_keys,\n     render_template,\n     write_env_file,\n )\n@@ -66,58 +68,87 @@\n # Curated offline fallback / label source. The picker prefers models pulled\n # live from the vendor's own API via ``model_catalog.get_provider_models``;\n # this list is the hand-verified backstop used when n