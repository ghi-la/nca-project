.pythonhosted.org/packages/24/9c/1aa4ce60e9bc72af20dc49c92cc0566825092d92b3d6a277439fb5fb7c01/opentelemetry_proto-1.45.2.tar.gz\", hash = \"sha256:bd8d23cf770605b0af9b7be2071d26a464fea289d35429abfd2a66226114ad64\", size = 46486, upload-time = \"2026-10-29T17:29:53.007Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/ab/9a/42ec8180a769516ae757e893b69736826efceac7332553915b4528a91c6d/opentelemetry_proto-1.45.1-py3-none-any.whl\", hash = \"sha256:f38e2a8413053c180cd3d2637fbb279673ec2f6a6e09c995aafa2f452c52b46e\", size = 72488, upload-time = \"2026-10-06T17:32:53.057Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/7e/0d/a0b8f2b9efe2ec1abdf639d3696db9b1563ebeb11d91aac08ba7341e9122/opentelemetry_proto-1.45.2-py3-none-any.whl\", hash = \"sha256:03a7ca1b43f89fd5b965d5975902bb2515c0c86e2428b456836e9a6149c6235a\", size = 72484, upload-time = \"2026-10-29T17:29:31.403Z\" },\n ]\n \n [[package]]\n name = \"opentelemetry-sdk\"\n-version = \"1.45.1\"\n+version = \"1.45.2\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"opentelemetry-api\" },\n@@ -6168,23 +6168,23 @@ dependencies = [\n     { name = \"typing-extensions\", version = \"4.15.0\", source = { registry = \"https://pypi.org/simple\" }, marker = \"python_full_version >= '3.11'\" },\n     { name = \"typing-extensions\", version = \"4.16.0\", source = { registry = \"https://pypi.org/simple\" }, marker = \"python_full_version < '3.11'\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/a1/79/7392e21a1c8f0c61d90b223e31c7e48cb9d452e91a6b820ad24cca5f23c4/opentelemetry_sdk-1.45.1.tar.gz\", hash = \"sha256:63d24a6ca645019a631e6a51999c73e93adcac1196ca640b8ae78a7cc4762bf3\", size = 218324, upload-time = \"2026-10-06T17:33:13.26Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/7b/1a/74a21d4d6969fb8b432ac397e66112a8167a6deb267ea4559dbaf2fe91ef/opentelemetry_sdk-1.45.2.tar.gz\", hash = \"sha256:7eec4de13dd21ff3a1670dcb0e02079e692736f94d733dfdce5af461d884248d\", size = 221705, upload-time = \"2026-10-29T17:29:54.685Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/95/3c/87c42b4bd6dd297536f04cd9383d212ac557ecd49f2cbdcd46da1c9ef5c8/opentelemetry_sdk-1.45.1-py3-none-any.whl\", hash = \"sha256:c604c11dc429810812348989115fa44bd558772a3d7442afc43d024f2c250ca4\", size = 140063, upload-time = \"2026-10-06T17:32:55.04Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/9f/a5/9a3b793ef48245f2336a16beb2324c2397dbb3f987cd68942f77cca06156/opentelemetry_sdk-1.45.2-py3-none-any.whl\", hash = \"sha256:ff974ea70ee4f1d51e2ec152db37c2b626c7bf82bb3f7d86114fd8704e7199c6\", size = 141756, upload-time = \"2026-10-29T17:29:33.722Z\" },\n ]\n \n [[package]]\n name = \"opentelemetry-semantic-conventions\"\n-version = \"0.66b1\"\n+version = \"0.66b2\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"opentelemetry-api\" },\n     { name = \"typing-extensions\", version = \"4.15.0\", source = { registry = \"https://pypi.org/simple\" }, marker = \"python_full_version >= '3.11'\" },\n     { name = \"typing-extensions\", version = \"4.16.0\", source = { registry = \"https://pypi.org/simple\" }, marker = \"python_full_version < '3.11'\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/46/e4/dbbfb2a010c4db2224a5114638acede6fe563d33cc20fb1752cebcbe6298/opentelemetry_semantic_conventions-0.66b1.tar.gz\", hash = \"sha256:497ca63bf383723411e8eaf60c8779e9877633c936bb641080adab59d0eb6ec8\", size = 150250, upload-time = \"2026-10-06T17:33:14.073Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/37/3f/50f95972b50e8e353f5b9342034c9cd17730f1956f009ce6a3fbbd89f9ce/opentelemetry_semantic_conventions-0.66b2.tar.gz\", hash = \"sha256:7da5f1a5dc4383eb66711d4d3d3e71824d9403ac1559fea021cc103c1a4c4976\", size = 150246, upload-time = \"2026-10-29T17:29:55.682Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/bc/14/67f8aa798857f8cf686f515bf93d9bb877ce952ddc8efae0fa25b45ce0d6/opentelemetry_semantic_conventions-0.66b1-py3-none-any.whl\", hash = \"sha256:d4cddeb4315490b35213f55e2bdc9ac54bb1e4d318927475bed62b35545e581b\", size = 206279, upload-time = \"2026-10-06T17:32:56.103Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/67/bd/6bf33ed31521c565931c037e9e81bac47c1acb000e850c6e24220e2a0c00/opentelemetry_semantic_conventions-0.66b2-py3-none-any.whl\", hash = \"sha256:4cbe61e5f9275d57ab31708446e7938ef4291ebbe6a7fca6f7a629c5acae87d8\", size = 206280, upload-time = \"2026-10-29T17:29:35.062Z\" },\n ]\n \n [[package]]\n", "test_patch": "", "problem_statement": "pip-audit failing: dnspython GHSA-vvf4-9x63-8xvv and opentelemetry-api GHSA-mf5v-w3w3-f6cg\nThe vulnerability-scan `pip-audit` job fails with:\n\n- `dnspython==2.9.0`: GHSA-vvf4-9x63-8xvv (excessive memory and CPU use; fixed in 2.9.2, which requires Python >=3.11)\n- `opentelemetry-api==1.45.1`: GHSA-mf5v-w3w3-f6cg (DoS via quadratic-time traceparent parsing; fixed in 1.45.2)\n\nFix: bump both via `override-dependencies` (OTel sdk and exporter in lockstep) and refresh `uv.lock`.\n", "hints_text": "", "created_at": "2026-11-15T09:17:05Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9445, "instance_id": "crewAIInc__crewAI-9445", "issue_numbers": ["9444"], "base_commit": "d7dfa0ef5ade793bd48ff7357c6eb45a45294371", "patch": "diff --git a/lib/cli/src/crewai_cli/utils.py b/lib/cli/src/crewai_cli/utils.py\nindex ef6e0ab68b..2cf02e116b 100644\n--- a/lib/cli/src/crewai_cli/utils.py\n+++ b/lib/cli/src/crewai_cli/utils.py\n@@ -198,7 +198,7 @@ def render_template(src: Path, replacements: Mapping[str, str]) -> str:\n def fetch_and_json_env_file(env_file_path: str = \".env\") -> dict[str, Any]:\n     \"\"\"Fetch the environment variables from a .env file and return them as a dictionary.\"\"\"\n     try:\n-        with open(env_file_path, \"r\") as f:\n+        with open(env_file_path, \"r\", encoding=\"utf-8\") as f:\n             env_content = f.read()\n \n         env_dict = {}\n@@ -259,7 +259,7 @@ def load_env_vars(folder_path: Path) -> dict[str, Any]:\n     env_file_path = folder_path / \".env\"\n     env_vars = {}\n     if env_file_path.exists():\n-        with open(env_file_path, \"r\") as file:\n+        with open(env_file_path, \"r\", encoding=\"utf-8\") as file:\n             for line in file:\n                 key, _, value = line.strip().partition(\"=\")\n                 if key and value:\n@@ -282,7 +282,7 @@ def write_env_file(folder_path: Path, env_vars: dict[str, Any]) -> None:\n             f\"Not writing API keys to {env_file_path}: it is a symlink.\"\n         )\n     flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, \"O_NOFOLLOW\", 0)\n-    with os.fdopen(os.open(env_file_path, flags, 0o600), \"w\") as file:\n+    with os.fdopen(os.open(env_file_path, flags, 0o600), \"w\", encoding=\"utf-8\") as file:\n         if sys.platform != \"win32\":\n             # os.open's mode applies only when it creates the file.\n             os.fchmod(file.fileno(), 0o600)\n", "test_patch": "diff --git a/lib/cli/tests/test_utils.py b/lib/cli/tests/test_utils.py\nindex 60cc9416ef..130cce9821 100644\n--- a/lib/cli/tests/test_utils.py\n+++ b/lib/cli/tests/test_utils.py\n@@ -215,3 +215,60 @@ def test_write_env_file_never_writes_keys_through_a_symlink(tmp_path):\n         utils.write_env_file(project, {\"OPENAI_API_KEY\": \"sk-test\"})\n \n     assert target.read_text() == \"untouched\\n\"\n+\n+\n+@pytest.fixture\n+def ascii_default_encoding(monkeypatch):\n+    \"\"\"Make text files default to ASCII, as on a Windows or C-locale machine.\n+\n+    The platform default decides how ``open()`` and ``os.fdopen()`` treat a text\n+    file when no encoding is given. Python reads it from the OS, so the tests\n+    stand in for it by filling it in when a caller leaves it out.\n+    \"\"\"\n+    real_open = open\n+    real_fdopen = os.fdopen\n+\n+    def default_ascii(real):\n+        def wrapper(*args, **kwargs):\n+            mode = args[1] if len(args) > 1 else kwargs.get(\"mode\", \"r\")\n+            if \"b\" not in mode:\n+                kwargs.setdefault(\"encoding\", \"ascii\")\n+            return real(*args, **kwargs)\n+\n+        return wrapper\n+\n+    monkeypatch.setattr(\"builtins.open\", default_ascii(real_open))\n+    monkeypatch.setattr(os, \"fdopen\", default_ascii(real_fdopen))\n+\n+\n+def test_load_env_vars_reads_a_utf8_env_file(tmp_path, ascii_default_encoding):\n+    (tmp_path / \".env\").write_bytes(\n+        \"# \u9879\u76ee\u914d\u7f6e\\nOPENAI_API_KEY=sk-test\\nNOTE=caf\u00e9\\n\".encode()\n+    )\n+\n+    assert utils.load_env_vars(tmp_path) == {\n+        \"OPENAI_API_KEY\": \"sk-test\",\n+        \"NOTE\": \"caf\u00e9\",\n+    }\n+\n+\n+def test_fetch_and_json_env_file_reads_a_utf8_env_file(tmp_path, ascii_default_encoding):\n+    env_file = tmp_path / \".env\"\n+    env_file.write_bytes(\"# \u9879\u76ee\u914d\u7f6e\\nOPENAI_API_KEY=sk-test\\nNOTE=caf\u00e9\\n\".encode())\n+\n+    assert utils.fetch_and_json_env_file(str(env_file)) == {\n+        \"OPENAI_API_KEY\": \"sk-test\",\n+        \"NOTE\": \"caf\u00e9\",\n+    }\n+\n+\n+def test_write_env_file_writes_utf8(tmp_path, ascii_default_encoding):\n+    utils.write_env_file(tmp_path, {\"note\": \"caf\u00e9\"})\n+\n+    assert (tmp_path / \".env\").read_bytes() == \"NOTE=caf\u00e9\\n\".encode()\n+\n+\n+def test_env_file_round_trips_non_ascii_values(tmp_path, ascii_default_encoding):\n+    utils.write_env_file(tmp_path, {\"note\": \"\u9879\u76ee\"})\n+\n+    assert utils.load_env_vars(tmp_path) == {\"NOTE\": \"\u9879\u76ee\"}\n", "problem_statement": "[BUG] The CLI reads and writes .env with the platform default encoding, so non-ASCII text breaks on Windows\n### Description\n\n`fetch_and_json_env_file`, `load_env_vars` and `write_env_file` in `lib/cli/src/crewai_cli/utils.py` open the `.env` file without an `encoding`. Python then uses the platform default: cp1252 on Windows, ASCII under a C locale. `.env` files are normally UTF-8, which is also what `python-dotenv` (used by `crewai run`) reads them as, so these helpers disagree with the rest of the toolchain.\n\nWith any non-ASCII text in the file (a comment in Chinese, an accented value), on such a platform:\n\n- `fetch_and_json_env_file` (used when deploying) catches the decode error, prints \"Error reading the .env file\", and returns `{}`. The deploy continues with no environment variables.\n- `load_env_vars` raises `UnicodeDecodeError`, which stops the JSON-crew create flow.\n- `write_env_file` raises `UnicodeEncodeError` for a non-ASCII value, or writes it in a different encoding than the reader expects.\n\nThe same kind of fix was recently made for `pyproject.toml` in `crewai_core.project` (#9414).\n\n### Steps to Reproduce\n\nWindows reproduces it directly. To see it on any OS, make the default encoding non-UTF-8:\n\n```python\n# PYTHONUTF8=0 PYTHONCOERCECLOCALE=0 LC_ALL=C python repro.py\nimport locale, tempfile\nfrom pathlib import Path\nfrom crewai_cli.utils import fetch_and_json_env_file, load_env_vars, write_env_file\n\nprint(\"default encoding:\", locale.getpreferredencoding(False))\nfolder = Path(tempfile.mkdtemp())\n(folder / \".env\").write_bytes(\"# \u9879\u76ee\u914d\u7f6e\\nOPENAI_API_KEY=sk-test\\n\".encode(\"utf-8\"))\n\nprint(fetch_and_json_env_file(str(folder / \".env\")))\ntry:\n    print(load_env_vars(folder))\nexcept Exception as e:\n    print(\"load_env_vars ->\", type(e).__name__)\ntry:\n    write_env_file(folder, {\"note\": \"caf\u00e9\"})\nexcept Exception as e:\n    print(\"write_env_file ->\", type(e).__name__)\n```\n\nOutput on `main` (d7dfa0ef5):\n\n```\ndefault encoding: US-ASCII\nError reading the .env file: 'ascii' codec can't decode byte 0xe9 in position 2:\n{}\nload_env_vars -> UnicodeDecodeError\nwrite_env_file -> UnicodeEncodeError\n```\n\n### Expected behavior\n\nThe three helpers read and write `.env` as UTF-8 on every platform, so the file is read the same way `crewai run` reads it.\n\n### Screenshots/Code snippets\n\nSee above.\n\n### Operating System\n\nmacOS (Darwin 25.4), reproduced with a non-UTF-8 default encoding. The cp1252 case applies to Windows.\n\n### Python Version\n\n3.13\n\n### crewAI Version\n\nmain @ d7dfa0ef5\n\n### crewAI Tools Version\n\nn/a\n\n### Virtual Environment\n\nVenv (uv)\n\n### Evidence\n\n`fetch_and_json_env_file`, `load_env_vars` and `write_env_file` call `open(path, \"r\")` / `os.fdopen(fd, \"w\")` with no `encoding`.\n\n### Possible Solution\n\nPass `encoding=\"utf-8\"` in all three. I have a fix with tests and can open a PR.\n\n### Additional context\n\nPrepared with the help of an AI coding assistant (Claude Code), so this should carry the `llm-generated` label. I reproduced and checked everything above myself.\n\n", "hints_text": "", "created_at": "2026-11-14T13:57:43Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9421, "instance_id": "crewAIInc__crewAI-9421", "issue_numbers": ["9420"], "base_commit": "c6809a33e67a96c4fd800ca5871622158c46cc4e", "patch": "diff --git a/lib/crewai/src/crewai/project/crew_base.py b/lib/crewai/src/crewai/project/crew_base.py\nindex fa945f0c56..30dcfa363d 100644\n--- a/lib/crewai/src/crewai/project/crew_base.py\n+++ b/lib/crewai/src/crewai/project/crew_base.py\n@@ -57,8 +57,8 @@ class AgentConfig(TypedDict, total=False):\n     max_tokens: int\n     callbacks: list[str]\n \n-    llm: str\n-    function_calling_llm: str\n+    llm: str | dict[str, Any]\n+    function_calling_llm: str | dict[str, Any]\n     use_system_prompt: bool\n \n     system_template: str\n@@ -661,7 +661,7 @@ def _map_agent_variables(\n         callbacks: Dictionary of available callbacks.\n     \"\"\"\n     if llm := agent_info.get(\"llm\"):\n-        factory = llms.get(llm)\n+        factory = llms.get(llm) if isinstance(llm, str) else None\n         self.agents_config[agent_name][\"llm\"] = factory() if factory else llm\n \n     if tools := agent_info.get(\"tools\"):\n@@ -671,7 +671,11 @@ def _map_agent_variables(\n             ]\n \n     if function_calling_llm := agent_info.get(\"function_calling_llm\"):\n-        factory = llms.get(function_calling_llm)\n+        factory = (\n+            llms.get(function_calling_llm)\n+            if isinstance(function_calling_llm, str)\n+            else None\n+        )\n         self.agents_config[agent_name][\"function_calling_llm\"] = (\n             factory() if factory else function_calling_llm\n         )\n", "test_patch": "diff --git a/lib/crewai/tests/test_project.py b/lib/crewai/tests/test_project.py\nindex 13c3afd07b..2be6898566 100644\n--- a/lib/crewai/tests/test_project.py\n+++ b/lib/crewai/tests/test_project.py\n@@ -227,6 +227,41 @@ def test_agent_function_calling_llm():\n     )\n \n \n+def test_agent_llm_given_as_a_mapping_in_yaml(tmp_path):\n+    agents_yaml = tmp_path / \"agents.yaml\"\n+    agents_yaml.write_text(\n+        \"researcher:\\n\"\n+        \"  role: Researcher\\n\"\n+        \"  goal: Find facts\\n\"\n+        \"  backstory: Careful\\n\"\n+        \"  llm:\\n\"\n+        \"    model: openai/gpt-4o-mini\\n\"\n+        \"    temperature: 0.2\\n\"\n+        \"  function_calling_llm:\\n\"\n+        \"    model: openai/gpt-4o-mini\\n\"\n+        \"    temperature: 0.1\\n\",\n+        encoding=\"utf-8\",\n+    )\n+    tasks_yaml = tmp_path / \"tasks.yaml\"\n+    tasks_yaml.write_text(\"\", encoding=\"utf-8\")\n+\n+    @CrewBase\n+    class MappingLLMCrew:\n+        agents_config = str(agents_yaml)\n+        tasks_config = str(tasks_yaml)\n+\n+        @agent\n+        def researcher(self):\n+            return Agent(config=self.agents_config[\"researcher\"])  # type: ignore[index]\n+\n+    researcher = MappingLLMCrew().researcher()\n+\n+    assert isinstance(researcher.llm, BaseLLM)\n+    assert researcher.llm.temperature == 0.2\n+    assert isinstance(researcher.function_calling_llm, BaseLLM)\n+    assert researcher.function_calling_llm.temperature == 0.1\n+\n+\n def test_task_guardrail():\n     crew = InternalCrew()\n     research_task = crew.research_task()\n", "problem_statement": "[BUG] @CrewBase fails with unhashable type: 'dict' when an agent's llm in agents.yaml is a mapping\n### Description\n\n`Agent` accepts its `llm` as a mapping of LLM settings: `create_llm()` builds the LLM from a dict with a `model` key, so `Agent(llm={\"model\": \"openai/gpt-4o-mini\", \"temperature\": 0.2})` gets an LLM with temperature 0.2. The same mapping in `agents.yaml` makes `@CrewBase` fail before any agent is built.\n\n`_map_agent_variables()` in `crewai/project/crew_base.py` checks whether the value names one of the crew's `@llm` methods with `llms.get(llm)`, and passes the value through to the agent when it doesn't. A YAML mapping is a `dict`, which can't be used as a dictionary key, so the lookup raises `TypeError: unhashable type: 'dict'` instead of reaching the pass-through. `function_calling_llm` goes through the same lookup.\n\n### Steps to Reproduce\n\n`config/agents.yaml`:\n\n```yaml\nresearcher:\n  role: Researcher\n  goal: Find facts\n  backstory: Careful\n  llm:\n    model: openai/gpt-4o-mini\n    temperature: 0.2\n```\n\n`crew.py`:\n\n```python\nfrom crewai import Agent\nfrom crewai.project import CrewBase, agent\n\n\n@CrewBase\nclass ResearchCrew:\n    agents_config = \"config/agents.yaml\"\n    tasks_config = \"config/tasks.yaml\"\n\n    @agent\n    def researcher(self) -> Agent:\n        return Agent(config=self.agents_config[\"researcher\"])\n\n\nResearchCrew()\n```\n\nNo LLM call is needed to reproduce it.\n\n### Expected behavior\n\nThe mapping reaches `Agent` unchanged, as a model name that isn't an `@llm` method already does, and `ResearchCrew().researcher().llm.temperature` is `0.2`.\n\n### Screenshots/Code snippets\n\n```\n  File \"crewai\\project\\crew_base.py\", line 664, in _map_agent_variables\n    factory = llms.get(llm)\nTypeError: unhashable type: 'dict'\n```\n\n### Operating System\n\nWindows 11 (the lookup is the same on every platform)\n\n### Python Version\n\n3.13\n\n### crewAI Version\n\nmain at 9b38b54 (1.15.41)\n\n### crewAI Tools Version\n\nNot installed; not needed to reproduce\n\n### Possible Solution\n\nLook the value up among the `@llm` methods only when it is a string, and pass anything else through to the agent. I'm opening a PR with that change and a test.\n\n### Additional context\n\nFound and written up with an AI coding agent (Claude Opus 5.5 in OpenCode). CONTRIBUTING asks for the `llm-generated` label on AI-assisted issues; I can't add labels, so could a maintainer add it?\n\n", "hints_text": "", "created_at": "2026-11-13T04:28:21Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9414, "instance_id": "crewAIInc__crewAI-9414", "issue_numbers": ["9413"], "base_commit": "b5ea88bfa18c73784d94dee77c7f261abb454a16", "patch": "diff --git a/lib/crewai-core/src/crewai_core/project.py b/lib/crewai-core/src/crewai_core/project.py\nindex 46ac8e5195..1e944ddccb 100644\n--- a/lib/crewai-core/src/crewai_core/project.py\n+++ b/lib/crewai-core/src/crewai_core/project.py\n@@ -233,7 +233,7 @@ def _get_project_attribute(\n     attribute = None\n \n     try:\n-        with open(pyproject_path, \"r\") as f:\n+        with open(pyproject_path, \"r\", encoding=\"utf-8\") as f:\n             pyproject_content = parse_toml(f.read())\n \n         dependencies = (\n", "test_patch": "diff --git a/lib/crewai-core/tests/test_project.py b/lib/crewai-core/tests/test_project.py\nnew file mode 100644\nindex 0000000000..68c269db71\n--- /dev/null\n+++ b/lib/crewai-core/tests/test_project.py\n@@ -0,0 +1,19 @@\n+from __future__ import annotations\n+\n+from pathlib import Path\n+\n+from crewai_core.project import get_project_description, get_project_name\n+\n+\n+def test_project_attributes_read_a_non_ascii_pyproject(tmp_path: Path) -> None:\n+    pyproject = tmp_path / \"pyproject.toml\"\n+    pyproject.write_text(\n+        \"[project]\\n\"\n+        'name = \"research_crew\"\\n'\n+        'description = \"\u6570\u636e\u5206\u6790\u56e2\u961f \u00b7 Caf\u00e9\"\\n'\n+        'dependencies = [\"crewai[tools]\"]\\n',\n+        encoding=\"utf-8\",\n+    )\n+\n+    assert get_project_name(str(pyproject), require=True) == \"research_crew\"\n+    assert get_project_description(str(pyproject)) == \"\u6570\u636e\u5206\u6790\u56e2\u961f \u00b7 Caf\u00e9\"\n", "problem_statement": "[BUG] crewai deploy and crewai tool publish can't read a non-ASCII pyproject.toml on Windows\n### Description\n\n`get_project_name()`, `get_project_version()` and `get_project_description()` in `crewai_core.project` read `pyproject.toml` through `_get_project_attribute()`, which opens it without an encoding: `open(pyproject_path, \"r\")`. On Windows the file is then decoded with the ANSI code page (cp1252) instead of UTF-8, which TOML requires. `read_toml()` in the same module, which `get_project_id()` uses, reads the file as UTF-8.\n\nWhat this does on Windows:\n\n- If the file has a character whose UTF-8 bytes include one that cp1252 does not define (0x81, 0x8D, 0x8F, 0x90, 0x9D), it can't be read at all. That covers most CJK text and letters such as \"\u010d\", \"\u0141\" or \"\u014d\". `crewai deploy` stops in `DeployCommand.__init__` with \"Unable to read 'project.name' in the pyproject.toml file\", and `crewai tool publish` stops the same way.\n- Other non-ASCII text is read as mojibake, so `crewai tool publish` sends `description = \"Caf\u00e9 crew\"` as `Caf\u00c3\u00a9 crew`.\n\n### Steps to Reproduce\n\nOn Windows 11 with Python 3.13 (default encoding cp1252):\n\n```python\nfrom pathlib import Path\n\nfrom crewai_core.project import get_project_description, get_project_name\n\nPath(\"pyproject.toml\").write_text(\n    '[project]\\nname = \"research_crew\"\\nversion = \"0.1.0\"\\n'\n    'description = \"\u6570\u636e\u5206\u6790\u56e2\u961f\"\\ndependencies = [\"crewai[tools]\"]\\n',\n    encoding=\"utf-8\",\n)\nget_project_name(require=True)\n```\n\nWith `description = \"Caf\u00e9 crew\"` instead, `get_project_description()` returns `'Caf\u00c3\u00a9 crew'`.\n\n### Expected behavior\n\nThe values are read from the UTF-8 file as they are on Linux and macOS: `research_crew`, `\u6570\u636e\u5206\u6790\u56e2\u961f`, `Caf\u00e9 crew`.\n\n### Screenshots/Code snippets\n\n```\nError reading the pyproject.toml file: 'charmap' codec can't decode byte 0x8d in position 73: character maps to <undefined>\nUnable to read 'project.name' in the pyproject.toml file. Please verify that the file exists and contains the specified attribute.\n```\n\n### Operating System\n\nWindows 11\n\n### Python Version\n\n3.13\n\n### crewAI Version\n\n1.15.40 (the line is the same in the 1.15.41 release and on main at 878d6c5)\n\n### crewAI Tools Version\n\nNot installed; not needed to reproduce\n\n### Possible Solution\n\nOpen the file with `encoding=\"utf-8\"` in `_get_project_attribute()`. I'm opening a PR with that change and a test.\n\n### Additional context\n\nFound and written up with an AI coding agent (Claude Opus 5.5 in OpenCode). CONTRIBUTING asks for the `llm-generated` label on AI-assisted issues; I can't add labels, so could a maintainer add it?\n\n", "hints_text": "", "created_at": "2026-11-12T19:01:27Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9360, "instance_id": "crewAIInc__crewAI-9360", "issue_numbers": ["9355"], "base_commit": "0b8b216db35eec36610b5e08c31eb31a29f5c9c1", "patch": "diff --git a/lib/crewai/src/crewai/llm.py b/lib/crewai/src/crewai/llm.py\nindex 5abc57caeb..58d77e475b 100644\n--- a/lib/crewai/src/crewai/llm.py\n+++ b/lib/crewai/src/crewai/llm.py\n@@ -2151,7 +2151,16 @@ async def acall(\n                     )\n \n                     if self._effective_stream():\n-                        return await self._ahandle_streaming_response(\n+                        result = await self._ahandle_streaming_response(\n+                            params=params,\n+                            callbacks=callbacks,\n+                            available_functions=available_functions,\n+                            from_task=from_task,\n+                            from_agent=from_agent,\n+                            response_model=response_model,\n+                        )\n+                    else:\n+                        result = await self._ahandle_non_streaming_response(\n                             params=params,\n                             callbacks=callbacks,\n                             available_functions=available_functions,\n@@ -2160,14 +2169,12 @@ async def acall(\n                             response_model=response_model,\n                         )\n \n-                    return await self._ahandle_non_streaming_response(\n-                        params=params,\n-                        callbacks=callbacks,\n-                        available_functions=available_functions,\n-                        from_task=from_task,\n-                        from_agent=from_agent,\n-                        response_model=response_model,\n-                    )\n+                    if isinstance(result, str):\n+                        result = self._invoke_after_llm_call_hooks(\n+                            messages, result, from_agent\n+                        )\n+\n+                    return result\n                 except LLMContextLengthExceededError:\n                     raise\n                 except Exception as e:\n", "test_patch": "diff --git a/lib/crewai/tests/hooks/test_async_after_llm_call_hooks.py b/lib/crewai/tests/hooks/test_async_after_llm_call_hooks.py\nnew file mode 100644\nindex 0000000000..a5e3a2cc76\n--- /dev/null\n+++ b/lib/crewai/tests/hooks/test_async_after_llm_call_hooks.py\n@@ -0,0 +1,47 @@\n+\"\"\"Async LLM calls must run the after_llm_call hooks like sync calls do.\"\"\"\n+\n+from __future__ import annotations\n+\n+from unittest.mock import AsyncMock, patch\n+\n+from crewai import LLM\n+from crewai.hooks.llm_hooks import (\n+    LLMCallHookContext,\n+    clear_all_llm_call_hooks,\n+    register_after_llm_call_hook,\n+)\n+import pytest\n+\n+\n+@pytest.fixture(autouse=True)\n+def _clean_llm_hooks():\n+    from crewai.hooks import llm_hooks\n+\n+    original_before = llm_hooks._before_llm_call_hooks.copy()\n+    original_after = llm_hooks._after_llm_call_hooks.copy()\n+    clear_all_llm_call_hooks()\n+\n+    yield\n+\n+    clear_all_llm_call_hooks()\n+    llm_hooks._before_llm_call_hooks.extend(original_before)\n+    llm_hooks._after_llm_call_hooks.extend(original_after)\n+\n+\n+@pytest.mark.asyncio\n+async def test_acall_runs_after_llm_call_hooks() -> None:\n+    llm = LLM(model=\"gpt-4o-mini\", is_litellm=True)\n+\n+    def redact(context: LLMCallHookContext) -> str:\n+        return (context.response or \"\").replace(\"secret\", \"[redacted]\")\n+\n+    register_after_llm_call_hook(redact)\n+\n+    with patch.object(\n+        llm,\n+        \"_ahandle_non_streaming_response\",\n+        new=AsyncMock(return_value=\"a secret\"),\n+    ):\n+        result = await llm.acall([{\"role\": \"user\", \"content\": \"say the secret\"}])\n+\n+    assert result == \"a [redacted]\"\n", "problem_statement": "LLM.acall skips after_llm_call hooks\n## Description\n\nAsync LLM calls through the LiteLLM `LLM` class never run the global `after_llm_call` hooks.\n\n`LLM.call()` runs them for string responses:\n\n```python\nif isinstance(result, str):\n    result = self._invoke_after_llm_call_hooks(messages, result, from_agent)\nreturn result\n```\n\n`LLM.acall()` returns straight from the streaming or non-streaming handler instead:\n\n```python\nif self._effective_stream():\n    return await self._ahandle_streaming_response(...)\n\nreturn await self._ahandle_non_streaming_response(...)\n```\n\nSo a hook registered with `register_after_llm_call_hook()` (or `@after_llm_call`) that rewrites a response \u2014 redacting secrets, enforcing formatting, appending citations \u2014 applies to `llm.call(...)` but is silently skipped for `await llm.acall(...)`. The native provider classes invoke the hooks on both paths; only the LiteLLM-backed `LLM` class is missing the async side.\n\n## Reproduction\n\n```python\nimport asyncio\nfrom unittest.mock import AsyncMock, patch\n\nfrom crewai import LLM\nfrom crewai.hooks.llm_hooks import register_after_llm_call_hook\n\ndef redact(context):\n    return context.response.replace(\"secret\", \"[redacted]\")\n\nregister_after_llm_call_hook(redact)\n\nllm = LLM(model=\"gpt-4o-mini\", is_litellm=True)\n\nasync def main():\n    with patch.object(\n        llm,\n        \"_ahandle_non_streaming_response\",\n        new=AsyncMock(return_value=\"a secret\"),\n    ):\n        print(await llm.acall([{\"role\": \"user\", \"content\": \"say the secret\"}]))\n\nasyncio.run(main())\n```\n\nPrints `a secret`. The same hook applied to `llm.call()` returns `a [redacted]`.\n\n## Expected behavior\n\n`acall()` applies `after_llm_call` hooks to string responses exactly as `call()` does, for both the streaming and non-streaming paths.\n\n## Suggested fix\n\nAssign the handler result, then run the shared hook helper before returning:\n\n```python\nif self._effective_stream():\n    result = await self._ahandle_streaming_response(...)\nelse:\n    result = await self._ahandle_non_streaming_response(...)\n\nif isinstance(result, str):\n    result = self._invoke_after_llm_call_hooks(messages, result, from_agent)\n\nreturn result\n```\n\n## Tests\n\nAn offline regression test registers a redacting hook, stubs `_ahandle_non_streaming_response` with an `AsyncMock`, and asserts `acall()` returns the redacted string. On current `main` (0b8b216db) it fails with `assert 'a secret' == 'a [redacted]'`.\n\nPrepared with an AI coding agent. Please apply the `llm-generated` label; this account cannot set repository labels.\n\n", "hints_text": "", "created_at": "2026-11-11T04:19:43Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9348, "instance_id": "crewAIInc__crewAI-9348", "issue_numbers": ["9343"], "base_commit": "dd3feccac1f4b93d748aa196c53aa61ee787a17a", "patch": "diff --git a/lib/crewai-tools/src/crewai_tools/tools/weaviate_tool/vector_search.py b/lib/crewai-tools/src/crewai_tools/tools/weaviate_tool/vector_search.py\nindex ef384e10cd..4029ba3cba 100644\n--- a/lib/crewai-tools/src/crewai_tools/tools/weaviate_tool/vector_search.py\n+++ b/lib/crewai-tools/src/crewai_tools/tools/weaviate_tool/vector_search.py\n@@ -86,12 +86,13 @@ class WeaviateVectorSearchTool(BaseTool):\n     def __init__(self, **kwargs: Any) -> None:\n         super().__init__(**kwargs)\n         if WEAVIATE_AVAILABLE:\n-            openai_api_key = os.environ.get(\"OPENAI_API_KEY\")\n-            if not openai_api_key:\n-                raise ValueError(\n-                    \"OPENAI_API_KEY environment variable is required for WeaviateVectorSearchTool and it is mandatory to use the tool.\"\n-                )\n-            self.headers = {\"X-OpenAI-Api-Key\": openai_api_key}\n+            if self.headers is None:\n+                openai_api_key = os.environ.get(\"OPENAI_API_KEY\")\n+                if not openai_api_key:\n+                    raise ValueError(\n+                        \"OPENAI_API_KEY environment variable is required for WeaviateVectorSearchTool and it is mandatory to use the tool.\"\n+                    )\n+                self.headers = {\"X-OpenAI-Api-Key\": openai_api_key}\n         else:\n             if click.confirm(\n                 \"You are missing the 'weaviate-client' package. Would you like to install it?\"\n", "test_patch": "diff --git a/lib/crewai-tools/tests/tools/test_weaviate_tool.py b/lib/crewai-tools/tests/tools/test_weaviate_tool.py\nnew file mode 100644\nindex 0000000000..79182af832\n--- /dev/null\n+++ b/lib/crewai-tools/tests/tools/test_weaviate_tool.py\n@@ -0,0 +1,57 @@\n+\"\"\"Regression tests for WeaviateVectorSearchTool header handling.\"\"\"\n+\n+from __future__ import annotations\n+\n+import pytest\n+\n+from crewai_tools.tools.weaviate_tool import vector_search\n+\n+\n+def _make_tool(headers: dict[str, str]) -> vector_search.WeaviateVectorSearchTool:\n+    return vector_search.WeaviateVectorSearchTool(\n+        weaviate_cluster_url=\"https://example.weaviate.cloud\",\n+        weaviate_api_key=\"weaviate-key\",\n+        collection_name=\"docs\",\n+        headers=headers,\n+        vectorizer=None,\n+        generative_model=None,\n+    )\n+\n+\n+def test_explicit_headers_are_not_replaced_by_the_environment(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    monkeypatch.setattr(vector_search, \"WEAVIATE_AVAILABLE\", True)\n+    monkeypatch.setenv(\"OPENAI_API_KEY\", \"environment-key\")\n+\n+    tool = _make_tool({\"X-OpenAI-Api-Key\": \"caller-key\"})\n+\n+    assert tool.headers == {\"X-OpenAI-Api-Key\": \"caller-key\"}\n+\n+\n+def test_explicit_headers_do_not_require_openai_env(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    monkeypatch.setattr(vector_search, \"WEAVIATE_AVAILABLE\", True)\n+    monkeypatch.delenv(\"OPENAI_API_KEY\", raising=False)\n+\n+    tool = _make_tool({\"X-Cohere-Api-Key\": \"cohere-key\"})\n+\n+    assert tool.headers == {\"X-Cohere-Api-Key\": \"cohere-key\"}\n+\n+\n+def test_default_header_still_comes_from_the_environment(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    monkeypatch.setattr(vector_search, \"WEAVIATE_AVAILABLE\", True)\n+    monkeypatch.setenv(\"OPENAI_API_KEY\", \"environment-key\")\n+\n+    tool = vector_search.WeaviateVectorSearchTool(\n+        weaviate_cluster_url=\"https://example.weaviate.cloud\",\n+        weaviate_api_key=\"weaviate-key\",\n+        collection_name=\"docs\",\n+        vectorizer=None,\n+        generative_model=None,\n+    )\n+\n+    assert tool.headers == {\"X-OpenAI-Api-Key\": \"environment-key\"}\n", "problem_statement": "[BUG] WeaviateVectorSearchTool overwrites caller-provided headers and requires OPENAI_API_KEY\n## Description\n\n`WeaviateVectorSearchTool` declares a `headers` field and forwards it to `weaviate.connect_to_weaviate_cloud()`, but `__init__` always replaces it with an OpenAI-only header and requires `OPENAI_API_KEY` even when the caller supplied headers:\n\n`lib/crewai-tools/src/crewai_tools/tools/weaviate_tool/vector_search.py:86-94`\n\n```python\nif WEAVIATE_AVAILABLE:\n    openai_api_key = os.environ.get(\"OPENAI_API_KEY\")\n    if not openai_api_key:\n        raise ValueError(\n            \"OPENAI_API_KEY environment variable is required for WeaviateVectorSearchTool and it is mandatory to use the tool.\"\n        )\n    self.headers = {\"X-OpenAI-Api-Key\": openai_api_key}\n```\n\nConsequences:\n\n- `WeaviateVectorSearchTool(..., headers={\"X-OpenAI-Api-Key\": \"caller-key\"})` silently sends the environment key instead of the caller's key.\n- A user running a custom vectorizer or generative model (both are configurable fields) cannot authenticate it: a header such as `{\"X-Cohere-Api-Key\": ...}` is discarded, and construction still fails when `OPENAI_API_KEY` is unset.\n- The tool documents `headers` in its `connect_to_weaviate_cloud(headers=self.headers)` call, so the caller has a legitimate way to pass authentication for non-OpenAI modules.\n\n## Reproduction\n\nWith `OPENAI_API_KEY=environment-key` in the environment:\n\n```python\nfrom crewai_tools import WeaviateVectorSearchTool\n\ntool = WeaviateVectorSearchTool(\n    weaviate_cluster_url=\"https://example.weaviate.cloud\",\n    weaviate_api_key=\"weaviate-key\",\n    collection_name=\"docs\",\n    headers={\"X-OpenAI-Api-Key\": \"caller-key\"},\n)\nprint(tool.headers)  # {'X-OpenAI-Api-Key': 'environment-key'}\n```\n\nWithout `OPENAI_API_KEY`, the same constructor raises `ValueError` even though the caller supplied a header.\n\n## Expected behaviour\n\nAn explicit `headers` argument should be kept as-is. The `OPENAI_API_KEY` header should only be synthesized when the caller did not provide `headers`.\n\n## Suggested fix\n\nWrap the default-header logic in `if self.headers is None:` and keep the existing requirement only for that default path.\n\n## Tests\n\n`lib/crewai-tools/tests/tools/test_weaviate_tool.py` covers explicit headers with and without `OPENAI_API_KEY` plus the default env-derived header. The first two tests fail on `main`; the default path test passes both before and after.\n\nPrepared with an AI coding agent. Please apply the `llm-generated` label; this account cannot set repository labels.\n\n", "hints_text": "", "created_at": "2026-11-11T03:20:30Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9346, "instance_id": "crewAIInc__crewAI-9346", "issue_numbers": ["9340"], "base_commit": "e72ac1747c8ef19a1d1fb8ecc7a19d780ee93eb0", "patch": "diff --git a/lib/cli/src/crewai_cli/cli.py b/lib/cli/src/crewai_cli/cli.py\nindex 17e0b7fd11..1edad37610 100644\n--- a/lib/cli/src/crewai_cli/cli.py\n+++ b/lib/cli/src/crewai_cli/cli.py\n@@ -712,7 +712,14 @@ def install(context: click.Context) -> None:\n     \"\"\"Install the Crew.\"\"\"\n     from crewai_cli.install_crew import install_crew\n \n-    install_crew(context.args)\n+    try:\n+        install_crew(context.args, raise_on_error=True)\n+    except subprocess.CalledProcessError as e:\n+        # Reporting the failure is not enough: CI and scripts key off the exit\n+        # status, and `uv sync` already printed the underlying error.\n+        raise SystemExit(e.returncode) from e\n+    except Exception as e:\n+        raise SystemExit(1) from e\n \n \n @crewai.command()\n", "test_patch": "diff --git a/lib/cli/tests/test_install_command.py b/lib/cli/tests/test_install_command.py\nnew file mode 100644\nindex 0000000000..6e12bfc25b\n--- /dev/null\n+++ b/lib/cli/tests/test_install_command.py\n@@ -0,0 +1,35 @@\n+\"\"\"Regression tests for the `crewai install` exit status.\"\"\"\n+\n+from __future__ import annotations\n+\n+import subprocess\n+from typing import Any\n+\n+from click.testing import CliRunner\n+import pytest\n+\n+from crewai_cli import install_crew as install_module\n+from crewai_cli.cli import crewai\n+\n+\n+def test_install_exits_with_the_uv_status(\n+    monkeypatch: pytest.MonkeyPatch, tmp_path: Any\n+) -> None:\n+    \"\"\"A failed `uv sync` must not be reported as a successful install.\"\"\"\n+\n+    def failing_run(*args: Any, **kwargs: Any) -> None:\n+        raise subprocess.CalledProcessError(\n+            2, [\"uv\", \"sync\"], output=\"No solution found\"\n+        )\n+\n+    monkeypatch.setattr(install_module.subprocess, \"run\", failing_run)\n+    monkeypatch.setattr(\n+        install_module, \"build_env_with_all_tool_credentials\", lambda: {}\n+    )\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"pyproject.toml\").write_text('[project]\\nname = \"demo\"\\n')\n+\n+    result = CliRunner().invoke(crewai, [\"install\"])\n+\n+    assert result.exit_code == 2, result.output\n+    assert \"An error occurred while running the crew\" in result.output\n", "problem_statement": "[BUG] crewai install exits 0 when uv sync fails\n## Description\n\n`crewai install` reports a failed install but exits with status `0`. `install_crew()` catches `subprocess.CalledProcessError`, prints the error, and returns unless the caller passes `raise_on_error=True`:\n\n`lib/cli/src/crewai_cli/install_crew.py:71-80`\n\n```python\nexcept subprocess.CalledProcessError as e:\n    click.echo(f\"An error occurred while running the crew: {e}\", err=True)\n    click.echo(e.output, err=True)\n    if raise_on_error:\n        raise\n```\n\nThe `install` command uses the default `False`:\n\n`lib/cli/src/crewai_cli/cli.py:652-656`\n\n```python\ndef install(context: click.Context) -> None:\n    \"\"\"Install the Crew.\"\"\"\n    from crewai_cli.install_crew import install_crew\n\n    install_crew(context.args)\n```\n\nThe other callers already pass `raise_on_error=True` and translate the failure into `SystemExit(e.returncode)` (`deploy/main.py:268`, `run_crew.py:454-459`), so the failure status is lost only on the user-facing `crewai install` path.\n\n## Reproduction\n\nIn a project whose dependencies cannot be resolved (an unavailable pin, a private index without credentials, no network, or simply `uv` missing), run:\n\n```bash\ncrewai install\necho $?\n```\n\nThe command prints `An error occurred while running the crew: Command '['uv', 'sync']' returned non-zero exit status ...` and then prints `0`. A CI job or install script therefore treats the project as installed and continues with a stale environment.\n\n## Expected behaviour\n\n`crewai install` should exit with `uv`'s non-zero status (or `1` when the failure is not a `CalledProcessError`), while keeping the existing error message.\n\n## Suggested fix\n\nPass `raise_on_error=True` from the command and translate the exception the same way `deploy` and `run` do:\n\n```python\ntry:\n    install_crew(context.args, raise_on_error=True)\nexcept subprocess.CalledProcessError as e:\n    raise SystemExit(e.returncode) from e\nexcept Exception:\n    raise SystemExit(1) from None\n```\n\n## Tests\n\n`lib/cli/tests/test_install_command.py` monkeypatches `subprocess.run` to raise `CalledProcessError(2, [\"uv\", \"sync\"])` and asserts the CLI exits with `2` while the error text is still printed. On `main` it fails with `assert 0 == 2`.\n\nPrepared with an AI coding agent. Please apply the `llm-generated` label; this account cannot set repository labels.\n\n", "hints_text": "", "created_at": "2026-11-11T03:19:40Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9303, "instance_id": "crewAIInc__crewAI-9303", "issue_numbers": ["9243"], "base_commit": "bb0ecba1c1028f81d001f7ad699f37498fb14dc6", "patch": "diff --git a/lib/crewai/README.md b/lib/crewai/README.md\nindex 6efbc3847c..259e253237 100644\n--- a/lib/crewai/README.md\n+++ b/lib/crewai/README.md\n@@ -632,9 +632,9 @@ CrewAI is released under the [MIT License](https://github.com/crewAIInc/crewAI/b\n \n ### Enterprise Features\n \n-- [What additional features does CrewAI AMP offer?](#q-what-additional-features-does-crewai-enterprise-offer)\n-- [Is CrewAI AMP available for cloud and on-premise deployments?](#q-is-crewai-enterprise-available-for-cloud-and-on-premise-deployments)\n-- [Can I try CrewAI AMP for free?](#q-can-i-try-crewai-enterprise-for-free)\n+- [What additional features does CrewAI AMP offer?](#q-what-additional-features-does-crewai-amp-offer)\n+- [Is CrewAI AMP available for cloud and on-premise deployments?](#q-is-crewai-amp-available-for-cloud-and-on-premise-deployments)\n+- [Can I try CrewAI AMP for free?](#q-can-i-try-crewai-amp-for-free)\n \n ### Q: What exactly is CrewAI?\n \n", "test_patch": "", "problem_statement": "docs: FAQ table links still point at pre-AMP anchors in lib/crewai/README.md\n### Description\n\nThree links in the FAQ table of `lib/crewai/README.md` still use the old \"CrewAI Enterprise\" fragments, while the corresponding Q&A headings were renamed to \"CrewAI AMP\". Clicking them lands at the top of the page instead of the answer.\n\n| Link text (unchanged) | Fragment now | Heading that exists |\n| --- | --- | --- |\n| What additional features does CrewAI AMP offer? | `#q-what-additional-features-does-crewai-enterprise-offer` | `### Q: What additional features does CrewAI AMP offer?` |\n| Is CrewAI AMP available for cloud and on-premise deployments? | `#q-is-crewai-enterprise-available-for-cloud-and-on-premise-deployments` | `### Q: Is CrewAI AMP available for cloud and on-premise deployments?` |\n| Can I try CrewAI AMP for free? | `#q-can-i-try-crewai-enterprise-for-free` | `### Q: Can I try CrewAI AMP for free?` |\n\nOnly the three `#fragment` parts need to change; link text and targets are correct.\n\n### Steps to reproduce\n\nOpen `lib/crewai/README.md`, jump to \"Enterprise Features\" in the FAQ, and click any of the three links. GitHub has no heading with the old slug, so the browser stays at the top of the document.\n\n### Expected behavior\n\nEach link resolves to the matching `### Q: ...` answer below the FAQ table (the slugs generated from the current AMP headings).\n\n### Verification\n\nA heading-slug check over the current `main` file lists all three target headings with the AMP names and none with the Enterprise names; each stale fragment occurs exactly once.\n\nI found this while auditing internal documentation links in high-star agent repositories. I have a focused three-line patch ready on a fork branch.\n\n", "hints_text": "Opened #9244 with the three fragment fixes (one line each), replacing #9242 which was auto-closed before this issue existed. Verified by recomputing heading slugs from the patched file.", "created_at": "2026-11-09T20:27:18Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9220, "instance_id": "crewAIInc__crewAI-9220", "issue_numbers": ["7728"], "base_commit": "73f48320dbe6e2dc7a9bc54fefc6a13637b9485c", "patch": "diff --git a/lib/cli/src/crewai_cli/cli.py b/lib/cli/src/crewai_cli/cli.py\nindex db15b04c68..1533bdabfc 100644\n--- a/lib/cli/src/crewai_cli/cli.py\n+++ b/lib/cli/src/crewai_cli/cli.py\n@@ -803,12 +803,18 @@ def run(\n         \"project id.\"\n     ),\n )\n+@click.option(\n+    \"--no-open\",\n+    is_flag=True,\n+    help=\"Print the report link without opening a browser (SSH, CI, headless).\",\n+)\n @click.pass_context\n def eval_command(\n     ctx: click.Context,\n     run_id: str | None,\n     models: str | None,\n     deployment_id: str | None,\n+    no_open: bool,\n ) -> None:\n     \"\"\"Evaluate this crew through CrewAI AMP, or compare models on the project's\n     deployment (--models).\n@@ -838,10 +844,15 @@ def eval_command(\n     if ctx.invoked_subcommand is not None:\n         # The subcommand does the work; an option meant for this body would\n         # otherwise be dropped without a word.\n-        if run_id is not None or models is not None or deployment_id is not None:\n+        if (\n+            run_id is not None\n+            or models is not None\n+            or deployment_id is not None\n+            or no_open\n+        ):\n             raise click.UsageError(\n-                f\"`crewai eval {ctx.invoked_subcommand}` takes no --run, --models \"\n-                \"or --deployment; give those to `crewai eval` alone.\"\n+                f\"`crewai eval {ctx.invoked_subcommand}` takes no --run, --models, \"\n+                \"--deployment or --no-open; give those to `crewai eval` alone.\"\n             )\n         return\n     if models is not None:\n@@ -850,13 +861,13 @@ def eval_command(\n                 \"--run grades a run that already happened; --models runs the \"\n                 \"deployment again. Give one of them.\"\n             )\n-        eval_models(models, deployment_id=deployment_id)\n+        eval_models(models, deployment_id=deployment_id, open_report=not no_open)\n         return\n     if deployment_id is not None:\n         raise click.UsageError(\n             \"--deployment names the deployment --models runs; add --models LIST.\"\n         )\n-    eval_crew(run_id=run_id)\n+    eval_crew(run_id=run_id, open_report=not no_open)\n \n \n @eval_command.command(name=\"export\")\ndiff --git a/lib/cli/src/crewai_cli/crew_run_tui.py b/lib/cli/src/crewai_cli/crew_run_tui.py\nindex effa1f5dd5..7393b6a5b1 100644\n--- a/lib/cli/src/crewai_cli/crew_run_tui.py\n+++ b/lib/cli/src/crewai_cli/crew_run_tui.py\n@@ -388,7 +388,10 @@ def _awaiting_dir() -> Path:\n \n @contextmanager\n def evaluating_after_run(\n-    *, trusted_amp_origins: Iterable[str] = (), tracing_turned_on: bool = False\n+    *,\n+    trusted_amp_origins: Iterable[str] = (),\n+    tracing_turned_on: bool = False,\n+    open_report: bool = True,\n ) -> Iterator[dict[str, str | None]]:\n     \"\"\"Run the crew for an evaluation that is already under way.\n \n@@ -403,11 +406,13 @@ def evaluating_after_run(\n     before the project's `.env` was loaded: which AMP origins may receive the\n     saved login (TRUSTED_AMP_ORIGINS), and whether it just turned tracing on for\n     the project (TRACING_TURNED_ON) \u2014 the one case its app says where the trace\n-    goes.\n+    goes \u2014 and whether the app may open the report in a browser (OPEN_REPORT,\n+    False for `crewai eval --no-open`).\n     \"\"\"\n     holder: dict[str, str | None] = {\n         \"execution_id\": None,\n         \"tracing_turned_on\": \"true\" if tracing_turned_on else None,\n+        \"no_open\": None if open_report else \"true\",\n     }\n     token = _AUTO_EVAL.set(holder)\n     before = os.environ.get(_AWAITING_EVAL_ENV)\n@@ -423,6 +428,7 @@ def evaluating_after_run(\n                 {\n                     \"trusted_amp_origins\": sorted(set(trusted_amp_origins)),\n                     \"tracing_turned_on\": tracing_turned_on,\n+                    \"open_report\": open_report,\n                 },\n                 out,\n             )\n@@ -463,8 +469,13 @@ def _an_evaluation_is_waiting() -> dict[str, str | None] | None:\n     said: Any = {}\n     with contextlib.suppress(ValueError):\n         said = _json.loads(text)\n-    turned_on = isinstance(said, dict) and said.get(\"tracing_turned_on\") is True\n-    return {\"execution_id\": None, \"tracing_turned_on\": \"true\" if turned_on else None}\n+    if not isinstance(said, dict):\n+        said = {}\n+    return {\n+        \"execution_id\": None,\n+        \"tracing_turned_on\": \"true\" if said.get(\"tracing_turned_on\") is True else None,\n+        \"no_open\": \"true\" if said.get(\"open_report\") is False else None,\n+    }\n \n \n def _recorded_run(execution_uuid: str) -> dict[str, Any] | None:\n@@ -1632,7 +1643,7 @@ def _evaluation_started(self, started: dict[str, Any]) -> None:\n             {\"state\": \"running\", \"id\": started.get(\"id\"), \"url\": url, \"note\": None}\n         )\n         self._refresh_eval_button()\n-        if isinstance(url, str) and url:\n+        if isinstance(url, str) and url and not (self._auto_eval or {}).get(\"no_open\"):\n             self._open_report(url)\n \n     def _evaluation_progress(self, payload: dict[str, Any]) -> None:\ndiff --git a/lib/cli/src/crewai_cli/experimental/eval_crew.py b/lib/cli/src/crewai_cli/experimental/eval_crew.py\nindex 93bc5ac9cc..731afd9d6b 100644\n--- a/lib/cli/src/crewai_cli/experimental/eval_crew.py\n+++ b/lib/cli/src/crewai_cli/experimental/eval_crew.py\n@@ -314,6 +314,7 @@ def eval_crew(\n     run_again: bool = False,\n     run_args: dict[str, Any] | None = None,\n     trusted_amp_origins: set[str] | None = None,\n+    open_report: bool = True,\n ) -> None:\n     \"\"\"Evaluate the last traced run of this project, or the run RUN_ID.\n \n@@ -324,7 +325,8 @@ def eval_crew(\n     person pressed Evaluate on (its definition, inputs and trained agents).\n     TRUSTED_AMP_ORIGINS: where the saved login may go, from a caller whose\n     process already loaded the project's `.env` (the run app); otherwise read\n-    here, before this command loads it.\n+    here, before this command loads it. OPEN_REPORT False (`--no-open`) prints\n+    the report link and opens no browser, here or in the run app it opens.\n     \"\"\"\n     # Before anything here writes to the project (the project id), so this\n     # command's own writes never read as a change.\n@@ -349,6 +351,7 @@ def eval_crew(\n             why,\n             trusted=trusted,\n             run_args=run_args,\n+            open_report=open_report,\n         )\n         if execution_id is None:\n             return\n@@ -398,7 +401,8 @@ def eval_crew(\n         # carrying `[link=\u2026]` would print a trustworthy label over a hostile\n         # target. The style belongs to the span, not to the string.\n         console.print(Text(\"Follow it at \").append(url, style=\"cyan underline\"))\n-        _open(url)\n+        if open_report:\n+            _open(url)\n \n     console.print(\"Waiting for the verdict\u2026\", style=\"dim\")\n     try:\n@@ -1075,6 +1079,7 @@ def _run_the_crew_to_evaluate(\n     *,\n     trusted: set[str] | None = None,\n     run_args: dict[str, Any] | None = None,\n+    open_report: bool = True,\n ) -> str | None:\n     \"\"\"Run the crew, traced, to have a run to evaluate.\n \n@@ -1150,7 +1155,9 @@ def _run_the_crew_to_evaluate(\n     started = time.monotonic()\n     with (\n         evaluating_after_run(\n-            trusted_amp_origins=trusted or (), tracing_turned_on=turned_on_now\n+            trusted_amp_origins=trusted or (),\n+            tracing_turned_on=turned_on_now,\n+            open_report=open_report,\n         ) as watched,\n         _run_output_to(run_log) as run_log,\n     ):\n@@ -1758,12 +1765,15 @@ def _record_models_usage(models: list[str]) -> None:\n         pass\n \n \n-def eval_models(models_text: str, deployment_id: str | None = None) -> None:\n+def eval_models(\n+    models_text: str, deployment_id: str | None = None, *, open_report: bool = True\n+) -> None:\n     \"\"\"Run this project's deployment once as deployed and once per model, and compare.\n \n     The deployment is AMP's to find, by the project id, unless DEPLOYMENT_ID\n     names one; its own models are the baseline, read off the deployment rather\n-    than this checkout, which may differ from what was deployed.\n+    than this checkout, which may differ from what was deployed. OPEN_REPORT\n+    False (`--no-open`) prints the report link and opens no browser.\n     \"\"\"\n     try:\n         models = parse_models(models_text)\n@@ -1816,7 +1826,8 @@ def eval_models(models_text: str, deployment_id: str | None = None) -> None:\n     if url:\n         # Appended, never interpolated \u2014 the same reason as `eval_crew`'s link.\n         console.print(Text(\"Follow it at \").append(url, style=\"cyan underline\"))\n-        _open(url)\n+        if open_report:\n+            _open(url)\n \n     console.print(\"Waiting for the comparison\u2026\", style=\"dim\")\n     # Every line once: setups run in parallel, so consecutive polls alternate\n", "test_patch": "diff --git a/lib/cli/tests/experimental/test_eval_crew.py b/lib/cli/tests/experimental/test_eval_crew.py\nindex 2d2f202a96..b2f670a0fb 100644\n--- a/lib/cli/tests/experimental/test_eval_crew.py\n+++ b/lib/cli/tests/experimental/test_eval_crew.py\n@@ -163,6 +163,50 @@ def test_the_last_run_is_evaluated_the_url_opened_and_the_verdict_printed(projec\n     assert \"Goal gate: PASSED\" in out and \"goal 5/5\" in out and \"cost not measured\" in out\n \n \n+@pytest.mark.parametrize(\"run_id\", [None, EXECUTION_ID])\n+def test_no_open_prints_the_link_and_hands_nothing_to_a_browser(project, monkeypatch, capsys, run_id):\n+    \"\"\"`--no-open` (#7728): over SSH or in CI the link is printed for somebody to\n+    copy, and the verdict and exit code are what they always were.\"\"\"\n+    directory, opened = project\n+    record_last_run(directory)\n+    amp = install(monkeypatch, FakeAMP(statuses=[done()]))\n+\n+    eval_module.eval_crew(run_id=run_id, open_report=False)\n+\n+    out = capsys.readouterr().out\n+    assert opened == []\n+    assert amp.calls == [(\"create\", EXECUTION_ID), (\"get\", \"ev-1\")]\n+    assert f\"Follow it at {URL}\" in out\n+    assert \"Goal gate: PASSED\" in out\n+\n+\n+def test_no_open_is_kept_by_the_app_that_runs_the_crew_first(project, monkeypatch):\n+    \"\"\"With nothing traced the run app evaluates on its own screen, in this\n+    process or a child: both are told not to open the report.\"\"\"\n+    directory, _ = project\n+    (directory / \"pyproject.toml\").write_text(\"[project]\\nname = 'demo'\\n\")\n+    monkeypatch.setattr(eval_module.sys.stdin, \"isatty\", lambda: True)\n+    monkeypatch.setenv(\"CREWAI_TRACING_ENABLED\", \"true\")\n+    told: list[tuple[str | None, object]] = []\n+\n+    def fake_run_crew() -> None:\n+        from crewai_cli.crew_run_tui import _AUTO_EVAL\n+        from crewai_core.eval_handshake import awaited_evaluation\n+\n+        told.append(((_AUTO_EVAL.get() or {}).get(\"no_open\"), (awaited_evaluation() or {}).get(\"open_report\")))\n+        record_last_run(directory, \"run-it-just-did\")\n+        eval_module.record_evaluation_outcome(\"run-it-just-did\")\n+\n+    monkeypatch.setattr(run_crew_module, \"run_crew\", fake_run_crew)\n+    amp = install(monkeypatch, FakeAMP(statuses=[done()]))\n+\n+    eval_module.eval_crew(open_report=False)\n+    eval_module.eval_crew(run_again=True)\n+\n+    assert told == [(\"true\", False), (None, True)]\n+    assert amp.calls == []\n+\n+\n def test_the_verdict_prints_whatever_areas_the_evaluation_graded(project, monkeypatch, capsys):\n     # The areas are the evaluator's to name. A client printing its own list\n     # would drop the ones it had not heard of and invent \"not measured\" for\n@@ -825,6 +869,7 @@ def fake_run_crew() -> None:\n         \"said\": {\n             \"trusted_amp_origins\": [\"https://amp.test\", \"https://app.crewai.com\"],\n             \"tracing_turned_on\": True,\n+            \"open_report\": True,\n         },\n     }\n     assert amp.calls[0] == (\"create\", \"fresh-run\")\n@@ -1298,10 +1343,18 @@ def test_the_cli_command_maps_to_the_implementation(monkeypatch):\n \n     assert runner.invoke(eval_command, []).exit_code == 0\n     assert runner.invoke(eval_command, [\"--run\", EXECUTION_ID]).exit_code == 0\n-    assert calls == [{\"run_id\": None}, {\"run_id\": EXECUTION_ID}]\n+    assert runner.invoke(eval_command, [\"--no-open\"]).exit_code == 0\n+    assert runner.invoke(eval_command, [\"--run\", EXECUTION_ID, \"--no-open\"]).exit_code == 0\n+    assert calls == [\n+        {\"run_id\": None, \"open_report\": True},\n+        {\"run_id\": EXECUTION_ID, \"open_report\": True},\n+        {\"run_id\": None, \"open_report\": False},\n+        {\"run_id\": EXECUTION_ID, \"open_report\": False},\n+    ]\n     help_text = \" \".join(runner.invoke(eval_command, [\"--help\"]).output.split())\n     assert \"Evaluate this crew through CrewAI AMP\" in help_text\n     assert \"it runs the crew first and grades that run\" in help_text\n+    assert \"--no-open Print the report link without opening a browser\" in help_text\n \n \n def test_only_a_missing_login_reads_as_anonymous(monkeypatch, capsys):\n@@ -1471,7 +1524,8 @@ def deployed(project, monkeypatch):\n     return directory, opened\n \n \n-def test_models_are_compared_on_the_deployment_and_the_table_printed(deployed, monkeypatch, capsys):\n+@pytest.mark.parametrize(\"open_report\", [True, False])\n+def test_models_are_compared_on_the_deployment_and_the_table_printed(deployed, monkeypatch, capsys, open_report):\n     directory, opened = deployed\n     (directory / \"eval.jsonc\").write_text('{\"dataset\": []}')\n     running = httpx.Response(200, json={\"id\": \"ev-9\", \"status\": \"running\", \"progress\": {\n@@ -1480,7 +1534,7 @@ def test_models_are_compared_on_the_deployment_and_the_table_printed(deployed, m\n         \"event\": \"judging\", \"payload\": {\"subject\": \"agent 'Poem composer'\", \"index\": 1, \"total\": 3}}})\n     amp = install(monkeypatch, FakeModelsAMP(statuses=[running, running, judging, compared()]))\n \n-    eval_module.eval_models(MODELS)\n+    eval_module.eval_models(MODELS, open_report=open_report)\n \n     out = capsys.readouterr().out\n     assert amp.api_key == \"login-token\"\n@@ -1488,7 +1542,7 @@ def test_models_are_compared_on_the_deployment_and_the_table_printed(deployed, m\n         \"models\": [\"openai/gpt-4o-mini\", \"openrouter/meta-llama/llama-4-maverick\"],\n         \"project_id\": \"proj-1\", \"eval_config\": '{\"dataset\": []}', \"deployment_id\": None,\n     }\n-    assert opened == [URL] and URL in out\n+    assert opened == ([URL] if open_report else []) and f\"Follow it at {URL}\" in out\n     # Progress: said once per change, never once per poll.\n     assert out.count(\"running \u00b7 model 2 of 3 \u00b7 mini\") == 1\n     assert \"judging agent 'Poem composer' \u00b7 model 2 of 3\" in out\n@@ -1901,13 +1955,18 @@ def test_the_cli_maps_models_and_deployment_to_the_comparison(monkeypatch):\n \n     assert runner.invoke(eval_command, [\"--models\", MODELS]).exit_code == 0\n     assert runner.invoke(eval_command, [\"--models\", \"openai/gpt-4o\", \"--deployment\", DEPLOYMENT]).exit_code == 0\n-    assert calls == [((MODELS,), {\"deployment_id\": None}), ((\"openai/gpt-4o\",), {\"deployment_id\": DEPLOYMENT})]\n+    assert runner.invoke(eval_command, [\"--models\", MODELS, \"--no-open\"]).exit_code == 0\n+    assert calls == [\n+        ((MODELS,), {\"deployment_id\": None, \"open_report\": True}),\n+        ((\"openai/gpt-4o\",), {\"deployment_id\": DEPLOYMENT, \"open_report\": True}),\n+        ((MODELS,), {\"deployment_id\": None, \"open_report\": False}),\n+    ]\n \n     both = runner.invoke(eval_command, [\"--models\", MODELS, \"--run\", EXECUTION_ID])\n     alone = runner.invoke(eval_command, [\"--deployment\", DEPLOYMENT])\n     assert both.exit_code == 2 and \"Give one of them\" in both.output\n     assert alone.exit_code == 2 and \"add --models LIST\" in alone.output\n-    assert len(calls) == 2\n+    assert len(calls) == 3\n     assert \"--models\" in runner.invoke(eval_command, [\"--help\"]).output\n \n \n@@ -2615,15 +2674,18 @@ def test_the_eval_group_keeps_every_old_invocation_and_adds_export(monkeypatch):\n     assert runner.invoke(crewai, [\"eval\", \"--models\", MODELS, \"--deployment\", DEPLOYMENT]).exit_code == 0\n     assert runner.invoke(crewai, [\"eval\", \"export\", EVALUATION_ID]).exit_code == 0\n     assert calls == [\n-        (\"run\", {\"run_id\": None}),\n-        (\"run\", {\"run_id\": EXECUTION_ID}),\n-        (\"models\", (MODELS,), {\"deployment_id\": DEPLOYMENT}),\n+        (\"run\", {\"run_id\": None, \"open_report\": True}),\n+        (\"run\", {\"run_id\": EXECUTION_ID, \"open_report\": True}),\n+        (\"models\", (MODELS,), {\"deployment_id\": DEPLOYMENT, \"open_report\": True}),\n         (\"export\", (EVALUATION_ID,)),\n     ]\n \n     # an option meant for `crewai eval` itself is refused, never dropped\n+    refused = \"takes no --run, --models, --deployment or --no-open\"\n     mixed = runner.invoke(eval_command, [\"--run\", EXECUTION_ID, \"export\", EVALUATION_ID])\n-    assert mixed.exit_code == 2 and \"takes no --run, --models or --deployment\" in mixed.output\n+    assert mixed.exit_code == 2 and refused in mixed.output\n+    headless = runner.invoke(eval_command, [\"--no-open\", \"export\", EVALUATION_ID])\n+    assert headless.exit_code == 2 and refused in headless.output\n     assert runner.invoke(eval_command, [\"export\"]).exit_code == 2  # the id is required\n     assert len(calls) == 4\n \ndiff --git a/lib/cli/tests/test_crew_run_tui.py b/lib/cli/tests/test_crew_run_tui.py\nindex c7fd85a985..73c27e0320 100644\n--- a/lib/cli/tests/test_crew_run_tui.py\n+++ b/lib/cli/tests/test_crew_run_tui.py\n@@ -276,6 +276,45 @@ def test_the_button_spins_while_it_evaluates_and_still_opens_the_report(\n     assert str(button.label) == \"Open eval report\"\n \n \n+@pytest.mark.parametrize(\"process\", [\"this process\", \"a child process\"])\n+@pytest.mark.parametrize(\"open_report\", [True, False])\n+def test_the_app_opens_the_report_unless_crewai_eval_said_no_open(\n+    monkeypatch, process, open_report\n+) -> None:\n+    \"\"\"`crewai eval --no-open` with nothing traced: the app that runs the crew\n+    and evaluates it leaves the browser alone, in this process or in a child\n+    that only has the token file; without the flag it opens the report.\"\"\"\n+    opened: list[str] = []\n+    monkeypatch.setattr(CrewRunApp, \"_open_report\", lambda self, url: opened.append(url))\n+    monkeypatch.setattr(CrewRunApp, \"_refresh_eval_button\", lambda self: None)\n+\n+    with crew_run_tui.evaluating_after_run(open_report=open_report):\n+        token = crew_run_tui._AUTO_EVAL.set(None) if process == \"a child process\" else None\n+        try:\n+            app = CrewRunApp()\n+        finally:\n+            if token is not None:\n+                crew_run_tui._AUTO_EVAL.reset(token)\n+    app._evaluation = {\"state\": \"starting\", \"execution_id\": \"run-this-app\"}\n+    app._evaluation_started({\"id\": \"ev-1\", \"url\": \"https://optimize.example/e/1\"})\n+\n+    assert opened == ([\"https://optimize.example/e/1\"] if open_report else [])\n+    assert app._evaluation[\"url\"] == \"https://optimize.example/e/1\"  # still on screen\n+\n+\n+def test_an_app_nobody_opened_for_an_evaluation_opens_the_report(monkeypatch) -> None:\n+    \"\"\"The run app's own Evaluate, after `crewai run`: unchanged.\"\"\"\n+    opened: list[str] = []\n+    monkeypatch.setattr(CrewRunApp, \"_open_report\", lambda self, url: opened.append(url))\n+    monkeypatch.setattr(CrewRunApp, \"_refresh_eval_button\", lambda self: None)\n+    app = CrewRunApp()\n+    app._evaluation = {\"state\": \"starting\", \"execution_id\": \"run-this-app\"}\n+\n+    app._evaluation_started({\"id\": \"ev-1\", \"url\": \"https://optimize.example/e/1\"})\n+\n+    assert opened == [\"https://optimize.example/e/1\"]\n+\n+\n def test_pressing_evaluate_again_opens_the_report_it_already_made(monkeypatch) -> None:\n     \"\"\"One evaluation per run: the second press is somebody looking for the\n     report, not asking to pay for another.\"\"\"\n@@ -478,6 +517,7 @@ def test_the_token_this_app_sets_is_the_one_crewais_tracing_reads(\n         assert eval_handshake.awaited_evaluation() == {\n             \"trusted_amp_origins\": [\"https://app.crewai.com\"],\n             \"tracing_turned_on\": True,\n+            \"open_report\": True,\n         }\n     assert eval_handshake.run_awaited_by_evaluation() is False\n \n", "problem_statement": "Add --no-open option to crewai eval for headless use\n### Feature Area\n\nOther: CLI evaluation workflow.\n\n### Is your feature request related to an existing bug?\n\nNA. This is a usability extension to the recently introduced `crewai eval` command.\n\n### Describe the solution you'd like\n\nAdd `crewai eval --no-open` to print the evaluation report URL and continue waiting for and printing the verdict without launching a browser. Keep the existing behavior unchanged when the flag is omitted, and allow the flag alongside `--run EXECUTION_ID`.\n\nThis is useful over SSH, in CI, and in terminal-only environments where the URL needs to be copied or surfaced in logs but opening a browser is unwanted or impossible.\n\n### Describe alternatives you've considered\n\nAutomatically detecting a headless session would be more brittle and could change behavior unexpectedly. Redirecting stdout does not prevent `webbrowser.open()` from running.\n\n### Additional context\n\nThe current CLI prints the URL and then calls `webbrowser.open()` whenever AMP supplies a URL; only the internal daemon-mode check suppresses the browser. This proposal is intentionally limited to an explicit opt-out.\n\n### Willingness to Contribute\n\nYes, I'd be happy to submit a pull request.\n\n### Implementation status (2026-10-24)\n\nImplementation is available in #7729. The branch was integrated with main `49f52a00` in commit `fd87915e1c`; `--no-open` applies to the current eval command group, including model comparisons. All 397 local CLI evaluation tests passed, and the current PR CI is green. The PR remains open for maintainer review.\n\n", "hints_text": "Disclosure: this feature request was prepared with Codex (an AI coding agent). I attempted to add the repository-required `llm-generated` and `feature-request` labels, but GitHub denied label updates for my account. Maintainers, please apply those labels.\nThis issue is stale because it has been open for 30 days with no activity. Remove stale label or comment or this will be closed in 5 days.", "created_at": "2026-11-07T17:37:28Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9058, "instance_id": "crewAIInc__crewAI-9058", "issue_numbers": ["9053"], "base_commit": "dd21ecce11aa008d5ef0325e6802a3962ce4d443", "patch": "diff --git a/lib/crewai-tools/src/crewai_tools/rag/misc.py b/lib/crewai-tools/src/crewai_tools/rag/misc.py\nindex dabe1599ff..21a4e0cdab 100644\n--- a/lib/crewai-tools/src/crewai_tools/rag/misc.py\n+++ b/lib/crewai-tools/src/crewai_tools/rag/misc.py\n@@ -18,17 +18,20 @@ def sanitize_metadata_for_chromadb(metadata: dict[str, Any]) -> dict[str, Any]:\n     \"\"\"Sanitize metadata to ensure ChromaDB compatibility.\n \n     ChromaDB only accepts str, int, float, or bool values in metadata.\n-    This function converts other types to strings.\n+    This function converts other types to strings and drops ``None`` values,\n+    which ChromaDB rejects.\n \n     Args:\n         metadata: Dictionary of metadata to sanitize\n \n     Returns:\n-        Sanitized metadata dictionary with only ChromaDB-compatible types\n+        Sanitized metadata dictionary with only ChromaDB-compatible values\n     \"\"\"\n     sanitized = {}\n     for key, value in metadata.items():\n-        if isinstance(value, (str, int, float, bool)) or value is None:\n+        if value is None:\n+            continue\n+        if isinstance(value, (str, int, float, bool)):\n             sanitized[key] = value\n         elif isinstance(value, (list, tuple)):\n             sanitized[key] = \" | \".join(str(v) for v in value)\n", "test_patch": "diff --git a/lib/crewai-tools/tests/rag/test_misc.py b/lib/crewai-tools/tests/rag/test_misc.py\nnew file mode 100644\nindex 0000000000..2480e66f72\n--- /dev/null\n+++ b/lib/crewai-tools/tests/rag/test_misc.py\n@@ -0,0 +1,30 @@\n+import chromadb\n+\n+from crewai_tools.rag.misc import sanitize_metadata_for_chromadb\n+\n+\n+def test_sanitize_metadata_drops_none_values() -> None:\n+    sanitized = sanitize_metadata_for_chromadb(\n+        {\"title\": \"Video\", \"description\": None}\n+    )\n+\n+    assert sanitized == {\"title\": \"Video\"}\n+\n+\n+def test_sanitized_metadata_is_accepted_by_chromadb() -> None:\n+    collection = chromadb.Client().get_or_create_collection(\n+        \"test_sanitized_metadata\"\n+    )\n+    sanitized = sanitize_metadata_for_chromadb(\n+        {\"title\": \"Video\", \"description\": None, \"length_seconds\": None}\n+    )\n+\n+    collection.add(\n+        ids=[\"doc-1\"],\n+        embeddings=[[0.1, 0.2]],\n+        documents=[\"Transcript\"],\n+        metadatas=[sanitized],\n+    )\n+\n+    stored = collection.get(ids=[\"doc-1\"], include=[\"metadatas\"])[\"metadatas\"]\n+    assert stored == [{\"title\": \"Video\"}]\n", "problem_statement": "[BUG] None metadata values break ChromaDB ingestion through sanitize_metadata_for_chromadb\n## Description\n\n`sanitize_metadata_for_chromadb()` is documented as making metadata safe for ChromaDB, but it explicitly keeps `None` values:\n\n`lib/crewai-tools/src/crewai_tools/rag/misc.py:31`\n\n```python\nif isinstance(value, (str, int, float, bool)) or value is None:\n    sanitized[key] = value\n```\n\nChromaDB metadata only accepts `str`, `int`, `float` and `bool`; a `None` value is rejected when the document is written (`TypeError: argument 'metadatas': Cannot convert Python object to MetadataValue` on current ChromaDB, `ValueError` on older versions).\n\nLoader metadata can contain `None`. The YouTube loader stores `description=None` when a video has no description:\n\n`lib/crewai-tools/src/crewai_tools/rag/loaders/youtube_video_loader.py:80-82`\n\n```python\nmetadata[\"description\"] = (\n    yt.description[:500] if yt.description else None\n)\n```\n\n(`length_seconds`, set a few lines earlier, is also `None` for some videos.) The CrewAI RAG adapter passes loader metadata through this sanitizer before adding documents (`lib/crewai-tools/src/crewai_tools/adapters/crewai_rag_adapter.py:295` and `:346`), so adding such a video aborts ingestion with a ChromaDB validation error rather than storing the content.\n\n## Reproduction\n\n```python\nimport chromadb\n\nfrom crewai_tools.rag.misc import sanitize_metadata_for_chromadb\n\nsanitized = sanitize_metadata_for_chromadb(\n    {\"title\": \"Video\", \"description\": None}\n)\nprint(sanitized)  # {'title': 'Video', 'description': None}\n\ncollection = chromadb.Client().get_or_create_collection(\"test_sanitized_metadata\")\ncollection.add(\n    ids=[\"doc-1\"],\n    embeddings=[[0.1, 0.2]],\n    documents=[\"Transcript\"],\n    metadatas=[sanitized],\n)\n# TypeError: argument 'metadatas': Cannot convert Python object to MetadataValue\n```\n\n## Expected behaviour\n\n`None` values are dropped, and the remaining metadata is written.\n\n## Suggested fix\n\n```python\nfor key, value in metadata.items():\n    if value is None:\n        continue\n    if isinstance(value, (str, int, float, bool)):\n        sanitized[key] = value\n```\n\n## Tests\n\nThe PR adds `lib/crewai-tools/tests/rag/test_misc.py` with `test_sanitize_metadata_drops_none_values` and `test_sanitized_metadata_is_accepted_by_chromadb` (the second writes through a real ephemeral ChromaDB client). Both fail on main and pass with the fix; the rest of `tests/rag` is unchanged (the four PDF/text permission failures are pre-existing Windows-only failures).\n\nPrepared with an AI coding agent. Please apply the `llm-generated` label; this account cannot set repository labels.\n\n", "hints_text": "", "created_at": "2026-11-04T09:41:38Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9057, "instance_id": "crewAIInc__crewAI-9057", "issue_numbers": ["9052"], "base_commit": "45e141a45e6e6362f0c3f32fe7af564c1587583e", "patch": "diff --git a/lib/crewai-tools/src/crewai_tools/tools/linkup/linkup_search_tool.py b/lib/crewai-tools/src/crewai_tools/tools/linkup/linkup_search_tool.py\nindex 1b9a10151a..481ffa6355 100644\n--- a/lib/crewai-tools/src/crewai_tools/tools/linkup/linkup_search_tool.py\n+++ b/lib/crewai-tools/src/crewai_tools/tools/linkup/linkup_search_tool.py\n@@ -66,12 +66,27 @@ def _run(\n         :param query: The query to search for.\n         :param depth: Search depth (default is \"standard\").\n         :param output_type: Desired result type (default is \"searchResults\").\n-        :return: A dictionary containing the results or an error message.\n+        :return: ``{\"success\": True, \"results\": [...]}`` for ``searchResults``,\n+            ``{\"success\": True, \"answer\": ..., \"sources\": [...]}`` for\n+            ``sourcedAnswer``, or ``{\"success\": False, \"error\": ...}``.\n         \"\"\"\n         try:\n             response = self._client.search(\n                 query=query, depth=depth, output_type=output_type\n             )\n+            if output_type == \"sourcedAnswer\":\n+                return {\n+                    \"success\": True,\n+                    \"answer\": response.answer,\n+                    \"sources\": [\n+                        {\n+                            \"name\": source.name,\n+                            \"url\": source.url,\n+                            \"snippet\": source.snippet,\n+                        }\n+                        for source in response.sources\n+                    ],\n+                }\n             results = [\n                 {\"name\": result.name, \"url\": result.url, \"content\": result.content}\n                 for result in response.results\n", "test_patch": "diff --git a/lib/crewai-tools/tests/tools/test_linkup_search_tool.py b/lib/crewai-tools/tests/tools/test_linkup_search_tool.py\nnew file mode 100644\nindex 0000000000..21eb13476c\n--- /dev/null\n+++ b/lib/crewai-tools/tests/tools/test_linkup_search_tool.py\n@@ -0,0 +1,56 @@\n+from types import SimpleNamespace\n+from typing import Any\n+\n+from crewai_tools.tools.linkup.linkup_search_tool import LinkupSearchTool\n+\n+\n+class FakeLinkupClient:\n+    def __init__(self, response: Any) -> None:\n+        self.response = response\n+\n+    def search(self, query: str, depth: str, output_type: str) -> Any:\n+        return self.response\n+\n+\n+def make_tool(response: Any) -> LinkupSearchTool:\n+    tool = LinkupSearchTool(api_key=\"test-key\")\n+    tool._client = FakeLinkupClient(response)\n+    return tool\n+\n+\n+def test_search_results_output_is_unchanged() -> None:\n+    tool = make_tool(\n+        SimpleNamespace(\n+            results=[\n+                SimpleNamespace(name=\"Example\", url=\"https://example.com\", content=\"c\")\n+            ]\n+        )\n+    )\n+\n+    assert tool._run(query=\"question\") == {\n+        \"success\": True,\n+        \"results\": [\n+            {\"name\": \"Example\", \"url\": \"https://example.com\", \"content\": \"c\"}\n+        ],\n+    }\n+\n+\n+def test_sourced_answer_output_returns_answer_and_sources() -> None:\n+    tool = make_tool(\n+        SimpleNamespace(\n+            answer=\"The answer\",\n+            sources=[\n+                SimpleNamespace(\n+                    name=\"Example\", url=\"https://example.com\", snippet=\"snippet\"\n+                )\n+            ],\n+        )\n+    )\n+\n+    assert tool._run(query=\"question\", output_type=\"sourcedAnswer\") == {\n+        \"success\": True,\n+        \"answer\": \"The answer\",\n+        \"sources\": [\n+            {\"name\": \"Example\", \"url\": \"https://example.com\", \"snippet\": \"snippet\"}\n+        ],\n+    }\n", "problem_statement": "[BUG] LinkupSearchTool fails every sourcedAnswer search\n## Description\r\n\r\n`LinkupSearchTool._run()` accepts three output types:\r\n\r\n`lib/crewai-tools/src/crewai_tools/tools/linkup/linkup_search_tool.py:60-62`\r\n\r\n```python\r\noutput_type: Literal[\r\n    \"searchResults\", \"sourcedAnswer\", \"structured\"\r\n] = \"searchResults\",\r\n```\r\n\r\nbut reads the response as if it always had a `results` list:\r\n\r\n`lib/crewai-tools/src/crewai_tools/tools/linkup/linkup_search_tool.py:75-78`\r\n\r\n```python\r\nresults = [\r\n    {\"name\": result.name, \"url\": result.url, \"content\": result.content}\r\n    for result in response.results\r\n]\r\n```\r\n\r\nWith `output_type=\"sourcedAnswer\"` the SDK returns a `LinkupSourcedAnswer` with `answer` and `sources` (`linkup/_types.py:76-86`), and with `structured` it returns a plain mapping. Neither has `results`, so the attribute access raises inside the `try` block and the tool reports failure for every call that is not `searchResults`:\r\n\r\n```python\r\n{\"success\": False, \"error\": \"'LinkupSourcedAnswer' object has no attribute 'results'\"}\r\n```\r\n\r\nThe `sourcedAnswer` option is therefore unusable even though it is part of the tool's public signature.\r\n\r\n## Reproduction\r\n\r\n```python\r\nfrom types import SimpleNamespace\r\n\r\nfrom crewai_tools.tools.linkup.linkup_search_tool import LinkupSearchTool\r\n\r\n\r\nclass FakeClient:\r\n    def search(self, query, depth, output_type):\r\n        return SimpleNamespace(\r\n            answer=\"The answer\",\r\n            sources=[\r\n                SimpleNamespace(\r\n                    name=\"Example\", url=\"https://example.com\", snippet=\"snippet\"\r\n                )\r\n            ],\r\n        )\r\n\r\n\r\ntool = LinkupSearchTool(api_key=\"test-key\")\r\ntool._client = FakeClient()\r\nprint(tool._run(query=\"question\", output_type=\"sourcedAnswer\"))\r\n# {'success': False, 'error': \"'SimpleNamespace' object has no attribute 'results'\"}\r\n```\r\n\r\n## Expected behaviour\r\n\r\nA sourced-answer search returns the answer and its sources instead of an error, while `searchResults` keeps its current shape.\r\n\r\n## Suggested fix\r\n\r\nBranch on the requested output type:\r\n\r\n```python\r\nif output_type == \"sourcedAnswer\":\r\n    return {\r\n        \"success\": True,\r\n        \"answer\": response.answer,\r\n        \"sources\": [\r\n            {\"name\": source.name, \"url\": source.url, \"snippet\": source.snippet}\r\n            for source in response.sources\r\n        ],\r\n    }\r\n```\r\n\r\n`structured` additionally requires a `structured_output_schema` argument, which the tool does not expose; that path is out of scope here.\r\n\r\n## Tests\r\n\r\nThe PR adds `lib/crewai-tools/tests/tools/test_linkup_search_tool.py` with a fake client: `test_search_results_output_is_unchanged` and `test_sourced_answer_output_returns_answer_and_sources`. The second fails on main with `success: False` and passes with the fix; both pass.\r\n\r\nPrepared with an AI coding agent. Please apply the `llm-generated` label; this account cannot set repository labels.\r\n\n", "hints_text": "", "created_at": "2026-11-04T09:41:22Z"}
{"repo": "crewAIInc/crewAI", "pull_number": 9035, "instance_id": "crewAIInc__crewAI-9035", "issue_numbers": ["7740"], "base_commit": "2666f2633998580cf516aaf24c02487ed3f6ef85", "patch": "diff --git a/docs/edge/ar/concepts/cli.mdx b/docs/edge/ar/concepts/cli.mdx\nindex a77fdedbfc..ff1ef14703 100644\n--- a/docs/edge/ar/concepts/cli.mdx\n+++ b/docs/edge/ar/concepts/cli.mdx\n@@ -54,6 +54,25 @@ crewai create flow my_new_flow\n \n \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064b\u0627\u060c \u064a\u0646\u0634\u0626 `crewai create crew` \u0645\u0634\u0631\u0648\u0639\u064b\u0627 JSON-first \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 `crew.jsonc` \u0648 `agents/*.jsonc`. \u0627\u0633\u062a\u062e\u062f\u0645 `crewai create crew my_new_crew --classic` \u0641\u0642\u0637 \u0625\u0630\u0627 \u0623\u0631\u062f\u062a \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 Python/YAML \u0645\u0639 `crew.py` \u0648 `config/agents.yaml` \u0648 `config/tasks.yaml`.\n \n+\u0628\u0639\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0632\u0648\u062f LLM \u0648\u0627\u0644\u0646\u0645\u0648\u0630\u062c\u060c \u064a\u0637\u0644\u0628 \u0645\u0646\u0643 CLI \u0645\u0641\u0627\u062a\u064a\u062d API. \u0641\u064a \u0627\u0644\u0637\u0631\u0641\u064a\u0629\u060c \u0644\u0627 \u064a\u0638\u0647\u0631 \u0645\u0627 \u062a\u0643\u062a\u0628\u0647 \u0644\u0645\u0641\u062a\u0627\u062d \u0623\u0648 \u0633\u0631\u0651 \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0628\u0642\u0649 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0623\u062e\u0631\u0649 \u0638\u0627\u0647\u0631\u0629\u060c \u0645\u062b\u0644 \u0639\u0646\u0648\u0627\u0646 URL \u0644\u0646\u0642\u0637\u0629 \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0623\u0648 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0623\u0648 \u0627\u0633\u0645 \u0646\u0634\u0631 Azure. \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 Enter \u0644\u062a\u062e\u0637\u064a \u0623\u064a \u062d\u0642\u0644.\n+\n+\u0644\u0627 \u064a\u064f\u062d\u0641\u0638 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u064a \u062a\u062a\u062e\u0637\u0627\u0647. \u0648\u0645\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0645\u0639\u064a\u0651\u0646\u064b\u0627 \u0645\u0633\u0628\u0642\u064b\u0627 \u0641\u064a \u0628\u064a\u0626\u062a\u0643\u060c \u064a\u0637\u0628\u0639 CLI \u0627\u0644\u0633\u0637\u0631 \u0627\u0644\u062f\u0642\u064a\u0642 \u0627\u0644\u0630\u064a \u064a\u062c\u0628 \u0625\u0636\u0627\u0641\u062a\u0647 \u0625\u0644\u0649 `.env` \u0642\u0628\u0644 `crewai run`:\n+\n+```text\n+  API key not saved. Add this line to my_new_crew/.env before `crewai run`:\n+    OPENAI_API_KEY=<your key>\n+```\n+\n+\u0644\u0627 \u062a\u064f\u062f\u0631\u062c \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u062a\u064a \u0644\u0647\u0627 \u0642\u064a\u0645\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629\u060c \u0645\u062b\u0644 \u0645\u0646\u0637\u0642\u0629 AWS \u0648\u0625\u0635\u062f\u0627\u0631 Azure API.\n+\n+\u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0646\u0645\u0627\u0630\u062c \u0645\u0646 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0645\u0632\u0648\u062f\u060c \u064a\u0637\u0644\u0628 CLI \u0645\u0641\u0627\u062a\u064a\u062d \u0643\u0644 \u0645\u0632\u0648\u062f \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637\u060c \u0648\u064a\u062d\u0641\u0638 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0648\u0643\u064a\u0644 \u0627\u0644\u0623\u0648\u0644 \u0641\u064a `MODEL`.\n+\n+\u0645\u0639 `--skip-provider`\u060c \u0623\u0648 \u0645\u0639 `CREWAI_DMN=true`\u060c \u0644\u0627 \u064a\u0637\u0644\u0628 CLI \u0623\u064a \u0645\u0641\u0627\u062a\u064a\u062d \u0648\u0644\u0627 \u064a\u062d\u0641\u0638 \u0623\u064a\u064b\u0627 \u0645\u0646\u0647\u0627. \u0648\u0641\u064a \u0637\u0627\u0642\u0645 JSON \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u060c \u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0648\u0643\u0644\u0627\u0621 `openai/gpt-6-luna` \u0645\u0627 \u0644\u0645 \u062a\u0645\u0631\u0631 `--provider`\u060c \u0648\u062a\u0630\u0643\u0631 \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0643\u0644 \u0645\u062a\u063a\u064a\u0631 \u063a\u064a\u0631 \u0645\u0639\u064a\u0651\u0646 \u0628\u0639\u062f \u0641\u064a \u0628\u064a\u0626\u062a\u0643:\n+\n+```text\n+  Set OPENAI_API_KEY in .env before `crewai run`\n+```\n+\n #### \u0623\u0633\u0645\u0627\u0621 \u0645\u0633\u062a\u0639\u0627\u0631 \u0642\u062f\u064a\u0645\u0629 \u0644\u0644\u0623\u0639\u0644\u0627\u0645 (\u0645\u0647\u0645\u0644\u0629)\n \n \u0644\u0627 \u062a\u0632\u0627\u0644 \u0623\u0639\u0644\u0627\u0645 snake_case \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u062a\u0639\u0645\u0644\u060c \u0644\u0643\u0646\u0647\u0627 \u0645\u062e\u0641\u064a\u0629 \u0645\u0646 `--help`. \u064a\u064f\u0641\u0636\u0651\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0635\u064a\u063a kebab-case \u0627\u0644\u0645\u0648\u062b\u0651\u0642\u0629 \u0641\u064a \u0623\u0642\u0633\u0627\u0645 \u0627\u0644\u0623\u0648\u0627\u0645\u0631 \u0623\u062f\u0646\u0627\u0647.\ndiff --git a/docs/edge/en/concepts/cli.mdx b/docs/edge/en/concepts/cli.mdx\nindex d4140da579..bfc21f6bab 100644\n--- a/docs/edge/en/concepts/cli.mdx\n+++ b/docs/edge/en/concepts/cli.mdx\n@@ -415,7 +415,24 @@ Notes:\n \n When running the `crewai create crew` command, the CLI shows a list of available LLM providers, followed by model selection for your chosen provider. The selected model is saved in the generated `.env` file and each generated agent JSONC file can set its own `llm`.\n \n-Once you've selected an LLM provider and model, you will be prompted for API keys.\n+Once you've selected an LLM provider and model, you will be prompted for API keys. At a terminal, what you type for a key or secret is hidden; other values, such as an endpoint URL, a region, or an Azure deployment name, stay visible. Press Enter to skip a prompt.\n+\n+A skipped key is not saved. Unless the key is already set in your environment, the CLI prints the exact line to add to `.env` before `crewai run`:\n+\n+```text\n+  API key not saved. Add this line to my_new_crew/.env before `crewai run`:\n+    OPENAI_API_KEY=<your key>\n+```\n+\n+Values that have a default, such as the AWS region and the Azure API version, are not listed.\n+\n+If your agents use models from more than one provider, the CLI asks once for each provider's keys, and the first agent's model is saved as `MODEL`.\n+\n+With `--skip-provider`, or with `CREWAI_DMN=true`, the CLI asks for no keys and writes none. In the default JSON crew, agents use `openai/gpt-6-luna` unless you pass `--provider`, and the next steps name each variable that is not already set in your environment:\n+\n+```text\n+  Set OPENAI_API_KEY in .env before `crewai run`\n+```\n \n #### Available LLM Providers\n \ndiff --git a/docs/edge/ko/concepts/cli.mdx b/docs/edge/ko/concepts/cli.mdx\nindex 2748c22caf..1ce44c7880 100644\n--- a/docs/edge/ko/concepts/cli.mdx\n+++ b/docs/edge/ko/concepts/cli.mdx\n@@ -343,7 +343,24 @@ CLI\ub97c \uc0ac\uc6a9\ud558\uc5ec [CrewAI AMP](https://app.crewai.com)\uc5d0 crew\ub97c \ubc30\ud3ec\ud558\ub294\n \n `crewai create crew` \uba85\ub839\uc5b4\ub97c \uc2e4\ud589\ud558\uba74, CLI\uc5d0\uc11c \uc120\ud0dd\ud560 \uc218 \uc788\ub294 LLM \uc81c\uacf5\uc5c5\uccb4 \ubaa9\ub85d\uc774 \ud45c\uc2dc\ub418\uace0, \uadf8 \ub2e4\uc74c\uc73c\ub85c \uc120\ud0dd\ud55c \uc81c\uacf5\uc5c5\uccb4\uc5d0 \ub300\ud55c \ubaa8\ub378 \uc120\ud0dd\uc774 \uc774\uc5b4\uc9d1\ub2c8\ub2e4. \uc120\ud0dd\ud55c \ubaa8\ub378\uc740 \uc0dd\uc131\ub41c `.env`\uc5d0 \uc800\uc7a5\ub418\uba70 \uac01 \uc5d0\uc774\uc804\ud2b8 JSONC \ud30c\uc77c\uc740 \uc790\uccb4 `llm`\uc744 \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n \n-LLM \uc81c\uacf5\uc5c5\uccb4\uc640 \ubaa8\ub378\uc744 \uc120\ud0dd\ud558\uba74, API \ud0a4\ub97c \uc785\ub825\ud558\ub77c\ub294 \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\n+LLM \uc81c\uacf5\uc5c5\uccb4\uc640 \ubaa8\ub378\uc744 \uc120\ud0dd\ud558\uba74, API \ud0a4\ub97c \uc785\ub825\ud558\ub77c\ub294 \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ud130\ubbf8\ub110\uc5d0\uc11c\ub294 \ud0a4\ub098 \uc2dc\ud06c\ub9bf\uc73c\ub85c \uc785\ub825\ud558\ub294 \ub0b4\uc6a9\uc774 \ud654\uba74\uc5d0 \ud45c\uc2dc\ub418\uc9c0 \uc54a\uc73c\uba70, \uc5d4\ub4dc\ud3ec\uc778\ud2b8 URL, \ub9ac\uc804, Azure \ubc30\ud3ec \uc774\ub984 \uac19\uc740 \ub2e4\ub978 \uac12\uc740 \uadf8\ub300\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. Enter\ub97c \ub20c\ub7ec \ud56d\ubaa9\uc744 \uac74\ub108\ub6f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n+\n+\uac74\ub108\ub6f4 \ud0a4\ub294 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud574\ub2f9 \ud0a4\uac00 \ud658\uacbd\uc5d0 \uc774\ubbf8 \uc124\uc815\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc73c\uba74, CLI\ub294 `crewai run` \uc804\uc5d0 `.env`\uc5d0 \ucd94\uac00\ud560 \uc815\ud655\ud55c \uc904\uc744 \ucd9c\ub825\ud569\ub2c8\ub2e4:\n+\n+```text\n+  API key not saved. Add this line to my_new_crew/.env before `crewai run`:\n+    OPENAI_API_KEY=<your key>\n+```\n+\n+AWS \ub9ac\uc804\uacfc Azure API \ubc84\uc804\ucc98\ub7fc \uae30\ubcf8\uac12\uc774 \uc788\ub294 \uac12\uc740 \ubaa9\ub85d\uc5d0 \ud45c\uc2dc\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n+\n+\uc5d0\uc774\uc804\ud2b8\ub4e4\uc774 \uc5ec\ub7ec \uc81c\uacf5\uc5c5\uccb4\uc758 \ubaa8\ub378\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0, CLI\ub294 \uc81c\uacf5\uc5c5\uccb4\ub9c8\ub2e4 \ud55c \ubc88\uc529\ub9cc \ud0a4\ub97c \ubb3b\uace0, \uccab \ubc88\uc9f8 \uc5d0\uc774\uc804\ud2b8\uc758 \ubaa8\ub378\uc744 `MODEL`\ub85c \uc800\uc7a5\ud569\ub2c8\ub2e4.\n+\n+`--skip-provider`\ub97c \uc0ac\uc6a9\ud558\uac70\ub098 `CREWAI_DMN=true`\ub85c \uc2e4\ud589\ud558\uba74, CLI\ub294 \ud0a4\ub97c \ubb3b\uc9c0\ub3c4 \uc800\uc7a5\ud558\uc9c0\ub3c4 \uc54a\uc2b5\ub2c8\ub2e4. \uae30\ubcf8 JSON \ud06c\ub8e8\uc5d0\uc11c\ub294 `--provider`\ub97c \uc9c0\uc815\ud558\uc9c0 \uc54a\uc73c\uba74 \uc5d0\uc774\uc804\ud2b8\uac00 `openai/gpt-6-luna`\ub97c \uc0ac\uc6a9\ud558\uba70, \ub2e4\uc74c \ub2e8\uacc4 \uc548\ub0b4\uc5d0 \ud658\uacbd\uc5d0 \uc544\uc9c1 \uc124\uc815\ub418\uc9c0 \uc54a\uc740 \ubcc0\uc218\uac00 \uac01\uac01 \ud45c\uc2dc\ub429\ub2c8\ub2e4:\n+\n+```text\n+  Set OPENAI_API_KEY in .env before `crewai run`\n+```\n \n #### \uc0ac\uc6a9 \uac00\ub2a5\ud55c LLM \uacf5\uae09\uc790\n \ndiff --git a/docs/edge/pt-BR/concepts/cli.mdx b/docs/edge/pt-BR/concepts/cli.mdx\nindex 94d9a9e8b6..ad16ece1c8 100644\n--- a/docs/edge/pt-BR/concepts/cli.mdx\n+++ b/docs/edge/pt-BR/concepts/cli.mdx\n@@ -364,7 +364,24 @@ Assista ao v\u00eddeo tutorial para uma demonstra\u00e7\u00e3o passo-a-passo de implanta\u00e7\u00e3\n \n Ao executar o comando `crewai create crew`, o CLI mostrar\u00e1 provedores de LLM dispon\u00edveis e depois a sele\u00e7\u00e3o de modelo para o provedor escolhido. O modelo selecionado \u00e9 salvo no `.env` gerado, e cada agente JSONC pode definir seu pr\u00f3prio `llm`.\n \n-Ap\u00f3s selecionar um provedor de LLM, ser\u00e1 solicitado que voc\u00ea informe as chaves de API.\n+Ap\u00f3s selecionar um provedor de LLM, ser\u00e1 solicitado que voc\u00ea informe as chaves de API. Em um terminal, o que voc\u00ea digita para uma chave ou um segredo fica oculto; outros valores, como uma URL de endpoint, uma regi\u00e3o ou o nome de um deployment do Azure, continuam vis\u00edveis. Pressione Enter para pular um campo.\n+\n+Uma chave pulada n\u00e3o \u00e9 salva. A menos que a chave j\u00e1 esteja definida no seu ambiente, o CLI mostra a linha exata a adicionar ao `.env` antes de `crewai run`:\n+\n+```text\n+  API key not saved. Add this line to my_new_crew/.env before `crewai run`:\n+    OPENAI_API_KEY=<your key>\n+```\n+\n+Valores que t\u00eam um padr\u00e3o, como a regi\u00e3o da AWS e a vers\u00e3o da API do Azure, n\u00e3o s\u00e3o listados.\n+\n+Se seus agentes usam modelos de mais de um provedor, o CLI pede as chaves uma vez por provedor, e o modelo do primeiro agente \u00e9 salvo como `MODEL`.\n+\n+Com `--skip-provider`, ou com `CREWAI_DMN=true`, o CLI n\u00e3o pede nem salva nenhuma chave. Na crew JSON padr\u00e3o, os agentes usam `openai/gpt-6-luna`, a menos que voc\u00ea passe `--provider`, e os pr\u00f3ximos passos indicam cada vari\u00e1vel que ainda n\u00e3o est\u00e1 definida no seu ambiente:\n+\n+```text\n+  Set OPENAI_API_KEY in .env before `crewai run`\n+```\n \n #### Provedores iniciais de chave de API\n \ndiff --git a/lib/cli/src/crewai_cli/constants.py b/lib/cli/src/crewai_cli/constants.py\nindex f864fd10de..a879b985a1 100644\n--- a/lib/cli/src/crewai_cli/constants.py\n+++ b/lib/cli/src/crewai_cli/constants.py\n@@ -7,6 +7,9 @@\n CREWAI_ENTERPRISE_DEFAULT_OAUTH2_CLIENT_ID = \"client_01JYT06R59SP0NXYGD994NFXXX\"\n CREWAI_ENTERPRISE_DEFAULT_OAUTH2_DOMAIN = \"login.crewai.com\"\n \n+# `crewai create` hides what is typed at a prompt unless its entry sets\n+# \"secret\": False. An entry with \"optional\": True has a runtime default, so\n+# leaving it blank is not reported as a missing key.\n ENV_VARS: dict[str, list[dict[str, Any]]] = {\n     \"openai\": [\n         {\n@@ -42,6 +45,7 @@\n         {\n             \"prompt\": \"Enter your WATSONX URL (press Enter to skip)\",\n             \"key_name\": \"WATSONX_URL\",\n+            \"secret\": False,\n         },\n         {\n             \"prompt\": \"Enter your WATSONX API Key (press Enter to skip)\",\n@@ -50,6 +54,7 @@\n         {\n             \"prompt\": \"Enter your WATSONX Project Id (press Enter to skip)\",\n             \"key_name\": \"WATSONX_PROJECT_ID\",\n+            \"secret\": False,\n         },\n     ],\n     \"ollama\": [\n@@ -70,12 +75,15 @@\n         {\n             \"prompt\": \"Enter your AWS Region Name (press Enter to skip)\",\n             \"key_name\": \"AWS_DEFAULT_REGION\",\n+            \"secret\": False,\n+            \"optional\": True,  # BedrockCompletion falls back to us-east-1.\n         },\n     ],\n     \"azure\": [\n         {\n             \"prompt\": \"Enter your Azure deployment name (must start with 'azure/')\",\n             \"key_name\": \"model\",\n+            \"secret\": False,\n         },\n         {\n             \"prompt\": \"Enter your AZURE API key (press Enter to skip)\",\n@@ -84,16 +92,20 @@\n         {\n             \"prompt\": \"Enter your AZURE API base URL (press Enter to skip)\",\n             \"key_name\": \"AZURE_API_BASE\",\n+            \"secret\": False,\n         },\n         {\n             \"prompt\": \"Enter your AZURE API version (press Enter to skip)\",\n             \"key_name\": \"AZURE_API_VERSION\",\n+            \"secret\": False,\n+            \"optional\": True,  # AzureCompletion falls back to 2024-06-01.\n         },\n     ],\n     \"cerebras\": [\n         {\n             \"prompt\": \"Enter your Cerebras model name (must start with 'cerebras/')\",\n             \"key_name\": \"model\",\n+            \"secret\": False,\n         },\n         {\n             \"prompt\": \"Enter your Cerebras API version (press Enter to skip)\",\n@@ -132,222 +144,56 @@\n \n MODELS: dict[str, list[str]] = {\n     \"openai\": [\n-        \"gpt-5.6-sol\",\n-        \"gpt-5.6-terra\",\n-        \"gpt-5.6-luna\",\n-        \"gpt-5.6\",\n-        \"gpt-5.5\",\n-        \"gpt-5.5-pro\",\n-        \"gpt-5.4\",\n-        \"gpt-5.4-pro\",\n-        \"gpt-5.4-mini\",\n-        \"gpt-5.4-nano\",\n-        \"gpt-5.2\",\n-        \"gpt-5.2-pro\",\n-        \"gpt-5.1\",\n-        \"gpt-5\",\n-        \"gpt-5-pro\",\n-        \"gpt-5-mini\",\n-        \"gpt-5-nano\",\n-        \"gpt-4.1\",\n-        \"gpt-4.1-mini\",\n-        \"gpt-4.1-nano\",\n-        \"gpt-4o\",\n-        \"gpt-4o-mini\",\n-        \"o4-mini\",\n-        \"o3\",\n-        \"o3-mini\",\n-        \"o1\",\n-        \"o1-mini\",\n-        \"o1-preview\",\n-        \"gpt-4\",\n-        \"gpt-4.1-mini-2025-04-14\",\n-