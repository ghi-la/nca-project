"].split(\"/\")[0] for a in agents)\n+        ):\n+            keys_to_set += missing_provider_keys(provider, {})\n \n     # Minted at creation so the project has a stable identity from run one.\n     # This is the default `crewai create crew` path, not just --classic.\n@@ -1443,6 +1490,11 @@ def create_json_crew(\n     click.echo()\n     click.echo(f\"    cd {folder_name}\")\n     click.echo()\n+    if keys_to_set:\n+        click.secho(\n+            f\"  Set {', '.join(keys_to_set)} in .env before `crewai run`\", fg=\"cyan\"\n+        )\n+        click.echo()\n     click.secho(\"  Run your crew:\", fg=\"cyan\")\n     click.echo(\"    crewai run\")\n     click.echo()\ndiff --git a/lib/cli/src/crewai_cli/provider.py b/lib/cli/src/crewai_cli/provider.py\nindex 18e5bef526..b9421a0811 100644\n--- a/lib/cli/src/crewai_cli/provider.py\n+++ b/lib/cli/src/crewai_cli/provider.py\n@@ -24,9 +24,6 @@ def select_choice(prompt_message: str, choices: Sequence[str]) -> str | None:\n         The selected choice from the list, or None if the user chooses to quit.\n     \"\"\"\n \n-    provider_models = get_provider_data()\n-    if not provider_models:\n-        return None\n     click.secho(prompt_message, fg=\"cyan\")\n     for idx, choice in enumerate(choices, start=1):\n         click.secho(f\"{idx}. {choice}\", fg=\"cyan\")\ndiff --git a/lib/cli/src/crewai_cli/utils.py b/lib/cli/src/crewai_cli/utils.py\nindex 5bccec3887..84ae991f81 100644\n--- a/lib/cli/src/crewai_cli/utils.py\n+++ b/lib/cli/src/crewai_cli/utils.py\n@@ -21,6 +21,7 @@\n )\n from rich.console import Console\n \n+from crewai_cli.constants import ENV_VARS\n from crewai_cli.version import get_crewai_tools_dependency\n \n \n@@ -30,6 +31,7 @@\n     \"copy_assistant_imports\",\n     \"copy_assistant_instructions\",\n     \"copy_template\",\n+    \"echo_missing_keys\",\n     \"enable_prompt_line_editing\",\n     \"fetch_and_json_env_file\",\n     \"get_or_create_project_id\",\n@@ -39,6 +41,7 @@\n     \"get_project_version\",\n     \"is_dmn_mode_enabled\",\n     \"load_env_vars\",\n+    \"missing_provider_keys\",\n     \"normalize_package_name\",\n     \"parse_toml\",\n     \"read_toml\",\n@@ -265,3 +268,34 @@ def write_env_file(folder_path: Path, env_vars: dict[str, Any]) -> None:\n         for key, value in env_vars.items():\n             # codeql[py/clear-text-storage-sensitive-data]\n             file.write(f\"{key.upper()}={value}\\n\")\n+\n+\n+def missing_provider_keys(provider: str, env_vars: Mapping[str, object]) -> list[str]:\n+    \"\"\"Return the names ``provider`` needs that neither ``env_vars`` nor the\n+    environment sets. Entries with a runtime default are not needed.\"\"\"\n+    saved = {key.upper() for key, value in env_vars.items() if value}\n+    names = [\n+        str(details[\"key_name\"]).upper()\n+        for details in ENV_VARS.get(provider, [])\n+        if \"key_name\" in details and not details.get(\"optional\", False)\n+    ]\n+    # azure and cerebras also prompt for the model under key_name \"model\"; that\n+    # fills MODEL, which is not a credential.\n+    return [\n+        name\n+        for name in names\n+        if name != \"MODEL\" and name not in saved and not os.environ.get(name)\n+    ]\n+\n+\n+def echo_missing_keys(folder_path: Path, key_names: list[str]) -> None:\n+    \"\"\"Print the ``.env`` lines to add before ``crewai run``, one per missing key.\"\"\"\n+    if len(key_names) == 1:\n+        heading = \"API key not saved. Add this line\"\n+    else:\n+        heading = \"API keys not saved. Add these lines\"\n+    click.secho(\n+        f\"  {heading} to {folder_path / '.env'} before `crewai run`:\", fg=\"yellow\"\n+    )\n+    for name in key_names:\n+        click.echo(f\"    {name}=<your key>\")\ndiff --git a/lib/crewai/src/crewai/llms/providers/openai/completion.py b/lib/crewai/src/crewai/llms/providers/openai/completion.py\nindex 13d1a4782e..dd4ad3c8d3 100644\n--- a/lib/crewai/src/crewai/llms/providers/openai/completion.py\n+++ b/lib/crewai/src/crewai/llms/providers/openai/completion.py\n@@ -76,11 +76,12 @@\n     from crewai.tools.base_tool import BaseTool\n \n \n-# Models learned at runtime to be unavailable on /v1/chat/completions, keyed by\n-# the model string as configured. Populated from the 404 by\n-# `_remember_responses_only_model` so the wasted round trip is paid once per model\n-# per process rather than on every call.\n-_LEARNED_RESPONSES_ONLY_MODELS: set[str] = set()\n+# (endpoint, model) pairs learned at runtime to need the Responses API: not\n+# served by /v1/chat/completions at all (a 404), or not for function tools\n+# (GPT-6 Astra and GPT-6.1 Sol). Populated by `_remember_responses_only_model`\n+# so the wasted round trips are paid once per model per process rather than on\n+# every call. Keyed by endpoint so one gateway's answer never reroutes another.\n+_LEARNED_RESPONSES_ONLY_MODELS: set[tuple[str, str]] = set()\n \n # (endpoint, model) pairs a 400 has shown to reject `reasoning_effort` in this\n # process, so the rejected call is paid once rather than on every request. Keyed\n@@ -735,14 +736,31 @@ def dispatch(params: dict[str, Any]) -> str | Any:\n \n             if self._rejects_reasoning_effort_with_tools(cause):\n                 retry_params = self._reasoning_effort_none_params(completion_params)\n-                if retry_params is not None:\n+                if retry_params is not None and self._offers_reasoning_effort_none(\n+                    cause\n+                ):\n                     logging.debug(\n                         'Retrying %r with reasoning_effort=\"none\": function tools '\n                         \"and reasoning effort cannot be combined on \"\n                         '/v1/chat/completions. Use api=\"responses\" to keep both.',\n                         self.model,\n                     )\n-                    return dispatch(retry_params)\n+                    try:\n+                        return dispatch(retry_params)\n+                    except Exception as retry_error:\n+                        if not self._rejects_reasoning_effort_none(\n+                            retry_error.__cause__ or retry_error\n+                        ):\n+                            raise\n+                self._remember_tools_need_responses()\n+                return self._call_responses(\n+                    messages=messages,\n+                    tools=tools,\n+                    available_functions=available_functions,\n+                    from_task=from_task,\n+                    from_agent=from_agent,\n+                    response_model=response_model,\n+                )\n \n             if self._rejects_reasoning_effort_as_unsupported(cause):\n                 retry_params = self._without_reasoning_effort(completion_params)\n@@ -879,8 +897,25 @@ async def dispatch(params: dict[str, Any]) -> str | Any:\n \n             if self._rejects_reasoning_effort_with_tools(cause):\n                 retry_params = self._reasoning_effort_none_params(completion_params)\n-                if retry_params is not None:\n-                    return await dispatch(retry_params)\n+                if retry_params is not None and self._offers_reasoning_effort_none(\n+                    cause\n+                ):\n+                    try:\n+                        return await dispatch(retry_params)\n+                    except Exception as retry_error:\n+                        if not self._rejects_reasoning_effort_none(\n+                            retry_error.__cause__ or retry_error\n+                        ):\n+                            raise\n+                self._remember_tools_need_responses()\n+                return await self._acall_responses(\n+                    messages=messages,\n+                    tools=tools,\n+                    available_functions=available_functions,\n+                    from_task=from_task,\n+                    from_agent=from_agent,\n+                    response_model=response_model,\n+                )\n \n             if self._rejects_reasoning_effort_as_unsupported(cause):\n                 retry_params = self._without_reasoning_effort(completion_params)\n@@ -1061,6 +1096,14 @@ def _prepare_responses_params(\n \n         if self.store is not None:\n             params[\"store\"] = self.store\n+        elif (\n+            self.api == \"completions\"\n+            and not (self.auto_chain or self.previous_response_id)\n+            and not self._on_compatible_server()\n+        ):\n+            # Moved here from chat completions, which stores nothing by default;\n+            # unset, OpenAI would store the call. Chaining needs it stored.\n+            params[\"store\"] = False\n \n         # Handle response chaining: explicit previous_response_id takes precedence\n         if self.previous_response_id:\n@@ -1542,6 +1585,19 @@ def _handle_streaming_responses(\n \n             return parsed_result\n \n+        if function_calls and not available_functions:\n+            self._emit_call_completed_event(\n+                response=function_calls,\n+                call_type=LLMCallType.TOOL_CALL,\n+                from_task=from_task,\n+                from_agent=from_agent,\n+                messages=params.get(\"input\", []),\n+                usage=usage,\n+                finish_reason=finish_reason,\n+                response_id=response_id,\n+            )\n+            return function_calls\n+\n         if function_calls and available_functions:\n             for call in function_calls:\n                 function_name = call.get(\"name\", \"\")\n@@ -1679,6 +1735,19 @@ async def _ahandle_streaming_responses(\n \n             return parsed_result\n \n+        if function_calls and not available_functions:\n+            self._emit_call_completed_event(\n+                response=function_calls,\n+                call_type=LLMCallType.TOOL_CALL,\n+                from_task=from_task,\n+                from_agent=from_agent,\n+                messages=params.get(\"input\", []),\n+                usage=usage,\n+                finish_reason=finish_reason,\n+                response_id=response_id,\n+            )\n+            return function_calls\n+\n         if function_calls and available_functions:\n             for call in function_calls:\n                 function_name = call.get(\"name\", \"\")\n@@ -1927,7 +1996,7 @@ def _is_responses_only_error(error: BaseException) -> bool:\n \n     def _remember_responses_only_model(self) -> None:\n         \"\"\"Record that this model must use the Responses API.\"\"\"\n-        _LEARNED_RESPONSES_ONLY_MODELS.add(self.model)\n+        _LEARNED_RESPONSES_ONLY_MODELS.add(self._reasoning_effort_key())\n \n     def _model_not_found_message(self, error: Exception) -> str:\n         \"\"\"Build a 404 message that says what to do about it.\n@@ -1971,6 +2040,57 @@ def _rejects_reasoning_effort_with_tools(error: BaseException) -> bool:\n         message = str(source.get(\"message\") or \"\").lower()\n         return \"function tools\" in message and \"reasoning_effort\" in message\n \n+    @staticmethod\n+    def _offers_reasoning_effort_none(error: BaseException) -> bool:\n+        \"\"\"Whether the tools 400 offers `reasoning_effort=\"none\"` as a way out.\n+\n+        Bedrock's OpenAI-compatible endpoint names only /v1/responses for GPT-6\n+        Astra, and rejects \"none\" there, so the retry would be a wasted call:\n+\n+            \"Function tools with reasoning_effort are not supported for\n+            us.openai.gpt-6-astra in /v1/chat/completions. To use function\n+            tools, use /v1/responses.\"\n+        \"\"\"\n+        return \"'none'\" in str(error).lower()\n+\n+    @staticmethod\n+    def _rejects_reasoning_effort_none(error: BaseException) -> bool:\n+        \"\"\"Whether a 400 is the model refusing the `reasoning_effort=\"none\"` retry.\n+\n+        GPT-6 Astra and GPT-6.1 Sol offer \"none\" in the tools 400 and then\n+        refuse it, so their tools are served only by /v1/responses:\n+\n+            {\"param\": \"reasoning_effort\", \"code\": \"unsupported_value\",\n+             \"message\": \"Unsupported value: 'reasoning_effort' does not support\n+             'none' with this model. Supported values are: 'low', 'medium',\n+             'high', and 'xhigh'.\"}\n+        \"\"\"\n+        if not isinstance(error, BadRequestError):\n+            return False\n+        body = getattr(error, \"body\", None)\n+        source = None\n+        if isinstance(body, dict):\n+            inner = body.get(\"error\")\n+            source = inner if isinstance(inner, dict) else body\n+        if not source or source.get(\"param\") != \"reasoning_effort\":\n+            return False\n+        return \"unsupported value\" in str(source.get(\"message\") or \"\").lower()\n+\n+    def _remember_tools_need_responses(self) -> None:\n+        \"\"\"Send this model's later calls on this endpoint to the Responses API.\n+\n+        Not with ``custom_openai=True``: `_effective_api` never upgrades those,\n+        since most don't implement /v1/responses, so each of their tool calls\n+        pays the rejected round trip instead.\n+        \"\"\"\n+        logging.debug(\n+            \"Calling %r on the Responses API: /v1/chat/completions does not serve \"\n+            'its function tools. Set api=\"responses\" to skip the rejected call.',\n+            self.model,\n+        )\n+        if not self.custom_openai:\n+            self._remember_responses_only_model()\n+\n     def _sends_reasoning_effort(self) -> bool:\n         \"\"\"Whether `reasoning_effort` goes on the wire for this model.\n \n@@ -2099,8 +2219,9 @@ def _effective_api(self) -> str:\n         \"\"\"Which OpenAI API to actually use for this model.\n \n         Honours an explicit ``api`` setting, but upgrades to ``\"responses\"`` for\n-        models already known -- from a previous 404 in this process -- not to be\n-        served by chat completions.\n+        models already known -- from a previous 404, or a tools 400 only the\n+        Responses API can serve, in this process -- not to be served by chat\n+        completions.\n \n         Never overrides ``custom_openai=True``: an OpenAI-compatible server may\n         serve any model name on /v1/chat/completions and most don't implement\n@@ -2109,7 +2230,7 @@ def _effective_api(self) -> str:\n         if (\n             self.api == \"completions\"\n             and not self.custom_openai\n-            and self.model in _LEARNED_RESPONSES_ONLY_MODELS\n+            and self._reasoning_effort_key() in _LEARNED_RESPONSES_ONLY_MODELS\n         ):\n             return \"responses\"\n         return self.api\n@@ -2378,11 +2499,13 @@ def _handle_completion(\n                 logging.error(f\"Context window exceeded: {e}\")\n                 raise LLMContextLengthExceededError(str(e)) from e\n \n-            # `_call_completions` retries these, so reporting a failed call\n+            # `_call_completions` recovers these, so reporting a failed call\n             # here would surface an error the caller never experiences.\n-            if self._rejects_reasoning_effort_with_tools(\n-                e\n-            ) or self._rejects_reasoning_effort_as_unsupported(e):\n+            if (\n+                self._rejects_reasoning_effort_with_tools(e)\n+                or self._rejects_reasoning_effort_as_unsupported(e)\n+                or self._rejects_reasoning_effort_none(e)\n+            ):\n                 raise\n \n             error_msg = f\"OpenAI API call failed: {e!s}\"\n@@ -2818,11 +2941,13 @@ async def _ahandle_completion(\n                 logging.error(f\"Context window exceeded: {e}\")\n                 raise LLMContextLengthExceededError(str(e)) from e\n \n-            # `_call_completions` retries these, so reporting a failed call\n+            # `_call_completions` recovers these, so reporting a failed call\n             # here would surface an error the caller never experiences.\n-            if self._rejects_reasoning_effort_with_tools(\n-                e\n-            ) or self._rejects_reasoning_effort_as_unsupported(e):\n+            if (\n+                self._rejects_reasoning_effort_with_tools(e)\n+                or self._rejects_reasoning_effort_as_unsupported(e)\n+                or self._rejects_reasoning_effort_none(e)\n+            ):\n                 raise\n \n             error_msg = f\"OpenAI API call failed: {e!s}\"\n", "test_patch": "diff --git a/lib/cli/tests/conftest.py b/lib/cli/tests/conftest.py\nindex 420fbdbb39..dafef1c98c 100644\n--- a/lib/cli/tests/conftest.py\n+++ b/lib/cli/tests/conftest.py\n@@ -11,3 +11,15 @@ def _usage_counts_stay_on_this_machine(monkeypatch):\n     A test that checks the counting replaces `Telemetry` or sets the flag\n     itself.\"\"\"\n     monkeypatch.setenv(\"CREWAI_DISABLE_TELEMETRY\", \"true\")\n+\n+\n+@pytest.fixture\n+def no_provider_keys(monkeypatch):\n+    \"\"\"Unset every value `crewai create` prompts for, so a key exported on the\n+    machine running the suite does not stop the CLI from naming it as missing.\"\"\"\n+    from crewai_cli.constants import ENV_VARS\n+\n+    for entries in ENV_VARS.values():\n+        for details in entries:\n+            if \"key_name\" in details:\n+                monkeypatch.delenv(str(details[\"key_name\"]).upper(), raising=False)\ndiff --git a/lib/cli/tests/test_constants.py b/lib/cli/tests/test_constants.py\nindex ed27635900..be2bd0b284 100644\n--- a/lib/cli/tests/test_constants.py\n+++ b/lib/cli/tests/test_constants.py\n@@ -20,11 +20,10 @@ def test_huggingface_models():\n     assert len(MODELS[\"huggingface\"]) > 0\n \n \n-def test_openai_models_include_gpt56_family() -> None:\n-    \"\"\"Curated OpenAI list should include Sol, Terra, Luna, and the alias.\"\"\"\n-    openai_models = MODELS[\"openai\"]\n-    for model in (\"gpt-5.6-sol\", \"gpt-5.6-terra\", \"gpt-5.6-luna\", \"gpt-5.6\"):\n-        assert model in openai_models\n+def test_openai_offers_only_the_gpt_6_family() -> None:\n+    \"\"\"No GPT-4, GPT-5.x or o-series model: all superseded by GPT-6, and the\n+    GPT-4.1 snapshots shut down on 2027-01-14.\"\"\"\n+    assert MODELS[\"openai\"] == [\"gpt-6-luna\", \"gpt-6.1-sol\", \"gpt-6-astra\"]\n \n \n def test_gemini_models_offer_no_shut_down_model() -> None:\n@@ -32,11 +31,7 @@ def test_gemini_models_offer_no_shut_down_model() -> None:\n     fails the first run with a ClientError.\"\"\"\n     gemini_models = MODELS[\"gemini\"]\n     assert gemini_models[0] == \"gemini/gemini-3.8-flash\"\n-    for model in (\n-        \"gemini/gemini-4-argon\",\n-        \"gemini/gemini-3.6-flash\",\n-        \"gemini/gemini-3.5-flash-lite\",\n-    ):\n+    for model in (\"gemini/gemini-3.5-flash-lite\", \"gemini/gemini-4-argon\"):\n         assert model in gemini_models\n     shut_down = {\n         \"gemini/gemini-3-pro-preview\",\n@@ -61,6 +56,61 @@ def test_default_wizard_offers_no_gemini_model_new_accounts_cannot_use() -> None\n \n     gemini_models = [model_id for model_id, _ in _PROVIDER_MODELS[\"gemini\"]]\n     assert _default_model_for_provider(\"gemini\") == \"gemini/gemini-3.8-flash\"\n-    for model in (\"gemini-4-argon\", \"gemini-3.6-flash\", \"gemini-3.5-flash-lite\"):\n+    for model in (\"gemini-3.5-flash-lite\", \"gemini-4-argon\"):\n         assert model in gemini_models\n     assert not [m for m in gemini_models if m.startswith((\"gemini-2.\", \"gemini-1.\"))]\n+\n+\n+def test_classic_lists_lead_with_current_small_models() -> None:\n+    \"\"\"`crewai create crew --classic` lists models in MODELS order.\"\"\"\n+    assert MODELS[\"openai\"][0] == \"gpt-6-luna\"\n+    assert MODELS[\"anthropic\"][0] == \"claude-sonnet-5-5\"\n+\n+\n+def test_wizard_lists_lead_with_current_small_models() -> None:\n+    \"\"\"With no key, the wizard shows the curated list in order; the first is the\n+    `--provider` default.\"\"\"\n+    from crewai_cli.create_json_crew import _PROVIDER_MODELS\n+\n+    assert [model_id for model_id, _ in _PROVIDER_MODELS[\"openai\"]] == [\n+        \"gpt-6-luna\",\n+        \"gpt-6.1-sol\",\n+        \"gpt-6-astra\",\n+    ]\n+    assert [model_id for model_id, _ in _PROVIDER_MODELS[\"anthropic\"]] == [\n+        \"claude-sonnet-5-5\",\n+        \"claude-haiku-5-5\",\n+        \"claude-opus-5-5\",\n+        \"claude-fable-5-1\",\n+    ]\n+\n+\n+def test_wizard_offers_a_curated_list_for_every_provider() -> None:\n+    \"\"\"Without one, the picker shows LiteLLM's feed, which lags and keeps old models.\"\"\"\n+    from crewai_cli.create_json_crew import _PROVIDER_MODELS, _PROVIDERS\n+\n+    assert [key for key, _ in _PROVIDERS if not _PROVIDER_MODELS.get(key)] == []\n+\n+\n+def test_no_picker_defaults_to_a_preview_model() -> None:\n+    \"\"\"A preview can be pulled at short notice, so it is labeled and listed last.\"\"\"\n+    from crewai_cli.create_json_crew import _PROVIDER_MODELS\n+\n+    for provider, models in _PROVIDER_MODELS.items():\n+        previews = [\"(preview)\" in label for _, label in models]\n+        assert previews == sorted(previews), f\"{provider}: a preview precedes a GA model\"\n+        assert not previews[0], f\"{provider}: the default is a preview\"\n+\n+\n+def _without_provider_prefix(provider: str, model: str) -> str:\n+    prefix = \"watsonx/\" if provider == \"watson\" else f\"{provider}/\"\n+    return model.removeprefix(prefix)\n+\n+\n+def test_classic_and_wizard_offer_the_same_models_in_the_same_order() -> None:\n+    \"\"\"Both ways of creating a crew lead with the same default.\"\"\"\n+    from crewai_cli.create_json_crew import _PROVIDER_MODELS\n+\n+    for provider, classic in MODELS.items():\n+        wizard = [model_id for model_id, _ in _PROVIDER_MODELS[provider]]\n+        assert [_without_provider_prefix(provider, m) for m in classic] == wizard\ndiff --git a/lib/cli/tests/test_create_crew.py b/lib/cli/tests/test_create_crew.py\nindex 227435636a..c171c34e7e 100644\n--- a/lib/cli/tests/test_create_crew.py\n+++ b/lib/cli/tests/test_create_crew.py\n@@ -1,8 +1,10 @@\n import ast\n import asyncio\n import builtins\n+import io\n import keyword\n import itertools\n+import json\n import os\n import re\n import shlex\n@@ -26,6 +28,7 @@\n import crewai_cli.tui_picker as tui_picker\n from crewai_cli import __version__ as crewai_cli_version\n from crewai_cli.cli import crewai\n+from crewai_cli.constants import MODELS, PROVIDERS\n from crewai_cli.create_crew import create_crew, create_folder_structure\n from crewai_cli.utils import copy_assistant_instructions, render_template\n from crewai_cli.version import get_crewai_tools_dependency\n@@ -1277,7 +1280,7 @@ def test_json_create_provider_preselects_default_model(tmp_path, monkeypatch):\n \n     mock_wizard.assert_called_once_with(\n         skip_provider=True,\n-        default_llm=\"openai/gpt-5.5\",\n+        default_llm=\"openai/gpt-6-luna\",\n     )\n     assert (tmp_path / \"json_crew\" / \"crew.jsonc\").exists()\n     assert not (tmp_path / \"json_crew\" / \"src\").exists()\n@@ -1457,7 +1460,10 @@ def test_render_template_does_not_replace_tokens_inside_replacement_values(tmp_p\n \n \n def test_json_provider_default_model_helper():\n-    assert json_crew._default_model_for_provider(\"openai\") == \"openai/gpt-5.5\"\n+    assert json_crew._default_model_for_provider(\"openai\") == \"openai/gpt-6-luna\"\n+    assert json_crew._default_model_for_provider(\"anthropic\") == (\n+        \"anthropic/claude-sonnet-5-5\"\n+    )\n     assert json_crew._default_model_for_provider(\"anthropic/claude-custom\") == (\n         \"anthropic/claude-custom\"\n     )\n@@ -1520,6 +1526,655 @@ def test_json_create_dmn_mode_uses_non_interactive_defaults(tmp_path, monkeypatc\n     assert f'\"llm\": \"{default_model}\"' in agent_template\n \n \n+FALLBACK_LLM = \"openai/gpt-6-luna\"\n+\n+\n+def _agent(name: str, llm: str) -> dict[str, object]:\n+    return {\n+        \"name\": name,\n+        \"role\": name.title(),\n+        \"goal\": \"Research\",\n+        \"backstory\": \"Researcher\",\n+        \"llm\": llm,\n+        \"tools\": [],\n+        \"planning\": False,\n+        \"allow_delegation\": False,\n+    }\n+\n+\n+def _record_key_prompts(monkeypatch, answers: list[str]) -> list[dict[str, object]]:\n+    \"\"\"Answer API-key prompts in order and record each prompt's text and options.\"\"\"\n+    calls: list[dict[str, object]] = []\n+    replies = iter(answers)\n+\n+    def fake_prompt(text: str, **kwargs: object) -> str:\n+        calls.append({\"text\": click.unstyle(text), **kwargs})\n+        return next(replies)\n+\n+    monkeypatch.setattr(json_crew.click, \"prompt\", fake_prompt)\n+    return calls\n+\n+\n+class _Terminal(io.StringIO):\n+    def isatty(self) -> bool:\n+        return True\n+\n+\n+@pytest.fixture\n+def terminal_stdin(monkeypatch):\n+    \"\"\"Prompt as a person at a terminal would be prompted.\"\"\"\n+    monkeypatch.setattr(\"sys.stdin\", _Terminal())\n+\n+\n+def _pipe_to_stdin(monkeypatch, text: str) -> None:\n+    \"\"\"Pipe ``text`` to the real ``click.prompt``; a hidden prompt fails the test,\n+    because outside pytest it reads the terminal and never sees the pipe.\"\"\"\n+    monkeypatch.setattr(\"sys.stdin\", io.StringIO(text))\n+    monkeypatch.setattr(\n+        click.termui,\n+        \"hidden_prompt_func\",\n+        lambda _prompt: pytest.fail(\"a hidden prompt does not read piped stdin\"),\n+    )\n+\n+\n+def _wizard_result(*agents: dict[str, object]):\n+    return (\n+        list(agents),\n+        [\n+            {\n+                \"name\": \"research_task\",\n+                \"description\": \"Research\",\n+                \"expected_output\": \"Findings\",\n+                \"agent\": agents[0][\"name\"],\n+                \"context\": [],\n+            }\n+        ],\n+        {\"process\": \"sequential\", \"memory\": False, \"inputs\": {}},\n+    )\n+\n+\n+def test_json_wizard_agent_falls_back_to_current_small_model_when_provider_is_skipped(\n+    monkeypatch,\n+):\n+    monkeypatch.setattr(json_crew, \"_prompt_text\", lambda label, **_: label)\n+    monkeypatch.setattr(json_crew, \"pick_many\", lambda *_args, **_kwargs: ([], None))\n+    monkeypatch.setattr(json_crew, \"_confirm\", lambda *_args, **_kwargs: False)\n+\n+    agent = json_crew._wizard_agent(agent_num=1, existing_names=[], skip_provider=True)\n+\n+    assert agent is not None\n+    assert agent[\"llm\"] == FALLBACK_LLM\n+\n+\n+def test_json_model_picker_falls_back_to_current_small_model_on_escape(monkeypatch):\n+    monkeypatch.setattr(json_crew, \"pick_one\", lambda *_args, **_kwargs: -1)\n+\n+    assert json_crew._select_model() == FALLBACK_LLM\n+\n+\n+@pytest.mark.parametrize(\n+    (\"provider\", \"model\", \"key_name\"),\n+    [\n+        (None, FALLBACK_LLM, \"OPENAI_API_KEY\"),\n+        (\"anthropic\", \"anthropic/claude-sonnet-5-5\", \"ANTHROPIC_API_KEY\"),\n+    ],\n+)\n+def test_json_create_dmn_mode_next_steps_name_the_key_the_model_needs(\n+    tmp_path, monkeypatch, capsys, no_provider_keys, provider, model, key_name\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CREWAI_DMN\", \"True\")\n+\n+    json_crew.create_json_crew(\"DMN Crew\", provider=provider, skip_provider=True)\n+\n+    agent_file = tmp_path / \"dmn_crew\" / \"agents\" / \"researcher.jsonc\"\n+    assert f'\"llm\": \"{model}\"' in agent_file.read_text()\n+    output = capsys.readouterr().out\n+    assert f\"  Set {key_name} in .env before `crewai run`\\n\" in output\n+    assert output.index(\"cd dmn_crew\") < output.index(key_name)\n+    assert output.index(key_name) < output.index(\"Run your crew:\")\n+    assert not (tmp_path / \"dmn_crew\" / \".env\").exists()\n+\n+\n+def test_json_create_dmn_mode_next_steps_name_each_key_of_a_multi_key_provider(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CREWAI_DMN\", \"True\")\n+\n+    json_crew.create_json_crew(\n+        \"DMN Crew\", provider=\"bedrock/anthropic.claude-sonnet-5\", skip_provider=True\n+    )\n+\n+    output = capsys.readouterr().out\n+    assert (\n+        \"  Set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY in .env before `crewai run`\\n\"\n+    ) in output\n+    assert \"AWS_DEFAULT_REGION\" not in output\n+\n+\n+def test_json_create_dmn_mode_with_ollama_names_no_key(tmp_path, monkeypatch, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CREWAI_DMN\", \"True\")\n+\n+    json_crew.create_json_crew(\"DMN Crew\", provider=\"ollama\", skip_provider=True)\n+\n+    output = capsys.readouterr().out\n+    assert \"Run your crew:\" in output\n+    assert \"in .env before `crewai run`\" not in output\n+\n+\n+def test_json_create_dmn_mode_next_steps_skip_a_key_already_exported(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CREWAI_DMN\", \"True\")\n+    monkeypatch.setenv(\"OPENAI_API_KEY\", \"sk-from-shell\")\n+\n+    json_crew.create_json_crew(\"DMN Crew\", skip_provider=True)\n+\n+    output = capsys.readouterr().out\n+    assert \"Run your crew:\" in output\n+    assert \"OPENAI_API_KEY\" not in output\n+    assert not (tmp_path / \"dmn_crew\" / \".env\").exists()\n+\n+\n+def test_json_create_skip_provider_names_the_key_in_next_steps_without_dmn(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"CREWAI_DMN\", raising=False)\n+    monkeypatch.setattr(\n+        json_crew,\n+        \"_wizard_agents_and_tasks\",\n+        lambda **_: _wizard_result(_agent(\"researcher\", FALLBACK_LLM)),\n+    )\n+    monkeypatch.setattr(\n+        json_crew.click,\n+        \"prompt\",\n+        lambda *_args, **_kwargs: pytest.fail(\"--skip-provider asks for no key\"),\n+    )\n+\n+    json_crew.create_json_crew(\"Skip Crew\", skip_provider=True)\n+\n+    output = capsys.readouterr().out\n+    assert \"  Set OPENAI_API_KEY in .env before `crewai run`\\n\" in output\n+    assert output.index(\"cd skip_crew\") < output.index(\"Set OPENAI_API_KEY\")\n+    assert not (tmp_path / \"skip_crew\" / \".env\").exists()\n+\n+\n+def test_json_setup_env_blank_key_prints_the_line_to_add_and_claims_no_save(\n+    tmp_path, monkeypatch, capsys, no_provider_keys, terminal_stdin\n+):\n+    calls = _record_key_prompts(monkeypatch, [\"\"])\n+\n+    json_crew._setup_env(tmp_path, [FALLBACK_LLM])\n+\n+    output = capsys.readouterr().out\n+    assert (\n+        f\"  API key not saved. Add this line to {tmp_path / '.env'} \"\n+        \"before `crewai run`:\\n    OPENAI_API_KEY=<your key>\\n\"\n+    ) in output\n+    assert \"saved to .env file\" not in output\n+    env_file = (tmp_path / \".env\").read_text()\n+    assert f\"MODEL={FALLBACK_LLM}\" in env_file\n+    assert \"OPENAI_API_KEY\" not in env_file\n+    assert [call[\"hide_input\"] for call in calls] == [True]\n+\n+\n+def test_json_setup_env_saved_key_keeps_the_success_message(\n+    tmp_path, monkeypatch, capsys, terminal_stdin\n+):\n+    calls = _record_key_prompts(monkeypatch, [\"sk-test\"])\n+\n+    json_crew._setup_env(tmp_path, [FALLBACK_LLM])\n+\n+    output = capsys.readouterr().out\n+    assert \"  API keys and model saved to .env file\" in output\n+    assert \"not saved\" not in output\n+    assert \"OPENAI_API_KEY=sk-test\" in (tmp_path / \".env\").read_text()\n+    assert [call[\"hide_input\"] for call in calls] == [True]\n+\n+\n+def test_json_setup_env_lists_each_missing_key_of_a_multi_key_provider(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    _record_key_prompts(monkeypatch, [\"https://us-south.ml.cloud.ibm.com\", \"\", \"\"])\n+\n+    json_crew._setup_env(tmp_path, [\"watsonx/ibm/granite-4-h-small\"])\n+\n+    output = capsys.readouterr().out\n+    assert (\n+        f\"  API keys not saved. Add these lines to {tmp_path / '.env'} \"\n+        \"before `crewai run`:\\n\"\n+        \"    WATSONX_APIKEY=<your key>\\n\"\n+        \"    WATSONX_PROJECT_ID=<your key>\\n\"\n+    ) in output\n+    assert \"WATSONX_URL=<your key>\" not in output\n+    assert \"saved to .env file\" not in output\n+    env_file = (tmp_path / \".env\").read_text()\n+    assert \"WATSONX_URL=https://us-south.ml.cloud.ibm.com\" in env_file\n+\n+\n+def test_json_watsonx_models_use_the_prefix_crewai_can_run(\n+    monkeypatch, no_provider_keys\n+):\n+    \"\"\"LiteLLM rejects `watson/`; it knows the provider only as `watsonx`.\"\"\"\n+    watson = [key for key, _ in json_crew._PROVIDERS].index(\"watson\")\n+    picks = iter([watson, 0])\n+    monkeypatch.setattr(json_crew, \"pick_one\", lambda *_a, **_k: next(picks))\n+\n+    assert json_crew._select_model() == \"watsonx/ibm/granite-4-h-small\"\n+    for provider in (\"watson\", \"watsonx\"):\n+        assert json_crew._default_model_for_provider(provider) == (\n+            \"watsonx/ibm/granite-4-h-small\"\n+        )\n+\n+\n+def test_json_dmn_next_steps_name_the_watsonx_keys(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CREWAI_DMN\", \"True\")\n+\n+    json_crew.create_json_crew(\"DMN Crew\", provider=\"watson\", skip_provider=True)\n+\n+    assert (\n+        \"Set WATSONX_URL, WATSONX_APIKEY, WATSONX_PROJECT_ID in .env before \"\n+        \"`crewai run`\"\n+    ) in capsys.readouterr().out\n+\n+\n+def test_json_setup_env_lists_neither_azure_deployment_name_nor_api_version(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    _record_key_prompts(monkeypatch, [\"\", \"\", \"\", \"\"])\n+\n+    json_crew._setup_env(tmp_path, [\"azure/my-deployment\"])\n+\n+    output = capsys.readouterr().out\n+    assert (\n+        \"    AZURE_API_KEY=<your key>\\n    AZURE_API_BASE=<your key>\\n\"\n+    ) in output\n+    assert \"AZURE_API_VERSION\" not in output\n+    assert \"MODEL=<your key>\" not in output\n+    assert \"MODEL=azure/my-deployment\" in (tmp_path / \".env\").read_text()\n+\n+\n+def test_json_setup_env_blank_region_still_reports_the_keys_saved(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    _record_key_prompts(monkeypatch, [\"AKIATEST\", \"aws-secret\", \"\"])\n+\n+    json_crew._setup_env(tmp_path, [\"bedrock/anthropic.claude-sonnet-5\"])\n+\n+    output = capsys.readouterr().out\n+    assert \"  API keys and model saved to .env file\" in output\n+    assert \"not saved\" not in output\n+    assert \"AWS_DEFAULT_REGION\" not in output\n+    env_file = (tmp_path / \".env\").read_text()\n+    assert \"AWS_SECRET_ACCESS_KEY=aws-secret\" in env_file\n+    assert \"AWS_DEFAULT_REGION\" not in env_file\n+\n+\n+def test_json_setup_env_blank_key_already_exported_prints_no_line_to_add(\n+    tmp_path, monkeypatch, capsys, no_provider_keys\n+):\n+    monkeypatch.setenv(\"OPENAI_API_KEY\", \"sk-from-shell\")\n+    _record_key_prompts(monkeypatch, [\"\"])\n+\n+    json_crew._setup_env(tmp_path, [FALLBACK_LLM])\n+\n+    output = capsys.readouterr().out\n+    assert \"<your key>\" not in output\n+    assert \"not saved\" not in output\n+    assert \"OPENAI_API_KEY\" not in (tmp_path / \".env\").read_text()\n+\n+\n+@pytest.mark.parametrize(\n+    (\"model\", \"prompts\"),\n+    [\n+        (\n+            \"azure/my-deployment\",\n+            [\n+                (\"Enter your Azure deployment name (must start with 'azure/')\", False),\n+                (\"Enter your AZURE API key (press Enter to skip)\", True),\n+                (\"Enter your AZURE API base URL (press Enter to skip)\", False),\n+                (\"Enter your AZURE API version (press Enter to skip)\", False),\n+            ],\n+        ),\n+        (\n+            \"bedrock/anthropic.claude-sonnet-5\",\n+            [\n+                (\"Enter your AWS Access Key ID (press Enter to skip)\", True),\n+                (\"Enter your AWS Secret Access Key (press Enter to skip)\", True),\n+                (\"Enter your AWS Region Name (press Enter to skip)\", False),\n+            ],\n+        ),\n+        (\n+            \"watsonx/ibm/granite-4-h-small\",\n+            [\n+                (\"Enter your WATSONX URL (press Enter to skip)\", False),\n+                (\"Enter your WATSONX API Key (press Enter to skip)\", True),\n+                (\"Enter your WATSONX Project Id (press Enter to skip)\", False),\n+            ],\n+        ),\n+        (\n+            \"cerebras/llama3.1-8b\",\n+            [\n+                (\"Enter your Cerebras model name (must start with 'cerebras/')\", False),\n+                (\"Enter your Cerebras API version (press Enter to skip)\", True),\n+            ],\n+        ),\n+    ],\n+)\n+def test_json_setup_env_hides_only_secrets_at_a_terminal(\n+    tmp_path, monkeypatch, terminal_stdin, model, prompts\n+):\n+    calls = _record_key_prompts(monkeypatch, [\"\"] * len(prompts))\n+\n+    json_crew._setup_env(tmp_path, [model])\n+\n+    assert [(str(call[\"text\"]).strip(), call[\"hide_input\"]) for call in calls] == (\n+        prompts\n+    )\n+\n+\n+def test_json_setup_env_reads_a_piped_key_from_stdin(tmp_path, monkeypatch, capsys):\n+    _pipe_to_stdin(monkeypatch, \"sk-piped\\n\")\n+\n+    json_crew._setup_env(tmp_path, [FALLBACK_LLM])\n+\n+    assert \"OPENAI_API_KEY=sk-piped\" in (tmp_path / \".env\").read_text()\n+    assert \"  API keys and model saved to .env file\" in capsys.readouterr().out\n+\n+\n+def test_json_setup_env_ollama_needs_no_key_and_prints_nothing_extra(\n+    tmp_path, monkeypatch, capsys\n+):\n+    monkeypatch.setattr(\n+        json_crew.click,\n+        \"prompt\",\n+        lambda *_args, **_kwargs: pytest.fail(\"ollama has no API key to prompt for\"),\n+    )\n+\n+    json_crew._setup_env(tmp_path, [\"ollama/llama3.3\"])\n+\n+    output = capsys.readouterr().out\n+    assert \"  API keys and model saved to .env file\" in output\n+    assert \"not saved\" not in output\n+    assert \"<your key>\" not in output\n+    assert \"API_BASE=http://localhost:11434\" in (tmp_path / \".env\").read_text()\n+\n+\n+def test_json_create_prompts_once_per_provider_and_first_agent_sets_model(\n+    tmp_path, monkeypatch, capsys\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"CREWAI_DMN\", raising=False)\n+    monkeypatch.setattr(\n+        json_crew,\n+        \"_wizard_agents_and_tasks\",\n+        lambda **_: _wizard_result(\n+            _agent(\"researcher\", FALLBACK_LLM),\n+            _agent(\"writer\", \"anthropic/claude-sonnet-5\"),\n+            _agent(\"editor\", \"openai/gpt-5.5\"),\n+        ),\n+    )\n+    calls = _record_key_prompts(monkeypatch, [\"sk-openai\", \"sk-anthropic\"])\n+\n+    json_crew.create_json_crew(\"Mixed Crew\", skip_provider=False)\n+\n+    assert [call[\"text\"] for call in calls] == [\n+        \"  Enter your OPENAI API key (press Enter to skip)\",\n+        \"  Enter your ANTHROPIC API key (press Enter to skip)\",\n+    ]\n+    env_lines = (tmp_path / \"mixed_crew\" / \".env\").read_text().splitlines()\n+    assert env_lines == [\n+        f\"MODEL={FALLBACK_LLM}\",\n+        \"OPENAI_API_KEY=sk-openai\",\n+        \"ANTHROPIC_API_KEY=sk-anthropic\",\n+    ]\n+    output = capsys.readouterr().out\n+    assert output.count(\"API keys and model saved to .env file\") == 1\n+    assert \"in .env before `crewai run`\" not in output\n+\n+\n+@mock.patch(\"crewai_cli.create_crew.create_folder_structure\")\n+@mock.patch(\"crewai_cli.create_crew.copy_template\")\n+@mock.patch(\"crewai_cli.create_crew.get_provider_data\")\n+@mock.patch(\"crewai_cli.create_crew.select_provider\")\n+@mock.patch(\"crewai_cli.create_crew.select_model\")\n+@mock.patch(\"click.prompt\")\n+def test_classic_create_blank_key_prints_the_line_to_add_and_claims_no_save(\n+    mock_prompt,\n+    mock_select_model,\n+    mock_select_provider,\n+    mock_get_provider_data,\n+    mock_copy_template,\n+    mock_create_folder_structure,\n+    tmp_path,\n+    capsys,\n+    no_provider_keys,\n+    terminal_stdin,\n+):\n+    crew_path = tmp_path / \"test_crew\"\n+    crew_path.mkdir()\n+    mock_create_folder_structure.return_value = (crew_path, \"test_crew\", \"TestCrew\")\n+    mock_get_provider_data.return_value = {\"openai\": [\"gpt-5.6-luna\"]}\n+    mock_select_provider.return_value = \"openai\"\n+    mock_select_model.return_value = \"gpt-5.6-luna\"\n+    mock_prompt.return_value = \"\"\n+\n+    create_crew(\"Test Crew\")\n+\n+    output = capsys.readouterr().out\n+    assert (\n+        f\"  API key not saved. Add this line to {crew_path / '.env'} \"\n+        \"before `crewai run`:\\n    OPENAI_API_KEY=<your key>\\n\"\n+    ) in output\n+    assert \"saved to .env file\" not in output\n+    env_file = (crew_path / \".env\").read_text()\n+    assert \"MODEL=gpt-5.6-luna\" in env_file\n+    assert \"OPENAI_API_KEY\" not in env_file\n+    assert mock_prompt.call_args.kwargs[\"hide_input\"] is True\n+\n+\n+@mock.patch(\"crewai_cli.create_crew.create_folder_structure\")\n+@mock.patch(\"crewai_cli.create_crew.copy_template\")\n+@mock.patch(\"crewai_cli.create_crew.get_provider_data\")\n+@mock.patch(\"crewai_cli.create_crew.select_provider\")\n+@mock.patch(\"crewai_cli.create_crew.select_model\")\n+@mock.patch(\"click.prompt\")\n+def test_classic_create_saved_key_keeps_the_success_message(\n+    mock_prompt,\n+    mock_select_model,\n+    mock_select_provider,\n+    mock_get_provider_data,\n+    mock_copy_template,\n+    mock_create_folder_structure,\n+    tmp_path,\n+    capsys,\n+    terminal_stdin,\n+):\n+    crew_path = tmp_path / \"test_crew\"\n+    crew_path.mkdir()\n+    mock_create_folder_structure.return_value = (crew_path, \"test_crew\", \"TestCrew\")\n+    mock_get_provider_data.return_value = {\"anthropic\": [\"claude-sonnet-5\"]}\n+    mock_select_provider.return_value = \"anthropic\"\n+    mock_select_model.return_value = \"claude-sonnet-5\"\n+    mock_prompt.return_value = \"sk-ant-test\"\n+\n+    create_crew(\"Test Crew\")\n+\n+    output = capsys.readouterr().out\n+    assert \"API keys and model saved to .env file\" in output\n+    assert \"not saved\" not in output\n+    assert \"ANTHROPIC_API_KEY=sk-ant-test\" in (crew_path / \".env\").read_text()\n+    assert mock_prompt.call_args.kwargs[\"hide_input\"] is True\n+\n+\n+@mock.patch(\"crewai_cli.create_crew.create_folder_structure\")\n+@mock.patch(\"crewai_cli.create_crew.copy_template\")\n+@mock.patch(\"crewai_cli.create_crew.get_provider_data\")\n+@mock.patch(\"crewai_cli.create_crew.select_provider\")\n+@mock.patch(\"crewai_cli.create_crew.select_model\")\n+@mock.patch(\"click.prompt\")\n+def test_classic_create_blank_region_still_reports_the_keys_saved(\n+    mock_prompt,\n+    mock_select_model,\n+    mock_select_provider,\n+    mock_get_provider_data,\n+    mock_copy_template,\n+    mock_create_folder_structure,\n+    tmp_path,\n+    capsys,\n+    no_provider_keys,\n+    terminal_stdin,\n+):\n+    crew_path = tmp_path / \"test_crew\"\n+    crew_path.mkdir()\n+    mock_create_folder_structure.return_value = (crew_path, \"test_crew\", \"TestCrew\")\n+    mock_get_provider_data.return_value = {\"bedrock\": [\"bedrock/amazon.nova-pro\"]}\n+    mock_select_provider.return_value = \"bedrock\"\n+    mock_select_model.return_value = \"bedrock/amazon.nova-pro\"\n+    mock_prompt.side_effect = [\"AKIATEST\", \"aws-secret\", \"\"]\n+\n+    create_crew(\"Test Crew\")\n+\n+    output = capsys.readouterr().out\n+    assert \"API keys and model saved to .env file\" in output\n+    assert \"AWS_DEFAULT_REGION\" not in output\n+    assert [call.kwargs[\"hide_input\"] for call in mock_prompt.call_args_list] == [\n+        True,\n+        True,\n+        False,\n+    ]\n+\n+\n+@mock.patch(\"crewai_cli.create_crew.create_folder_structure\")\n+@mock.patch(\"crewai_cli.create_crew.copy_template\")\n+@mock.patch(\"crewai_cli.create_crew.get_provider_data\")\n+@mock.patch(\"crewai_cli.create_crew.select_provider\")\n+@mock.patch(\"crewai_cli.create_crew.select_model\")\n+@mock.patch(\"click.prompt\")\n+def test_classic_create_blank_key_already_exported_prints_no_line_to_add(\n+    mock_prompt,\n+    mock_select_model,\n+    mock_select_provider,\n+    mock_get_provider_data,\n+    mock_copy_template,\n+    mock_create_folder_structure,\n+    tmp_path,\n+    monkeypatch,\n+    capsys,\n+    no_provider_keys,\n+):\n+    monkeypatch.setenv(\"OPENAI_API_KEY\", \"sk-from-shell\")\n+    crew_path = tmp_path / \"test_crew\"\n+    crew_path.mkdir()\n+    mock_create_folder_structure.return_value = (crew_path, \"test_crew\", \"TestCrew\")\n+    mock_get_provider_data.return_value = {\"openai\": [\"gpt-5.6-luna\"]}\n+    mock_select_provider.return_value = \"openai\"\n+    mock_select_model.return_value = \"gpt-5.6-luna\"\n+    mock_prompt.return_value = \"\"\n+\n+    create_crew(\"Test Crew\")\n+\n+    output = capsys.readouterr().out\n+    assert \"<your key>\" not in output\n+    assert \"not saved\" not in output\n+    assert \"OPENAI_API_KEY\" not in (crew_path / \".env\").read_text()\n+\n+\n+@mock.patch(\"crewai_cli.create_crew.create_folder_structure\")\n+@mock.patch(\"crewai_cli.create_crew.copy_template\")\n+@mock.patch(\"crewai_cli.create_crew.get_provider_data\")\n+@mock.patch(\"crewai_cli.create_crew.select_provider\")\n+@mock.patch(\"crewai_cli.create_crew.select_model\")\n+def test_classic_create_reads_a_piped_key_from_stdin(\n+    mock_select_model,\n+    mock_select_provider,\n+    mock_get_provider_data,\n+    mock_copy_template,\n+    mock_create_folder_structure,\n+    tmp_path,\n+    monkeypatch,\n+    capsys,\n+):\n+    _pipe_to_stdin(monkeypatch, \"sk-piped\\n\")\n+    crew_path = tmp_path / \"test_crew\"\n+    crew_path.mkdir()\n+    mock_create_folder_structure.return_value = (crew_path, \"test_crew\", \"TestCrew\")\n+    mock_get_provider_data.return_value = {\"openai\": [\"gpt-5.6-luna\"]}\n+    mock_select_provider.return_value = \"openai\"\n+    mock_select_model.return_value = \"gpt-5.6-luna\"\n+\n+    create_crew(\"Test Crew\")\n+\n+    assert \"OPENAI_API_KEY=sk-piped\" in (crew_path / \".env\").read_text()\n+    assert \"API keys and model saved to .env file\" in capsys.readouterr().out\n+\n+\n+@pytest.fixture\n+def classic_create(tmp_path, monkeypatch, runner):\n+    \"\"\"Run `crewai create crew my_crew --classic` in ``tmp_path`` with\n+    ``tmp_path`` as home, so the LiteLLM cache starts cold.\"\"\"\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"HOME\", str(tmp_path))\n+\n+    def run(answers: list[str]):\n+        return runner.invoke(\n+            crewai,\n+            [\"create\", \"crew\", \"my_crew\", \"--classic\"],\n+            input=\"\".join(f\"{answer}\\n\" for answer in answers),\n+        )\n+\n+    return run\n+\n+\n+def _catalog_unreachable(*_args, **_kwargs):\n+    raise httpx.ConnectError(\"[Errno 8] nodename nor servname provided\")\n+\n+\n+@pytest.mark.parametrize(\"provider\", list(MODELS))\n+def test_classic_create_offers_curated_models_when_the_catalog_is_unreachable(\n+    provider, classic_create, tmp_path, monkeypatch\n+):\n+    monkeypatch.setattr(\"crewai_cli.provider.httpx.stream\", _catalog_unreachable)\n+\n+    result = classic_create([str(PROVIDERS.index(provider) + 1), \"1\", \"\", \"\", \"\"])\n+\n+    assert result.exit_code == 0, result.output\n+    assert \"Error fetching provider data: [Errno 8]\" in result.output\n+    for number, model in enumerate(MODELS[provider], start=1):\n+        assert f\"{number}. {model}\\n\" in result.output\n+    assert \"Crew my_crew created successfully!\" in result.output\n+    project = tmp_path / \"my_crew\"\n+    assert f\"MODEL={MODELS[provider][0]}\" in (project / \".env\").read_text()\n+    assert (project / \"src\" / \"my_crew\" / \"crew.py\").is_file()\n+\n+\n+def test_classic_create_other_lists_catalog_providers_when_the_catalog_loads(\n+    classic_create, tmp_path, monkeypatch\n+):\n+    cache = tmp_path / \".crewai\" / \"provider_cache.json\"\n+    cache.parent.mkdir()\n+    cache.write_text(json.dumps({\"xai/grok-5\": {\"litellm_provider\": \"xai\"}}))\n+    monkeypatch.setattr(\n+        \"crewai_cli.provider.httpx.stream\",\n+        lambda *_a, **_k: pytest.fail(\"a fresh cache must not be refetched\"),\n+    )\n+    xai_number = sorted({*PROVIDERS, \"xai\"}).index(\"xai\") + 1\n+\n+    result = classic_create([str(len(PROVIDERS) + 1), str(xai_number)])\n+\n+    assert result.exit_code == 0, result.output\n+    _, full_list = result.output.split(\"Select a provider from the full list:\\n\")\n+    assert f\"{xai_number}. xai\\n\" in full_list\n+    assert \"Crew my_crew created successfully!\" in result.output\n+\n+\n def test_create_crew_scaffolds_assistant_instructions(tmp_path, monkeypatch):\n     monkeypatch.chdir(tmp_path)\n     create_crew(\"my-crew\", skip_provider=True)\ndiff --git a/lib/cli/tests/test_utils.py b/lib/cli/tests/test_utils.py\nindex a8427f4cd3..56afcf6508 100644\n--- a/lib/cli/tests/test_utils.py\n+++ b/lib/cli/tests/test_utils.py\n@@ -130,3 +130,31 @@ def test_project_id_lookups_default_to_the_cwd_pyproject(tmp_path, monkeypatch):\n # Tests for extract_available_exports, get_crews, get_flows, fetch_crews,\n # is_valid_tool live in lib/crewai/tests/cli/test_utils.py \u2014 the canonical\n # implementations are in crewai.utilities.project_utils.\n+\n+\n+@pytest.mark.usefixtures(\"no_provider_keys\")\n+@pytest.mark.parametrize(\n+    (\"provider\", \"env_vars\", \"expected\"),\n+    [\n+        (\"openai\", {}, [\"OPENAI_API_KEY\"]),\n+        (\"openai\", {\"OPENAI_API_KEY\": \"\"}, [\"OPENAI_API_KEY\"]),\n+        (\"openai\", {\"OPENAI_API_KEY\": \"sk-test\"}, []),\n+        (\"bedrock\", {\"aws_access_key_id\": \"AKIATEST\"}, [\"AWS_SECRET_ACCESS_KEY\"]),\n+        (\"azure\", {}, [\"AZURE_API_KEY\", \"AZURE_API_BASE\"]),\n+        (\"watson\", {}, [\"WATSONX_URL\", \"WATSONX_APIKEY\", \"WATSONX_PROJECT_ID\"]),\n+        (\"ollama\", {}, []),\n+        (\"deepseek\", {}, []),\n+    ],\n+)\n+def test_missing_provider_keys_names_each_required_value_left_unset(\n+    provider, env_vars, expected\n+):\n+    assert utils.missing_provider_keys(provider, env_vars) == expected\n+\n+\n+@pytest.mark.usefixtures(\"no_provider_keys\")\n+def test_missing_provider_keys_skips_a_key_set_in_the_environment(monkeypatch):\n+    monkeypatch.setenv(\"AWS_ACCESS_KEY_ID\", \"AKIA-from-shell\")\n+    monkeypatch.setenv(\"AWS_SECRET_ACCESS_KEY\", \"\")\n+\n+    assert utils.missing_provider_keys(\"bedrock\", {}) == [\"AWS_SECRET_ACCESS_KEY\"]\ndiff --git a/lib/crewai/tests/cassettes/llms/openai/test_gpt_6_1_sol_agent_runs_its_tool.yaml b/lib/crewai/tests/cassettes/llms/openai/test_gpt_6_1_sol_agent_runs_its_tool.yaml\nnew file mode 100644\nindex 0000000000..76ddbb929f\n--- /dev/null\n+++ b/lib/crewai/tests/cassettes/llms/openai/test_gpt_6_1_sol_agent_runs_its_tool.yaml\n@@ -0,0 +1,644 @@\n+interactions:\n+- request:\n+    body: '{\"input\":[{\"role\":\"user\",\"content\":\"\\nCurrent Task: What is the access\n+      code for the project named ''orion''?\\n\\nThis is the expected criteria for your\n+      final answer: The access code, exactly as the tool returned it\\nyou MUST return\n+      the actual complete content as the final answer, not a summary.\"}],\"instructions\":\"You\n+      are Records clerk. You never guess a code.\\nYour personal goal is: Report access\n+      codes exactly as the lookup tool returns them\",\"model\":\"gpt-6.1-sol\",\"tools\":[{\"type\":\"function\",\"name\":\"lookup_code\",\"description\":\"Look\n+      up the access code for a project by name.\",\"parameters\":{\"properties\":{\"name\":{\"title\":\"Name\",\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\",\"additionalProperties\":false}}]}'\n+    headers:\n+      User-Agent:\n+      - X-USER-AGENT-XXX\n+      accept:\n+      - application/json\n+      accept-encoding:\n+      - ACCEPT-ENCODING-XXX\n+      authorization:\n+      - AUTHORIZATION-XXX\n+      connection:\n+      - keep-alive\n+      co