pports_prompt_caching\": true,\n         \"supports_reasoning\": true,\n         \"supports_response_schema\": true,\n         \"supports_tool_choice\": true,\n", "test_patch": "diff --git a/tests/unit/litellm_core_utils/llm_cost_calc/test_llm_cost_calc_utils.py b/tests/unit/litellm_core_utils/llm_cost_calc/test_llm_cost_calc_utils.py\nindex cb9d87622e2f..6612d28c43b4 100644\n--- a/tests/unit/litellm_core_utils/llm_cost_calc/test_llm_cost_calc_utils.py\n+++ b/tests/unit/litellm_core_utils/llm_cost_calc/test_llm_cost_calc_utils.py\n@@ -4413,19 +4413,23 @@ def test_azure_gpt_6_foundry_price_sheet(_local_model_cost_map, model_base):\n \n @pytest.mark.parametrize(\"model\", [\"azure/gpt-6-luna\", \"azure/gpt-6-luna-2026-09-22\"])\n @pytest.mark.parametrize(\n-    (\"prompt_tokens\", \"input_rate\", \"cache_read_rate\", \"output_rate\"),\n+    (\"prompt_tokens\", \"cost_suffix\"),\n     [\n-        (100_000, 5e-08, 5e-09, 2.5e-07),\n-        (300_000, 1e-07, 1e-08, 3.75e-07),\n+        (100_000, \"\"),\n+        (300_000, \"_above_272k_tokens\"),\n     ],\n )\n-def test_generic_cost_per_token_azure_gpt_6_luna_flex_tiers(\n-    _local_model_cost_map, model, prompt_tokens, input_rate, cache_read_rate, output_rate\n-):\n-    \"\"\"azure/gpt-6-luna bills Azure's Flex Global rates, half of Standard, with the long context step past 272K.\"\"\"\n-    cached_tokens = 20_000\n-    completion_tokens = 1_000\n-    usage = Usage(\n+def test_generic_cost_per_token_azure_flex_uses_registered_tier_rates(\n+    _local_model_cost_map: None, model: str, prompt_tokens: int, cost_suffix: str\n+) -> None:\n+    model_info: Final = litellm.get_model_info(model=model, custom_llm_provider=\"azure\")\n+    input_rate, cache_read_rate, output_rate = (\n+        rate if (rate := model_info.get(f\"{key}{cost_suffix}_flex\")) is not None else model_info[f\"{key}{cost_suffix}\"]\n+        for key in (\"input_cost_per_token\", \"cache_read_input_token_cost\", \"output_cost_per_token\")\n+    )\n+    cached_tokens: Final = 20_000\n+    completion_tokens: Final = 1_000\n+    usage: Final = Usage(\n         prompt_tokens=prompt_tokens,\n         completion_tokens=completion_tokens,\n         total_tokens=prompt_tokens + completion_tokens,\n@@ -4437,7 +4441,7 @@ def test_generic_cost_per_token_azure_gpt_6_luna_flex_tiers(\n         custom_llm_provider=\"azure\",\n         service_tier=\"flex\",\n     )\n-    expected_prompt = (prompt_tokens - cached_tokens) * input_rate + cached_tokens * cache_read_rate\n+    expected_prompt: Final = (prompt_tokens - cached_tokens) * input_rate + cached_tokens * cache_read_rate\n     assert prompt_cost == pytest.approx(expected_prompt)\n     assert completion_cost == pytest.approx(completion_tokens * output_rate)\n \ndiff --git a/tests/unit/llms/deepinfra/test_deepinfra_chat_transformation.py b/tests/unit/llms/deepinfra/test_deepinfra_chat_transformation.py\nindex 773c1d056f03..1feb46b7b55f 100644\n--- a/tests/unit/llms/deepinfra/test_deepinfra_chat_transformation.py\n+++ b/tests/unit/llms/deepinfra/test_deepinfra_chat_transformation.py\n@@ -237,3 +237,28 @@ async def test_deepinfra_request_stringifies_tool_content_without_touching_the_c\n \n     assert body[\"messages\"][2][\"content\"] == \"20\"\n     assert messages == messages_before\n+\n+\n+@pytest.mark.parametrize(\n+    \"model\",\n+    (\n+        \"deepseek-ai/DeepSeek-V4-Pro\",\n+        \"deepseek-ai/DeepSeek-V4-Pro-0813\",\n+        \"moonshotai/Kimi-K3\",\n+    ),\n+)\n+def test_deepinfra_reasoning_models_support_and_forward_reasoning_effort(\n+    model: str, local_model_cost_map: None\n+) -> None:\n+    from litellm.llms.deepinfra.chat.transformation import DeepInfraConfig\n+\n+    config: Final = DeepInfraConfig()\n+    assert litellm.supports_reasoning(model=model, custom_llm_provider=\"deepinfra\") is True\n+    assert \"reasoning_effort\" in config.get_supported_openai_params(model=model)\n+    mapped: Final = config.map_openai_params(\n+        non_default_params={\"reasoning_effort\": \"low\"},\n+        optional_params={},\n+        model=model,\n+        drop_params=False,\n+    )\n+    assert mapped == {\"reasoning_effort\": \"low\"}\ndiff --git a/tests/unit/llms/soniox/test_soniox_provider_registration.py b/tests/unit/llms/soniox/test_soniox_provider_registration.py\nindex b4e758c119df..af6e270e2048 100644\n--- a/tests/unit/llms/soniox/test_soniox_provider_registration.py\n+++ b/tests/unit/llms/soniox/test_soniox_provider_registration.py\n@@ -41,6 +41,24 @@ def test_should_resolve_soniox_v5_via_get_llm_provider(self, monkeypatch):\n         assert api_key == \"test-key\"\n         assert api_base == \"https://api.soniox.com\"\n \n+    def test_should_resolve_soniox_v6_via_get_llm_provider(self, monkeypatch):\n+        monkeypatch.setenv(\"SONIOX_API_KEY\", \"test-key\")\n+        model, provider, api_key, api_base = litellm.get_llm_provider(\n+            model=\"soniox/stt-async-v6\"\n+        )\n+        assert provider == \"soniox\"\n+        assert model == \"stt-async-v6\"\n+        assert api_key == \"test-key\"\n+        assert api_base == \"https://api.soniox.com\"\n+\n+        model, provider, api_key, api_base = litellm.get_llm_provider(\n+            model=\"soniox/stt-rt-v6\"\n+        )\n+        assert provider == \"soniox\"\n+        assert model == \"stt-rt-v6\"\n+        assert api_key == \"test-key\"\n+        assert api_base == \"https://api.soniox.com\"\n+\n     def test_should_return_soniox_config_from_provider_config_manager(self):\n         from litellm.utils import ProviderConfigManager\n \ndiff --git a/tests/unit/test_model_prices_and_context_window.py b/tests/unit/test_model_prices_and_context_window.py\nindex 0febb58548c9..9c71d4ef0d4d 100644\n--- a/tests/unit/test_model_prices_and_context_window.py\n+++ b/tests/unit/test_model_prices_and_context_window.py\n@@ -1112,3 +1112,57 @@ def test_azure_ai_claude_rows_priced_for_web_search_say_they_support_it(path: Pa\n     assert priced_rows\n     unflagged: Final = tuple(key for key, row in priced_rows.items() if row.get(\"supports_web_search\") is not True)\n     assert unflagged == (), unflagged\n+\n+\n+@pytest.mark.parametrize(\n+    (\"model\", \"supports_vision\", \"supports_video_input\", \"supports_audio_input\"),\n+    (\n+        (\"deepinfra/zai-org/GLM-5.3-Flash\", True, True, False),\n+        (\"deepinfra/XiaomiMiMo/MiMo-V2.6-Flash\", True, True, True),\n+        (\"deepinfra/nvidia/NVIDIA-Nemotron-3.5-Super-VL\", True, True, False),\n+        (\"deepinfra/tencent/Hy4-preview\", False, False, False),\n+    ),\n+)\n+def test_deepinfra_new_catalog_models_resolve_pricing_and_capabilities(\n+    model: str,\n+    supports_vision: bool,\n+    supports_video_input: bool,\n+    supports_audio_input: bool,\n+    local_model_cost_map: None,\n+) -> None:\n+    from litellm.llms.deepinfra.chat.transformation import DeepInfraConfig\n+\n+    catalog: Final = TypeAdapter(dict[str, JsonValue]).validate_json(PRICES_PATH.read_bytes())\n+    backup: Final = TypeAdapter(dict[str, JsonValue]).validate_json(BACKUP_PRICES_PATH.read_bytes())\n+    row: Final = catalog[model]\n+    assert isinstance(row, dict)\n+    assert row == backup[model]\n+    assert (row[\"litellm_provider\"], row[\"mode\"]) == (\"deepinfra\", \"chat\")\n+\n+    max_input: Final = row[\"max_input_tokens\"]\n+    input_cost: Final = row[\"input_cost_per_token\"]\n+    output_cost: Final = row[\"output_cost_per_token\"]\n+    cache_read_cost: Final = row[\"cache_read_input_token_cost\"]\n+    assert isinstance(max_input, int) and max_input > 0\n+    assert isinstance(input_cost, float) and isinstance(output_cost, float) and isinstance(cache_read_cost, float)\n+    assert 0 < cache_read_cost < input_cost and output_cost > 0\n+\n+    bare_model: Final = model.removeprefix(\"deepinfra/\")\n+    info: Final = litellm.get_model_info(model=bare_model, custom_llm_provider=\"deepinfra\")\n+    assert info[\"input_cost_per_token\"] == input_cost\n+    assert info[\"output_cost_per_token\"] == output_cost\n+    assert info[\"cache_read_input_token_cost\"] == cache_read_cost\n+\n+    prompt_cost, completion_cost = litellm.cost_per_token(\n+        model=model, prompt_tokens=1_000_000, completion_tokens=1_000_000\n+    )\n+    assert (prompt_cost, completion_cost) == pytest.approx((input_cost * 1_000_000, output_cost * 1_000_000))\n+\n+    assert litellm.supports_reasoning(model=model) is True\n+    assert litellm.supports_function_calling(model=model) is True\n+    assert litellm.supports_response_schema(model=model) is True\n+    assert litellm.utils.supports_prompt_caching(model=model) is True\n+    assert litellm.supports_vision(model=model) is supports_vision\n+    assert litellm.supports_video_input(model=model) is supports_video_input\n+    assert litellm.supports_audio_input(model=model) is supports_audio_input\n+    assert \"reasoning_effort\" in DeepInfraConfig().get_supported_openai_params(model=model)\n", "problem_statement": "[Feature]: Add Soniox stt-async-v6 and stt-rt-v6 to the cost map\n### Check for existing issues\n\n- [x] I have searched the existing issues and checked that my issue is not a duplicate.\n\n### The Feature\n\nSoniox released `stt-async-v6` and `stt-rt-v6` on Nov 3, 2026 (https://docs.soniox.com/stt/models). The v5 models are deprecated and get removed on Dec 15, 2026. The LiteLLM cost map only lists up to v5, so calls to the v6 models work but are logged at $0 spend. Please add the two v6 models at the current Soniox prices ($0.10/hour async, $0.12/hour realtime, https://soniox.com/pricing) and mark v5 with its removal date.\n\n### User Flow\n\nBefore this feature (today): a developer who moves to the new Soniox models gets transcripts back but no spend is recorded.\n\n1. The proxy admin adds `soniox/stt-async-v6` and `soniox/stt-rt-v6` to config.yaml with a Soniox API key\n2. The developer sends POST http://localhost:4000/v1/audio/transcriptions with a WAV file and gets the transcript back with HTTP 200\n3. The response has no `x-litellm-response-cost` header, and the proxy logs `response_cost: 0.0`\n4. A realtime session on ws://localhost:4000/v1/realtime?model=soniox-rt-v6&intent=transcription also returns the transcript and is logged at $0\n\nAfter this feature (ideal user flow): the same calls are billed at Soniox's per-hour rates.\n\n1. The proxy admin adds the same two models\n2. The same POST returns the transcript and `x-litellm-response-cost` matches the audio length at $0.10/hour\n3. The realtime session is logged at the audio length times $0.12/hour\n\n### How far you got\n\nConfig / setup the proxy ran with:\n\n```yaml\nmodel_list:\n  - model_name: soniox-async-v6\n    litellm_params:\n      model: soniox/stt-async-v6\n      api_key: os.environ/SONIOX_API_KEY\n  - model_name: soniox-rt-v6\n    litellm_params:\n      model: soniox/stt-rt-v6\n      api_key: os.environ/SONIOX_API_KEY\n    model_info:\n      mode: audio_transcription\n```\n\nVersion or commit: main at 1c68ec429aea, hosted cost map\n\nCommands and their full output, up to the step that dead-ends:\n\n```\n$ python client.py   # POST tests/gettysburg.wav to /v1/audio/transcriptions, then a realtime session with a 24 kHz pcm16 WAV\nasync status 200 cost None\nasync text For score and 7 years ago, our fathers brought forth on this continent a new nation, conceived in liberty and dedicated\nrt completed What is the weather in Paris?\n\n$ grep \"response_cost:\" litellm.log\nlitellm_logging.py:2272 - response_cost: 0.0\nlitellm_logging.py:2272 - response_cost: 0.0\n```\n\nWhat stopped me there: both v6 models are missing from the cost map, so spend is recorded as zero.\n\n### Which part of LiteLLM is this about?\n\nCost map: model prices and context windows\n\n### LiteLLM is hiring a founding backend engineer, are you interested in joining us and shipping to all our users?\n\nNo\n\n", "hints_text": "", "created_at": "2026-11-13T13:16:10Z"}
{"repo": "BerriAI/litellm", "pull_number": 51517, "instance_id": "BerriAI__litellm-51517", "issue_numbers": ["49767"], "base_commit": "ac5fd9e0d048e2f86a20d5a7b4ad422f379eff5b", "patch": "diff --git a/litellm/constants.py b/litellm/constants.py\nindex 9efeefacacd6..276bc9036801 100644\n--- a/litellm/constants.py\n+++ b/litellm/constants.py\n@@ -2001,7 +2001,7 @@ class ServerStreamingClassification(str, Enum):\n     \"BACKGROUND_INTERACTION_COST_POLL_MAX_INTERVAL_SECONDS\", 60.0\n )\n BACKGROUND_INTERACTION_COST_POLL_TIMEOUT_SECONDS: Final = get_env_float(\n-    \"BACKGROUND_INTERACTION_COST_POLL_TIMEOUT_SECONDS\", 3600.0\n+    \"BACKGROUND_INTERACTION_COST_POLL_TIMEOUT_SECONDS\", 7800.0\n )\n _background_interaction_cost_polling_env: Final = os.getenv(\n     \"BACKGROUND_INTERACTION_COST_POLLING_ENABLED\", \"true\"\ndiff --git a/litellm/cost_calculator.py b/litellm/cost_calculator.py\nindex 03feb8dc1e69..927f37791fba 100644\n--- a/litellm/cost_calculator.py\n+++ b/litellm/cost_calculator.py\n@@ -126,6 +126,7 @@\n from litellm.types.agents import LiteLLMSendMessageResponse\n from litellm.types.decisions import DecisionsResponse, DecisionsUsage, OpenAIDecisionResponse, OpenAIDecisionUsage\n from litellm.types.extraction import ExtractionResponse, ExtractionUsage\n+from litellm.types.interactions import InteractionsAPIResponse\n from litellm.types.llms.base import CachedTokensDetails, LiteLLMBaseModel\n from litellm.types.llms.openai import (\n     HttpxBinaryResponseContent,\n@@ -1205,6 +1206,8 @@ def _get_response_model(completion_response: object) -> str | None:\n     if completion_response is None:\n         return None\n \n+    if isinstance(completion_response, InteractionsAPIResponse):\n+        return completion_response.model or completion_response.agent\n     if isinstance(completion_response, BaseModel):\n         return getattr(completion_response, \"model\", None)\n     elif isinstance(completion_response, dict):\ndiff --git a/litellm/interactions/main.py b/litellm/interactions/main.py\nindex cd144646f798..76c65f7041d2 100644\n--- a/litellm/interactions/main.py\n+++ b/litellm/interactions/main.py\n@@ -300,6 +300,26 @@ def create(\n             )\n         else:\n             custom_llm_provider = custom_llm_provider or \"gemini\"\n+        if agent and model and model != agent:\n+            raise litellm.BadRequestError(\n+                message=(\n+                    f\"agent '{agent}' can only run on a deployment of that agent, but the model is '{model}'. \"\n+                    \"Configure a deployment whose model is the agent and send its model group.\"\n+                ),\n+                model=model,\n+                llm_provider=custom_llm_provider,\n+            )\n+        if extra_body and (\n+            (\"agent\" in extra_body and extra_body[\"agent\"] != agent) or (agent and \"model\" in extra_body)\n+        ):\n+            raise litellm.BadRequestError(\n+                message=(\n+                    \"extra_body cannot set a different agent or add a model to an agent interaction. \"\n+                    \"Send the agent and model as top-level fields.\"\n+                ),\n+                model=model,\n+                llm_provider=custom_llm_provider,\n+            )\n \n         interactions_api_config: Final = get_provider_interactions_api_config(\n             provider=custom_llm_provider,\n@@ -340,7 +360,7 @@ def create(\n \n         litellm_logging_obj.update_from_kwargs(\n             kwargs=kwargs,\n-            model=model,\n+            model=agent or model,\n             optional_params=dict(optional_params),\n             litellm_params={\"litellm_call_id\": litellm_call_id},\n             custom_llm_provider=custom_llm_provider,\ndiff --git a/litellm/llms/gemini/interactions/transformation.py b/litellm/llms/gemini/interactions/transformation.py\nindex a02afa3a13fc..b9a2cc6493cf 100644\n--- a/litellm/llms/gemini/interactions/transformation.py\n+++ b/litellm/llms/gemini/interactions/transformation.py\n@@ -198,11 +198,10 @@ def transform_request(\n         \"\"\"\n         request_body: Final[dict[str, object]] = {}\n \n-        # Model or Agent (one required)\n-        if model:\n-            request_body[\"model\"] = GeminiModelInfo.get_base_model(model) or model\n-        elif agent:\n+        if agent:\n             request_body[\"agent\"] = agent\n+        elif model:\n+            request_body[\"model\"] = GeminiModelInfo.get_base_model(model) or model\n         else:\n             raise ValueError(\"Either 'model' or 'agent' must be provided\")\n \n@@ -225,7 +224,7 @@ def transform_request(\n         dropped_keys: Final = (\n             frozenset({\"agent_config\"})\n             if drops_unsupported_params(litellm_params.get(\"drop_params\"))\n-            and (model or not _has_agent_config_type(optional_params.get(\"agent_config\")))\n+            and (not agent or not _has_agent_config_type(optional_params.get(\"agent_config\")))\n             else frozenset()\n         )\n         for key in optional_keys:\ndiff --git a/litellm/model_prices_and_context_window_backup.json b/litellm/model_prices_and_context_window_backup.json\nindex e57abe994183..793c4ac8b4e9 100644\n--- a/litellm/model_prices_and_context_window_backup.json\n+++ b/litellm/model_prices_and_context_window_backup.json\n@@ -54503,6 +54503,20 @@\n         \"supports_web_search\": true,\n         \"web_search_billing_unit\": \"per_query\"\n     },\n+    \"vertex_ai/deep-research-preview-04-2026\": {\n+        \"cache_read_input_token_cost\": 2e-07,\n+        \"input_cost_per_token\": 2e-06,\n+        \"litellm_provider\": \"vertex_ai\",\n+        \"mode\": \"chat\",\n+        \"output_cost_per_token\": 1.2e-05,\n+        \"search_context_cost_per_query\": {\n+            \"search_context_size_low\": 0.014,\n+            \"search_context_size_medium\": 0.014,\n+            \"search_context_size_high\": 0.014\n+        },\n+        \"source\": \"https://cloud.google.com/model-garden/pricing\",\n+        \"web_search_billing_unit\": \"per_query\"\n+    },\n     \"vertex_ai/deep-research-pro-preview-12-2025\": {\n         \"cache_read_input_token_cost\": 2e-07,\n         \"cache_read_input_token_cost_batches\": 1e-07,\ndiff --git a/model_prices_and_context_window.json b/model_prices_and_context_window.json\nindex e57abe994183..793c4ac8b4e9 100644\n--- a/model_prices_and_context_window.json\n+++ b/model_prices_and_context_window.json\n@@ -54503,6 +54503,20 @@\n         \"supports_web_search\": true,\n         \"web_search_billing_unit\": \"per_query\"\n     },\n+    \"vertex_ai/deep-research-preview-04-2026\": {\n+        \"cache_read_input_token_cost\": 2e-07,\n+        \"input_cost_per_token\": 2e-06,\n+        \"litellm_provider\": \"vertex_ai\",\n+        \"mode\": \"chat\",\n+        \"output_cost_per_token\": 1.2e-05,\n+        \"search_context_cost_per_query\": {\n+            \"search_context_size_low\": 0.014,\n+            \"search_context_size_medium\": 0.014,\n+            \"search_context_size_high\": 0.014\n+        },\n+        \"source\": \"https://cloud.google.com/model-garden/pricing\",\n+        \"web_search_billing_unit\": \"per_query\"\n+    },\n     \"vertex_ai/deep-research-pro-preview-12-2025\": {\n         \"cache_read_input_token_cost\": 2e-07,\n         \"cache_read_input_token_cost_batches\": 1e-07,\n", "test_patch": "diff --git a/tests/unit/interactions/test_background_cost_polling.py b/tests/unit/interactions/test_background_cost_polling.py\nindex d55994dfb193..ac80f1dc4842 100644\n--- a/tests/unit/interactions/test_background_cost_polling.py\n+++ b/tests/unit/interactions/test_background_cost_polling.py\n@@ -3,7 +3,7 @@\n import time\n from datetime import datetime, timedelta, timezone\n from itertools import islice\n-from typing import Optional\n+from typing import Final, Optional\n \n import httpx\n import pytest\n@@ -21,11 +21,13 @@\n     poll_and_log_background_interaction_cost,\n     PollSchedule,\n     resume_unsettled_background_interactions,\n+    SettlementOutcome,\n )\n from litellm.litellm_core_utils.core_helpers import get_litellm_metadata_from_kwargs\n from litellm.litellm_core_utils.litellm_logging import Logging as LitellmLogging\n from litellm.proxy.spend_tracking.spend_tracking_utils import get_logging_payload\n from litellm.types.interactions import InteractionsAPIResponse\n+from tests._support.clock_loops import AutojumpClockLoop\n \n USAGE_BLOCK = {\n     \"total_tokens\": 175,\n@@ -1422,3 +1424,70 @@ async def test_create_on_a_replica_without_the_settlement_table_still_settles_in\n     task.cancel()\n     with pytest.raises(asyncio.CancelledError):\n         await task\n+\n+\n+class _JobFinishingAt:\n+    def __init__(self, finishes_at: float) -> None:\n+        self.finishes_at: Final = finishes_at\n+        self.last_polled_at: float | None = None\n+\n+    async def fetch(self, context: BackgroundInteractionPollContext) -> InteractionsAPIResponse:\n+        now: Final = asyncio.get_running_loop().time()\n+        self.last_polled_at = now\n+        finished: Final = now >= self.finishes_at\n+        return _response(\"completed\" if finished else \"in_progress\", with_usage=finished)\n+\n+\n+async def _finish_owned_loop_tasks() -> None:\n+    current: Final = asyncio.current_task()\n+    leftover: Final = tuple(task for task in asyncio.all_tasks() if task is not current)\n+    for task in leftover:\n+        task.cancel()\n+    await asyncio.gather(*leftover, return_exceptions=True)\n+\n+\n+def _poll_on_a_virtual_clock(\n+    context: BackgroundInteractionPollContext, job: _JobFinishingAt\n+) -> SettlementOutcome | None:\n+    loop: Final = AutojumpClockLoop()\n+    try:\n+        return loop.run_until_complete(poll_and_log_background_interaction_cost(context, fetch_interaction=job.fetch))\n+    finally:\n+        loop.run_until_complete(_finish_owned_loop_tasks())\n+        loop.run_until_complete(loop.shutdown_asyncgens())\n+        loop.run_until_complete(loop.shutdown_default_executor())\n+        loop.close()\n+\n+\n+_TWO_HOURS_SECONDS: Final = 7200.0\n+\n+\n+def test_a_background_job_that_runs_past_the_old_one_hour_window_settles_under_the_default_poll_window() -> None:\n+    logging_obj: Final = _logging_obj()\n+    job: Final = _JobFinishingAt(_TWO_HOURS_SECONDS)\n+    context: Final = BackgroundInteractionPollContext(\n+        interaction_id=\"interactions/bg-abc\", custom_llm_provider=\"gemini\", logging_obj=logging_obj\n+    )\n+\n+    outcome: Final = _poll_on_a_virtual_clock(context, job)\n+\n+    assert outcome == \"billed\"\n+    assert job.last_polled_at is not None and job.last_polled_at >= _TWO_HOURS_SECONDS\n+    assert logging_obj.model_call_details[\"response_cost\"] > 0\n+\n+\n+def test_an_explicit_shorter_poll_window_still_gives_up_before_a_job_that_outlasts_it() -> None:\n+    logging_obj: Final = _logging_obj()\n+    job: Final = _JobFinishingAt(_TWO_HOURS_SECONDS)\n+    context: Final = BackgroundInteractionPollContext(\n+        interaction_id=\"interactions/bg-abc\",\n+        custom_llm_provider=\"gemini\",\n+        logging_obj=logging_obj,\n+        timeout_seconds=3600.0,\n+    )\n+\n+    outcome: Final = _poll_on_a_virtual_clock(context, job)\n+\n+    assert outcome == \"unsettled\"\n+    assert job.last_polled_at is not None and job.last_polled_at <= 3600.0\n+    assert logging_obj.model_call_details.get(\"response_cost\") is None\ndiff --git a/tests/unit/interactions/test_main.py b/tests/unit/interactions/test_main.py\nindex cd32eb114853..9b448bbb1c6c 100644\n--- a/tests/unit/interactions/test_main.py\n+++ b/tests/unit/interactions/test_main.py\n@@ -1,3 +1,4 @@\n+import asyncio\n import base64\n import json\n from collections.abc import Mapping\n@@ -6,7 +7,8 @@\n \n import httpx\n import pytest\n-from pydantic import JsonValue, TypeAdapter\n+import responses\n+from pydantic import BaseModel, ConfigDict, JsonValue, TypeAdapter\n from respx import MockRouter\n \n import litellm\n@@ -96,6 +98,45 @@ def api_key():\n     return \"test-api-key\"\n \n \n+_GEMINI_INTERACTIONS_URL: Final = \"https://generativelanguage.googleapis.com/v1beta/interactions\"\n+_AGENT: Final = \"antigravity-preview-09-2026\"\n+_OTHER_AGENT: Final = \"deep-research-preview-04-2026\"\n+\n+_EXTRA_BODY_SELECTOR_OVERRIDES: Final = (\n+    pytest.param(\n+        {\"model\": f\"gemini/{_AGENT}\", \"agent\": _AGENT}, {\"agent\": _OTHER_AGENT}, id=\"matching-agent-nested-other-agent\"\n+    ),\n+    pytest.param({\"agent\": _AGENT}, {\"agent\": None}, id=\"agent-nested-null-agent\"),\n+    pytest.param({\"model\": \"gemini/gemini-4-argon\"}, {\"agent\": _AGENT}, id=\"model-nested-agent\"),\n+    pytest.param({\"agent\": _AGENT}, {\"model\": \"gemini-4-argon\"}, id=\"agent-nested-model\"),\n+    pytest.param({\"agent\": _AGENT}, {\"model\": _AGENT}, id=\"agent-nested-model-named-like-the-agent\"),\n+)\n+\n+_EXTRA_BODY_PASS_THROUGH: Final = (\n+    pytest.param(\n+        {\"agent\": _AGENT},\n+        {\"agent\": _AGENT, \"store\": False},\n+        {\"agent\": _AGENT, \"store\": False},\n+        id=\"same-agent-repeated\",\n+    ),\n+    pytest.param(\n+        {\"agent\": _AGENT}, {\"custom_flag\": 1}, {\"agent\": _AGENT, \"custom_flag\": 1}, id=\"agent-unrelated-extra\"\n+    ),\n+    pytest.param(\n+        {\"model\": \"gemini/gemini-4-argon\"},\n+        {\"custom_flag\": 1},\n+        {\"model\": \"gemini-4-argon\", \"custom_flag\": 1},\n+        id=\"model-unrelated-extra\",\n+    ),\n+    pytest.param(\n+        {\"model\": \"gemini/gemini-4-argon\"},\n+        {\"model\": \"gemini-4-carbon\"},\n+        {\"model\": \"gemini-4-carbon\"},\n+        id=\"model-only-nested-model\",\n+    ),\n+)\n+\n+\n class TestGoogleInteractionsCreate:\n     @pytest.mark.usefixtures(\"fake_provider_credentials\")\n     def test_missing_model_and_agent(self, api_key):\n@@ -305,6 +346,15 @@ def test_create_keeps_positional_response_settings_in_place(self, respx_mock: Mo\n                 },\n                 id=\"agent-keeps-an-object\",\n             ),\n+            pytest.param(\n+                {\"model\": \"gemini/antigravity-preview-09-2026\", \"agent\": \"antigravity-preview-09-2026\"},\n+                {\"type\": \"antigravity\", \"model\": \"gemini-3.8-flash\"},\n+                {\n+                    \"agent\": \"antigravity-preview-09-2026\",\n+                    \"agent_config\": {\"type\": \"antigravity\", \"model\": \"gemini-3.8-flash\"},\n+                },\n+                id=\"matching-model-and-agent-sends-the-agent-with-its-config\",\n+            ),\n             pytest.param(\n                 {\"agent\": \"antigravity-preview-09-2026\"},\n                 \"antigravity\",\n@@ -347,6 +397,45 @@ def test_create_with_drop_params_drops_agent_config_gemini_cannot_take(\n \n         assert json.loads(route.calls.last.request.content) == {**expected_target, \"input\": \"Say hi in one word.\"}\n \n+    @pytest.mark.usefixtures(\"fake_provider_credentials\")\n+    def test_create_refuses_an_agent_with_another_model_before_any_http_call(self, respx_mock: MockRouter) -> None:\n+        with pytest.raises(litellm.BadRequestError, match=\"antigravity-preview-09-2026\"):\n+            interactions.create(\n+                model=\"gemini/gemini-2.5-flash\",\n+                agent=\"antigravity-preview-09-2026\",\n+                input=\"Say hi in one word.\",\n+                api_key=\"gemini-offline\",\n+            )\n+\n+        assert not respx_mock.calls\n+\n+    @pytest.mark.parametrize((\"target\", \"extra_body\"), _EXTRA_BODY_SELECTOR_OVERRIDES)\n+    @pytest.mark.usefixtures(\"fake_provider_credentials\")\n+    def test_create_refuses_extra_body_that_changes_the_agent_or_model_before_any_http_call(\n+        self, respx_mock: MockRouter, target: Mapping[str, str], extra_body: Mapping[str, object]\n+    ) -> None:\n+        with pytest.raises(litellm.BadRequestError, match=\"extra_body\"):\n+            interactions.create(**target, input=\"Say hi in one word.\", extra_body=extra_body, api_key=\"gemini-offline\")\n+\n+        assert not respx_mock.calls\n+\n+    @pytest.mark.parametrize((\"target\", \"extra_body\", \"expected_target\"), _EXTRA_BODY_PASS_THROUGH)\n+    @pytest.mark.usefixtures(\"fake_provider_credentials\")\n+    def test_create_sends_extra_body_that_keeps_the_agent_and_model(\n+        self,\n+        respx_mock: MockRouter,\n+        target: Mapping[str, str],\n+        extra_body: Mapping[str, object],\n+        expected_target: Mapping[str, object],\n+    ) -> None:\n+        route: Final = respx_mock.post(_GEMINI_INTERACTIONS_URL).mock(\n+            return_value=httpx.Response(200, json={\"id\": \"interaction-extra\", \"status\": \"completed\"})\n+        )\n+\n+        interactions.create(**target, input=\"Say hi in one word.\", extra_body=extra_body, api_key=\"gemini-offline\")\n+\n+        assert json.loads(route.calls.last.request.content) == {**expected_target, \"input\": \"Say hi in one word.\"}\n+\n     @pytest.mark.usefixtures(\"fake_provider_credentials\")\n     def test_create_rejects_agent_config_a_bridged_provider_cannot_take(self, respx_mock: MockRouter) -> None:\n         route: Final = respx_mock.post(\"https://api.openai.com/v1/responses\").mock(\n@@ -494,6 +583,39 @@ class TestInteractionsAcreateOffline:\n     def _httpx_only_transport(self, monkeypatch: pytest.MonkeyPatch) -> None:\n         monkeypatch.setenv(\"DISABLE_AIOHTTP_TRANSPORT\", \"True\")\n \n+    @pytest.mark.parametrize((\"target\", \"extra_body\"), _EXTRA_BODY_SELECTOR_OVERRIDES)\n+    @pytest.mark.usefixtures(\"fake_provider_credentials\")\n+    @pytest.mark.asyncio\n+    async def test_acreate_refuses_extra_body_that_changes_the_agent_or_model_before_any_http_call(\n+        self, respx_mock: MockRouter, target: Mapping[str, str], extra_body: Mapping[str, object]\n+    ) -> None:\n+        with pytest.raises(litellm.BadRequestError, match=\"extra_body\"):\n+            await interactions.acreate(\n+                **target, input=\"Say hi in one word.\", extra_body=extra_body, api_key=\"gemini-offline\"\n+            )\n+\n+        assert not respx_mock.calls\n+\n+    @pytest.mark.parametrize((\"target\", \"extra_body\", \"expected_target\"), _EXTRA_BODY_PASS_THROUGH)\n+    @pytest.mark.usefixtures(\"fake_provider_credentials\")\n+    @pytest.mark.asyncio\n+    async def test_acreate_sends_extra_body_that_keeps_the_agent_and_model(\n+        self,\n+        respx_mock: MockRouter,\n+        target: Mapping[str, str],\n+        extra_body: Mapping[str, object],\n+        expected_target: Mapping[str, object],\n+    ) -> None:\n+        route: Final = respx_mock.post(_GEMINI_INTERACTIONS_URL).mock(\n+            return_value=httpx.Response(200, json={\"id\": \"interaction-extra\", \"status\": \"completed\"})\n+        )\n+\n+        await interactions.acreate(\n+            **target, input=\"Say hi in one word.\", extra_body=extra_body, api_key=\"gemini-offline\"\n+        )\n+\n+        assert json.loads(route.calls.last.request.content) == {**expected_target, \"input\": \"Say hi in one word.\"}\n+\n     @pytest.mark.usefixtures(\"fake_provider_credentials\")\n     @pytest.mark.asyncio\n     async def test_acreate_simple_gemini(self, respx_mock: MockRouter) -> None:\n@@ -922,3 +1044,134 @@ def test_create_sends_a_caller_continuation_token_to_resume_a_long_decode(respx_\n     }, sent\n     assert response.status == \"completed\"\n     assert response.continuation_token is None\n+\n+\n+_DEEP_RESEARCH_AGENT: Final = \"deep-research-preview-04-2026\"\n+_DEEP_RESEARCH_USAGE: Final = {\n+    \"total_input_tokens\": 1000,\n+    \"total_cached_tokens\": 200,\n+    \"total_output_tokens\": 300,\n+    \"total_thought_tokens\": 100,\n+    \"total_tokens\": 1400,\n+    \"input_tokens_by_modality\": [{\"modality\": \"text\", \"tokens\": 1000}],\n+    \"output_tokens_by_modality\": [{\"modality\": \"text\", \"tokens\": 300}],\n+    \"grounding_tool_count\": [{\"type\": \"google_search\", \"count\": 3}],\n+}\n+\n+\n+def _deep_research_cost_from_the_vertex_row() -> float:\n+    row: Final = litellm.model_cost[f\"vertex_ai/{_DEEP_RESEARCH_AGENT}\"]\n+    return (\n+        (1000 - 200) * row[\"input_cost_per_token\"]\n+        + 200 * row[\"cache_read_input_token_cost\"]\n+        + (300 + 100) * row[\"output_cost_per_token\"]\n+        + 3 * row[\"search_context_cost_per_query\"][\"search_context_size_medium\"]\n+    )\n+\n+\n+class _LoggedModelMapValue(BaseModel):\n+    model_config = ConfigDict(frozen=True, extra=\"ignore\")\n+\n+    key: str\n+\n+\n+class _LoggedModelMap(BaseModel):\n+    model_config = ConfigDict(frozen=True, extra=\"ignore\")\n+\n+    model_map_value: _LoggedModelMapValue\n+\n+\n+class _LoggedModel(BaseModel):\n+    model_config = ConfigDict(frozen=True, extra=\"ignore\")\n+\n+    model: str\n+    model_map_information: _LoggedModelMap\n+\n+\n+class _LoggedCost(BaseModel):\n+    model_config = ConfigDict(frozen=True, extra=\"ignore\")\n+\n+    response_cost: float\n+    standard_logging_object: _LoggedModel\n+\n+\n+class _CostRecorder(CustomLogger):\n+    def __init__(self) -> None:\n+        super().__init__()\n+        self.logged: Final = asyncio.Event()\n+        self.cost: _LoggedCost | None = None\n+\n+    async def async_log_success_event(\n+        self, kwargs: Mapping[str, object], response_obj: object, start_time: object, end_time: object\n+    ) -> None:\n+        self.cost = _LoggedCost.model_validate(kwargs)\n+        self.logged.set()\n+\n+\n+_DEEP_RESEARCH_INTERACTION: Final = {\n+    \"id\": \"interaction-dr\",\n+    \"object\": \"interaction\",\n+    \"agent\": _DEEP_RESEARCH_AGENT,\n+    \"status\": \"completed\",\n+    \"usage\": _DEEP_RESEARCH_USAGE,\n+}\n+_DEEP_RESEARCH_URL: Final = (\n+    \"https://aiplatform.googleapis.com/v1beta1/projects/dr-project/locations/global/interactions\"\n+)\n+\n+\n+def _deep_research_reply(stream: bool) -> httpx.Response:\n+    if not stream:\n+        return httpx.Response(200, json=_DEEP_RESEARCH_INTERACTION)\n+    completed: Final = json.dumps({\"event_type\": \"interaction.completed\", \"interaction\": _DEEP_RESEARCH_INTERACTION})\n+    return httpx.Response(200, text=f\"data: {completed}\\n\\n\", headers={\"content-type\": \"text/event-stream\"})\n+\n+\n+@pytest.mark.parametrize(\"stream\", [False, True], ids=[\"background-or-foreground\", \"streamed\"])\n+@pytest.mark.asyncio\n+async def test_an_agent_only_vertex_deep_research_interaction_is_billed_under_the_agent_row(\n+    respx_mock: MockRouter, monkeypatch: pytest.MonkeyPatch, stream: bool\n+) -> None:\n+    recorder: Final = _CostRecorder()\n+    monkeypatch.setattr(litellm, \"callbacks\", [recorder])\n+    monkeypatch.setattr(litellm, \"disable_aiohttp_transport\", True)\n+    route: Final = respx_mock.post(f\"{_DEEP_RESEARCH_URL}?alt=sse\" if stream else _DEEP_RESEARCH_URL).mock(\n+        return_value=_deep_research_reply(stream)\n+    )\n+    credentials: Final = {\n+        \"type\": \"authorized_user\",\n+        \"client_id\": \"dr-client\",\n+        \"client_secret\": \"dr-secret\",\n+        \"refresh_token\": \"dr-refresh-token\",\n+    }\n+\n+    with responses.RequestsMock(assert_all_requests_are_fired=False) as google_oauth:\n+        google_oauth.post(\n+            \"https://oauth2.googleapis.com/token\",\n+            json={\"access_token\": \"dr-token\", \"expires_in\": 3600, \"token_type\": \"Bearer\"},\n+        )\n+        response: Final = await interactions.acreate(\n+            agent=_DEEP_RESEARCH_AGENT,\n+            input=\"Compare grid-scale storage options.\",\n+            custom_llm_provider=\"vertex_ai\",\n+            vertex_project=\"dr-project\",\n+            vertex_location=\"global\",\n+            vertex_credentials=json.dumps(credentials),\n+            stream=stream,\n+        )\n+        if stream:\n+            async for _ in response:\n+                pass\n+        await asyncio.wait_for(recorder.logged.wait(), timeout=10)\n+\n+    assert json.loads(route.calls.last.request.content) == {\n+        \"agent\": _DEEP_RESEARCH_AGENT,\n+        \"input\": \"Compare grid-scale storage options.\",\n+        \"stream\": stream,\n+    }\n+    assert recorder.cost is not None\n+    assert recorder.cost.standard_logging_object.model == _DEEP_RESEARCH_AGENT\n+    assert recorder.cost.standard_logging_object.model_map_information.model_map_value.key == (\n+        f\"vertex_ai/{_DEEP_RESEARCH_AGENT}\"\n+    )\n+    assert recorder.cost.response_cost == pytest.approx(_deep_research_cost_from_the_vertex_row())\ndiff --git a/tests/unit/proxy/google_endpoints/test_endpoints.py b/tests/unit/proxy/google_endpoints/test_endpoints.py\nindex e6df7bf1d4f8..ef7933917886 100644\n--- a/tests/unit/proxy/google_endpoints/test_endpoints.py\n+++ b/tests/unit/proxy/google_endpoints/test_endpoints.py\n@@ -425,6 +425,208 @@ def test_interaction_by_id_naming_a_model_the_key_cannot_call_is_refused_before_\n     assert not respx_mock.calls\n \n \n+_DEEP_RESEARCH_USAGE: Final = {\n+    \"total_input_tokens\": 1000,\n+    \"total_cached_tokens\": 200,\n+    \"total_output_tokens\": 300,\n+    \"total_thought_tokens\": 100,\n+    \"total_tokens\": 1400,\n+    \"input_tokens_by_modality\": [{\"modality\": \"text\", \"tokens\": 1000}],\n+    \"output_tokens_by_modality\": [{\"modality\": \"text\", \"tokens\": 300}],\n+    \"grounding_tool_count\": [{\"type\": \"google_search\", \"count\": 3}],\n+}\n+\n+\n+def _deep_research_cost_from_the_vertex_row() -> float:\n+    row: Final = litellm.model_cost[f\"vertex_ai/{_DEEP_RESEARCH_AGENT}\"]\n+    return (\n+        (1000 - 200) * row[\"input_cost_per_token\"]\n+        + 200 * row[\"cache_read_input_token_cost\"]\n+        + (300 + 100) * row[\"output_cost_per_token\"]\n+        + 3 * row[\"search_context_cost_per_query\"][\"search_context_size_medium\"]\n+    )\n+\n+\n+def _deep_research_create(model_group: str) -> Mapping[str, str]:\n+    return {\"model\": model_group, \"agent\": _DEEP_RESEARCH_AGENT, \"input\": \"Compare grid-scale storage options.\"}\n+\n+\n+def _completed_deep_research(respx_mock: respx.MockRouter) -> respx.Route:\n+    return respx_mock.post(_VERTEX_COLLECTION_URL).mock(\n+        return_value=httpx.Response(\n+            200,\n+            json={\n+                \"id\": _INTERACTION_ID,\n+                \"object\": \"interaction\",\n+                \"agent\": _DEEP_RESEARCH_AGENT,\n+                \"status\": \"completed\",\n+                \"usage\": _DEEP_RESEARCH_USAGE,\n+            },\n+        )\n+    )\n+\n+\n+def test_routed_create_with_an_agent_sends_the_agent_with_the_deployment_credentials_and_bills_the_agent(\n+    interactions_proxy: TestClient, respx_mock: respx.MockRouter\n+) -> None:\n+    upstream: Final = _completed_deep_research(respx_mock)\n+\n+    response: Final = interactions_proxy.post(\n+        \"/v1beta/interactions\", json=_deep_research_create(_VERTEX_DEEP_RESEARCH_GROUP)\n+    )\n+\n+    assert response.status_code == 200, response.text\n+    assert json.loads(upstream.calls.last.request.content) == {\n+        \"agent\": _DEEP_RESEARCH_AGENT,\n+        \"input\": \"Compare grid-scale storage options.\",\n+    }\n+    assert upstream.calls.last.request.headers[\"authorization\"] == \"Bearer deployment-token\"\n+    assert float(response.headers[\"x-litellm-response-cost\"]) == pytest.approx(\n+        _deep_research_cost_from_the_vertex_row()\n+    )\n+\n+\n+def test_routed_create_with_an_agent_on_another_models_deployment_is_refused_before_any_upstream_call(\n+    interactions_proxy: TestClient, respx_mock: respx.MockRouter, google_oauth: responses.RequestsMock\n+) -> None:\n+    response: Final = interactions_proxy.post(\"/v1beta/interactions\", json=_deep_research_create(_VERTEX_GROUP))\n+\n+    assert response.status_code == 400, response.text\n+    assert _DEEP_RESEARCH_AGENT in response.text\n+    assert not respx_mock.calls\n+    assert not google_oauth.calls\n+\n+\n+@pytest.mark.parametrize(\n+    \"create\",\n+    (\n+        pytest.param(\n+            {**_deep_research_create(_VERTEX_DEEP_RESEARCH_GROUP), \"extra_body\": {\"agent\": \"other-agent\"}},\n+            id=\"nested-other-agent\",\n+        ),\n+        pytest.param(\n+            {**_deep_research_create(_VERTEX_DEEP_RESEARCH_GROUP), \"extra_body\": {\"model\": \"gemini-4-argon\"}},\n+            id=\"nested-model-beside-the-agent\",\n+        ),\n+        pytest.param(\n+            {\n+                \"model\": _VERTEX_GROUP,\n+                \"input\": \"Compare grid-scale storage options.\",\n+                \"extra_body\": {\"agent\": _DEEP_RESEARCH_AGENT},\n+            },\n+            id=\"nested-agent-on-a-model-deployment\",\n+        ),\n+    ),\n+)\n+def test_routed_create_with_extra_body_that_changes_the_agent_or_model_is_refused_before_any_upstream_call(\n+    interactions_proxy: TestClient,\n+    respx_mock: respx.MockRouter,\n+    google_oauth: responses.RequestsMock,\n+    create: Mapping[str, object],\n+) -> None:\n+    response: Final = interactions_proxy.post(\"/v1beta/interactions\", json=create)\n+\n+    assert response.status_code == 400, response.text\n+    assert \"extra_body\" in response.text\n+    assert not respx_mock.calls\n+    assert not google_oauth.calls\n+\n+\n+def test_routed_create_with_extra_body_repeating_the_agent_sends_it_once_with_the_other_extras(\n+    interactions_proxy: TestClient, respx_mock: respx.MockRouter\n+) -> None:\n+    upstream: Final = _completed_deep_research(respx_mock)\n+\n+    response: Final = interactions_proxy.post(\n+        \"/v1beta/interactions\",\n+        json={\n+            **_deep_research_create(_VERTEX_DEEP_RESEARCH_GROUP),\n+            \"extra_body\": {\"agent\": _DEEP_RESEARCH_AGENT, \"custom_flag\": 1},\n+        },\n+    )\n+\n+    assert response.status_code == 200, response.text\n+    assert json.loads(upstream.calls.last.request.content) == {\n+        \"agent\": _DEEP_RESEARCH_AGENT,\n+        \"input\": \"Compare grid-scale storage options.\",\n+        \"custom_flag\": 1,\n+    }\n+\n+\n+def test_a_key_allowed_the_agent_deployment_runs_the_agent(\n+    interactions_proxy: TestClient, respx_mock: respx.MockRouter\n+) -> None:\n+    upstream: Final = _completed_deep_research(respx_mock)\n+\n+    with _cached_key(UserAPIKeyAuth(models=[_VERTEX_DEEP_RESEARCH_GROUP])) as authorization:\n+        response: Final = interactions_proxy.post(\n+            \"/v1beta/interactions\",\n+            json=_deep_research_create(_VERTEX_DEEP_RESEARCH_GROUP),\n+            headers={\"authorization\": authorization},\n+        )\n+\n+    assert response.status_code == 200, response.text\n+    assert json.loads(upstream.calls.last.request.content)[\"agent\"] == _DEEP_RESEARCH_AGENT\n+\n+\n+@pytest.mark.parametrize(\n+    (\"key\", \"teams\", \"model_group\", \"status_code\"),\n+    (\n+        pytest.param(\n+            UserAPIKeyAuth(models=[_VERTEX_GROUP]), (), _VERTEX_GROUP, 400, id=\"own-group-cannot-run-another-agent\"\n+        ),\n+        pytest.param(\n+            UserAPIKeyAuth(models=[_VERTEX_GROUP]), (), _VERTEX_DEEP_RESEARCH_GROUP, 403, id=\"agent-group-not-on-key\"\n+        ),\n+        pytest.param(\n+            UserAPIKeyAuth(models=[_VERTEX_DEEP_RESEARCH_GROUP]),\n+            (),\n+            _VERTEX_GROUP,\n+            403,\n+            id=\"other-group-not-on-key\",\n+        ),\n+        pytest.param(\n+            UserAPIKeyAuth(team_id=\"team-without-deep-research\"),\n+            (LiteLLM_TeamTableCachedObj(team_id=\"team-without-deep-research\", models=[_VERTEX_GROUP]),),\n+            _VERTEX_DEEP_RESEARCH_GROUP,\n+            403,\n+            id=\"agent-group-not-on-team\",\n+        ),\n+    ),\n+)\n+def test_a_restricted_key_cannot_run_an_agent_it_was_not_given_the_deployment_for(\n+    interactions_proxy: TestClient,\n+    respx_mock: respx.MockRouter,\n+    google_oauth: responses.RequestsMock,\n+    key: UserAPIKeyAuth,\n+    teams: tuple[LiteLLM_TeamTableCachedObj, ...],\n+    model_group: str,\n+    status_code: int,\n+) -> None:\n+    with _cached_key(key, *teams) as authorization:\n+        response: Final = interactions_proxy.post(\n+            \"/v1beta/interactions\", json=_deep_research_create(model_group), headers={\"authorization\": authorization}\n+        )\n+\n+    assert response.status_code == status_code, response.text\n+    assert not respx_mock.calls\n+    assert not google_oauth.calls\n+\n+\n+def test_routed_create_without_an_agent_still_sends_the_deployment_model(\n+    interactions_proxy: TestClient, respx_mock: respx.MockRouter\n+) -> None:\n+    upstream: Final = respx_mock.post(_VERTEX_COLLECTION_URL).mock(\n+        return_value=httpx.Response(200, json={\"id\": _INTERACTION_ID, \"object\": \"interaction\", \"status\": \"completed\"})\n+    )\n+\n+    response: Final = interactions_proxy.post(\"/v1beta/interactions\", json={\"model\": _VERTEX_GROUP, \"input\": \"Hi\"})\n+\n+    assert response.status_code == 200, response.text\n+    assert json.loads(upstream.calls.last.request.content) == {\"model\": \"gemini-4-argon\", \"input\": \"Hi\"}\n+    assert upstream.calls.last.request.headers[\"authorization\"] == \"Bearer deployment-token\"\n+\n+\n def _project_url(project: str) -> str:\n     return f\"https://aiplatform.googleapis.com/v1beta1/projects/{project}/locations/global/interactions\"\n \ndiff --git a/tests/unit/test_cost_calculator.py b/tests/unit/test_cost_calculator.py\nindex 237487908691..10ab0cd25f54 100644\n--- a/tests/unit/test_cost_calculator.py\n+++ b/tests/unit/test_cost_calculator.py\n@@ -5250,6 +5250,37 @@ def test_completion_cost_bills_interactions_google_search_per_query():\n     assert cost > 3 * per_query_cost\n \n \n+def test_completion_cost_bills_an_agent_interaction_at_its_agent_row():\n+    from litellm.types.interactions import InteractionsAPIResponse\n+\n+    agent: Final = \"deep-research-preview-04-2026\"\n+    model_info: Final = litellm.get_model_info(model=agent, custom_llm_provider=\"vertex_ai\")\n+    response: Final = InteractionsAPIResponse(\n+        id=\"interactions/agent123\",\n+        agent=agent,\n+        status=\"completed\",\n+        usage={\n+            \"total_input_tokens\": 1000,\n+            \"input_tokens_by_modality\": [{\"modality\": \"text\", \"tokens\": 1000}],\n+            \"total_cached_tokens\": 200,\n+            \"total_output_tokens\": 300,\n+            \"output_tokens_by_modality\": [{\"modality\": \"text\", \"tokens\": 300}],\n+            \"total_thought_tokens\": 100,\n+            \"grounding_tool_count\": [{\"type\": \"google_search\", \"count\": 3}],\n+        },\n+    )\n+\n+    cost: Final = completion_cost(completion_response=response, custom_llm_provider=\"vertex_ai\")\n+\n+    assert model_info[\"key\"] == f\"vertex_ai/{agent}\"\n+    assert cost == pytest.approx(\n+        800 * model_info[\"input_cost_per_token\"]\n+        + 200 * model_info[\"cache_read_input_token_cost\"]\n+        + 400 * model_info[\"output_cost_per_token\"]\n+        + 3 * model_info[\"search_context_cost_per_query\"][\"search_context_size_medium\"]\n+    )\n+\n+\n def test_completion_cost_bills_interactions_video_output_at_video_rate():\n     from litellm.types.interactions import InteractionsAPIResponse\n \n", "problem_statement": "[Bug]: Interactions API on vertex_ai deployments: by-id GET/DELETE/cancel hard-coded to gemini, Vertex cancel uses `:cancel`, Deep Research cost-map and poll-timeout gaps\n### Description\n\nThrough the proxy, Google's Interactions API works end to end only for Google AI Studio (`gemini`). Native `vertex_ai` Interactions landed in #38229, but several pieces are still missing on the Vertex side. Some of them matter most for long-running jobs such as Google's Deep Research agent (`deep-research-preview-04-2026`, in Preview on Vertex AI since 2026-05-26). Most appear only as caveats in merged PRs, no issue tracks the Vertex gaps, and the Interactions docs don't mention them. Everything below was checked on **v1.106.6** (latest stable) and **origin/main `a2d27881e8`** (2026-11-02).\n\n**1. The by-id routes always use `gemini`.** `GET /v1beta/interactions/{id}`, `DELETE /v1beta/interactions/{id}` and `POST /v1beta/interactions/{id}/cancel` hard-code the provider to `gemini`:\n- `litellm/proxy/google_endpoints/endpoints.py`, lines 519/587/655 on main\n- the same file, lines 455/523/591 on v1.106.6\n\nSo a job created on a `vertex_ai` deployment can't be polled, deleted or cancelled through the proxy. The call goes to the Google AI Studio base URL instead, or fails with \"Google API key is required\" if no AI Studio key is configured.\n- This was noted in the caveats of #38229: \"Proxy by-id GET/DELETE/cancel routes still assume the gemini provider\".\n- Open PR #41375 would make these routes provider-selectable, but it targets Anthropic sessions.\n\n**2. Vertex cancel uses an off-spec path.** `litellm/llms/vertex_ai/interactions/transformation.py:149` sends `url_suffix=\":cancel\"` on every ref I checked. Google documents `POST .../interactions/{id}/cancel`.\n- #46240 also moved the Gemini route to `/cancel`, on main, v1.108.0-rc.1 and v1.109.0-dev.x. Its caveats say \"Vertex AI interactions still cancel at `{id}:cancel`\".\n- On v1.106.x, the Gemini route still sends `:cancel` too (see Steps to Repro).\n\n**3. Pricing and settlement gaps for Deep Research jobs on Vertex.**\n- a. No cost-map row exists for `vertex_ai/deep-research-preview-04-2026`.\n  - #42833 added only `gemini/` rows for the 04-2026 agents, and calls their prices placeholders.\n  - The only Vertex-provider deep-research rows (`vertex_ai/deep-research-pro-preview-12-2025` and the bare `deep-research-pro-preview-12-2025`, both `vertex_ai-language-models`) are for the 12-2025 agent, which Google shut down on 2026-10-23.\n  - Vertex bills the 04-2026 agent at $2 / $0.20 cached / $12 per 1M tokens on Standard, and $1 / $0.10 / $6 on Deferred. Grounding queries cost $14 per 1,000 after 5,000 free per month.\n- b. The background cost poll gives up after `BACKGROUND_INTERACTION_COST_POLL_TIMEOUT_SECONDS` = 3600 (`constants.py` main:1971-1973). Vertex allows Deep Research runs of up to 120 minutes, so long jobs end unsettled. #33310 notes: \"A poll still non-terminal at the one-hour timeout leaves that interaction unbilled\".\n- c. Before #45743, the background cost poll couldn't read jobs on a Vertex deployment with that deployment's own project or credentials, so those jobs never settled. #45743 is on main and v1.109.0-dev.x only, not in any stable release.\n- d. Google's spec added a `requires_continuation` status; the spec canary in #49038 has been red since 10-29. Per open PR #49266, a background job that ends in that status is polled until the timeout and never settles.\n\n**4. `agent_config` on older lines.** v1.106.x and v1.108.0-rc.1 drop `agent_config`. #48750 forwards it on main and v1.109.0-dev.2, and Vertex inherits that. Its intentional `drop_params` behaviour is unchanged.\n\n**5. Docs.**\n- https://docs.litellm.ai/docs/interactions has no Vertex section, no `background`, delete or cancel, and no per-provider limitations. `vertex_ai` appears only in the generic table of bridged chat providers.\n- The managed agents page and the 2026-05-19 managed-agents blog post say the `agent` param is Gemini-only, but the main Interactions page doesn't.\n- The Vertex and Gemini provider pages have no Interactions or Deep Research section.\n\n**Expected:**\n- An Interactions job created on a `vertex_ai` deployment can be polled, cancelled and deleted through the proxy with that deployment's credentials.\n- Vertex cancel uses `/cancel`.\n- Deep Research jobs on Vertex have cost-map rows, and they settle even when they run longer than an hour.\n- The Interactions docs say what each provider supports.\n\nHappy to test a fix against a Vertex deployment.\n\n### Config\n\nThe by-id routing below was reproduced with a stub upstream rather than a real provider:\n\n```yaml\n# config.yaml\nmodel_list:\n  - model_name: gemini-2.5-flash\n    litellm_params:\n      model: gemini/gemini-2.5-flash\ngeneral_settings:\n  master_key: sk-local-master-0000\n# environment: GEMINI_API_KEY=<any>, GEMINI_API_BASE=http://mock:8080 (a stub that logs each request it receives)\n```\n\nThe Vertex-side items were found by reading the code with a deployment like this one:\n\n```yaml\nmodel_list:\n  - model_name: gemini-4-argon\n    litellm_params:\n      model: vertex_ai/gemini-4-argon\n      vertex_project: <project>\n      vertex_location: global\n```\n\n### LiteLLM Version\n\nv1.106.6 (`ghcr.io/berriai/litellm-database@sha256:7ef0e78fe00ad5ea7ea45666cc1d1f02cb7076aee69091543bf397de52db33ce`). Also checked v1.106.2, v1.108.0-rc.1, v1.109.0-dev.2 and origin/main a2d27881e8.\n\n### Steps to Repro\n\nOn v1.106.6 with the config above:\n\n```\n$ curl -X GET    http://localhost:4000/v1beta/interactions/abc123        -H \"Authorization: Bearer sk-local-master-0000\"\nHTTP 200   stub received: GET /v1beta/interactions/abc123\n$ curl -X DELETE http://localhost:4000/v1beta/interactions/abc123        -H \"Authorization: Bearer sk-local-master-0000\"\nHTTP 200   stub received: DELETE /v1beta/interactions/abc123\n$ curl -X POST   http://localhost:4000/v1beta/interactions/abc123/cancel -H \"Authorization: Bearer sk-local-master-0000\"\nHTTP 200   stub received: POST /v1beta/interactions/abc123:cancel\n```\n\n- Every by-id call goes to the AI Studio base (`GEMINI_API_BASE`), whichever provider created the job, because the proxy hard-codes `gemini` (item 1).\n- On v1.106.x, cancel is sent as `:cancel` rather than `/cancel` (item 2).\n- I can't show items 1\u20133 against Vertex without a live Vertex job. They come from reading the code at the refs above.\n\n### Which part of LiteLLM is this about?\n\nLLM translation: a specific provider's request or response\n\n### How are you deploying?\n\nDocker\n\n", "hints_text": "", "created_at": "2026-11-13T01:43:47Z"}
{"repo": "BerriAI/litellm", "pull_number": 51502, "instance_id": "BerriAI__litellm-51502", "issue_numbers": ["51396"], "base_commit": "b304dcfe94541b6c6fbbecde94dbb8bb97d94c6c", "patch": "diff --git a/litellm/router_rust/core.py b/litellm/router_rust/core.py\nindex 8d5778b8a634..fbb07ea75537 100644\n--- a/litellm/router_rust/core.py\n+++ b/litellm/router_rust/core.py\n@@ -29,9 +29,9 @@\n from time import perf_counter\n from time import time as unix_time\n from types import MappingProxyType\n-from typing import TYPE_CHECKING, Final, Literal, Protocol, TypeAlias, TypeVar, final, overload\n+from typing import TYPE_CHECKING, Annotated, Final, Literal, Protocol, TypeAlias, TypeVar, final, overload\n \n-from pydantic import TypeAdapter\n+from pydantic import BaseModel, ConfigDict, Field, TypeAdapter, ValidationError, field_validator, model_validator\n \n from litellm._internal_context import service_target\n from litellm.constants import DEFAULT_COOLDOWN_TIME_SECONDS, HEALTH_CHECKS_TARGET\n@@ -1007,10 +1007,6 @@ def _listing_team_id(request: Mapping[str, object]) -> str | None:\n     return team_id if isinstance(team_id, str) else None\n \n \n-# Request fallback settings, which replace the router's for the call.\n-_REQUEST_FALLBACK_KEYS: Final = (\"fallbacks\", \"context_window_fallbacks\", \"content_policy_fallbacks\", \"max_fallbacks\")\n-\n-\n def _strings(value: object) -> \"tuple[str, ...]\":\n     \"\"\"Every string in ``value``, a name or a fallback list of names and dict entries.\"\"\"\n     if isinstance(value, str):\n@@ -1018,7 +1014,7 @@ def _strings(value: object) -> \"tuple[str, ...]\":\n     if isinstance(value, Mapping):\n         entries: Final[Mapping[object, object]] = value  # pyright: ignore[reportUnknownVariableType]  # read as objects\n         return tuple(itertools.chain.from_iterable(map(_strings, itertools.chain.from_iterable(entries.items()))))\n-    if isinstance(value, list | tuple):\n+    if isinstance(value, Sequence):\n         items: Final[Sequence[object]] = value  # pyright: ignore[reportUnknownVariableType]  # see above\n         return tuple(itertools.chain.from_iterable(map(_strings, items)))  # pyright: ignore[reportUnknownArgumentType]  # read as objects\n     return ()\n@@ -1030,31 +1026,82 @@ def _routed_model(request: Mapping[str, object]) -> object:\n     return model if model is None or isinstance(model, str) else str(model)\n \n \n+class RequestStartFields(BaseModel):\n+    model_config = ConfigDict(frozen=True)\n+\n+    fallbacks: Sequence[str | Mapping[str, object]] | None = None\n+    context_window_fallbacks: Sequence[str | Mapping[str, object]] | None = None\n+    content_policy_fallbacks: Sequence[str | Mapping[str, object]] | None = None\n+    max_fallbacks: Annotated[int, Field(ge=0, le=_U32_MAX)] | None = None\n+    specific_deployment: bool = False\n+    disable_fallbacks: bool = False\n+    cooldown_time: object | None = None\n+    router_weights: object | None = Field(default=None, validation_alias=\"_router_weights\")\n+    team_id: str | None = None\n+    listing_team_id: str | None = None\n+    routing_strategy: str | None = None\n+\n+    @model_validator(mode=\"before\")\n+    @classmethod\n+    def ignore_standalone_fallback_strings(cls, value: object) -> object:\n+        request_fields: Final = as_str_mapping(value)\n+        if request_fields is None:\n+            return value\n+        return {\n+            key: item\n+            for key, item in request_fields.items()\n+            if key not in (\"fallbacks\", \"context_window_fallbacks\", \"content_policy_fallbacks\")\n+            or not isinstance(item, str)\n+        }\n+\n+    @field_validator(\"specific_deployment\", \"disable_fallbacks\", mode=\"before\")\n+    @classmethod\n+    def literal_true_only(cls, value: object) -> bool:\n+        return value is True\n+\n+\n+def _request_start_fields(request: Mapping[str, object]) -> RequestStartFields:\n+    strategy: Final = request.get(\"routing_strategy\")\n+    override: Final = normalize_strategy(strategy) if isinstance(strategy, str | RoutingStrategy) else None\n+    fields: Final = {\n+        **request,\n+        \"team_id\": get_request_team_id(request),\n+        \"listing_team_id\": _listing_team_id(request),\n+        \"routing_strategy\": override,\n+    }\n+    try:\n+        return RequestStartFields.model_validate(fields)\n+    except ValidationError:\n+        import litellm.exceptions as litellm_exceptions\n+\n+        model: Final = request.get(\"model\")\n+        raise litellm_exceptions.BadRequestError(\n+            message=\"Invalid router request fields\",\n+            model=model if isinstance(model, str) else None,\n+            llm_provider=\"\",\n+        ) from None\n+\n+\n def _start_fields(request: Mapping[str, object]) -> Mapping[str, object]:\n     \"\"\"The request fields the Rust core routes on.\"\"\"\n-    fields: Final = {\n-        **request_retry_fields(request.get(\"num_retries\")),\n-        **({\"cooldown_time\": request[\"cooldown_time\"]} if request.get(\"cooldown_time\") is not None else {}),\n+    normalized: Final = _request_start_fields(request)\n+    excluded: Final = {\n+        name: True\n+        for name, omit in (\n+            (\"specific_deployment\", not normalized.specific_deployment),\n+            (\"disable_fallbacks\", not normalized.disable_fallbacks),\n+            (\"cooldown_time\", normalized.cooldown_time is None),\n+            (\"router_weights\", normalized.router_weights is None),\n+            (\"team_id\", not normalized.team_id),\n+            (\"listing_team_id\", normalized.listing_team_id is None),\n+            (\"routing_strategy\", normalized.routing_strategy is None),\n+        )\n+        if omit\n     }\n-    # `_common_checks_available_deployment`: only True names a litellm model.\n-    specific: Final = {\"specific_deployment\": True} if request.get(\"specific_deployment\") is True else {}\n-    # `record_disable_fallbacks(kwargs, disable_fallbacks is True)`: only True turns them off.\n-    disabled: Final = {\"disable_fallbacks\": True} if request.get(\"disable_fallbacks\") is True else {}\n-    lists: Final = {key: _plain(request[key]) for key in _REQUEST_FALLBACK_KEYS if key in request}\n-    weights: Final = request.get(\"_router_weights\")\n-    team_id: Final = get_request_team_id(request)\n-    listing_team_id: Final = _listing_team_id(request)\n-    strategy: Final = request.get(\"routing_strategy\")\n-    override: Final = normalize_strategy(strategy) if isinstance(strategy, str | RoutingStrategy) else None\n+    request_fields: Final = normalized.model_dump(exclude_unset=True, exclude=excluded)\n     return {\n-        **fields,\n-        **specific,\n-        **({\"routing_strategy\": override} if override is not None else {}),\n-        **disabled,\n-        **({\"router_weights\": weights} if weights is not None else {}),\n-        **lists,\n-        **({\"team_id\": team_id} if team_id else {}),\n-        **({\"listing_team_id\": listing_team_id} if listing_team_id is not None else {}),\n+        **request_retry_fields(request.get(\"num_retries\")),\n+        **request_fields,\n         **caller_fields(request),\n     }\n \n@@ -2849,11 +2896,14 @@ def _policy_lookup_names(self, request: Mapping[str, object]) -> frozenset[str]:\n         \"\"\"The model names a retry policy lookup may run on (each hop looks up the name it calls):\n         the requested one and every name in the fallback lists the walk may take.\"\"\"\n         resolved: Final = self._resolved\n+        normalized: Final = _request_start_fields(request)\n         lists: Final = (\n             resolved.fallbacks,\n             resolved.context_window_fallbacks,\n             resolved.content_policy_fallbacks,\n-            *(request.get(key) for key in _REQUEST_FALLBACK_KEYS),\n+            normalized.fallbacks,\n+            normalized.context_window_fallbacks,\n+            normalized.content_policy_fallbacks,\n         )\n         return frozenset((*_strings(request.get(\"model\")), *_strings(lists)))\n \n", "test_patch": "diff --git a/tests/unit/test_router/core/test_fallbacks.py b/tests/unit/test_router/core/test_fallbacks.py\nindex ef51634b920e..5f7235da27c8 100644\n--- a/tests/unit/test_router/core/test_fallbacks.py\n+++ b/tests/unit/test_router/core/test_fallbacks.py\n@@ -91,6 +91,51 @@ async def test_a_failed_group_falls_back_to_the_chain_from_the_winning_source(\n     assert headers(response)[\"x-litellm-model-group\"] == expected[-1]\n \n \n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    (\"field\", \"error\"),\n+    [\n+        (\"fallbacks\", rate_limit),\n+        (\"context_window_fallbacks\", context_window),\n+        (\"content_policy_fallbacks\", content_policy),\n+    ],\n+    ids=[\"fallbacks\", \"context-window\", \"content-policy\"],\n+)\n+async def test_request_fallback_string_is_ignored_and_router_chain_is_used(\n+    make_core: MakeCore, host: ScriptedHost, field: str, error: Callable[[], Exception]\n+) -> None:\n+    core = build(make_core, **{field: [{\"a\": [\"b\"]}]})\n+    host.answer(\"openai/a\", error())\n+\n+    response = await complete(core, **{field: \"unconfigured-scalar-model\"})\n+\n+    assert host.deployments_called(\"acompletion\") == [\"a\", \"b\"]\n+    assert headers(response)[\"x-litellm-model-group\"] == \"b\"\n+\n+\n+@pytest.mark.parametrize(\n+    (\"field\", \"error\"),\n+    [\n+        (\"fallbacks\", rate_limit),\n+        (\"context_window_fallbacks\", context_window),\n+        (\"content_policy_fallbacks\", content_policy),\n+    ],\n+    ids=[\"fallbacks\", \"context-window\", \"content-policy\"],\n+)\n+def test_sync_request_fallback_string_is_ignored_and_router_chain_is_used(\n+    make_core: MakeCore, host: ScriptedHost, field: str, error: Callable[[], Exception]\n+) -> None:\n+    core = build(make_core, **{field: [{\"a\": [\"b\"]}]})\n+    host.answer(\"openai/a\", error())\n+\n+    response: Final = core.completion(  # pyright: ignore[reportAttributeAccessIssue]  # endpoint method\n+        model=\"a\", messages=MESSAGES, **{field: \"unconfigured-scalar-model\"}\n+    )\n+\n+    assert host.deployments_called(\"completion\") == [\"a\", \"b\"]\n+    assert headers(response)[\"x-litellm-model-group\"] == \"b\"\n+\n+\n @pytest.mark.asyncio\n async def test_an_empty_request_fallback_list_overrides_the_constructor_chain(\n     make_core: MakeCore, host: ScriptedHost\n@@ -104,6 +149,19 @@ async def test_an_empty_request_fallback_list_overrides_the_constructor_chain(\n     assert host.deployments_called(\"acompletion\") == [\"a\"]\n \n \n+@pytest.mark.asyncio\n+async def test_a_null_request_fallback_list_overrides_the_constructor_chain(\n+    make_core: MakeCore, host: ScriptedHost\n+) -> None:\n+    core = build(make_core, fallbacks=[{\"a\": [\"b\"]}])\n+    host.answer(\"openai/a\", rate_limit())\n+\n+    with pytest.raises(litellm.RateLimitError):\n+        await complete(core, fallbacks=None)\n+\n+    assert host.deployments_called(\"acompletion\") == [\"a\"]\n+\n+\n @pytest.mark.asyncio\n @pytest.mark.parametrize(\"field\", [\"assign\", \"settings\"])\n async def test_fallbacks_applied_by_changeset_take_effect(make_core: MakeCore, host: ScriptedHost, field: str) -> None:\n@@ -300,6 +358,71 @@ async def test_max_fallbacks_applied_by_changeset_bounds_the_walk(make_core: Mak\n     assert host.deployments_called(\"acompletion\") == [\"a\", \"b\"]\n \n \n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    (\"value\", \"expected\"),\n+    [\n+        (True, [\"a\", \"b\"]),\n+        (False, [\"a\"]),\n+        (1.0, [\"a\", \"b\"]),\n+        (\"1\", [\"a\", \"b\"]),\n+        (\"1.0\", [\"a\", \"b\"]),\n+        (0, [\"a\"]),\n+    ],\n+    ids=[\"true\", \"false\", \"integral-float\", \"integer-string\", \"decimal-string\", \"zero\"],\n+)\n+async def test_request_max_fallbacks_uses_bounded_integer_coercion(\n+    make_core: MakeCore, host: ScriptedHost, value: object, expected: list[str]\n+) -> None:\n+    core = build(make_core, model_list=GROUPS_ABCD, fallbacks=CHAIN_ABCD)\n+    host.answer(\"*\", rate_limit())\n+\n+    with pytest.raises(litellm.RateLimitError):\n+        await complete(core, max_fallbacks=value)\n+\n+    assert host.deployments_called(\"acompletion\") == expected\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    (\"field\", \"value\"),\n+    [\n+        (\"fallbacks\", 3),\n+        (\"fallbacks\", [\"c\", 1]),\n+        (\"context_window_fallbacks\", [None]),\n+        (\"content_policy_fallbacks\", [True]),\n+        (\"max_fallbacks\", \"not-an-integer\"),\n+        (\"max_fallbacks\", -1),\n+        (\"max_fallbacks\", 2**32),\n+        (\"max_fallbacks\", 1.5),\n+        (\"max_fallbacks\", float(\"nan\")),\n+        (\"max_fallbacks\", float(\"inf\")),\n+    ],\n+    ids=[\n+        \"fallbacks-not-a-list\",\n+        \"fallbacks-invalid-entry\",\n+        \"context-window-invalid-entry\",\n+        \"content-policy-invalid-entry\",\n+        \"max-fallbacks-invalid-string\",\n+        \"max-fallbacks-negative\",\n+        \"max-fallbacks-too-large\",\n+        \"max-fallbacks-fractional\",\n+        \"max-fallbacks-nan\",\n+        \"max-fallbacks-infinite\",\n+    ],\n+)\n+async def test_invalid_request_fallback_fields_raise_bad_request(\n+    make_core: MakeCore, host: ScriptedHost, field: str, value: object\n+) -> None:\n+    core = build(make_core)\n+\n+    with pytest.raises(litellm.BadRequestError) as raised:\n+        await complete(core, **{field: value})\n+\n+    assert raised.value.status_code == 400\n+    assert host.deployments_called(\"acompletion\") == []\n+\n+\n @pytest.mark.asyncio\n async def test_a_fallback_group_with_no_deployments_is_passed_over(make_core: MakeCore, host: ScriptedHost) -> None:\n     core = build(make_core, fallbacks=[{\"a\": [\"missing\", \"c\"]}])\ndiff --git a/tests/unit/test_router/core/test_fallbacks_characterization.py b/tests/unit/test_router/core/test_fallbacks_characterization.py\nindex 41a751358a93..3e6c1f3666aa 100644\n--- a/tests/unit/test_router/core/test_fallbacks_characterization.py\n+++ b/tests/unit/test_router/core/test_fallbacks_characterization.py\n@@ -248,13 +248,14 @@ async def test_the_request_fallbacks_kwarg_is_not_forwarded_to_the_provider(\n \n \n @pytest.mark.asyncio\n-async def test_disable_fallbacks_given_as_a_string_does_not_disable_them(\n-    make_core: MakeCore, host: ScriptedHost\n+@pytest.mark.parametrize(\"value\", [\"true\", 1, False], ids=[\"string\", \"integer\", \"false\"])\n+async def test_disable_fallbacks_requires_literal_true(\n+    make_core: MakeCore, host: ScriptedHost, value: object\n ) -> None:\n     core = build(make_core, fallbacks=[{\"a\": [\"b\"]}])\n     host.answer(\"openai/a\", rate_limit())\n \n-    await complete(core, disable_fallbacks=\"true\")\n+    await complete(core, disable_fallbacks=value)\n \n     assert host.deployments_called(\"acompletion\") == [\"a\", \"b\"]\n \n", "problem_statement": "[Bug]: A request with a non-list `fallbacks` or a non-integer `max_fallbacks` fails with a router-core shape error (HTTP 500)\n### Description\n\nNow that the Rust router core is the only core (#49513, #50178), a request whose own `fallbacks`, `context_window_fallbacks` or `content_policy_fallbacks` is not a list fails before it is routed:\n\n```\nValueError: the router request does not have the shape router-core reads: invalid type: string \"default\", expected a sequence\n```\n\nOn the proxy this comes back as an HTTP 500 `api_error`. We see it on `/v1/messages` from a client that sends `\"fallbacks\": \"default\"` in the request body, about 70 failed requests in one morning. A `max_fallbacks` that is not an integer fails the same way (`invalid type: string \"2\", expected u32`).\n\n`_start_fields` in `litellm/router_rust/core.py` copies these four keys unchanged into the router-core request document. `RequestSpec` in `litellm/rust/crates/python-bridge/src/router/config.rs` reads the three lists as sequences and `max_fallbacks` as a `u32`, and a `Document::Request` shape error is not declined to Python, so the call raises. Nothing validates the values on the way in: they come from the request body, from `router_settings_override`, or from key and team `router_settings`.\n\nThe Python core only read these settings after a failure, so the same request used to be served. The Python side of the current fallback walk already reads a non-list value as no entries (`_as_list`). I'd expect router-core to match that: a list key holding anything other than a list replaces the router's list and names no fallback, and a `max_fallbacks` that is not a count leaves the router's limit in place. Rejecting such a request with a 400 would also be reasonable, but a 500 gives the client nothing to act on.\n\n### Config\n\n```yaml\nmodel_list:\n  - model_name: gpt-4o-mini\n    litellm_params:\n      model: openai/gpt-4o-mini\n      api_key: os.environ/OPENAI_API_KEY\n```\n\n### LiteLLM Version\n\nv1.110.0. The same `_start_fields` and `RequestSpec` are on main at 52d1c4cd80.\n\n### Steps to Repro\n\nNo API key is needed:\n\n```python\nfrom litellm import Router\n\nrouter = Router(model_list=[{\"model_name\": \"gpt-4o-mini\", \"litellm_params\": {\"model\": \"openai/gpt-4o-mini\", \"api_key\": \"sk-fake\"}}])\nfor kwargs in ({}, {\"fallbacks\": \"default\"}, {\"context_window_fallbacks\": \"default\"}, {\"max_fallbacks\": \"2\"}):\n    try:\n        response = router.completion(\n            model=\"gpt-4o-mini\", messages=[{\"role\": \"user\", \"content\": \"hi\"}], mock_response=\"ok\", **kwargs\n        )\n        print(kwargs, \"->\", response.choices[0].message.content)\n    except Exception as e:\n        print(kwargs, \"->\", type(e).__name__, e)\n```\n\nOutput:\n\n```\n{} -> ok\n{'fallbacks': 'default'} -> ValueError the router request does not have the shape router-core reads: invalid type: string \"default\", expected a sequence\n{'context_window_fallbacks': 'default'} -> ValueError the router request does not have the shape router-core reads: invalid type: string \"default\", expected a sequence\n{'max_fallbacks': '2'} -> ValueError the router request does not have the shape router-core reads: invalid type: string \"2\", expected u32\n```\n\nThrough the proxy, `POST /v1/messages` with `\"fallbacks\": \"default\"` in the body returns 500 with the same message.\n\n### Which part of LiteLLM is this about?\n\nRouting: load balancing, fallbacks, retries, cooldowns\n\n### How are you deploying?\n\nOther\n\n", "hints_text": "The reported error points to request-shape parsing before routing, rather than a failed fallback attempt.\n\nFor a client-side workaround, replace `\"fallbacks\": \"default\"` with `\"fallbacks\": []` if the request should name no fallback targets. Use lists for `context_window_fallbacks` and `content_policy_fallbacks` too.\n\nSend `\"max_fallbacks\": 2` as a JSON integer, not `\"2\"`, or omit that override to leave the router's configured limit in place.\n\nApply the same cleanup to any values supplied through `router_settings_override` and key or team `router_settings`, since those are also input paths identified here.\n\nThat avoids the malformed input, but it doesn't address the bug: a client-side type error shouldn't surface as an HTTP 500.\n@nasrsuresh Agreed, thanks for the assist. I will apply the following:\n\n- string in place of list of strings -> treat as single-item list. `\"fallbacks\" -> [\"fallbacks\"]`\n- string representation of int -> parse. `\"1\" -> 1`\n- Any other unexpected -> 400 bad request", "created_at": "2026-11-13T00:22:21Z"}
{"repo": "BerriAI/litellm", "pull_number": 51480, "instance_id": "BerriAI__litellm-51480", "issue_numbers": ["45379"], "base_commit": "4dad0bc513b75029e2a274143536bf50a7e56a4d", "patch": "diff --git a/litellm/proxy/pass_through_endpoints/llm_provider_handlers/transcribe_passthrough_logging_handler.py b/litellm/proxy/pass_through_endpoints/llm_provider_handlers/transcribe_passthrough_logging_handler.py\nindex ec189b831954..d7dd2fb2921e 100644\n--- a/litellm/proxy/pass_through_endpoints/llm_provider_handlers/transcribe_passthrough_logging_handler.py\n+++ b/litellm/proxy/pass_through_endpoints/llm_provider_handlers/transcribe_passthrough_logging_handler.py\n@@ -13,7 +13,6 @@\n from urllib.parse import quote\n \n import httpx\n-import soundfile\n from pydantic import ConfigDict, TypeAdapter, ValidationError\n from typing_extensions import ReadOnly, TypedDict\n \n@@ -522,6 +521,8 @@ async def write_media_within_limit(response: httpx.Response, media_file: IO[byte\n \n \n def media_file_seconds(path: Path) -> float | None:\n+    import soundfile\n+\n     try:\n         with soundfile.SoundFile(str(path)) as audio:\n             frames: Final = len(audio)\n", "test_patch": "diff --git a/tests/unit/proxy/pass_through_endpoints/llm_provider_handlers/test_transcribe_passthrough_logging_handler.py b/tests/unit/proxy/pass_through_endpoints/llm_provider_handlers/test_transcribe_passthrough_logging_handler.py\nindex 067e2cfc25f1..a25a1dfe5c96 100644\n--- a/tests/unit/proxy/pass_through_endpoints/llm_provider_handlers/test_transcribe_passthrough_logging_handler.py\n+++ b/tests/unit/proxy/pass_through_endpoints/llm_provider_handlers/test_transcribe_passthrough_logging_handler.py\n@@ -1,7 +1,9 @@\n import asyncio\n+import importlib\n import io\n import json\n import struct\n+import sys\n import wave\n from datetime import datetime\n from pathlib import Path\n@@ -471,6 +473,21 @@ def test_undecodable_media_yields_no_duration(self, tmp_path: Path):\n         assert media_file_seconds(media) is None\n \n \n+def test_passthrough_logging_imports_without_soundfile_installed(monkeypatch: pytest.MonkeyPatch) -> None:\n+    monkeypatch.setitem(sys.modules, \"soundfile\", None)\n+    for name in (\n+        \"litellm.proxy.pass_through_endpoints.llm_provider_handlers.transcribe_passthrough_logging_handler\",\n+        \"litellm.proxy.pass_through_endpoints.success_handler\",\n+    ):\n+        package, _, attribute = name.rpartition(\".\")\n+        monkeypatch.setattr(sys.modules[package], attribute, sys.modules[name])\n+        monkeypatch.delitem(sys.modules, name)\n+\n+    success_handler: Final = importlib.import_module(\"litellm.proxy.pass_through_endpoints.success_handler\")\n+\n+    assert success_handler.PassThroughEndpointLogging is not PassThroughEndpointLogging\n+\n+\n class TestStartedTranscriptionJob:\n     def test_reads_the_media_and_creation_time_from_the_start_response(self):\n         started = started_transcription_job(\n", "problem_statement": "[Bug]: Top-level `import soundfile` in the Transcribe pass-through handler breaks `/v1/messages` streaming without the `proxy` extra (since v1.103.0)\n### Description\n\nSince v1.103.0, `litellm.anthropic.messages.acreate(stream=True)` raises `ModuleNotFoundError: No module named 'soundfile'` for both the Anthropic and the Bedrock provider unless `soundfile` is installed. `soundfile` is only declared in the `proxy` and `stt-nvidia-riva` extras, and nothing on this path reads audio\n\n#41515 (Amazon Transcribe pass-through) added `import soundfile` at the top of `transcribe_passthrough_logging_handler.py` in commit ea1fd5f28, although only `media_file_seconds()` uses it. `success_handler.py` imports that handler at module top, and `streaming_iterator.py:19` has imported `success_handler` at module top since #11928. So every `/v1/messages` stream now loads `soundfile`. The import works on v1.102.4 and fails on v1.103.0 through v1.104.2. It is still there on main (1.106.0), where `experimental_pass_through/` has moved to `pass_through/` (#43329)\n\nWe hit this in a FastAPI service that pins the proxy runtime packages it needs (`fastapi`, `orjson`, `backoff`, `redis`) because `litellm[proxy]` conflicts with our `fastapi` pin. A bare `pip install litellm` fails earlier on this path, which is the same class of problem as #42195 and #36043\n\nThe smallest fix is to move `import soundfile` into `media_file_seconds()`, the same way `calculate_request_duration()` in `litellm_core_utils/audio_utils/utils.py` already imports it lazily. A CI job that imports the SDK entry points with only the base dependencies installed would catch this regression along with #42195 and #36043\n\n### Config\n\n```\nimport asyncio\nimport litellm\n\nasync def main():\n    response = await litellm.anthropic.messages.acreate(\n        model=\"anthropic/claude-sonnet-4-5\",\n        messages=[{\"role\": \"user\", \"content\": \"hi\"}],\n        max_tokens=16,\n        stream=True,\n    )\n    async for _ in response:\n        pass\n\nasyncio.run(main())\n```\n\n### LiteLLM Version\n\nv1.104.0 (first affected v1.103.0, still present on main at 1.106.0)\n\n### Steps to Repro\n\n1. In a clean venv: `pip install litellm==1.104.0 fastapi orjson`\n2. `python -c \"import litellm.proxy.pass_through_endpoints.success_handler\"`\n3. Expected: no error, as on v1.102.4. Actual:\n\n```\nTraceback (most recent call last):\n  File \"<string>\", line 1, in <module>\n  File \"litellm/proxy/pass_through_endpoints/success_handler.py\", line 42, in <module>\n    from .llm_provider_handlers.transcribe_passthrough_logging_handler import (\n  File \"litellm/proxy/pass_through_endpoints/llm_provider_handlers/transcribe_passthrough_logging_handler.py\", line 16, in <module>\n    import soundfile\nModuleNotFoundError: No module named 'soundfile'\n```\n\nThe SDK call in Config raises the same error once `backoff` and `redis` are also installed. Without them it fails earlier on those packages\n\n### Which part of LiteLLM is this about?\n\nPython SDK: the litellm package itself\n\n### How are you deploying?\n\npip / Python SDK\n\n", "hints_text": "Happy to take this. I would move the import into media_file_seconds(). Sound good?\nPR is up: #45395. It moves the import into media_file_seconds().\nI reproduced this independently as well.\n\nWithout soundfile installed, the unrelated /v1/messages streaming path fails and the resulting stream contains no usable response.\n\nI replayed that result through Badgr's response validation and it is rejected as an unsuccessful outcome.\n\nReceipt:\nhttps://aibadgr.com/receipts/litellm-45379-soundfile-import-breaks-stream\n\nLooks like #45395 is already fixing the source import issue.\n\nFor this type of failure, Badgr's role wouldn't be to replace LiteLLM's fix \u2014 it's to make sure an empty/broken stream doesn't get counted as successful work downstream.\nI tested the fix that #45395 and #45400 both make for the stream path, moving `import soundfile` into `media_file_seconds()`. I applied that edit to v1.104.0 and removed `soundfile`. The Anthropic and Bedrock streams both complete and the success callback runs. I did not build either PR branch itself\n\nOne note for review: #45395 also carries an unrelated Gemini commit (135f41ffc, default temperature for Gemini 3), which may be better as its own PR\n", "created_at": "2026-11-12T23:01:05Z"}
{"repo": "BerriAI/litellm", "pull_number": 51479, "instance_id": "BerriAI__litellm-51479", "issue_numbers": ["46286"], "base_commit": "40debbb9c0c0a243f1c438b4689f2b2cf1c93e78", "patch": "diff --git a/litellm/cost_calculator.py b/litellm/cost_calculator.py\nindex a37160b45288..2a7ba5bd01bf 100644\n--- a/litellm/cost_calculator.py\n+++ b/litellm/cost_calculator.py\n@@ -1144,11 +1144,29 @@ def _served_or_priced_requested_model(\n     if served in (requested, requested.partition(\"/\")[2]):\n         return served\n     pricing_provider: Final = _get_provider_for_cost_calc(requested, custom_llm_provider)\n+    profile_of_served: Final = _is_bedrock_cross_region_profile_of(requested_model, served_model, pricing_provider)\n+    if profile_of_served and _resolves_to_rates(requested, pricing_provider):\n+        return requested\n     if _resolves_to_rates(served, pricing_provider):\n         return served\n     return requested if _resolves_to_rates(requested, pricing_provider) else served\n \n \n+def _is_bedrock_cross_region_profile_of(profile: str, served_model: str, custom_llm_provider: str | None) -> bool:\n+    if custom_llm_provider != \"bedrock\":\n+        return False\n+    from litellm.llms.bedrock.common_utils import (\n+        get_bedrock_cross_region_inference_regions,\n+        strip_bedrock_routing_prefix,\n+    )\n+\n+    region, _, profiled_model = strip_bedrock_routing_prefix(profile).partition(\".\")\n+    return (\n+        region in get_bedrock_cross_region_inference_regions()\n+        and strip_bedrock_routing_prefix(served_model) == profiled_model\n+    )\n+\n+\n def _strip_unregistered_leading_segments(model: str, region_name: str | None) -> str:\n     \"\"\"Resolve a provider-prefixed slash alias like \"vertex_ai/vertex/claude-opus-5\" to the\n     registered cost key (\"vertex_ai/claude-opus-5\"), keeping the model unchanged when it already\n", "test_patch": "diff --git a/tests/unit/integrations/langfuse/langfuse_expected_request_body/completion_with_bedrock_call.json b/tests/unit/integrations/langfuse/langfuse_expected_request_body/completion_with_bedrock_call.json\nindex 6f3593802454..96548edc60f4 100644\n--- a/tests/unit/integrations/langfuse/langfuse_expected_request_body/completion_with_bedrock_call.json\n+++ b/tests/unit/integrations/langfuse/langfuse_expected_request_body/completion_with_bedrock_call.json\n@@ -2,9 +2,6 @@\n     \"name\": \"litellm-acompletion\",\n     \"parent_span_id\": null,\n     \"attributes\": {\n-        \"langfuse.observation.cost_details\": {\n-            \"total\": 6e-05\n-        },\n         \"langfuse.observation.input\": {\n             \"messages\": [\n                 {\ndiff --git a/tests/unit/integrations/langfuse/test_langfuse.py b/tests/unit/integrations/langfuse/test_langfuse.py\nindex 7a374c1affe0..e7fcad5c7487 100644\n--- a/tests/unit/integrations/langfuse/test_langfuse.py\n+++ b/tests/unit/integrations/langfuse/test_langfuse.py\n@@ -97,7 +97,9 @@ def _comparable(span: Mapping[str, object]) -> dict[str, object]:\n     }\n \n \n-def _expected_generation(route: respx.Route, fixture_name: str, trace_id: str) -> dict[str, object]:\n+def _expected_generation(\n+    route: respx.Route, fixture_name: str, trace_id: str, cost_total: float | None = None\n+) -> dict[str, object]:\n     otel_trace_id: Final = resolve_trace_id(trace_id)\n     generations: Final = tuple(\n         span\n@@ -108,7 +110,14 @@ def _expected_generation(route: respx.Route, fixture_name: str, trace_id: str) -\n     )\n     assert len(generations) == 1\n     expected_path: Final = Path(__file__).with_name(\"langfuse_expected_request_body\") / fixture_name\n-    expected: Final = TypeAdapter(dict[str, object]).validate_python(json.loads(expected_path.read_text()))\n+    fixture: Final = TypeAdapter(dict[str, object]).validate_python(json.loads(expected_path.read_text()))\n+    fixture_attributes: Final = TypeAdapter(dict[str, object]).validate_python(fixture[\"attributes\"])\n+    priced_attributes: Final = (\n+        fixture_attributes\n+        if cost_total is None\n+        else {**fixture_attributes, \"langfuse.observation.cost_details\": {\"total\": cost_total}}\n+    )\n+    expected: Final = {**fixture, \"attributes\": priced_attributes}\n     actual: Final = _comparable(generations[0])\n     expected_comparable: Final = _comparable(expected)\n     assert actual == expected_comparable, json.dumps(\n@@ -355,6 +364,12 @@ async def test_langfuse_logging_completion_with_bedrock_llm_response(\n     langfuse_export: tuple[respx.Route, str],\n ) -> None:\n     route, trace_id = langfuse_export\n+    profile: Final = litellm.get_model_info(\n+        model=\"us.anthropic.claude-haiku-4-5-20251001-v1:0\", custom_llm_provider=\"bedrock\"\n+    )\n+    input_rate: Final = profile[\"input_cost_per_token\"]\n+    output_rate: Final = profile[\"output_cost_per_token\"]\n+    assert isinstance(input_rate, float) and isinstance(output_rate, float)\n     response: Final = litellm.ModelResponse(\n         choices=[],\n         usage=litellm.Usage(prompt_tokens=10, completion_tokens=10, total_tokens=20),\n@@ -373,7 +388,9 @@ async def test_langfuse_logging_completion_with_bedrock_llm_response(\n     )\n     await _flush_langfuse()\n     assert route.call_count == 1\n-    _expected_generation(route, \"completion_with_bedrock_call.json\", trace_id)\n+    _expected_generation(\n+        route, \"completion_with_bedrock_call.json\", trace_id, cost_total=10 * input_rate + 10 * output_rate\n+    )\n \n \n @pytest.mark.asyncio\ndiff --git a/tests/unit/test_cost_calculator.py b/tests/unit/test_cost_calculator.py\nindex 71efa1352e43..237487908691 100644\n--- a/tests/unit/test_cost_calculator.py\n+++ b/tests/unit/test_cost_calculator.py\n@@ -2,7 +2,7 @@\n import asyncio\n import datetime\n import time\n-from collections.abc import Iterator, Mapping\n+from collections.abc import Callable, Iterator, Mapping\n from pathlib import Path\n from types import MappingProxyType, SimpleNamespace\n from typing import Final, Literal, cast\n@@ -526,6 +526,204 @@ def test_completion_cost_bills_priced_response_model_over_priced_requested_model\n     assert cost == pytest.approx(_token_rates_cost(litellm.model_cost[\"openai/sol-requested-test-2099-01-01\"], usage))\n \n \n+_BEDROCK_PROFILE_GLOBAL_RATES: Final = MappingProxyType(\n+    {\n+        \"input_cost_per_token\": 1e-6,\n+        \"output_cost_per_token\": 5e-6,\n+        \"cache_read_input_token_cost\": 1e-7,\n+        \"cache_creation_input_token_cost\": 1.25e-6,\n+    }\n+)\n+_BEDROCK_PROFILE_MODEL: Final = \"anthropic.bedrock-profile-test-v1:0\"\n+_BEDROCK_PROFILE_RATE_MULTIPLIERS: Final = MappingProxyType(\n+    {\n+        _BEDROCK_PROFILE_MODEL: 1.0,\n+        f\"eu.{_BEDROCK_PROFILE_MODEL}\": 1.1,\n+        f\"us.{_BEDROCK_PROFILE_MODEL}\": 1.2,\n+        f\"jp.{_BEDROCK_PROFILE_MODEL}\": 1.3,\n+        f\"global.{_BEDROCK_PROFILE_MODEL}\": 0.9,\n+        \"anthropic.bedrock-profile-other-test-v1:0\": 3.0,\n+        \"anthropic.bedrock-profile-unpriced-test-v1:0\": 1.0,\n+        \"bedrock-profile-router-test\": 5.0,\n+    }\n+)\n+_BEDROCK_PROFILE_CACHE_USAGE: Final = MappingProxyType(\n+    {\"cache_creation_input_tokens\": 2000, \"cache_read_input_tokens\": 24000}\n+)\n+\n+\n+@pytest.fixture\n+def _bedrock_profile_rows(_local_model_cost_map: None, monkeypatch: pytest.MonkeyPatch) -> None:\n+    for key, multiplier in _BEDROCK_PROFILE_RATE_MULTIPLIERS.items():\n+        monkeypatch.setitem(\n+            litellm.model_cost,\n+            key,\n+            {\n+                \"litellm_provider\": \"bedrock_converse\",\n+                \"mode\": \"chat\",\n+                **{field: rate * multiplier for field, rate in _BEDROCK_PROFILE_GLOBAL_RATES.items()},\n+            },\n+        )\n+    monkeypatch.setitem(\n+        litellm.model_cost,\n+        \"eu.anthropic.bedrock-profile-unpriced-test-v1:0\",\n+        {\"litellm_provider\": \"bedrock_converse\", \"mode\": \"chat\"},\n+    )\n+\n+\n+def _bedrock_messages_body(model: str) -> dict[str, object]:\n+    return {\n+        \"id\": \"msg_bdrk_profile\",\n+        \"type\": \"message\",\n+        \"role\": \"assistant\",\n+        \"model\": model,\n+        \"content\": [{\"type\": \"text\", \"text\": \"hi\"}],\n+        \"stop_reason\": \"end_turn\",\n+        \"usage\": {\"input_tokens\": 18, \"output_tokens\": 4, **_BEDROCK_PROFILE_CACHE_USAGE},\n+    }\n+\n+\n+def _bedrock_stream_response(model: str) -> ModelResponse:\n+    cached: Final = _BEDROCK_PROFILE_CACHE_USAGE[\"cache_read_input_tokens\"]\n+    written: Final = _BEDROCK_PROFILE_CACHE_USAGE[\"cache_creation_input_tokens\"]\n+    return ModelResponse(\n+        model=model,\n+        choices=[],\n+        usage=Usage(\n+            prompt_tokens=18 + cached + written,\n+            completion_tokens=4,\n+            total_tokens=22 + cached + written,\n+            cache_creation_input_tokens=written,\n+            cache_read_input_tokens=cached,\n+            prompt_tokens_details=PromptTokensDetailsWrapper(cached_tokens=cached),\n+        ),\n+    )\n+\n+\n+def _bedrock_private_route_response(model: str) -> ModelResponse:\n+    response: Final = _bedrock_stream_response(\"bedrock-profile-alias\")\n+    response._hidden_params = {\"custom_llm_provider\": \"bedrock\", \"provider_response_model\": model}\n+    return response\n+\n+\n+def _bedrock_global_cost(served_shape: Callable[[str], object]) -> float:\n+    return completion_cost(\n+        completion_response=served_shape(_BEDROCK_PROFILE_MODEL),\n+        model=f\"bedrock/{_BEDROCK_PROFILE_MODEL}\",\n+        custom_llm_provider=\"bedrock\",\n+    )\n+\n+\n+_BEDROCK_SERVED_SHAPES: Final = (\n+    pytest.param(_bedrock_messages_body, id=\"non-streaming\"),\n+    pytest.param(_bedrock_stream_response, id=\"streaming\"),\n+    pytest.param(_bedrock_private_route_response, id=\"private-provider-response-model\"),\n+)\n+\n+\n+@pytest.mark.parametrize(\"served_shape\", _BEDROCK_SERVED_SHAPES)\n+@pytest.mark.parametrize(\"route\", [\"bedrock/\", \"bedrock/invoke/\"])\n+@pytest.mark.parametrize(\"region\", [\"eu\", \"us\", \"jp\"])\n+def test_completion_cost_bills_bedrock_cross_region_profile_when_bedrock_serves_the_region_stripped_id(\n+    _bedrock_profile_rows: None, region: str, route: str, served_shape: Callable[[str], object]\n+) -> None:\n+    profile: Final = f\"{region}.{_BEDROCK_PROFILE_MODEL}\"\n+\n+    cost: Final = completion_cost(\n+        completion_response=served_shape(_BEDROCK_PROFILE_MODEL),\n+        model=f\"{route}{profile}\",\n+        custom_llm_provider=\"bedrock\",\n+    )\n+\n+    assert cost == pytest.approx(_bedrock_global_cost(served_shape) * _BEDROCK_PROFILE_RATE_MULTIPLIERS[profile])\n+\n+\n+@pytest.mark.parametrize(\"served_shape\", _BEDROCK_SERVED_SHAPES)\n+@pytest.mark.parametrize(\n+    (\"deployment\", \"served_model\"),\n+    [\n+        pytest.param(f\"bedrock/eu.{_BEDROCK_PROFILE_MODEL}\", f\"us.{_BEDROCK_PROFILE_MODEL}\", id=\"other-region\"),\n+        pytest.param(f\"bedrock/eu.{_BEDROCK_PROFILE_MODEL}\", f\"global.{_BEDROCK_PROFILE_MODEL}\", id=\"global-profile\"),\n+        pytest.param(\n+            f\"bedrock/jp.{_BEDROCK_PROFILE_MODEL}\", \"anthropic.bedrock-profile-other-test-v1:0\", id=\"other-model\"\n+        ),\n+        pytest.param(\n+            \"bedrock/eu.anthropic.bedrock-profile-unpriced-test-v1:0\",\n+            \"anthropic.bedrock-profile-unpriced-test-v1:0\",\n+            id=\"unpriced-profile\",\n+        ),\n+    ],\n+)\n+def test_completion_cost_keeps_the_served_bedrock_row_unless_it_is_the_region_stripped_profile(\n+    _bedrock_profile_rows: None, deployment: str, served_model: str, served_shape: Callable[[str], object]\n+) -> None:\n+    cost: Final = completion_cost(\n+        completion_response=served_shape(served_model),\n+        model=deployment,\n+        custom_llm_provider=\"bedrock\",\n+    )\n+\n+    assert cost == pytest.approx(_bedrock_global_cost(served_shape) * _BEDROCK_PROFILE_RATE_MULTIPLIERS[served_model])\n+\n+\n+@pytest.mark.parametrize(\n+    (\"base_model\", \"custom_pricing\", \"router_model_id\", \"priced_row\"),\n+    [\n+        pytest.param(\n+            \"bedrock/anthropic.bedrock-profile-other-test-v1:0\",\n+            None,\n+            None,\n+            \"anthropic.bedrock-profile-other-test-v1:0\",\n+            id=\"base-model\",\n+        ),\n+        pytest.param(None, True, \"bedrock-profile-router-test\", \"bedrock-profile-router-test\", id=\"custom-pricing\"),\n+    ],\n+)\n+def test_completion_cost_explicit_pricing_precedes_the_bedrock_cross_region_profile(\n+    _bedrock_profile_rows: None,\n+    base_model: str | None,\n+    custom_pricing: bool | None,\n+    router_model_id: str | None,\n+    priced_row: str,\n+) -> None:\n+    cost: Final = completion_cost(\n+        completion_response=_bedrock_messages_body(_BEDROCK_PROFILE_MODEL),\n+        model=f\"bedrock/eu.{_BEDROCK_PROFILE_MODEL}\",\n+        custom_llm_provider=\"bedrock\",\n+        base_model=base_model,\n+        custom_pricing=custom_pricing,\n+        router_model_id=router_model_id,\n+    )\n+\n+    assert cost == pytest.approx(\n+        _bedrock_global_cost(_bedrock_messages_body) * _BEDROCK_PROFILE_RATE_MULTIPLIERS[priced_row]\n+    )\n+\n+\n+def test_completion_cost_keeps_the_served_row_for_a_region_dotted_name_outside_bedrock(\n+    _local_model_cost_map: None, monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    monkeypatch.setitem(\n+        litellm.model_cost,\n+        \"openai/eu.profile-dotted-test\",\n+        {\"litellm_provider\": \"openai\", \"mode\": \"chat\", \"input_cost_per_token\": 3e-6, \"output_cost_per_token\": 7e-6},\n+    )\n+    monkeypatch.setitem(\n+        litellm.model_cost,\n+        \"openai/profile-dotted-test\",\n+        {\"litellm_provider\": \"openai\", \"mode\": \"chat\", \"input_cost_per_token\": 5e-6, \"output_cost_per_token\": 11e-6},\n+    )\n+    usage: Final = Usage(prompt_tokens=1000, completion_tokens=500, total_tokens=1500)\n+\n+    cost: Final = completion_cost(\n+        completion_response=ModelResponse(model=\"profile-dotted-test\", choices=[], usage=usage),\n+        model=\"openai/eu.profile-dotted-test\",\n+        custom_llm_provider=\"openai\",\n+    )\n+\n+    assert cost == pytest.approx(_token_rates_cost(litellm.model_cost[\"openai/profile-dotted-test\"], usage))\n+\n+\n def test_completion_cost_keeps_response_pricing_when_requested_alias_has_no_rates(\n     _local_model_cost_map: None, monkeypatch: pytest.MonkeyPatch\n ) -> None:\n", "problem_statement": "[Bug]: Bedrock /v1/messages spend priced at the global rate for cross-region (eu.) profiles; streamed usage.cost uses the eu. rate\n### What happened?\n\nFor a Bedrock deployment on a cross-region inference profile (e.g. `bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0`) without custom pricing, `/v1/messages` books the spend-log `spend` at the **global** model's rate instead of the `eu.` entry's rate. With `include_cost_in_streaming_usage: true`, the streamed `usage.cost` uses the correct `eu.` rate, so the client-visible cost and the spend log disagree by the EU premium (10 %).\n\nRepro (v1.105.0; v1.104.0 behaves the same):\n\n- Deployment: `model: eu.anthropic.claude-haiku-4-5-20251001-v1:0`, provider `bedrock`, no custom pricing. `/model/info` shows `input_cost_per_token 1.1e-06`, `output_cost_per_token 5.5e-06` (the `eu.` map entry).\n- `POST /v1/messages` with `stream: true`, 8 prompt tokens, 16 completion tokens:\n  - `message_delta` event: `usage.cost = 0.0000968` (8 x 1.1e-6 + 16 x 5.5e-6, correct)\n  - spend log row (`request_id` = the `msg_bdrk_...` id): `spend = 0.000088` (8 x 1e-6 + 16 x 5e-6, the global `anthropic.claude-haiku-4-5-20251001-v1:0` rate)\n- `/chat/completions` (streaming, `include_usage`) for the same deployment: `usage.cost = spend = 0.0000968`, correct.\n\n### Where it happens\n\n- The Anthropic Messages response is rebuilt from the Bedrock stream, and `model` is taken from `message_start.message.model` (`llms/anthropic/chat/handler.py` ~1009-1042). For a cross-region profile that id carries no `eu.` prefix.\n- `_select_model_name_for_cost_calc` (`cost_calculator.py` ~815-883) prefers the response's model over the deployment model passed in, so `stream_chunk_builder` -> `_stamp_streaming_usage_cost` (`main.py` ~8961) prices the global key, and the success handler reuses that cost.\n- The streamed `usage.cost` (`proxy/common_request_processing.py` `_streamed_usage_cost`) prices a model-less usage frame against the deployment model and therefore gets the `eu.` rate.\n\n### Workaround\n\nSet `model_info.base_model` to the deployment's own `eu.` model name; `base_model` outranks the response model in the cost lookup, and both values then agree.\n\n### Expected\n\nWhen the response model is the region-stripped form of the deployment's cross-region profile, price with the deployment model (keep the `eu.`/`us.`/`apac.` prefix), so spend logs and budgets use the profile's rate.\n\n### LiteLLM version\n\nv1.105.0 (`ghcr.io/berriai/litellm-database`); same result in v1.104.0.\n\n", "hints_text": "**Additional findings: non-streaming `/v1/messages` is also affected, it predates v1.103.0, and the `base_model` workaround has to go in `model_info`**\n\nI tested a Bedrock cross-region profile and compared each request's spend-log `spend` with a cost calculated by hand. The pattern is the issue's, but the scope is wider.\n\n### Test setup (the same on both proxies)\n\n- **Deployment:** `model: bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0`, no custom pricing, no `base_model` unless a row below says so. Each variant was a separate DB-registered model.\n- **Request:** `POST /v1/messages`, `max_tokens: 20`. The system prompt was one text block with `cache_control: {\"type\":\"ephemeral\"}`, about 13,000 tokens. I generated a fresh system text for each run so the first call is a cache write, the second a cache read, and nothing carries over from earlier runs. The user text carried a random number, so the proxy's Redis response cache couldn't answer repeats. Three calls per configuration: non-streaming write, non-streaming read, streaming read.\n- **Measured:** the `spend` field of the spend-log row (`/spend/logs?request_id=<msg id>`), plus the token counts in the row's `metadata.usage_object`.\n- **Expected:** the token counts times the cost-map rates for the `us.` entry and for the global entry. The two sets of rates:\n\n| | input | output | cache read | cache write |\n|---|---|---|---|---|\n| `us.anthropic.claude-haiku-4-5-20251001-v1:0` | 1.1e-6 | 5.5e-6 | 1.1e-7 | 1.375e-6 |\n| `anthropic.claude-haiku-4-5-20251001-v1:0` (global) | 1.0e-6 | 5.0e-6 | 1.0e-7 | 1.25e-6 |\n\n- **Verdict:** a row is \"us\" or \"global\" when `spend` matches that rate within 2e-7. In every case below one matched and the other was about 10% away.\n\n### Results on v1.105.7 (the proxy was running v1.105.7)\n\nToken shape for the plain row: about 17 uncached input, 13,052 cache write or read, 4 output. The other variants used 13,502 cached tokens, so their dollar amounts differ slightly.\n\n| Row configuration | Non-streaming, cache write | Non-streaming, cache read | Streaming, cache read | `/v1/chat/completions`, cache read |\n|---|---|---|---|---|\n| Plain (no override) | **global** (0.016352; us would be 0.0179872) | **global** (0.0013422; us 0.0014764) | **global** (0.0013422) | us (0.00149952) |\n| `litellm_params.base_model` = `us.anthropic.claude-haiku-4-5-20251001-v1:0` | **global** | **global** | **global** | us |\n| `litellm_params.base_model` = `bedrock/us.anthropic...` | **global** | **global** | **global** | not tested |\n| `model_info.base_model` = `us.anthropic.claude-haiku-4-5-20251001-v1:0` | us (0.0179872) | us (0.0014775) | us (0.0014775) | not tested |\n\n### Results on v1.102.3 (the proxy was running v1.102.3)\n\nSame deployment and request shape (about 13k cached tokens). The table shows one row, then the same row with `model_info.base_model` set via the PATCH below, then after clearing it.\n\n| Row state | Non-streaming, cache write | Non-streaming, cache read | Streaming, cache read |\n|---|---|---|---|\n| Plain (no override) | **global** (0.0163480; us would be 0.0179828) | **global** (0.0013392; us 0.0014731) | us (0.0015061) |\n| `model_info.base_model` = the `us.` name | us (0.0186026) | us (0.0015215) | us (0.0015226) |\n| `model_info.base_model` = `\"\"` | **global** (0.0163490) | **global** (0.0013382) | us (0.0014720) |\n\nAn earlier, smaller check on the same proxy (uncached, 19 prompt and 4 completion tokens) also showed streamed `/v1/messages` and `/v1/chat/completions` both at the `us` rate (0.0000429).\n\n### What this changes about the issue\n\n1. **Non-streaming `/v1/messages` is wrong too.** The repro and the PR description cover only `stream: true`. On both versions, non-streaming `/v1/messages` books the global rate for input, output, cache write and cache read.\n2. **It exists before `847172d3`.** On v1.102.3 the streaming path books the `us` rate, as it should, and only the non-streaming path is wrong. Streaming breaks later, so there are two separate defects.\n3. **The stated cause does not explain case 2.** The issue says the response `model` has no region prefix. On v1.102.3 I checked one request on a real `us.anthropic.claude-haiku-4-5-20251001-v1:0` row, once non-streaming and once streaming. The non-streaming response `model` and the streamed `message_start.message.model` were both `us.anthropic.claude-haiku-4-5-20251001-v1:0`, with the prefix, and non-streaming was still booked at the global rate. I did not trace why. I did not inspect the response `model` on v1.105.x, so I can't say whether the prefix-stripping description holds there. I also have not checked whether #46288 changes the non-streaming result.\n4. **The workaround must go in `model_info`.** `litellm_params.base_model` (with or without a `bedrock/` prefix) is ignored on `/v1/messages`. `model_info.base_model` set to the deployment's own `us.` name made all three calls book the `us` rate on both versions.\n5. **Clearing it.** For a DB-registered model: `\"base_model\": \"\"` takes effect and returns billing to the plain-row behaviour; `null` and omitting the key are silent no-ops, and `\"\"` stays stored.\n\n### Commands\n\nSet the workaround on an existing DB model (do not send `model_info` without `id` and `db_model`; that overwrites them):\n\n```\nPATCH /model/<model-id>/update\n{\"model_info\":{\"id\":\"<model-id>\",\"db_model\":true,\"base_model\":\"us.anthropic.claude-haiku-4-5-20251001-v1:0\"}}\n```\n\nAfterwards `GET /model/info` showed `id`, `db_model` and `litellm_params.model` unchanged and `model_info.base_model` set. The change took effect on v1.102.3 about 35 seconds later, which was my polling interval, not a measured minimum.\n", "created_at": "2026-11-12T22:57:55Z"}
{"repo": "BerriAI/litellm", "pull_number": 51462, "instance_id": "BerriAI__litellm-51462", "issue_numbers": ["34906"], "base_commit": "ca4c6c0a6d5bc21b3931101fb2675f174dc35273", "patch": "diff --git a/litellm/proxy/mcp_server/mcp_server_manager.py b/litellm/proxy/mcp_server/mcp_server_manager.py\nindex 5b4ebe419485..d31e9246a38b 100644\n--- a/litellm/proxy/mcp_server/mcp_server_manager.py\n+++ b/litellm/proxy/mcp_server/mcp_server_manager.py\n@@ -373,6 +373,12 @@ def _requires_oauth_discovery(\n ]\n \n \n+@dataclass(frozen=True, slots=True)\n+class ResourceListingFailed:\n+    server_name: str\n+    error: Exception\n+\n+\n @dataclass(frozen=True, slots=True)\n class _OAuthDiscoveryResolved:\n     server: MCPServer\n@@ -1621,13 +1627,14 @@ def _redacted_registry_dump(servers: dict[str, MCPServer]) -> dict[str, dict[str\n \n def caller_authorization_fans_out(\n     server: MCPServer,\n-    scope_servers: list[MCPServer] | None,\n+    scope_servers: Sequence[MCPServer] | None,\n ) -> bool:\n     \"\"\"True when forwarding the caller's request-wide ``Authorization`` to ``server`` inside a\n     listing fan-out would replay one credential against multiple upstreams: another server in the\n     scope also consumes it (RFC 9700 cross-resource replay). ``scope_servers`` is None for\n-    explicitly-addressed operations (tool call, get_prompt, read_resource, single-server routes),\n-    where the client named the one target and the gateway is not choosing recipients.\"\"\"\n+    explicitly-addressed operations (tool call, get_prompt, single-server routes), where the client\n+    named the one target and the gateway is not choosing recipients. An aggregate read_resource passes\n+    its scope because the gateway picks the owner from listings.\"\"\"\n     if scope_servers is None:\n         return False\n     return any(\n@@ -5099,8 +5106,33 @@ async def get_resources_from_server(\n         raw_headers: dict[str, str] | None = None,\n         client_ip: str | None = None,\n     ) -> list[Resource]:\n-        if self._skip_blocked_stdio_listing(server, \"resource\"):\n+        listing: Final = await self.list_resources_from_server(\n+            server=server,\n+            user_api_key_auth=user_api_key_auth,\n+            mcp_auth_header=mcp_auth_header,\n+            extra_headers=extra_headers,\n+            add_prefix=add_prefix,\n+            raw_headers=raw_headers,\n+            client_ip=client_ip,\n+        )\n+        if isinstance(listing, ResourceListingFailed):\n+            verbose_logger.warning(\"Failed to get resources from server %s: %s\", server.name, listing.error)\n             return []\n+        return list(listing)\n+\n+    async def list_resources_from_server(\n+        self,\n+        server: MCPServer,\n+        user_api_key_auth: UserAPIKeyAuth | None,\n+        mcp_auth_header: str | Mapping[str, str] | None = None,\n+        extra_headers: Mapping[str, str] | None = None,\n+        add_prefix: bool = True,\n+        raw_headers: Mapping[str, str] | None = None,\n+        client_ip: str | None = None,\n+    ) -> tuple[Resource, ...] | ResourceListingFailed:\n+        if self._skip_blocked_stdio_listing(server, \"resource\"):\n+            return ()\n+        auth_header: Final = dict(mcp_auth_header) if isinstance(mcp_auth_header, Mapping) else mcp_auth_header\n         try:\n             headers: Final = (\n                 dict(\n@@ -5115,7 +5147,7 @@ async def get_resources_from_server(\n             subject_token: Final = self._obo_subject_token(server, raw_headers, user_api_key_auth)\n             client: Final = await self.create_mcp_client(\n                 server=server,\n-                mcp_auth_header=mcp_auth_header,\n+                mcp_auth_header=auth_header,\n                 extra_headers=headers,\n                 stdio_env=stdio_env,\n                 subject_token=subject_token,\n@@ -5127,7 +5159,7 @@ async def get_resources_from_server(\n             key: Final = self._discovery_key(\n                 server,\n                 user_api_key_auth,\n-                mcp_auth_header,\n+                auth_header,\n                 headers,\n                 stdio_env,\n                 subject_token,\n@@ -5139,10 +5171,9 @@ async def fetch() -> ListResourcesResult:\n                 return await client.list_resources_result(raise_on_error=True)\n \n             items: Final = await self._resource_discovery_cache.get(key, fetch)\n-            return self._create_prefixed_resources(items.resources, server, add_prefix=add_prefix)\n+            return tuple(self._create_prefixed_resources(items.resources, server, add_prefix=add_prefix))\n         except Exception as error:\n-            verbose_logger.warning(\"Failed to get resources from server %s: %s\", server.name, error)\n-            return []\n+            return ResourceListingFailed(server_name=server.name, error=error)\n \n     async def get_resource_templates_from_server(\n         self,\ndiff --git a/litellm/proxy/mcp_server/operations.py b/litellm/proxy/mcp_server/operations.py\nindex 73a16291c61a..6c9b8184e1aa 100644\n--- a/litellm/proxy/mcp_server/operations.py\n+++ b/litellm/proxy/mcp_server/operations.py\n@@ -112,6 +112,7 @@\n from litellm.proxy.mcp_server.legacy_callbacks import get_scope_response\n from litellm.proxy.mcp_server.mcp_server_manager import (  # noqa: F401  # legacy module exports\n     MCPServerManager,\n+    ResourceListingFailed,\n     _caller_authorization_fans_out,  # pyright: ignore[reportPrivateUsage,reportUnusedImport]  # backwards-compatible package export\n     _client_forwarded_authorization_headers,  # pyright: ignore[reportPrivateUsage,reportUnusedImport]  # backwards-compatible package export\n     _resolve_openapi_tool_auth,  # pyright: ignore[reportPrivateUsage,reportUnusedImport]  # backwards-compatible package export\n@@ -142,6 +143,7 @@\n     handler_outcome,\n     to_call_tool_result,\n )\n+from litellm.proxy.mcp_server.stdio_gate import is_mcp_stdio_blocked\n from litellm.proxy.mcp_server.tool_registry import (\n     global_mcp_tool_registry,\n )\n@@ -262,6 +264,61 @@ class _MCPServerRateLimitAdmission:\n     rejected_servers: tuple[tuple[MCPServer, ProxyRateLimitError], ...]\n \n \n+@dataclass(frozen=True, slots=True)\n+class _ResourceOwnerRateLimited:\n+    error: ProxyRateLimitError\n+\n+\n+@dataclass(frozen=True, slots=True)\n+class _ResourceOwnerMissing:\n+    pass\n+\n+\n+@dataclass(frozen=True, slots=True)\n+class _ResourceOwnerAmbiguous:\n+    server_names: tuple[str, ...]\n+\n+\n+_ResourceOwnerFailure: TypeAlias = (\n+    _ResourceOwnerRateLimited | ResourceListingFailed | _ResourceOwnerMissing | _ResourceOwnerAmbiguous\n+)\n+\n+\n+def _withhold_fanned_out_caller_authorization(\n+    server: MCPServer, extra_headers: dict[str, str] | None, scope_servers: Sequence[MCPServer]\n+) -> dict[str, str] | None:\n+    \"\"\"Drop the caller's request-wide Authorization from a gateway-selected read when another server in\n+    scope also consumes it. ``_prepare_mcp_server_headers`` already withholds it from client-forwarded\n+    servers, but legacy oauth2 delegates and OAuth pass-through servers still carry it, and an aggregate\n+    read must not replay one caller token to servers the gateway picked.\"\"\"\n+    if extra_headers and caller_authorization_fans_out(server, scope_servers):\n+        return without_header(extra_headers, DEFAULT_CREDENTIAL_HEADER)\n+    return extra_headers\n+\n+\n+def _raise_resource_owner_failure(failure: _ResourceOwnerFailure, url: AnyUrl) -> NoReturn:\n+    match failure:\n+        case _ResourceOwnerRateLimited(error=error):\n+            raise error\n+        case ResourceListingFailed(server_name=server_name):\n+            raise HTTPException(\n+                status_code=502,\n+                detail=f\"Unable to list resources from MCP server '{server_name}'; resource owner is unknown.\",\n+            )\n+        case _ResourceOwnerMissing():\n+            raise HTTPException(status_code=404, detail=f\"Resource '{url}' not found on any allowed MCP server.\")\n+        case _ResourceOwnerAmbiguous(server_names=server_names):\n+            raise HTTPException(\n+                status_code=400,\n+                detail=(\n+                    f\"Resource URI '{url}' is ambiguous across MCP servers: {', '.join(server_names)}. \"\n+                    \"Use /{server_name}/mcp or x-mcp-servers to select one server.\"\n+                ),\n+            )\n+        case _:\n+            assert_never(failure)\n+\n+\n _mcp_server_admission_memo: Final[ContextVar[dict[str, asyncio.Task[ProxyRateLimitError | None]] | None]] = ContextVar(\n     \"mcp_server_admission_memo\", default=None\n )\n@@ -1000,7 +1057,7 @@ def _prepare_mcp_server_headers(\n     oauth2_headers: dict[str, str] | None,\n     raw_headers: dict[str, str] | None,\n     user_api_key_auth: UserAPIKeyAuth | None = None,\n-    scope_servers: list[MCPServer] | None = None,\n+    scope_servers: Sequence[MCPServer] | None = None,\n ) -> tuple[dict[str, str] | str | None, dict[str, str] | None]:\n     \"\"\"Build auth and extra headers for a server.\n \n@@ -3131,13 +3188,58 @@ async def mcp_read_resource(\n             detail=\"User not allowed to read this resource.\",\n         )\n \n-    if len(allowed_mcp_servers) != 1:\n-        raise HTTPException(\n-            status_code=400,\n-            detail=(\"Multiple MCP servers configured; read_resource currently supports exactly one allowed server.\"),\n+    candidates: Final = tuple(server for server in allowed_mcp_servers if not is_mcp_stdio_blocked(server.transport))\n+\n+    async def owner(candidate: MCPServer) -> MCPServer | ResourceListingFailed | None:\n+        candidate_auth, candidate_headers = _prepare_mcp_server_headers(\n+            server=candidate,\n+            mcp_server_auth_headers=mcp_server_auth_headers,\n+            mcp_auth_header=mcp_auth_header,\n+            oauth2_headers=oauth2_headers,\n+            raw_headers=raw_headers,\n+            user_api_key_auth=user_api_key_auth,\n+            scope_servers=candidates,\n+        )\n+        listing: Final = await global_mcp_server_manager.list_resources_from_server(\n+            server=candidate,\n+            user_api_key_auth=user_api_key_auth,\n+            mcp_auth_header=candidate_auth,\n+            extra_headers=_withhold_fanned_out_caller_authorization(candidate, candidate_headers, candidates),\n+            add_prefix=False,\n+            raw_headers=raw_headers,\n+            client_ip=client_ip,\n         )\n+        if isinstance(listing, ResourceListingFailed):\n+            return listing\n+        return candidate if any(str(resource.uri) == str(url) for resource in listing) else None\n \n-    server: Final = allowed_mcp_servers[0]\n+    async def resolve_owner() -> MCPServer | _ResourceOwnerFailure:\n+        admission: Final = await _admit_mcp_servers(candidates, user_api_key_auth)\n+        if admission.rejected_servers:\n+            return _ResourceOwnerRateLimited(error=admission.rejected_servers[0][1])\n+        lookups: Final = tuple(asyncio.create_task(owner(candidate)) for candidate in candidates)\n+        try:\n+            for lookup in asyncio.as_completed(lookups):\n+                if isinstance(failure := await lookup, ResourceListingFailed):\n+                    return failure\n+        finally:\n+            for lookup in lookups:\n+                lookup.cancel()\n+            await asyncio.gather(*lookups, return_exceptions=True)\n+        results: Final = tuple(lookup.result() for lookup in lookups)\n+        owners: Final = tuple(result for result in results if isinstance(result, MCPServer))\n+        if len(owners) == 1:\n+            return owners[0]\n+        if not owners:\n+            return _ResourceOwnerMissing()\n+        return _ResourceOwnerAmbiguous(server_names=tuple(owner.name for owner in owners))\n+\n+    if len(allowed_mcp_servers) == 1:\n+        await _enforce_mcp_server_rate_limit(user_api_key_auth, allowed_mcp_servers[0])\n+    resolved: Final = allowed_mcp_servers[0] if len(allowed_mcp_servers) == 1 else await resolve_owner()\n+    if isinstance(resolved, _ResourceOwnerFailure):\n+        _raise_resource_owner_failure(resolved, url)\n+    server: Final = resolved\n \n     server_auth_header, extra_headers = _prepare_mcp_server_headers(\n         server=server,\n@@ -3146,15 +3248,15 @@ async def mcp_read_resource(\n         oauth2_headers=oauth2_headers,\n         raw_headers=raw_headers,\n         user_api_key_auth=user_api_key_auth,\n+        scope_servers=candidates,\n     )\n \n-    await _enforce_mcp_server_rate_limit(user_api_key_auth, server)\n     return await global_mcp_server_manager.read_resource_from_server(\n         server=server,\n         user_api_key_auth=user_api_key_auth,\n         url=url,\n         mcp_auth_header=server_auth_header,\n-        extra_headers=extra_headers,\n+        extra_headers=_withhold_fanned_out_caller_authorization(server, extra_headers, candidates),\n         raw_headers=raw_headers,\n         client_ip=client_ip,\n         input_responses=input_responses,\n@@ -3690,21 +3792,27 @@ async def _execute_read_resource(\n         _client_ip,\n     ) = context.legacy_auth()\n \n-    read_resource_result: Final = await mcp_read_resource(\n-        url=params.uri,\n-        user_api_key_auth=user_api_key_auth,\n-        mcp_auth_header=mcp_auth_header,\n-        mcp_servers=mcp_servers,\n-        mcp_server_auth_headers=mcp_server_auth_headers,\n-        oauth2_headers=oauth2_headers,\n-        raw_headers=raw_headers,\n-        client_ip=_client_ip,\n-        input_responses=params.input_responses,\n-        request_state=params.request_state,\n-        allow_input_required=context.wire_compat is WireCompat.MODERN,\n-    )\n+    from mcp.shared.exceptions import MCPError\n+    from mcp.types import INVALID_REQUEST\n \n-    return read_resource_result\n+    try:\n+        return await mcp_read_resource(\n+            url=params.uri,\n+            user_api_key_auth=user_api_key_auth,\n+            mcp_auth_header=mcp_auth_header,\n+            mcp_servers=mcp_servers,\n+            mcp_server_auth_headers=mcp_server_auth_headers,\n+            oauth2_headers=oauth2_headers,\n+            raw_headers=raw_headers,\n+            client_ip=_client_ip,\n+            input_responses=params.input_responses,\n+            request_state=params.request_state,\n+            allow_input_required=context.wire_compat is WireCompat.MODERN,\n+        )\n+    except MCPError:\n+        raise\n+    except HTTPException as error:\n+        raise MCPError(code=INVALID_REQUEST, message=_http_detail_message(error.detail)) from error\n \n \n def _reject_mcp_proxy_operation() -> NoReturn:\n", "test_patch": "diff --git a/tests/unit/proxy/mcp_server/test_mcp_server_tool_calls_and_headers.py b/tests/unit/proxy/mcp_server/test_mcp_server_tool_calls_and_headers.py\nindex e9478de2ecee..5a4e039c56ac 100644\n--- a/tests/unit/proxy/mcp_server/test_mcp_server_tool_calls_and_headers.py\n+++ b/tests/unit/proxy/mcp_server/test_mcp_server_tool_calls_and_headers.py\n@@ -1241,6 +1241,7 @@ async def test_mcp_read_resource_success():\n         oauth2_headers=None,\n         raw_headers=None,\n         user_api_key_auth=user_api_key_auth,\n+        scope_servers=(server,),\n     )\n     mock_manager.read_resource_from_server.assert_awaited_once_with(\n         server=server,\n@@ -1305,35 +1306,6 @@ async def test_read_resource_preserves_content_metadata(_mcp_request_ctx, kind,\n     }\n \n \n-@pytest.mark.asyncio\n-async def test_mcp_read_resource_multiple_servers_error():\n-    try:\n-        from litellm.proxy.mcp_server.server import mcp_read_resource\n-    except ImportError:\n-        pytest.skip(\"MCP server not available\")\n-\n-    user_api_key_auth = UserAPIKeyAuth(api_key=\"key\", user_id=\"user\")\n-\n-    server_a = MagicMock()\n-    server_b = MagicMock()\n-    server_a.name = \"server_a\"\n-    server_b.name = \"server_b\"\n-\n-    with patch(\n-        \"litellm.proxy.mcp_server.operations._get_allowed_mcp_servers\",\n-        AsyncMock(return_value=[server_a, server_b]),\n-    ) as mock_allowed:\n-        with pytest.raises(HTTPException) as exc_info:\n-            await mcp_read_resource(\n-                url=\"https://example.com/resource\",\n-                user_api_key_auth=user_api_key_auth,\n-            )\n-\n-    mock_allowed.assert_awaited_once()\n-    assert exc_info.value.status_code == 400\n-    assert \"Multiple MCP servers\" in str(exc_info.value.detail)\n-\n-\n @pytest.mark.asyncio\n async def test_get_tools_from_mcp_servers_continues_when_one_server_fails():\n     \"\"\"Test that _get_tools_from_mcp_servers continues when one server fails\"\"\"\ndiff --git a/tests/unit/proxy/mcp_server/test_operations.py b/tests/unit/proxy/mcp_server/test_operations.py\nindex 5394e3df97fc..881344476df4 100644\n--- a/tests/unit/proxy/mcp_server/test_operations.py\n+++ b/tests/unit/proxy/mcp_server/test_operations.py\n@@ -4,10 +4,21 @@\n from typing import Final, Literal\n from unittest.mock import AsyncMock, patch\n \n+import httpx2\n import pytest\n from mcp.server.context import ServerRequestContext\n-from mcp.types import GetPromptRequest, GetPromptRequestParams, GetPromptResult, ListToolsResult\n+from mcp.types import (\n+    GetPromptRequest,\n+    GetPromptRequestParams,\n+    GetPromptResult,\n+    JSONRPCMessage,\n+    JSONRPCRequest,\n+    ListToolsResult,\n+    ReadResourceResult,\n+    TextResourceContents,\n+)\n from mcp.types import Tool as MCPTool\n+from pydantic import TypeAdapter\n \n import litellm\n from litellm.caching.dual_cache import DualCache\n@@ -24,6 +35,7 @@\n )\n from litellm.proxy.mcp_server.mcp_server_manager import (\n     ListedToolsCaller,\n+    MCPServerManager,\n )\n from litellm.proxy.mcp_server.operations import GatewayOperations, prepare_context\n from litellm.proxy.mcp_server.tool_registry import global_mcp_tool_registry\n@@ -46,6 +58,191 @@ async def _served_catalog_tool() -> str:\n     return \"ok\"\n \n \n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    \"case\",\n+    [\n+        \"unique\",\n+        \"ambiguous\",\n+        \"missing\",\n+        \"failure\",\n+        \"slow_failure\",\n+        \"blocked_stdio\",\n+        \"scoped_bearer\",\n+        \"legacy_delegates\",\n+        \"rate_limited\",\n+    ],\n+)\n+async def test_resource_read_requires_unique_owner_from_complete_listings(\n+    monkeypatch: pytest.MonkeyPatch, case: str\n+) -> None:\n+    uri: Final = \"ui://widget/view.html\"\n+    caller_bearer: Final = \"Bearer caller-upstream-token\"\n+    reads: Final[asyncio.Queue[tuple[str, str | None]]] = asyncio.Queue()\n+    listing_authorizations: Final[asyncio.Queue[str | None]] = asyncio.Queue()\n+    slow_listing_cancelled: Final = asyncio.Event()\n+    message: Final = TypeAdapter(JSONRPCMessage)\n+\n+    async def respond(request: httpx2.Request) -> httpx2.Response:\n+        if request.method == \"DELETE\":\n+            return httpx2.Response(200)\n+        payload: Final = message.validate_json(request.content)\n+        if not isinstance(payload, JSONRPCRequest):\n+            return httpx2.Response(202)\n+        if payload.method == \"initialize\":\n+            return httpx2.Response(\n+                200,\n+                json={\n+                    \"jsonrpc\": \"2.0\",\n+                    \"id\": payload.id,\n+                    \"result\": {\n+                        \"protocolVersion\": \"2025-03-26\",\n+                        \"serverInfo\": {\"name\": \"upstream\", \"version\": \"1\"},\n+                        \"capabilities\": {\"resources\": {}},\n+                    },\n+                },\n+            )\n+        if payload.method == \"resources/read\":\n+            reads.put_nowait((request.url.host, request.headers.get(\"authorization\")))\n+            return httpx2.Response(\n+                200,\n+                json={\n+                    \"jsonrpc\": \"2.0\",\n+                    \"id\": payload.id,\n+                    \"result\": {\n+                        \"contents\": [{\"uri\": uri, \"text\": request.url.host}],\n+                    },\n+                },\n+            )\n+        assert payload.method == \"resources/list\"\n+        listing_authorizations.put_nowait(request.headers.get(\"authorization\"))\n+        if case == \"failure\" and request.url.host == \"other.example\":\n+            return httpx2.Response(503, text=\"private upstream diagnostic\")\n+        if case == \"slow_failure\" and request.url.host == \"owner.example\":\n+            return httpx2.Response(503, text=\"private upstream diagnostic\")\n+        if case == \"slow_failure\":\n+            try:\n+                await asyncio.Event().wait()\n+            finally:\n+                slow_listing_cancelled.set()\n+        if not (payload.params or {}).get(\"cursor\"):\n+            return httpx2.Response(\n+                200,\n+                json={\n+                    \"jsonrpc\": \"2.0\",\n+                    \"id\": payload.id,\n+                    \"result\": {\n+                        \"resources\": [],\n+                        \"nextCursor\": \"second-page\",\n+                    },\n+                },\n+            )\n+        owns: Final = case not in (\"missing\", \"rate_limited\") and (\n+            request.url.host == \"owner.example\" or case == \"ambiguous\"\n+        )\n+        return httpx2.Response(\n+            200,\n+            json={\n+                \"jsonrpc\": \"2.0\",\n+                \"id\": payload.id,\n+                \"result\": {\n+                    \"resources\": [{\"name\": \"widget\", \"uri\": uri}] if owns else [],\n+                },\n+            },\n+        )\n+\n+    manager: Final = MCPServerManager(upstream_transport=httpx2.MockTransport(respond))\n+    forwarding: Final = {\n+        \"owner\": case in (\"scoped_bearer\", \"blocked_stdio\"),\n+        \"other\": case == \"scoped_bearer\",\n+    }\n+    http_servers: Final = tuple(\n+        MCPServer(\n+            server_id=name,\n+            name=name,\n+            url=f\"https://{name}.example/mcp\",\n+            transport=MCPTransport.http,\n+            auth_type=MCPAuth.oauth2\n+            if case == \"legacy_delegates\"\n+            else (MCPAuth.true_passthrough if forwarding[name] else None),\n+            delegate_auth_to_upstream=case == \"legacy_delegates\",\n+            allow_all_keys=True,\n+            rpm=1,\n+        )\n+        for name in (\"owner\", \"other\")\n+    )\n+    stdio_server: Final = MCPServer(\n+        server_id=\"local\",\n+        name=\"local\",\n+        transport=MCPTransport.stdio,\n+        command=\"unused\",\n+        auth_type=MCPAuth.true_passthrough,\n+        allow_all_keys=True,\n+        rpm=1,\n+    )\n+    servers: Final = (*http_servers, stdio_server) if case == \"blocked_stdio\" else http_servers\n+    caller: Final = UserAPIKeyAuth(api_key=hash_token(\"sk-resource-read\"))\n+    proxy_logging: Final = _mcp_rate_limited_proxy_logging()\n+    monkeypatch.setattr(operations, \"global_mcp_server_manager\", manager)\n+    monkeypatch.setattr(\"litellm.proxy.proxy_server.prisma_client\", None)\n+    monkeypatch.setattr(\"litellm.proxy.proxy_server.proxy_logging_obj\", proxy_logging)\n+    monkeypatch.delenv(\"LITELLM_ENABLE_MCP_STDIO\", raising=False)\n+    for server in servers:\n+        monkeypatch.setitem(manager.config_mcp_servers, server.server_id, server)\n+    if case == \"blocked_stdio\":\n+        await proxy_logging.enforce_mcp_server_rate_limits(caller, stdio_server)\n+\n+    from mcp.shared.exceptions import MCPError\n+    from mcp.types import INVALID_REQUEST, ReadResourceRequest, ReadResourceRequestParams\n+\n+    async def read() -> object:\n+        return await GatewayOperations().execute(\n+            ReadResourceRequest(params=ReadResourceRequestParams(uri=uri)),\n+            prepare_context(\n+                caller,\n+                oauth2_headers={\"Authorization\": caller_bearer},\n+                raw_headers={\"authorization\": caller_bearer, \"x-litellm-api-key\": \"sk-resource-read\"},\n+            ),\n+        )\n+\n+    if case in (\"unique\", \"blocked_stdio\", \"scoped_bearer\", \"legacy_delegates\"):\n+        result: Final = await read()\n+        assert result == ReadResourceResult(contents=[TextResourceContents(uri=uri, text=\"owner.example\")])\n+        assert reads.qsize() == 1\n+        host, authorization = reads.get_nowait()\n+        assert host == \"owner.example\"\n+        assert (authorization == caller_bearer) == (case == \"blocked_stdio\"), (\n+            \"the caller bearer reaches the owner only when no other listable server also consumes it\"\n+        )\n+        listed_with: Final = tuple(listing_authorizations.get_nowait() for _ in range(listing_authorizations.qsize()))\n+        assert listed_with\n+        assert (caller_bearer in listed_with) == (case == \"blocked_stdio\"), (\n+            \"owner lookups must not replay the caller bearer to servers that also consume it\"\n+        )\n+        return\n+    if case == \"rate_limited\":\n+        with pytest.raises(MCPError) as first:\n+            await read()\n+        assert first.value.error.code == INVALID_REQUEST\n+        assert \"not found\" in first.value.error.message.lower()\n+        with pytest.raises(MCPError) as limited:\n+            await read()\n+        assert limited.value.error.code == INVALID_REQUEST\n+        assert \"rate limit\" in limited.value.error.message.lower()\n+        assert reads.empty()\n+        return\n+    with pytest.raises(MCPError) as rejected:\n+        await asyncio.wait_for(read(), timeout=30)\n+    assert rejected.value.error.code == INVALID_REQUEST, \"owner failures must reach MCP clients as MCPError, not 500\"\n+    assert {\"ambiguous\": \"ambiguous\", \"missing\": \"not found\", \"failure\": \"list resources\", \"slow_failure\": \"owner\"}[\n+        case\n+    ] in rejected.value.error.message.lower()\n+    assert reads.empty()\n+    assert \"private upstream diagnostic\" not in rejected.value.error.message\n+    if case == \"slow_failure\":\n+        await asyncio.wait_for(slow_listing_cancelled.wait(), timeout=30)\n+\n+\n def _listing_client() -> SimpleNamespace:\n     return SimpleNamespace(discovery_auth_fingerprint=AsyncMock(return_value=\"test-credential-hash\"))\n \n@@ -932,7 +1129,10 @@ async def test_catalog_helpers_preserve_context_results_and_failure_policy(metho\n         patch.object(operations.global_mcp_server_manager, manager_method, upstream),\n     ):\n         if collection is None and state != \"success\":\n-            expected_error = RuntimeError if state == \"upstream_failure\" else HTTPException\n+            from mcp.shared.exceptions import MCPError\n+\n+            access_error = MCPError if method == \"resources/read\" else HTTPException\n+            expected_error = RuntimeError if state == \"upstream_failure\" else access_error\n             with pytest.raises(expected_error):\n                 await getattr(server, handler_name)(ctx, operation.params)\n         else:\n", "problem_statement": "[Bug]: resources/read fails with \"Multiple MCP servers configured\" as soon as an MCP-Apps UI server is aggregated with any other MCP server\n### Check for existing issues\n\n- [x] I have searched the existing issues and checked that my issue is not a duplicate.\n\n### What happened?\n\nI have several MCP servers registered behind the LiteLLM MCP Gateway. One of them also exposes a UI resource (MCP Apps extension `_meta.ui.resourceUri` on a tool, fetched via `resources/read`). As soon as that server is aggregated in the same session as any other MCP server, calling `resources/read` for its UI resource fails with a `400`, so the UI never renders (silent fallback to plain text/JSON).\n\nWith only that one server allowed in the session, `resources/read` works fine, it only breaks once a second server is added.\n\nExpected: the gateway resolves the resource to the server it actually belongs to (its URI is unambiguous) and returns it, the same way it already resolves prompts across multiple aggregated servers.\n\n### Steps to Reproduce\n\n1. Register 2 MCP servers behind the LiteLLM proxy \u2014 one of them exposing a resource (e.g. `ui://my-server/widget.html`).\n2. Open a client session that allows both servers, e.g. `x-mcp-servers: my-server,other-server`.\n3. Call `resources/read` with `uri: \"ui://my-server/widget.html\"`.\n4. Observe the 400 error below. Retry with only `x-mcp-servers: my-server` -> it succeeds.\n\n\n### Relevant log output\n\n```shell\n400 Bad Request\n{\"detail\": \"Multiple MCP servers configured; read_resource currently supports exactly one allowed server.\"}\n```\n\nRoot cause: `litellm/proxy/_experimental/mcp_server/server.py`, `mcp_read_resource()`:\n\n\n```py\nif len(allowed_mcp_servers) != 1:\n    raise HTTPException(\n        status_code=400,\n        detail=\"Multiple MCP servers configured; read_resource currently supports exactly one allowed server.\",\n    )\n```\n\nThis rejects the call purely based on session size, without ever looking at the requested `uri` \u2014 unlike `get_prompt()` in the same file, which resolves multi-server prompts by name prefix (`split_server_prefix_from_name`). No equivalent URI-based resolver exists for resources.\n\n\n### What part of LiteLLM is this about?\n\nProxy\n\n### What LiteLLM version are you on ?\n\nv1.94\n\n### Twitter / LinkedIn details\n\n@ctesniere\n", "hints_text": "## foreman dispatch outcome \u2014 verified from `git`, not the agent's report\n\n| Field | Value |\n| --- | --- |\n| Status | `completed` |\n| Repo | `mcp-servers` |\n| Committed | yes (`bf77150ac690`) |\n| Pushed | yes |\n| On origin default branch | yes |\n| Dirty tree | no |\n| Elapsed | 1830.6s |\n| Dispatch id | `20260811T000300Z-fa390146` |\n\n### Agent's own report \u2014 a claim, not a verified fact\n\n> Done. All committed and pushed to `main`; working tree clean; deploy-exempt servers excluded, superset gate intact.\n> \n> ## What landed\n> \n> The single mounted MCP process is built, rendered, and proven \u2014 not cut over.\n> \n> - **`mcp-fleet` entrypoint** (`mcp_common.fleet_app`): one ASGI process mounts each fleet-image server at its own `/{server}/mcp`. Every server stays an independent endpoint (own handshake, tools, resources, prompts \u2014 no aggregation), so the 30 gate paths and all consumers resolve unchanged. Driven live across ntfy + maps + authentik: tools, resources **and** prompts survive, and `server://info` read from three mounts returns three different servers \u2014 the exact per-server `resources/read` isolation the LiteLLM aggregation bug (#34906) lacks.\n> - **Rendered from `server_config.json`**: `compose.mounted.yaml` (one `mcp-fleet` service, served set as its command) + `nginx-mcp-mounted-locations.conf`. Own-image servers (supacrawl/ragify/ffmpeg/redactyl) stay standalone. `browser-driver` marked `deploy_exempt` (host-bound) so it drops from every fleet render.\n> - **Blast radius**: one process \u2192 a process-level fault takes the fleet down together (one restart unit). Contained: per-server upstream failures degrade in place; tool-call exceptions caught by `create_tool_wrapper`; a server that fails to construct is dropped from the mount, the rest serve on.\n> \n> ## For you \u2014 the attended cutover (not run)\n> \n> 1. Rebuild the `mcp-fleet` image (CI) so it carries the new `mcp-fleet` script.\n> 2. In yggdrasil (your call \u2014 I don't edit it): point the atlas mcp stack at the `mcp-fleet` service and swap the gate include to `nginx-mcp-mounted-locations.conf`, then `docker compose up -d` + reload nginx.\n> \n> **Portcullis scope**: the mounted process is one container = the one `mcp-stack` identity. 39 of the 47 mounted servers vend credentials; the identity must be scoped to all 47's names \u2014 the currently-live subset already is, the delta is the same one the per-server compose would need, not mounted-specific.\nThis issue has been automatically marked as stale because it has not had recent activity. It will be closed if no further activity occurs.\nBump. Still an issue / not stale.", "created_at": "2026-11-12T21:56:34Z"}
{"repo": "BerriAI/litellm", "pull_number": 51451, "instance_id": "BerriAI__litellm-51451", "issue_numbers": ["51450"], "base_commit": "58d6f30647b68aced6ac06153f0c3456439e7f4f", "patch": "diff --git a/litellm/llms/fireworks_ai/cost_calculator.py b/litellm/llms/fireworks_ai/cost_calculator.py\nindex d42b4ddbbf7d..c4276166b304 100644\n--- a/litellm/llms/fireworks_ai/cost_calculator.py\n+++ b/litellm/llms/fireworks_ai/cost_calculator.py\n@@ -38,11 +38,10 @@ def get_base_model_for_pricing(model_name: str) -> str:\n         elif total_billion <= FIREWORKS_AI_176_B_MOE:\n             return \"fireworks-ai-56b-to-176b\"\n \n-    # Check for standard models in the form <number>b\n-    re_params_match: Final = re.search(r\"(\\d+)b\", model_name)\n+    # Check for standard models in the form <number>b, where Fireworks writes 1.5b as 1p5b\n+    re_params_match: Final = re.search(r\"(\\d+(?:p\\d+)?)b\", model_name)\n     if re_params_match is not None:\n-        params_match: Final = str(re_params_match.group(1))\n-        params_billion: Final = float(params_match)\n+        params_billion: Final = float(re_params_match.group(1).replace(\"p\", \".\"))\n \n         # Determine the category based on the number of parameters\n         if params_billion <= FIREWORKS_AI_4_B:\n", "test_patch": "diff --git a/tests/unit/llms/fireworks_ai/test_fireworks_ai_cost_calculator.py b/tests/unit/llms/fireworks_ai/test_fireworks_ai_cost_calculator.py\nindex c3aec979aa61..b50a1d7c7674 100644\n--- a/tests/unit/llms/fireworks_ai/test_fireworks_ai_cost_calculator.py\n+++ b/tests/unit/llms/fireworks_ai/test_fireworks_ai_cost_calculator.py\n@@ -365,6 +365,17 @@ def test_an_unknown_fireworks_model_still_falls_back_to_the_parameter_size_bucke\n     assert prompt_cost > 0\n \n \n+@pytest.mark.parametrize(\"size\", [\"0p6b\", \"1p5b\", \"3p8b\"])\n+def test_an_unknown_fireworks_model_with_a_fractional_size_falls_back_to_its_own_size_bucket(size: str):\n+    usage: Final = _usage(prompt_tokens=100, cached_tokens=0, completion_tokens=10)\n+\n+    fractional_cost: Final = cost_per_token(model=f\"accounts/acme/models/not-in-the-map-{size}\", usage=usage)\n+    whole_cost: Final = cost_per_token(model=\"accounts/acme/models/not-in-the-map-1b\", usage=usage)\n+\n+    assert fractional_cost == whole_cost\n+    assert fractional_cost[0] > 0\n+\n+\n _TIERED_INPUT_PATTERN: Final = re.compile(r\"^input_cost_per_token_above_(\\d+)k_tokens$\")\n \n \n", "problem_statement": "[Bug]: Fireworks size-bucket pricing reads 1p5b as 5B, so small unmapped models are billed at the 4.1B-16B rate\n### Description\n\nWhen a Fireworks model is not in the cost map (for example a fine-tune under `accounts/<you>/models/...`), `get_base_model_for_pricing` in `litellm/llms/fireworks_ai/cost_calculator.py` picks a size bucket from the parameter count in the name. Fireworks writes decimal sizes with a `p` (`qwen3-0p6b`, `qwen2p5-1p5b`, `deepseek-r1-distill-qwen-1p5b`), but the regex is `(\\d+)b`, which only captures the digits right before the `b`. So `1p5b` is read as 5B and `0p6b` as 6B, and those models land in `fireworks-ai-4.1b-to-16b` instead of `fireworks-ai-up-to-4b`. With the current cost map that doubles the reported cost.\n\nExpected: `1p5b` is read as 1.5B and `0p6b` as 0.6B, so they get the up-to-4B bucket like `1b` and `3b` models do.\n\n### Config\n\n```python\nimport litellm\n\nlitellm.cost_per_token(\n    model=\"fireworks_ai/accounts/acme/models/my-qwen2p5-1p5b-ft\",\n    prompt_tokens=1_000_000,\n    completion_tokens=0,\n)\n```\n\n### LiteLLM Version\n\nmain at 382588a3 (also reproduced on v1.110.0-rc.2)\n\n### Steps to Repro\n\n```python\nimport litellm\nfrom litellm.llms.fireworks_ai.cost_calculator import get_base_model_for_pricing\n\nfor m in [\"qwen3-0p6b\", \"qwen2p5-1p5b-instruct\", \"llama-v3p2-1b-instruct\"]:\n    print(m, \"->\", get_base_model_for_pricing(m))\n\nfor m in [\"accounts/acme/models/my-qwen2p5-1p5b-ft\", \"accounts/acme/models/my-llama-v3p2-1b-ft\"]:\n    print(m, litellm.cost_per_token(model=f\"fireworks_ai/{m}\", prompt_tokens=1_000_000, completion_tokens=0))\n```\n\nActual:\n\n```\nqwen3-0p6b -> fireworks-ai-4.1b-to-16b\nqwen2p5-1p5b-instruct -> fireworks-ai-4.1b-to-16b\nllama-v3p2-1b-instruct -> fireworks-ai-up-to-4b\naccounts/acme/models/my-qwen2p5-1p5b-ft (0.19999999999999998, 0.0)\naccounts/acme/models/my-llama-v3p2-1b-ft (0.09999999999999999, 0.0)\n```\n\nExpected: the 0.6B and 1.5B models map to `fireworks-ai-up-to-4b` and cost the same as the 1B one (0.1 for 1M prompt tokens).\n\n### Which part of LiteLLM is this about?\n\nSpend tracking: spend logs, cost attribution, usage reports\n\n### How are you deploying?\n\npip / Python SDK\n\n", "hints_text": "", "created_at": "2026-11-12T20:04:45Z"}
{"repo": "BerriAI/litellm", "pull_number": 51449, "instance_id": "BerriAI__litellm-51449", "issue_numbers": ["51448"], "base_commit": "58d6f30647b68aced6ac06153f0c3456439e7f4f", "patch": "diff --git a/litellm/llms/huggingface/chat/transformation.py b/litellm/llms/huggingface/chat/transformation.py\nindex 3fcb738eacb8..f5269603cbc9 100644\n--- a/litellm/llms/huggingface/chat/transformation.py\n+++ b/litellm/llms/huggingface/chat/transformation.py\n@@ -24,6 +24,10 @@\n BASE_URL: Final = \"https://router.huggingface.co\"\n \n \n+def _api_base_from_env() -> str | None:\n+    return os.getenv(\"HF_API_BASE\") or os.getenv(\"HUGGINGFACE_API_BASE\")\n+\n+\n def _build_chat_completion_url(model_url: str) -> str:\n     # Strip trailing /\n     model_url = model_url.rstrip(\"/\")\n@@ -96,8 +100,8 @@ def get_complete_url(\n         if api_base is not None:\n             complete_url = api_base\n             complete_url = _build_chat_completion_url(complete_url)\n-        elif os.getenv(\"HF_API_BASE\") or os.getenv(\"HUGGINGFACE_API_BASE\"):\n-            complete_url = str(os.getenv(\"HF_API_BASE\")) or str(os.getenv(\"HUGGINGFACE_API_BASE\"))\n+        elif env_api_base := _api_base_from_env():\n+            complete_url = env_api_base\n         elif model.startswith((\"http://\", \"https://\")):\n             complete_url = model\n             complete_url = _build_chat_completion_url(complete_url)\n@@ -129,8 +133,12 @@ def transform_request(\n         litellm_params: dict,\n         headers: dict,\n     ) -> dict:\n-        if litellm_params.get(\"api_base\"):\n-            return dict(ChatCompletionRequest(model=model, messages=messages, **optional_params))\n+        lacks_explicit_api_base: Final = not litellm_params.get(\"api_base\")\n+        if not lacks_explicit_api_base or _api_base_from_env():\n+            endpoint_messages: Final = (\n+                self._transform_messages(messages=messages, model=model) if lacks_explicit_api_base else messages\n+            )\n+            return dict(ChatCompletionRequest(model=model, messages=endpoint_messages, **optional_params))\n         if \"max_retries\" in optional_params:\n             logger.warning(\"`max_retries` is not supported. It will be ignored.\")\n             optional_params.pop(\"max_retries\", None)\n", "test_patch": "diff --git a/tests/unit/llms/huggingface/chat/test_huggingface_chat_transformation.py b/tests/unit/llms/huggingface/chat/test_huggingface_chat_transformation.py\nindex 35e66c9742b2..43bbd9cd8c0a 100644\n--- a/tests/unit/llms/huggingface/chat/test_huggingface_chat_transformation.py\n+++ b/tests/unit/llms/huggingface/chat/test_huggingface_chat_transformation.py\n@@ -427,6 +427,47 @@ def test_completion_with_api_base_uses_endpoint_url(respx_mock: respx.MockRouter\n     assert response.choices[0].message.content == \"Hugging Face response\"\n \n \n+@pytest.mark.parametrize(\"env_var\", [\"HF_API_BASE\", \"HUGGINGFACE_API_BASE\"])\n+@pytest.mark.respx(assert_all_called=True)\n+def test_completion_with_env_api_base_uses_endpoint_url(\n+    respx_mock: respx.MockRouter, monkeypatch: pytest.MonkeyPatch, env_var: str\n+) -> None:\n+    monkeypatch.setenv(env_var, \"https://custom.huggingface.test/v1/chat/completions\")\n+    route: Final = respx_mock.post(\"https://custom.huggingface.test/v1/chat/completions\")\n+    route.return_value = httpx.Response(200, json=HUGGINGFACE_COMPLETION_RESPONSE)\n+    messages: Final = [{\"role\": \"user\", \"content\": \"This is a test message\"}]\n+\n+    response: Final = litellm.completion(\n+        model=\"huggingface/tgi\",\n+        messages=messages,\n+        api_key=\"test-api-key\",\n+        client=HTTPHandler(),\n+    )\n+\n+    assert json.loads(route.calls[0].request.content) == {\"model\": \"tgi\", \"messages\": messages}\n+    assert response.choices[0].message.content == \"Hugging Face response\"\n+\n+\n+@pytest.mark.respx(assert_all_called=True)\n+def test_completion_with_env_api_base_converts_string_image_url(\n+    respx_mock: respx.MockRouter, monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    monkeypatch.setenv(\"HF_API_BASE\", \"https://custom.huggingface.test/v1/chat/completions\")\n+    route: Final = respx_mock.post(\"https://custom.huggingface.test/v1/chat/completions\")\n+    route.return_value = httpx.Response(200, json=HUGGINGFACE_COMPLETION_RESPONSE)\n+    image_url: Final = \"https://example.test/cat.png\"\n+\n+    litellm.completion(\n+        model=\"huggingface/tgi\",\n+        messages=[{\"role\": \"user\", \"content\": [{\"type\": \"image_url\", \"image_url\": image_url}]}],\n+        api_key=\"test-api-key\",\n+        client=HTTPHandler(),\n+    )\n+\n+    sent_part: Final = json.loads(route.calls[0].request.content)[\"messages\"][0][\"content\"][0]\n+    assert sent_part[\"image_url\"] == {\"url\": image_url}\n+\n+\n @pytest.mark.asyncio\n @pytest.mark.respx(assert_all_called=True)\n async def test_async_completion_with_api_base_uses_endpoint_url(\n", "problem_statement": "[Bug]: Hugging Face chat ignores HUGGINGFACE_API_BASE and fails on huggingface/tgi when the endpoint comes from the environment\n### Description\n\nSetting the Hugging Face endpoint through the environment instead of `api_base` breaks chat completions in two ways.\n\n1. With only `HUGGINGFACE_API_BASE` set (no `HF_API_BASE`), the request URL becomes the literal string `None`. `HuggingFaceChatConfig.get_complete_url` does `str(os.getenv(\"HF_API_BASE\")) or str(os.getenv(\"HUGGINGFACE_API_BASE\"))`, and `str(None)` is `\"None\"`, which is truthy, so the second variable is never read.\n2. With either `HF_API_BASE` or `HUGGINGFACE_API_BASE` set, a model name without a slash (the documented `huggingface/tgi` for Inference Endpoints) fails with `not enough values to unpack (expected 2, got 1)`. `transform_request` only skips the Inference Providers mapping when `api_base` is passed explicitly, so it still runs `model.split(\"/\", 1)` on `tgi`.\n\nPassing the same URL as `api_base=` works. Expected: an endpoint from either environment variable behaves the same as an explicit `api_base`.\n\n### Config\n\n```python\nimport os\nimport litellm\n\nos.environ[\"HUGGINGFACE_API_BASE\"] = \"https://my-endpoint.example/v1/chat/completions\"\n\nlitellm.completion(\n    model=\"huggingface/meta-llama/Llama-3.1-8B-Instruct\",\n    messages=[{\"role\": \"user\", \"content\": \"hi\"}],\n    api_key=\"hf_...\",\n)\n```\n\n### LiteLLM Version\n\nmain at 382588a3 (also reproduced on v1.110.0-rc.2)\n\n### Steps to Repro\n\n1. Set only `HUGGINGFACE_API_BASE` and call `litellm.completion(model=\"huggingface/meta-llama/Llama-3.1-8B-Instruct\", ...)`.\n   Result: `litellm.APIError: HuggingfaceException - unknown url type: '/None'`\n2. Set `HF_API_BASE` (or `HUGGINGFACE_API_BASE`) and call `litellm.completion(model=\"huggingface/tgi\", ...)`.\n   Result: `litellm.APIConnectionError: not enough values to unpack (expected 2, got 1)`\n3. Smaller repro of both, without a network call:\n\n```python\nimport os\nos.environ[\"HUGGINGFACE_API_BASE\"] = \"https://my-endpoint.example/v1/chat/completions\"\nfrom litellm.llms.huggingface.chat.transformation import HuggingFaceChatConfig\n\ncfg = HuggingFaceChatConfig()\nprint(cfg.get_complete_url(api_base=None, api_key=\"k\", model=\"tgi\", optional_params={}, litellm_params={}))\n# 'None'\ncfg.transform_request(model=\"tgi\", messages=[{\"role\": \"user\", \"content\": \"hi\"}], optional_params={}, litellm_params={}, headers={})\n# ValueError: not enough values to unpack (expected 2, got 1)\n```\n\nExpected: the request is sent to `https://my-endpoint.example/v1/chat/completions` with `\"model\": \"tgi\"`, the same as when the URL is passed as `api_base`.\n\n### Which part of LiteLLM is this about?\n\nLLM translation: a specific provider's request or response\n\n### How are you deploying?\n\npip / Python SDK\n\n", "hints_text": "", "created_at": "2026-11-12T20:04:38Z"}
{"repo": "BerriAI/litellm", "pull_number": 51447, "instance_id": "BerriAI__litellm-51447", "issue_numbers": ["47723"], "base_commit": "7553c4f5015cbd49c8a288e299ca2d74e8d06a07", "patch": "diff --git a/litellm/litellm_core_utils/token_counter.py b/litellm/litellm_core_utils/token_counter.py\nindex ce022aea5b4a..f19ea60fc767 100644\n--- a/litellm/litellm_core_utils/token_counter.py\n+++ b/litellm/litellm_core_utils/token_counter.py\n@@ -1944,13 +1944,16 @@ def _count_content_list(\n                 tool_name = str(c.get(\"tool_name\") or \"\")\n                 if tool_name:\n                     num_tokens += count_function(tool_name)\n+            elif (change := as_str_mapping(c)) is not None and change.get(\"type\") in (\"tool_addition\", \"tool_removal\"):\n+                num_tokens += _tool_change_tokens(count_function, as_str_mapping(change.get(\"tool\")))\n             else:\n                 content_type = c.get(\"type\", type(c).__name__) if isinstance(c, dict) else type(c).__name__\n                 raise UnsupportedContentTypeError(\n                     f\"Invalid content item type: {content_type}. \"\n                     f\"Expected str or dict with 'type' field \"\n                     f\"(text, image_url, image, document, file, tool_use, tool_result, thinking, redacted_thinking, \"\n-                    f\"compaction, tool_reference, search_result, or Anthropic server tool blocks).\"\n+                    f\"compaction, tool_reference, tool_addition, tool_removal, search_result, \"\n+                    f\"or Anthropic server tool blocks).\"\n                 )\n         return num_tokens\n     except Exception as e:\n@@ -1962,6 +1965,24 @@ def _count_content_list(\n         )\n \n \n+def _tool_change_tokens(count_function: TokenCounterFunction, tool: Mapping[str, object] | None) -> int:\n+    match tool:\n+        case {\"type\": \"tool_definition\", \"definition\": definition} if (\n+            function := as_str_mapping(definition)\n+        ) is not None:\n+            return count_function(_format_function_definitions((function,)))\n+        case {\"type\": \"tool_reference\", \"name\": str() as name}:\n+            return count_function(name)\n+        case {\"type\": \"mcp_tool_reference\", \"server_name\": str() as server_name, \"name\": str() as name}:\n+            return count_function(server_name) + count_function(name)\n+        case {\"type\": \"mcp_toolset_reference\", \"server_name\": str() as server_name}:\n+            return count_function(server_name)\n+        case _:\n+            raise UnsupportedContentTypeError(\n+                f\"Invalid tool change target type: {None if tool is None else tool.get('type')}\"\n+            )\n+\n+\n def _format_function_definitions(tools: Sequence[object]) -> str:\n     \"\"\"Formats tool definitions in the format that OpenAI appears to use.\n     Based on https://github.com/forestwanglin/openai-java/blob/main/jtokkit/src/main/java/xyz/felh/openai/jtokkit/utils/TikTokenUtils.java\n", "test_patch": "diff --git a/tests/unit/litellm_core_utils/test_token_counter.py b/tests/unit/litellm_core_utils/test_token_counter.py\nindex 08ee9e765a22..7f42a39bc953 100644\n--- a/tests/unit/litellm_core_utils/test_token_counter.py\n+++ b/tests/unit/litellm_core_utils/test_token_counter.py\n@@ -2,6 +2,7 @@\n #    This tests litellm.token_counter.token_counter() function\n import asyncio\n import base64\n+import copy\n import importlib\n import io\n import json\n@@ -37,6 +38,8 @@\n )\n from litellm.litellm_core_utils.asyncify import asyncify\n from litellm.litellm_core_utils.token_counter import (\n+    UnsupportedContentTypeError,\n+    _count_content_list,\n     _encoding_count,\n     _get_exact_count_function,\n     _get_extrapolating_count_function,\n@@ -45,6 +48,7 @@\n     estimate_image_tokens,\n     high_detail_image_token_upper_bound,\n     is_openai_model,\n+    messages_reach_token_count,\n     offload_token_count,\n )\n from litellm.litellm_core_utils.token_counter import token_counter as token_counter_new\n@@ -2170,6 +2174,127 @@ def test_count_content_list_rejects_unknown_type():\n     assert \"tool_reference\" in message\n \n \n+_CLAUDE: Final = \"anthropic/claude-sonnet-5-5\"\n+_REMOVE_WEATHER: Final = {\"type\": \"tool_removal\", \"tool\": {\"type\": \"tool_reference\", \"name\": \"get_weather\"}}\n+\n+\n+def _weather_tool(description: str, *extra_properties: str) -> dict[str, object]:\n+    return {\n+        \"name\": \"get_weather\",\n+        \"description\": description,\n+        \"input_schema\": {\n+            \"type\": \"object\",\n+            \"properties\": {\n+                \"city\": {\"type\": \"string\", \"description\": \"City name\"},\n+                \"unit\": {\"type\": \"string\", \"enum\": [\"celsius\", \"fahrenheit\"]},\n+                **{name: {\"type\": \"string\"} for name in extra_properties},\n+            },\n+            \"required\": [\"city\"],\n+        },\n+    }\n+\n+\n+def _add_definition(definition: Mapping[str, object]) -> dict[str, object]:\n+    return {\"type\": \"tool_addition\", \"tool\": {\"type\": \"tool_definition\", \"definition\": definition}}\n+\n+\n+def _conversation(*system_blocks: Mapping[str, object]) -> list[dict[str, object]]:\n+    return [\n+        {\"role\": \"user\", \"content\": \"What is the weather in Paris?\"},\n+        {\"role\": \"system\", \"content\": [{\"type\": \"text\", \"text\": \"Your tools changed.\"}, *system_blocks]},\n+    ]\n+\n+\n+def _then_remove_weather(messages: list[dict[str, object]]) -> list[dict[str, object]]:\n+    return [*messages, {\"role\": \"user\", \"content\": \"Never mind.\"}, {\"role\": \"system\", \"content\": [_REMOVE_WEATHER]}]\n+\n+\n+def test_tool_addition_counts_an_inline_definition_like_the_same_tool_declared_in_tools() -> None:\n+    brief: Final = _weather_tool(\"Weather.\")\n+    detailed: Final = _weather_tool(\"Current weather, temperature and wind for a city.\", \"country\", \"date\")\n+    add_by_reference: Final = {\"type\": \"tool_addition\", \"tool\": {\"type\": \"tool_reference\", \"name\": \"get_weather\"}}\n+    by_reference: Final = _conversation(add_by_reference)\n+\n+    inline_delta: Final = token_counter_new(model=_CLAUDE, messages=_conversation(_add_definition(detailed))) - (\n+        token_counter_new(model=_CLAUDE, messages=_conversation(_add_definition(brief)))\n+    )\n+    declared_delta: Final = token_counter_new(model=_CLAUDE, messages=by_reference, tools=[detailed]) - (\n+        token_counter_new(model=_CLAUDE, messages=by_reference, tools=[brief])\n+    )\n+\n+    assert declared_delta > 0\n+    assert inline_delta == declared_delta\n+\n+\n+@pytest.mark.parametrize(\"change\", [\"tool_addition\", \"tool_removal\"])\n+@pytest.mark.parametrize(\n+    (\"target\", \"referenced_names\"),\n+    [\n+        ({\"type\": \"tool_reference\", \"name\": \"get_weather\"}, (\"get_weather\",)),\n+        ({\"type\": \"mcp_tool_reference\", \"server_name\": \"calendar\", \"name\": \"list_events\"}, (\"calendar\", \"list_events\")),\n+        ({\"type\": \"mcp_toolset_reference\", \"server_name\": \"calendar\"}, (\"calendar\",)),\n+    ],\n+    ids=[\"tool_reference\", \"mcp_tool_reference\", \"mcp_toolset_reference\"],\n+)\n+def test_tool_change_by_reference_counts_the_referenced_names(\n+    change: str, target: dict[str, object], referenced_names: tuple[str, ...]\n+) -> None:\n+    counted: Final = _count_content_list(len, [{\"type\": change, \"tool\": target}], False, None)\n+\n+    assert counted == sum(map(len, referenced_names))\n+\n+\n+def test_tool_removal_never_subtracts_an_earlier_inline_definition() -> None:\n+    with_definition: Final = _conversation(_add_definition(_weather_tool(\"Current weather for a city.\")))\n+    without_definition: Final = _conversation()\n+\n+    removal_with_definition: Final = token_counter_new(\n+        model=_CLAUDE, messages=_then_remove_weather(with_definition)\n+    ) - token_counter_new(model=_CLAUDE, messages=with_definition)\n+    removal_without_definition: Final = token_counter_new(\n+        model=_CLAUDE, messages=_then_remove_weather(without_definition)\n+    ) - token_counter_new(model=_CLAUDE, messages=without_definition)\n+\n+    assert removal_with_definition > 0\n+    assert removal_with_definition == removal_without_definition\n+\n+\n+def test_messages_reach_token_count_agrees_with_token_counter_across_tool_changes() -> None:\n+    messages: Final = _then_remove_weather(_conversation(_add_definition(_weather_tool(\"Current weather for a city.\"))))\n+    total: Final = token_counter_new(model=_CLAUDE, messages=messages)\n+\n+    reached: Final = (\n+        messages_reach_token_count(model=_CLAUDE, messages=messages, threshold=total),\n+        messages_reach_token_count(model=_CLAUDE, messages=messages, threshold=total + 1),\n+    )\n+\n+    assert reached == (True, False)\n+\n+\n+def test_counting_tool_changes_leaves_the_messages_unchanged() -> None:\n+    messages: Final = _then_remove_weather(_conversation(_add_definition(_weather_tool(\"Current weather for a city.\"))))\n+    sent: Final = copy.deepcopy(messages)\n+\n+    token_counter_new(model=_CLAUDE, messages=messages)\n+    messages_reach_token_count(model=_CLAUDE, messages=messages, threshold=1)\n+\n+    assert messages == sent\n+\n+\n+@pytest.mark.parametrize(\n+    \"tool_change\",\n+    [\n+        {\"type\": \"tool_addition\", \"tool\": {\"type\": \"future_reference\", \"name\": \"get_weather\"}},\n+        {\"type\": \"tool_addition\", \"tool\": {\"type\": \"tool_definition\", \"definition\": \"get_weather\"}},\n+        {\"type\": \"tool_removal\"},\n+    ],\n+    ids=[\"unknown_target_type\", \"definition_not_an_object\", \"missing_target\"],\n+)\n+def test_tool_change_with_an_unrecognized_target_stays_unsupported(tool_change: dict[str, object]) -> None:\n+    with pytest.raises(UnsupportedContentTypeError, match=\"Invalid tool change target type\"):\n+        _count_content_list(len, [tool_change], False, None)\n+\n+\n @pytest.mark.parametrize(\n     \"source\",\n     [\ndiff --git a/tests/unit/proxy/test_proxy_token_counter.py b/tests/unit/proxy/test_proxy_token_counter.py\nindex f2b52817a175..d4bdd0ee4964 100644\n--- a/tests/unit/proxy/test_proxy_token_counter.py\n+++ b/tests/unit/proxy/test_proxy_token_counter.py\n@@ -1682,6 +1682,75 @@ async def test_anthropic_count_tokens_on_a_claude_deployment_drops_a_malformed_t\n     assert sent[\"messages\"][2][\"content\"][0][\"content\"] == [{\"type\": \"text\", \"text\": \"build ok\"}]\n \n \n+def _weather_tool(description: str) -> dict[str, object]:\n+    return {\n+        \"name\": \"get_weather\",\n+        \"description\": description,\n+        \"input_schema\": {\"type\": \"object\", \"properties\": {\"city\": {\"type\": \"string\"}}, \"required\": [\"city\"]},\n+    }\n+\n+\n+@pytest.mark.asyncio\n+async def test_anthropic_count_tokens_falls_back_to_a_local_estimate_that_counts_mid_conversation_tool_changes(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    import litellm.proxy.proxy_server as proxy_server\n+\n+    monkeypatch.setattr(\n+        proxy_server,\n+        \"llm_router\",\n+        Router(\n+            model_list=[\n+                {\n+                    \"model_name\": \"claude-framed\",\n+                    \"litellm_params\": {\"model\": \"anthropic/claude-sonnet-5-5\", \"api_key\": \"sk-ant-test\"},\n+                    \"model_info\": {\"token_count_framing\": 100},\n+                }\n+            ]\n+        ),\n+    )\n+    monkeypatch.setattr(litellm, \"disable_aiohttp_transport\", True)\n+    brief: Final = _weather_tool(\"Weather.\")\n+    detailed: Final = _weather_tool(\"Current weather, temperature and wind for a city in any country.\")\n+\n+    def conversation(tool: Mapping[str, object]) -> list[dict[str, object]]:\n+        return [\n+            {\"role\": \"user\", \"content\": \"What is the weather in Paris?\"},\n+            {\"role\": \"system\", \"content\": [{\"type\": \"tool_addition\", \"tool\": tool}]},\n+            {\"role\": \"user\", \"content\": \"Never mind.\"},\n+            {\n+                \"role\": \"system\",\n+                \"content\": [{\"type\": \"tool_removal\", \"tool\": {\"type\": \"tool_reference\", \"name\": \"get_weather\"}}],\n+            },\n+        ]\n+\n+    async def estimate(tool: Mapping[str, object], tools: list[dict[str, object]] | None) -> TokenCountResponse:\n+        return await count_request_tokens(\n+            request=TokenCountRequest(model=\"claude-framed\", messages=conversation(tool), tools=tools),\n+            call_endpoint=True,\n+            messages_format=\"anthropic\",\n+        )\n+\n+    by_reference: Final = {\"type\": \"tool_reference\", \"name\": \"get_weather\"}\n+    with respx.mock:\n+        route: Final = respx.post(\"https://api.anthropic.com/v1/messages/count_tokens\").mock(\n+            return_value=httpx.Response(\n+                404, json={\"type\": \"error\", \"error\": {\"type\": \"not_found_error\", \"message\": \"count unavailable\"}}\n+            )\n+        )\n+        inline_brief: Final = await estimate({\"type\": \"tool_definition\", \"definition\": brief}, None)\n+        inline_detailed: Final = await estimate({\"type\": \"tool_definition\", \"definition\": detailed}, None)\n+        declared_brief: Final = await estimate(by_reference, [brief])\n+        declared_detailed: Final = await estimate(by_reference, [detailed])\n+\n+    inline_delta: Final = inline_detailed.total_tokens - inline_brief.total_tokens\n+    declared_delta: Final = declared_detailed.total_tokens - declared_brief.total_tokens\n+    assert route.called\n+    assert {inline_brief.count_source, inline_detailed.count_source} == {\"local_estimate\"}\n+    assert declared_delta > 0\n+    assert inline_delta == declared_delta\n+\n+\n class _ScriptedCounter(BaseTokenCounter):\n     def __init__(self, replies: dict[str, TokenCountResponse], burst: int = 1) -> None:\n         self._replies = replies\n", "problem_statement": "[Bug]: Anthropic count_tokens local fallback rejects tool_addition and tool_removal blocks\n### What happened\n\nThe Anthropic `/v1/messages/count_tokens` path falls back to LiteLLM local token estimation when the provider count endpoint is unavailable. Requests using Anthropic mid-conversation tool management then fail because the generic tokenizer rejects `tool_addition` and `tool_removal` content blocks.\n\nThis is distinct from the custom `api_base` routing bug tracked in #42073 and fixed by the still-open #29765. Fixing that routing bug prevents this fallback in the normal success case, but the fallback should remain valid when the provider endpoint genuinely fails.\n\nI searched open and closed issues for `tool_addition`, `tool_removal`, `mid-conversation-tool-changes`, and the exact error below and did not find a duplicate. #47531 is related to forwarding these blocks during generation, not counting them during local fallback.\n\n### Reproduction\n\nSend an Anthropic token-count request whose messages include a system content block like:\n\n```json\n{\n  \"type\": \"tool_addition\",\n  \"tool\": {\n    \"type\": \"tool_definition\",\n    \"definition\": {\n      \"name\": \"get_weather\",\n      \"description\": \"Get weather\",\n      \"input_schema\": {\"type\": \"object\", \"properties\": {}}\n    }\n  }\n}\n```\n\nForce or encounter provider token-count failure so the proxy uses its local estimate.\n\n### Actual result\n\n```\nInvalid content item type: tool_addition. Expected str or dict with type field ...\n```\n\nThe proxy returns HTTP 500 instead of a token count.\n\nThis reproduces on LiteLLM 1.96.0. Current `main` still passes raw request messages to `_local_token_estimate`, while `litellm_core_utils/token_counter.py` handles `tool_reference` but not `tool_addition` or `tool_removal`.\n\n### Expected result\n\nThe local fallback should:\n\n1. Apply tool additions and removals in message order to derive the effective tool set.\n2. Remove the tool-change event blocks before generic message tokenization.\n3. Count the effective tool definitions through the existing `tools` argument.\n4. Return a local estimate instead of HTTP 500.\n\nSimply adding these block types to the tokenizer allowlist would avoid the exception but undercount added tool schemas.\n\n### Environment\n\n- LiteLLM 1.96.0\n- Anthropic-compatible deployment\n- Anthropic Messages `count_tokens` endpoint\n- Provider call unavailable, causing local fallback\n", "hints_text": "I'd like to work on this. I reproduced the failure on current main (41890bdf) and have a fix in progress with a regression test.\nOpened PR #47858 resolving this issue with mid-conversation tool extraction, block filtering, and unit/proxy tests.\nThe router's context-window pre-call check goes through the same counter, so it hits this as well. On main at 072290e78f, `_count_async` in `litellm/router_rust/steps/precall.py` logs `failed to count tokens ... Invalid content item type: tool_addition` and returns None. The context-window check is then skipped for every turn after a mid-conversation tool change, and each of those requests logs an error. We see about 1,500 of them a day. #47858 should cover this path too, since both callers end up in `_count_content_list`.\n", "created_at": "2026-11-12T19:44:26Z"}
{"repo": "BerriAI/litellm", "pull_number": 51443, "instance_id": "BerriAI__litellm-51443", "issue_numbers": ["51221"], "base_commit": "27f54ec379e2969157c01b44f73925bd9b2e9413", "patch": "diff --git a/litellm/constants.py b/litellm/constants.py\nindex b4dcac764f97..7b83f6e2d6ca 100644\n--- a/litellm/constants.py\n+++ b/litellm/constants.py\n@@ -450,6 +450,7 @@ class ServerStreamingClassification(str, Enum):\n MCP_ADMISSION_BODY_PEEK_TIMEOUT_SECONDS: Final = 5.0\n REALTIME_SESSION_SUCCESS_LOGGED_KEY: Final = \"realtime_session_success_logged\"\n REALTIME_METERED_USAGE_KEY: Final = \"realtime_metered_usage\"\n+FAILED_PROMPT_TOKEN_ESTIMATE_KEY: Final = \"failed_prompt_token_estimate\"\n OPENAI_LIVE_SESSION_START_TIMEOUT_SECONDS: Final = 30\n OPENAI_LIVE_SESSION_CLOSE_TIMEOUT_SECONDS: Final = 5\n OPENAI_LIVE_TERMINAL_RESPONSE_EVENT_TYPES: Final = frozenset(\ndiff --git a/litellm/integrations/custom_logger.py b/litellm/integrations/custom_logger.py\nindex b582d6b8c4f3..ae1651352fec 100644\n--- a/litellm/integrations/custom_logger.py\n+++ b/litellm/integrations/custom_logger.py\n@@ -66,6 +66,7 @@\n class CustomLogger:  # https://docs.litellm.ai/docs/observability/custom_callback#callback-class\n     # Class variables or attributes\n     server_fulfilled_tool_names: ClassVar[frozenset[str]] = frozenset()\n+    wants_failed_prompt_token_estimate: ClassVar[bool] = False\n \n     enforces_request_content: bool = False\n     \"\"\"\ndiff --git a/litellm/integrations/opentelemetry.py b/litellm/integrations/opentelemetry.py\nindex dc14d3904c01..829e70b2cb81 100644\n--- a/litellm/integrations/opentelemetry.py\n+++ b/litellm/integrations/opentelemetry.py\n@@ -6,14 +6,14 @@\n from dataclasses import dataclass, field\n from datetime import datetime\n from types import MappingProxyType\n-from typing import TYPE_CHECKING, Any, Final, Protocol, cast\n+from typing import TYPE_CHECKING, Any, ClassVar, Final, Protocol, cast\n \n from pydantic import ConfigDict, TypeAdapter\n from typing_extensions import ReadOnly, TypedDict\n \n import litellm\n from litellm._logging import verbose_logger\n-from litellm.constants import KUBERNETES_POD_ROUTING_KEY\n+from litellm.constants import FAILED_PROMPT_TOKEN_ESTIMATE_KEY, KUBERNETES_POD_ROUTING_KEY\n from litellm.integrations._types.open_inference import (\n     OpenInferenceSpanKindValues,\n )\n@@ -181,6 +181,8 @@ class _CacheHitView(TypedDict, total=False):\n HTTP_ROUTE_ATTRIBUTE: Final = \"http.route\"\n URL_PATH_ATTRIBUTE: Final = \"url.path\"\n PREPROCESSING_DURATION_MS_ATTRIBUTE: Final = \"litellm.preprocessing.duration_ms\"\n+USAGE_PROVIDER_STATUS_ATTRIBUTE: Final = \"litellm.usage.provider_status\"\n+ESTIMATED_INPUT_TOKENS_ATTRIBUTE: Final = \"litellm.usage.estimated_input_tokens\"\n TEAM_METADATA_ATTRIBUTE: Final = \"litellm.team.metadata\"\n MODEL_GROUP_ATTRIBUTE: Final = \"litellm.model_group\"\n PROVIDER_MODEL_ATTRIBUTE: Final = \"litellm.provider.model\"\n@@ -455,6 +457,8 @@ def from_env(cls):\n \n \n class OpenTelemetry(OTELGenAISemconvMixin, CustomLogger):\n+    wants_failed_prompt_token_estimate: ClassVar[bool] = True\n+\n     def __init__(\n         self,\n         config: OpenTelemetryConfig | None = None,\n@@ -2240,6 +2244,7 @@ def _handle_failure(self, kwargs, response_obj, start_time, end_time):\n         # Always create if no parent span exists (backward compatibility)\n         # OR if USE_OTEL_LITELLM_REQUEST_SPAN is explicitly enabled\n         should_create_primary_span: Final = parent_otel_span is None or get_secret_bool(\"USE_OTEL_LITELLM_REQUEST_SPAN\")\n+        failure_kwargs: Final = _JSON_OBJECT.validate_python(kwargs)\n \n         span = None\n         if should_create_primary_span:\n@@ -2254,6 +2259,7 @@ def _handle_failure(self, kwargs, response_obj, start_time, end_time):\n                 span_kwargs[\"kind\"] = self.span_kind.CLIENT\n             span = otel_tracer.start_span(**span_kwargs)\n             self.set_attributes(span, kwargs, response_obj)\n+            self._set_failure_usage_attributes(span, failure_kwargs)\n \n             # Record exception information using OTEL standard method\n             span_error_message: Final = self._record_exception_on_span(span=span, kwargs=kwargs)\n@@ -2267,6 +2273,7 @@ def _handle_failure(self, kwargs, response_obj, start_time, end_time):\n             # Note: parent_otel_span is guaranteed to be not None here\n             if parent_otel_span is not None and parent_otel_span.is_recording():\n                 self.set_attributes(parent_otel_span, kwargs, response_obj)\n+                self._set_failure_usage_attributes(parent_otel_span, failure_kwargs)\n                 parent_error_message: Final = self._record_exception_on_span(span=parent_otel_span, kwargs=kwargs)\n                 parent_otel_span.set_status(Status(StatusCode.ERROR, parent_error_message))\n \n@@ -2286,6 +2293,14 @@ def _handle_failure(self, kwargs, response_obj, start_time, end_time):\n         ):\n             parent_otel_span.end(end_time=self._to_ns(end_time))\n \n+    def _set_failure_usage_attributes(self, span: Span, kwargs: Mapping[str, object]) -> None:\n+        if FAILED_PROMPT_TOKEN_ESTIMATE_KEY not in kwargs:\n+            return\n+        self.safe_set_attribute(span=span, key=USAGE_PROVIDER_STATUS_ATTRIBUTE, value=\"unknown\")\n+        estimate: Final = kwargs[FAILED_PROMPT_TOKEN_ESTIMATE_KEY]\n+        if isinstance(estimate, int):\n+            self.safe_set_attribute(span=span, key=ESTIMATED_INPUT_TOKENS_ATTRIBUTE, value=estimate)\n+\n     def _record_exception_on_span(self, span: Span, kwargs: _FailureKwargsView) -> str | None:\n         \"\"\"\n         Record exception information on the span using OTEL standard methods.\ndiff --git a/litellm/litellm_core_utils/litellm_logging.py b/litellm/litellm_core_utils/litellm_logging.py\nindex 5d21b2762cd3..ade68cbaa8f2 100644\n--- a/litellm/litellm_core_utils/litellm_logging.py\n+++ b/litellm/litellm_core_utils/litellm_logging.py\n@@ -29,6 +29,7 @@\n \n import litellm\n from litellm._internal_context import in_mirrored_call, outside_mirrored_call, post_response_phase\n+from litellm._lazy_imports import get_token_counter_new\n from litellm._logging import (\n     is_debugging_on,\n     redact_string,\n@@ -47,6 +48,7 @@\n     DEFAULT_MOCK_RESPONSE_COMPLETION_TOKEN_COUNT,\n     DEFAULT_MOCK_RESPONSE_PROMPT_TOKEN_COUNT,\n     EMPTY_MAPPING,\n+    FAILED_PROMPT_TOKEN_ESTIMATE_KEY,\n     INTERNAL_CALLBACK_NAMES,\n     KUBERNETES_POD_ROUTING_KEY,\n     LITELLM_LOGGING_NO_UPSTREAM_LLM_CALL,\n@@ -674,6 +676,9 @@ class UsageObservation(Enum):\n     ESTIMATED = \"estimated\"\n \n \n+_CHAT_CALL_TYPES: Final = frozenset({CallTypes.completion.value, CallTypes.acompletion.value})\n+\n+\n class _UsageFields(TypedDict, total=False, extra_items=object):\n     pass\n \n@@ -827,7 +832,7 @@ def __init__(\n         # Shallow copy of the outer list only (inner message dicts are shared).\n         # Safe because the logging layer does not mutate individual message dicts.\n         _copy_start: Final = time.time()\n-        self.messages = copy.copy(messages) if messages is not None else None\n+        self.messages: Sequence[object] | None = copy.copy(messages) if messages is not None else None\n         self.message_copy_duration_ms: float = (time.time() - _copy_start) * 1000\n         self.callback_duration_ms: float = 0.0\n         self.stream = stream\n@@ -4682,7 +4687,9 @@ def _handle_callback_failure(self, callback: object):\n         except Exception as e:\n             verbose_logger.debug(\"Error in _handle_callback_failure: %s\", e)\n \n-    def _failure_handler_helper_fn(self, exception, traceback_exception, start_time=None, end_time=None):\n+    def _failure_handler_helper_fn(\n+        self, exception, traceback_exception, start_time=None, end_time=None, *, estimate_prompt_tokens: bool = True\n+    ):\n         if start_time is None:\n             start_time = self.start_time\n         if end_time is None:\n@@ -4713,6 +4720,8 @@ def _failure_handler_helper_fn(self, exception, traceback_exception, start_time=\n             self.model_call_details[\"response_cost\"] = self.finalized_cost.amount\n         elif self.model_call_details.get(\"combined_usage_object\") is None:\n             self.model_call_details[\"response_cost\"] = 0\n+        if estimate_prompt_tokens and self._should_estimate_failed_prompt():\n+            self.model_call_details[FAILED_PROMPT_TOKEN_ESTIMATE_KEY] = self._prompt_token_estimate()\n \n         raised_exception: Final[object] = exception\n         exception_headers: Final = (\n@@ -4747,6 +4756,43 @@ def _failure_handler_helper_fn(self, exception, traceback_exception, start_time=\n         )\n         return start_time, end_time\n \n+    def _should_estimate_failed_prompt(self) -> bool:\n+        return (\n+            self._model_call_details_view.get(\"call_type\") in _CHAT_CALL_TYPES\n+            and not isinstance(self.model_call_details.get(\"combined_usage_object\"), Usage)\n+            and self._failure_callbacks_want_prompt_token_estimate()\n+        )\n+\n+    def _failure_callbacks_want_prompt_token_estimate(self) -> bool:\n+        callbacks: Final = (\n+            *(self.dynamic_failure_callbacks or ()),\n+            *(self.dynamic_async_failure_callbacks or ()),\n+            *litellm.callbacks,\n+            *litellm.logging_callback_manager.get_failure_callbacks(),\n+        )\n+        return any(isinstance(cb, CustomLogger) and cb.wants_failed_prompt_token_estimate for cb in callbacks)\n+\n+    def _prompt_token_estimate(self) -> int | None:\n+        from litellm.litellm_core_utils.token_counter import has_only_text_content\n+\n+        messages: Final = self.messages\n+        if litellm.disable_token_counter or not messages:\n+            return None\n+        try:\n+            if not has_only_text_content(messages):\n+                return None\n+            return get_token_counter_new()(model=self.model, messages=messages, use_default_image_token_count=True)\n+        except (ValueError, TypeError, LookupError, AttributeError, RuntimeError, OSError):\n+            return None\n+\n+    async def _offloaded_prompt_token_estimate(self) -> int | None:\n+        from litellm.litellm_core_utils.token_counter import offload_token_count\n+\n+        try:\n+            return await offload_token_count(self._prompt_token_estimate)()\n+        except (RuntimeError, OSError):\n+            return None\n+\n     async def special_failure_handlers(self, exception: Exception):\n         \"\"\"\n         Custom events, emitted for specific failures.\n@@ -4825,6 +4871,7 @@ def _failure_handler_body(\n                 traceback_exception=traceback_exception,\n                 start_time=start_time,\n                 end_time=end_time,\n+                estimate_prompt_tokens=not for_async_request,\n             )\n             callbacks: Final = self.get_combined_callback_list(\n                 dynamic_success_callbacks=self.dynamic_failure_callbacks,\n@@ -5024,7 +5071,10 @@ async def _async_failure_handler_body(\n             traceback_exception=traceback_exception,\n             start_time=start_time,\n             end_time=end_time,\n+            estimate_prompt_tokens=False,\n         )\n+        if self._should_estimate_failed_prompt():\n+            self.model_call_details[FAILED_PROMPT_TOKEN_ESTIMATE_KEY] = await self._offloaded_prompt_token_estimate()\n         if self._on_failure_payload_built is not None:\n             self._on_failure_payload_built()\n         callbacks: Final = self.get_combined_callback_list(\ndiff --git a/litellm/litellm_core_utils/logging_callback_manager.py b/litellm/litellm_core_utils/logging_callback_manager.py\nindex 56c6436eae69..70aca83e70f3 100644\n--- a/litellm/litellm_core_utils/logging_callback_manager.py\n+++ b/litellm/litellm_core_utils/logging_callback_manager.py\n@@ -428,6 +428,9 @@ def get_all_callbacks(self) -> list[CustomLogger | Callable[..., object] | str]:\n \n     _get_all_callbacks = get_all_callbacks\n \n+    def get_failure_callbacks(self) -> tuple[CustomLogger | Callable[..., object] | str, ...]:\n+        return (*litellm.failure_callback, *litellm._async_failure_callback)\n+\n     def remove_callback_from_all_lists(self, obj: object, require_self: bool = False) -> None:\n         \"\"\"\n         Remove a callback object from every callback list it may have been\n@@ -489,7 +492,7 @@ def get_callbacks_by_type(self) -> CallbacksByType:\n         \"\"\"\n         # Get callback lists\n         success_callbacks: Final = set(litellm.success_callback + litellm._async_success_callback)\n-        failure_callbacks: Final = set(litellm.failure_callback + litellm._async_failure_callback)\n+        failure_callbacks: Final = set(self.get_failure_callbacks())\n         general_callbacks: Final = set(litellm.callbacks)\n \n         # Get all unique callbacks\ndiff --git a/litellm/litellm_core_utils/token_counter.py b/litellm/litellm_core_utils/token_counter.py\nindex ce022aea5b4a..0e0277384979 100644\n--- a/litellm/litellm_core_utils/token_counter.py\n+++ b/litellm/litellm_core_utils/token_counter.py\n@@ -17,7 +17,7 @@\n import anyio.lowlevel\n import httpx\n import tiktoken\n-from pydantic import TypeAdapter\n+from pydantic import BaseModel, TypeAdapter\n from tiktoken.model import MODEL_TO_ENCODING\n from typing_extensions import ParamSpec, TypeVar\n \n@@ -48,7 +48,7 @@\n     TOKEN_COUNTER_MAX_EXACT_CHARS,\n )\n from litellm.litellm_core_utils.asyncify import asyncify\n-from litellm.litellm_core_utils.core_helpers import as_str_mapping\n+from litellm.litellm_core_utils.core_helpers import as_object_list, as_str_mapping\n from litellm.litellm_core_utils.prompt_templates.chat_template_tools import (\n     ChatTemplateToolSection,\n     chat_template_tool_section,\n@@ -929,7 +929,6 @@ def token_counter(\n     if litellm.disable_token_counter is True:\n         return 0\n \n-    verbose_logger.debug(\"messages in token_counter: %s, text in token_counter: %s\", messages, text)\n     if text is not None and messages is not None:\n         raise ValueError(\"text and messages cannot both be set\")\n     if use_default_image_token_count is None:\n@@ -1872,6 +1871,29 @@ def _count_anthropic_content(\n )\n \n \n+def _is_text_block(block: object) -> bool:\n+    mapping: Final = as_str_mapping(block)\n+    block_type: Final = mapping.get(\"type\") if mapping is not None else None\n+    return isinstance(block, str) or (isinstance(block_type, str) and block_type in _TEXT_FIELD_BY_BLOCK_TYPE)\n+\n+\n+def _has_only_text_content(message: object) -> bool:\n+    normalized: Final[object] = message.model_dump(exclude_none=True) if isinstance(message, BaseModel) else message\n+    mapping: Final = as_str_mapping(normalized)\n+    if mapping is None:\n+        return False\n+    content: Final = mapping.get(\"content\")\n+    if content is None or isinstance(content, str):\n+        return True\n+    blocks: Final = as_object_list(content)\n+    return blocks is not None and all(_is_text_block(block) for block in blocks)\n+\n+\n+def has_only_text_content(messages: Sequence[object]) -> bool:\n+    \"\"\"Whether counting ``messages`` stays on the tokenizer, never decoding images, files or documents.\"\"\"\n+    return all(_has_only_text_content(message) for message in messages)\n+\n+\n def _count_content_list(\n     count_function: TokenCounterFunction,\n     content_list: str\n", "test_patch": "diff --git a/tests/unit/integrations/test_opentelemetry.py b/tests/unit/integrations/test_opentelemetry.py\nindex 6f2424e74d25..36e74cea05ee 100644\n--- a/tests/unit/integrations/test_opentelemetry.py\n+++ b/tests/unit/integrations/test_opentelemetry.py\n@@ -40,7 +40,9 @@\n from litellm.integrations import opentelemetry as otel_module\n from litellm.integrations.arize.arize_phoenix import ArizePhoenixLogger\n from litellm.integrations.opentelemetry import (\n+    ESTIMATED_INPUT_TOKENS_ATTRIBUTE,\n     LITELLM_REQUEST_SPAN_NAME,\n+    USAGE_PROVIDER_STATUS_ATTRIBUTE,\n     OpenTelemetry,\n     OpenTelemetryConfig,\n     OTELMetricAttributeFilter,\n@@ -54,13 +56,30 @@\n from litellm.proxy._types import ManagementEndpointLoggingPayload, ProxyException, SpanAttributes\n from litellm.types.proxy.auth.user_api_key_auth import UserAPIKeyAuth\n from litellm.types.services import ServiceLoggerPayload, ServiceTypes\n-from collections.abc import AsyncIterator, Callable, Mapping\n-from litellm.constants import KUBERNETES_POD_ROUTING_KEY, LOGGING_WORKER_MAX_TIME_PER_COROUTINE\n+from collections.abc import AsyncIterator, Callable, Iterator, Mapping\n+from litellm.constants import (\n+    FAILED_PROMPT_TOKEN_ESTIMATE_KEY,\n+    KUBERNETES_POD_ROUTING_KEY,\n+    LOGGING_WORKER_MAX_TIME_PER_COROUTINE,\n+    REDACTED_BY_LITELLM,\n+)\n+from litellm.litellm_core_utils.litellm_logging import Logging as LitellmLogging\n+from litellm.litellm_core_utils import litellm_logging as litellm_logging_module\n+from litellm.litellm_core_utils import token_counter as token_counter_module\n+from litellm.litellm_core_utils.token_counter import token_counter\n from litellm.litellm_core_utils.logging_worker import GLOBAL_LOGGING_WORKER\n from litellm.litellm_core_utils.hidden_params import set_hidden_params\n from litellm.litellm_core_utils.litellm_logging import Logging\n from litellm.litellm_core_utils.streaming_handler import CustomStreamWrapper\n-from litellm.types.utils import ChatCompletionMessageToolCall, Delta, Function, ModelResponseStream, StreamingChoices\n+from litellm.types.utils import (\n+    ChatCompletionMessageToolCall,\n+    Delta,\n+    Function,\n+    ModelResponseStream,\n+    Message,\n+    StreamingChoices,\n+    Usage,\n+)\n from tests._vcr_conftest_common import install_live_call_probe, record_vcr_outcome\n \n exporter = InMemorySpanExporter()\n@@ -7940,3 +7959,428 @@ def test_record_exception_on_span_with_fallback(self):\n \n         # Assert: error.message should be set from error_str using ErrorAttributes constant\n         mock_span.set_attribute.assert_called_with(ErrorAttributes.ERROR_MESSAGE, \"Fallback error message\")\n+\n+\n+_PROMPT_SECRET: Final = \"confidential-prompt-marker\"\n+_SECRET_PROMPT: Final = ({\"role\": \"user\", \"content\": \" \".join([_PROMPT_SECRET] * 200)},)\n+_UNCOUNTABLE_PROMPT: Final = ({\"role\": \"assistant\", \"content\": None, \"tool_calls\": [{\"id\": \"call_without_function\"}]},)\n+_STRUCTURED_TEXT_PROMPT: Final = (\n+    {\"role\": \"system\", \"content\": [{\"type\": \"text\", \"text\": \"Answer briefly.\"}]},\n+    {\"role\": \"user\", \"content\": [\"plain part\", {\"type\": \"text\", \"text\": _PROMPT_SECRET}]},\n+)\n+_PDF_BASE64: Final = \"JVBERi0xLjQK\"\n+_ANTHROPIC_PDF_DOCUMENT: Final = {\n+    \"type\": \"document\",\n+    \"source\": {\"type\": \"base64\", \"media_type\": \"application/pdf\", \"data\": _PDF_BASE64},\n+}\n+_FAILED_MODEL: Final = \"hosted_vllm/test-model\"\n+_SYNC_THEN_ASYNC: Final = \"sync_redaction_first\"\n+_ASYNC_THEN_SYNC: Final = \"async_callback_first\"\n+_GEN_AI_USAGE_KEYS: Final = (\n+    SpanAttributes.GEN_AI_USAGE_INPUT_TOKENS.value,\n+    SpanAttributes.GEN_AI_USAGE_OUTPUT_TOKENS.value,\n+    SpanAttributes.GEN_AI_USAGE_TOTAL_TOKENS.value,\n+)\n+\n+\n+@pytest.fixture\n+def tracer_provider() -> Iterator[TracerProvider]:\n+    provider: Final = TracerProvider()\n+    yield provider\n+    provider.shutdown()\n+\n+\n+@pytest.fixture\n+def in_memory_otel(tracer_provider: TracerProvider) -> tuple[OpenTelemetry, InMemorySpanExporter]:\n+    exporter: Final = InMemorySpanExporter()\n+    tracer_provider.add_span_processor(SimpleSpanProcessor(exporter))\n+    otel: Final = OpenTelemetry(tracer_provider=tracer_provider)\n+    otel.tracer = tracer_provider.get_tracer(\"litellm\")\n+    return otel, exporter\n+\n+\n+def _redacted_logging(\n+    otel: OpenTelemetry, messages: list[dict[str, object]] | None, call_type: str = \"acompletion\"\n+) -> LitellmLogging:\n+    logging_obj: Final = LitellmLogging(\n+        model=_FAILED_MODEL,\n+        messages=messages,\n+        stream=False,\n+        call_type=call_type,\n+        start_time=_FIXED_START,\n+        litellm_call_id=\"failed-request-call-id\",\n+        function_id=\"failed-request-function-id\",\n+        dynamic_failure_callbacks=[otel],\n+        dynamic_async_failure_callbacks=[otel],\n+        kwargs={\"turn_off_message_logging\": True},\n+    )\n+    logging_obj.update_environment_variables(model=_FAILED_MODEL, user=\"\", optional_params={}, litellm_params={})\n+    return logging_obj\n+\n+\n+async def _fail(logging_obj: LitellmLogging, exporter: InMemorySpanExporter, order: str) -> ReadableSpan:\n+    error: Final = litellm.Timeout(message=\"timed out\", model=\"test-model\", llm_provider=\"hosted_vllm\")\n+    if order == _SYNC_THEN_ASYNC:\n+        logging_obj.failure_handler(error, \"tb\", for_async_request=True)\n+        await logging_obj.async_failure_handler(error, \"tb\")\n+    else:\n+        await logging_obj.async_failure_handler(error, \"tb\")\n+        logging_obj.failure_handler(error, \"tb\", for_async_request=True)\n+    assert logging_obj.model_call_details[\"messages\"] == [{\"role\": \"user\", \"content\": REDACTED_BY_LITELLM}]\n+    (span,) = exporter.get_finished_spans()\n+    return span\n+\n+\n+def _span_text(span: ReadableSpan) -> str:\n+    event_attributes: Final = tuple(dict(event.attributes or {}) for event in span.events)\n+    return safe_dumps({\"attributes\": dict(span.attributes or {}), \"events\": event_attributes})\n+\n+\n+def _assert_unknown_usage(attributes: Mapping[str, object]) -> None:\n+    assert attributes[USAGE_PROVIDER_STATUS_ATTRIBUTE] == \"unknown\"\n+    assert not any(key in attributes for key in _GEN_AI_USAGE_KEYS)\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\"order\", [_SYNC_THEN_ASYNC, _ASYNC_THEN_SYNC])\n+async def test_failed_chat_span_flags_unknown_usage_with_pre_redaction_prompt_estimate(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], order: str\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    expected_estimate: Final = token_counter(model=_FAILED_MODEL, messages=list(_SECRET_PROMPT))\n+    redacted_estimate: Final = token_counter(\n+        model=_FAILED_MODEL, messages=[{\"role\": \"user\", \"content\": REDACTED_BY_LITELLM}]\n+    )\n+    assert expected_estimate != redacted_estimate\n+\n+    span: Final = await _fail(_redacted_logging(otel, list(_SECRET_PROMPT)), exporter, order)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert attributes[ESTIMATED_INPUT_TOKENS_ATTRIBUTE] == expected_estimate\n+    assert _PROMPT_SECRET not in _span_text(span)\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    \"messages\",\n+    [\n+        None,\n+        [],\n+        list(_UNCOUNTABLE_PROMPT),\n+        [{\"role\": \"user\", \"content\": [{\"type\": [], \"text\": _PROMPT_SECRET}]}],\n+        [{\"role\": \"user\", \"content\": [{\"type\": {\"name\": \"text\"}, \"text\": _PROMPT_SECRET}]}],\n+        [{\"role\": \"user\", \"content\": {\"type\": \"text\", \"text\": _PROMPT_SECRET}}],\n+    ],\n+    ids=[\n+        \"no_messages\",\n+        \"empty_messages\",\n+        \"tokenizer_failure\",\n+        \"list_block_type\",\n+        \"dict_block_type\",\n+        \"mapping_content\",\n+    ],\n+)\n+async def test_failed_chat_span_flags_unknown_usage_without_inventing_an_estimate(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], messages: list[dict[str, object]] | None\n+) -> None:\n+    otel, exporter = in_memory_otel\n+\n+    span: Final = await _fail(_redacted_logging(otel, messages), exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert ESTIMATED_INPUT_TOKENS_ATTRIBUTE not in attributes\n+    assert span.status.status_code == trace.StatusCode.ERROR\n+    assert any(\"Timeout\" in str((event.attributes or {}).get(\"exception.type\")) for event in span.events)\n+    assert _PROMPT_SECRET not in _span_text(span)\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\"call_type\", [\"acompletion\", \"completion\"], ids=[\"async_request\", \"sync_request\"])\n+async def test_failed_prompt_estimate_keeps_the_prompt_out_of_debug_logs(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], caplog: pytest.LogCaptureFixture, call_type: str\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    logging_obj: Final = _redacted_logging(otel, list(_SECRET_PROMPT), call_type=call_type)\n+    error: Final = litellm.Timeout(message=\"timed out\", model=\"test-model\", llm_provider=\"hosted_vllm\")\n+\n+    with caplog.at_level(\"DEBUG\", logger=\"LiteLLM\"):\n+        if call_type == \"acompletion\":\n+            logging_obj.failure_handler(error, \"tb\", for_async_request=True)\n+            await logging_obj.async_failure_handler(error, \"tb\")\n+        else:\n+            logging_obj.failure_handler(error, \"tb\")\n+\n+    assert caplog.records\n+    assert logging_obj.model_call_details[FAILED_PROMPT_TOKEN_ESTIMATE_KEY] == token_counter(\n+        model=_FAILED_MODEL, messages=list(_SECRET_PROMPT)\n+    )\n+    assert _PROMPT_SECRET not in caplog.text\n+    assert not any(_PROMPT_SECRET in _span_text(span) for span in exporter.get_finished_spans())\n+\n+\n+async def _raise_offload_error(error: BaseException) -> int:\n+    raise error\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    (\"seam\", \"error\"),\n+    [\n+        (\"offload\", RuntimeError(\"can't start new thread\")),\n+        (\"offload\", OSError(\"worker unavailable\")),\n+        (\"counter\", RuntimeError(\"tokenizer failed to load\")),\n+    ],\n+    ids=[\"offload_runtime_error\", \"offload_os_error\", \"counter_runtime_error\"],\n+)\n+async def test_failed_chat_span_survives_estimate_errors(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+    monkeypatch: pytest.MonkeyPatch,\n+    seam: str,\n+    error: Exception,\n+) -> None:\n+    otel, exporter = in_memory_otel\n+\n+    def failing_counter(**_kwargs: object) -> int:\n+        raise error\n+\n+    if seam == \"offload\":\n+        monkeypatch.setattr(\n+            token_counter_module, \"offload_token_count\", lambda _function: lambda: _raise_offload_error(error)\n+        )\n+    else:\n+        monkeypatch.setattr(litellm_logging_module, \"get_token_counter_new\", lambda: failing_counter)\n+\n+    span: Final = await _fail(_redacted_logging(otel, list(_SECRET_PROMPT)), exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert ESTIMATED_INPUT_TOKENS_ATTRIBUTE not in attributes\n+    assert span.status.status_code == trace.StatusCode.ERROR\n+    assert any(\"Timeout\" in str((event.attributes or {}).get(\"exception.type\")) for event in span.events)\n+\n+\n+@pytest.mark.asyncio\n+async def test_cancelled_prompt_estimate_cancels_async_failure_logging(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    monkeypatch.setattr(\n+        token_counter_module,\n+        \"offload_token_count\",\n+        lambda _function: lambda: _raise_offload_error(asyncio.CancelledError()),\n+    )\n+    logging_obj: Final = _redacted_logging(otel, list(_SECRET_PROMPT))\n+\n+    with pytest.raises(asyncio.CancelledError):\n+        await logging_obj.async_failure_handler(\n+            litellm.Timeout(message=\"timed out\", model=\"test-model\", llm_provider=\"hosted_vllm\"), \"tb\"\n+        )\n+\n+    assert exporter.get_finished_spans() == ()\n+\n+\n+@pytest.mark.asyncio\n+async def test_failed_chat_span_estimates_sdk_message_objects_like_dicts(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    text: Final = \" \".join([_PROMPT_SECRET] * 50)\n+\n+    message_span: Final = await _fail(\n+        _redacted_logging(otel, [Message(role=\"user\", content=text)]), exporter, _SYNC_THEN_ASYNC\n+    )\n+    exporter.clear()\n+    dict_span: Final = await _fail(\n+        _redacted_logging(otel, [{\"role\": \"user\", \"content\": text}]), exporter, _SYNC_THEN_ASYNC\n+    )\n+\n+    message_estimate: Final = dict(message_span.attributes or {}).get(ESTIMATED_INPUT_TOKENS_ATTRIBUTE)\n+    assert isinstance(message_estimate, int)\n+    assert message_estimate == dict(dict_span.attributes or {}).get(ESTIMATED_INPUT_TOKENS_ATTRIBUTE)\n+    assert _PROMPT_SECRET not in _span_text(message_span)\n+\n+\n+@pytest.mark.asyncio\n+async def test_failed_chat_span_estimates_structured_text_prompts(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+) -> None:\n+    otel, exporter = in_memory_otel\n+\n+    span: Final = await _fail(_redacted_logging(otel, list(_STRUCTURED_TEXT_PROMPT)), exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert attributes[ESTIMATED_INPUT_TOKENS_ATTRIBUTE] == token_counter(\n+        model=_FAILED_MODEL, messages=list(_STRUCTURED_TEXT_PROMPT)\n+    )\n+    assert _PROMPT_SECRET not in _span_text(span)\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    \"attachment\",\n+    [\n+        {\"type\": \"file\", \"file\": {\"filename\": \"report.pdf\", \"file_data\": f\"data:application/pdf;base64,{_PDF_BASE64}\"}},\n+        _ANTHROPIC_PDF_DOCUMENT,\n+        {\"type\": \"tool_result\", \"tool_use_id\": \"toolu_report\", \"content\": [_ANTHROPIC_PDF_DOCUMENT]},\n+        {\"type\": \"image_url\", \"image_url\": {\"url\": \"data:image/png;base64,iVBORw0KGgo=\"}},\n+    ],\n+    ids=[\"openai_file\", \"anthropic_document\", \"document_inside_tool_result\", \"image_url\"],\n+)\n+async def test_failed_chat_span_skips_the_estimate_for_prompts_with_attachments(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+    monkeypatch: pytest.MonkeyPatch,\n+    attachment: dict[str, object],\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    parsed_pdfs: Final[list[str]] = []\n+\n+    def record_pdf_parse(data_url: str, *_args: object) -> None:\n+        parsed_pdfs.append(data_url)\n+\n+    monkeypatch.setattr(token_counter_module, \"_count_inline_pdf_tokens\", record_pdf_parse)\n+    messages: Final = [{\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": _PROMPT_SECRET}, attachment]}]\n+\n+    span: Final = await _fail(_redacted_logging(otel, messages), exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert ESTIMATED_INPUT_TOKENS_ATTRIBUTE not in attributes\n+    assert parsed_pdfs == []\n+    assert _PROMPT_SECRET not in _span_text(span)\n+\n+\n+@pytest.mark.asyncio\n+async def test_async_failure_counts_the_prompt_off_the_event_loop(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    counting_started: Final = threading.Event()\n+    release_counting: Final = threading.Event()\n+\n+    def blocked_token_counter(**_kwargs: object) -> int:\n+        counting_started.set()\n+        release_counting.wait(timeout=30)\n+        return 4321\n+\n+    monkeypatch.setattr(litellm_logging_module, \"get_token_counter_new\", lambda: blocked_token_counter)\n+    failure: Final = asyncio.create_task(\n+        _fail(_redacted_logging(otel, list(_SECRET_PROMPT)), exporter, _SYNC_THEN_ASYNC)\n+    )\n+    try:\n+        assert await asyncio.to_thread(counting_started.wait, 30)\n+        other_coroutine_ran: Final = asyncio.Event()\n+\n+        async def other_request() -> None:\n+            other_coroutine_ran.set()\n+\n+        await asyncio.create_task(other_request())\n+        assert other_coroutine_ran.is_set()\n+        assert not failure.done()\n+    finally:\n+        release_counting.set()\n+        await asyncio.gather(failure, return_exceptions=True)\n+    span: Final = failure.result()\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert attributes[ESTIMATED_INPUT_TOKENS_ATTRIBUTE] == 4321\n+\n+\n+@pytest.mark.asyncio\n+async def test_failed_chat_span_flags_unknown_usage_without_estimate_when_token_counter_is_disabled(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    monkeypatch.setattr(litellm, \"disable_token_counter\", True)\n+\n+    span: Final = await _fail(_redacted_logging(otel, list(_SECRET_PROMPT)), exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    _assert_unknown_usage(attributes)\n+    assert ESTIMATED_INPUT_TOKENS_ATTRIBUTE not in attributes\n+\n+\n+@pytest.mark.asyncio\n+async def test_failure_inside_active_parent_span_records_unknown_usage_on_the_parent(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+    tracer_provider: TracerProvider,\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    monkeypatch.delenv(\"USE_OTEL_LITELLM_REQUEST_SPAN\", raising=False)\n+    logging_obj: Final = _redacted_logging(otel, list(_SECRET_PROMPT))\n+    error: Final = litellm.Timeout(message=\"timed out\", model=\"test-model\", llm_provider=\"hosted_vllm\")\n+\n+    with trace.use_span(tracer_provider.get_tracer(\"caller\").start_span(\"caller_request\"), end_on_exit=True):\n+        logging_obj.failure_handler(error, \"tb\")\n+        await logging_obj.async_failure_handler(error, \"tb\")\n+\n+    (parent,) = exporter.get_finished_spans()\n+    attributes: Final = dict(parent.attributes or {})\n+    assert parent.name == \"caller_request\"\n+    _assert_unknown_usage(attributes)\n+    assert attributes[ESTIMATED_INPUT_TOKENS_ATTRIBUTE] == token_counter(\n+        model=_FAILED_MODEL, messages=list(_SECRET_PROMPT)\n+    )\n+    assert _PROMPT_SECRET not in _span_text(parent)\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    \"recovered\",\n+    [\n+        Usage(prompt_tokens=0, completion_tokens=0, total_tokens=0),\n+        Usage(prompt_tokens=120, completion_tokens=7, total_tokens=127),\n+    ],\n+    ids=[\"recovered_zero\", \"recovered_partial_stream\"],\n+)\n+async def test_failed_chat_span_adds_no_usage_attributes_when_usage_was_recovered(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter], recovered: Usage\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    logging_obj: Final = _redacted_logging(otel, list(_SECRET_PROMPT))\n+    logging_obj.record_partial_usage_for_failure(recovered, 0.0)\n+\n+    span: Final = await _fail(logging_obj, exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    assert USAGE_PROVIDER_STATUS_ATTRIBUTE not in attributes\n+    assert ESTIMATED_INPUT_TOKENS_ATTRIBUTE not in attributes\n+    assert not any(key in attributes for key in _GEN_AI_USAGE_KEYS)\n+\n+\n+@pytest.mark.asyncio\n+async def test_failed_non_chat_span_gets_no_failure_usage_flags(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    logging_obj: Final = _redacted_logging(otel, list(_SECRET_PROMPT), call_type=\"aresponses\")\n+\n+    span: Final = await _fail(logging_obj, exporter, _SYNC_THEN_ASYNC)\n+\n+    attributes: Final = dict(span.attributes or {})\n+    assert USAGE_PROVIDER_STATUS_ATTRIBUTE not in attributes\n+    assert ESTIMATED_INPUT_TOKENS_ATTRIBUTE not in attributes\n+\n+\n+def test_successful_span_reports_provider_usage_without_failure_usage_flags(\n+    in_memory_otel: tuple[OpenTelemetry, InMemorySpanExporter],\n+) -> None:\n+    otel, exporter = in_memory_otel\n+    data_dir: Final = Path(__file__).parent / \"open_telemetry\" / \"data\"\n+    kwargs: Final = {\n+        **json.loads((data_dir / \"captured_kwargs.json\").read_text()),\n+        FAILED_PROMPT_TOKEN_ESTIMATE_KEY: 999,\n+    }\n+    response_obj: Final = json.loads((data_dir / \"captured_response.json\").read_text())\n+\n+    otel.log_success_event(kwargs, response_obj, _FIXED_START, _FIXED_START + timedelta(seconds=1))\n+\n+    span_attributes: Final = tuple(dict(span.attributes or {}) for span in exporter.get_finished_spans())\n+    input_tokens: Final = {attrs.get(SpanAttributes.GEN_AI_USAGE_INPUT_TOKENS.value) for attrs in span_attributes}\n+    assert response_obj[\"usage\"][\"prompt_tokens\"] in input_tokens\n+    assert not any(USAGE_PROVIDER_STATUS_ATTRIBUTE in attrs for attrs in span_attributes)\n+    assert not any(ESTIMATED_INPUT_TOKENS_ATTRIBUTE in attrs for attrs in span_attributes)\ndiff --git a/tests/unit/litellm_core_utils/test_litellm_logging.py b/tests/unit/litellm_core_utils/test_litellm_logging.py\nindex 51fbcaa54bf7..cd7599799ed2 100644\n--- a/tests/unit/litellm_core_utils/test_litellm_logging.py\n+++ b/tests/unit/litellm_core_utils/test_litellm_logging.py\n@@ -31,6 +31,7 @@\n from litellm._service_logger import ServiceLogging\n from litellm.caching.caching import DualCache\n from litellm.constants import (\n+    FAILED_PROMPT_TOKEN_ESTIMATE_KEY,\n     KUBERNETES_POD_ROUTING_KEY,\n     LITELLM_LOGGING_NO_UPSTREAM_LLM_CALL,\n     LOGGING_WORKER_MAX_TIME_PER_COROUTINE,\n@@ -41,6 +42,7 @@\n from litellm.integrations.custom_logger import CustomLogger\n from litellm.litellm_core_utils import litellm_logging\n from litellm.litellm_core_utils.litellm_logging import Logging as LitellmLogging\n+from litellm.litellm_core_utils.token_counter import token_counter\n from litellm.litellm_core_utils.litellm_logging import (\n     BilledRoundsSpend,\n     Logging,\n@@ -14851,3 +14853,125 @@ async def async_log_success_event(\n     assert kwargs[\"response_cost\"] == pytest.approx(both_attempts)\n     assert prepared is not None\n     assert prepared.amount == pytest.approx(both_attempts)\n+\n+\n+class _FailureKwargsRecorder(CustomLogger):\n+    def __init__(self) -> None:\n+        super().__init__()\n+        self.failure_kwargs: asyncio.Queue[dict[str, object]] = asyncio.Queue()\n+\n+    async def async_log_failure_event(\n+        self,\n+        kwargs: dict[str, object],\n+        response_obj: object,\n+        start_time: datetime.datetime,\n+        end_time: datetime.datetime,\n+    ) -> None:\n+        self.failure_kwargs.put_nowait(dict(kwargs))\n+\n+\n+class _EstimateWantingRecorder(_FailureKwargsRecorder):\n+    wants_failed_prompt_token_estimate = True\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    (\"recorder_type\", \"expects_estimate\"),\n+    [(_FailureKwargsRecorder, False), (_EstimateWantingRecorder, True)],\n+    ids=[\"plain_logger_skips_counting\", \"opted_in_logger_gets_estimate\"],\n+)\n+async def test_failed_chat_prompt_is_counted_only_for_loggers_that_want_the_estimate(\n+    monkeypatch: pytest.MonkeyPatch,\n+    recorder_type: type[_FailureKwargsRecorder],\n+    expects_estimate: bool,\n+) -> None:\n+    for callback_list in (\"callbacks\", \"success_callback\", \"_async_success_callback\", \"failure_callback\"):\n+        monkeypatch.setattr(litellm, callback_list, [])\n+    monkeypatch.setattr(litellm, \"_async_failure_callback\", [])\n+    recorder: Final = recorder_type()\n+    messages: Final = [{\"role\": \"user\", \"content\": \"count these prompt words\"}]\n+    logging_obj: Final = LitellmLogging(\n+        model=\"hosted_vllm/test-model\",\n+        messages=messages,\n+        stream=False,\n+        call_type=\"acompletion\",\n+        start_time=datetime.datetime(2026, 1, 1),\n+        litellm_call_id=\"failed-request-call-id\",\n+        function_id=\"failed-request-function-id\",\n+        dynamic_async_failure_callbacks=[recorder],\n+    )\n+    logging_obj.update_environment_variables(\n+        model=\"hosted_vllm/test-model\", user=\"\", optional_params={}, litellm_params={}\n+    )\n+\n+    await logging_obj.async_failure_handler(\n+        litellm.Timeout(message=\"timed out\", model=\"test-model\", llm_provider=\"hosted_vllm\"), \"tb\"\n+    )\n+\n+    received: Final = recorder.failure_kwargs.get_nowait()\n+    expected: Final = {\n+        FAILED_PROMPT_TOKEN_ESTIMATE_KEY: token_counter(model=\"hosted_vllm/test-model\", messages=messages)\n+    }\n+    assert {k: v for k, v in received.items() if k == FAILED_PROMPT_TOKEN_ESTIMATE_KEY} == (\n+        expected if expects_estimate else {}\n+    )\n+\n+\n+_GLOBAL_CALLBACK_LISTS: Final = (\n+    \"callbacks\",\n+    \"success_callback\",\n+    \"_async_success_callback\",\n+    \"failure_callback\",\n+    \"_async_failure_callback\",\n+)\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\n+    (\"registration\", \"expects_estimate\"),\n+    [\n+        (\"success_callback\", False),\n+        (\"_async_success_callback\", False),\n+        (\"callbacks\", True),\n+        (\"failure_callback\", True),\n+        (\"_async_failure_callback\", True),\n+        (\"dynamic_failure_callbacks\", True),\n+        (\"dynamic_async_failure_callbacks\", True),\n+    ],\n+)\n+async def test_failed_chat_prompt_is_counted_only_when_an_opted_in_logger_receives_failures(\n+    monkeypatch: pytest.MonkeyPatch, registration: str, expects_estimate: bool\n+) -> None:\n+    for callback_list in _GLOBAL_CALLBACK_LISTS:\n+        monkeypatch.setattr(litellm, callback_list, [])\n+    recorder: Final = _EstimateWantingRecorder()\n+    if registration in _GLOBAL_CALLBACK_LISTS:\n+        monkeypatch.setattr(litellm, registration, [recorder])\n+    counted_prompts: Final[list[object]] = []\n+\n+    def recording_token_counter(**kwargs: object) -> int:\n+        counted_prompts.append(kwargs[\"messages\"])\n+        return 7\n+\n+    monkeypatch.setattr(litellm_logging, \"get_token_counter_new\", lambda: recording_token_counter)\n+    messages: Final = [{\"role\": \"user\", \"content\": \"count these prompt words\"}]\n+    logging_obj: Final = LitellmLogging(\n+        model=\"hosted_vllm/test-model\",\n+        messages=messages,\n+        stream=False,\n+        call_type=\"acompletion\",\n+        start_time=datetime.datetime(2026, 1, 1),\n+        litellm_call_id=\"failed-request-call-id\",\n+        function_id=\"failed-request-function-id\",\n+        **{registration: [recorder]} if registration.startswith(\"dynamic_\") else {},\n+    )\n+    logging_obj.update_environment_variables(\n+        model=\"hosted_vllm/test-model\", user=\"\", optional_params={}, litellm_params={}\n+    )\n+\n+    await logging_obj.async_failure_handler(\n+        litellm.Timeout(message=\"timed out\", model=\"test-model\", llm_provider=\"hosted_vllm\"), \"tb\"\n+    )\n+\n+    assert counted_prompts == ([messages] if expects_estimate else [])\n+    assert logging_obj.model_call_details.get(FAILED_PROMPT_TOKEN_ESTIMATE_KEY) == (7 if expects_estimate else None)\ndiff --git a/tests/unit/litellm_core_utils/test_logging_callback_manager.py b/tests/unit/litellm_core_utils/test_logging_callback_manager.py\nindex 25a52137d658..d7cad81f179f 100644\n--- a/tests/unit/litellm_core_utils/test_logging_callback_manager.py\n+++ b/tests/unit/litellm_core_utils/test_logging_callback_manager.py\n@@ -344,3 +344,28 @@ def test_duplicate_multiple_loggers_test():\n \n     assert langfuse_count == 1, \"Should have exactly one LangfusePromptManagement instance\"\n     assert otel_count == 1, \"Should have exactly one OpenTelemetry instance\"\n+\n+\n+def test_get_callbacks_by_type_treats_both_failure_lists_as_failure(monkeypatch: pytest.MonkeyPatch) -> None:\n+    for callback_list in (\n+        \"callbacks\",\n+        \"success_callback\",\n+        \"_async_success_callback\",\n+        \"failure_callback\",\n+        \"_async_failure_callback\",\n+    ):\n+        monkeypatch.setattr(litellm, callback_list, [])\n+    manager = LoggingCallbackManager()\n+    manager.add_litellm_callback(\"general_logger\")\n+    manager.add_litellm_success_callback(\"sync_success_logger\")\n+    manager.add_litellm_async_success_callback(\"async_success_logger\")\n+    manager.add_litellm_failure_callback(\"sync_failure_logger\")\n+    manager.add_litellm_async_failure_callback(\"async_failure_logger\")\n+    manager.add_litellm_success_callback(\"sync_success_and_async_failure_logger\")\n+    manager.add_litellm_async_failure_callback(\"sync_success_and_async_failure_logger\")\n+\n+    callbacks_by_type = manager.get_callbacks_by_type()\n+\n+    assert set(callbacks_by_type[\"success\"]) == {\"sync_success_logger\", \"async_success_logger\"}\n+    assert set(callbacks_by_type[\"failure\"]) == {\"sync_failure_logger\", \"async_failure_logger\"}\n+    assert set(callbacks_by_type[\"success_and_failure\"]) == {\"general_logger\", \"sync_success_and_async_failure_logger\"}\ndiff --git a/tests/unit/litellm_core_utils/test_token_counter.py b/tests/unit/litellm_core_utils/test_token_counter.py\nindex 08ee9e765a22..f176ef696020 100644\n--- a/tests/unit/litellm_core_utils/test_token_counter.py\n+++ b/tests/unit/litellm_core_utils/test_token_counter.py\n@@ -43,6 +43,7 @@\n     _get_tiktoken_count_function,\n     calculate_img_tokens,\n     estimate_image_tokens,\n+    has_only_text_content,\n     high_detail_image_token_upper_bound,\n     is_openai_model,\n     offload_token_count,\n@@ -3804,3 +3805,35 @@ def register() -> None:\n             registering.result()\n     finally:\n         litellm.open_ai_chat_completion_models.difference_update(registered)\n+\n+\n+@pytest.mark.parametrize(\n+    (\"messages\", \"text_only\"),\n+    [\n+        ([{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"assistant\", \"content\": None}], True),\n+        ([{\"role\": \"user\", \"content\": [\"part\", {\"type\": \"text\", \"text\": \"hi\"}, {\"type\": \"thinking\"}]}], True),\n+        ([{\"role\": \"user\", \"content\": \"hi\"}, \"a bare string message\"], False),\n+        ([{\"role\": \"user\", \"content\": \"hi\"}, 42], False),\n+        ([None], False),\n+        ([{\"role\": \"user\", \"content\": {\"type\": \"text\", \"text\": \"hi\"}}], False),\n+        (\n+            [{\"role\": \"user\", \"content\": [{\"type\": \"image_url\", \"image_url\": {\"url\": \"data:image/png;base64,AA==\"}}]}],\n+            False,\n+        ),\n+        ([{\"role\": \"user\", \"content\": [{\"type\": [\"text\"], \"text\": \"hi\"}]}], False),\n+        ([{\"role\": \"user\", \"content\": [{\"text\": \"hi\"}]}], False),\n+    ],\n+    ids=[\n+        \"string_and_empty_content\",\n+        \"text_blocks\",\n+        \"string_message\",\n+        \"number_message\",\n+        \"none_message\",\n+        \"mapping_content\",\n+        \"image_block\",\n+        \"non_string_block_type\",\n+        \"untyped_block\",\n+    ],\n+)\n+def test_has_only_text_content_accepts_only_plain_text_chat_messages(messages: list[object], text_only: bool) -> None:\n+    assert has_only_text_content(messages) is text_only\n", "problem_statement": "[Bug]: OTel span has no gen_ai.usage when a request times out after the backend processed the prompt\n### What happened?\n\nWhen a request times out in LiteLLM after the backend has already processed the prompt, the OpenTelemetry span for that request has no `gen_ai.usage.*` attributes at all. The backend did the prefill (and kept generating), but nothing in LiteLLM's telemetry records those tokens, so cost attribution built on the spans charges that work to no one.\n\n**Setup**\n- LiteLLM proxy `ghcr.io/berriai/litellm:v1.108.4`, OpenTelemetry callback on, `turn_off_message_logging: true`\n- Backend: vLLM 0.31.0 (`hosted_vllm/`), serving Qwen3-0.6B on an NVIDIA L4\n- Same prompt of about 1,450 tokens in each case; vLLM's own counters (`vllm:prompt_tokens_total`, `vllm:generation_tokens_total`) read before and after each request\n\n**Results**\n\n| Case | Response | vLLM prompt tokens | vLLM generated tokens | LiteLLM span |\n|---|---|---|---|---|\n| Control, `max_tokens: 50` | 200 | +1,447 | +50 | `litellm_request` OK, input 1,447, output 50 |\n| `max_tokens: 6000`, `\"timeout\": 3`, non-streamed | 408 `litellm.Timeout` | +1,447 | +453 | `litellm_request` status ERROR, `error.type` Timeout, exception event, **no `gen_ai.usage.*`** |\n\nThe 408 body: `litellm.Timeout: Timeout Error: Hosted_vllmException - litellm.Timeout: Connection timed out. Timeout passed=3.0, time taken=3.002 seconds`\n\n**Expected**\n\nOn a failed request where LiteLLM already knows the prompt, record what it can:\n- the prompt token count LiteLLM can compute itself (for example with `litellm.token_counter`), marked as estimated, and\n- an explicit signal that usage from the provider wasn't captured, so a consumer can tell \"0 tokens\" from \"unknown\".\n\nHappy to test a fix against the same setup. Related discussion on cost attribution through gateways: opencost/opencost#3952.\n\n### Relevant log output\n\n```\nlitellm_request  status=ERROR  error.type=Timeout  (no gen_ai.usage.input_tokens / output_tokens)\nFailed Proxy Server Request  status=ERROR\n```\n\n### What LiteLLM version are you on?\n\nv1.108.4\n\n", "hints_text": "Could I work on timeout span usage, keeping estimates distinct from provider-reported tokens and testing unknown usage without recording prompt content?\nYes please, go ahead. Keeping the estimate separate from provider-reported usage is exactly what a cost consumer needs, so it can tell \"0 tokens\" from \"unknown\".\n\nOne request: please mark estimated counts with a distinct attribute or flag rather than putting them in `gen_ai.usage.input_tokens` itself, so existing dashboards don't silently mix estimates with billed numbers.\n\nWhen you have a branch, ping me. I can rerun the same timeout test (vLLM behind LiteLLM, engine counters as the reference) and post the numbers here.\n", "created_at": "2026-11-12T19:27:56Z"}
{"repo": "BerriAI/litellm", "pull_number": 51438, "instance_id": "BerriAI__litellm-51438", "issue_numbers": ["46866"], "base_commit": "d723545320080fd6e1dd3a4f24fb58af880e067b", "patch": "diff --git a/litellm/llms/azure/responses/transformation.py b/litellm/llms/azure/responses/transformation.py\nindex 637d3cfc2197..670614078d66 100644\n--- a/litellm/llms/azure/responses/transformation.py\n+++ b/litellm/llms/azure/responses/transformation.py\n@@ -145,7 +145,12 @@ def validate_environment(self, headers: dict, model: str, litellm_params: Generi\n         return BaseAzureLLM.base_validate_azure_environment(headers=headers, litellm_params=litellm_params)\n \n     def get_stripped_model_name(self, model: str) -> str:\n-        return model.replace(\"responses/\", \"\").replace(\"o_series/\", \"\").replace(\"azure_ai/\", \"\")\n+        return (\n+            model.replace(\"responses/\", \"\")\n+            .replace(\"o_series/\", \"\")\n+            .replace(\"azure_ai/\", \"\")\n+            .replace(AzureOpenAIGPT5Config.GPT5_SERIES_ROUTE, \"\")\n+        )\n \n     def _validate_input_param(\n         self, input: str | ResponseInputParam, *, drop_params: bool = False\n", "test_patch": "diff --git a/tests/unit/llms/azure/response/test_azure_transformation.py b/tests/unit/llms/azure/response/test_azure_transformation.py\nindex 3a8c9d96da49..7879d0e9ae60 100644\n--- a/tests/unit/llms/azure/response/test_azure_transformation.py\n+++ b/tests/unit/llms/azure/response/test_azure_transformation.py\n@@ -1308,6 +1308,30 @@ def test_responses_api_version_routes_a_dated_chat_deployment_to_its_own_respons\n     assert \"api_version\" not in request_body\n \n \n+@pytest.mark.respx(assert_all_called=True)\n+@pytest.mark.parametrize(\n+    \"model\",\n+    [\"azure/gpt5_series/my-deployment\", \"azure/responses/gpt5_series/my-deployment\", \"azure/my-deployment\"],\n+)\n+def test_responses_sends_the_bare_deployment_name_without_the_gpt5_series_marker(\n+    respx_mock: respx.MockRouter, model: str\n+) -> None:\n+    route: Final = respx_mock.post(\n+        \"https://example-resource.openai.azure.com/openai/responses\", params={\"api-version\": \"2025-04-01-preview\"}\n+    ).mock(return_value=httpx.Response(200, json=_COMPLETED_RESPONSE))\n+\n+    litellm.responses(\n+        model=model,\n+        input=\"hi\",\n+        api_base=\"https://example-resource.openai.azure.com\",\n+        api_key=\"azure-test-key\",\n+        api_version=\"2025-04-01-preview\",\n+    )\n+\n+    assert route.call_count == 1\n+    assert TypeAdapter(dict[str, JsonValue]).validate_json(route.calls[0].request.content)[\"model\"] == \"my-deployment\"\n+\n+\n @pytest.mark.respx(assert_all_called=True)\n def test_responses_api_version_reaches_the_url_when_chat_completion_bridges_to_responses(\n     respx_mock: respx.MockRouter,\n", "problem_statement": "[Bug]: Azure Responses API sends the gpt5_series/ routing prefix to Azure as the deployment name\n### What happened?\n\nWhen an Azure model uses the `gpt5_series/` routing marker (`azure/gpt5_series/<deployment>`), Responses API calls send the marker to Azure inside the request body's `model` field. Azure has no deployment named `gpt5_series/<deployment>`, so the call can't be served.\n\nThe marker is a LiteLLM-only routing hint: `AzureOpenAIGPT5Config.is_model_gpt_5_model` checks for `\"gpt5_series\" in model`. The Responses transformer doesn't strip it, though. `AzureOpenAIResponsesAPIConfig.get_stripped_model_name` removes only `responses/`, `o_series/` and `azure_ai/`:\n\n- v1.105.1: [`litellm/llms/azure/responses/transformation.py#L51-L52`](https://github.com/BerriAI/litellm/blob/d665dc1a6315847fcad6cc2c1264ceb47c06abce/litellm/llms/azure/responses/transformation.py#L51-L52)\n- main @ 4e49394: [`litellm/llms/azure/responses/transformation.py#L54-L55`](https://github.com/BerriAI/litellm/blob/4e49394adef46940cae8545c788c3f67bf5ee31f/litellm/llms/azure/responses/transformation.py#L54-L55)\n- v1.88.1 has the same gap (only `responses/` and `o_series/` are stripped there).\n\nThis is the same kind of bug as #41387, where the `azure_ai/` prefix leaked into the Responses request model. That was fixed by adding `azure_ai/` to this method.\n\n### Steps to reproduce\n\nThis uses a mocked Azure backend (`httpx.MockTransport`), so it needs no credentials and makes no network call. The 404 below comes from the mock and just stands in for Azure's response.\n\n```python\nimport json\nimport httpx\nimport litellm\nfrom litellm.llms.custom_httpx.http_handler import HTTPHandler\n\nsent = {}\n\ndef azure(request: httpx.Request) -> httpx.Response:\n    sent[\"url\"] = str(request.url)\n    sent[\"model\"] = json.loads(request.content)[\"model\"]\n    return httpx.Response(404, json={\"error\": {\"code\": \"DeploymentNotFound\", \"message\": \"mock\"}})\n\nclient = HTTPHandler()\nclient.client = httpx.Client(transport=httpx.MockTransport(azure))\n\ntry:\n    litellm.responses(\n        model=\"azure/gpt5_series/my-deployment\",\n        input=\"hello\",\n        api_base=\"https://example-resource.openai.azure.com\",\n        api_key=\"placeholder\",\n        api_version=\"2025-04-01-preview\",\n        client=client,\n    )\nexcept Exception as e:\n    print(type(e).__name__)\nprint(sent)\n```\n\nActual (`litellm==1.105.1` from PyPI):\n```\nNotFoundError\n{'url': 'https://example-resource.openai.azure.com/openai/responses?api-version=2025-04-01-preview', 'model': 'gpt5_series/my-deployment'}\n```\n\nExpected: `'model': 'my-deployment'`.\n\nThe proxy has the same problem. In an in-process proxy test against the same mocked backend, a `model_list` entry with `model: azure/gpt5_series/<deployment>` called via `POST /v1/responses` sent `gpt5_series/<deployment>` as the body `model`.\n\n### Suggested fix\n\nStrip the marker in `get_stripped_model_name`, the same way `o_series/` and `azure_ai/` are already stripped:\n\n```diff\n     def get_stripped_model_name(self, model: str) -> str:\n-        return model.replace(\"responses/\", \"\").replace(\"o_series/\", \"\").replace(\"azure_ai/\", \"\")\n+        return (\n+            model.replace(\"responses/\", \"\")\n+            .replace(\"o_series/\", \"\")\n+            .replace(\"azure_ai/\", \"\")\n+            .replace(AzureOpenAIGPT5Config.GPT5_SERIES_ROUTE, \"\")\n+        )\n```\n\n(`GPT5_SERIES_ROUTE = \"gpt5_series/\"` is defined in `litellm/llms/azure/chat/gpt_5_transformation.py`.) I tested an equivalent change on the v1.105.1 wheel, appending `.replace(\"gpt5_series/\", \"\")` to the existing return expression. The repro above then sends `'model': 'my-deployment'`.\n\nSuggested regression cases for `get_stripped_model_name`:\n\n| input | expected |\n|---|---|\n| `gpt5_series/my-deployment` | `my-deployment` |\n| `o_series/o3` | `o3` (unchanged) |\n| `responses/my-deployment` | `my-deployment` (unchanged) |\n| `my-deployment` | `my-deployment` |\n\n### Related\n\n- #41387: the same leak for the `azure_ai/` prefix (fixed)\n- #45033 / #45367: Azure SDK Responses calls (`POST /openai/responses`) bypass the router. Once that's fixed, Azure SDK clients using `gpt5_series/` models will run into this issue next.\n\n### LiteLLM version\n\nv1.88.1 through v1.105.1; also present on `main` @ 4e49394.\n\n", "hints_text": "Taking this one - the fix is to strip the gpt5_series/ routing marker in AzureOpenAIResponsesAPIConfig.get_stripped_model_name so the real deployment name reaches Azure. PR shortly.\nOpened #46868 for this - strips the gpt5_series/ marker in get_stripped_model_name (reusing the existing GPT5_SERIES_ROUTE constant) so the real deployment name reaches Azure, with unit tests on the transform.", "created_at": "2026-11-12T18:51:26Z"}
{"repo": "BerriAI/litellm", "pull_number": 51430, "instance_id": "BerriAI__litellm-51430", "issue_numbers": ["51029"], "base_commit": "d2711ac5592fb777887a7c204b9f73c18bfd115c", "patch": "diff --git a/litellm/integrations/opentelemetry.py b/litellm/integrations/opentelemetry.py\nindex 9bec220e0731..dc14d3904c01 100644\n--- a/litellm/integrations/opentelemetry.py\n+++ b/litellm/integrations/opentelemetry.py\n@@ -33,9 +33,11 @@\n from litellm.integrations.otel.model.db_endpoint import db_span_attributes\n from litellm.integrations.otel.model.metadata import flatten_metadata\n from litellm.integrations.otel.model.semconv import LiteLLM, Metric\n+from litellm.integrations.otel.model.utils import as_str\n from litellm.integrations.otel.plumbing.otlp_tls import resolve_otlp_http_tls\n from litellm.integrations.otel.routing import routed_model_name, routing_decision_attributes\n from litellm.litellm_core_utils.core_helpers import iter_items, require_attributes\n+from litellm.litellm_core_utils.hidden_params import get_hidden_params\n from litellm.litellm_core_utils.internal_call_metadata import is_unbilled_non_inference_call_from_params\n from litellm.litellm_core_utils.safe_json_dumps import safe_dumps\n from litellm.litellm_core_utils.secret_redaction import redact_string\n@@ -140,6 +142,18 @@ def _response_field(response_obj: object, key: str) -> object:\n     return require_attributes(response_obj, _SupportsGet, \"get\").get(key)\n \n \n+def _semconv_response_model(\n+    response_obj: object, response_model: object, model_group: str | None, deployment_model: str | None\n+) -> object:\n+    hidden_params: Final = get_hidden_params(response_obj)\n+    provider_model: Final = hidden_params.get(\"provider_response_model\") if hidden_params is not None else None\n+    if isinstance(provider_model, str) and provider_model:\n+        return provider_model\n+    if response_model and response_model == model_group and deployment_model:\n+        return deployment_model\n+    return response_model\n+\n+\n def _billed_usage(response_obj: object, call_type: str | None, litellm_params: Mapping[str, object] | None) -> object:\n     if not response_obj or is_unbilled_non_inference_call_from_params(call_type, litellm_params, response_obj):\n         return None\n@@ -152,6 +166,7 @@ class _CacheHitView(TypedDict, total=False):\n \n \n _CACHE_HIT_VIEW: Final = TypeAdapter(_CacheHitView)\n+_OPAQUE_VALUE: Final = TypeAdapter(object)\n \n # Dedicated so a slow exporter shutdown cannot starve the shared logging executor.\n _PROVIDER_SHUTDOWN_EXECUTOR: Final = ThreadPoolExecutor(max_workers=4, thread_name_prefix=\"OtelProviderShutdown\")\n@@ -2521,11 +2536,12 @@ def set_attributes(self, span: Span, kwargs, response_obj: Any | None):\n             #############################################\n \n             # The name of the LLM a request is being made to\n-            if kwargs.get(\"model\"):\n+            request_model: Final = as_str(_OPAQUE_VALUE.validate_python(kwargs.get(\"model\")))\n+            if request_model:\n                 self.safe_set_attribute(\n                     span=span,\n                     key=SpanAttributes.LLM_REQUEST_MODEL.value,\n-                    value=kwargs.get(\"model\"),\n+                    value=request_model,\n                 )\n \n             # The LLM request type\n@@ -2617,10 +2633,14 @@ def set_attributes(self, span: Span, kwargs, response_obj: Any | None):\n                 )\n \n             # The model used to generate the response.\n-            response_model: Final = routed_model_name(\n-                _response_field(response_obj, \"model\"),\n-                standard_logging_payload.get(\"model_group\"),  # pyright: ignore[reportUnknownMemberType, reportUnknownArgumentType]  # kwargs is untyped\n-                decision,\n+            model_group: Final = as_str(standard_logging_payload.get(\"model_group\"))  # pyright: ignore[reportUnknownMemberType, reportUnknownArgumentType]  # kwargs is untyped\n+            routed_response_model: Final = routed_model_name(\n+                _response_field(response_obj, \"model\"), model_group, decision\n+            )\n+            response_model: Final = (\n+                _semconv_response_model(response_obj, routed_response_model, model_group, request_model)\n+                if self._gen_ai_semconv_latest_experimental\n+                else routed_response_model\n             )\n             if response_model:\n                 self.safe_set_attribute(\n", "test_patch": "diff --git a/tests/unit/integrations/test_opentelemetry.py b/tests/unit/integrations/test_opentelemetry.py\nindex 4ef95d3a79da..6f2424e74d25 100644\n--- a/tests/unit/integrations/test_opentelemetry.py\n+++ b/tests/unit/integrations/test_opentelemetry.py\n@@ -57,7 +57,10 @@\n from collections.abc import AsyncIterator, Callable, Mapping\n from litellm.constants import KUBERNETES_POD_ROUTING_KEY, LOGGING_WORKER_MAX_TIME_PER_COROUTINE\n from litellm.litellm_core_utils.logging_worker import GLOBAL_LOGGING_WORKER\n-from litellm.types.utils import ChatCompletionMessageToolCall, Function\n+from litellm.litellm_core_utils.hidden_params import set_hidden_params\n+from litellm.litellm_core_utils.litellm_logging import Logging\n+from litellm.litellm_core_utils.streaming_handler import CustomStreamWrapper\n+from litellm.types.utils import ChatCompletionMessageToolCall, Delta, Function, ModelResponseStream, StreamingChoices\n from tests._vcr_conftest_common import install_live_call_probe, record_vcr_outcome\n \n exporter = InMemorySpanExporter()\n@@ -401,6 +404,121 @@ def test_v1_auto_router_response_model_names_the_routed_model(decision: object,\n     assert (attributes[\"gen_ai.response.model\"], attributes[\"gen_ai.usage.input_tokens\"]) == (expected, 3)\n \n \n+def _response_with_provider_model(model: str, provider_model: str | None) -> litellm.ModelResponse:\n+    response: Final = litellm.ModelResponse(model=model)\n+    if provider_model:\n+        set_hidden_params(response, {\"provider_response_model\": provider_model})\n+    return response\n+\n+\n+def _aliased_response(provider_model: str | None) -> litellm.ModelResponse:\n+    return _response_with_provider_model(\"qwen-small\", provider_model)\n+\n+\n+def _streamed_aliased_response(provider_model: str | None) -> litellm.ModelResponse:\n+    wrapper: Final = CustomStreamWrapper(\n+        completion_stream=None,\n+        model=\"qwen-small\",\n+        logging_obj=Logging(\n+            model=\"qwen-small\",\n+            messages=[{\"role\": \"user\", \"content\": \"hi\"}],\n+            stream=True,\n+            call_type=\"acompletion\",\n+            start_time=1.0,\n+            litellm_call_id=\"alias-call\",\n+            function_id=\"test\",\n+        ),\n+        custom_llm_provider=\"hosted_vllm\",\n+    )\n+    chunks: Final = tuple(\n+        wrapper.chunk_creator(\n+            chunk=ModelResponseStream(\n+                id=\"chunk-1\",\n+                model=provider_model,\n+                choices=[StreamingChoices(finish_reason=finish_reason, index=0, delta=delta)],\n+            )\n+        )\n+        for finish_reason, delta in ((None, Delta(content=\"hi\")), (\"stop\", Delta()))\n+    )\n+    assembled: Final = litellm.stream_chunk_builder(chunks=list(chunks))\n+    assert isinstance(assembled, litellm.ModelResponse) and assembled.model == \"qwen-small\"\n+    return assembled\n+\n+\n+def _logged_model_names(\n+    response_obj: object, latest_semconv: bool, model_group: str = \"qwen-small\", decision: object = None\n+) -> tuple[object, object, object]:\n+    semconv: Final = {OTELSemconvCategory.GEN_AI_LATEST_EXPERIMENTAL} if latest_semconv else set[OTELSemconvCategory]()\n+    exporter: Final = InMemorySpanExporter()\n+    provider: Final = TracerProvider()\n+    provider.add_span_processor(SimpleSpanProcessor(exporter))\n+    with patch.dict(os.environ, {\"OTEL_SEMCONV_STABILITY_OPT_IN\": \"\"}):\n+        otel: Final = OpenTelemetry(\n+            config=OpenTelemetryConfig(semconv_stability_opt_in=semconv), tracer_provider=provider\n+        )\n+    with provider.get_tracer(__name__).start_as_current_span(\"inference\") as span:\n+        otel.set_attributes(\n+            span,\n+            {\n+                \"model\": \"qwen-dep\",\n+                \"standard_logging_object\": {\n+                    \"id\": \"alias-call\",\n+                    \"call_type\": \"acompletion\",\n+                    \"model_group\": model_group,\n+                    \"metadata\": {\"routing_decision\": decision},\n+                },\n+            },\n+            response_obj,\n+        )\n+    (finished,) = exporter.get_finished_spans()\n+    attributes: Final = finished.attributes\n+    return (\n+        attributes.get(\"gen_ai.response.model\"),\n+        attributes.get(\"litellm.model_group\"),\n+        attributes.get(\"gen_ai.request.model\"),\n+    )\n+\n+\n+@pytest.mark.parametrize(\n+    (\"make_response\", \"provider_model\", \"latest_semconv\", \"expected_response_model\"),\n+    [\n+        (_aliased_response, \"Qwen3-0.6B-served\", True, \"Qwen3-0.6B-served\"),\n+        (_streamed_aliased_response, \"Qwen3-0.6B-served\", True, \"Qwen3-0.6B-served\"),\n+        (_aliased_response, None, True, \"qwen-dep\"),\n+        (_aliased_response, \"Qwen3-0.6B-served\", False, \"qwen-small\"),\n+        (_streamed_aliased_response, \"Qwen3-0.6B-served\", False, \"qwen-small\"),\n+    ],\n+    ids=[\"semconv\", \"semconv-streamed\", \"semconv-deployment-fallback\", \"legacy\", \"legacy-streamed\"],\n+)\n+def test_aliased_response_model_names_the_provider_model_only_under_latest_semconv(\n+    make_response: Callable[[str | None], litellm.ModelResponse],\n+    provider_model: str | None,\n+    latest_semconv: bool,\n+    expected_response_model: str,\n+) -> None:\n+    assert _logged_model_names(make_response(provider_model), latest_semconv) == (\n+        expected_response_model,\n+        \"qwen-small\",\n+        \"qwen-dep\",\n+    )\n+\n+\n+@pytest.mark.parametrize(\n+    (\"provider_model\", \"expected_response_model\"),\n+    [(\"Qwen3-0.6B-served\", \"Qwen3-0.6B-served\"), (None, \"answer\")],\n+    ids=[\"provider-model\", \"routed-model\"],\n+)\n+def test_latest_semconv_auto_router_response_model_prefers_provider_then_routed_model(\n+    provider_model: str | None, expected_response_model: str\n+) -> None:\n+    assert _logged_model_names(\n+        _response_with_provider_model(\"auto-router\", provider_model),\n+        latest_semconv=True,\n+        model_group=\"auto-router\",\n+        decision={\"router_model_name\": \"auto-router\", \"routed_model\": \"answer\"},\n+    ) == (expected_response_model, \"auto-router\", \"qwen-dep\")\n+\n+\n def test_v1_server_tool_calls_lead_the_completion_function_call_attributes() -> None:\n     exporter: Final = InMemorySpanExporter()\n     provider: Final = TracerProvider()\n", "problem_statement": "[Bug]: OTel gen_ai.response.model holds the requested model group, not the model that generated the response\n### What happened?\n\nOn the proxy, the OpenTelemetry span's `gen_ai.response.model` holds the model group the client asked for (the alias), not the model that generated the response.\n\nThe GenAI semantic conventions define `gen_ai.response.model` as \"the name of the model that generated the response\". `gen_ai.request.model` is already on the span, so the alias is recorded twice, and the served model only appears in `gen_ai.request.model`.\n\n**Reproduction (v1.108.4, `litellm-database` image, `otel` callback, `OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental`):**\n\n```yaml\nmodel_list:\n  - model_name: qwen-small            # what clients ask for\n    litellm_params:\n      model: openai/Qwen3-0.6B        # what the vLLM-compatible engine serves\n      api_base: http://engine:8000/v1\n```\n\nA request for `qwen-small` produces a span with:\n\n- `gen_ai.request.model = Qwen3-0.6B`\n- `gen_ai.response.model = qwen-small`  \u2190 expected `Qwen3-0.6B` (the engine's response `model`)\n- `litellm.model_group = qwen-small`\n\n**Where:** `litellm/integrations/opentelemetry.py`, `set_attributes`. `response_model` is taken from `response_obj[\"model\"]` after the proxy has rewritten it to the model group (`routed_model_name` only substitutes the auto-router's pick).\n\n**Why it matters:** cost and usage tools that join spans to the engine's own metrics (for example vLLM's `model_name` label) need the served model. With the alias, a rewritten or aliased request joins to nothing. The alias is still available in `litellm.model_group`.\n\n**Suggested fix:** set `gen_ai.response.model` from the model returned by the provider before the proxy renames it, falling back to the deployment's model, and keep the alias in `litellm.model_group`. Happy to send a PR with a test.\n\n### Relevant log output\n\n_No response_\n\n### Are you a ML Ops Team?\n\nNo\n\n### What LiteLLM version are you on ?\n\nv1.108.4\n\n", "hints_text": "On main, [`provider_response_model`](https://github.com/BerriAI/litellm/blob/0fd6dd4168dd2c95c929c7d36d7100dee589dd9b/litellm/litellm_core_utils/llm_response_utils/response_metadata.py#L124-L189) preserves `ModelResponse.model` unless already populated for pricing. [OTel](https://github.com/BerriAI/litellm/blob/0fd6dd4168dd2c95c929c7d36d7100dee589dd9b/litellm/integrations/opentelemetry.py#L2619-L2630) reads the response\u2019s `model`. I reviewed source, without deployment testing.\nThanks for looking. `provider_response_model` is also in v1.108.4, the version we deployed, and the deployment still records the alias.\n\nProxy `ghcr.io/berriai/litellm-database:v1.108.4`, `otel` callback, OTLP HTTP. The client asks for `qwen-small`; the deployment is `openai/Qwen3-0.6B` on a vLLM-compatible engine. The usage span (`litellm_request`):\n\n```\ngen_ai.request.model   = Qwen3-0.6B\ngen_ai.response.model  = qwen-small\nlitellm.model_group    = qwen-small\ngen_ai.usage.input_tokens = 18, gen_ai.usage.output_tokens = 8\n```\n\nThe body returned to the client also has `\"model\": \"qwen-small\"`, so the proxy's rename to the model group seems to happen before the OTel callback reads the response's `model`. The result is the same with `OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental`.\n\nWe'll rerun the same case on the latest `main` image and post what we see.\n\nReran it on main: still present.\n\nImage `ghcr.io/berriai/litellm-database:main-latest@sha256:b36556d0145e1a9816535d4ef947bb3cd07ac199f592b7fa14d4af55029c60c0`, which reports 1.110.0. It was pulled 10 Nov ~22:30 UTC, when main was at 8207a57d8. Same settings as before (`otel`, OTLP HTTP, `OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental`).\n\nThe client asks for `qwen-small`, routed to `hosted_vllm/Qwen3-0.6B`. Usage span `chat Qwen3-0.6B`:\n\n```\ngen_ai.request.model   = Qwen3-0.6B\ngen_ai.response.model  = qwen-small\nlitellm.model_group    = qwen-small\nlitellm.provider.model = hosted_vllm/Qwen3-0.6B\n```\n\nRequests where the alias equals the engine's model name have `gen_ai.response.model = Qwen3-0.6B`, as expected. So it's only the aliased case. Happy to send a PR with a test if that helps.\n\nThe [existing telemetry test](https://github.com/BerriAI/litellm/blob/ac0d2fcd68405310baaafbf32334d3d1ffc27877/tests/integration/spend/test_stream_alias_billing.py#L224-L253) expects aliases with and without streaming. Could your regression distinguish the client alias, deployment name, and provider\u2019s response model?\nThanks, that test helps. It pins the alias as the logged response model on purpose, so changing the default would break it, and anyone who relies on it today.\n\nYes, the regression can keep the three apart: client alias `qwen-small`, deployment `hosted_vllm/qwen-dep`, and a provider reply whose `model` is `Qwen3-0.6B-served`.\n\nA scoped change that keeps your test green: only under `OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental`, set `gen_ai.response.model` to the provider's response model, as the GenAI conventions define it. Keep the alias in `litellm.model_group`, and leave the default (non-opt-in) behaviour as it is.\n\nWould a maintainer accept that? If so, I'll send a PR with that three-name regression for streamed and non-streamed requests.\n", "created_at": "2026-11-12T18:12:25Z"}
{"repo": "BerriAI/litellm", "pull_number": 51385, "instance_id": "BerriAI__litellm-51385", "issue_numbers": ["47898"], "base_commit": "52d1c4cd80162fbf03d7f92def0cb1631f1edfd4", "patch": "diff --git a/litellm/integrations/otel/langfuse_logger.py b/litellm/integrations/otel/langfuse_logger.py\nindex 15b0f3f0cc28..a209b21b8212 100644\n--- a/litellm/integrations/otel/langfuse_logger.py\n+++ b/litellm/integrations/otel/langfuse_logger.py\n@@ -4,11 +4,14 @@\n from opentelemetry.sdk.trace import ReadableSpan\n \n from litellm._logging import verbose_logger\n+from litellm.integrations.otel.emitter import attribute_budget, carried_keys\n from litellm.integrations.otel.logger import OpenTelemetryV2\n from litellm.integrations.otel.mappers.langfuse import (\n     LANGFUSE_OBSERVATION_INPUT,\n     LANGFUSE_OBSERVATION_OUTPUT,\n+    LANGFUSE_RELEASE,\n     LANGFUSE_TRACE_NAME,\n+    LANGFUSE_VERSION,\n     LangfuseMapper,\n )\n from litellm.integrations.otel.model.metadata import internal_call_origin\n@@ -31,11 +34,16 @@ class LangfuseOpenTelemetryV2(OpenTelemetryV2):\n     def log_pre_api_call(self, model: str, messages: object, kwargs: Mapping[str, object]) -> None:\n         root: Final = request_root_span()\n         if root is not None and root.is_recording():\n+            stamped: Final = LangfuseMapper.trace_attributes(\n+                caller_trace_controls(kwargs),\n+                as_str(kwargs.get(\"call_type\")) if self._derives_trace_name(root, kwargs) else None,\n+            )\n+            room: Final = attribute_budget(root, 0)\n+            fits: Final = room is None or len(stamped.keys() - carried_keys(root)) <= room\n             root.set_attributes(\n-                LangfuseMapper.trace_attributes(\n-                    caller_trace_controls(kwargs),\n-                    as_str(kwargs.get(\"call_type\")) if self._derives_trace_name(root, kwargs) else None,\n-                )\n+                stamped\n+                if fits\n+                else {key: value for key, value in stamped.items() if key not in (LANGFUSE_RELEASE, LANGFUSE_VERSION)}\n             )\n         super().log_pre_api_call(model, messages, kwargs)\n \ndiff --git a/litellm/integrations/otel/mappers/langfuse.py b/litellm/integrations/otel/mappers/langfuse.py\nindex 5aed173254c6..98b02ea6d41e 100644\n--- a/litellm/integrations/otel/mappers/langfuse.py\n+++ b/litellm/integrations/otel/mappers/langfuse.py\n@@ -39,10 +39,17 @@\n LANGFUSE_TRACE_USER_ID: Final = \"user.id\"\n LANGFUSE_TRACE_SESSION_ID: Final = \"session.id\"\n LANGFUSE_TRACE_TAGS: Final = \"langfuse.trace.tags\"\n+LANGFUSE_RELEASE: Final = \"langfuse.release\"\n+LANGFUSE_VERSION: Final = \"langfuse.version\"\n LANGFUSE_OBSERVATION_METADATA: Final = \"langfuse.observation.metadata\"\n LANGFUSE_TRACE_METADATA_PREFIX: Final = \"langfuse.trace.metadata.\"\n LANGFUSE_REQUEST_METADATA_ATTRIBUTES: Final[frozenset[str]] = frozenset(\n-    {LANGFUSE_OBSERVATION_METADATA, *(f\"{LANGFUSE_TRACE_METADATA_PREFIX}{name}\" for name in IDENTITY_METADATA_FIELDS)}\n+    {\n+        LANGFUSE_OBSERVATION_METADATA,\n+        LANGFUSE_RELEASE,\n+        LANGFUSE_VERSION,\n+        *(f\"{LANGFUSE_TRACE_METADATA_PREFIX}{name}\" for name in IDENTITY_METADATA_FIELDS),\n+    }\n )\n \n \n@@ -112,6 +119,8 @@ class LangfuseMapper:\n             LANGFUSE_TRACE_USER_ID,\n             LANGFUSE_TRACE_SESSION_ID,\n             LANGFUSE_TRACE_TAGS,\n+            LANGFUSE_RELEASE,\n+            LANGFUSE_VERSION,\n         }\n     )\n \n@@ -130,13 +139,17 @@ def trace_attributes(trace: TraceControls, call_type: str | None = None) -> Attr\n                 (LANGFUSE_TRACE_USER_ID, trace.user_id or None),\n                 (LANGFUSE_TRACE_SESSION_ID, trace.session_id or None),\n                 (LANGFUSE_TRACE_TAGS, trace.tags or None),\n+                (LANGFUSE_RELEASE, trace.release or None),\n+                (LANGFUSE_VERSION, trace.version or None),\n             )\n         )\n \n     @classmethod\n     def _llm_call(cls, data: LLMCallSpanData) -> AttributeMap:\n+        trace: Final = cls.trace_attributes(data.trace)\n         return {\n+            **{key: trace[key] for key in (LANGFUSE_RELEASE, LANGFUSE_VERSION) if key in trace},\n             **collect(cls._LLM_CALL_ATTRS, data),\n-            **cls.trace_attributes(data.trace),\n+            **trace,\n             **collect(cls._BLOB_ATTRS, data),\n         }\ndiff --git a/litellm/integrations/otel/model/config.py b/litellm/integrations/otel/model/config.py\nindex b50e927f977e..ea570bc19c96 100644\n--- a/litellm/integrations/otel/model/config.py\n+++ b/litellm/integrations/otel/model/config.py\n@@ -1,5 +1,6 @@\n \"\"\"Typed configuration for the OpenTelemetry instrumentation.\"\"\"\n \n+from collections.abc import Mapping\n from enum import Enum\n from functools import lru_cache\n from typing import Annotated, Final\n@@ -94,6 +95,10 @@ class ExporterSpec(LiteLLMBaseModel):\n             \"different backend's exporter.\"\n         ),\n     )\n+    resource_attributes: Mapping[str, str] = Field(\n+        default_factory=dict,\n+        description=\"Resource attributes only this exporter's copy of a span carries, under the provider's resource.\",\n+    )\n     options: dict[str, str] | None = Field(\n         default=None,\n         description=(\ndiff --git a/litellm/integrations/otel/model/trace_controls.py b/litellm/integrations/otel/model/trace_controls.py\nindex eac7b5c897b5..97938a9a99a3 100644\n--- a/litellm/integrations/otel/model/trace_controls.py\n+++ b/litellm/integrations/otel/model/trace_controls.py\n@@ -17,14 +17,16 @@\n @dataclass(frozen=True, slots=True)\n class TraceControls:\n     \"\"\"The caller's trace-level Langfuse controls: ``metadata.trace_name`` / ``trace_user_id`` / ``session_id`` /\n-    ``tags`` on the request (SDK or proxy body), with the proxy's ``langfuse_<control>`` headers winning over the\n-    body for the scalar ones. Mutation controls (``trace_id``, ``existing_trace_id``, ``update_trace_keys``) are\n-    deliberately not carried.\"\"\"\n+    ``tags`` / ``trace_release`` / ``trace_version`` (else ``version``) on the request (SDK or proxy body), with the\n+    proxy's ``langfuse_<control>`` headers winning over the body for the scalar ones. Mutation controls\n+    (``trace_id``, ``existing_trace_id``, ``update_trace_keys``) are deliberately not carried.\"\"\"\n \n     name: str | None = None\n     user_id: str | None = None\n     session_id: str | None = None\n     tags: tuple[str, ...] = ()\n+    release: str | None = None\n+    version: str | None = None\n \n \n def caller_trace_controls(kwargs: Mapping[str, object]) -> TraceControls:\n@@ -50,6 +52,8 @@ def scalar(control: str) -> str | None:\n         user_id=scalar(\"trace_user_id\"),\n         session_id=scalar(\"session_id\"),\n         tags=next((tags for body in bodies if (tags := _str_items(body.get(\"tags\")))), ()),\n+        release=scalar(\"trace_release\"),\n+        version=scalar(\"trace_version\") or scalar(\"version\"),\n     )\n \n \ndiff --git a/litellm/integrations/otel/plumbing/providers.py b/litellm/integrations/otel/plumbing/providers.py\nindex 0941c065e74e..5525f1797a01 100644\n--- a/litellm/integrations/otel/plumbing/providers.py\n+++ b/litellm/integrations/otel/plumbing/providers.py\n@@ -471,8 +471,14 @@ def without_message_content(span: ReadableSpan) -> ReadableSpan:\n class _CountedSpanView(_SpanView):\n     \"\"\"A ``_SpanView`` of ``inner`` with other attributes that reports the dropped counts ``inner`` reports.\"\"\"\n \n-    def __init__(self, inner: ReadableSpan, attributes: Attributes, dropped_attributes: int = 0) -> None:\n-        super().__init__(inner, inner.resource, attributes, inner.events, inner.status, parent=inner.parent)\n+    def __init__(\n+        self,\n+        inner: ReadableSpan,\n+        attributes: Attributes,\n+        dropped_attributes: int = 0,\n+        resource: Resource | None = None,\n+    ) -> None:\n+        super().__init__(inner, resource or inner.resource, attributes, inner.events, inner.status, parent=inner.parent)\n         self._dropped_counts: Final = (\n             inner.dropped_attributes + dropped_attributes,\n             inner.dropped_events,\n@@ -1299,6 +1305,36 @@ def force_flush(self, timeout_millis: int = 30000) -> bool:\n         return self._inner.force_flush(timeout_millis)\n \n \n+class _ExporterResource(SpanProcessor):\n+    \"\"\"Add one exporter's own resource attributes to every span before ``inner`` exports it, under any value the\n+    span's own resource already names. The merged resource is kept for the next span, since a provider's spans share\n+    one resource.\"\"\"\n+\n+    def __init__(self, inner: SpanProcessor, attributes: Mapping[str, str]) -> None:\n+        self._inner: Final = inner\n+        self._extra: Final = Resource(dict(attributes))\n+        self._merged: tuple[Resource, Resource] | None = None\n+\n+    def on_start(self, span: SDKSpan, parent_context: Context | None = None) -> None:\n+        self._inner.on_start(span, parent_context)\n+\n+    def on_end(self, span: ReadableSpan) -> None:\n+        cached: Final = self._merged\n+        merged: Final = (\n+            cached\n+            if cached is not None and cached[0] is span.resource\n+            else (span.resource, self._extra.merge(span.resource))\n+        )\n+        self._merged = merged\n+        self._inner.on_end(_CountedSpanView(span, span.attributes, resource=merged[1]))\n+\n+    def shutdown(self) -> None:\n+        self._inner.shutdown()\n+\n+    def force_flush(self, timeout_millis: int = 30000) -> bool:\n+        return self._inner.force_flush(timeout_millis)\n+\n+\n class _MessageContentFilter(SpanProcessor):\n     \"\"\"Strip prompt and response content from every span before ``inner`` exports it.\"\"\"\n \n@@ -1576,10 +1612,11 @@ def _spec_processor(\n     strip_destination_langfuse_attributes: bool,\n     langfuse_mapped: bool,\n ) -> SpanProcessor:\n-    exporting: Final = _processor_for(\n+    batching: Final = _processor_for(\n         _exporter_from_spec(spec),\n         (spec.use_simple_processor if spec.use_simple_processor is not None else use_simple_processor),\n     )\n+    exporting: Final = _ExporterResource(batching, spec.resource_attributes) if spec.resource_attributes else batching\n     scoped: Final = (\n         _DestinationLangfuseAttributeFilter(exporting, langfuse_mapped)\n         if strip_destination_langfuse_attributes\ndiff --git a/litellm/integrations/otel/plumbing/routing.py b/litellm/integrations/otel/plumbing/routing.py\nindex 9cf96a1e5e34..9e53688f23c0 100644\n--- a/litellm/integrations/otel/plumbing/routing.py\n+++ b/litellm/integrations/otel/plumbing/routing.py\n@@ -401,4 +401,4 @@ def _routed_exporter(\n             if (field == \"headers\" and routed != spec.headers)\n             or (field == \"endpoint\" and endpoint is not None and endpoint != spec.endpoint)\n         }\n-        return spec if not update else spec.model_copy(update=update)\n+        return spec if not update else spec.model_copy(update={**update, \"resource_attributes\": {}})\ndiff --git a/litellm/integrations/otel/presets/destinations.py b/litellm/integrations/otel/presets/destinations.py\nindex 0bd408240662..a14d1b69b5ae 100644\n--- a/litellm/integrations/otel/presets/destinations.py\n+++ b/litellm/integrations/otel/presets/destinations.py\n@@ -124,21 +124,11 @@ def _arize_default_project() -> Mapping[str, str]:\n     return MappingProxyType({\"model_id\": ARIZE_DEFAULT_PROJECT})\n \n \n-def _stands_in_for_the_legacy_langfuse_logger() -> bool:\n-    \"\"\"Whether a Langfuse destination replaces the older Langfuse logger's copy, which a proxy without Langfuse keys\n-    of its own sends for a key's or team's ``langfuse_otel``.\"\"\"\n-    return not (os.environ.get(\"LANGFUSE_PUBLIC_KEY\") and os.environ.get(\"LANGFUSE_SECRET_KEY\"))\n-\n-\n def _langfuse_environment(params: StandardCallbackDynamicParams) -> Mapping[str, str]:\n-    \"\"\"The key's or team's ``langfuse_environment``, else ``LANGFUSE_TRACING_ENVIRONMENT``, where the older Langfuse\n-    logger wrote it.\"\"\"\n-    from litellm.types.integrations.langfuse_otel import LangfuseSpanAttributes\n-\n-    if not _stands_in_for_the_legacy_langfuse_logger():\n-        return _NO_ATTRS\n-    environment: Final = params.get(\"langfuse_environment\") or os.environ.get(\"LANGFUSE_TRACING_ENVIRONMENT\")\n-    return MappingProxyType({LangfuseSpanAttributes.LANGFUSE_ENVIRONMENT.value: environment} if environment else {})\n+    \"\"\"The key's or team's ``langfuse_environment``, else ``LANGFUSE_TRACING_ENVIRONMENT``.\"\"\"\n+    from litellm.integrations.otel.presets.langfuse import langfuse_environment_attributes\n+\n+    return MappingProxyType(langfuse_environment_attributes(params.get(\"langfuse_environment\")))\n \n \n #: Resource attributes a backend gets on every export the team receives, over the\ndiff --git a/litellm/integrations/otel/presets/langfuse.py b/litellm/integrations/otel/presets/langfuse.py\nindex 3ff3b521d290..60949f7fe8e9 100644\n--- a/litellm/integrations/otel/presets/langfuse.py\n+++ b/litellm/integrations/otel/presets/langfuse.py\n@@ -1,5 +1,7 @@\n \"\"\"Langfuse-OTEL preset.\"\"\"\n \n+import os\n+from collections.abc import Mapping\n from typing import Final\n \n from litellm.integrations.langfuse.langfuse_otel import (\n@@ -14,9 +16,17 @@\n     credential_gated_exporters,\n     ensure_mappers,\n )\n+from litellm.types.integrations.langfuse_otel import LangfuseSpanAttributes\n from litellm.types.utils import StandardCallbackDynamicParams\n \n \n+def langfuse_environment_attributes(environment: str | None = None) -> Mapping[str, str]:\n+    \"\"\"``langfuse.environment`` for ``environment``, else for ``LANGFUSE_TRACING_ENVIRONMENT``. Langfuse reads it off\n+    the resource.\"\"\"\n+    resolved: Final = environment or os.environ.get(\"LANGFUSE_TRACING_ENVIRONMENT\")\n+    return {LangfuseSpanAttributes.LANGFUSE_ENVIRONMENT.value: resolved} if resolved else {}\n+\n+\n def langfuse_preset(\n     *,\n     config_overrides: OpenTelemetryV2Config | None = None,\n@@ -45,6 +55,7 @@ def langfuse_preset(\n                     endpoint=cfg.endpoint,\n                     headers=cfg.headers,\n                     owner=ExporterOwner.LANGFUSE_OTEL,\n+                    resource_attributes=langfuse_environment_attributes(),\n                 ),\n             ],\n             \"mapper_names\": mappers,\n", "test_patch": "diff --git a/tests/integration/observability/test_langfuse_otel_v2_environment.py b/tests/integration/observability/test_langfuse_otel_v2_environment.py\nnew file mode 100644\nindex 000000000000..8c85b757fb24\n--- /dev/null\n+++ b/tests/integration/observability/test_langfuse_otel_v2_environment.py\n@@ -0,0 +1,284 @@\n+import re\n+import uuid\n+from collections.abc import Iterator, Mapping\n+from contextlib import contextmanager\n+from dataclasses import dataclass\n+from pathlib import Path\n+from typing import Final, Literal\n+from urllib.parse import urlparse\n+\n+import pytest\n+import yaml\n+from integration._support.client import Gateway, Scenario, eventually, gateway_from_environment, object_value\n+from integration._support.openai_wire import answering_model_discovery, chat_reply, openai_error, responses_reply\n+from integration._support.otlp_sink import Span, SpanSinks, recorded_spans\n+from integration._support.process import owned_proxy_process\n+from integration._support.wire import Reply, Request, Wire, wire_server\n+from pydantic import JsonValue, TypeAdapter\n+\n+MARKER: Final = re.compile(rb\"lfenv-(?:fail-)?[0-9a-f]{32}\")\n+JSON: Final[TypeAdapter[JsonValue]] = TypeAdapter(JsonValue)\n+SERVER: Final = 2\n+CALL_ID: Final = \"litellm.call_id\"\n+OPERATION: Final = \"gen_ai.operation.name\"\n+ENVIRONMENT: Final = \"langfuse.environment\"\n+RELEASE: Final = \"langfuse.release\"\n+VERSION: Final = \"langfuse.version\"\n+PROXY_ENVIRONMENT: Final = \"itest-proxy\"\n+Endpoint = Literal[\"chat\", \"responses\", \"messages\"]\n+\n+\n+def _marker(kind: str = \"\") -> str:\n+    return f\"lfenv-{kind}{uuid.uuid4().hex}\"\n+\n+\n+def _upstream(request: Request) -> Reply:\n+    found: Final = MARKER.search(request.body)\n+    if found is None:\n+        return Reply(status=404, body=b'{\"error\":\"no marker\"}')\n+    marker: Final = found.group(0).decode()\n+    if marker.startswith(\"lfenv-fail-\"):\n+        return openai_error(500)\n+    stream: Final = object_value(JSON.validate_json(request.body)).get(\"stream\") is True\n+    identity: Final = uuid.uuid4().hex\n+    if request.target.endswith(\"/responses\"):\n+        return responses_reply(f\"resp_{identity}\", \"gpt-4o-mini\", marker, stream=stream)\n+    return chat_reply(f\"chatcmpl-{identity}\", \"gpt-4o-mini\", marker, stream=stream)\n+\n+\n+def _body(model: str, endpoint: Endpoint, marker: str, stream: bool) -> tuple[str, dict[str, JsonValue]]:\n+    if endpoint == \"responses\":\n+        return \"/v1/responses\", {\"model\": model, \"input\": marker, \"stream\": stream}\n+    messages: Final[list[JsonValue]] = [{\"role\": \"user\", \"content\": marker}]\n+    if endpoint == \"messages\":\n+        return \"/v1/messages\", {\"model\": model, \"max_tokens\": 16, \"messages\": messages, \"stream\": stream}\n+    return \"/v1/chat/completions\", {\"model\": model, \"messages\": messages, \"stream\": stream}\n+\n+\n+@dataclass(frozen=True, slots=True)\n+class Sent:\n+    marker: str\n+    trace_id: str\n+    call_id: str\n+    status: int\n+    text: str\n+\n+\n+@dataclass(frozen=True, slots=True)\n+class Rig:\n+    proxy: Gateway\n+    scenario: Scenario\n+    model: str\n+    sinks: SpanSinks\n+\n+    def langfuse(self, environment: str | None = None) -> dict[str, str]:\n+        credentials: Final = {\n+            \"langfuse_public_key\": \"pk-lf-tenant\",\n+            \"langfuse_secret_key\": \"sk-lf-tenant\",\n+            \"langfuse_host\": self.sinks.tenant,\n+        }\n+        return credentials if environment is None else {**credentials, \"langfuse_environment\": environment}\n+\n+    def send(\n+        self,\n+        key: str | None = None,\n+        endpoint: Endpoint = \"chat\",\n+        stream: bool = False,\n+        *,\n+        marker: str | None = None,\n+        metadata: Mapping[str, JsonValue] | None = None,\n+        headers: Mapping[str, str] | None = None,\n+    ) -> Sent:\n+        tagged: Final = marker or _marker()\n+        path, body = _body(self.model, endpoint, tagged, stream)\n+        trace_id: Final = uuid.uuid4().hex\n+        call_id: Final = str(uuid.uuid4())\n+        sent_headers: Final = {\n+            \"Authorization\": f\"Bearer {self.proxy.key if key is None else key}\",\n+            \"traceparent\": f\"00-{trace_id}-{uuid.uuid4().hex[:16]}-01\",\n+            \"x-litellm-call-id\": call_id,\n+            **(headers or {}),\n+        }\n+        payload: Final = body if metadata is None else {**body, \"metadata\": dict(metadata)}\n+        with self.proxy.client.stream(\"POST\", path, json=payload, headers=sent_headers) as response:\n+            text: Final = response.read().decode()\n+            return Sent(tagged, trace_id, call_id, response.status_code, text)\n+\n+\n+def _served(sent: Sent) -> Sent:\n+    assert sent.status == 200, sent.text\n+    assert sent.marker in sent.text, sent.text\n+    return sent\n+\n+\n+def _of_request(url: str, since: int, sent: Sent) -> tuple[Span, ...]:\n+    spans: Final = recorded_spans(url, since)[1]\n+    traces: Final = {sent.trace_id} | {\n+        span[\"trace_id\"] for span in spans if span[\"attributes\"].get(CALL_ID) == sent.call_id\n+    }\n+    return tuple(span for span in spans if span[\"trace_id\"] in traces)\n+\n+\n+def _root(spans: tuple[Span, ...]) -> Span | None:\n+    return next((span for span in spans if span[\"kind\"] == SERVER and span[\"name\"].startswith(\"POST\")), None)\n+\n+\n+def _model(spans: tuple[Span, ...]) -> Span | None:\n+    return next((span for span in spans if OPERATION in span[\"attributes\"]), None)\n+\n+\n+def _trace(url: str, since: int, sent: Sent) -> tuple[Span, ...]:\n+    return eventually(\n+        lambda: _of_request(url, since, sent),\n+        lambda found: _root(found) is not None and _model(found) is not None,\n+        seconds=40,\n+    )\n+\n+\n+def _environments(spans: tuple[Span, ...]) -> set[JsonValue]:\n+    return {span[\"resource\"].get(ENVIRONMENT) for span in spans}\n+\n+\n+def _cursor(url: str) -> int:\n+    return recorded_spans(url)[0]\n+\n+\n+@pytest.mark.parametrize(\n+    (\"endpoint\", \"stream\"),\n+    [(\"chat\", False), (\"chat\", True), (\"responses\", False), (\"messages\", True)],\n+    ids=[\"chat-unary\", \"chat-stream\", \"responses-unary\", \"messages-stream\"],\n+)\n+def test_every_span_of_a_request_names_the_proxy_environment(rig: Rig, endpoint: Endpoint, stream: bool) -> None:\n+    since: Final = _cursor(rig.sinks.operator)\n+    sent: Final = _served(rig.send(endpoint=endpoint, stream=stream))\n+    assert _environments(_trace(rig.sinks.operator, since, sent)) == {PROXY_ENVIRONMENT}\n+\n+\n+def test_a_failed_call_names_the_proxy_environment(rig: Rig) -> None:\n+    since: Final = _cursor(rig.sinks.operator)\n+    sent: Final = rig.send(marker=_marker(\"fail-\"))\n+    assert sent.status >= 500, sent.text\n+    assert _environments(_trace(rig.sinks.operator, since, sent)) == {PROXY_ENVIRONMENT}\n+\n+\n+@pytest.mark.parametrize(\"own\", [True, False], ids=[\"own-environment\", \"no-environment\"])\n+def test_a_key_destination_names_its_own_environment_else_the_proxys(rig: Rig, own: bool) -> None:\n+    environment: Final = f\"key-{uuid.uuid4().hex[:8]}\" if own else None\n+    logging: Final[list[JsonValue]] = [\n+        {\"callback_name\": \"langfuse_otel\", \"callback_type\": \"success\", \"callback_vars\": rig.langfuse(environment)}\n+    ]\n+    key: Final = rig.scenario.key(metadata={\"logging\": logging})\n+    since: Final = _cursor(rig.sinks.tenant)\n+    sent: Final = _served(rig.send(key))\n+    assert _environments(_trace(rig.sinks.tenant, since, sent)) == {environment or PROXY_ENVIRONMENT}\n+\n+\n+def test_a_team_destination_names_its_own_environment(rig: Rig) -> None:\n+    team: Final = rig.scenario.team()\n+    environment: Final = f\"team-{uuid.uuid4().hex[:8]}\"\n+    attached: Final = rig.proxy.request(\n+        \"POST\",\n+        f\"/team/{team}/callback\",\n+        {\"callback_name\": \"langfuse_otel\", \"callback_vars\": rig.langfuse(environment)},\n+    )\n+    assert attached.status_code == 200, attached.text\n+    since: Final = _cursor(rig.sinks.tenant)\n+    sent: Final = _served(rig.send(rig.scenario.key(team_id=team)))\n+    assert _environments(_trace(rig.sinks.tenant, since, sent)) == {environment}\n+\n+\n+@pytest.mark.parametrize(\n+    (\"metadata\", \"headers\", \"expected\"),\n+    [\n+        ({\"trace_release\": \"r-body\", \"trace_version\": \"v-body\"}, {}, (\"r-body\", \"v-body\")),\n+        (\n+            {\"trace_release\": \"r-body\", \"trace_version\": \"v-body\"},\n+            {\"langfuse_trace_release\": \"r-header\", \"langfuse_trace_version\": \"v-header\"},\n+            (\"r-header\", \"v-header\"),\n+        ),\n+        ({\"version\": \"v-plain\"}, {}, (None, \"v-plain\")),\n+        ({}, {}, (None, None)),\n+    ],\n+    ids=[\"metadata\", \"headers-win\", \"plain-version\", \"neither\"],\n+)\n+def test_release_and_version_land_on_the_root_and_model_spans(\n+    rig: Rig, metadata: Mapping[str, JsonValue], headers: Mapping[str, str], expected: tuple[str | None, str | None]\n+) -> None:\n+    since: Final = _cursor(rig.sinks.operator)\n+    sent: Final = _served(rig.send(metadata=metadata, headers=headers))\n+    spans: Final = _trace(rig.sinks.operator, since, sent)\n+    root, model = _root(spans), _model(spans)\n+    assert root is not None and model is not None\n+    for attributes in (root[\"attributes\"], model[\"attributes\"]):\n+        assert (attributes.get(RELEASE), attributes.get(VERSION)) == expected, sorted(attributes)\n+\n+\n+def test_no_environment_set_names_none(bare_rig: Rig) -> None:\n+    since: Final = _cursor(bare_rig.sinks.operator)\n+    sent: Final = _served(bare_rig.send())\n+    assert _environments(_trace(bare_rig.sinks.operator, since, sent)) == {None}\n+\n+\n+def _write_config(directory: Path, sinks: SpanSinks) -> Path:\n+    config: Final = yaml.safe_load(Path(\"tests/integration/proxy_config.yaml\").read_text())\n+    config[\"litellm_settings\"] = {\n+        **config.get(\"litellm_settings\", {}),\n+        \"callbacks\": [\"langfuse_otel\"],\n+        \"provider_url_destination_allowed_hosts\": [urlparse(sinks.tenant).netloc],\n+    }\n+    config[\"general_settings\"] = {**config.get(\"general_settings\", {}), \"user_api_key_cache_ttl\": 2}\n+    path: Final = directory / \"langfuse-environment.yaml\"\n+    path.write_text(yaml.safe_dump(config))\n+    return path\n+\n+\n+@contextmanager\n+def _started(provider: Wire, sinks: SpanSinks, directory: Path, overrides: Mapping[str, str]) -> Iterator[Rig]:\n+    environment: Final = {\n+        \"LITELLM_OTEL_V2\": \"1\",\n+        \"OTEL_BSP_SCHEDULE_DELAY\": \"300\",\n+        \"LANGFUSE_HOST\": sinks.operator,\n+        \"LANGFUSE_PUBLIC_KEY\": \"pk-lf-operator\",\n+        \"LANGFUSE_SECRET_KEY\": \"sk-lf-operator\",\n+        **overrides,\n+    }\n+    with (\n+        gateway_from_environment() as gateway,\n+        owned_proxy_process(\n+            gateway,\n+            directory,\n+            environment,\n+            config=_write_config(directory, sinks),\n+            remove_environment=tuple(\n+                name\n+                for name in (\"LANGFUSE_TRACING_ENVIRONMENT\", \"OTEL_ENVIRONMENT_NAME\", \"LANGFUSE_RELEASE\")\n+                if name not in overrides\n+            ),\n+            workers=2,\n+        ) as owned,\n+        owned.gateway.scenario() as scenario,\n+    ):\n+        yield Rig(owned.gateway, scenario, scenario.model(api_base=provider.url + \"/v1\"), sinks)\n+\n+\n+@pytest.fixture(scope=\"module\")\n+def provider() -> Iterator[Wire]:\n+    with wire_server(answering_model_discovery(_upstream)) as wire:\n+        yield wire\n+\n+\n+@pytest.fixture(scope=\"module\")\n+def rig(provider: Wire, audit_sinks: SpanSinks, tmp_path_factory: pytest.TempPathFactory) -> Iterator[Rig]:\n+    with _started(\n+        provider,\n+        audit_sinks,\n+        tmp_path_factory.mktemp(\"langfuse-environment\"),\n+        {\"LANGFUSE_TRACING_ENVIRONMENT\": PROXY_ENVIRONMENT},\n+    ) as started:\n+        yield started\n+\n+\n+@pytest.fixture(scope=\"module\")\n+def bare_rig(provider: Wire, audit_sinks: SpanSinks, tmp_path_factory: pytest.TempPathFactory) -> Iterator[Rig]:\n+    with _started(provider, audit_sinks, tmp_path_factory.mktemp(\"langfuse-environment-unset\"), {}) as started:\n+        yield started\ndiff --git a/tests/unit/integrations/otel/test_langfuse_logger.py b/tests/unit/integrations/otel/test_langfuse_logger.py\nindex 1ac6635b8ee9..d395ad0d2999 100644\n--- a/tests/unit/integrations/otel/test_langfuse_logger.py\n+++ b/tests/unit/integrations/otel/test_langfuse_logger.py\n@@ -13,6 +13,8 @@\n \n from opentelemetry import trace  # noqa: E402  # needs the importorskip above\n from opentelemetry.context import Context  # noqa: E402  # needs the importorskip above\n+from opentelemetry.sdk.trace import SpanLimits, TracerProvider  # noqa: E402  # needs the importorskip above\n+from opentelemetry.sdk.trace.export import SimpleSpanProcessor  # noqa: E402  # needs the importorskip above\n from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter  # noqa: E402\n from opentelemetry.trace import SpanKind  # noqa: E402\n \n@@ -713,3 +715,32 @@ def test_failed_generation_without_a_first_chunk_has_no_completion_start_time()\n     attrs: Final = _generation_attrs(_llm_call_kwargs({\"stream\": True}, None), fail=True)\n \n     assert COMPLETION_START_ATTR not in attrs\n+\n+\n+@pytest.mark.parametrize(\"room\", [0, 1, 2], ids=[\"full\", \"one-free\", \"two-free\"])\n+def test_release_and_version_never_push_an_attribute_off_a_root_span_at_its_limit(room: int) -> None:\n+    server: Final = {\"http.method\": \"POST\", \"http.scheme\": \"http\", \"http.route\": \"/v1/chat/completions\"}\n+    cfg: Final = OpenTelemetryV2Config(exporter=\"in_memory\", mapper_names=[\"genai\", \"langfuse\"])\n+    exporter: Final = InMemorySpanExporter()\n+    provider: Final = TracerProvider(span_limits=SpanLimits(max_span_attributes=len(server) + 1 + room))\n+    provider.add_span_processor(SimpleSpanProcessor(exporter))\n+    logger: Final = build_otel_v2_logger(config=cfg, tracer_provider=provider)\n+    root: Final = provider.get_tracer(\"server\").start_span(\"POST /v1/chat/completions\")\n+    root.set_attributes(server)\n+    set_request_root_span(root)\n+\n+    logger.log_pre_api_call(\n+        model=\"gpt-5.4-mini\",\n+        messages=[],\n+        kwargs={\n+            \"litellm_call_id\": \"call_1\",\n+            \"litellm_params\": {\n+                \"metadata\": {\"trace_name\": \"checkout\", \"trace_release\": \"rel-1\", \"trace_version\": \"v-1\"}\n+            },\n+        },\n+    )\n+    root.end()\n+\n+    stamped: Final = dict(exporter.get_finished_spans()[0].attributes or {})\n+    assert stamped.items() >= {**server, TRACE_NAME_ATTR: \"checkout\"}.items()\n+    assert (\"langfuse.release\" in stamped, \"langfuse.version\" in stamped) == (room == 2, room == 2)\ndiff --git a/tests/unit/integrations/otel/test_otel_v2_destinations.py b/tests/unit/integrations/otel/test_otel_v2_destinations.py\nindex 256b9e5e4802..60635c5ce457 100644\n--- a/tests/unit/integrations/otel/test_otel_v2_destinations.py\n+++ b/tests/unit/integrations/otel/test_otel_v2_destinations.py\n@@ -3665,6 +3665,7 @@ def test_an_exporter_whose_config_maps_langfuse_keeps_the_langfuse_fields_but_th\n         }\n         assert not LANGFUSE_REQUEST_METADATA_ATTRIBUTES & received[None].keys()\n \n+    @pytest.mark.parametrize(\"operator_keys\", [False, True], ids=[\"no-operator-keys\", \"operator-keys\"])\n     @pytest.mark.parametrize(\n         (\"key_environment\", \"tracing_environment\", \"expected\"),\n         [\n@@ -3675,14 +3676,18 @@ def test_an_exporter_whose_config_maps_langfuse_keeps_the_langfuse_fields_but_th\n         ],\n         ids=[\"key\", \"key-over-env\", \"env\", \"neither\"],\n     )\n-    def test_a_langfuse_destination_names_the_environment_the_legacy_logger_wrote(\n+    def test_a_langfuse_destination_names_its_own_environment_else_the_proxys(\n         self,\n         monkeypatch: pytest.MonkeyPatch,\n         key_environment: str | None,\n         tracing_environment: str | None,\n         expected: Mapping[str, str],\n+        operator_keys: bool,\n     ) -> None:\n         credential_less_proxy(monkeypatch)\n+        if operator_keys:\n+            monkeypatch.setenv(\"LANGFUSE_PUBLIC_KEY\", \"pk-operator\")\n+            monkeypatch.setenv(\"LANGFUSE_SECRET_KEY\", \"sk-operator\")\n         if tracing_environment is None:\n             monkeypatch.delenv(\"LANGFUSE_TRACING_ENVIRONMENT\", raising=False)\n         else:\n@@ -3698,22 +3703,54 @@ def test_a_langfuse_destination_names_the_environment_the_legacy_logger_wrote(\n         assert destination is not None\n         assert dict(destination.resource_attributes) == expected\n \n-    def test_a_langfuse_destination_on_a_proxy_with_langfuse_keys_names_no_environment(\n+    @pytest.mark.parametrize(\"tracing_environment\", [\"staging\", None], ids=[\"env\", \"unset\"])\n+    def test_only_the_proxys_langfuse_exporter_names_the_proxys_environment(\n+        self, monkeypatch: pytest.MonkeyPatch, tracing_environment: str | None\n+    ) -> None:\n+        monkeypatch.setenv(\"LANGFUSE_PUBLIC_KEY\", \"pk-operator\")\n+        monkeypatch.setenv(\"LANGFUSE_SECRET_KEY\", \"sk-operator\")\n+        if tracing_environment is None:\n+            monkeypatch.delenv(\"LANGFUSE_TRACING_ENVIRONMENT\", raising=False)\n+        else:\n+            monkeypatch.setenv(\"LANGFUSE_TRACING_ENVIRONMENT\", tracing_environment)\n+        capture: Final = _ExporterCapture()\n+        for kind in (\"otlp_grpc\", \"otlp_http\", \"console\"):\n+            monkeypatch.setitem(otel_providers._EXPORTER_FACTORIES, kind, capture.build)  # pyright: ignore[reportPrivateUsage]  # the factory table is the seam for capturing each exporter\n+        collector: Final = ExporterSpec(kind=\"otlp_http\", endpoint=\"http://collector:4318\", headers=\"x-collector=1\")\n+        config: Final = langfuse_preset(config_overrides=OpenTelemetryV2Config(exporters=[collector]))\n+        provider: Final = build_tracer_provider(config)\n+\n+        SpanEmitter(get_tracer(provider, \"litellm\"), config).emit(SpanRole.LLM_CALL, _MODEL_CALL_WITHOUT_CONTENT)\n+        provider.force_flush()\n+\n+        environments: Final = {\n+            headers == collector.headers: exporter.get_finished_spans()[0].resource.attributes.get(\n+                \"langfuse.environment\"\n+            )\n+            for headers, exporter in capture.built\n+        }\n+        assert environments == {True: None, False: tracing_environment}\n+        assert \"langfuse.environment\" not in otel_providers.build_resource(config).attributes\n+\n+    def test_an_environment_the_proxys_resource_already_names_wins_on_the_langfuse_exporter(\n         self, monkeypatch: pytest.MonkeyPatch\n     ) -> None:\n-        \"\"\"With operator keys the older Langfuse logger never runs, so there is no environment of its to keep.\"\"\"\n         monkeypatch.setenv(\"LANGFUSE_PUBLIC_KEY\", \"pk-operator\")\n         monkeypatch.setenv(\"LANGFUSE_SECRET_KEY\", \"sk-operator\")\n+        monkeypatch.setenv(\"LANGFUSE_TRACING_ENVIRONMENT\", \"staging\")\n+        monkeypatch.setenv(\"OTEL_RESOURCE_ATTRIBUTES\", \"langfuse.environment=from-resource\")\n+        capture: Final = _ExporterCapture()\n+        monkeypatch.setitem(otel_providers._EXPORTER_FACTORIES, \"otlp_http\", capture.build)  # pyright: ignore[reportPrivateUsage]  # the factory table is the seam for capturing each exporter\n+        config: Final = langfuse_preset()\n+        provider: Final = build_tracer_provider(config)\n \n-        destination: Final = destination_for(\n-            \"langfuse_otel\",\n-            StandardCallbackDynamicParams(\n-                langfuse_public_key=\"pk\", langfuse_secret_key=\"sk\", langfuse_environment=\"prod\"\n-            ),\n-        )\n+        SpanEmitter(get_tracer(provider, \"litellm\"), config).emit(SpanRole.LLM_CALL, _MODEL_CALL_WITHOUT_CONTENT)\n+        provider.force_flush()\n \n-        assert destination is not None\n-        assert dict(destination.resource_attributes) == {}\n+        assert [\n+            exporter.get_finished_spans()[0].resource.attributes.get(\"langfuse.environment\")\n+            for _headers, exporter in capture.built\n+        ] == [\"from-resource\"]\n \n     @pytest.mark.parametrize(\"operator_keys\", [False, True], ids=[\"no-operator-keys\", \"operator-keys\"])\n     @pytest.mark.parametrize(\"configured\", [None, \"no_content\", \"span_only\"])\n@@ -3814,6 +3851,26 @@ def test_a_span_at_its_attribute_limit_sheds_the_destinations_langfuse_fields_fi\n             \"the generic attributes all survive\"\n         )\n \n+    def test_a_span_at_its_attribute_limit_sheds_the_release_and_version_before_its_other_fields(self) -> None:\n+        call: Final = replace(\n+            _MODEL_CALL_WITH_CONTENT,\n+            trace=TraceControls(release=\"rel-1\", version=\"v-1\"),\n+            request_metadata=MappingProxyType({\"user_api_key_alias\": \"prod-key\"}),\n+        )\n+        config: Final = OpenTelemetryV2Config(mapper_names=[\"genai\", \"langfuse\"])\n+\n+        def attributes(limit: int | None) -> dict[str, object]:\n+            exporter: Final = InMemorySpanExporter()\n+            provider: Final = TracerProvider(span_limits=SpanLimits(max_span_attributes=limit))\n+            provider.add_span_processor(SimpleSpanProcessor(exporter))\n+            SpanEmitter(get_tracer(provider, \"litellm\"), config).emit(SpanRole.LLM_CALL, call)\n+            return dict(exporter.get_finished_spans()[0].attributes or {})\n+\n+        whole: Final = attributes(None)\n+\n+        assert LANGFUSE_REQUEST_METADATA_ATTRIBUTES & whole.keys() > {\"langfuse.release\", \"langfuse.version\"}\n+        assert whole.keys() - attributes(len(whole) - 2).keys() == {\"langfuse.release\", \"langfuse.version\"}\n+\n     def test_a_span_at_its_attribute_limit_sheds_the_destinations_request_metadata_before_its_other_fields(\n         self,\n     ) -> None:\ndiff --git a/tests/unit/integrations/otel/test_otel_v2_dynamic.py b/tests/unit/integrations/otel/test_otel_v2_dynamic.py\nindex 8163ba063172..bf009b4e879a 100644\n--- a/tests/unit/integrations/otel/test_otel_v2_dynamic.py\n+++ b/tests/unit/integrations/otel/test_otel_v2_dynamic.py\n@@ -2,6 +2,7 @@\n \n import base64\n import logging\n+from typing import Final\n \n import pytest\n from opentelemetry.trace import NoOpTracer\n@@ -743,3 +744,21 @@ def test_signoz_keyless_team_endpoint_is_ignored_so_the_operator_key_never_reach\n     owned = next(e for e in routed.exporters if e.owner == \"signoz\")\n     assert owned.endpoint == \"https://ingest.us.signoz.cloud:443\"\n     assert owned.headers == \"signoz-ingestion-key=OPERATOR\"\n+\n+\n+def test_an_exporter_routed_to_a_tenants_credentials_drops_the_operators_resource_attributes() -> None:\n+    cache: Final = _cache(\n+        \"langfuse_otel\",\n+        exporters=[\n+            ExporterSpec(\n+                kind=\"otlp_http\",\n+                owner=\"langfuse_otel\",\n+                headers=\"Authorization=Basic operator\",\n+                resource_attributes={\"langfuse.environment\": \"operator-env\"},\n+            )\n+        ],\n+    )\n+\n+    (routed,) = cache._routed_config({\"Authorization\": \"Basic tenant\"}, {}).exporters\n+\n+    assert (routed.headers, dict(routed.resource_attributes)) == (\"Authorization=Basic tenant\", {})\ndiff --git a/tests/unit/integrations/otel/test_otel_v2_sources_of_truth.py b/tests/unit/integrations/otel/test_otel_v2_sources_of_truth.py\nindex 3c95a85e9a81..673e6d4f485a 100644\n--- a/tests/unit/integrations/otel/test_otel_v2_sources_of_truth.py\n+++ b/tests/unit/integrations/otel/test_otel_v2_sources_of_truth.py\n@@ -821,8 +821,8 @@ def test_responses_tool_calls_fold_into_the_assistant_message_with_tool_calls_fi\n \n \n def test_responses_claude_web_calls_lead_the_tool_calls_without_ending_the_turn_on_tool_calls():\n-    claude_fetch: Final = (\n-        build_web_search_call(\"srvtoolu_01\", {\"url\": \"https://example.com/\"}, None, tool_name=\"web_fetch\")\n+    claude_fetch: Final = build_web_search_call(\n+        \"srvtoolu_01\", {\"url\": \"https://example.com/\"}, None, tool_name=\"web_fetch\"\n     )\n     openai_search: Final = {\n         \"type\": \"web_search_call\",\n@@ -1414,6 +1414,33 @@ def test_caller_trace_controls_carry_user_session_and_tags(request_data, expecte\n     assert LLMCallEvent.from_dict({\"litellm_params\": request_data}).trace == expected\n \n \n+@pytest.mark.parametrize(\n+    (\"request_data\", \"release\", \"version\"),\n+    [\n+        ({\"metadata\": {\"trace_release\": \"r-body\", \"trace_version\": \"v-body\"}}, \"r-body\", \"v-body\"),\n+        (\n+            {\n+                \"proxy_server_request\": {\n+                    \"headers\": {\"langfuse_trace_release\": \"r-header\", \"langfuse_trace_version\": \"v-header\"}\n+                },\n+                \"metadata\": {\"trace_release\": \"r-body\", \"trace_version\": \"v-body\"},\n+            },\n+            \"r-header\",\n+            \"v-header\",\n+        ),\n+        ({\"litellm_metadata\": {\"trace_release\": \"r-anthropic\", \"version\": \"v-plain\"}}, \"r-anthropic\", \"v-plain\"),\n+        ({\"metadata\": {\"trace_version\": \"v-trace\", \"version\": \"v-plain\"}}, None, \"v-trace\"),\n+        ({\"proxy_server_request\": {\"headers\": {\"langfuse_version\": \"v-header-plain\"}}}, None, \"v-header-plain\"),\n+        ({\"metadata\": {\"user_api_key_team_id\": \"t1\"}}, None, None),\n+    ],\n+    ids=[\"body\", \"headers-beat-body\", \"anthropic-body\", \"trace-version-beats-version\", \"version-header\", \"neither\"],\n+)\n+def test_caller_trace_controls_carry_release_and_version(request_data, release, version):\n+    controls: Final = caller_trace_controls({\"litellm_params\": request_data})\n+\n+    assert (controls.release, controls.version) == (release, version)\n+\n+\n def test_llm_span_data_carries_the_caller_trace_controls():\n     controls: Final = TraceControls(name=\"nightly-eval\", user_id=\"u1\", session_id=\"s1\", tags=(\"a\", \"b\"))\n     data: Final = LLMCallSpanData.from_standard_logging_payload(_sample_payload(), trace=controls)\ndiff --git a/tests/unit/integrations/otel/test_otel_v2_vendor_mappers.py b/tests/unit/integrations/otel/test_otel_v2_vendor_mappers.py\nindex 9551c22a1859..5fbc39127f4b 100644\n--- a/tests/unit/integrations/otel/test_otel_v2_vendor_mappers.py\n+++ b/tests/unit/integrations/otel/test_otel_v2_vendor_mappers.py\n@@ -681,6 +681,18 @@ def test_langfuse_trace_attributes_match_between_root_and_generation():\n     assert all(generation[key] == value for key, value in root.items())\n \n \n+def test_langfuse_mapper_sends_release_and_version_on_root_and_generation():\n+    controls: Final = TraceControls(release=\"commit-abc\", version=\"v2\")\n+\n+    root: Final = LangfuseMapper.trace_attributes(controls)\n+    generation: Final = LangfuseMapper().map(_llm_call(trace=controls))\n+\n+    assert root == {\"langfuse.release\": \"commit-abc\", \"langfuse.version\": \"v2\"}\n+    assert all(generation[key] == value for key, value in root.items())\n+    assert root.keys() <= LangfuseMapper.LLM_CALL_ATTRIBUTES\n+    assert root.keys().isdisjoint(LangfuseMapper().map(_llm_call(trace=TraceControls(release=\"\", version=None))))\n+\n+\n def test_langfuse_mapper_skips_when_no_messages():\n     data = _llm_call(messages_in=(), choices_out=())\n     attrs = LangfuseMapper().map(data)\n", "problem_statement": "[Bug]: OTel v2 LangfuseMapper drops langfuse.environment / release / version (parity regression from OTel v1)\n## What happened?\n\nOn the OTel **v2** Langfuse export path, the mapper never sets the Langfuse span attributes `langfuse.environment`, `langfuse.release`, or `langfuse.version`. As a result:\n\n- A caller-supplied `langfuse_environment` (and `trace_release` / `trace_version`) silently collapses to `environment = \"default\"` in **Langfuse v4**, and release/version never land.\n- The `LANGFUSE_TRACING_ENVIRONMENT` env var is also ignored on this path \u2014 even the deployment-wide default environment is not emitted, so traces show `environment = \"default\"` instead of the configured stage.\n\nThis is a **parity regression**: the retired OTel **v1** `LangfuseOtelLogger` *did* set `langfuse.environment` from `standard_callback_dynamic_params[\"langfuse_environment\"]` with the `LANGFUSE_TRACING_ENVIRONMENT` fallback (`litellm/integrations/langfuse/langfuse_otel.py`, `_set_langfuse_specific_attributes`). The v1\u2192v2 rewrite (`litellm/integrations/otel/mappers/langfuse.py`, `LangfuseMapper`) kept name/user/session/tags but dropped environment/release/version.\n\nLangfuse v4 maps these from span attributes (its own OTEL docs): `langfuse.environment` \u2192 environment (precedence over `deployment.environment`), `langfuse.release` \u2192 trace release, `langfuse.version` \u2192 observation version. Per Langfuse docs these must be present **on the span** to be filterable.\n\n## Reproduction\n\n1. Run the proxy with the OTel v2 pipeline enabled (`LITELLM_OTEL_V2=true`) and the `langfuse_otel` callback, against a Langfuse v4 deployment.\n2. Admit `langfuse_environment` (see \"Related gap\" below) and send:\n\n   ```json\n   POST /chat/completions\n   {\n     \"model\": \"<any>\",\n     \"metadata\": {\n       \"langfuse_environment\": \"test\",\n       \"trace_release\": \"commit-abc123\",\n       \"trace_version\": \"sha256-deadbeef\"\n     },\n     \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n   }\n   ```\n3. Read the trace via `GET /api/public/v2/observations`. **Expected:** `environment=\"test\"`, `release=\"commit-abc123\"`, `version=\"sha256-deadbeef\"`. **Actual:** `environment=\"default\"`, release/version empty.\n\n## Root cause (v1.105.1)\n\n- `litellm/litellm_core_utils/litellm_logging.py` \u2014 `langfuse_otel` prefers the v2 logger (`LangfuseOpenTelemetryV2`), which stamps attributes via `LangfuseMapper`.\n- `litellm/integrations/otel/mappers/langfuse.py` \u2014 `LangfuseMapper._LLM_CALL_ATTRS` / `trace_attributes` emit `langfuse.trace.*` / `langfuse.observation.*` (name, tags, team, usage, cost) but **no** `langfuse.environment` / `langfuse.release` / `langfuse.version`.\n- `litellm/integrations/otel/model/trace_controls.py` \u2014 `TraceControls` / `caller_trace_controls` carry only `name`/`user_id`/`session_id`/`tags`.\n\n## Suggested fix\n\nCarry `environment` / `release` / `version` on `TraceControls` and emit them in `LangfuseMapper.trace_attributes`, sourced (in precedence order) from:\n\n1. request headers `langfuse_environment` / `langfuse_release` / `langfuse_version`,\n2. request metadata `langfuse_environment` / `trace_release` / `trace_version`,\n3. `LANGFUSE_TRACING_ENVIRONMENT` fallback (environment only).\n\n## Related gap (separate but required to use it)\n\n`langfuse_environment` is in `_BANNED_REQUEST_BODY_PARAMS`, so it 401s unless admitted. Today the only selective mechanism is **per-deployment** `configurable_clientside_auth_params`; there is no **proxy-wide selective** allowlist \u2014 only the all-or-nothing `general_settings.allow_client_side_credentials`, which lifts the entire blocklist (incl. `api_base`, `azure_ad_token`, AWS identity selectors) with no URL validation (see #37053).\n\n**Request:** support `general_settings.configurable_clientside_auth_params` (proxy-wide, selective) so an operator can admit a benign observability param for every model without opening the credential-exfil surface. This mirrors the existing per-deployment `_is_param_allowed` semantics.\n\nExample proxy config (what we run):\n\n```yaml\ngeneral_settings:\n  # Proxy-wide SELECTIVE allowlist: admit ONLY langfuse_environment from the\n  # request, for EVERY model, without lifting the whole banned-credentials\n  # blocklist the way allow_client_side_credentials would.\n  configurable_clientside_auth_params: [\"langfuse_environment\"]\n```\n\nWith that set, both request placements work for any model:\n\n```json\n{\n  \"model\": \"any/model\",\n  \"metadata\": { \"langfuse_environment\": \"prod\", \"trace_release\": \"<sha>\", \"trace_version\": \"<digest>\" },\n  \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n}\n```\n\nor via headers: `langfuse_environment: prod`, `langfuse_release: <sha>`, `langfuse_version: <digest>`. Unlisted params (e.g. `api_base`) remain rejected.\n\n## Related issues\n\n- #10020 \u2014 \"Support passing environment to langfuse per key\" (closed; covered the **legacy** path only).\n- #19926 \u2014 \"Langfuse Tracing Environment not populated on all spans\" (closed; **legacy** path only).\n- #37053 \u2014 SSRF/key-exfil via client-supplied `api_base` under clientside-auth opt-ins (motivates keeping admission selective, not global).\n\n## Environment\n\n- LiteLLM version: 1.105.1 (OTel v2 enabled)\n- Langfuse: v4 (events_only / OTel ingestion)\n\n\n---\n\n## Proposed patches (apply cleanly to v1.105.1; `patch -p1` from the repo root)\n\nWe are running these two patches locally and they resolve both parts of the issue. Sharing as reference / starting point \u2014 happy to open a PR if you'd like.\n\n<details><summary><b>Patch 1 \u2014 emit langfuse.environment / release / version on OTel-v2 spans (body + header)</b></summary>\n\n```diff\ndiff --git a/litellm/integrations/otel/mappers/langfuse.py b/litellm/integrations/otel/mappers/langfuse.py\nindex 6886093..1632a4d 100644\n--- a/litellm/integrations/otel/mappers/langfuse.py\n+++ b/litellm/integrations/otel/mappers/langfuse.py\n@@ -35,6 +35,13 @@ LANGFUSE_TRACE_NAME: Final = \"langfuse.trace.name\"\n LANGFUSE_TRACE_USER_ID: Final = \"user.id\"\n LANGFUSE_TRACE_SESSION_ID: Final = \"session.id\"\n LANGFUSE_TRACE_TAGS: Final = \"langfuse.trace.tags\"\n+# Per-request trace/release metadata Langfuse v4 reads off the span. ``langfuse.environment``\n+# is the documented observation- and trace-level environment key (takes precedence over\n+# ``deployment.environment``); ``langfuse.release`` / ``langfuse.version`` map to the trace\n+# release and observation version respectively.\n+LANGFUSE_ENVIRONMENT: Final = \"langfuse.environment\"\n+LANGFUSE_RELEASE: Final = \"langfuse.release\"\n+LANGFUSE_VERSION: Final = \"langfuse.version\"\n \n \n class LangfuseMapper:\n@@ -96,6 +103,9 @@ class LangfuseMapper:\n                 (LANGFUSE_TRACE_USER_ID, trace.user_id or None),\n                 (LANGFUSE_TRACE_SESSION_ID, trace.session_id or None),\n                 (LANGFUSE_TRACE_TAGS, trace.tags or None),\n+                (LANGFUSE_ENVIRONMENT, trace.environment or None),\n+                (LANGFUSE_RELEASE, trace.release or None),\n+                (LANGFUSE_VERSION, trace.version or None),\n             )\n         )\n \ndiff --git a/litellm/integrations/otel/model/trace_controls.py b/litellm/integrations/otel/model/trace_controls.py\nindex eac7b5c..5f78236 100644\n--- a/litellm/integrations/otel/model/trace_controls.py\n+++ b/litellm/integrations/otel/model/trace_controls.py\n@@ -2,6 +2,7 @@\n \n from __future__ import annotations\n \n+import os\n from collections.abc import Mapping\n from dataclasses import dataclass\n from typing import Final\n@@ -13,18 +14,30 @@ from litellm.integrations.otel.model.utils import as_str, as_str_mapping\n LANGFUSE_HEADER_PREFIX: Final = \"langfuse_\"\n _ITEMS: Final = TypeAdapter(tuple[object, ...])\n \n+# Deployment-wide tracing environment fallback, mirroring the legacy\n+# ``langfuse_otel`` logger and the ``LANGFUSE_TRACING_ENVIRONMENT`` env var the\n+# proxy sets per-stage. Read at call time so per-request overrides win.\n+LANGFUSE_TRACING_ENVIRONMENT: Final = \"LANGFUSE_TRACING_ENVIRONMENT\"\n+\n \n @dataclass(frozen=True, slots=True)\n class TraceControls:\n     \"\"\"The caller's trace-level Langfuse controls: ``metadata.trace_name`` / ``trace_user_id`` / ``session_id`` /\n     ``tags`` on the request (SDK or proxy body), with the proxy's ``langfuse_<control>`` headers winning over the\n     body for the scalar ones. Mutation controls (``trace_id``, ``existing_trace_id``, ``update_trace_keys``) are\n-    deliberately not carried.\"\"\"\n+    deliberately not carried.\n+\n+    ``environment`` / ``release`` / ``version`` let a caller (e.g. CHEMS) tag each trace with its own deployment\n+    stage and release identifiers. ``environment`` falls back to the gateway's ``LANGFUSE_TRACING_ENVIRONMENT``\n+    when the request does not set one, preserving the per-stage behaviour the legacy logger provided.\"\"\"\n \n     name: str | None = None\n     user_id: str | None = None\n     session_id: str | None = None\n     tags: tuple[str, ...] = ()\n+    environment: str | None = None\n+    release: str | None = None\n+    version: str | None = None\n \n \n def caller_trace_controls(kwargs: Mapping[str, object]) -> TraceControls:\n@@ -45,11 +58,39 @@ def caller_trace_controls(kwargs: Mapping[str, object]) -> TraceControls:\n             return from_header\n         return next((value for body in bodies if (value := as_str(body.get(control)))), None)\n \n+    def body_scalar(*controls: str) -> str | None:\n+        \"\"\"First non-empty value across the request metadata bodies for any of ``controls``.\"\"\"\n+        for control in controls:\n+            value: Final = next((v for body in bodies if (v := as_str(body.get(control)))), None)\n+            if value:\n+                return value\n+        return None\n+\n+    def header_scalar(*controls: str) -> str | None:\n+        \"\"\"First non-empty ``langfuse_<control>`` request header for any of ``controls``.\n+\n+        Mirrors the precedence of the other trace controls: an explicit header wins over\n+        the request body, then the deployment fallback applies.\"\"\"\n+        if headers is None:\n+            return None\n+        for control in controls:\n+            value: Final = as_str(headers.get(f\"{LANGFUSE_HEADER_PREFIX}{control}\"))\n+            if value:\n+                return value\n+        return None\n+\n     return TraceControls(\n         name=scalar(\"trace_name\"),\n         user_id=scalar(\"trace_user_id\"),\n         session_id=scalar(\"session_id\"),\n         tags=next((tags for body in bodies if (tags := _str_items(body.get(\"tags\")))), ()),\n+        environment=(\n+            header_scalar(\"environment\")\n+            or body_scalar(\"langfuse_environment\")\n+            or os.environ.get(LANGFUSE_TRACING_ENVIRONMENT)\n+        ),\n+        release=header_scalar(\"release\") or body_scalar(\"trace_release\", \"release\"),\n+        version=header_scalar(\"version\") or body_scalar(\"trace_version\", \"version\"),\n     )\n```\n\n</details>\n\n<details><summary><b>Patch 2 \u2014 proxy-wide selective clientside allowlist (general_settings.configurable_clientside_auth_params)</b></summary>\n\n```diff\ndiff --git a/litellm/proxy/auth/auth_utils.py b/litellm/proxy/auth/auth_utils.py\nindex f20bdad..c6db67d 100644\n--- a/litellm/proxy/auth/auth_utils.py\n+++ b/litellm/proxy/auth/auth_utils.py\n@@ -395,6 +395,23 @@ def _check_banned_params(\n             # Proxy-wide opt-in: every banned param is permitted, exit\n             # entirely so the rest of the loop doesn't waste work.\n             return\n+        if (\n+            _is_param_allowed(\n+                param=param,\n+                request_body_value=body[param],\n+                configurable_clientside_auth_params=general_settings.get(\n+                    \"configurable_clientside_auth_params\"\n+                ),\n+            )\n+            is True\n+        ):\n+            # Proxy-wide SELECTIVE opt-in: only the params the admin named in\n+            # ``general_settings.configurable_clientside_auth_params`` are\n+            # permitted, for EVERY model. Unlike ``allow_client_side_credentials``\n+            # (which lifts the whole blocklist), this admits only the listed\n+            # params, so a client that may set ``langfuse_environment`` still\n+            # cannot smuggle ``api_base``/``aws_web_identity_token``/etc.\n+            continue\n         if (\n             _allow_model_level_clientside_configurable_parameters(\n                 model=model,\n```\n\n</details>\n\nBoth are covered by unit + send-and-fetch regression tests on our side; happy to share those too.\n\n\n", "hints_text": "### \ud83d\udd0d Root Cause Analysis & Architectural Resolution\n\nAfter reviewing the OTel v1 vs v2 parity in `litellm/integrations/otel/mappers/langfuse.py` and `litellm/integrations/otel/model/trace_controls.py`, the dropping of `langfuse.environment`, `langfuse.release`, and `langfuse.version` stems from two decoupled layers:\n\n1. **Span Attribute Mapping & Extraction Gap (`litellm/integrations/otel`):**\n   * The `TraceControls` dataclass omits fields for `environment`, `release`, and `version`.\n   * `LangfuseMapper.trace_attributes()` therefore lacks inputs to populate `langfuse.environment`, `langfuse.release`, and `langfuse.version` on the exported OpenTelemetry spans, causing Langfuse v4 ingestion to collapse every incoming request into `environment = \"default\"`.\n   * Falling back to `os.environ.get(\"LANGFUSE_TRACING_ENVIRONMENT\")` was present in the retired v1 logger (`litellm/integrations/langfuse/langfuse_otel.py::_set_langfuse_specific_attributes`) but missing in the v2 pipeline.\n\n2. **Parameter Admission / Blocklist Surface:**\n   * Passing `langfuse_environment` via client request metadata triggers the `_BANNED_REQUEST_BODY_PARAMS` check (returning `HTTP 401`) unless `allow_client_side_credentials: true` is explicitly opted into, which is undesirable because it opens up the entire credential exfiltration surface (`api_base`, `azure_ad_token`, etc.).\n\n---\n\n### \ud83d\udee0\ufe0f Proposed Solution & Fix\n\n#### A. Extend `TraceControls` and `LangfuseMapper`\nExtend `TraceControls` in `litellm/integrations/otel/model/trace_controls.py`:\n```python\n@dataclass(frozen=True)\nclass TraceControls:\n    name: Optional[str] = None\n    user_id: Optional[str] = None\n    session_id: Optional[str] = None\n    tags: Tuple[str, ...] = ()\n    environment: Optional[str] = None\n    release: Optional[str] = None\n    version: Optional[str] = None\n```\n\nIn `caller_trace_controls()` resolve precedence cleanly:\n```python\nLANGFUSE_HEADER_PREFIX: Final = \"x-langfuse-\"\nLANGFUSE_TRACING_ENVIRONMENT: Final = \"LANGFUSE_TRACING_ENVIRONMENT\"\n\n# Precedence: Header -> Request Metadata/Body -> Environment Variable\nenvironment = (\n    headers.get(f\"{LANGFUSE_HEADER_PREFIX}environment\")\n    or body.get(\"langfuse_environment\")\n    or os.environ.get(LANGFUSE_TRACING_ENVIRONMENT)\n)\nrelease = headers.get(f\"{LANGFUSE_HEADER_PREFIX}release\") or body.get(\"trace_release\") or body.get(\"release\")\nversion = headers.get(f\"{LANGFUSE_HEADER_PREFIX}version\") or body.get(\"trace_version\") or body.get(\"version\")\n```\n\nIn `LangfuseMapper.trace_attributes()` stamp the span attributes:\n```python\nif controls.environment:\n    attrs[\"langfuse.environment\"] = controls.environment\nif controls.release:\n    attrs[\"langfuse.release\"] = controls.release\nif controls.version:\n    attrs[\"langfuse.version\"] = controls.version\n```\n\n#### B. Safe Proxy-Wide Allowlist in `auth_utils.py`\nIn `litellm/proxy/auth/auth_utils.py`, permit selective parameter admission without disabling security guarantees:\n```python\nif _is_param_allowed(\n    param=param,\n    request_body_value=body[param],\n    configurable_clientside_auth_params=general_settings.get(\"configurable_clientside_auth_params\"),\n) is True:\n    continue\n```\nThis enables operators to define in their proxy config:\n```yaml\ngeneral_settings:\n  configurable_clientside_auth_params: [\"langfuse_environment\"]\n```\nThis safely permits environment tagging across all models without opening sensitive credential parameters.\n\nHappy to open a clean PR with unit tests and regression verification if the maintainers align with this design!", "created_at": "2026-11-12T09:52:13Z"}
{"repo": "BerriAI/litellm", "pull_number": 51380, "instance_id": "BerriAI__litellm-51380", "issue_numbers": ["51379"], "base_commit": "1677c2250e24697a904dd1750815f574af8040f4", "patch": "diff --git a/litellm/proxy/response_api_endpoints/endpoints.py b/litellm/proxy/response_api_endpoints/endpoints.py\nindex b4eec96ecd99..095a84db8aad 100644\n--- a/litellm/proxy/response_api_endpoints/endpoints.py\n+++ b/litellm/proxy/response_api_endpoints/endpoints.py\n@@ -2678,7 +2678,6 @@ async def return_body():\n             user_request_timeout=user_request_timeout,\n             user_max_tokens=user_max_tokens,\n             user_api_base=user_api_base,\n-            model=resolved_model,\n             route_type=\"_aresponses_websocket\",\n             skip_guardrails=True,\n         )\n", "test_patch": "diff --git a/tests/unit/proxy/response_api_endpoints/test_endpoints.py b/tests/unit/proxy/response_api_endpoints/test_endpoints.py\nindex 0a28bb507d2d..27f6b82b816c 100644\n--- a/tests/unit/proxy/response_api_endpoints/test_endpoints.py\n+++ b/tests/unit/proxy/response_api_endpoints/test_endpoints.py\n@@ -2463,6 +2463,112 @@ def _key() -> UserAPIKeyAuth:\n \n \n class TestResponsesWSFirstFrameModelAuth:\n+    @pytest.mark.parametrize(\"query_model\", [None, \"gpt-6.1-sol\"])\n+    @pytest.mark.parametrize(\"nested\", [False, True])\n+    def test_team_alias_keeps_websocket_turns_on_the_authorized_deployment(\n+        self, monkeypatch: pytest.MonkeyPatch, query_model: str | None, nested: bool\n+    ) -> None:\n+        from openai.types.responses import ResponseCompletedEvent\n+\n+        import litellm.proxy.proxy_server as ps\n+        from litellm.proxy.auth.user_api_key_auth import user_api_key_auth_websocket\n+        from litellm.responses.utils import ResponsesAPIRequestUtils\n+        from litellm.types.llms.openai import InputTokensDetails, OutputTokensDetails\n+\n+        model: Final = \"gpt-6.1-sol\"\n+        authorized_model: Final = \"restricted/\" + model\n+        deployment_id: Final = \"restricted-deployment\"\n+        router: Final = litellm.Router(\n+            model_list=[\n+                {\n+                    \"model_name\": \"shared/\" + model,\n+                    \"litellm_params\": {\n+                        \"model\": model,\n+                        \"custom_llm_provider\": \"openai\",\n+                        \"api_key\": \"shared-fixture-key\",\n+                        \"order\": 0,\n+                    },\n+                    \"model_info\": {\"id\": \"shared-deployment\"},\n+                },\n+                {\n+                    \"model_name\": authorized_model,\n+                    \"litellm_params\": {\n+                        \"model\": model,\n+                        \"custom_llm_provider\": \"openai\",\n+                        \"api_key\": \"restricted-fixture-key\",\n+                        \"order\": 1,\n+                    },\n+                    \"model_info\": {\"id\": deployment_id, \"access_groups\": [\"Restricted\"]},\n+                },\n+            ],\n+            num_retries=0,\n+        )\n+        auth: Final = UserAPIKeyAuth(\n+            api_key=\"hashed-fixture-key\",\n+            team_id=\"alias-team\",\n+            models=[\"all-team-models\"],\n+            team_models=[\"Restricted\"],\n+            team_model_aliases={model: authorized_model},\n+        )\n+        completed: Final = json.dumps(\n+            {\n+                \"type\": \"response.completed\",\n+                \"sequence_number\": 1,\n+                \"response\": ResponsesAPIResponse(\n+                    id=\"resp_alias\",\n+                    object=\"response\",\n+                    created_at=1,\n+                    status=\"completed\",\n+                    model=model,\n+                    output=[],\n+                    parallel_tool_calls=True,\n+                    tool_choice=\"auto\",\n+                    tools=[],\n+                    usage=ResponseAPIUsage(\n+                        input_tokens=1,\n+                        output_tokens=0,\n+                        total_tokens=1,\n+                        input_tokens_details=InputTokensDetails(cached_tokens=0),\n+                        output_tokens_details=OutputTokensDetails(reasoning_tokens=0),\n+                    ),\n+                ).model_dump(mode=\"json\"),\n+            }\n+        )\n+\n+        def provider_connect(*_args: object, **_kwargs: object) -> MagicMock:\n+            replies: Final[asyncio.Queue[str]] = asyncio.Queue()\n+\n+            async def send(_message: str) -> None:\n+                await replies.put(completed)\n+\n+            async def receive(**_kwargs: object) -> str:\n+                return await replies.get()\n+\n+            peer: Final = MagicMock()\n+            peer.send = AsyncMock(side_effect=send)\n+            peer.recv = AsyncMock(side_effect=receive)\n+            peer.close = AsyncMock()\n+            connection: Final = MagicMock()\n+            connection.__aenter__ = AsyncMock(return_value=peer)\n+            connection.__aexit__ = AsyncMock(return_value=None)\n+            return connection\n+\n+        monkeypatch.setattr(ps, \"llm_router\", router)\n+        monkeypatch.setattr(ps, \"master_key\", None)\n+        monkeypatch.setattr(ps, \"general_settings\", {})\n+        monkeypatch.setitem(app.dependency_overrides, user_api_key_auth_websocket, lambda: auth)\n+        monkeypatch.setattr(\"websockets.connect\", provider_connect)\n+        payload: Final = {\"model\": model, \"input\": \"hello\"}\n+        frame: Final = (\n+            {\"type\": \"response.create\", \"response\": payload} if nested else {\"type\": \"response.create\", **payload}\n+        )\n+        path: Final = \"/v1/responses\" + (f\"?model={query_model}\" if query_model is not None else \"\")\n+        with TestClient(app).websocket_connect(path) as websocket:\n+            websocket.send_json(frame)\n+            response: Final = ResponseCompletedEvent.model_validate_json(websocket.receive_text())\n+\n+        assert ResponsesAPIRequestUtils.get_model_id_from_response_id(response.response.id) == deployment_id\n+\n     @pytest.mark.asyncio\n     async def test_endpoint_enforces_auth_after_model_from_first_frame(self):\n         from litellm.proxy.response_api_endpoints.endpoints import (\n@@ -2643,7 +2749,6 @@ async def fake_llm_call():\n         assert routed[\"model\"] == \"gpt-4o-mini\"\n         assert routed[\"input\"] == replayed_input\n         assert routed[\"previous_response_id\"] == \"resp_prev\"\n-        assert processor.common_processing_pre_call_logic.await_args.kwargs[\"model\"] == \"gpt-4o-mini\"\n         assert processor.common_processing_pre_call_logic.await_args.kwargs[\"skip_guardrails\"] is True\n         assert callable(routed[\"responses_ws_frame_guard\"])\n         assert mock_route_request.await_args.kwargs[\"route_type\"] == \"_aresponses_websocket\"\n", "problem_statement": "[Bug]: Responses WebSocket overwrites team model aliases before routing\n## Description\n\nA Responses WebSocket request can pass model authorization through a team's model alias, then lose that alias before routing. If another deployment has the same underlying provider model, the router can select that deployment even though the team's configured model access group does not include it.\n\nThis report concerns LiteLLM v1.110.0-rc.1, upstream commit d786036a8b07ff0652d2ebba0eb9cf53d323afa4. The affected call sequence is also present in main at db8ad3b1. The package version and readiness endpoint report 1.110.0 without the release-candidate suffix.\n\n## Impact\n\nAn authenticated caller using a permitted team alias can be routed to a different deployment, which can use different provider credentials or billing. Existing logs from an instance operated by the reporter attributed the affected WebSocket turns to deployment IDs outside the intended access group. No production identities, addresses, credentials, or request content are included here.\n\nThe issue depends on a team alias and deployments sharing the same litellm_params.model. This report does not claim unauthenticated access or unrestricted access to arbitrary provider models.\n\n## Config\n\nThe following model entries illustrate the relevant configuration. Environment variables supply credentials and are intentionally not populated here.\n\n```yaml\nmodel_list:\n  - model_name: restricted/gpt-6.1-sol\n    litellm_params:\n      model: gpt-6.1-sol\n      custom_llm_provider: openai\n      api_key: os.environ/RESTRICTED_OPENAI_API_KEY\n    model_info:\n      id: restricted-deployment\n      access_groups:\n        - Restricted\n  - model_name: shared/gpt-6.1-sol\n    litellm_params:\n      model: gpt-6.1-sol\n      custom_llm_provider: openai\n      api_key: os.environ/SHARED_OPENAI_API_KEY\n    model_info:\n      id: shared-deployment\n```\n\nThe team permits only the Restricted access group and defines the model alias gpt-6.1-sol to restricted/gpt-6.1-sol. The caller uses a team key. Both the team's restriction and its alias must be present in the request's effective authentication object.\n\n## LiteLLM Version\n\nObserved in v1.110.0-rc.1 and reproduced against main at db8ad3b13e7320bf835205cae58be5a58e0ff366. The first affected release has not been established.\n\n## Steps to Repro\n\nThe caller opens a WebSocket to /v1/responses without a model query parameter and sends a response.create frame whose model is gpt-6.1-sol.\n\n```json\n{\"type\":\"response.create\",\"model\":\"gpt-6.1-sol\",\"input\":\"Reply with OK.\",\"stream\":true}\n```\n\nThe request should use restricted/gpt-6.1-sol and restricted-deployment. A shared/gpt-6.1-sol deployment should not become a candidate merely because it serves the same provider model string.\n\n## Root cause\n\nThe WebSocket endpoint extracts the model from the first frame and passes it as the model argument to common_processing_pre_call_logic.\n\nThat method first calls add_litellm_data_to_request. The setup function applies team_model_aliases and changes data[\"model\"] to restricted/gpt-6.1-sol. The common processor then calls resolve_inference_model with both the changed body model and the endpoint's original model argument.\n\nFor completion requests, resolve_inference_model prioritizes endpoint_model over body_model. This restores gpt-6.1-sol and discards the team alias.\n\nThe proxy supports routing by underlying provider model strings through deployment_names. A raw-name match invokes the router with specific_deployment=True. That resolver collects deployments whose params.model equals the requested name, so both entries above can become candidates.\n\n## Evidence collected\n\nRead-only investigation of the reporter's instance found successful Responses WebSocket turn records with the shared deployment IDs, no fallback attempts, and no retry attempts. Representative stored authentication objects contained a restricted team model list and aliases pointing the raw model names to the restricted deployments.\n\nAn isolated execution of the original rc.1 _update_model_if_team_alias_exists and resolve_inference_model functions reproduced the precedence failure for both observed model names.\n\n```text\nrequested model     after team alias             after WebSocket model precedence\ngpt-6.1-sol          codex/gpt-6.1-sol             gpt-6.1-sol\ngpt-6-luna           codex/gpt-6-luna              gpt-6-luna\n```\n\nWhen the original endpoint-model override was omitted, the same functions preserved the aliased model in both cases.\n\nThe issue was subsequently reproduced against a local proxy built from main at db8ad3b13e7320bf835205cae58be5a58e0ff366, using a real restricted virtual key and real upstream provider calls. Both a first-frame model and a query model selected qa-shared-deployment before the patch. The same requests selected qa-restricted-deployment after removing the endpoint-model override. The adjacent HTTP Responses route selected qa-restricted-deployment in both runs, and a direct request for the shared model returned HTTP 403 in both runs.\n\nThe proxy used two workers sharing an isolated local Redis and Postgres. The verification scripts checked the local proxy's spend log model_id. No production configuration was changed. The existing mapped endpoint tests and the CI inclusion test passed, with 378 tests passing, and the official make lint gates passed.\n\n## Source references\n\nThe rc.1 source links are pinned to d786036a8b07ff0652d2ebba0eb9cf53d323afa4.\n\nTeam alias application is in litellm/proxy/litellm_pre_call_utils.py, lines 3104 through 3117.\n\nhttps://github.com/BerriAI/litellm/blob/d786036a8b07ff0652d2ebba0eb9cf53d323afa4/litellm/proxy/litellm_pre_call_utils.py#L3104-L3117\n\nThe common processor resolves the model again in litellm/proxy/common_request_processing.py, lines 2698 through 2707.\n\nhttps://github.com/BerriAI/litellm/blob/d786036a8b07ff0652d2ebba0eb9cf53d323afa4/litellm/proxy/common_request_processing.py#L2698-L2707\n\nThe model precedence is defined in litellm/proxy/common_utils/http_parsing_utils.py, lines 63 through 94.\n\nhttps://github.com/BerriAI/litellm/blob/d786036a8b07ff0652d2ebba0eb9cf53d323afa4/litellm/proxy/common_utils/http_parsing_utils.py#L63-L94\n\nThe WebSocket endpoint supplies the original model in litellm/proxy/response_api_endpoints/endpoints.py, lines 2617 through 2633.\n\nhttps://github.com/BerriAI/litellm/blob/d786036a8b07ff0652d2ebba0eb9cf53d323afa4/litellm/proxy/response_api_endpoints/endpoints.py#L2617-L2633\n\nRaw-name routing is in litellm/proxy/route_llm_request.py, lines 980 through 992.\n\nhttps://github.com/BerriAI/litellm/blob/d786036a8b07ff0652d2ebba0eb9cf53d323afa4/litellm/proxy/route_llm_request.py#L980-L992\n\nSpecific-deployment candidate matching is in litellm-rust/crates/router-core/src/resolve.rs, lines 314 through 322.\n\nhttps://github.com/BerriAI/litellm/blob/d786036a8b07ff0652d2ebba0eb9cf53d323afa4/litellm-rust/crates/router-core/src/resolve.rs#L314-L322\n\n## Proposed correction\n\nPreserve the model selected by team-alias processing when entering the WebSocket routing stage. Avoid reintroducing the original model through the endpoint override after alias application. Add a regression that exercises the WebSocket endpoint and real common preprocessing with duplicate underlying provider models, and asserts the restricted deployment is selected.\n\n\n", "hints_text": "", "created_at": "2026-11-12T08:20:35Z"}
