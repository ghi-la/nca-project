{"repo": "BerriAI/litellm", "pull_number": 51835, "instance_id": "BerriAI__litellm-51835", "issue_numbers": ["41639"], "base_commit": "27c796c412eed2f7336dccb46a58247463b7c498", "patch": "diff --git a/litellm/litellm_core_utils/token_counter.py b/litellm/litellm_core_utils/token_counter.py\nindex 5fb0a619744f..c0116454ce61 100644\n--- a/litellm/litellm_core_utils/token_counter.py\n+++ b/litellm/litellm_core_utils/token_counter.py\n@@ -2095,7 +2095,7 @@ def _format_single_function_definition(function: Mapping[str, object]) -> tuple[\n     if not function_name:\n         return ()\n     function_description: Final = function.get(\"description\")\n-    parameters_value: Final = function.get(\"parameters\") or {}\n+    parameters_value: Final = function.get(\"parameters\") or function.get(\"parametersJsonSchema\") or {}\n     parameters: Final = parameters_value if isinstance(parameters_value, Mapping) else {}\n     properties: Final = parameters.get(\"properties\")\n     if isinstance(properties, Mapping) and properties:\ndiff --git a/litellm/llms/vertex_ai/common_utils.py b/litellm/llms/vertex_ai/common_utils.py\nindex 0013e6789316..7a163d9b1d02 100644\n--- a/litellm/llms/vertex_ai/common_utils.py\n+++ b/litellm/llms/vertex_ai/common_utils.py\n@@ -11,6 +11,7 @@\n \n import httpx\n from pydantic import JsonValue, TypeAdapter, ValidationError\n+from pydantic_core import to_jsonable_python\n from typing_extensions import NotRequired, ReadOnly, TypedDict\n \n import litellm\n@@ -39,7 +40,12 @@\n )\n from litellm.types.router import GenericLiteLLMParams\n from litellm.types.utils import CountContextManagement, TokenCountMessagesFormat, TokenCountResponse\n-from litellm.utils import supports_response_schema, supports_system_messages\n+from litellm.utils import (\n+    remove_additional_properties,\n+    remove_strict_from_schema,\n+    supports_response_schema,\n+    supports_system_messages,\n+)\n \n if TYPE_CHECKING:\n     from litellm.llms.anthropic.count_tokens.transformation import AnthropicCountFields\n@@ -916,6 +922,132 @@ def build_vertex_schema(\n \n _build_vertex_schema = build_vertex_schema\n \n+_VERTEX_PARAMETERS_UNSUPPORTED_ROOT_KEYWORDS: Final = (\"anyOf\", \"oneOf\", \"allOf\")\n+_ROOT_DEFS_REF_PREFIX: Final = \"#/$defs/\"\n+_JSON_SCHEMA: Final = TypeAdapter(Mapping[str, JsonValue])\n+\n+\n+def _is_absent_or_object_type(schema_type: object) -> bool:\n+    match schema_type:\n+        case None:\n+            return True\n+        case str():\n+            return schema_type.lower() == \"object\"\n+        case [str() as only_type]:\n+            return only_type.lower() == \"object\"\n+        case _:\n+            return False\n+\n+\n+def _root_cannot_be_vertex_parameters(root: Mapping[str, object]) -> bool:\n+    return any(\n+        keyword in root for keyword in _VERTEX_PARAMETERS_UNSUPPORTED_ROOT_KEYWORDS\n+    ) or not _is_absent_or_object_type(root.get(\"type\"))\n+\n+\n+def _root_ref_def_name(schema: Mapping[str, JsonValue], def_names: Mapping[str, str]) -> str | None:\n+    match schema.get(\"$ref\"):\n+        case str() as ref if ref.startswith(_ROOT_DEFS_REF_PREFIX):\n+            return def_names.get(ref.removeprefix(_ROOT_DEFS_REF_PREFIX))\n+        case _:\n+            return None\n+\n+\n+def _root_ref_chain(\n+    schema: Mapping[str, JsonValue], defs: Mapping[str, JsonValue]\n+) -> tuple[Mapping[str, JsonValue], ...] | None:\n+    object_defs: Final = MappingProxyType({name: value for name, value in defs.items() if isinstance(value, dict)})\n+    def_names: Final = MappingProxyType({name: name for name in object_defs})\n+    next_names: Final = ((name, _root_ref_def_name(value, def_names)) for name, value in object_defs.items())\n+    next_def: Final = MappingProxyType({name: target for name, target in next_names if target is not None})\n+    first: Final = _root_ref_def_name(schema, def_names)\n+    if first is None:\n+        return (schema,)\n+    names: Final = tuple(accumulate(range(len(next_def)), lambda name, _: next_def.get(name, name), initial=first))\n+    return None if names[-1] in next_def else (schema, *(object_defs[name] for name in frozenset(names)))\n+\n+\n+def needs_parameters_json_schema(parameters: Mapping[str, JsonValue]) -> bool:\n+    defs: Final = parameters.get(\"$defs\")\n+    chain: Final = _root_ref_chain(parameters, defs if isinstance(defs, dict) else {})\n+    return chain is not None and any(_root_cannot_be_vertex_parameters(schema) for schema in chain)\n+\n+\n+def _is_union(schema: Mapping[str, JsonValue]) -> bool:\n+    return \"anyOf\" in schema or \"oneOf\" in schema\n+\n+\n+def has_bare_root_union(json_schema: Mapping[str, JsonValue]) -> bool:\n+    defs: Final = json_schema.get(\"$defs\")\n+    chain: Final = _root_ref_chain(json_schema, defs if isinstance(defs, dict) else {}) or (json_schema,)\n+    return any(map(_is_union, chain)) and not any(\"properties\" in schema for schema in chain)\n+\n+\n+_FORCING_MODES: Final = frozenset({\"ANY\", \"VALIDATED\"})\n+\n+\n+def _forces(function_calling_config: JsonValue, name: JsonValue) -> bool:\n+    match function_calling_config:\n+        case {\"mode\": str() as mode, \"allowed_function_names\": [*names]} | {\n+            \"mode\": str() as mode,\n+            \"allowedFunctionNames\": [*names],\n+        } if mode.upper() in _FORCING_MODES:\n+            return name in names\n+        case {\"mode\": str() as mode} if mode.upper() in _FORCING_MODES:\n+            return True\n+        case _:\n+            return False\n+\n+\n+def _vertex_parameters(json_schema: Mapping[str, JsonValue], send_integer_enums: bool) -> Mapping[str, JsonValue]:\n+    stripped: Final = remove_strict_from_schema(remove_additional_properties(deepcopy(dict(json_schema))))\n+    return _JSON_SCHEMA.validate_python(build_vertex_schema(stripped, send_integer_enums=send_integer_enums))\n+\n+\n+def _declaration_for(declaration: JsonValue, function_calling_config: JsonValue, send_integer_enums: bool) -> JsonValue:\n+    if not isinstance(declaration, dict):\n+        return declaration\n+    json_schema: Final = declaration.get(\"parametersJsonSchema\")\n+    if not isinstance(json_schema, dict) or not has_bare_root_union(json_schema):\n+        return declaration\n+    if not _forces(function_calling_config, declaration.get(\"name\")):\n+        return declaration\n+    kept: Final = {key: value for key, value in declaration.items() if key != \"parametersJsonSchema\"}\n+    return {**kept, \"parameters\": dict(_vertex_parameters(json_schema, send_integer_enums))}\n+\n+\n+def _tool_for(tool: JsonValue, function_calling_config: JsonValue, send_integer_enums: bool) -> JsonValue:\n+    declarations: Final = tool.get(\"function_declarations\") if isinstance(tool, dict) else None\n+    if not isinstance(tool, dict) or not isinstance(declarations, list):\n+        return tool\n+    return {\n+        **tool,\n+        \"function_declarations\": [\n+            _declaration_for(item, function_calling_config, send_integer_enums) for item in declarations\n+        ],\n+    }\n+\n+\n+def with_forced_bare_root_unions_on_parameters(\n+    tools: JsonValue, tool_config: JsonValue, send_integer_enums: bool\n+) -> JsonValue:\n+    match tool_config:\n+        case {\"functionCallingConfig\": function_calling_config} | {\"function_calling_config\": function_calling_config}:\n+            return (\n+                [_tool_for(tool, function_calling_config, send_integer_enums) for tool in tools]\n+                if isinstance(tools, list)\n+                else tools\n+            )\n+        case _:\n+            return tools\n+\n+\n+def parameters_json_schema_for(parameters: Mapping[str, object]) -> Mapping[str, JsonValue] | None:\n+    if \"$ref\" not in parameters and not _root_cannot_be_vertex_parameters(parameters):\n+        return None\n+    json_schema: Final = _JSON_SCHEMA.validate_python(to_jsonable_python(parameters))\n+    return json_schema if needs_parameters_json_schema(json_schema) else None\n+\n \n def build_json_schema(parameters: dict) -> dict:\n     \"\"\"\n@@ -1656,7 +1788,7 @@ async def count_tokens(\n             if isinstance(request_view, InferenceRequestViewError):\n                 return count_context_error_response(request_view, request_model, model_to_use)\n             count_context: Final = vertex_gemini_count_context(\n-                system=request_view.system, tools=tools, model=model_to_use\n+                system=request_view.system, tools=tools, model=model_to_use, allow_parameters_json_schema=False\n             )\n             if isinstance(count_context, VertexGeminiCountContextError):\n                 return count_context_error_response(count_context, request_model, model_to_use)\ndiff --git a/litellm/llms/vertex_ai/count_tokens/context.py b/litellm/llms/vertex_ai/count_tokens/context.py\nindex c29f2ecbcf8d..b33e1d6fdb10 100644\n--- a/litellm/llms/vertex_ai/count_tokens/context.py\n+++ b/litellm/llms/vertex_ai/count_tokens/context.py\n@@ -80,6 +80,7 @@ def _is_function_tool(tool: Mapping[str, JsonValue]) -> bool:\n def _map_function_tools(\n     tools: object | None,\n     model: str,\n+    allow_parameters_json_schema: bool,\n ) -> tuple[Mapping[str, object], ...] | None | VertexGeminiCountContextError:\n     try:\n         tool_values: Final = _TOOLS.validate_python(tools or ())\n@@ -104,6 +105,7 @@ def _map_function_tools(\n                 value=[dict(tool) for tool in chat_tools],\n                 optional_params={},\n                 send_integer_enums=send_integer_enums,\n+                allow_parameters_json_schema=allow_parameters_json_schema,\n             ),\n             VertexGeminiConfig.is_gemini_3_or_newer(model),\n         )\n@@ -119,11 +121,12 @@ def vertex_gemini_count_context(\n     system: object | None,\n     tools: object | None,\n     model: str,\n+    allow_parameters_json_schema: bool = True,\n ) -> VertexGeminiCountContext | VertexGeminiCountContextError:\n     system_parts: Final = _system_parts(system)\n     if isinstance(system_parts, VertexGeminiCountContextError):\n         return system_parts\n-    function_tools: Final = _map_function_tools(tools, model)\n+    function_tools: Final = _map_function_tools(tools, model, allow_parameters_json_schema)\n     if isinstance(function_tools, VertexGeminiCountContextError):\n         return function_tools\n     return VertexGeminiCountContext(\ndiff --git a/litellm/llms/vertex_ai/files/transformation.py b/litellm/llms/vertex_ai/files/transformation.py\nindex 478291bd7db3..be7628bf064f 100644\n--- a/litellm/llms/vertex_ai/files/transformation.py\n+++ b/litellm/llms/vertex_ai/files/transformation.py\n@@ -1338,6 +1338,7 @@ def _map_openai_to_vertex_params(\n             optional_params={},\n             drop_params=drops_unsupported_params(openai_request_body.get(\"drop_params\", deployment_drop_params)),\n             allow_integer_enums=False,\n+            allow_parameters_json_schema=False,\n         )\n         return vertex_params\n \ndiff --git a/litellm/llms/vertex_ai/gemini/transformation.py b/litellm/llms/vertex_ai/gemini/transformation.py\nindex 765ccff23f55..97a36403c754 100644\n--- a/litellm/llms/vertex_ai/gemini/transformation.py\n+++ b/litellm/llms/vertex_ai/gemini/transformation.py\n@@ -12,7 +12,7 @@\n from urllib.parse import quote\n \n import httpx\n-from pydantic import BaseModel, PositiveInt, TypeAdapter, ValidationError\n+from pydantic import BaseModel, JsonValue, PositiveInt, TypeAdapter, ValidationError\n from typing_extensions import NotRequired, ReadOnly, TypedDict\n \n import litellm\n@@ -67,6 +67,8 @@\n     gemini_video_metadata_from_openai,\n     get_supports_response_schema,\n     get_supports_system_message,\n+    with_forced_bare_root_unions_on_parameters,\n+    with_integer_enums_that_fit,\n )\n from .long_decode import with_default_output_budget\n \n@@ -1068,6 +1070,35 @@ def _pop_and_merge_extra_body(data: RequestBody, optional_params: dict) -> None:\n                 data_dict[k] = v\n \n \n+class _CallerToolConfig(TypedDict, total=False):\n+    toolConfig: ReadOnly[JsonValue]\n+    tool_config: ReadOnly[JsonValue]\n+\n+\n+_CALLER_TOOL_CONFIG: Final = TypeAdapter(_CallerToolConfig)\n+\n+\n+def _tools_fit_for_caller_tool_config(tools: Tools, extra_body: object, model: str) -> Tools:\n+    extra_body_fields: Final = as_str_mapping(extra_body)\n+    if extra_body_fields is None:\n+        return tools\n+    try:\n+        caller: Final = _CALLER_TOOL_CONFIG.validate_python(extra_body_fields)\n+    except ValidationError:\n+        return tools\n+    tool_config: Final = caller.get(\"toolConfig\", caller.get(\"tool_config\"))\n+    if tool_config is None:\n+        return tools\n+    from .vertex_and_google_ai_studio_gemini import VertexGeminiConfig\n+\n+    json_tools: Final = cast(JsonValue, tools)  # cast-ok: LiteLLM built these tools as JSON request data\n+    fitted: Final = with_integer_enums_that_fit(\n+        partial(with_forced_bare_root_unions_on_parameters, json_tools, tool_config),\n+        VertexGeminiConfig.is_gemini_3_or_newer(model),\n+    )\n+    return cast(Tools, fitted)  # cast-ok: same shape back\n+\n+\n def _has_google_maps_tool(tools: object) -> bool:\n     \"\"\"Return True if any tool object in the list has a 'googleMaps' key.\"\"\"\n     if not isinstance(tools, list):\n@@ -1212,7 +1243,9 @@ def transform_request_body(\n             if system_instructions is not None:\n                 data[\"system_instruction\"] = system_instructions\n             if tools is not None:\n-                data[\"tools\"] = tools\n+                built_tools: Final = cast(Tools, tools)  # cast-ok: popped from the untyped optional_params\n+                caller_params: Final = cast(Mapping[str, object], optional_params)  # cast-ok: untyped shared signature\n+                data[\"tools\"] = _tools_fit_for_caller_tool_config(built_tools, caller_params.get(\"extra_body\"), model)\n             if tool_choice is not None:\n                 data[\"toolConfig\"] = tool_choice\n             if include_server_side_tool_invocations:\ndiff --git a/litellm/llms/vertex_ai/gemini/vertex_and_google_ai_studio_gemini.py b/litellm/llms/vertex_ai/gemini/vertex_and_google_ai_studio_gemini.py\nindex e462e6a14888..572dcd5eecfa 100644\n--- a/litellm/llms/vertex_ai/gemini/vertex_and_google_ai_studio_gemini.py\n+++ b/litellm/llms/vertex_ai/gemini/vertex_and_google_ai_studio_gemini.py\n@@ -14,7 +14,8 @@\n from typing import TYPE_CHECKING, Any, ClassVar, Final, Literal, Optional, Protocol, Union, cast, get_args\n \n import httpx\n-from pydantic import JsonValue, TypeAdapter\n+from pydantic import JsonValue, TypeAdapter, ValidationError\n+from typing_extensions import ReadOnly, TypedDict\n \n import litellm\n from litellm import verbose_logger\n@@ -106,6 +107,8 @@\n     VertexAIError,\n     build_json_schema,\n     build_vertex_schema,\n+    has_bare_root_union,\n+    parameters_json_schema_for,\n     supports_response_json_schema,\n     with_integer_enums_that_fit,\n )\n@@ -553,6 +556,48 @@ def mapped_gemini_speech_config(\n     }\n \n \n+class _CallerFunction(TypedDict, total=False):\n+    parameters: ReadOnly[Mapping[str, object]]\n+\n+\n+class _CallerTool(_CallerFunction, total=False):\n+    function: ReadOnly[_CallerFunction]\n+\n+\n+class _ToolChoiceParam(TypedDict, total=False):\n+    tool_choice: ReadOnly[object]\n+\n+\n+_CALLER_TOOL: Final = TypeAdapter(_CallerTool)\n+_CALLER_TOOLS: Final = TypeAdapter(tuple[object, ...])\n+_TOOL_CHOICE_PARAM: Final = TypeAdapter(_ToolChoiceParam)\n+\n+\n+def _caller_parameters(tool: object) -> Mapping[str, object] | None:\n+    try:\n+        caller_tool: Final = _CALLER_TOOL.validate_python(tool)\n+    except ValidationError:\n+        return None\n+    return caller_tool.get(\"function\", caller_tool).get(\"parameters\")\n+\n+\n+def _parameters_json_schema(tool: object, forced_function_names: frozenset[str]) -> Mapping[str, JsonValue] | None:\n+    parameters: Final = _caller_parameters(tool)\n+    json_schema: Final = None if parameters is None else parameters_json_schema_for(parameters)\n+    if json_schema is None or declared_function_name(tool) not in forced_function_names:\n+        return json_schema\n+    return None if has_bare_root_union(json_schema) else json_schema\n+\n+\n+def _parameters_json_schemas(\n+    tools: object, allow_parameters_json_schema: bool, forced_function_names: frozenset[str]\n+) -> tuple[Mapping[str, JsonValue] | None, ...]:\n+    return tuple(\n+        _parameters_json_schema(tool, forced_function_names) if allow_parameters_json_schema else None\n+        for tool in _CALLER_TOOLS.validate_python(tools)\n+    )\n+\n+\n def _as_chat_tool(member: JsonValue) -> JsonValue:\n     if not isinstance(member, dict) or \"function\" in member or \"name\" not in member:\n         return member\n@@ -685,6 +730,16 @@ def _forced_function_names(name: str, tools: JsonValue) -> tuple[str, ...]:\n     return tuple(qualified) or (name,)\n \n \n+def _function_names_forced_by(tool_choice: object, tools: JsonValue) -> frozenset[str]:\n+    match tool_choice:\n+        case \"required\":\n+            return frozenset(chain.from_iterable(_names_each_tool_declares(_listed(tools))))\n+        case {\"function\": {\"name\": str() as name}}:\n+            return frozenset(_forced_function_names(name, tools))\n+        case _:\n+            return frozenset()\n+\n+\n class VertexAIBaseConfig:\n     def get_mapped_special_auth_params(self) -> dict:\n         \"\"\"\n@@ -1226,7 +1281,9 @@ def _map_function(\n         value: list[dict],\n         optional_params: dict,\n         send_integer_enums: bool = False,\n+        allow_parameters_json_schema: bool = True,\n         outside_declarations: JsonValue = None,\n+        tool_choice: object = None,\n     ) -> list[Tools]:\n         \"\"\"\n         Map OpenAI-style tools/functions to Vertex AI format.\n@@ -1235,6 +1292,8 @@ def _map_function(\n             value: List of tool definitions\n             optional_params: Request-scoped parameters to store retrieval config\n             send_integer_enums: Whether to send integer enums with string values\n+            allow_parameters_json_schema: Whether a tool whose parameters root Vertex cannot take as `parameters`\n+                goes as `parametersJsonSchema`\n \n         Returns:\n             List of mapped tools in Vertex AI format\n@@ -1254,18 +1313,25 @@ def _map_function(\n         computerUse: dict | None = None\n         # remove 'additionalProperties' from tools\n         schema_value: Final[JsonValue] = deepcopy(cast(JsonValue, value))  # cast-ok: tools are JSON request data\n+        parameters_json_schemas: Final = _parameters_json_schemas(\n+            _with_namespace_members_inlined(schema_value, outside_declarations),\n+            allow_parameters_json_schema,\n+            _function_names_forced_by(tool_choice, [*_listed(schema_value), *_listed(outside_declarations)]),\n+        )\n         remove_additional_properties(schema_value)\n         # remove 'strict' from tools\n         remove_strict_from_schema(schema_value)\n \n         inlined_tools: Final = _with_namespace_members_inlined(schema_value, outside_declarations)\n-        for tool in cast(list[dict], inlined_tools):  # cast-ok: a deep copy keeps the caller's tool shape\n+        for index, parameters_json_schema in enumerate(parameters_json_schemas):\n+            tool = cast(list[dict], inlined_tools)[index]  # cast-ok: a deep copy keeps the caller's tool shape\n             openai_function_object: ChatCompletionToolParamFunctionChunk | None = None\n             if \"function\" in tool:  # tools list\n                 _openai_function_object = ChatCompletionToolParamFunctionChunk(**tool[\"function\"])\n \n                 if (\n-                    \"parameters\" in _openai_function_object\n+                    parameters_json_schema is None\n+                    and \"parameters\" in _openai_function_object\n                     and _openai_function_object[\"parameters\"] is not None\n                     and isinstance(_openai_function_object[\"parameters\"], dict)\n                 ):  # OPENAI accepts JSON Schema, Google accepts OpenAPI schema.\n@@ -1328,8 +1394,12 @@ def _map_function(\n                     # Empty config - Gemini will use defaults\n                     computerUse = {}\n             elif openai_function_object is not None:\n-                gtool_func_declaration = FunctionDeclaration(\n-                    name=openai_function_object[\"name\"],\n+                gtool_func_declaration = (\n+                    FunctionDeclaration(name=openai_function_object[\"name\"])\n+                    if parameters_json_schema is None\n+                    else FunctionDeclaration(\n+                        name=openai_function_object[\"name\"], parametersJsonSchema=parameters_json_schema\n+                    )\n                 )\n                 _description = openai_function_object.get(\"description\", None)\n                 _parameters = openai_function_object.get(\"parameters\", None)\n@@ -1339,7 +1409,7 @@ def _map_function(\n                     }\n                 if _description is not None:\n                     gtool_func_declaration[\"description\"] = _description\n-                if _parameters is not None:\n+                if _parameters is not None and parameters_json_schema is None:\n                     gtool_func_declaration[\"parameters\"] = _parameters\n                 gtool_func_declarations.append(gtool_func_declaration)\n             else:\n@@ -1415,8 +1485,9 @@ def map_function(\n         value: list[dict[str, object]],  # mutable-ok: mirrors override contract\n         optional_params: dict[str, object],  # mutable-ok: mirrors override contract\n         send_integer_enums: bool = False,\n+        allow_parameters_json_schema: bool = True,\n     ) -> list[Tools]:  # mutable-ok: mirrors override contract\n-        return self._map_function(value, optional_params, send_integer_enums)\n+        return self._map_function(value, optional_params, send_integer_enums, allow_parameters_json_schema)\n \n     def _map_response_schema(self, value: dict, send_integer_enums: bool = False) -> Mapping[str, object]:\n         old_schema = deepcopy(value)\n@@ -1836,6 +1907,7 @@ def map_openai_params(\n         model: str,\n         drop_params: bool,\n         allow_integer_enums: bool = True,\n+        allow_parameters_json_schema: bool = True,\n     ) -> dict:\n         request_params: Final = tool_params_without_hosted_mcp(\n             non_default_params, model=model, route=self._route, drop_params=drop_params\n@@ -1898,7 +1970,9 @@ def map_openai_params(\n                         self._map_function,\n                         value,\n                         optional_params,\n+                        allow_parameters_json_schema=allow_parameters_json_schema,\n                         outside_declarations=request_params.get(\"functions\" if param == \"tools\" else \"tools\"),\n+                        tool_choice=_TOOL_CHOICE_PARAM.validate_python(request_params).get(\"tool_choice\"),\n                     ),\n                     allow_integer_enums and self._is_gemini_3_or_newer(model),\n                 )\ndiff --git a/litellm/types/llms/vertex_ai.py b/litellm/types/llms/vertex_ai.py\nindex 968fb11e44a7..2fbf9996f4d9 100644\n--- a/litellm/types/llms/vertex_ai.py\n+++ b/litellm/types/llms/vertex_ai.py\n@@ -2,6 +2,7 @@\n from enum import Enum\n from typing import Final, Literal, Protocol\n \n+from pydantic import JsonValue\n from typing_extensions import (\n     NotRequired,\n     ReadOnly,\n@@ -164,6 +165,7 @@ class FunctionDeclaration(TypedDict, total=False):\n     name: Required[str]\n     description: str\n     parameters: Schema | dict\n+    parametersJsonSchema: ReadOnly[Mapping[str, JsonValue]]\n     response: Schema\n \n \n", "test_patch": "diff --git a/tests/unit/litellm_core_utils/test_token_counter.py b/tests/unit/litellm_core_utils/test_token_counter.py\nindex d80661ea8fd4..4696203c914a 100644\n--- a/tests/unit/litellm_core_utils/test_token_counter.py\n+++ b/tests/unit/litellm_core_utils/test_token_counter.py\n@@ -704,6 +704,20 @@ def test_token_counter_counts_function_tools_like_chat_completions_tools_for_cha\n     ) == token_counter_new(model=model, messages=list(_USER_MESSAGES), tools=[_openai_tool(function)])\n \n \n+def test_token_counter_counts_a_gemini_parameters_json_schema_like_parameters():\n+    json_schema_function: Final = {\n+        \"name\": _WEATHER_FUNCTION[\"name\"],\n+        \"description\": _WEATHER_FUNCTION[\"description\"],\n+        \"parametersJsonSchema\": _WEATHER_FUNCTION[\"parameters\"],\n+    }\n+\n+    assert token_counter_new(\n+        model=\"gemini-2.5-pro\", messages=list(_USER_MESSAGES), tools=[_gemini_tool(json_schema_function)]\n+    ) == token_counter_new(\n+        model=\"gemini-2.5-pro\", messages=list(_USER_MESSAGES), tools=[_gemini_tool(_WEATHER_FUNCTION)]\n+    )\n+\n+\n # Azure AI Foundry DeepSeek-V4-Flash-0731 billed 295 prompt tokens for the weather tool with each of\n # these tool_choice values on 2026-10-17, the same as without one. On 2026-10-29 aiand's\n # deepseek-v4.1-flash billed 296 for each, and Fireworks' deepseek-v4p1-flash and OpenRouter's\ndiff --git a/tests/unit/llms/gemini/test_gemini_common_utils.py b/tests/unit/llms/gemini/test_gemini_common_utils.py\nindex 508bd264f194..51b2c36038d0 100644\n--- a/tests/unit/llms/gemini/test_gemini_common_utils.py\n+++ b/tests/unit/llms/gemini/test_gemini_common_utils.py\n@@ -82,6 +82,37 @@ async def test_google_ai_studio_count_tokens_forwards_system_and_tools() -> None\n     }\n \n \n+@pytest.mark.asyncio\n+async def test_google_ai_studio_count_tokens_sends_a_union_root_tool_as_parameters_json_schema() -> None:\n+    union_root: Final = {\n+        \"type\": \"object\",\n+        \"properties\": {\"a\": {\"type\": \"string\"}, \"b\": {\"type\": \"string\"}},\n+        \"anyOf\": [{\"required\": [\"a\"]}, {\"required\": [\"b\"]}],\n+    }\n+    peer: Final = _GeminiCountTokensPeer()\n+    client: Final = AsyncHTTPHandler(transport=httpx.MockTransport(peer))\n+\n+    with patch.object(gemini_count_tokens_handler, \"get_async_httpx_client\", return_value=client):\n+        result: Final = await GoogleAIStudioTokenCounter().count_tokens(\n+            model_to_use=\"gemini-2.5-flash\",\n+            messages=None,\n+            contents=[{\"role\": \"user\", \"parts\": [{\"text\": \"Look up Atlas.\"}]}],\n+            deployment={\"litellm_params\": {\"api_key\": \"test-key\", \"api_base\": \"https://count-tokens.test\"}},\n+            request_model=\"gemini/gemini-2.5-flash\",\n+            tools=[{\"name\": \"lookup\", \"input_schema\": union_root}],\n+        )\n+\n+    assert result is not None\n+    assert result.total_tokens == 11\n+    assert peer.request_body == {\n+        \"generateContentRequest\": {\n+            \"model\": \"models/gemini-2.5-flash\",\n+            \"contents\": [{\"role\": \"user\", \"parts\": [{\"text\": \"Look up Atlas.\"}]}],\n+            \"tools\": [{\"functionDeclarations\": [{\"name\": \"lookup\", \"parametersJsonSchema\": union_root}]}],\n+        }\n+    }\n+\n+\n @pytest.mark.asyncio\n async def test_google_ai_studio_count_tokens_rejects_image_system_without_request() -> None:\n     peer: Final = _GeminiCountTokensPeer()\ndiff --git a/tests/unit/llms/vertex_ai/files/test_vertex_ai_files_transformation.py b/tests/unit/llms/vertex_ai/files/test_vertex_ai_files_transformation.py\nindex bc8da76656cd..1c559ccbaa49 100644\n--- a/tests/unit/llms/vertex_ai/files/test_vertex_ai_files_transformation.py\n+++ b/tests/unit/llms/vertex_ai/files/test_vertex_ai_files_transformation.py\n@@ -1698,6 +1698,52 @@ def test_tool_rows_drop_integer_enums_and_keep_string_enums(self, model: str):\n         assert properties[\"mode\"][\"enum\"] == [\"fast\", \"slow\"]\n \n \n+_FLAT_TOOL_SCHEMA: Final = {\"type\": \"object\", \"properties\": {\"city\": {\"type\": \"string\"}}, \"required\": [\"city\"]}\n+\n+\n+def _chat_entry_with_tool(custom_id: str, name: str, parameters: Mapping[str, object]) -> dict[str, object]:\n+    return {\n+        \"custom_id\": custom_id,\n+        \"method\": \"POST\",\n+        \"url\": \"/v1/chat/completions\",\n+        \"body\": {\n+            \"model\": \"gemini-2.5-flash\",\n+            \"messages\": [{\"role\": \"user\", \"content\": \"Look it up\"}],\n+            \"tools\": [{\"type\": \"function\", \"function\": {\"name\": name, \"parameters\": parameters}}],\n+        },\n+    }\n+\n+\n+class TestVertexBatchToolParameters:\n+    @pytest.mark.parametrize(\n+        \"root_schema\",\n+        [\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\"a\": {\"type\": \"string\"}, \"b\": {\"type\": \"string\"}},\n+                \"anyOf\": [{\"required\": [\"a\"]}, {\"required\": [\"b\"]}],\n+            },\n+            {\"type\": [\"object\", \"null\"], \"properties\": {\"a\": {\"type\": \"string\"}}},\n+        ],\n+        ids=[\"anyof-root\", \"type-list-root\"],\n+    )\n+    def test_rows_never_send_parameters_json_schema_since_vertex_batch_merges_keys_across_rows(\n+        self, root_schema: Mapping[str, object]\n+    ):\n+        rows: Final = _wrap_entries(\n+            [\n+                _chat_entry_with_tool(\"root-1\", \"lookup\", root_schema),\n+                _chat_entry_with_tool(\"flat-1\", \"get_weather\", _FLAT_TOOL_SCHEMA),\n+            ]\n+        )\n+\n+        declarations: Final = [row[\"request\"][\"tools\"][0][\"function_declarations\"][0] for row in rows]\n+        assert [\n+            (declaration[\"name\"], \"parameters\" in declaration, \"parametersJsonSchema\" in declaration)\n+            for declaration in declarations\n+        ] == [(\"lookup\", True, False), (\"get_weather\", True, False)]\n+\n+\n class TestVertexEmbeddingsBatchOutputTranslation:\n     \"\"\"Vertex Gemini Embedding batch output rows must come back as OpenAI batch rows.\"\"\"\n \ndiff --git a/tests/unit/llms/vertex_ai/gemini/test_transformation.py b/tests/unit/llms/vertex_ai/gemini/test_transformation.py\nindex ac2d43f64a15..946f7c1cc6c1 100644\n--- a/tests/unit/llms/vertex_ai/gemini/test_transformation.py\n+++ b/tests/unit/llms/vertex_ai/gemini/test_transformation.py\n@@ -485,3 +485,69 @@ def test_image_only_user_content_logs_the_blank_text_fixup_at_debug(caplog: pyte\n     fixups: Final = tuple(r for r in caplog.records if \"No text in user content\" in r.getMessage())\n     assert tuple(r.levelno for r in fixups) == (logging.DEBUG,)\n     assert contents[0][\"parts\"][-1] == {\"text\": \" \"}\n+\n+\n+_LOOKUP_TOOL: Final = {\n+    \"type\": \"function\",\n+    \"function\": {\n+        \"name\": \"lookup\",\n+        \"parameters\": {\n+            \"anyOf\": [\n+                {\"type\": \"object\", \"properties\": {\"a\": {\"type\": \"integer\", \"enum\": [1, 2]}}, \"required\": [\"a\"]},\n+                {\"type\": \"object\", \"properties\": {\"b\": {\"type\": \"string\"}}, \"required\": [\"b\"]},\n+            ]\n+        },\n+    },\n+}\n+_WEATHER_TOOL: Final = {\n+    \"type\": \"function\",\n+    \"function\": {\n+        \"name\": \"weather\",\n+        \"parameters\": {\"type\": \"object\", \"properties\": {\"city\": {\"type\": \"string\"}}, \"required\": [\"city\"]},\n+    },\n+}\n+\n+\n+def _declarations(model: str, tool_choice: str, extra_body: dict[str, object] | None) -> list[dict[str, object]]:\n+    optional_params: Final = VertexGeminiConfig().map_openai_params(\n+        non_default_params={\"tools\": [_LOOKUP_TOOL, _WEATHER_TOOL], \"tool_choice\": tool_choice},\n+        optional_params={},\n+        model=model,\n+        drop_params=False,\n+    )\n+    body: Final = transformation.transform_request_body(\n+        messages=[{\"role\": \"user\", \"content\": \"Find the record named Atlas\"}],\n+        model=model,\n+        optional_params={**optional_params, **({} if extra_body is None else {\"extra_body\": extra_body})},\n+        custom_llm_provider=\"gemini\",\n+        litellm_params={},\n+        cached_content=None,\n+    )\n+    return body[\"tools\"][0][\"function_declarations\"]\n+\n+\n+@pytest.mark.parametrize(\n+    (\"extra_body\", \"forced\"),\n+    [\n+        ({\"toolConfig\": {\"functionCallingConfig\": {\"mode\": \"ANY\"}}}, True),\n+        ({\"tool_config\": {\"function_calling_config\": {\"mode\": \"VALIDATED\"}}}, True),\n+        ({\"toolConfig\": {\"functionCallingConfig\": {\"mode\": \"any\"}}}, True),\n+        ({\"toolConfig\": {\"functionCallingConfig\": {\"mode\": \"ANY\", \"allowedFunctionNames\": [\"lookup\"]}}}, True),\n+        ({\"toolConfig\": {\"functionCallingConfig\": {\"mode\": \"ANY\", \"allowed_function_names\": [\"weather\"]}}}, False),\n+        ({\"toolConfig\": {\"functionCallingConfig\": {\"mode\": \"AUTO\"}}}, False),\n+        ({\"toolConfig\": {\"retrievalConfig\": {\"languageCode\": \"en\"}}}, False),\n+        (None, False),\n+    ],\n+    ids=[\"any\", \"validated-snake-case\", \"lowercase-any\", \"any-named-union-tool\", \"any-named-other-tool\", \"auto\", \"no-mode\", \"none\"],\n+)\n+@pytest.mark.parametrize(\"model\", [\"gemini-2.5-flash\", \"gemini-4-argon\"])\n+def test_a_tool_call_forced_through_extra_body_keeps_a_bare_root_union_tool_as_tool_choice_does(\n+    model: str, extra_body: dict[str, object] | None, forced: bool\n+) -> None:\n+    lookup, weather = _declarations(model, \"auto\", extra_body)\n+    forced_lookup, forced_weather = _declarations(model, \"required\", None)\n+    free_lookup, _ = _declarations(model, \"auto\", None)\n+\n+    assert \"parameters\" in forced_lookup and \"parametersJsonSchema\" in free_lookup\n+    assert lookup == (forced_lookup if forced else free_lookup)\n+    assert weather == forced_weather\ndiff --git a/tests/unit/llms/vertex_ai/gemini/test_vertex_and_google_ai_studio_gemini.py b/tests/unit/llms/vertex_ai/gemini/test_vertex_and_google_ai_studio_gemini.py\nindex dbd71270978d..31dbb9a4e9e9 100644\n--- a/tests/unit/llms/vertex_ai/gemini/test_vertex_and_google_ai_studio_gemini.py\n+++ b/tests/unit/llms/vertex_ai/gemini/test_vertex_and_google_ai_studio_gemini.py\n@@ -2897,6 +2897,199 @@ def test_gemini_reasoning_effort_and_function_tool_share_request() -> None:\n     ]\n \n \n+_LOOKUP_PROPERTIES: Final = {\"a\": {\"type\": \"string\"}, \"b\": {\"type\": \"string\"}}\n+_LOOKUP_BY_A: Final = {\"type\": \"object\", \"properties\": {\"a\": {\"type\": \"string\"}}, \"required\": [\"a\"]}\n+_LOOKUP_BY_B: Final = {\"type\": \"object\", \"properties\": {\"b\": {\"type\": \"string\"}}, \"required\": [\"b\"]}\n+_WEATHER_PARAMETERS: Final = {\n+    \"type\": \"object\",\n+    \"properties\": {\"city\": {\"type\": \"string\"}},\n+    \"required\": [\"city\"],\n+    \"additionalProperties\": False,\n+}\n+_WEATHER_VERTEX_PARAMETERS: Final = {\"type\": \"object\", \"properties\": {\"city\": {\"type\": \"string\"}}, \"required\": [\"city\"]}\n+\n+\n+@pytest.mark.parametrize(\n+    \"parameters\",\n+    [\n+        {\n+            \"type\": \"object\",\n+            \"properties\": _LOOKUP_PROPERTIES,\n+            \"anyOf\": [{\"required\": [\"a\"]}, {\"required\": [\"b\"]}],\n+            \"additionalProperties\": False,\n+        },\n+        {\n+            \"type\": [\"object\", \"null\"],\n+            \"properties\": _LOOKUP_PROPERTIES,\n+            \"anyOf\": [{\"required\": [\"a\"]}, {\"required\": [\"b\"]}],\n+        },\n+        {\"anyOf\": [{**_LOOKUP_BY_A, \"additionalProperties\": False}, _LOOKUP_BY_B]},\n+        {\n+            \"type\": \"object\",\n+            \"properties\": {\"limit\": {\"type\": \"integer\"}},\n+            \"anyOf\": [\n+                {\"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]},\n+                {\"properties\": {\"url\": {\"type\": \"string\"}}, \"required\": [\"url\"]},\n+            ],\n+        },\n+        {\"$ref\": \"#/$defs/Lookup\", \"$defs\": {\"Lookup\": {\"oneOf\": [_LOOKUP_BY_A, _LOOKUP_BY_B]}}},\n+        {\n+            \"$ref\": \"#/$defs/Lookup\",\n+            \"$defs\": {\"Lookup\": {\"$ref\": \"#/$defs/Union\"}, \"Union\": {\"anyOf\": [_LOOKUP_BY_A, _LOOKUP_BY_B]}},\n+        },\n+        {\"allOf\": [{\"type\": \"object\", \"properties\": _LOOKUP_PROPERTIES}, {\"required\": [\"b\"]}]},\n+    ],\n+    ids=[\n+        \"object-with-required-branches\",\n+        \"nullable-object-with-required-branches\",\n+        \"root-object-branches\",\n+        \"object-with-property-branches\",\n+        \"root-ref-to-union\",\n+        \"chained-root-ref-to-union\",\n+        \"root-all-of\",\n+    ],\n+)\n+@pytest.mark.respx(assert_all_called=True)\n+def test_gemini_sends_a_union_root_tool_schema_unchanged_as_parameters_json_schema(\n+    respx_mock: respx.MockRouter, parameters: Mapping[str, object]\n+) -> None:\n+    route: Final = respx_mock.post(\n+        url__regex=r\"https://generativelanguage\\.googleapis\\.com/v1beta/models/gemini-2\\.5-flash:generateContent.*\"\n+    ).mock(\n+        return_value=httpx.Response(\n+            200,\n+            json={\n+                \"candidates\": [{\"content\": {\"parts\": [{\"text\": \"Ready\"}]}, \"finishReason\": \"STOP\"}],\n+                \"usageMetadata\": {\"promptTokenCount\": 1, \"candidatesTokenCount\": 1, \"totalTokenCount\": 2},\n+            },\n+        )\n+    )\n+    completion(\n+        model=\"gemini/gemini-2.5-flash\",\n+        messages=[{\"role\": \"user\", \"content\": \"Look up the record named Atlas\"}],\n+        tools=[\n+            {\"type\": \"function\", \"function\": {\"name\": \"lookup\", \"parameters\": deepcopy(parameters)}},\n+            {\"type\": \"function\", \"function\": {\"name\": \"weather\", \"parameters\": deepcopy(_WEATHER_PARAMETERS)}},\n+        ],\n+        api_key=\"test-api-key\",\n+        client=HTTPHandler(),\n+    )\n+    request_body: Final = json.loads(route.calls.last.request.content)\n+\n+    assert request_body[\"tools\"] == [\n+        {\n+            \"function_declarations\": [\n+                {\"name\": \"lookup\", \"parametersJsonSchema\": parameters},\n+                {\"name\": \"weather\", \"parameters\": _WEATHER_VERTEX_PARAMETERS},\n+            ]\n+        }\n+    ]\n+\n+\n+def test_vertex_sends_a_union_root_tool_schema_built_with_tuples_as_parameters_json_schema() -> None:\n+    request_params: Final = VertexGeminiConfig().map_openai_params(\n+        non_default_params={\n+            \"tools\": [\n+                {\n+                    \"type\": \"function\",\n+                    \"function\": {\n+                        \"name\": \"lookup\",\n+                        \"parameters\": {\"anyOf\": ({**_LOOKUP_BY_A, \"required\": (\"a\",)}, _LOOKUP_BY_B)},\n+                    },\n+                }\n+            ]\n+        },\n+        optional_params={},\n+        model=\"gemini-2.5-flash\",\n+        drop_params=False,\n+    )\n+\n+    assert request_params[\"tools\"] == [\n+        {\"function_declarations\": [{\"name\": \"lookup\", \"parametersJsonSchema\": {\"anyOf\": [_LOOKUP_BY_A, _LOOKUP_BY_B]}}]}\n+    ]\n+\n+\n+def test_vertex_sends_a_union_root_legacy_function_schema_unchanged_as_parameters_json_schema() -> None:\n+    parameters: Final = {\"anyOf\": [{**_LOOKUP_BY_A, \"additionalProperties\": False}, _LOOKUP_BY_B]}\n+    request_params: Final = VertexGeminiConfig().map_openai_params(\n+        non_default_params={\n+            \"functions\": [\n+                {\"name\": \"lookup\", \"description\": \"Look up a record\", \"parameters\": deepcopy(parameters)},\n+                {\"name\": \"weather\", \"parameters\": deepcopy(_WEATHER_PARAMETERS)},\n+            ]\n+        },\n+        optional_params={},\n+        model=\"gemini-2.5-flash\",\n+        drop_params=False,\n+    )\n+\n+    assert request_params[\"tools\"] == [\n+        {\n+            \"function_declarations\": [\n+                {\"name\": \"lookup\", \"description\": \"Look up a record\", \"parametersJsonSchema\": parameters},\n+                {\"name\": \"weather\", \"parameters\": _WEATHER_VERTEX_PARAMETERS},\n+            ]\n+        }\n+    ]\n+\n+\n+_ROOT_ONE_OF: Final = {\"oneOf\": [_LOOKUP_BY_A, _LOOKUP_BY_B]}\n+\n+\n+@pytest.mark.parametrize(\n+    (\"lookup_parameters\", \"tool_choice\", \"expected_field\"),\n+    [\n+        (_ROOT_ONE_OF, \"required\", \"parameters\"),\n+        (_ROOT_ONE_OF, {\"type\": \"function\", \"function\": {\"name\": \"lookup\"}}, \"parameters\"),\n+        (\n+            {\"$ref\": \"#/$defs/Lookup\", \"$defs\": {\"Lookup\": {\"anyOf\": [_LOOKUP_BY_A, _LOOKUP_BY_B]}}},\n+            \"required\",\n+            \"parameters\",\n+        ),\n+        (\n+            {\"type\": \"object\", \"properties\": _LOOKUP_PROPERTIES, \"anyOf\": [{\"required\": [\"a\"]}, {\"required\": [\"b\"]}]},\n+            \"required\",\n+            \"parametersJsonSchema\",\n+        ),\n+        (_ROOT_ONE_OF, {\"type\": \"function\", \"function\": {\"name\": \"weather\"}}, \"parametersJsonSchema\"),\n+        (_ROOT_ONE_OF, \"auto\", \"parametersJsonSchema\"),\n+        (\n+            {\"allOf\": [{\"type\": \"object\", \"properties\": _LOOKUP_PROPERTIES}, {\"required\": [\"b\"]}]},\n+            \"required\",\n+            \"parametersJsonSchema\",\n+        ),\n+    ],\n+    ids=[\n+        \"required\",\n+        \"named-union-tool\",\n+        \"required-root-ref-to-union\",\n+        \"required-root-properties-beside-union\",\n+        \"named-other-tool\",\n+        \"auto\",\n+        \"required-root-all-of\",\n+    ],\n+)\n+def test_vertex_keeps_a_union_root_tool_on_parameters_when_the_call_can_be_forced_to_it(\n+    lookup_parameters: Mapping[str, object], tool_choice: str | dict[str, object], expected_field: str\n+) -> None:\n+    request_params: Final = VertexGeminiConfig().map_openai_params(\n+        non_default_params={\n+            \"tool_choice\": tool_choice,\n+            \"tools\": [\n+                {\"type\": \"function\", \"function\": {\"name\": \"lookup\", \"parameters\": deepcopy(lookup_parameters)}},\n+                {\"type\": \"function\", \"function\": {\"name\": \"weather\", \"parameters\": deepcopy(_WEATHER_PARAMETERS)}},\n+            ],\n+        },\n+        optional_params={},\n+        model=\"gemini-2.5-flash\",\n+        drop_params=False,\n+    )\n+    lookup, weather = request_params[\"tools\"][0][\"function_declarations\"]\n+\n+    assert {field for field in (\"parameters\", \"parametersJsonSchema\") if field in lookup} == {expected_field}\n+    assert weather == {\"name\": \"weather\", \"parameters\": _WEATHER_VERTEX_PARAMETERS}\n+\n+\n @pytest.mark.parametrize(\n     (\"model\", \"expected_level\"),\n     [\ndiff --git a/tests/unit/llms/vertex_ai/test_vertex_ai_common_utils.py b/tests/unit/llms/vertex_ai/test_vertex_ai_common_utils.py\nindex eb300d823aaf..997bf6cf566a 100644\n--- a/tests/unit/llms/vertex_ai/test_vertex_ai_common_utils.py\n+++ b/tests/unit/llms/vertex_ai/test_vertex_ai_common_utils.py\n@@ -1,7 +1,7 @@\n import copy\n import threading\n import time\n-from collections.abc import Iterator, Mapping\n+from collections.abc import Callable, Iterator, Mapping\n from contextlib import contextmanager\n from enum import Enum\n from typing import Final\n@@ -26,6 +26,7 @@\n     get_vertex_location_from_url,\n     get_vertex_project_id_from_url,\n     get_vertex_url,\n+    needs_parameters_json_schema,\n     pop_vertex_request_labels,\n     set_schema_property_ordering,\n     supports_response_json_schema,\n@@ -298,6 +299,37 @@ async def test_vertex_gemini_count_applies_the_context_edits_inference_applies()\n     assert peer.requests[0].content.decode().count(_TOOL_OUTPUT) == 1\n \n \n+@pytest.mark.asyncio\n+async def test_vertex_gemini_count_sends_a_union_root_tool_as_parameters_since_vertex_counts_only_that_field() -> None:\n+    with _vertex_count_tokens_peer(200) as peer:\n+        result: Final = await VertexAITokenCounter().count_tokens(\n+            model_to_use=\"gemini-2.5-flash\",\n+            messages=[{\"role\": \"user\", \"content\": \"Look up Atlas.\"}],\n+            contents=None,\n+            deployment=_VERTEX_DEPLOYMENT,\n+            request_model=\"vertex_ai/gemini-2.5-flash\",\n+            tools=[\n+                {\n+                    \"name\": \"lookup\",\n+                    \"input_schema\": {\n+                        \"type\": \"object\",\n+                        \"properties\": {\"a\": {\"type\": \"string\"}, \"b\": {\"type\": \"string\"}},\n+                        \"anyOf\": [{\"required\": [\"a\"]}, {\"required\": [\"b\"]}],\n+                    },\n+                }\n+            ],\n+            messages_format=\"anthropic\",\n+        )\n+\n+    assert result is not None\n+    assert result.total_tokens == 37\n+    sent_tools: Final = _JSON_BODY.validate_json(peer.requests[0].content)[\"tools\"]\n+    assert isinstance(sent_tools, list) and isinstance(sent_tools[0], dict)\n+    declarations: Final = sent_tools[0][\"functionDeclarations\"]\n+    assert isinstance(declarations, list) and isinstance(declarations[0], dict)\n+    assert (\"parameters\" in declarations[0], \"parametersJsonSchema\" in declarations[0]) == (True, False)\n+\n+\n @pytest.mark.parametrize(\"location\", [\"us\", \"eu\", \"us-central1\", \"europe-west1\", \"global\"])\n def test_validate_vertex_location_accepts_valid(location):\n     assert validate_vertex_location(location) == location\n@@ -1628,6 +1660,109 @@ def test_map_function_keeps_integer_enum_when_tools_are_reused():\n     assert sent[0] == sent[1]\n \n \n+_OBJECT_BRANCH: Final = {\"type\": \"object\", \"properties\": {\"a\": {\"type\": \"string\"}}, \"required\": [\"a\"]}\n+_DEEP_ROOT_REF_CHAIN_LENGTH: Final = 3000\n+\n+\n+def _deep_root_ref_chain(end: Mapping[str, JsonValue]) -> Mapping[str, JsonValue]:\n+    links: Final = {f\"d{i}\": {\"$ref\": f\"#/$defs/d{i + 1}\"} for i in range(_DEEP_ROOT_REF_CHAIN_LENGTH)}\n+    return {\"$ref\": \"#/$defs/d0\", \"$defs\": {**links, f\"d{_DEEP_ROOT_REF_CHAIN_LENGTH}\": end}}\n+\n+\n+@pytest.mark.parametrize(\n+    (\"parameters\", \"expected\"),\n+    [\n+        ({\"type\": \"object\", \"properties\": {\"a\": {\"type\": \"string\"}}}, False),\n+        ({\"type\": \"OBJECT\", \"properties\": {\"a\": {\"type\": \"string\"}}}, False),\n+        ({\"properties\": {\"a\": {\"type\": \"string\"}}}, False),\n+        ({\"type\": \"object\", \"properties\": {\"a\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}]}}}, False),\n+        ({\"$ref\": \"#/$defs/Lookup\", \"$defs\": {\"Lookup\": _OBJECT_BRANCH}}, False),\n+        ({\"$ref\": \"#/$defs/Missing\", \"$defs\": {\"Lookup\": {\"anyOf\": [_OBJECT_BRANCH]}}}, False),\n+        ({\"$ref\": \"#/definitions/Lookup\", \"definitions\": {\"Lookup\": {\"anyOf\": [_OBJECT_BRANCH]}}}, False),\n+        ({\"type\": \"object\", \"anyOf\": [{\"required\": [\"a\"]}]}, True),\n+        ({\"anyOf\": [_OBJECT_BRANCH]}, True),\n+        ({\"oneOf\": [_OBJECT_BRANCH]}, True),\n+        ({\"allOf\": [_OBJECT_BRANCH]}, True),\n+        ({\"type\": [\"object\", \"null\"], \"properties\": {\"a\": {\"type\": \"string\"}}}, True),\n+        ({\"type\": \"string\"}, True),\n+        ({\"$ref\": \"#/$defs/Lookup\", \"$defs\": {\"Lookup\": {\"anyOf\": [_OBJECT_BRANCH]}}}, True),\n+        ({\"$ref\": \"#/$defs/Lookup\", \"$defs\": {\"Lookup\": {\"type\": [\"object\", \"null\"]}}}, True),\n+        ({\"type\": [\"object\"], \"properties\": {\"a\": {\"type\": \"string\"}}}, False),\n+        ({\"$ref\": \"#/$defs/Lookup\", \"$defs\": {\"Lookup\": {\"type\": [\"OBJECT\"]}}}, False),\n+        ({\"$ref\": \"#/$defs/A\", \"$defs\": {\"A\": {\"$ref\": \"#/$defs/B\"}, \"B\": {\"anyOf\": [_OBJECT_BRANCH]}}}, True),\n+        ({\"$ref\": \"#/$defs/A\", \"$defs\": {\"A\": {\"$ref\": \"#/$defs/B\"}, \"B\": _OBJECT_BRANCH}}, False),\n+        ({\"$ref\": \"#/$defs/Lookup\", \"anyOf\": [{\"required\": [\"a\"]}], \"$defs\": {\"Lookup\": _OBJECT_BRANCH}}, True),\n+        ({\"$ref\": \"#/$defs/A\", \"$defs\": {\"A\": {\"$ref\": \"#/$defs/B\", \"oneOf\": [_OBJECT_BRANCH]}, \"B\": _OBJECT_BRANCH}}, True),\n+        ({\"$ref\": \"#/$defs/A\", \"$defs\": {\"A\": {\"$ref\": \"#/$defs/B\"}, \"B\": {\"$ref\": \"#/$defs/A\"}}}, False),\n+        ({\"$ref\": \"#/$defs/A\", \"$defs\": {\"A\": {\"$ref\": \"#/$defs/B\"}, \"B\": {\"$ref\": \"#/$defs/A\", \"anyOf\": [_OBJECT_BRANCH]}}}, False),\n+        ({\"$ref\": \"#/$defs/A\", \"anyOf\": [{\"required\": [\"a\"]}], \"$defs\": {\"A\": {\"$ref\": \"#/$defs/B\"}, \"B\": {\"$ref\": \"#/$defs/A\"}}}, False),\n+        (_deep_root_ref_chain({\"anyOf\": [_OBJECT_BRANCH]}), True),\n+        (_deep_root_ref_chain(_OBJECT_BRANCH), False),\n+    ],\n+    ids=[\n+        \"object\",\n+        \"uppercase-object\",\n+        \"untyped-properties\",\n+        \"union-inside-a-property\",\n+        \"root-ref-to-object\",\n+        \"root-ref-to-missing-def\",\n+        \"root-ref-into-definitions\",\n+        \"object-with-any-of\",\n+        \"root-any-of\",\n+        \"root-one-of\",\n+        \"root-all-of\",\n+        \"type-list\",\n+        \"non-object-type\",\n+        \"root-ref-to-union\",\n+        \"root-ref-to-type-list\",\n+        \"single-object-type-list\",\n+        \"root-ref-to-single-object-type-list\",\n+        \"chained-root-ref-to-union\",\n+        \"chained-root-ref-to-object\",\n+        \"root-ref-to-object-beside-a-union\",\n+        \"chained-root-ref-through-a-union-to-object\",\n+        \"cyclic-root-ref\",\n+        \"cyclic-root-ref-through-a-union\",\n+        \"cyclic-root-ref-beside-a-union\",\n+        \"deep-root-ref-chain-to-union\",\n+        \"deep-root-ref-chain-to-object\",\n+    ],\n+)\n+def test_needs_parameters_json_schema(parameters: Mapping[str, JsonValue], expected: bool) -> None:\n+    assert needs_parameters_json_schema(parameters) is expected\n+\n+\n+def _missing_root_ref(size: int) -> Mapping[str, JsonValue]:\n+    return {\"$ref\": \"#/$defs/\" + \"m\" * size, \"$defs\": {f\"d{i}\": {} for i in range(size // 16)}}\n+\n+\n+def _long_named_root_ref_cycle(size: int) -> Mapping[str, JsonValue]:\n+    first, second = \"a\" * size, \"b\" * size\n+    fillers: Final = {f\"d{i}\": {\"type\": \"string\"} for i in range(size // 16)}\n+    cycle: Final = {first: {\"$ref\": f\"#/$defs/{second}\"}, second: {\"$ref\": f\"#/$defs/{first}\"}}\n+    return {\"$ref\": f\"#/$defs/{first}\", \"$defs\": {**cycle, **fillers}}\n+\n+\n+def _root_ref_cost(parameters: Mapping[str, JsonValue]) -> float:\n+    def once() -> float:\n+        started: Final = time.perf_counter()\n+        needs_parameters_json_schema(parameters)\n+        return time.perf_counter() - started\n+\n+    return min(once() for _ in range(3))\n+\n+\n+@pytest.mark.parametrize(\"build\", [_missing_root_ref, _long_named_root_ref_cycle], ids=[\"missing-ref\", \"ref-cycle\"])\n+def test_needs_parameters_json_schema_stays_linear_on_long_refs_and_many_defs(\n+    build: Callable[[int], Mapping[str, JsonValue]],\n+) -> None:\n+    \"\"\"Tool parameters are caller-controlled, so 4x longer refs with 4x more $defs must not cost 16x.\n+    Comparing two sizes keeps this honest on a slow box, and the quadratic walk this replaced grew 13x to 16x.\"\"\"\n+    growth: Final = _root_ref_cost(build(256 * 1024)) / _root_ref_cost(build(64 * 1024))\n+\n+    assert growth < 10.0, f\"cost grew {growth:.1f}x for 4x the input\"\n+\n+\n class _Priority(int, Enum):\n     LOW = 1\n     HIGH = 3\n", "problem_statement": "[Bug]: Vertex AI 400 rejection when tools define top-level anyOf parameter schemas without type: object\n### Check for existing issues\n\n- [x] I have searched the existing issues and checked that my issue is not a duplicate.\n\n### What happened?\n\nWhen sending a request to a Vertex AI Gemini model (`vertex_ai/gemini-*`) with tools where a tool's parameter schema defines a polymorphic union (`anyOf`) at the top level without an explicit `type: \"object\"`, LiteLLM forwards the raw schema directly to Vertex AI without wrapping or normalizing it to an object.\n\nGoogle Cloud Vertex AI rejects the request with HTTP 400 `INVALID_ARGUMENT`:\n`\"Unable to submit request because '<tool_name>' functionDeclaration parameters schema should be of type OBJECT.\"`\n\nThis causes every chat completion request to fail before any text or tool call is generated, even for trivial prompts like \"hi\".\n\n**What did you expect to happen?**\nLiteLLM should sanitize tool parameter schemas targeting Vertex AI: if a tool defines a top-level `anyOf` or lacks `type: \"object\"`, LiteLLM should convert or wrap the schema into `type: \"object\"` so Vertex AI's protobuf schema validator accepts the function declaration.\n\n### User Flow\n\nBefore a (hypothetical) fix: a developer sending chat completions with MCP tools to a Vertex AI Gemini model gets a 400 error on every message because one tool uses a top-level union schema.\n\n1. They send `POST http://localhost:4000/v1/chat/completions` with `model: \"vertex_ai/gemini-3.8-flash\"`, a simple user message `\"hi\"`, and a tool whose `parameters` schema has top-level `\"anyOf\": [...]` without `\"type\": \"object\"`.\n2. The proxy returns HTTP 400 Bad Request with error:\n   `\"Unable to submit request because '<tool_name>' functionDeclaration parameters schema should be of type OBJECT. Learn more: https://cloud.google.com/vertex-ai/generative-ai/docs/multimodal/function-calling\"`\n3. The conversation is blocked and no response is generated.\n\nAfter a (hypothetical) fix: the same request succeeds because the proxy normalizes the tool's schema into an object accepted by Vertex AI.\n\n1. They send `POST http://localhost:4000/v1/chat/completions` with `model: \"vertex_ai/gemini-3.8-flash\"`, a simple user message `\"hi\"`, and the same tool schema.\n2. The proxy normalizes the tool declaration before forwarding to Vertex AI, ensuring `parameters` has `type: \"object\"`.\n3. The request succeeds with HTTP 200 OK and a valid assistant completion.\n\n### Proof the bug occurs\n\nConfig / setup the proxy ran with (`config.yaml`):\n\n```yaml\nmodel_list:\n  - model_name: gemini-vertex\n    litellm_params:\n      model: vertex_ai/gemini-3.8-flash\n      vertex_project: \"sample-project\"\n      vertex_location: \"us-central1\"\n\n### What part of LiteLLM is this about?\n\nProxy\n\n### What LiteLLM version are you on ?\n\nv1.95.0\n\n### Twitter / LinkedIn details\n\n_No response_\n", "hints_text": "Reproduced. `_filter_anyof_fields` strips top-level `type`, so adding `type: object` does not help. Working on a fix with regression tests.", "created_at": "2026-11-14T12:59:50Z"}
{"repo": "BerriAI/litellm", "pull_number": 51834, "instance_id": "BerriAI__litellm-51834", "issue_numbers": ["50780"], "base_commit": "1f2b2734e5db334c56312595184889f64a9f6e26", "patch": "diff --git a/litellm/rust/Cargo.lock b/litellm/rust/Cargo.lock\nindex 798e85effa2f..edb3a07a8bad 100644\n--- a/litellm/rust/Cargo.lock\n+++ b/litellm/rust/Cargo.lock\n@@ -3864,6 +3864,7 @@ dependencies = [\n  \"litellm-http\",\n  \"litellm-inference\",\n  \"litellm-llms\",\n+ \"litellm-model-catalog\",\n  \"litellm-redis-client\",\n  \"litellm-redis-connect\",\n  \"litellm-redis-resolve\",\n@@ -3885,6 +3886,7 @@ dependencies = [\n  \"tracing\",\n  \"uuid\",\n  \"veil\",\n+ \"wiremock\",\n ]\n \n [[package]]\n@@ -4343,6 +4345,7 @@ dependencies = [\n  \"litellm-host\",\n  \"litellm-http\",\n  \"litellm-llms-types\",\n+ \"litellm-model-catalog\",\n  \"litellm-python-compat\",\n  \"litellm-router-types\",\n  \"litellm-secret-value\",\n@@ -4380,6 +4383,7 @@ name = \"litellm-model-catalog\"\n version = \"0.1.0\"\n dependencies = [\n  \"encoding_rs\",\n+ \"fancy-regex 0.19.2\",\n  \"indexmap 2.14.0\",\n  \"jiff\",\n  \"jsonschema\",\n@@ -4624,8 +4628,11 @@ dependencies = [\n  \"litellm-core-utils\",\n  \"litellm-inference\",\n  \"litellm-inference-messages\",\n+ \"litellm-llms\",\n+ \"litellm-model-catalog\",\n  \"litellm-router-types\",\n  \"rstest\",\n+ \"serde_json\",\n ]\n \n [[package]]\ndiff --git a/litellm/rust/crates/auth-aws/src/aws.rs b/litellm/rust/crates/auth-aws/src/aws.rs\nindex e6e32754b4fc..8508ac0c47c6 100644\n--- a/litellm/rust/crates/auth-aws/src/aws.rs\n+++ b/litellm/rust/crates/auth-aws/src/aws.rs\n@@ -694,7 +694,7 @@ pub fn bedrock_model_id_and_region(model: &str) -> (String, Option<String>) {\n     (stripped.to_string(), region)\n }\n \n-fn is_bedrock_region(value: &str) -> bool {\n+pub fn is_bedrock_region(value: &str) -> bool {\n     value.len() > 3\n         && value.contains('-')\n         && value\ndiff --git a/litellm/rust/crates/gateway-inference/src/messages.rs b/litellm/rust/crates/gateway-inference/src/messages.rs\nindex 58ecd40204de..56e283d63b9b 100644\n--- a/litellm/rust/crates/gateway-inference/src/messages.rs\n+++ b/litellm/rust/crates/gateway-inference/src/messages.rs\n@@ -25,6 +25,31 @@ const OPENROUTER_API_HEADERS: [&str; 2] = [\n ];\n const ANTHROPIC_API_HEADER_PROVIDERS: &str =\n     \"anthropic,bedrock,bedrock_mantle,vertex_ai,openrouter,deepseek\";\n+const DEPLOYMENT_DEFAULT_PARAMS: [&str; 23] = [\n+    \"max_tokens\",\n+    \"metadata\",\n+    \"stop_sequences\",\n+    \"stream\",\n+    \"system\",\n+    \"temperature\",\n+    \"thinking\",\n+    \"tool_choice\",\n+    \"top_k\",\n+    \"inference_geo\",\n+    \"top_p\",\n+    \"mcp_servers\",\n+    \"context_management\",\n+    \"compaction\",\n+    \"container\",\n+    \"output_format\",\n+    \"speed\",\n+    \"output_config\",\n+    \"cache_control\",\n+    \"reasoning_effort\",\n+    \"safeguards\",\n+    \"service_tier\",\n+    \"thread\",\n+];\n \n pub async fn create(\n     State(gateway): State<Arc<Gateway>>,\n@@ -72,12 +97,15 @@ fn project(\n     body: Map<String, Value>,\n     headers: &HeaderMap,\n ) -> Result<MessagesCall, Error> {\n-    let body = body\n-        .into_iter()\n-        .map(|(name, value)| match name.as_str() {\n-            \"model\" => (name, Value::from(deployment.model.as_str())),\n-            _ => (name, value),\n-        })\n+    let tools =\n+        merged_tools(deployment, body.get(\"tools\")).map(|tools| (\"tools\".to_owned(), tools));\n+    let client_params = body.into_iter().map(|(name, value)| match name.as_str() {\n+        \"model\" => (name, Value::from(deployment.model.as_str())),\n+        _ => (name, value),\n+    });\n+    let body = deployment_default_params(deployment)\n+        .chain(client_params)\n+        .chain(tools)\n         .collect();\n     Ok(MessagesCall {\n         body: messages_body(body)?,\n@@ -92,6 +120,31 @@ fn project(\n     })\n }\n \n+fn deployment_default_params(\n+    deployment: &Deployment,\n+) -> impl Iterator<Item = (String, Value)> + '_ {\n+    DEPLOYMENT_DEFAULT_PARAMS.iter().filter_map(|name| {\n+        let value = deployment.litellm_params.extra.get(*name)?;\n+        Some(((*name).to_owned(), value.clone()))\n+    })\n+}\n+\n+fn merged_tools(deployment: &Deployment, client_tools: Option<&Value>) -> Option<Value> {\n+    let deployment_tools = deployment.litellm_params.extra.get(\"tools\")?.as_array()?;\n+    let client_tools: &[Value] = match client_tools.unwrap_or(&Value::Null) {\n+        Value::Null => &[],\n+        Value::Array(tools) => tools,\n+        _ => return None,\n+    };\n+    Some(\n+        deployment_tools\n+            .iter()\n+            .chain(client_tools)\n+            .cloned()\n+            .collect(),\n+    )\n+}\n+\n fn anthropic_api_headers(headers: &HeaderMap) -> Option<ProviderSpecificHeaders> {\n     let scopes = [\n         (\ndiff --git a/litellm/rust/crates/gateway/Cargo.toml b/litellm/rust/crates/gateway/Cargo.toml\nindex a14df9b9c531..bea1ea1a70c6 100644\n--- a/litellm/rust/crates/gateway/Cargo.toml\n+++ b/litellm/rust/crates/gateway/Cargo.toml\n@@ -30,6 +30,7 @@ litellm-redis-types.workspace = true\n rustls.workspace = true\n litellm-http.workspace = true\n litellm-llms.workspace = true\n+litellm-model-catalog.workspace = true\n litellm-secrets.workspace = true\n litellm-tracing.workspace = true\n serde_json.workspace = true\n@@ -48,3 +49,4 @@ rstest.workspace = true\n tempfile.workspace = true\n tokio = { workspace = true, features = [\"sync\"] }\n tower = { version = \"0.5\", features = [\"util\"] }\n+wiremock.workspace = true\ndiff --git a/litellm/rust/crates/gateway/src/error.rs b/litellm/rust/crates/gateway/src/error.rs\nindex c267e79353de..779656fb76cd 100644\n--- a/litellm/rust/crates/gateway/src/error.rs\n+++ b/litellm/rust/crates/gateway/src/error.rs\n@@ -20,4 +20,6 @@ pub enum Error {\n     RedisConnect(#[from] litellm_redis_connect::Error),\n     #[error(\"MCP requires working ga