 PREFECT_SERVER_UI_ENABLED: boolean,\n   PREFECT_SERVER_UI_API_URL: string,\n-  PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT: boolean,\n   PREFECT_SERVER_ANALYTICS_ENABLED: boolean,\n   PREFECT_SERVER_SERVICES_SCHEDULER_ENABLED: boolean,\n   PREFECT_SERVER_SERVICES_LATE_RUNS_ENABLED: boolean,\n+  server: {\n+    ui: {\n+      show_promotional_content: boolean,\n+    },\n+  },\n }\n\\ No newline at end of file\ndiff --git a/ui/src/pages/Dashboard.vue b/ui/src/pages/Dashboard.vue\nindex b0c6c1d11f63..a15d84ffeed2 100644\n--- a/ui/src/pages/Dashboard.vue\n+++ b/ui/src/pages/Dashboard.vue\n@@ -100,7 +100,7 @@\n   const route = useRoute()\n   const browserUiSettings = ref<Settings | null>(UiSettings.settings)\n   const serverSettings = await prefectApi.admin.getSettings()\n-  const showPromotionalContent = computed(() => serverSettings.PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT)\n+  const showPromotionalContent = computed(() => serverSettings.server.ui.show_promotional_content)\n   const canSwitchToV2 = computed(() => {\n     return browserUiSettings.value !== null && isUiAvailable(browserUiSettings.value, 'v2')\n   })\n", "test_patch": "diff --git a/.github/workflows/ui-tests.yml b/.github/workflows/ui-tests.yml\nindex 3e582ede1baa..9a324d5cb0d7 100644\n--- a/.github/workflows/ui-tests.yml\n+++ b/.github/workflows/ui-tests.yml\n@@ -43,6 +43,10 @@ jobs:\n         working-directory: ./ui\n         run: npm ci install\n \n+      - name: Test ui\n+        working-directory: ./ui\n+        run: npm test\n+\n       - name: Build ui\n         working-directory: ./ui\n         run: npm run build\ndiff --git a/ui/tests/SlotContainer.ts b/ui/tests/SlotContainer.ts\nnew file mode 100644\nindex 000000000000..f14313019a4d\n--- /dev/null\n+++ b/ui/tests/SlotContainer.ts\n@@ -0,0 +1,7 @@\n+import { defineComponent, h as createVNode } from 'vue'\n+\n+// Keep named slots visible while replacing unrelated design-system components.\n+export const SlotContainer = defineComponent({\n+  name: 'SlotContainer',\n+  setup: (_props, { slots }) => () => createVNode('div', Object.values(slots).flatMap(slot => slot?.() ?? [])),\n+})\ndiff --git a/ui/tests/promotionalContent.test.ts b/ui/tests/promotionalContent.test.ts\nnew file mode 100644\nindex 000000000000..f2a03ae82f86\n--- /dev/null\n+++ b/ui/tests/promotionalContent.test.ts\n@@ -0,0 +1,97 @@\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n+import { createSSRApp } from 'vue'\n+import { renderToString } from 'vue/server-renderer'\n+import ApiStatusToast from '@/components/ApiStatusToast.vue'\n+import ContextSidebar from '@/components/ContextSidebar.vue'\n+import Dashboard from '@/pages/Dashboard.vue'\n+import { SlotContainer } from 'tests/SlotContainer'\n+\n+const { getSettings } = vi.hoisted(() => ({ getSettings: vi.fn() }))\n+\n+vi.mock('@/compositions/usePrefectApi', () => ({\n+  usePrefectApi: () => ({ admin: { getSettings } }),\n+}))\n+vi.mock('@/compositions/useCan', () => ({ useCan: () => ({ read: { 'work_pool': true } }) }))\n+vi.mock('vue-router', () => ({ useRoute: () => ({ path: '/' }) }))\n+vi.mock('@/router', () => ({ routes: new Proxy({}, { get: () => () => '/' }) }))\n+vi.mock('@/services/uiSettings', () => ({\n+  UiSettings: { settings: null, loadOptional: () => Promise.resolve(null) },\n+}))\n+vi.mock('@/utilities/uiVersion', () => ({\n+  V2_PROMO_DISMISSED_STORAGE_KEY: 'v2-promo-dismissed',\n+  isUiAvailable: () => false,\n+  switchToV2Ui: vi.fn(),\n+}))\n+vi.mock('@/components/JoinTheCommunityModal.vue', () => ({ default: { render: () => null } }))\n+vi.mock('@prefecthq/prefect-design', async () => {\n+  const { SlotContainer: Container } = await import('tests/SlotContainer')\n+  return { PContextSidebar: Container, PContextNavItem: Container, PButton: Container, PHeading: Container }\n+})\n+vi.mock('@prefecthq/vue-compositions', async () => {\n+  const { ref } = await import('vue')\n+  return {\n+    useStorage: (_location: string, _key: string, fallback: boolean) => ({ value: ref(fallback) }),\n+    useSubscription: () => ({ executed: true, response: 0 }),\n+  }\n+})\n+vi.mock('@prefecthq/prefect-ui-library', async () => {\n+  const { ref } = await import('vue')\n+  const { SlotContainer: Container } = await import('tests/SlotContainer')\n+  return {\n+    ...Object.fromEntries([\n+      'DashboardWorkPoolsCard', 'WorkspaceDashboardFlowRunsCard', 'CumulativeTaskRunsCard',\n+      'PageHeading', 'FlowRunTagsInput', 'FlowRunsPageEmptyState', 'MarketingBanner', 'DateRangeSelect',\n+    ].map(name => [name, Container])),\n+    localization: { info: { variables: 'Variables' } },\n+    useShowModal: () => ({ showModal: ref(false), open: vi.fn() }),\n+    useWorkspaceApi: () => ({ flowRuns: { getFlowRunsCount: vi.fn() } }),\n+    subscriptionIntervalKey: Symbol('subscriptionInterval'),\n+    dateFunctions: { secondsToMilliseconds: (seconds: number) => seconds * 1000 },\n+    secondsInDay: 86400,\n+    useWorkspaceDashboardFilterFromRoute: () => ({ hideSubflows: false, tags: [], range: {} }),\n+    mapper: { map: vi.fn() },\n+  }\n+})\n+\n+async function render(component: typeof ContextSidebar): Promise<string> {\n+  const app = createSSRApp(component)\n+  for (const name of ['PLayoutDefault', 'PButton', 'PIcon', 'RouterLink']) {\n+    app.component(name, SlotContainer)\n+  }\n+  return await renderToString(app)\n+}\n+\n+beforeEach(() => {\n+  vi.clearAllMocks()\n+  // Reproduce the stale value cached by the old flat-key lookup.\n+  const values = new Map([['prefect-show-promotional-content', 'undefined']])\n+  vi.stubGlobal('localStorage', {\n+    getItem: (key: string) => values.get(key) ?? null,\n+    setItem: (key: string, value: string) => values.set(key, String(value)),\n+  })\n+})\n+\n+afterEach(() => {\n+  vi.unstubAllGlobals()\n+})\n+\n+for (const [name, component, promotion] of [\n+  ['sidebar', ContextSidebar, 'Ready to scale?'],\n+  ['dashboard', Dashboard, 'Upgrade to Cloud'],\n+] as const) {\n+  describe(name, () => {\n+    it.each([false, true])('honors the nested promotional setting %s through the error toast', async enabled => {\n+      getSettings.mockResolvedValue({ server: { ui: { 'show_promotional_content': enabled } } })\n+\n+      const page = await render(component)\n+      expect(getSettings).toHaveBeenCalledOnce()\n+      expect(page.includes(promotion)).toBe(enabled)\n+      expect(localStorage.getItem('prefect-show-promotional-content')).toBe(String(enabled))\n+\n+      // The API error interceptor creates this toast after a subsequent request fails.\n+      const toast = await render(ApiStatusToast)\n+      expect(toast.includes('You can use Prefect Cloud for free, anytime.')).toBe(enabled)\n+      expect(toast.includes('Please check your connection and try again.')).toBe(!enabled)\n+    })\n+  })\n+}\ndiff --git a/ui/vitest.config.mts b/ui/vitest.config.mts\nnew file mode 100644\nindex 000000000000..401147155434\n--- /dev/null\n+++ b/ui/vitest.config.mts\n@@ -0,0 +1,17 @@\n+import { fileURLToPath, URL } from 'node:url'\n+import vue from '@vitejs/plugin-vue'\n+import { defineConfig } from 'vitest/config'\n+\n+export default defineConfig({\n+  plugins: [vue()],\n+  resolve: {\n+    alias: {\n+      '@': fileURLToPath(new URL('./src', import.meta.url)),\n+      'tests': fileURLToPath(new URL('./tests', import.meta.url)),\n+    },\n+  },\n+  test: {\n+    environment: 'node',\n+    include: ['tests/**/*.test.ts'],\n+  },\n+})\n", "problem_statement": "v1 UI ignores PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT\n### Bug summary\n\nWith `PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT=false`, the v1 UI's API error toast still shows \"You can use Prefect Cloud for free, anytime.\"\n\n`ContextSidebar.vue` and `Dashboard.vue` read `serverSettings.PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT`, but `/api/admin/settings` returns the value nested at `server.ui.show_promotional_content`. The lookup is always `undefined`, which gets cached in localStorage as `\"undefined\"`. `ApiStatusToast.vue` shows the promo unless that cached value is `\"false\"`.\n\nThe flat-key lookup was introduced in #21706. The v2 UI is not affected.\n\nTo reproduce:\n\n1. `PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT=false prefect server start`\n2. Open the v1 UI, then stop the server.\n3. The error toast shows the Prefect Cloud promo.\n\n### Version info\n\n```Text\nVersion:              3.9.1\nAPI version:          0.8.4\nPython version:       3.13.12\nGit commit:           bd4807c3\nBuilt:                Fri, Oct 30, 2026 03:52 PM\nOS/Arch:              linux/x86_64\nProfile:              ephemeral\nServer type:          ephemeral\nPydantic version:     2.13.4\nServer:\n  Database:           postgresql\n  PostgreSQL version: 16.15\nIntegrations:\n  prefect-redis:      0.2.14\n  prefect-kubernetes: 0.7.12\n  prefect-docker:     0.7.3\n  prefect-aws:        0.7.11\n  prefect-azure:      0.4.12\n  prefect-ray:        0.5.0\n```\n\n### Additional context\n\nFix: read `serverSettings.server.ui.show_promotional_content`, as #19299 originally did.\n\n", "hints_text": "", "created_at": "2026-11-02T17:33:47Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23695, "instance_id": "PrefectHQ__prefect-23695", "issue_numbers": ["23694"], "base_commit": "da9d9dc15f647f10135a8ff79ce93c4bdb2dbf6a", "patch": "diff --git a/src/prefect/cli/AGENTS.md b/src/prefect/cli/AGENTS.md\nindex 6242f9aaf6c5..2e8092f7af64 100644\n--- a/src/prefect/cli/AGENTS.md\n+++ b/src/prefect/cli/AGENTS.md\n@@ -6,7 +6,7 @@ Prefect command-line interface, powered by **cyclopts**.\n \n - **Use `rich` for all output.** Console output via `rich.console`, tables via `rich.table`, progress bars via `rich.progress`. Always use `exit_with_error` for error exits.\n - **Support JSON output whenever possible.** Commands should have a `--json` flag or equivalent for machine-readable output. Any diagnostic or informational `print()` calls must be suppressed when JSON output is active \u2014 mixing human-readable text with the JSON payload breaks machine consumers.\n-- **Print JSON and other verbatim user data with `markup=False, emoji=False`.** `console.print` otherwise parses `[...]` as Rich markup and `:name:` as emoji aliases, silently rewriting payloads (or raising `MarkupError` on stray closing tags). `print_json` and `Pretty` are not affected.\n+- **Print JSON, YAML, and other verbatim user data with `print_verbatim` from `_utilities.py`.** `console.print` otherwise parses `[...]` as Rich markup and `:name:` as emoji aliases, silently rewriting payloads (or raising `MarkupError` on stray closing tags). `print_verbatim` disables both and soft-wraps; `tests/cli/test_utilities.py` fails if serialized output goes through `console.print` directly. `print_json` and `Pretty` are not affected.\n - **Page through \"all records\" reads.** Client `read_*` list calls without `limit` return at most `PREFECT_SERVER_API_DEFAULT_LIMIT` (200) rows (server `LimitBody`) \u2014 or fewer when the client method has its own default `limit` (e.g. `read_global_concurrency_limits` defaults to 10) \u2014 so `--all`/bulk commands must loop on `offset`. When deleting while paging, re-read from offset 0 each pass \u2014 advancing `offset` skips rows that shifted into earlier pages.\n - **Excluded from `prefect-client`** \u2014 the entire `cli/` directory is stripped during the client package build.\n \ndiff --git a/src/prefect/cli/_utilities.py b/src/prefect/cli/_utilities.py\nindex 38bcac4b0b71..bd3463fc17e1 100644\n--- a/src/prefect/cli/_utilities.py\n+++ b/src/prefect/cli/_utilities.py\n@@ -28,6 +28,17 @@ def exit_with_success(message: str, **kwargs: Any) -> NoReturn:\n     raise SystemExit(0)\n \n \n+def print_verbatim(output: str) -> None:\n+    \"\"\"\n+    Print machine-readable output (e.g. JSON or YAML) exactly as given.\n+\n+    Rich markup and emoji alias parsing are disabled so user data like\n+    `[red]text[/red]` or `:smile:` is not rewritten, and soft wrapping keeps\n+    long lines intact.\n+    \"\"\"\n+    _cli.console.print(output, soft_wrap=True, markup=False, emoji=False)\n+\n+\n def with_cli_exception_handling(fn: Callable[..., Any]) -> Callable[..., Any]:\n     if inspect.iscoroutinefunction(fn):\n \ndiff --git a/src/prefect/cli/artifact.py b/src/prefect/cli/artifact.py\nindex b5b3f1b293d8..4df8e20e4bf9 100644\n--- a/src/prefect/cli/artifact.py\n+++ b/src/prefect/cli/artifact.py\n@@ -13,6 +13,7 @@\n from prefect.cli._utilities import (\n     exit_with_error,\n     exit_with_success,\n+    print_verbatim,\n     with_cli_exception_handling,\n )\n \n@@ -77,7 +78,7 @@ async def list_artifacts(\n     if output and output.lower() == \"json\":\n         artifacts_json = [artifact.model_dump(mode=\"json\") for artifact in artifacts]\n         json_output = orjson.dumps(artifacts_json, option=orjson.OPT_INDENT_2).decode()\n-        _cli.console.print(json_output, soft_wrap=True, markup=False, emoji=False)\n+        print_verbatim(json_output)\n     else:\n         table = Table(\n             title=\"Artifacts\",\n@@ -181,7 +182,7 @@ async def inspect(\n             json_output = orjson.dumps(\n                 artifacts_json, option=orjson.OPT_INDENT_2\n             ).decode()\n-            _cli.console.print(json_output, soft_wrap=True, markup=False, emoji=False)\n+            print_verbatim(json_output)\n         else:\n             _cli.console.print(Pretty(artifacts_json))\n \ndiff --git a/src/prefect/cli/automation.py b/src/prefect/cli/automation.py\nindex 0f33c8f101ce..0c06125ed10b 100644\n--- a/src/prefect/cli/automation.py\n+++ b/src/prefect/cli/automation.py\n@@ -15,6 +15,7 @@\n from prefect.cli._utilities import (\n     exit_with_error,\n     exit_with_success,\n+    print_verbatim,\n     with_cli_exception_handling,\n )\n \n@@ -171,9 +172,9 @@ def no_really_json(obj: type[BaseModel]):\n             automation = no_really_json(automation)\n \n         if yaml or (output and output.lower() == \"yaml\"):\n-            _cli.console.print(pyyaml.dump(automation, sort_keys=False))\n+            print_verbatim(pyyaml.dump(automation, sort_keys=False))\n         elif json or (output and output.lower() == \"json\"):\n-            _cli.console.print(\n+            print_verbatim(\n                 orjson.dumps(automation, option=orjson.OPT_INDENT_2).decode()\n             )\n     else:\ndiff --git a/src/prefect/cli/block.py b/src/prefect/cli/block.py\nindex 1d192c757f9b..e4dde826b473 100644\n--- a/src/prefect/cli/block.py\n+++ b/src/prefect/cli/block.py\n@@ -22,6 +22,7 @@\n from prefect.cli._utilities import (\n     exit_with_error,\n     exit_with_success,\n+    print_verbatim,\n     with_cli_exception_handling,\n )\n \n@@ -287,7 +288,7 @@ async def block_ls(\n     if output and output.lower() == \"json\":\n         blocks_json = [block.model_dump(mode=\"json\") for block in blocks]\n         json_output = orjson.dumps(blocks_json, option=orjson.OPT_INDENT_2).decode()\n-        _cli.console.print(json_output, soft_wrap=True)\n+        print_verbatim(json_output)\n     else:\n         table = Table(\n             title=\"Blocks\", caption=\"List Block Types using `prefect block type ls`\"\n@@ -464,7 +465,7 @@ async def block_inspect(\n         if output and output.lower() == \"json\":\n             block_json = block_document.model_dump(mode=\"json\")\n             json_output = orjson.dumps(block_json, option=orjson.OPT_INDENT_2).decode()\n-            _cli.console.print(json_output, soft_wrap=True)\n+            print_verbatim(json_output)\n         else:\n             _cli.console.print(_display_block(block_document))\n \n@@ -501,7 +502,7 @@ async def list_types(\n         json_output = orjson.dumps(\n             block_types_json, option=orjson.OPT_INDENT_2\n         ).decode()\n-        _cli.console.print(json_output, soft_wrap=True)\n+        print_verbatim(json_output)\n     else:\n         table = Table(\n             title=\"Block Types\",\n@@ -572,7 +573,7 @@ async def blocktype_inspect(\n                 {\"block_type\": block_type_json, \"schema\": schema_json},\n                 option=orjson.OPT_INDENT_2,\n             ).decode()\n-            _cli.console.print(json_output, soft_wrap=True)\n+            print_verbatim(json_output)\n             return\n \n         _cli.console.print(_display_block_type(block_type))\ndiff --git a/src/prefect/cli/cloud/__init__.py b/src/prefect/cli/cloud/__init__.py\nindex 933b3a55363d..68107352ce91 100644\n--- a/src/prefect/cli/cloud/__init__.py\n+++ b/src/prefect/cli/cloud/__init__.py\n@@ -20,6 +20,7 @@\n     prompt_select_from_list,\n )\n from prefect.cli._utilities import (\n+    print_verbatim,\n     exit_with_error,\n     exit_with_success,\n     with_cli_exception_handling,\n@@ -350,7 +351,7 @@ async def workspace_ls(\n             workspace.model_dump(mode=\"json\") for workspace in sorted_workspaces\n         ]\n         json_output = orjson.dumps(workspaces_json, option=orjson.OPT_INDENT_2).decode()\n-        _cli.console.print(json_output, soft_wrap=True)\n+        print_verbatim(json_output)\n         return\n \n     current_workspace = get_current_work