 @@\n+import { render, screen, within } from \"@testing-library/react\";\n+import userEvent from \"@testing-library/user-event\";\n+import { mockPointerEvents } from \"@tests/utils/browser\";\n+import { useState } from \"react\";\n+import { beforeAll, describe, expect, it, vi } from \"vitest\";\n+import type { StateType } from \"@/api/flow-runs/constants\";\n+import { StateTypeFilter } from \"./state-type-filter\";\n+\n+function TestStateTypeFilter({\n+\tinitialTypes = [],\n+\tonChange = () => {},\n+}: {\n+\tinitialTypes?: StateType[];\n+\tonChange?: (types: Set<StateType>) => void;\n+}) {\n+\tconst [types, setTypes] = useState(new Set(initialTypes));\n+\treturn (\n+\t\t<StateTypeFilter\n+\t\t\tselectedFilters={types}\n+\t\t\tonSelectFilter={(next) => {\n+\t\t\t\tsetTypes(next);\n+\t\t\t\tonChange(next);\n+\t\t\t}}\n+\t\t/>\n+\t);\n+}\n+\n+describe(\"StateTypeFilter\", () => {\n+\tbeforeAll(mockPointerEvents);\n+\n+\tit(\"adds and removes types while preserving the other selections\", async () => {\n+\t\tconst user = userEvent.setup();\n+\t\tconst onChange = vi.fn();\n+\t\trender(\n+\t\t\t<TestStateTypeFilter initialTypes={[\"FAILED\"]} onChange={onChange} />,\n+\t\t);\n+\t\tconst trigger = screen.getByRole(\"button\", { name: \"State types\" });\n+\t\texpect(trigger).toHaveTextContent(\"Failed\");\n+\t\tawait user.click(trigger);\n+\t\tawait user.click(screen.getByRole(\"menuitem\", { name: \"Running\" }));\n+\t\texpect(onChange).toHaveBeenLastCalledWith(new Set([\"FAILED\", \"RUNNING\"]));\n+\t\texpect(trigger).toHaveTextContent(\"Failed, Running\");\n+\t\tawait user.click(screen.getByRole(\"menuitem\", { name: \"Failed\" }));\n+\t\texpect(onChange).toHaveBeenLastCalledWith(new Set([\"RUNNING\"]));\n+\t\texpect(\n+\t\t\twithin(screen.getByRole(\"menuitem\", { name: \"Failed\" })).getByRole(\n+\t\t\t\t\"checkbox\",\n+\t\t\t),\n+\t\t).not.toBeChecked();\n+\t\texpect(\n+\t\t\twithin(screen.getByRole(\"menuitem\", { name: \"Running\" })).getByRole(\n+\t\t\t\t\"checkbox\",\n+\t\t\t),\n+\t\t).toBeChecked();\n+\t\tawait user.keyboard(\"{Escape}\");\n+\t\texpect(trigger).toHaveTextContent(\"Running\");\n+\t});\n+\n+\tit(\"clears all selected types\", async () => {\n+\t\tconst user = userEvent.setup();\n+\t\tconst onChange = vi.fn();\n+\t\trender(\n+\t\t\t<TestStateTypeFilter\n+\t\t\t\tinitialTypes={[\"FAILED\", \"SCHEDULED\"]}\n+\t\t\t\tonChange={onChange}\n+\t\t\t/>,\n+\t\t);\n+\t\tconst trigger = screen.getByRole(\"button\", { name: \"State types\" });\n+\t\tawait user.click(trigger);\n+\t\tawait user.click(screen.getByRole(\"menuitem\", { name: \"All state types\" }));\n+\t\texpect(onChange).toHaveBeenLastCalledWith(new Set());\n+\t\texpect(screen.getAllByRole(\"checkbox\")).toSatisfy((boxes: HTMLElement[]) =>\n+\t\t\tboxes.every((box) => box.getAttribute(\"aria-checked\") === \"false\"),\n+\t\t);\n+\t\tawait user.keyboard(\"{Escape}\");\n+\t\texpect(trigger).toHaveTextContent(\"All state types\");\n+\t});\n+\n+\tit(\"replaces the selection with every type except scheduled\", async () => {\n+\t\tconst user = userEvent.setup();\n+\t\tconst onChange = vi.fn();\n+\t\trender(\n+\t\t\t<TestStateTypeFilter initialTypes={[\"SCHEDULED\"]} onChange={onChange} />,\n+\t\t);\n+\t\tconst trigger = screen.getByRole(\"button\", { name: \"State types\" });\n+\t\tawait user.click(trigger);\n+\t\tawait user.click(\n+\t\t\tscreen.getByRole(\"menuitem\", { name: \"All except scheduled\" }),\n+\t\t);\n+\t\texpect(onChange).toHaveBeenLastCalledWith(\n+\t\t\tnew Set<StateType>([\n+\t\t\t\t\"COMPLETED\",\n+\t\t\t\t\"RUNNING\",\n+\t\t\t\t\"PENDING\",\n+\t\t\t\t\"FAILED\",\n+\t\t\t\t\"CANCELLED\",\n+\t\t\t\t\"CANCELLING\",\n+\t\t\t\t\"CRASHED\",\n+\t\t\t\t\"PAUSED\",\n+\t\t\t]),\n+\t\t);\n+\t\texpect(\n+\t\t\twithin(screen.getByRole(\"menuitem\", { name: \"Completed\" })).getByRole(\n+\t\t\t\t\"checkbox\",\n+\t\t\t),\n+\t\t).toBeChecked();\n+\t\texpect(\n+\t\t\twithin(screen.getByRole(\"menuitem\", { name: \"Scheduled\" })).getByRole(\n+\t\t\t\t\"checkbox\",\n+\t\t\t),\n+\t\t).not.toBeChecked();\n+\t\tawait user.keyboard(\"{Escape}\");\n+\t\texpect(trigger).toHaveTextContent(\"All except scheduled\");\n+\t});\n+});\ndiff --git a/ui-v2/src/components/runs/use-runs-saved-filters.test.ts b/ui-v2/src/components/runs/use-runs-saved-filters.test.ts\nnew file mode 100644\nindex 000000000000..e0791a72860d\n--- /dev/null\n+++ b/ui-v2/src/components/runs/use-runs-saved-filters.test.ts\n@@ -0,0 +1,19 @@\n+import { expect, it } from \"vitest\";\n+import {\n+\tfilterValuesToUrlParams,\n+\turlParamsToFilterValues,\n+} from \"./use-runs-saved-filters\";\n+\n+it(\"restores legacy names and round-trips custom names with separate types\", () => {\n+\texpect(urlParamsToFilterValues({ state: \"Failed,TimedOut\" })).toEqual({\n+\t\tstate: [\"Failed\", \"TimedOut\"],\n+\t});\n+\tconst saved = {\n+\t\tstate: [\"Baseline, NOT Met\", \"baseline NOT Met\"],\n+\t\tstateTypes: [\"FAILED\" as const],\n+\t\trange: \"past-7-days\" as const,\n+\t};\n+\texpect(urlParamsToFilterValues(filterValuesToUrlParams(saved))).toEqual(\n+\t\tsaved,\n+\t);\n+});\ndiff --git a/ui-v2/src/components/runs/use-saved-filters.test.ts b/ui-v2/src/components/runs/use-saved-filters.test.ts\nindex 9933c185e5ae..9c32bd9600d5 100644\n--- a/ui-v2/src/components/runs/use-saved-filters.test.ts\n+++ b/ui-v2/src/components/runs/use-saved-filters.test.ts\n@@ -8,12 +8,26 @@ import {\n \tfilterValuesToDateRangeUrlState,\n \ttype SavedFilter,\n \ttype SavedFilterValues,\n+\tSYSTEM_FILTER_HIDE_SCHEDULED_ID,\n \tSYSTEM_FILTERS,\n \tURL_PARAM_TO_FILTER_KEY_MAP,\n \tuseSavedFilters,\n } from \"./use-saved-filters\";\n \n describe(\"areFiltersEqual\", () => {\n+\tit(\"keeps custom names exact and compares types independently\", () => {\n+\t\tconst filters: SavedFilterValues = {\n+\t\t\tstate: [\"Baseline, NOT Met\"],\n+\t\t\tstateTypes: [\"FAILED\"],\n+\t\t};\n+\t\texpect(areFiltersEqual(filters, { ...filters })).toBe(true);\n+\t\texpect(\n+\t\t\tareFiltersEqual(filters, { ...filters, stateTypes: [\"RUNNING\"] }),\n+\t\t).toBe(false);\n+\t\texpect(\n+\t\t\tareFiltersEqual(filters, { ...filters, state: [\"baseline, NOT Met\"] }),\n+\t\t).toBe(false);\n+\t});\n \tit(\"returns true for identical empty filters\", () => {\n \t\tconst filterA: SavedFilterValues = {};\n \t\tconst filterB: SavedFilterValues = {};\n@@ -187,6 +201,37 @@ describe(\"useSavedFilters\", () => {\n \t\texpect(result.current.defaultFilterId).toBeNull();\n \t});\n \n+\tit(\"restores a system default by ID while keeping user-saved names exact\", () => {\n+\t\tconst legacyFilter = {\n+\t\t\tid: \"legacy-name-filter\",\n+\t\t\tname: \"Completed names\",\n+\t\t\tfilters: { state: [\"Completed\", \"Cached\"] },\n+\t\t};\n+\t\tvi.mocked(localStorage.getItem).withImplementation(\n+\t\t\t(key) => {\n+\t\t\t\tif (key === \"prefect-ui-v2-default-filter-id\") {\n+\t\t\t\t\treturn JSON.stringify(SYSTEM_FILTER_HIDE_SCHEDULED_ID);\n+\t\t\t\t}\n+\t\t\t\tif (key === \"prefect-ui-v2-saved-filters\") {\n+\t\t\t\t\treturn JSON.stringify([legacyFilter]);\n+\t\t\t\t}\n+\t\t\t\treturn null;\n+\t\t\t},\n+\t\t\t() => {\n+\t\t\t\tconst { result } = renderHook(() => useSavedFilters());\n+\t\t\t\tconst systemDefault = result.current.getFilterById(\n+\t\t\t\t\tresult.current.defaultFilterId ?? \"\",\n+\t\t\t\t);\n+\t\t\t\texpect(systemDefault?.filters.state).toBeUndefined();\n+\t\t\t\texpect(systemDefault?.filters.stateTypes).toContain(\"COMPLETED\");\n+\t\t\t\texpect(systemDefault?.filters.stateTypes).not.toContain(\"SCHEDULED\");\n+\t\t\t\texpect(result.current.getFilterById(legacyFilter.id)).toEqual(\n+\t\t\t\t\tlegacyFilter,\n+\t\t\t\t);\n+\t\t\t},\n+\t\t);\n+\t});\n+\n \tit(\"saves a new filter\", () => {\n \t\tconst { result } = renderHook(() => useSavedFilters());\n \ndiff --git a/ui-v2/src/routes/runs/-state-filters.test.ts b/ui-v2/src/routes/runs/-state-filters.test.ts\nnew file mode 100644\nindex 000000000000..67e6bc566b38\n--- /dev/null\n+++ b/ui-v2/src/routes/runs/-state-filters.test.ts\n@@ -0,0 +1,100 @@\n+import { describe, expect, it } from \"vitest\";\n+import { STATE_NAME_TO_TYPE } from \"@/api/flow-runs/constants\";\n+import { filterValuesToUrlParams } from \"@/components/runs/use-runs-saved-filters\";\n+import {\n+\tSYSTEM_DEFAULT_FILTER,\n+\tSYSTEM_FILTER_HIDE_SCHEDULED_ID,\n+\tSYSTEM_FILTERS,\n+} from \"@/components/runs/use-saved-filters\";\n+import {\n+\tbuildHistoryFilter,\n+\tbuildPaginationBody,\n+\tbuildTaskRunsPaginationBody,\n+\tsearchParams,\n+} from \"./index\";\n+\n+describe(\"runs state filtering\", () => {\n+\tit(\"hides every scheduled type through the saved preset, URL, list, and chart\", () => {\n+\t\tconst preset = SYSTEM_FILTERS.find(\n+\t\t\t(filter) => filter.id === SYSTEM_FILTER_HIDE_SCHEDULED_ID,\n+\t\t);\n+\t\tif (!preset) throw new Error(\"Missing Hide scheduled runs preset\");\n+\t\tconst params = searchParams.parse(filterValuesToUrlParams(preset.filters));\n+\t\tconst expected = {\n+\t\t\toperator: \"and_\",\n+\t\t\ttype: {\n+\t\t\t\tany_: [\n+\t\t\t\t\t\"COMPLETED\",\n+\t\t\t\t\t\"RUNNING\",\n+\t\t\t\t\t\"PENDING\",\n+\t\t\t\t\t\"FAILED\",\n+\t\t\t\t\t\"CANCELLED\",\n+\t\t\t\t\t\"CANCELLING\",\n+\t\t\t\t\t\"CRASHED\",\n+\t\t\t\t\t\"PAUSED\",\n+\t\t\t\t],\n+\t\t\t},\n+\t\t};\n+\t\tconst filters = [\n+\t\t\tbuildPaginationBody(params).flow_runs?.state,\n+\t\t\tbuildHistoryFilter(params).flow_runs?.state,\n+\t\t\tbuildTaskRunsPaginationBody(params).task_runs?.state,\n+\t\t];\n+\t\tfor (const filter of filters) {\n+\t\t\texpect(filter).toEqual(expected);\n+\t\t\texpect(filter?.name).toBeUndefined();\n+\t\t\t// Cached and custom names are included by type, without a name allowlist.\n+\t\t\texpect(filter?.type?.any_).toContain(STATE_NAME_TO_TYPE.Cached);\n+\t\t\texpect(filter?.type?.any_).toContain(\"FAILED\");\n+\t\t\tfor (const name of [\n+\t\t\t\t\"Scheduled\",\n+\t\t\t\t\"Late\",\n+\t\t\t\t\"Resuming\",\n+\t\t\t\t\"AwaitingRetry\",\n+\t\t\t\t\"AwaitingConcurrencySlot\",\n+\t\t\t] as const) {\n+\t\t\t\texpect(filter?.type?.any_).not.toContain(STATE_NAME_TO_TYPE[name]);\n+\t\t\t}\n+\t\t}\n+\t\texpect(params.range).toBe(\"past-7-days\");\n+\t});\n+\n+\tit(\"keeps the Past week default unrestricted by state\", () => {\n+\t\tconst params = searchParams.parse(\n+\t\t\tfilterValuesToUrlParams(SYSTEM_DEFAULT_FILTER.filters),\n+\t\t);\n+\t\texpect(params.range).toBe(\"past-7-days\");\n+\t\texpect(buildPaginationBody(params).flow_runs?.state).toBeUndefined();\n+\t\texpect(buildHistoryFilter(params).flow_runs?.state).toBeUndefined();\n+\t\texpect(\n+\t\t\tbuildTaskRunsPaginationBody(params).task_runs?.state,\n+\t\t).toBeUndefined();\n+\t});\n+\n+\tit(\"preserves exact names in existing user-saved filters\", () => {\n+\t\tconst params = searchParams.parse(\n+\t\t\tfilterValuesToUrlParams({ state: [\"Completed\", \"Cached\"] }),\n+\t\t);\n+\t\texpect(buildPaginationBody(params).flow_runs?.state).toEqual({\n+\t\t\toperator: \"and_\",\n+\t\t\tname: { any_: [\"Completed\", \"Cached\"] },\n+\t\t});\n+\t});\n+\n+\tit(\"uses the same exact type/name filter for the flow list and chart\", () => {\n+\t\tconst params = searchParams.parse({\n+\t\t\tstate: [\"Baseline, NOT Met\"],\n+\t\t\t\"state-types\": [\"FAILED\"],\n+\t\t});\n+\t\tconst expected = {\n+\t\t\toperator: \"and_\",\n+\t\t\tname: { any_: [\"Baseline, NOT Met\"] },\n+\t\t\ttype: { any_: [\"FAILED\"] },\n+\t\t};\n+\t\texpect(buildPaginationBody(params).flow_runs?.state).toEqual(expected);\n+\t\texpect(buildHistoryFilter(params).flow_runs?.state).toEqual(expected);\n+\t\tconst task = buildTaskRunsPaginationBody(params);\n+\t\texpect(task.task_runs?.state).toEqual(expected);\n+\t\texpect(task.flow_runs?.state).toBeUndefined();\n+\t});\n+});\ndiff --git a/ui-v2/tests/utils/handlers.ts b/ui-v2/tests/utils/handlers.ts\nindex 8f5e3d11d352..b0cac9a5249c 100644\n--- a/ui-v2/tests/utils/handlers.ts\n+++ b/ui-v2/tests/utils/handlers.ts\n@@ -412,6 +412,7 @@ const workPoolQueuesHandlers = [\n ];\n \n export const handlers = [\n+\thttp.get(buildApiUrl(\"/observed-states\"), () => HttpResponse.json([])),\n \t...uiSettingsHandlers,\n \t...csrfTokenHandlers,\n \t...artifactsHandlers,\n", "problem_statement": "Allow filtering flow and task runs by both state type and state name\n### Describe the current behavior\n\nI'm marking some tasks (and flows) with a custom `Failed` state, let's say `NewObjects`, like this:\n```\nreturn Failed(message=\"New objects added mid flow\", name=\"NewObjects\")\n```\n\nThis works great as in when I display all flow/task runs, it shows the correct icon (failed state type) and the text (the state name). \n\nWhere it does not work that great, it's filtering. The filters in both `/runs` and `/flows/flow/8c5e78f2-8141-4c9f-8621-395c26902bbe` do not show `NewObjects` as options, so I can't filter for only flows with this state type.\n\nEven more so, filtering by `Failed` actually does not show flows with the `NewObjects`. This is, I assume, because it filters for the state name.\n\n\n\n### Describe the proposed behavior\n\nFor me, ideally, there would be two filters on both pages, one for state type and one for state name\n\n### Example Use\n\n_No response_\n\n### Additional context\n\nWorkarounds\n\nIn the flow run page, one can filter for specific state name by modifying the GET parameters\n\n```\n/flows/flow/8c5e78f2-8141-4c9f-8621-395c26902bbe?runs.flowRuns.state.name=NewObjects\n```\n\nIn the flow run page, one can filter fopr specific state type by modifying the GET parameters even more\n\n```\n/flows/flow/8c5e78f2-8141-4c9f-8621-395c26902bbe?runs.flowRuns.state.type=Failed\n```\n\nIn the runs page, one can filter for specific state name by modifying the GET parameters\n\n```\n/runs?seconds=-604800&type=span&state=NewObjects\n```\n\nI did not find a workaround to filter for state type\n", "hints_text": "  Hey @desertaxle  I took a look through the current `ui-v2` filter wiring, and this seems to be a real gap rather than just a docs\n  issue.\n\n  Right now the run filters are effectively keyed off a fixed list of known state names, and the flow-detail route\n  specifically applies `state.name` filtering. That means custom states like `Failed(name=\"NewObjects\")` can render\n  correctly in the table, but they do not show up as filter options, and filtering by `Failed` will miss them because it\n  is filtering by name rather than state type.\n\n  Before I start on a fix, would you want this treated as:\n  - a narrower change where the existing state filter matches on state type\n  - or the fuller version from the issue, with separate filters for state type and state name\n\n  I can work on it either way, but I wanted to confirm the preferred scope first.", "created_at": "2026-10-20T20:58:18Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23473, "instance_id": "PrefectHQ__prefect-23473", "issue_numbers": ["23472"], "base_commit": "817bc93b6e828459e6853fa8b51ddba52515ad16", "patch": "diff --git a/src/prefect/_internal/concurrency/services.py b/src/prefect/_internal/concurrency/services.py\nindex e75ebf73ff9e..d2575de6d7a0 100644\n--- a/src/prefect/_internal/concurrency/services.py\n+++ b/src/prefect/_internal/concurrency/services.py\n@@ -27,6 +27,11 @@\n # Track all active services for fork handling\n _active_services: weakref.WeakSet[_QueueServiceBase[Any]] = weakref.WeakSet()\n \n+# Services take items that are already queued without leaving the event loop.\n+# Other services share the global loop, so a service working through a backlog\n+# yields to them after this many items in a row.\n+_READY_ITEMS_PER_YIELD = 256\n+\n \n def _reset_services_after_fork():\n     \"\"\"\n@@ -73,6 +78,7 @@ def __init__(self, *args: Hashable) -> None:\n         self._started: bool = False\n         self._key = hash((self.__class__, *args))\n         self._lock = threading.Lock()\n+        self._ready_items_since_yield = 0\n         self._queue_get_thread = WorkerThread(\n             # TODO: This thread should not need to be a daemon but when it is not, it\n             #       can prevent the interpreter from exiting.\n@@ -184,14 +190,37 @@ async def _run(self) -> None:\n             assert self._done_event is not None\n             self._done_event.set()\n \n+    async def _get_item(self, timeout: Optional[float] = None) -> Optional[T]:\n+        \"\"\"\n+        Take the next item from the queue.\n+\n+        An item that is already queued is taken on the event loop. Only an empty\n+        queue waits on the queue thread, which raises `queue.Empty` if `timeout`\n+        passes first.\n+        \"\"\"\n+        if self._ready_items_since_yield >= _READY_ITEMS_PER_YIELD:\n+            self._ready_items_since_yield = 0\n+            await asyncio.sleep(0)\n+\n+        try:\n+            item = self._queue.get_nowait()\n+        except queue.Empty:\n+            pass\n+        else:\n+            self._ready_items_since_yield += 1\n+            return item\n+\n+        self._ready_items_since_yield = 0\n+        return await self._queue_get_thread.submit(\n+            create_call(self._queue.get, timeout=timeout)\n+        ).aresult()\n+\n     async def _main_loop(self) -> None:\n         last_log_time = 0\n         log_interval = 4  # log every 4 seconds\n \n         while True:\n-            item: Optional[T] = await self._queue_get_thread.submit(\n-                create_call(self._queue.get)\n-            ).aresult()\n+            item: Optional[T] = await self._get_item()\n \n             if self._stopped:\n                 current_time = asyncio.get_event_loop().time()\n@@ -500,9 +529,7 @@ async def _main_loop(self):\n             deadline = get_deadline(self.min_interval)\n             while batch_size < self.max_batch_size:\n                 try:\n-                    item = await self._queue_get_thread.submit(\n-                        create_call(self._queue.get, timeout=get_timeout(deadline))\n-                    ).aresult()\n+                    item = await self._get_item(timeout=get_timeout(deadline))\n \n                     if item is None:\n                         done = True\ndiff --git a/src/prefect/logging/AGENTS.md b/src/prefect/logging/AGENTS.md\nindex 49a189660504..b050d0fae278 100644\n--- a/src/prefect/logging/AGENTS.md\n+++ b/src/prefect/logging/AGENTS.md\n@@ -41,7 +41,8 @@ Key invariants:\n \n `APILogWorker` is a **singleton per unique settings tuple** `(BATCH_SIZE, API_URL, MAX_LOG_SIZE)`. A new settings combination creates a new worker instance.\n \n-- `max_batch_size = max(BATCH_SIZE - MAX_LOG_SIZE, MAX_LOG_SIZE)` \u2014 defensive: ensures a single max-size log can always fit\n+- `max_batch_size = max(BATCH_SIZE - MAX_LOG_SIZE - 1, 1)` \u2014 a batch stops taking logs at this size, which leaves room for one more max-size log and the request body's opening bracket. Requests stay within `BATCH_SIZE` whenever `BATCH_SIZE >= MAX_LOG_SIZE + 2`; below that, each request holds one log.\n+- `APILogWorker.send()` serializes each log dict to compact JSON (orjson) right away, dropping the `__payload_size__` key that `prepare()` adds. The queue holds only those bytes, and `_handle_batch` posts them joined, without serializing again. Changes to a dict after `send()` are not sent. Process-pool workers still forward dicts through `_api_log_sink`; the parent serializes them when it calls `send()`.\n - `APILogHandler.prepare()` truncates oversized logs with a buffer; `WorkerAPILogHandler.prepare()` raises `ValueError` instead (no truncation)\n \n **Flush deadlock guard:** `APILogHandler.flush()` detects if called from within an event loop and avoids blocking via `from_sync.call_soon_in_new_thread()`. Do not call `flush()` synchronously from async code without this guard.\ndiff --git a/src/prefect/logging/handlers.py b/src/prefect/logging/handlers.py\nindex 842cf6127bc4..a217002ccc99 100644\n--- a/src/prefect/logging/handlers.py\n+++ b/src/prefect/logging/handlers.py\n@@ -1,7 +1,6 @@\n from __future__ import annotations\n \n import inspect\n-import json\n import logging\n import sys\n import time\n@@ -11,6 +10,7 @@\n from contextlib import asynccontextmanager\n from typing import TYPE_CHECKING, Any, Callable, Dict, TextIO, Type, cast\n \n+import orjson\n from rich.console import Console\n from rich.highlighter import Highlighter, NullHighlighter\n from rich.theme import Theme\n@@ -64,22 +64,51 @@ def emit_api_log(log: Dict[str, Any]) -> None:\n     APILogWorker.instance().send(log)\n \n \n-class APILogWorker(BatchedQueueService[Dict[str, Any]]):\n+class APILogWorker(BatchedQueueService[bytes]):\n     @property\n     def max_batch_size(self) -> int:\n+        # A batch takes logs until it reaches this size, and the last log it takes\n+        # can be a maximum size log. Leave room for that log and for the opening\n+        # bracket of the request body, so the request fits in the configured\n+        # batch size. A batch always takes at least one log.\n         return max(\n             PREFECT_LOGGING_TO_API_BATCH_SIZE.value()\n-            - PREFECT_LOGGING_TO_API_MAX_LOG_SIZE.value(),\n-            PREFECT_LOGGING_TO_API_MAX_LOG_SIZE.value(),\n+            - PREFECT_LOGGING_TO_API_MAX_LOG_SIZE.value()\n+            - 1,\n+            1,\n         )\n \n     @property\n     def min_interval(self) -> float | None:\n         return PREFECT_LOGGING_TO_API_BATCH_INTERVAL.value()\n \n-    async def _handle_batch(self, items: list[dict[str, Any]]):\n+    def send(self, item: Dict[str, Any] | bytes) -> None:\n+        \"\"\"\n+        Queue a log to send to the API.\n+\n+        Accepts a `LogCreate`-compatible dict, such as one returned by\n+        `APILogHandler.prepare`, or its serialized JSON. Logs are queued as JSON\n+        so each one is held once and is not serialized again when its batch is\n+        sent.\n+        \"\"\"\n+        if isinstance(item, dict):\n+            payload = orjson.dumps(\n+                {key: value for key, value in item.items() if key != \"__payload_size__\"}\n+            )\n+            # orjson output can take far more memory than its length, about 1 KiB\n+            # for a short log. Copy it so a backlog of queued logs holds only the\n+            # JSON.\n+            item = memoryview(payload).tobytes()\n+        super().send(item)\n+\n+    async def _handle_batch(self, items: list[bytes]):\n         try:\n-            await self._client.create_logs(items)\n+            await self._client.request(\n+                \"POST\",\n+                \"/logs/\",\n+                content=b\"[\" + b\",\".join(items) + b\"]\",\n+                headers={\"Content-Type\": \"application/json\"},\n+            )\n         except Exception as e:\n             # Roughly replicate the behavior of the stdlib logger error handling\n             if logging.raiseExceptions and sys.stderr:\n@@ -106,8 +135,10 @@ def instance(cls: Type[Self], *args: Any) -> Self:\n         # Ensure a unique worker is retrieved per relevant logging settings\n         return super().instance(*settings, *args)\n \n-    def _get_size(self, item: Dict[str, Any]) -> int:\n-        return item.pop(\"__payload_size__\", None) or len(json.dumps(item).encode())\n+    def _get_size(self, item: bytes) -> int:\n+        # Count the comma or closing bracket that follows each log in the request\n+        # body, so a full batch stays within the configured batch size\n+        return len(item) + 1\n \n \n class APILogHandler(logging.Handler):\n@@ -286,7 +317,7 @@ def prepare(self, record: logging.LogRecord) -> Dict[str, Any]:\n         return log\n \n     def _get_payload_size(self, log: Dict[str, Any]) -> int:\n-        return len(json.dumps(log).encode())\n+        return len(orjson.dumps(log))\n \n \n class WorkerAPILogHandler(APILogHandler):\n", "test_patch": "diff --git a/tests/_internal/concurrency/test_services.py b/tests/_internal/concurrency/test_services.py\nindex c0b7a8067ec3..4c81d98ada98 100644\n--- a/tests/_internal/concurrency/test_services.py\n+++ b/tests/_internal/concurrency/test_services.py\n@@ -56,6 +56,50 @@ async def _handle_batch(self, items: List[int]):\n         print(f\"Handled batch for {self}\")\n \n \n+class _BacklogMixin:\n+    \"\"\"\n+    Holds items in the queue until `release` is set, so a backlog builds up, then\n+    handles them without suspending.\n+    \"\"\"\n+\n+    release: threading.Event\n+    handled: List[int]\n+    # The queue size when other work on the event loop first got to run\n+    queue_sizes_seen_by_other_work: List[int]\n+\n+    @contextlib.asynccontextmanager\n+    async def _lifespan(self):\n+        await asyncio.to_thread(self.release.wait)\n+        # Runs the first time the service lets the event loop do other work\n+        asyncio.get_running_loop().call_soon(\n+            lambda: self.queue_sizes_seen_by_other_work.append(self._queue.qsize())\n+        )\n+        yield\n+\n+\n+class BacklogService(_BacklogMixin, QueueService[int]):\n+    async def _handle(self, item: int):\n+        self.handled.append(item)\n+\n+\n+class BatchedBacklogService(_BacklogMixin, BatchedQueueService[int]):\n+    _max_batch_size = 10_000\n+\n+    async def _handle_batch(self, items: List[int]):\n+        self.handled.extend(items)\n+\n+\n+@pytest.fixture(params=[BacklogService, BatchedBacklogService])\n+def backlog_service_type(request: pytest.FixtureRequest):\n+    service_type = request.param\n+    service_type.release = threading.Event()\n+    service_type.handled = []\n+    service_type.queue_sizes_seen_by_other_work = []\n+    yield service_type\n+    service_type.release.set()\n+    service_type.drain_all()\n+\n+\n @pytest.fixture(autouse=True)\n def reset_mock_services():\n     yield\n@@ -553,6 +597,40 @@ class IntervalMockBatchedService(MockBatchedService):\n     )\n \n \n+def test_queued_items_are_taken_without_waiting_on_queue_thread(\n+    backlog_service_type: type[BacklogService] | type[BatchedBacklogService],\n+    monkeypatch: pytest.MonkeyPatch,\n+):\n+    instance = backlog_service_type.instance()\n+    queue_thread_submit = MagicMock(wraps=instance._queue_get_thread.submit)\n+    monkeypatch.setattr(instance._queue_get_thread, \"submit\", queue_thread_submit)\n+\n+    for i in range(1000):\n+        instance.send(i)\n+    backlog_service_type.release.set()\n+    instance.drain()\n+\n+    assert backlog_service_type.handled == list(range(1000))\n+    # At most one wait for the stop signal, if it arrived after the backlog was\n+    # taken\n+    assert queue_thread_submit.call_count <= 1\n+\n+\n+def test_service_working_through_backlog_lets_other_work_run(\n+    backlog_service_type: type[BacklogService] | type[BatchedBacklogService],\n+):\n+    instance = backlog_service_type.instance()\n+\n+    for i in range(5000):\n+        instance.send(i)\n+    backlog_service_type.release.set()\n+    instance.drain()\n+\n+    assert backlog_service_type.handled == list(range(5000))\n+    # Other work on the global loop ran while most of the backlog was still queued\n+    assert backlog_service_type.queue_sizes_seen_by_other_work[0] > 4000\n+\n+\n def test_on_item_dropped_called_when_queue_full():\n     \"\"\"When the queue is full, _on_item_dropped is called with the prepared item.\"\"\"\n     dropped_items: list[str] = []\ndiff --git a/tests/test_logging.py b/tests/test_logging.py\nindex dcb4d067147f..7fadd6694e42 100644\n--- a/tests/test_logging.py\n+++ b/tests/test_logging.py\n@@ -15,9 +15,11 @@\n from pathlib import Path\n from typing import TYPE_CHECKING, Any, Callable, Generator\n from unittest import mock\n-from unittest.mock import ANY, AsyncMock, MagicMock, patch\n+from unittest.mock import ANY, MagicMock, patch\n \n+import httpx\n import pytest\n+import respx\n from rich.color import Color, ColorType\n from rich.console import Console\n from rich.highlighter import NullHighlighter, ReprHighlighter\n@@ -936,6 +938,40 @@ async def test_does_not_enqueue_logs_that_are_too_big(\n         assert sent_log[\"message\"].endswith(\"... [truncated]\")\n         assert \"ValueError\" not in output.err\n \n+    @pytest.mark.parametrize(\n+        \"character\", [\"X\", \"\u00e9\", \"\ud83e\udd86\"], ids=[\"one-byte\", \"two-byte\", \"four-byte\"]\n+    )\n+    async def test_oversized_logs_are_truncated_to_fit_max_log_size(\n+        self,\n+        logger: logging.Logger,\n+        handler: APILogHandler,\n+        flow_run: \"FlowRun\",\n+        respx_mock: respx.MockRouter,\n+        character: str,\n+    ):\n+        create_logs = respx_mock.post(path__regex=r\"/logs/$\").pass_through()\n+        respx_mock.route().pass_through()\n+        max_log_size = 1_000\n+\n+        with temporary_settings(\n+            updates={PREFECT_LOGGING_TO_API_MAX_LOG_SIZE: max_log_size}\n+        ):\n+            logger.info(character * max_log_size, extra={\"flow_run_id\": flow_run.id})\n+            await handler.aflush()\n+\n+        sent_logs = [\n+            log\n+            for call in create_logs.calls\n+            for log in json.loads(call.request.content)\n+            if log[\"flow_run_id\"] == str(flow_run.id)\n+        ]\n+        assert len(sent_logs) == 1\n+        assert sent_logs[0][\"message\"].endswith(\"... [truncated]\")\n+        sent_size = len(\n+            json.dumps(sent_logs[0], separators=(\",\", \":\"), ensure_ascii=False).encode()\n+        )\n+        assert sent_size <= max_log_size\n+\n     def test_handler_knows_how_large_logs_are(self):\n         dict_log = {\n             \"name\": \"prefect.flow_runs\",\n@@ -946,8 +982,9 @@ def test_handler_knows_how_large_logs_are(self):\n             \"task_run_id\": None,\n         }\n \n-        log_size = len(json.dumps(dict_log))\n-        assert log_size == 211\n+        # Logs are sent to the API as compact JSON\n+        log_size = len(json.dumps(dict_log, separators=(\",\", \":\")).encode())\n+        assert log_size == 200\n         handler = APILogHandler()\n         assert handler._get_payload_size(dict_log) == log_size  # type: ignore[reportPrivateUsage]\n \n@@ -1202,44 +1239,91 @@ async def test_send_logs_writes_exceptions_to_stderr(\n         self,\n         log_dict: dict[str, Any],\n         capsys: pytest.CaptureFixture[str],\n-        monkeypatch: pytest.MonkeyPatch,\n+        respx_mock: respx.MockRouter,\n         worker: APILogWorker,\n     ):\n-        monkeypatch.setattr(\n-            \"prefect.client.orchestration.PrefectClient.create_logs\",\n-            MagicMock(side_effect=ValueError(\"Test\")),\n+        respx_mock.post(path__regex=r\"/logs/$\").mock(\n+            return_value=httpx.Response(400, json={\"detail\": \"Test\"})\n         )\n+        respx_mock.route().pass_through()\n \n         worker.send(log_dict)\n         await worker.drain()\n \n         err = capsys.readouterr().err\n         assert \"--- Error logging to API ---\" in err\n-        assert \"ValueError: Test\" in err\n+        assert \"400 Bad Request\" in err\n \n     async def test_send_logs_batches_by_size(\n-        self, log_dict: dict[str, Any], monkeypatch: pytest.MonkeyPatch\n+        self,\n+        log_dict: dict[str, Any],\n+        respx_mock: respx.MockRouter,\n+        prefect_client: PrefectClient,\n     ):\n-        mock_create_logs = AsyncMock()\n-        monkeypatch.setattr(\n-            \"prefect.client.orchestration.PrefectClient.create_logs\", mock_create_logs\n-        )\n+        create_logs = respx_mock.post(path__regex=r\"/logs/$\").pass_through()\n+        respx_mock.route().pass_through()\n \n-        log_size = APILogHandler()._get_payload_size(log_dict)\n+        logs_to_send = [{**log_dict, \"message\": str(i)} for i in range(5)]\n+        log_size = len(json.dumps(logs_to_send[0], separators=(\",\", \":\")).encode())\n+        # Room for two logs per request, after leaving room for a maximum size log\n+        batch_size = 3 * (log_size + 1)\n \n         with temporary_settings(\n             updates={\n-                PREFECT_LOGGING_TO_API_BATCH_SIZE: log_size + 1,\n-                PREFECT_LOGGING_TO_API_MAX_LOG_SIZE: log_size,\n+                PREFECT_LOGGING_TO_API_BATCH_SIZE: batch_size,\n+                PREFECT_LOGGING_TO_API_MAX_LOG_SIZE: log_size + 1,\n             }\n         ):\n             worker = APILogWorker.instance()\n-            worker.send(log_dict)\n-            worker.send(log_dict)\n-            worker.send(log_dict)\n+            for log in logs_to_send:\n+                worker.send(log)\n             await worker.drain()\n \n-        assert mock_create_logs.call_count == 3\n+        bodies = [call.request.content for call in create_logs.calls]\n+        assert [len(json.loads(body)) for body in bodies] == [2, 2, 1]\n+        assert all(len(body) <= batch_size for body in bodies)\n+\n+        log_filter = LogFilter(\n+            flow_run_id=LogFilterFlowRunId(any_=[uuid.UUID(log_dict[\"flow_run_id\"])])\n+        )\n+        logs = await prefect_client.read_logs(log_filter=log_filter)\n+        assert sorted(log.message for log in logs) == [\"0\", \"1\", \"2\", \"3\", \"4\"]\n+\n+    @pytest.mark.parametrize(\n+        \"batch_size\",\n+        [300, 200, 102],\n+        ids=[\"three-max-logs\", \"two-max-logs\", \"one-max-log-and-brackets\"],\n+    )\n+    async def test_batch_ending_in_max_size_log_fits_in_batch_size(\n+        self, respx_mock: respx.MockRouter, batch_size: int\n+    ):\n+        create_logs = respx_mock.post(path__regex=r\"/logs/$\").mock(\n+            return_value=httpx.Response(201)\n+        )\n+        respx_mock.route().pass_through()\n+        max_log_size = 100\n+\n+        def serialized_log(size: int) -> bytes:\n+            # A JSON string of exactly `size` bytes\n+            return b'\"' + b\"x\" * (size - 2) + b'\"'\n+\n+        with temporary_settings(\n+            updates={\n+                PREFECT_LOGGING_TO_API_BATCH_SIZE: batch_size,\n+                PREFECT_LOGGING_TO_API_MAX_LOG_SIZE: max_log_size,\n+            }\n+        ):\n+            # Fill a batch to each size near the point where it stops taking logs,\n+            # then send a maximum size log\n+            for last_filler_size in range(90, max_log_size + 1):\n+                worker = APILogWorker.instance()\n+                worker.send(serialized_log(98))\n+                worker.send(serialized_log(last_filler_size))\n+                worker.send(serialized_log(max_log_size))\n+                await worker.drain()\n+\n+        body_sizes = [len(call.request.content) for call in create_logs.calls]\n+        assert max(body_sizes) <= batch_size\n \n     async def test_logs_are_sent_immediately_when_stopped(\n         self, log_dict: dict[str, Any], prefect_client: PrefectClient\n@@ -1286,20 +1370,45 @@ async def test_logs_are_sent_immediately_when_flushed(\n         assert len(logs) == 2\n \n     async def test_logs_include_worker_id_if_available(\n-        self, worker: APILogWorker, log_dict: dict[str, Any]\n+        self,\n+        worker: APILogWorker,\n+        log_dict: dict[str, Any],\n+        respx_mock: respx.MockRouter,\n     ):\n         worker_id = str(uuid.uuid4())\n         log_dict[\"worker_id\"] = worker_id\n+        # Open source servers do not accept worker logs\n+        create_logs = respx_mock.post(path__regex=r\"/logs/$\").mock(\n+            return_value=httpx.Response(201)\n+        )\n+        respx_mock.route().pass_through()\n \n-        with mock.patch(\n-            \"prefect.client.orchestration.PrefectClient.create_logs\", autospec=True\n-        ) as mock_create_logs:\n-            worker.send(log_dict)\n-            await worker.drain()\n-            assert mock_create_logs.call_count == 1\n-            logs = mock_create_logs.call_args.args[1]\n-            assert len(logs) == 1\n-            assert logs[0][\"worker_id\"] == worker_id\n+        worker.send(log_dict)\n+        await worker.drain()\n+\n+        assert create_logs.call_count == 1\n+        logs = json.loads(create_logs.calls.last.request.content)\n+        assert len(logs) == 1\n+        assert logs[0][\"worker_id\"] == worker_id\n+\n+    async def test_send_does_not_send_payload_size(\n+        self,\n+        worker: APILogWorker,\n+        log_dict: dict[str, Any],\n+        prefect_client: PrefectClient,\n+    ):\n+        log_dict[\"__payload_size__\"] = 100\n+\n+        # The API rejects unknown fields, so the log is stored only if the size\n+        # recorded by `APILogHandler.prepare` is left out\n+        worker.send(log_dict)\n+        await worker.drain()\n+\n+        log_filter = LogFilter(\n+            flow_run_id=LogFilterFlowRunId(any_=[uuid.UUID(log_dict[\"flow_run_id\"])])\n+        )\n+        logs = await prefect_client.read_logs(log_filter=log_filter)\n+        assert len(logs) == 1\n \n \n def test_flow_run_logger(flow_run: \"FlowRun\"):\n", "problem_statement": "Sending events and API logs from a run uses more CPU than it needs to\n### Describe the current behavior\n\nA flow run that writes many logs or emits many events spends a lot of CPU in the background services that send them to the API. Against a local `prefect server start`, 20,000 run-logger lines cost 1.43 s of process CPU, and 5,000 `emit_event` calls cost 0.78 s. Both numbers are medians of 3 runs on macOS with Python 3.14.\n\nTwo things cause most of that cost:\n\n- `_QueueServiceBase._main_loop` and `BatchedQueueService._main_loop` in `src/prefect/_internal/concurrency/services.py` fetch every item by submitting `queue.get` to the service's queue thread and awaiting the result. Each item costs a round trip between threads, even when hundreds of items are already queued.\n- `APILogHandler._get_payload_size` runs `json.dumps` on every log only to measure its size. `APILogWorker` then queues the log as a dict, and httpx serializes the whole batch again when it sends the request.\n\n### Describe the proposed behavior\n\n- Queue services take an item directly when one is already queued, and wait on the queue thread only when the queue is empty. A service working through a backlog yields to the event loop at regular intervals, so other services on the global loop still run.\n- `APILogWorker` serializes each log with orjson when it is sent, queues only the bytes, and posts the joined bytes to `/logs/`. `APILogHandler` measures log size with orjson too.\n\nA prototype of these changes cut CPU by about 65% for logs and 45% for events, without raising peak memory. Every log and event still reached the server.\n\n### Example Use\n\nA flow that logs once per record in a loop, or uses `log_prints=True` around a library that prints a lot, or emits many custom events with `emit_event`. The delivery services run in the same process as the user's code, so the CPU they use is overhead on the user's workload.\n\n", "hints_text": "", "created_at": "2026-10-20T15:56:54Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23471, "instance_id": "PrefectHQ__prefect-23471", "issue_numbers": ["23470"], "base_commit": "817bc93b6e828459e6853fa8b51ddba52515ad16", "patch": "diff --git a/src/prefect/server/events/models/automations.py b/src/prefect/server/events/models/automations.py\nindex c23225d05520..3b1595eca988 100644\n--- a/src/prefect/server/events/models/automations.py\n+++ b/src/prefect/server/events/models/automations.py\n@@ -59,9 +59,13 @@ async def emit_automation_deleted_event(automation: Automation) -> None:\n @asynccontextmanager\n @db_injector\n async def automations_session(\n-    db: PrefectDBInterface, begin_transaction: bool = False\n+    db: PrefectDBInterface,\n+    begin_transaction: bool = False,\n+    with_for_update: bool = False,\n ) -> AsyncGenerator[AsyncSession, None]:\n-    async with db.session_context(begin_transaction=begin_transaction) as session:\n+    async with db.session_context(\n+        begin_transaction=begin_transaction, with_for_update=with_for_update\n+    ) as session:\n         yield session\n \n \ndiff --git a/src/prefect/server/events/triggers.py b/src/prefect/server/events/triggers.py\nindex dc6ff4a55a19..fdba65b8e274 100644\n--- a/src/prefect/server/events/triggers.py\n+++ b/src/prefect/server/events/triggers.py\n@@ -615,7 +615,13 @@ async def reactive_evaluation(event: ReceivedEvent, depth: int = 0) -> None:\n \n             bucketing_key = trigger.bucketing_key(event)\n \n-            async with automations_session(begin_transaction=True) as session:\n+            # `with_for_update=True` makes SQLite start with `BEGIN IMMEDIATE` so the\n+            # write lock is held before the bucket is read; a deferred transaction\n+            # that reads first cannot be upgraded to a write if another connection\n+            # commits in between and fails immediately with \"database is locked\".\n+            async with automations_session(\n+                begin_transaction=True, with_for_update=True\n+            ) as session:\n                 try:\n                     bucket: Optional[\"ORMAutomationBucket\"] = None\n \n", "test_patch": "diff --git a/tests/events/server/triggers/test_regressions.py b/tests/events/server/triggers/test_regressions.py\nindex 311c948e7228..98a7d913b174 100644\n--- a/tests/events/server/triggers/test_regressions.py\n+++ b/tests/events/server/triggers/test_regressions.py\n@@ -978,3 +978,66 @@ async def test_same_event_in_expect_and_after_proactively_fires_with_for_each_th\n                     id=uuid4(),\n                 ).receive()\n             )\n+\n+\n+@pytest.fixture\n+async def counting_after_automation(\n+    cleared_buckets: None,\n+    cleared_automations: None,\n+    automations_session: AsyncSession,\n+) -> Automation:\n+    automation = await automations.create_automation(\n+        automations_session,\n+        Automation(\n+            name=\"Counts expected events after a starting event\",\n+            trigger=EventTrigger(\n+                after={\"start-event\"},\n+                expect={\"counted-event\"},\n+                posture=Posture.Reactive,\n+                threshold=1000,\n+                within=timedelta(hours=1),\n+            ),\n+            actions=[actions.DoNothing()],\n+        ),\n+    )\n+    triggers.load_automation(automation)\n+    await automations_session.commit()\n+    return automation\n+\n+\n+async def test_concurrent_bucket_updates_count_each_event_once(\n+    act: mock.AsyncMock,\n+    start_of_test: DateTime,\n+    counting_after_automation: Automation,\n+    automations_session: AsyncSession,\n+):\n+    \"\"\"Regression test for https://github.com/PrefectHQ/prefect/issues/23470, where\n+    concurrent events reading and then updating the same bucket failed on SQLite with\n+    \"database is locked\".\"\"\"\n+    await triggers.reactive_evaluation(\n+        Event(\n+            occurred=start_of_test,\n+            event=\"start-event\",\n+            resource={\"prefect.resource.id\": \"some.resource\"},\n+            id=uuid4(),\n+        ).receive()\n+    )\n+\n+    events = [\n+        Event(\n+            occurred=start_of_test + timedelta(milliseconds=i + 1),\n+            event=\"counted-event\",\n+            resource={\"prefect.resource.id\": \"some.resource\"},\n+            id=uuid4(),\n+        ).receive()\n+        for i in range(25)\n+    ]\n+\n+    await asyncio.gather(*[triggers.reactive_evaluation(event) for event in events])\n+\n+    bucket = await triggers.read_bucket(\n+        automations_session, counting_after_automation.trigger, ()\n+    )\n+    assert bucket\n+    assert bucket.count == len(events)\n+    act.assert_not_awaited()\n", "problem_statement": "SQLite lock errors while updating automation buckets during event processing\n## Bug summary\n\nA self-hosted Prefect server using SQLite can fail while processing an event that updates an `automation_bucket` row:\n\n```\nsqlite3.OperationalError: database is locked\n```\n\nThis has been observed under concurrent database writes with SQLite in WAL mode. The failure occurs in the event-processing path while evaluating an automation trigger and upserting its bucket state.\n\n## Expected behavior\n\nThe event is processed successfully, or the operation is retried safely without losing the event or applying its bucket update more than once.\n\n## Actual behavior\n\nThe bucket upsert fails with a SQLite lock error. The event consumer retries failed messages, but repeated failures can send a message to the dead-letter queue, so an event-triggered automation may not run.\n\n## Suspected cause\n\nIn Prefect 3.8.8, `automations_session` forwards `begin_transaction` to the database session but does not expose `with_for_update`. With SQLite, a deferred transaction that reads bucket state before writing it can fail when another transaction commits in between.\n\n## Request\n\nPlease investigate a SQLite-safe fix for the automation bucket read/update path. Possible approaches include acquiring the write transaction before reading bucket state (for example, using the existing `with_for_update` / `BEGIN IMMEDIATE` mechanism where appropriate) or retrying the entire transaction with bounded backoff on `SQLITE_BUSY_SNAPSHOT`.\n\nPlease add a regression test that exercises concurrent bucket updates and verifies that events are neither lost nor double-counted.\n\n## Environment\n\n- Prefect 3.8.8\n- Self-hosted server\n- SQLite with WAL mode\n", "hints_text": "", "created_at": "2026-10-20T14:17:44Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23464, "instance_id": "PrefectHQ__prefect-23464", "issue_numbers": ["23463"], "base_commit": "71d1906204dfca1bd2dff36b57bcfc46dd7a2dd8", "patch": "diff --git a/src/prefect/_internal/concurrency/services.py b/src/prefect/_internal/concurrency/services.py\nindex e75ebf73ff9e..585cb2107cc1 100644\n--- a/src/prefect/_internal/concurrency/services.py\n+++ b/src/prefect/_internal/concurrency/services.py\n@@ -242,8 +242,9 @@ def _drain(self, at_exit: bool = False) -> concurrent.futures.Future[bool]:\n \n         self._stop(at_exit=at_exit)\n \n-        assert self._done_event is not None\n-        if self._done_event.is_set():\n+        # `_done_event` is unset if the service never started in this process, e.g.\n+        # in a child process after `reset_for_fork`\n+        if self._done_event is None or self._done_event.is_set():\n             future: concurrent.futures.Future[bool] = concurrent.futures.Future()\n             future.set_result(False)\n             return future\n", "test_patch": "diff --git a/tests/_internal/concurrency/test_services.py b/tests/_internal/concurrency/test_services.py\nindex c0b7a8067ec3..c40b30afa066 100644\n--- a/tests/_internal/concurrency/test_services.py\n+++ b/tests/_internal/concurrency/test_services.py\n@@ -1,5 +1,6 @@\n import asyncio\n import contextlib\n+import multiprocessing\n import threading\n import time\n from concurrent.futures import ThreadPoolExecutor\n@@ -280,6 +281,35 @@ class ForkedService(MockService):\n     instance.mock.assert_called_once_with(instance, 1)\n \n \n+def test_drain_after_reset_for_fork_does_not_error():\n+    instance = MockService.instance()\n+    instance.send(1)\n+    instance.drain()\n+\n+    # Simulates the state of an inherited service in a forked child process\n+    instance.reset_for_fork()\n+\n+    assert instance.drain(at_exit=True) is False\n+\n+\n+@pytest.mark.skipif(\n+    \"fork\" not in multiprocessing.get_all_start_methods(),\n+    reason=\"Requires the fork start method\",\n+)\n+def test_forked_child_exits_cleanly_with_running_service():\n+    instance = MockService.instance()\n+    instance.send(1)\n+\n+    try:\n+        process = multiprocessing.get_context(\"fork\").Process(target=int)\n+        process.start()\n+        process.join(timeout=10)\n+\n+        assert process.exitcode == 0\n+    finally:\n+        instance.drain()\n+\n+\n def test_send_one():\n     instance = MockService.instance()\n     instance.send(1)\ndiff --git a/tests/testing/test_utilites.py b/tests/testing/test_utilites.py\nindex be0078e2de29..6272f0b54bae 100644\n--- a/tests/testing/test_utilites.py\n+++ b/tests/testing/test_utilites.py\n@@ -26,14 +26,6 @@ def _multiprocessing_worker():\n     \"\"\"\n     Worker function for multiprocessing test. Must be at module level for pickling.\n     \"\"\"\n-    import os\n-\n-    # os._exit() is required here despite the underscore prefix. On Linux with fork(),\n-    # the child process inherits Prefect's logging/event state. Normal exit (return or\n-    # sys.exit) triggers Python cleanup that fails with this inherited state, causing\n-    # exitcode=1. os._exit() bypasses cleanup and is documented for use \"in the child\n-    # process after os.fork()\" - which is exactly this scenario.\n-    os._exit(0)\n \n \n def _api_url_without_settings_context() -> str:\n", "problem_statement": "Forked child processes exit with code 1: QueueService at-exit drain asserts after reset_for_fork\n### Bug summary\n\nA process forked after a Prefect `QueueService` has started (for example the events or log workers inside a flow run) always exits with code 1, even when its target returns normally.\n\n`QueueService.start()` registers `self._at_exit` with `threading._register_atexit`. Prefect's fork hook `_reset_services_after_fork` \u2192 `reset_for_fork()` sets `_done_event = None` in the child but leaves that at-exit callback registered. When the child exits, `multiprocessing`'s `_bootstrap` runs `threading._shutdown()`, which calls `_at_exit` \u2192 `drain(at_exit=True)` \u2192 `_drain`, and `_drain` fails `assert self._done_event is not None`. The `AssertionError` is raised inside `_bootstrap`'s `finally`, so nothing is printed and `popen_fork` exits the child with its default code of 1.\n\nMinimal reproduction (no flow, no server needed):\n\n```python\nimport multiprocessing as mp\n\nfrom prefect._internal.concurrency.services import QueueService\n\n\nclass Noop(QueueService[int]):\n    async def _handle(self, item: int) -> None:\n        pass\n\n\nNoop.instance().send(1)  # starts the service on Prefect's global loop thread\np = mp.get_context(\"fork\").Process(target=int)\np.start()\np.join()\nprint(\"child exitcode\", p.exitcode)  # 1 (expected 0)\nNoop.drain_all()\n```\n\nRemoving the service's partial from `threading._threading_atexits` in an `os.register_at_fork(after_in_child=...)` hook makes the child exit 0.\n\n### Version info\n\n```Text\nVersion:              3.6.26\nAPI version:          0.8.4\nPython version:       3.12.3\nGit commit:           8ffec225\nBuilt:                Fri, Apr 10, 2026 04:36 PM\nOS/Arch:              linux/x86_64\nProfile:              ephemeral\nServer type:          server\nPydantic version:     2.13.0\n```\n\nAlso reproduced with the script above on Prefect 3.8.8 / Python 3.12.14 (`python:3.12-slim`, `pip install prefect==3.8.8`).\n\n### Additional context\n\nImpact: PyTorch `DataLoader` workers are forked processes. Inside a flow run, every worker exits 1 at shutdown. Libraries that check worker exit codes then fail the task, e.g. Ultralytics 8.4.180, whose `InfiniteDataLoader.close()` calls `_shutdown_workers()`, and torch's SIGCHLD handler raises `RuntimeError: DataLoader worker (pid N) exited unexpectedly with exit code 1`. The same training runs cleanly outside Prefect.\n\nPossible fixes: have `reset_for_fork()` unregister (or neutralize) the at-exit callback, or make `_drain()` return immediately when `_done_event is None` (the service never started in this process).\n\n", "hints_text": "", "created_at": "2026-10-19T20:42:05Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23459, "instance_id": "PrefectHQ__prefect-23459", "issue_numbers": ["23458"], "base_commit": "a44083290283b087173e9ec5533bba48ad9e66fd", "patch": "diff --git a/src/prefect/server/schemas/filters.py b/src/prefect/server/schemas/filters.py\nindex 5dccdaf39fc8..a94ea49959d6 100644\n--- a/src/prefect/server/schemas/filters.py\n+++ b/src/prefect/server/schemas/filters.py\n@@ -428,11 +428,11 @@ def _get_filter_list(\n         filters: list[sa.ColumnExpressionArgument[bool]] = []\n         if self.type is not None:\n             filter = self.type.as_sql_filter()\n-            if isinstance(filter, sa.BinaryExpression):\n+            if not isinstance(filter, sa.True_):\n                 filters.append(filter)\n         if self.name is not None:\n             filter = self.name.as_sql_filter()\n-            if isinstance(filter, sa.BinaryExpression):\n+            if not isinstance(filter, sa.True_):\n                 filters.append(filter)\n         return filters\n \n", "test_patch": "diff --git a/tests/server/models/test_flow_runs.py b/tests/server/models/test_flow_runs.py\nindex 8722e6af50d3..bde92cff3c1f 100644\n--- a/tests/server/models/test_flow_runs.py\n+++ b/tests/server/models/test_flow_runs.py\n@@ -587,6 +587,69 @@ async def test_read_flow_runs_filters_by_states_any(self, flow, session):\n         )\n         assert len(result) == 0\n \n+    async def test_read_flow_runs_filters_by_states_any_and_not_any(\n+        self, flow, session\n+    ):\n+        flow_run_1 = await models.flow_runs.create_flow_run(\n+            session=session,\n+            flow_run=schemas.core.FlowRun(\n+                flow_id=flow.id,\n+                state=schemas.states.Running(name=\"My Running State\"),\n+            ),\n+        )\n+        await models.flow_runs.create_flow_run(\n+            session=session,\n+            flow_run=schemas.core.FlowRun(\n+                flow_id=flow.id,\n+                state=schemas.states.Completed(name=\"My Completed State\"),\n+            ),\n+        )\n+        flow_run_3 = await models.flow_runs.create_flow_run(\n+            session=session,\n+            flow_run=schemas.core.FlowRun(\n+                flow_id=flow.id, state=schemas.states.Failed(name=\"RIP\")\n+            ),\n+        )\n+\n+        result = await models.flow_runs.read_flow_runs(\n+            session=session,\n+            flow_run_filter=schemas.filters.FlowRunFilter(\n+                state=dict(\n+                    type=schemas.filters.FlowRunFilterStateType(\n+                        any_=[\"RUNNING\", \"COMPLETED\"], not_any_=[\"COMPLETED\"]\n+                    )\n+                )\n+            ),\n+        )\n+        assert {res.id for res in result} == {flow_run_1.id}\n+\n+        result = await models.flow_runs.read_flow_runs(\n+            session=session,\n+            flow_run_filter=schemas.filters.FlowRunFilter(\n+                state=dict(\n+                    name=schemas.filters.FlowRunFilterStateName(\n+                        any_=[\"My Running State\", \"My Completed State\"],\n+                        not_any_=[\"My Completed State\"],\n+                    )\n+                )\n+            ),\n+        )\n+        assert {res.id for res in result} == {flow_run_1.id}\n+\n+        result = await models.flow_runs.read_flow_runs(\n+            session=session,\n+            flow_run_filter=schemas.filters.FlowRunFilter(\n+                state=dict(\n+                    operator=\"or_\",\n+                    type=schemas.filters.FlowRunFilterStateType(\n+                        any_=[\"RUNNING\", \"COMPLETED\"], not_any_=[\"COMPLETED\"]\n+                    ),\n+                    name=schemas.filters.FlowRunFilterStateName(any_=[\"RIP\"]),\n+                )\n+            ),\n+        )\n+        assert {res.id for res in result} == {flow_run_1.id, flow_run_3.id}\n+\n     async def test_read_flow_runs_filters_by_flow_versions_any(self, flow, session):\n         flow_run_1 = await models.flow_runs.create_flow_run(\n             session=session,\n", "problem_statement": "Flow run state filter ignores a type or name filter that sets both `any_` and `not_any_`\n### Bug summary\n\nA flow run state filter that sets both `any_` and `not_any_` on `state.type` (or on `state.name`) is ignored, so the server returns flow runs in the excluded state and in states that were not asked for.\n\n`FlowRunFilterStateType` and `FlowRunFilterStateName` accept both fields: `any_` is \"A list of flow run state types to include\" and `not_any_` is \"A list of flow run state types to exclude\". With one run Completed and one Failed, asking for `any_=[\"COMPLETED\", \"FAILED\"]` and `not_any_=[\"FAILED\"]` should return only the Completed run.\n\n```python\nimport asyncio\n\nfrom prefect import flow, get_client\nfrom prefect.client.schemas.filters import (\n    FlowRunFilter,\n    FlowRunFilterState,\n    FlowRunFilterStateName,\n    FlowRunFilterStateType,\n)\n\n\n@flow\ndef passes():\n    return 1\n\n\n@flow\ndef fails():\n    raise ValueError(\"example failure\")\n\n\nasync def main():\n    async with get_client() as client:\n        by_type = FlowRunFilter(\n            state=FlowRunFilterState(\n                type=FlowRunFilterStateType(\n                    any_=[\"COMPLETED\", \"FAILED\"], not_any_=[\"FAILED\"]\n                )\n            )\n        )\n        by_name = FlowRunFilter(\n            state=FlowRunFilterState(\n                name=FlowRunFilterStateName(\n                    any_=[\"Completed\", \"Failed\"], not_any_=[\"Failed\"]\n                )\n            )\n        )\n        for label, flow_run_filter in [(\"type\", by_type), (\"name\", by_name)]:\n            runs = await client.read_flow_runs(flow_run_filter=flow_run_filter)\n            print(label, sorted(run.state_name for run in runs))\n\n\npasses()\nfails(return_state=True)\nasyncio.run(main())\n```\n\nOutput:\n\n```\ntype ['Completed', 'Failed']\nname ['Completed', 'Failed']\n```\n\nExpected:\n\n```\ntype ['Completed']\nname ['Completed']\n```\n\nWith only `any_` or only `not_any_` the filter works. A `state.type` filter with `any_=[\"RUNNING\", \"COMPLETED\"]` and `not_any_=[\"COMPLETED\"]` also matched a Failed run that is in neither list, so the whole state criterion is dropped.\n\n### Version info\n\n```\nVersion:             3.8.9.dev6+10.g1c866f04d\nPython version:      3.12.14\nGit commit:          1c866f04\n```\n\nI reproduced this on commit 1c866f04d6268a56a02bdbc1f8aa4b1788c39f89, which the links below point to.\n\n### Additional context\n\n`FlowRunFilterState._get_filter_list` calls `as_sql_filter()` on its `type` and `name` parts and appends the result only if it is a `sqlalchemy.BinaryExpression`: https://github.com/PrefectHQ/prefect/blob/1c866f04d6268a56a02bdbc1f8aa4b1788c39f89/src/prefect/server/schemas/filters.py#L429-L436\n\nA part that sets both fields returns `sa.and_(in_, not_in)`, which is a `BooleanClauseList`, so it is skipped. A part with one field returns a single comparison, which passes. Before 3d9e9db81 this method extended its list with `self.type._get_filter_list()` and `self.name._get_filter_list()`, which kept both comparisons.\n\n`POST /flow_runs/bulk_delete` takes the same filter. With one Running and one Completed run, I sent it `{\"flow_runs\": {\"state\": {\"type\": {\"any_\": [\"RUNNING\", \"COMPLETED\"], \"not_any_\": [\"COMPLETED\"]}}}}` and it deleted both runs. Only the Running run matches the filter.\n\nI plan to open a pull request for this.\n\n", "hints_text": "", "created_at": "2026-10-19T16:48:55Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23457, "instance_id": "PrefectHQ__prefect-23457", "issue_numbers": ["22208"], "base_commit": "1c866f04d6268a56a02bdbc1f8aa4b1788c39f89", "patch": "diff --git a/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py b/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py\nindex 590026593bb0..900adb920847 100644\n--- a/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py\n+++ b/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py\n@@ -13,11 +13,19 @@\n from functools import wraps\n from typing import Any, cast\n \n+import aiohttp\n import anyio\n import kopf\n from cachetools import TTLCache\n from kubernetes_asyncio import config\n from kubernetes_asyncio.client import ApiClient, BatchV1Api, CoreV1Api, V1Job\n+from kubernetes_asyncio.client.exceptions import ApiException\n+from tenacity import (\n+    AsyncRetrying,\n+    RetryCallState,\n+    retry_if_exception,\n+    wait_exponential_jitter,\n+)\n \n from prefect import __version__, get_client\n from prefect.client.orchestration import PrefectClient\n@@ -152,12 +160,12 @@ def _discard_if_empty(self, uid: str, state: _PodLifecycleState) -> None:\n \n \n _pod_lifecycle_states = _PodLifecycleStates()\n-_POD_LIST_PAGE_SIZE = 500\n+_LIST_PAGE_SIZE = 500\n _POD_LIFECYCLE_RECONCILIATION_INTERVAL_SECONDS = 5 * 60\n \n \n-def _pod_label_filters() -> dict[str, Any]:\n-    \"\"\"Return the label filters shared by pod watching and reconciliation.\"\"\"\n+def _observed_label_filters() -> dict[str, Any]:\n+    \"\"\"Return the label filters shared by pod/job watching and reconciliation.\"\"\"\n     additional_label_filters = cast(\n         dict[str, str], settings.observer.additional_label_filters\n     )\n@@ -167,11 +175,11 @@ def _pod_label_filters() -> dict[str, Any]:\n     }\n \n \n-def _pod_label_selector() -> str:\n-    \"\"\"Render the pod observer's label filters for Kubernetes list calls.\"\"\"\n+def _observed_label_selector() -> str:\n+    \"\"\"Render the observer's label filters as a Kubernetes label selector.\"\"\"\n     return \",\".join(\n         key if value is kopf.PRESENT else f\"{key}={value}\"\n-        for key, value in sorted(_pod_label_filters().items())\n+        for key, value in sorted(_observed_label_filters().items())\n     )\n \n \n@@ -195,8 +203,8 @@ async def _reconcile_pod_lifecycle_states(logger: kopf.Logger) -> None:\n                 continue_token: str | None = None\n                 while True:\n                     list_kwargs: dict[str, Any] = {\n-                        \"label_selector\": _pod_label_selector(),\n-                        \"limit\": _POD_LIST_PAGE_SIZE,\n+                        \"label_selector\": _observed_label_selector(),\n+                        \"limit\": _LIST_PAGE_SIZE,\n                     }\n                     if continue_token:\n                         list_kwargs[\"_continue\"] = continue_token\n@@ -327,6 +335,12 @@ def _pod_phase_occurred(\n @kopf.on.startup()\n def configure(settings: kopf.OperatorSettings, **_):\n     settings.scanning.disabled = True\n+    # Filter server-side so Kubernetes never sends unrelated pods or jobs, and\n+    # page the initial LIST so large clusters don't produce one huge response.\n+    label_selector = _observed_label_selector()\n+    settings.watching.label_selectors[\"v1\", \"pods\"] = label_selector\n+    settings.watching.label_selectors[\"batch\", \"v1\", \"jobs\"] = label_selector\n+    settings.watching.chunk_size = _LIST_PAGE_SIZE\n \n \n @kopf.on.startup()\n@@ -645,7 +659,7 @@ async def _replicate_pod_event(  # pyright: ignore[reportUnusedFunction]\n if settings.observer.replicate_pod_events:\n     kopf.on.event(\n         \"pods\",\n-        labels=_pod_label_filters(),\n+        labels=_observed_label_filters(),\n     )(_replicate_pod_event)  # type: ignore\n \n \n@@ -930,14 +944,87 @@ async def _get_k8s_jobs(\n             await client.close()  # type: ignore\n \n \n+_JOB_LOOKUP_REQUEST_TIMEOUT = 30\n+_JOB_LOOKUP_RETRY_WAIT = wait_exponential_jitter(initial=1, max=60)\n+\n+\n+def _is_transient_job_lookup_error(exc: BaseException) -> bool:\n+    if isinstance(exc, ApiException):\n+        status = exc.status or 0\n+        return status in (408, 429) or (500 <= status < 600 and status != 501)\n+    return isinstance(exc, (aiohttp.ClientError, TimeoutError, ConnectionError))\n+\n+\n+async def _read_job_uid(name: str, namespace: str) -> str | None:\n+    \"\"\"Return the UID of the named job, or `None` if it doesn't exist.\"\"\"\n+    client = await _get_kubernetes_client()\n+    try:\n+        job = await BatchV1Api(client).read_namespaced_job(  # type: ignore\n+            name=name,\n+            namespace=namespace,\n+            _request_timeout=_JOB_LOOKUP_REQUEST_TIMEOUT,\n+        )\n+    except ApiException as e:\n+        if e.status == 404:\n+            return None\n+        raise\n+    finally:\n+        await client.close()  # type: ignore\n+    return job.metadata.uid  # type: ignore\n+\n+\n+async def _job_still_exists(\n+    name: str, namespace: str, uid: str | None, logger: kopf.Logger\n+) -> bool | None:\n+    \"\"\"Return whether the job behind a DELETED watch event still exists.\n+\n+    A server-side label selector reports a job whose labels stop matching as\n+    DELETED even though the job still exists. Only a missing job, or a new job\n+    with the same name, confirms the deletion. Kopf doesn't retry raw event\n+    handlers, so transient lookup failures are retried here until the lookup\n+    succeeds or the handler is cancelled. Returns `None` if the lookup fails\n+    permanently, since that proves neither existence nor absence.\n+    \"\"\"\n+\n+    def log_retry(retry_state: RetryCallState) -> None:\n+        assert retry_state.outcome is not None\n+        assert retry_state.next_action is not None\n+        logger.warning(\n+            f\"Failed to confirm deletion of job {name} (attempt\"\n+            f\" {retry_state.attempt_number}): {retry_state.outcome.exception()}.\"\n+            f\" Retrying in {retry_state.next_action.sleep:.0f}s.\"\n+        )\n+\n+    try:\n+        async for attempt in AsyncRetrying(\n+            retry=retry_if_exception(_is_transient_job_lookup_error),\n+            wait=_JOB_LOOKUP_RETRY_WAIT,\n+            before_sleep=log_retry,\n+            reraise=True,\n+        ):\n+            with attempt:\n+                current_uid = await _read_job_uid(name, namespace)\n+    except Exception as e:\n+        logger.warning(f\"Failed to confirm deletion of job {name}: {e}\")\n+        return None\n+    return current_uid is not None and current_uid == uid\n+\n+\n+def _flow_run_state_is_settled(state: State) -> bool:\n+    \"\"\"Return whether the observer should leave a flow run in `state` alone.\"\"\"\n+    return (\n+        state.is_final()\n+        or state.is_scheduled()\n+        or state.is_paused()\n+        or state.is_cancelling()\n+    )\n+\n+\n @kopf.on.event(\n     \"batch\",\n     \"v1\",\n     \"jobs\",\n-    labels={\n-        \"prefect.io/flow-run-id\": kopf.PRESENT,\n-        **settings.observer.additional_label_filters,\n-    },\n+    labels=_observed_label_filters(),\n )  # type: ignore\n async def _mark_flow_run_as_crashed(  # pyright: ignore[reportUnusedFunction]\n     event: kopf.RawEvent,\n@@ -986,15 +1073,33 @@ async def _mark_flow_run_as_crashed(  # pyright: ignore[reportUnusedFunction]\n \n     assert flow_run.state is not None, \"Expected flow run state to be set\"\n \n-    if (\n-        flow_run.state.is_final()\n-        or flow_run.state.is_scheduled()\n-        or flow_run.state.is_paused()\n-        or flow_run.state.is_cancelling()\n-    ):\n+    if _flow_run_state_is_settled(flow_run.state):\n         logger.debug(f\"Flow run {flow_run_id} is in {flow_run.state.name!r}, skipping\")\n         return\n \n+    uid = kwargs.get(\"uid\")\n+    if event[\"type\"] == \"DELETED\":\n+        job_exists = await _job_still_exists(name, kwargs[\"namespace\"], uid, logger)\n+        if job_exists is not False:\n+            if job_exists:\n+                logger.debug(f\"Job {name} still exists, skipping DELETED event\")\n+            return\n+\n+        # Lookup retries may have taken a while, so re-check the flow run.\n+        try:\n+            flow_run = await orchestration_client.read_flow_run(\n+                flow_run_id=uuid.UUID(flow_run_id)\n+            )\n+        except ObjectNotFound:\n+            logger.debug(f\"Flow run {flow_run_id} not found, skipping\")\n+            return\n+        assert flow_run.state is not None, \"Expected flow run state to be set\"\n+        if _flow_run_state_is_settled(flow_run.state):\n+            logger.debug(\n+                f\"Flow run {flow_run_id} is in {flow_run.state.name!r}, skipping\"\n+            )\n+            return\n+\n     # Eagerly fetch pod logs while the flow run is still in a pre-connectivity\n     # state (Pending / InfrastructurePending).  We capture them *before* the\n     # 30-second reschedule-wait loop below because cluster GC (e.g.\n@@ -1024,8 +1129,13 @@ async def _mark_flow_run_as_crashed(  # pyright: ignore[reportUnusedFunction]\n                 flow_run_id, namespace=kwargs[\"namespace\"], logger=logger\n             )\n \n-            # Filter out the current job from the list\n-            other_jobs = [job for job in k8s_jobs if job.metadata.name != name]  # type: ignore\n+            # Filter out the current job from the list. Compare by UID when\n+            # available, since a replacement job can reuse the same name.\n+            other_jobs = [\n+                job\n+                for job in k8s_jobs\n+                if (job.metadata.uid != uid if uid else job.metadata.name != name)  # type: ignore\n+            ]\n \n             # Check if any other job is completed or running\n             has_other_active_job = any(\ndiff --git a/src/integrations/prefect-kubernetes/pyproject.toml b/src/integrations/prefect-kubernetes/pyproject.toml\nindex aa776f5e3b63..c79cb95ffc37 100644\n--- a/src/integrations/prefect-kubernetes/pyproject.toml\n+++ b/src/integrations/prefect-kubernetes/pyproject.toml\n@@ -9,7 +9,7 @@ dependencies = [\n     \"tenacity>=8.2.3\",\n     \"exceptiongroup\",\n     \"pyopenssl>=24.1.0\",\n-    \"kopf>=1.37.4\",\n+    \"kopf>=1.45.1\",\n     \"python-json-logger>=3.3.0\",\n ]\n name = \"prefect-kubernetes\"\ndiff --git a/uv.lock b/uv.lock\nindex ddf904922b6d..5fdbbd8cddc2 100644\n--- a/uv.lock\n+++ b/uv.lock\n@@ -2142,18 +2142,19 @@ wheels = [\n \n [[package]]\n name = \"kopf\"\n-version = \"1.40.0\"\n+version = \"1.45.1\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"aiohttp\" },\n     { name = \"click\" },\n     { name = \"iso8601\" },\n+    { name = \"jsonpatch\" },\n     { name = \"python-json-logger\" },\n     { name = \"pyyaml\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/c0/10/bb40195b8a529a070b9cd7b295c9df5247efe912ceae7ad8bddf67905aa5/kopf-1.40.0.tar.gz\", hash = \"sha256:755f33ccb2619e0dede15a64e5f1f5da44e585f9f2afea7e127e9005cbc44d50\", size = 1194739, upload-time = \"2026-01-03T18:41:39.757Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/0d/95/9d9b62ae209eb49683a7375cd748bbff386e4c474a716976c5a97befea13/kopf-1.45.1.tar.gz\", hash = \"sha256:12ab33251a2d250ae59d415fede7bc6ca2a95267125dc7bd6ad8f29ed29fde4a\", size = 1277396, upload-time = \"2026-10-14T08:39:35.169Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/c2/d7/bc83004f59ae0c73ef91f00c03ce8967e2be1d8c3d5fa5dfa460f6ca3ce5/kopf-1.40.0-py3-none-any.whl\", hash = \"sha256:35d309da7ef84d6ea83d1638cbdf8dc392f7a9b513369aad3cc5367320219075\", size = 211116, upload-time = \"2026-01-03T18:41:37.726Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/6d/db/f9b88472004fcacd0abec945d5ff7b2844f170bb0d1b7f766b428388565d/kopf-1.45.1-py3-none-any.whl\", hash = \"sha256:7355b9ca1932303afc48fce3cd282472edcac3fed534d11c0db82d545fccb828\", size = 228888, upload-time = \"2026-10-14T08:39:33.381Z\" },\n ]\n \n [[package]]\n", "test_patch": "diff --git a/src/integrations/prefect-kubernetes/tests/test_observer.py b/src/integrations/prefect-kubernetes/tests/test_observer.py\nindex c296c76b72ee..befc5404a437 100644\n--- a/src/integrations/prefect-kubernetes/tests/test_observer.py\n+++ b/src/integrations/prefect-kubernetes/tests/test_observer.py\n@@ -1,14 +1,25 @@\n import asyncio\n+import json\n import logging\n import uuid\n-from collections.abc import Iterator\n+from collections.abc import AsyncIterator, Iterator\n from contextlib import asynccontextmanager\n from io import StringIO\n from time import sleep\n+from typing import Any, cast\n from unittest.mock import AsyncMock, MagicMock, call, patch\n \n+import aiohttp\n import anyio\n+import kopf\n import pytest\n+from aiohttp import web\n+from kopf._cogs.clients import auth as kopf_auth\n+from kopf._cogs.clients import fetching as kopf_fetching\n+from kopf._cogs.clients import watching as kopf_watching\n+from kopf._cogs.structs import credentials as kopf_credentials\n+from kubernetes_asyncio.client import V1Job, V1JobStatus, V1ObjectMeta\n+from kubernetes_asyncio.client.exceptions import ApiException\n from prefect_kubernetes import observer\n from prefect_kubernetes._logging import KopfObjectJsonFormatter\n from prefect_kubernetes.diagnostics import diagnose_k8s_pod\n@@ -23,6 +34,7 @@\n     start_observer,\n     stop_observer,\n )\n+from tenacity import wait_fixed, wait_none\n \n from prefect.client.schemas.objects import FlowRun, State\n from prefect.events.schemas.events import RelatedResource, Resource\n@@ -2394,6 +2406,32 @@ def base_kwargs(self, flow_run_id):\n             \"namespace\": \"default\",\n         }\n \n+    @pytest.fixture(autouse=True)\n+    def no_job_lookup_retry_wait(self, monkeypatch: pytest.MonkeyPatch) -> None:\n+        monkeypatch.setattr(observer, \"_JOB_LOOKUP_RETRY_WAIT\", wait_none())\n+\n+    @pytest.fixture\n+    def mock_k8s_client(self, monkeypatch: pytest.MonkeyPatch) -> AsyncMock:\n+        k8s_client = AsyncMock()\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_kubernetes_client\",\n+            AsyncMock(return_value=k8s_client),\n+        )\n+        return k8s_client\n+\n+    @pytest.fixture\n+    def mock_read_job(\n+        self, monkeypatch: pytest.MonkeyPatch, mock_k8s_client: AsyncMock\n+    ) -> AsyncMock:\n+        \"\"\"Stub the Kubernetes direct job lookup used to confirm deletions.\"\"\"\n+        batch_client = MagicMock()\n+        batch_client.read_namespaced_job = AsyncMock()\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer.BatchV1Api\",\n+            MagicMock(return_value=batch_client),\n+        )\n+        return batch_client.read_namespaced_job\n+\n     async def test_skips_paused_states(\n         self, mock_orchestration_client: AsyncMock, flow_run_id, base_kwargs\n     ):\n@@ -2451,6 +2489,7 @@ async def test_marks_run_crashed_when_job_deleted(\n         flow_run_id,\n         base_kwargs,\n         monkeypatch,\n+        mock_read_job: AsyncMock,\n     ):\n         \"\"\"A deleted job never retries, so nothing else would finalize the run.\"\"\"\n         mock_orchestration_client.read_flow_run.return_value = FlowRun(\n@@ -2462,6 +2501,7 @@ async def test_marks_run_crashed_when_job_deleted(\n         monkeypatch.setattr(\n             \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n         )\n+        mock_read_job.side_effect = ApiException(status=404)\n         mock_propose = AsyncMock()\n         monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n \n@@ -2469,12 +2509,398 @@ async def test_marks_run_crashed_when_job_deleted(\n             **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n         )\n \n+        # A bounded request timeout lets a hung lookup fail and be retried.\n+        mock_read_job.assert_awaited_once_with(\n+            name=\"test-job\",\n+            namespace=\"default\",\n+            _request_timeout=observer._JOB_LOOKUP_REQUEST_TIMEOUT,\n+        )\n         mock_propose.assert_called_once()\n         assert (\n             mock_propose.call_args.kwargs[\"state\"].message\n             == \"Kubernetes job was deleted\"\n         )\n \n+    async def test_marks_run_crashed_when_job_recreated_with_same_name(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+    ):\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n+        )\n+        mock_read_job.return_value = V1Job(\n+            metadata=V1ObjectMeta(name=\"test-job\", uid=\"replacement-uid\")\n+        )\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n+        )\n+\n+        mock_propose.assert_called_once()\n+\n+    @pytest.mark.parametrize(\n+        (\"keeps_flow_run_label\", \"current_team\"),\n+        [\n+            pytest.param(True, \"other\", id=\"equality-filter-changed\"),\n+            pytest.param(False, \"data\", id=\"flow-run-label-removed\"),\n+        ],\n+    )\n+    async def test_ignores_deleted_event_when_job_left_selector(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+        keeps_flow_run_label: bool,\n+        current_team: str,\n+    ):\n+        \"\"\"A label change that drops a job out of the server-side selector is\n+        reported as DELETED with the old labels, but the job still exists.\"\"\"\n+        monkeypatch.setattr(\n+            observer.settings.observer, \"additional_label_filters\", {\"team\": \"data\"}\n+        )\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        current_job_labels = {\"team\": current_team}\n+        if keeps_flow_run_label:\n+            current_job_labels[\"prefect.io/flow-run-id\"] = str(flow_run_id)\n+        still_active_job = V1Job(\n+            metadata=V1ObjectMeta(\n+                name=\"test-job\", uid=\"job-uid\", labels=current_job_labels\n+            ),\n+            status=V1JobStatus(active=1),\n+        )\n+        mock_read_job.return_value = still_active_job\n+        # Mirrors the flow-run-labeled LIST: it can't see a job whose flow run\n+        # label was removed, so it must not be used as proof of deletion.\n+        listed_jobs = [still_active_job] if keeps_flow_run_label else []\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\",\n+            AsyncMock(return_value=listed_jobs),\n+        )\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{\n+                **base_kwargs,\n+                \"event\": {\"type\": \"DELETED\"},\n+                \"labels\": {\"prefect.io/flow-run-id\": str(flow_run_id), \"team\": \"data\"},\n+                \"status\": {\"active\": 1},\n+                \"uid\": \"job-uid\",\n+            }\n+        )\n+\n+        mock_propose.assert_not_called()\n+\n+    @pytest.mark.parametrize(\n+        \"lookup_error\",\n+        [\n+            ApiException(status=403),\n+            ApiException(status=401),\n+            ApiException(status=422),\n+            ApiException(status=501),\n+            ValueError(\"bad kubeconfig\"),\n+        ],\n+        ids=[\n+            \"forbidden\",\n+            \"unauthorized\",\n+            \"unprocessable\",\n+            \"not-implemented\",\n+            \"unexpected-error\",\n+        ],\n+    )\n+    async def test_does_not_crash_run_when_deletion_cannot_be_confirmed(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+        mock_k8s_client: AsyncMock,\n+        lookup_error: Exception,\n+    ):\n+        \"\"\"Permanent lookup errors are neither retried nor treated as absence.\"\"\"\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n+        )\n+        mock_read_job.side_effect = lookup_error\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n+        )\n+\n+        mock_read_job.assert_awaited_once()\n+        mock_k8s_client.close.assert_awaited_once()\n+        mock_propose.assert_not_called()\n+\n+    @pytest.mark.parametrize(\n+        \"transient_error\",\n+        [\n+            ApiException(status=503),\n+            ApiException(status=429),\n+            ApiException(status=520),\n+            TimeoutError(),\n+            aiohttp.ClientConnectionError(\"connection reset\"),\n+        ],\n+        ids=[\n+            \"unavailable\",\n+            \"throttled\",\n+            \"unlisted-5xx\",\n+            \"timeout\",\n+            \"connection-error\",\n+        ],\n+    )\n+    async def test_retries_transient_lookup_failure_then_crashes_deleted_job(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+        mock_k8s_client: AsyncMock,\n+        transient_error: Exception,\n+    ):\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n+        )\n+        mock_read_job.side_effect = [transient_error, ApiException(status=404)]\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n+        )\n+\n+        assert mock_read_job.await_count == 2\n+        assert mock_k8s_client.close.await_count == 2\n+        mock_propose.assert_called_once()\n+        assert (\n+            mock_propose.call_args.kwargs[\"state\"].message\n+            == \"Kubernetes job was deleted\"\n+        )\n+\n+    async def test_same_name_replacement_job_prevents_crash(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+    ):\n+        \"\"\"A job recreated under the same name is a replacement, not the deleted job.\"\"\"\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        replacement_job = V1Job(\n+            metadata=V1ObjectMeta(name=\"test-job\", uid=\"new-uid\"),\n+            status=V1JobStatus(active=1),\n+        )\n+        mock_read_job.return_value = replacement_job\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\",\n+            AsyncMock(return_value=[replacement_job]),\n+        )\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{\n+                **base_kwargs,\n+                \"event\": {\"type\": \"DELETED\"},\n+                \"status\": {},\n+                \"uid\": \"old-uid\",\n+            }\n+        )\n+\n+        mock_propose.assert_not_called()\n+\n+    async def test_keeps_retrying_lookup_through_extended_outage(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+        mock_k8s_client: AsyncMock,\n+    ):\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n+        )\n+        outage = [ApiException(status=503)] * 50\n+        mock_read_job.side_effect = [*outage, ApiException(status=404)]\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n+        )\n+\n+        assert mock_read_job.await_count == 51\n+        assert mock_k8s_client.close.await_count == 51\n+        mock_propose.assert_called_once()\n+\n+    async def test_skips_deleted_event_when_same_job_found_after_transient_failure(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+    ):\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n+        )\n+        mock_read_job.side_effect = [\n+            TimeoutError(),\n+            V1Job(\n+                metadata=V1ObjectMeta(\n+                    name=\"test-job\", uid=\"job-uid\", labels={\"team\": \"other\"}\n+                ),\n+                status=V1JobStatus(active=1),\n+            ),\n+        ]\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{\n+                **base_kwargs,\n+                \"event\": {\"type\": \"DELETED\"},\n+                \"status\": {\"active\": 1},\n+                \"uid\": \"job-uid\",\n+            }\n+        )\n+\n+        assert mock_read_job.await_count == 2\n+        mock_propose.assert_not_called()\n+\n+    @pytest.mark.parametrize(\n+        \"state_after_recovery\",\n+        [\n+            State(type=\"CANCELLING\", name=\"Cancelling\"),\n+            State(type=\"COMPLETED\", name=\"Completed\"),\n+        ],\n+        ids=[\"cancelling\", \"completed\"],\n+    )\n+    async def test_rechecks_flow_run_state_after_lookup_recovers(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+        state_after_recovery: State,\n+    ):\n+        def flow_run_in(state: State) -> FlowRun:\n+            return FlowRun(\n+                id=flow_run_id, name=\"test-flow-run\", flow_id=uuid.uuid4(), state=state\n+            )\n+\n+        mock_orchestration_client.read_flow_run.side_effect = [\n+            flow_run_in(State(type=\"RUNNING\", name=\"Running\")),\n+            flow_run_in(state_after_recovery),\n+        ]\n+        monkeypatch.setattr(\n+            \"prefect_kubernetes.observer._get_k8s_jobs\", AsyncMock(return_value=[])\n+        )\n+        mock_read_job.side_effect = [ApiException(status=503), ApiException(status=404)]\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        await _mark_flow_run_as_crashed(\n+            **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n+        )\n+\n+        mock_propose.assert_not_called()\n+\n+    async def test_cancellation_interrupts_lookup_retry_wait(\n+        self,\n+        mock_orchestration_client: AsyncMock,\n+        flow_run_id,\n+        base_kwargs,\n+        monkeypatch,\n+        mock_read_job: AsyncMock,\n+        mock_k8s_client: AsyncMock,\n+    ):\n+        monkeypatch.setattr(observer, \"_JOB_LOOKUP_RETRY_WAIT\", wait_fixed(3600))\n+        mock_orchestration_client.read_flow_run.return_value = FlowRun(\n+            id=flow_run_id,\n+            name=\"test-flow-run\",\n+            flow_id=uuid.uuid4(),\n+            state=State(type=\"RUNNING\", name=\"Running\"),\n+        )\n+        lookup_failed = anyio.Event()\n+\n+        async def fail_lookup(**_: Any) -> V1Job:\n+            lookup_failed.set()\n+            raise TimeoutError()\n+\n+        mock_read_job.side_effect = fail_lookup\n+        mock_propose = AsyncMock()\n+        monkeypatch.setattr(\"prefect_kubernetes.observer.propose_state\", mock_propose)\n+\n+        handler = asyncio.create_task(\n+            _mark_flow_run_as_crashed(\n+                **{**base_kwargs, \"event\": {\"type\": \"DELETED\"}, \"status\": {}}\n+            )\n+        )\n+        with anyio.fail_after(5):\n+            await lookup_failed.wait()\n+            handler.cancel()\n+            with pytest.raises(asyncio.CancelledError):\n+                await handler\n+\n+        mock_read_job.assert_awaited_once()\n+        mock_k8s_client.close.assert_awaited_once()\n+        mock_propose.assert_not_called()\n+\n     async def test_skips_cancelling_run_when_job_deleted(\n         self,\n         mock_orchestration_client: AsyncMock,\n@@ -3583,3 +4009,178 @@ def test_kopf_logs_visible_with_json_formatting(\n         finally:\n             stop_observer()\n             monkeypatch.delenv(\"PREFECT_LOGGING_HANDLERS_CONSOLE_FORMATTER\")\n+\n+\n+_POD_RESOURCE = kopf.Resource(\"\", \"v1\", \"pods\", namespaced=True, preferred=True)\n+_JOB_RESOURCE = kopf.Resource(\"batch\", \"v1\", \"jobs\", namespaced=True, preferred=True)\n+_NAMESPACE_RESOURCE = kopf.Resource(\n+    \"\", \"v1\", \"namespaces\", namespaced=False, preferred=True\n+)\n+_CRD_RESOURCE = kopf.Resource(\n+    \"apiextensions.k8s.io\",\n+    \"v1\",\n+    \"customresourcedefinitions\",\n+    namespaced=False,\n+    preferred=True,\n+)\n+\n+\n+def _configured_operator_settings() -> kopf.OperatorSettings:\n+    settings = kopf.OperatorSettings()\n+    observer.configure(settings)\n+    return settings\n+\n+\n+@asynccontextmanager\n+async def _fake_kubernetes_api(\n+    requests: list[tuple[str, dict[str, str]]],\n+) -> AsyncIterator[None]:\n+    \"\"\"Serve two-page LISTs and a one-event WATCH, recording every request.\"\"\"\n+\n+    async def handler(request: web.Request) -> web.StreamResponse:\n+        query = dict(request.query)\n+        requests.append((request.path, query))\n+        kind = \"Pod\" if request.path.endswith(\"/pods\") else \"Job\"\n+        if query.get(\"watch\") == \"true\":\n+            event = {\n+                \"type\": \"ADDED\",\n+                \"object\": {\"kind\": kind, \"metadata\": {\"name\": \"watched\"}},\n+            }\n+            return web.Response(text=json.dumps(event) + \"\\n\")\n+        page = 2 if \"continue\" in query else 1\n+        return web.json_response(\n+            {\n+                \"kind\": f\"{kind}List\",\n+                \"apiVersion\": \"v1\",\n+                \"metadata\": {\n+                    \"resourceVersion\": \"100\",\n+                    \"continue\": \"next-page\" if page == 1 else \"\",\n+                },\n+                \"items\": [{\"metadata\": {\"name\": f\"{kind.lower()}-{page}\"}}],\n+            }\n+        )\n+\n+    app = web.Application()\n+    app.router.add_get(\"/{tail:.*}\", handler)\n+    runner = web.AppRunner(app)\n+    await runner.setup()\n+    site = web.TCPSite(runner, \"127.0.0.1\", 0)\n+    await site.start()\n+    port = cast(Any, site)._server.sockets[0].getsockname()[1]\n+\n+    vault = kopf_credentials.Vault()\n+    await vault.populate(\n+        {\"fake\": kopf_credentials.ConnectionInfo(server=f\"http://127.0.0.1:{port}\")}\n+    )\n+    token = kopf_auth.vault_var.set(vault)\n+    try:\n+        yield\n+    finally:\n+        kopf_auth.vault_var.reset(token)\n+        await vault.close()\n+        await runner.cleanup()\n+\n+\n+class TestServerSideFiltering:\n+    @pytest.mark.parametrize(\n+        (\"additional_label_filters\", \"expected_selector\"),\n+        [\n+            ({}, \"prefect.io/flow-run-id\"),\n+            (\n+                {\"team\": \"data\", \"empty\": \"\"},\n+                \"empty=,prefect.io/flow-run-id,team=data\",\n+            ),\n+            ({\"prefect.io/flow-run-id\": \"abc\"}, \"prefect.io/flow-run-id=abc\"),\n+        ],\n+    )\n+    def test_configure_sets_label_selectors_for_pods_and_jobs_only(\n+        self,\n+        monkeypatch: pytest.MonkeyPatch,\n+        additional_label_filters: dict[str, str],\n+        expected_selector: str,\n+    ):\n+        monkeypatch.setattr(\n+            observer.settings.observer,\n+            \"additional_label_filters\",\n+            additional_label_filters,\n+        )\n+\n+        settings = _configured_operator_settings()\n+\n+        selectors = settings.watching.label_selectors\n+        assert selectors.collect(_POD_RESOURCE) == [expected_selector]\n+        assert selectors.collect(_JOB_RESOURCE) == [expected_selector]\n+        assert selectors.collect(_NAMESPACE_RESOURCE) == []\n+        assert selectors.collect(_CRD_RESOURCE) == []\n+\n+    def test_configure_pages_initial_lists_without_field_selectors(self):\n+        settings = _configured_operator_settings()\n+\n+        assert settings.scanning.disabled is True\n+        assert settings.watching.chunk_size == 500\n+        assert settings.watching.initial_streaming is False\n+        for resource in (_POD_RESOURCE, _JOB_RESOURCE):\n+            assert settings.watching.field_selectors.collect(resource) == []\n+\n+    @pytest.mark.parametrize(\n+        (\"namespace\", \"path_prefix\"),\n+        [(\"prefect\", \"/api/v1/namespaces/prefect\"), (None, \"/api/v1\")],\n+    )\n+    @pytest.mark.parametrize(\"resource\", [_POD_RESOURCE, _JOB_RESOURCE])\n+    async def test_list_and_watch_requests_carry_selector_and_page_size(\n+        self,\n+        monkeypatch: pytest.MonkeyPatch,\n+        resource: kopf.Resource,\n+        namespace: str | None,\n+        path_prefix: str,\n+    ):\n+        monkeypatch.setattr(\n+            observer.settings.observer, \"additional_label_filters\", {\"team\": \"data\"}\n+        )\n+        settings = _configured_operator_settings()\n+        if resource.group:\n+            path_prefix = path_prefix.replace(\"/api/v1\", \"/apis/batch/v1\")\n+        expected_path = f\"{path_prefix}/{resource.plural}\"\n+        requests: list[tuple[str, dict[str, str]]] = []\n+\n+        async with _fake_kubernetes_api(requests):\n+            listed = [\n+                item[\"metadata\"][\"name\"]\n+                async for chunk, _ in kopf_fetching.fetch_objs(\n+                    settings=settings,\n+                    resource=resource,\n+                    namespace=namespace,\n+                    logger=logging.getLogger(__name__),\n+                )\n+                for item in chunk\n+            ]\n+            watched = [\n+                raw_event\n+                async for raw_event in kopf_watching.watch_objs(\n+                    settings=settings,\n+                    resource=resource,\n+                    namespace=namespace,\n+                    since=\"100\",\n+                    operator_pause_waiter=asyncio.get_running_loop().create_future(),\n+                )\n+            ]\n+\n+        assert len(listed) == 2\n+        assert len(watched) == 1\n+        selector = \"prefect.io/flow-run-id,team=data\"\n+        assert requests == [\n+            (expected_path, {\"limit\": \"500\", \"labelSelector\": selector}),\n+            (\n+                expected_path,\n+                {\"limit\": \"500\", \"labelSelector\": selector, \"continue\": \"next-page\"},\n+            ),\n+            (\n+                expected_path,\n+                {\n+                    \"watch\": \"true\",\n+                    \"allowWatchBookmarks\": \"true\",\n+                    \"labelSelector\": selector,\n+                    \"resourceVersion\": \"100\",\n+                },\n+            ),\n+        ]\n", "problem_statement": "Reduce Kubernetes worker observer memory footprint in large / multi-tenant clusters\nThe Kubernetes worker observer can OOM in large / multi-tenant clusters because it loads every pod and job in the watched scope into memory at startup, regardless of ownership or completion state.\n\n### Describe the current behavior\n\nThe Kubernetes worker's observer is built on [`kopf`](https://github.com/nolar/kopf). At startup, kopf performs an initial LIST of the watched resources (pods, jobs) before streaming watch events. kopf does **not** send a server-side `labelSelector` or `fieldSelector` on its LIST/WATCH calls \u2014 it fetches *all* objects of the resource type in scope and applies the handler's `labels={...}` filter **client-side**, after the objects are already in memory.\n\nIn `prefect-kubernetes`, both watches are registered label-only:\n\n```python\nkopf.on.event(\"pods\", labels={\"prefect.io/flow-run-id\": kopf.PRESENT, ...})\n@kopf.on.event(\"jobs\", labels={\"prefect.io/flow-run-id\": kopf.PRESENT, ...})\n```\n\n- Pod watch: [`observer.py#L205-L211`](https://github.com/PrefectHQ/prefect/blob/9f4dba8c3d19927ff63f97b1ffa0224804ca9708/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py#L205-L211)\n- Job watch: [`observer.py#L251-L257`](https://github.com/PrefectHQ/prefect/blob/9f4dba8c3d19927ff63f97b1ffa0224804ca9708/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py#L251-L257)\n- Cluster-wide vs. namespaced operator startup: [`observer.py#L424-L451`](https://github.com/PrefectHQ/prefect/blob/9f4dba8c3d19927ff63f97b1ffa0224804ca9708/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py#L424-L451)\n\nBecause the filter is client-side, a cluster-wide observer materializes **every pod and job in the watched scope** at startup \u2014 including long-completed/terminal objects and objects owned by non-Prefect workloads \u2014 before the `prefect.io/flow-run-id` filter is applied. Peak memory therefore scales with total cluster object count, not with the number of Prefect objects. Additionally, the pod handler has no terminal-phase early-return: each object surfaced at cold start triggers a [`/events/filter` dedup request](https://github.com/PrefectHQ/prefect/blob/9f4dba8c3d19927ff63f97b1ffa0224804ca9708/src/integrations/prefect-kubernetes/prefect_kubernetes/observer.py#L132), so a large initial list also produces a burst of API calls.\n\n### Describe the proposed behavior\n\nBound the observer's startup memory footprint so it scales with the number of *Prefect* objects rather than total cluster size. The core lever is server-side scoping of the watches so that terminal and non-Prefect objects are never fetched into memory at all. Candidate approaches (complementary, for maintainer evaluation):\n\n1. **Server-side `labelSelector` on the watch.** Have the observer's watches send `labelSelector=prefect.io/flow-run-id` to the LIST/WATCH API so non-Prefect objects are never fetched into memory. This is the largest, memory-size-independent win.\n\n2. **Server-side `fieldSelector` on `status.phase`.** Watch only non-terminal pods (`Pending`/`Running`/`Unknown`) and skip `Succeeded`/`Failed`, so completed objects aren't materialized at all.\n\nBoth approaches require sending server-side selectors on the underlying watches, which the current `kopf`-based implementation does not do today.\n\n### Example Use\n\nA user runs a single cluster-wide Kubernetes worker on a shared, multi-tenant cluster containing a large number of completed jobs/pods (both Prefect and non-Prefect). With server-side scoping, the observer would watch only Prefect's non-terminal objects, keeping worker memory roughly constant as the cluster grows \u2014 instead of OOMing on restart and requiring ever-larger memory limits.\n\n### Additional context\n\nReported by a user running a cluster-wide observer across many namespaces on 1GB workers: an observer restart OOM'd the worker and took the work pool to `NOT_READY`. Current mitigations are all stopgaps for this use case:\n\n- **Increase worker memory** \u2014 a treadmill; peak grows with total cluster objects over time.\n- **Scope `PREFECT_INTEGRATIONS_KUBERNETES_OBSERVER_NAMESPACES`** \u2014 reduces watched scope, but is a static set fixed at observer startup and doesn't bound memory within a busy namespace.\n- **Lower job TTL** \u2014 can be applied to Prefect's own pods, but users may be unable to for compliance/retention reasons, and it has no effect on other tenants' objects on a shared cluster, which the observer still materializes.\n", "hints_text": "", "created_at": "2026-10-19T16:23:54Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23456, "instance_id": "PrefectHQ__prefect-23456", "issue_numbers": ["23455"], "base_commit": "1c866f04d6268a56a02bdbc1f8aa4b1788c39f89", "patch": "diff --git a/src/prefect/cli/_transfer_utils.py b/src/prefect/cli/_transfer_utils.py\nindex 00e5d9a580af..f40513a850f8 100644\n--- a/src/prefect/cli/_transfer_utils.py\n+++ b/src/prefect/cli/_transfer_utils.py\n@@ -28,14 +28,20 @@ async def collect_resources(client: Any) -> Sequence[\"MigratableProtocol\"]:\n         client.read_deployments(),\n         client.read_block_documents(),\n         client.read_variables(),\n-        client.read_global_concurrency_limits(),\n         client.read_automations(),\n     )\n \n+    # The client reads 10 global concurrency limits per call by default.\n+    global_concurrency_limits: list[Any] = []\n+    while page := await client.read_global_concurrency_limits(\n+        offset=len(global_concurrency_limits)\n+    ):\n+        global_concurrency_limits.extend(page)\n+\n     resources = await asyncio.gather(\n         *[\n             construct_migratable_resource(item)\n-            for collection in collections\n+            for collection in [*collections, global_concurrency_limits]\n             for item in collection\n         ]\n     )\n", "test_patch": "diff --git a/tests/cli/test_transfer.py b/tests/cli/test_transfer.py\nindex baf49300e12c..ccb08434f326 100644\n--- a/tests/cli/test_transfer.py\n+++ b/tests/cli/test_transfer.py\n@@ -5,6 +5,9 @@\n \n import pytest\n \n+from prefect.cli._transfer_utils import (\n+    collect_resources as _collect_resources,\n+)\n from prefect.cli._transfer_utils import (\n     find_root_resources as _find_root_resources,\n )\n@@ -13,6 +16,8 @@\n )\n from prefect.cli.transfer._exceptions import TransferSkipped\n from prefect.cli.transfer._migratable_resources.base import MigratableProtocol\n+from prefect.client.orchestration import PrefectClient\n+from prefect.client.schemas.actions import GlobalConcurrencyLimitCreate\n from prefect.settings import Profile, ProfilesCollection\n from prefect.testing.cli import invoke_and_assert\n from prefect.utilities.asyncutils import run_sync_in_worker_thread\n@@ -222,6 +227,22 @@ async def test_transfer_no_resources_found(\n             expected_output_contains=\"No resources found to transfer\",\n         )\n \n+    async def test_collect_resources_reads_every_global_concurrency_limit(\n+        self, prefect_client: PrefectClient\n+    ):\n+        \"\"\"Test that more than one default page of limits is collected.\"\"\"\n+        names = [f\"transfer-limit-{i:02d}\" for i in range(12)]\n+        for name in names:\n+            await prefect_client.create_global_concurrency_limit(\n+                GlobalConcurrencyLimitCreate(name=name, limit=1)\n+            )\n+\n+        resources = await _collect_resources(prefect_client)\n+\n+        assert (\n+            sorted(r.source_global_concurrency_limit.name for r in resources) == names\n+        )\n+\n \n class TestIntegrationScenarios:\n     \"\"\"Integration-style tests for common scenarios.\"\"\"\n", "problem_statement": "`prefect transfer` copies only the first 10 global concurrency limits\n### Bug summary\n\n`prefect transfer --from A --to B` copies only the first 10 global concurrency limits of the source profile. With 12 limits in A and none in B, B ends up with 10.\n\nThe command gathers the source resources with `collect_resources`, which reads global concurrency limits with one call to `read_global_concurrency_limits()`. That client method returns 10 limits per call by default, so the rest are not collected.\n\nThe transfer guide says the command \"transfers all resources from the source to the destination\" and lists global concurrency limits among them.\n\n```python\nimport asyncio\n\nfrom prefect import get_client\nfrom prefect.cli._transfer_utils import collect_resources\nfrom prefect.client.schemas.actions import GlobalConcurrencyLimitCreate\n\n\nasync def main():\n    async with get_client() as client:\n        for i in range(12):\n            await client.create_global_concurrency_limit(\n                GlobalConcurrencyLimitCreate(name=f\"limit-{i:02d}\", limit=1)\n            )\n        resources = await collect_resources(client)\n        print(len(resources))\n\n\nasyncio.run(main())\n```\n\nOutput:\n\n```\n10\n```\n\nExpected: `12`, one resource for each limit.\n\n### Version info\n\n```\nVersion:             3.8.9.dev6+10.g1c866f04d\nPython version:      3.12.14\nGit commit:          1c866f04\n```\n\nThis is `main` at 1c866f04d6268a56a02bdbc1f8aa4b1788c39f89.\n\n### Additional context\n\n`collect_resources` calls the client method once, and the client default is `limit: int = 10`:\n\n- https://github.com/PrefectHQ/prefect/blob/1c866f04d6268a56a02bdbc1f8aa4b1788c39f89/src/prefect/cli/_transfer_utils.py#L31\n- https://github.com/PrefectHQ/prefect/blob/1c866f04d6268a56a02bdbc1f8aa4b1788c39f89/src/prefect/client/orchestration/_concurrency_limits/client.py#L929-L931\n\nThe command calls `collect_resources` here: https://github.com/PrefectHQ/prefect/blob/1c866f04d6268a56a02bdbc1f8aa4b1788c39f89/src/prefect/cli/transfer/_commands.py#L111\n\nThe guide sentence is at https://github.com/PrefectHQ/prefect/blob/1c866f04d6268a56a02bdbc1f8aa4b1788c39f89/docs/v3/how-to-guides/migrate/transfer-resources.mdx#L10 and the list of resources at https://github.com/PrefectHQ/prefect/blob/1c866f04d6268a56a02bdbc1f8aa4b1788c39f89/docs/v3/how-to-guides/migrate/transfer-resources.mdx#L36.\n\nThe other reads in `collect_resources` (work pools, work queues, deployments, block documents, variables and automations) pass no `limit`, so the server returns at most `PREFECT_SERVER_API_DEFAULT_LIMIT` rows for each, 200 by default. Those are not part of this issue.\n\nI plan to open a pull request for this.\n\n", "hints_text": "", "created_at": "2026-10-19T16:16:53Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23454, "instance_id": "PrefectHQ__prefect-23454", "issue_numbers": ["23452"], "base_commit": "1c866f04d6268a56a02bdbc1f8aa4b1788c39f89", "patch": "diff --git a/src/prefect/utilities/collections.py b/src/prefect/utilities/collections.py\nindex 465f50a2a498..4384d33e970d 100644\n--- a/src/prefect/utilities/collections.py\n+++ b/src/prefect/utilities/collections.py\n@@ -13,6 +13,7 @@\n     Hashable,\n     Iterable,\n     Iterator,\n+    Mapping,\n     Sequence,\n     Set,\n )\n@@ -617,6 +618,21 @@ def _key(__i: Any) -> Hashable:\n         yield item\n \n \n+def _canonical_int_or_key(key: Any) -> Any:\n+    \"\"\"\n+    Convert a string like `\"1\"` or `\"-1\"` to an int, leaving any other key\n+    (including non-canonical forms like `\"01\"`) unchanged.\n+    \"\"\"\n+    if isinstance(key, str):\n+        try:\n+            int_key = int(key)\n+        except ValueError:\n+            return key\n+        if str(int_key) == key:\n+            return int_key\n+    return key\n+\n+\n @overload\n def get_from_dict(\n     dct: NestedDict[str, VT], keys: Union[str, list[str]], default: None = None\n@@ -645,7 +661,9 @@ def get_from_dict(\n         keys: The sequence of keys to use for access. Can be a\n             dot-separated string or a list of keys. List indices can be included\n             in the sequence as either integer keys or as string indices in square\n-            brackets.\n+            brackets. When indexing a dictionary, a string key is matched\n+            exactly first and only falls back to the equivalent integer key\n+            (e.g. `\"1\"` -> `1`) if no exact match exists.\n         default: The default value to return if the requested key path does not\n             exist. Defaults to None.\n \n@@ -658,6 +676,7 @@ def get_from_dict(\n     get_from_dict({'a': {'b': {'c': [1, 2, 3, 4]}}}, 'a.b.c[1]') # 2\n     get_from_dict({'a': {'b': [0, {'c': [1, 2]}]}}, ['a', 'b', 1, 'c', 1]) # 2\n     get_from_dict({'a': {'b': [0, {'c': [1, 2]}]}}, 'a.b.1.c.2', 'default') # 'default'\n+    get_from_dict({'years': {'2026': 42}}, 'years.2026') # 42\n     ```\n     \"\"\"\n     if isinstance(keys, str):\n@@ -665,13 +684,16 @@ def get_from_dict(\n     value = dct\n     try:\n         for key in keys:\n-            try:\n-                # Try to cast to int to handle list indices\n-                key = int(key)\n-            except ValueError:\n-                # If it's not an int, use the key as-is\n-                # for dict lookup\n-                pass\n+            if isinstance(value, Mapping):\n+                # Prefer an exact match so numeric string keys like \"2026\" resolve\n+                if key not in value:\n+                    key = _canonical_int_or_key(key)\n+            else:\n+                try:\n+                    # Try to cast to int to handle list indices\n+                    key = int(key)\n+                except ValueError:\n+                    pass\n             value = value[key]  # type: ignore\n         return cast(VT, value)\n     except (TypeError, KeyError, IndexError):\n", "test_patch": "diff --git a/tests/utilities/test_collections.py b/tests/utilities/test_collections.py\nindex 48eac033b55e..79e0f1775db7 100644\n--- a/tests/utilities/test_collections.py\n+++ b/tests/utilities/test_collections.py\n@@ -825,6 +825,16 @@ class TestGetFromDict:\n                 \"default_value\",\n                 \"default_value\",\n             ),\n+            ({\"years\": {\"2026\": 42}}, \"years.2026\", 42, None),\n+            ({\"items\": {\"01\": \"first\"}}, \"items.01\", \"first\", None),\n+            ({\"a\": {1: \"int\", \"1\": \"str\"}}, \"a.1\", \"str\", None),\n+            ({\"a\": {1: \"int\", \"1\": \"str\"}}, [\"a\", 1], \"int\", None),\n+            ({\"a\": {1: \"int\"}}, \"a.1\", \"int\", None),\n+            ({\"a\": {-1: \"neg\"}}, \"a.-1\", \"neg\", None),\n+            ({\"a\": {1: \"int\"}}, \"a.01\", \"default_value\", \"default_value\"),\n+            ({\"a\": [1, 2, 3]}, \"a[-1]\", 3, None),\n+            ({\"a\": [1, 2, 3]}, \"a.-1\", 3, None),\n+            ({\"a\": [{\"b\": 1}]}, \"a[0].b\", 1, None),\n         ],\n     )\n     def test_get_from_dict(self, dct, keys, expected, default):\ndiff --git a/tests/utilities/test_templating.py b/tests/utilities/test_templating.py\nindex 93db9182ba80..f30da53a61d0 100644\n--- a/tests/utilities/test_templating.py\n+++ b/tests/utilities/test_templating.py\n@@ -161,6 +161,11 @@ def test_apply_values_dictionary_with_placeholders(self):\n         values = {\"first_name\": \"Alice\", \"last_name\": \"Smith\", \"age\": 30}\n         assert apply_values(template, values) == {\"name\": \"Alice Smith\", \"age\": 30}\n \n+    def test_apply_values_with_numeric_string_dict_key(self):\n+        values = {\"years\": {\"2026\": 42}}\n+        assert apply_values({\"year\": \"{{ years.2026 }}\"}, values) == {\"year\": 42}\n+        assert apply_values(\"FY{{ years.2026 }}\", values) == \"FY42\"\n+\n     def test_apply_values_dictionary_with_unset_value(self):\n         template = {\"last_name\": \"{{last_name}}\", \"age\": \"{{age}}\"}\n         values = {\"first_name\": \"Alice\", \"age\": 30}\n", "problem_statement": "Numeric string dictionary keys are not resolved by get_from_dict or apply_values\nNumeric string keys in nested dictionaries are converted to integers before\nlookup. A missing lookup then causes apply_values to drop the template field\nwith its default remove_notset=True behavior.\n\nMinimal reproduction:\n\n```python\nfrom prefect.utilities.collections import get_from_dict\nfrom prefect.utilities.templating import apply_values\n\nvalues = {\"years\": {\"2026\": 42}}\nprint(get_from_dict(values, \"years.2026\", \"missing\"))\nprint(apply_values({\"year\": \"{{ years.2026 }}\"}, values))\nprint(get_from_dict({\"items\": {\"01\": \"first\"}}, \"items.01\", \"missing\"))\nprint(get_from_dict({\"a\": {1: \"int\", \"1\": \"str\"}}, \"a.1\"))\n```\n\nActual output on main at 1c866f04d6268a56a02bdbc1f8aa4b1788c39f89:\n\n```text\nmissing\n{}\nmissing\nint\n```\n\nExpected output:\n\n```text\n42\n{'year': 42}\nfirst\nstr\n```\n\nThe leading zero in \"01\" identifies a dictionary key and should be preserved.\nWhen both 1 and \"1\" exist, a string path should prefer the matching string key.\nInteger-only dictionary keys and existing positive/negative sequence indices\nshould keep working, including the documented dotted and bracketed list paths.\n\nEnvironment: macOS 26.5.1 arm64, Python 3.12.13, editable Prefect\n3.8.9.dev6+10.g1c866f04d6 from the commit above; pydantic 2.14.1,\npydantic-settings 2.16.0.\n\nEvidence provenance: an AI agent executed this reproduction locally using real\nimports from the checked-out Prefect source, without a server or database.\nThe accompanying baseline-reproduction.log contains the complete output,\nincluding working list-index and integer-key controls. The intended submitter\nmust review and reproduce these results before publishing this draft.\n\nI plan to open a PR for this.\n\nAI disclosure: Codex assisted with part of the code and this description.\n\n", "hints_text": "", "created_at": "2026-10-19T16:14:41Z"}
