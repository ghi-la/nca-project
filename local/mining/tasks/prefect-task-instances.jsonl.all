es.pythonhosted.org/packages/49/d1/452275817b8114ea32c89c44cde1e4a2474448fcace49de94c78b2cea6f6/prefect_shell-0.3.7-py3-none-any.whl\", hash = \"sha256:e5971d7e984db4a08ebba85fc163d84eeba338faeb3d6868f6c841462375bb2e\", size = 13405, upload-time = \"2026-09-30T16:09:12.443Z\" },\n ]\n \n [[package]]\n name = \"prefect-slack\"\n-version = \"0.3.1\"\n+version = \"0.4.0\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"aiohttp\" },\n     { name = \"prefect\" },\n     { name = \"slack-sdk\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/8c/58/0506e132aaead9a0c4d6adf3d547d8e1fd1010053b0c0a8ba76db419f0eb/prefect_slack-0.3.1.tar.gz\", hash = \"sha256:3eaa9dd997c1be96d9601b7a1dbfb57f7e9a40d7208b22b6c5cdc0579be13b21\", size = 11710, upload-time = \"2024-11-15T17:17:29.282Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/3b/cb/9ce2d4a4e0732e91bdc6bc9c1e81239d2cb68ebfefe51fd77b054a7a49b0/prefect_slack-0.4.0.tar.gz\", hash = \"sha256:a49303796602b8d8df674f69446809ef1ad820c631a8ebeadf136180c638e54c\", size = 12391, upload-time = \"2026-08-04T17:57:02.182Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/41/12/6b095a290517abd605875be2a746d222a95d0296d44ff81f56fc93a32eac/prefect_slack-0.3.1-py3-none-any.whl\", hash = \"sha256:84067ef89c9085fd991943747e4943accb3fe586a9401355180bb50dac5dab21\", size = 10588, upload-time = \"2024-11-15T17:17:27.495Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/22/87/f57aa0df3be1a4f83d1178331bf53b7959637b07e16a7707e995a25e5533/prefect_slack-0.4.0-py3-none-any.whl\", hash = \"sha256:e91c31eeb4f202413d21509bab8502999400e4f7a374fe67022a0050ab4838c4\", size = 10534, upload-time = \"2026-08-04T17:57:00.915Z\" },\n ]\n \n [[package]]\n name = \"prefect-snowflake\"\n-version = \"0.28.8\"\n+version = \"0.28.9\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"prefect\" },\n@@ -4716,9 +4717,9 @@ dependencies = [\n     { name = \"snowflake-connector-python\" },\n     { name = \"tenacity\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/91/88/faf51c2d1cbe20ab0bb2773d08ba9422d197e7dc54e261bc2d0c4f8f6ed4/prefect_snowflake-0.28.8.tar.gz\", hash = \"sha256:0b382420487cd52fe7fa73a3be70e94ec5b4271750111ecfb4d8abc85831c6a4\", size = 48715, upload-time = \"2026-06-05T19:38:54.366Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/fc/5b/f5d8aeee1367392ba4b0cb289f324c504cf1d0ea8f79ecbb3b71c7e1e932/prefect_snowflake-0.28.9.tar.gz\", hash = \"sha256:0502e1cf37b663eabfb5e0d965430fe1bb9e2886569af34e59f4bb06160cb3f5\", size = 49568, upload-time = \"2026-09-08T18:28:06.108Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/c4/e6/ca77f8b6f970ef7e332d7915084e27a6684c802f1924cfbaf9027f3cf809/prefect_snowflake-0.28.8-py3-none-any.whl\", hash = \"sha256:0351dcdeafee1493cb05e42f2219cb58ba627db7882403d288b325e5622fa2a2\", size = 26183, upload-time = \"2026-06-05T19:38:53.125Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/be/34/00ce2e3272b0502b5e78457d69d1bccb04dbbe249da1d1a5bed38ec91490/prefect_snowflake-0.28.9-py3-none-any.whl\", hash = \"sha256:d104d504b6c3a8f49e813b283c2744a8c99180f1ee8bca78a9dbf9ad07fd15df\", size = 26406, upload-time = \"2026-09-08T18:28:04.859Z\" },\n ]\n \n [[package]]\n@@ -6370,11 +6371,11 @@ wheels = [\n \n [[package]]\n name = \"setuptools\"\n-version = \"83.0.0\"\n+version = \"80.10.2\"\n source = { registry = \"https://pypi.org/simple\" }\n-sdist = { url = \"https://files.pythonhosted.org/packages/34/26/f5d29e25ffdb535afef2d35cdb55b325298f96debd670da4c325e08d70f4/setuptools-83.0.0.tar.gz\", hash = \"sha256:025bccbbf0fa05b6192bc64ae1e7b16e001fd6d6d4d5de03c97b1c1ade523bef\", size = 1154254, upload-time = \"2026-07-04T15:31:22.699Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/76/95/faf61eb8363f26aa7e1d762267a8d602a1b26d4f3a1e758e92cb3cb8b054/setuptools-80.10.2.tar.gz\", hash = \"sha256:8b0e9d10c784bf7d262c4e5ec5d4ec94127ce206e8738f29a437945fbc219b70\", size = 1200343, upload-time = \"2026-01-25T22:38:17.252Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/5d/40/e1e72872c6354b306daef1703549e8e83b4d43cfea356311bf722a043752/setuptools-83.0.0-py3-none-any.whl\", hash = \"sha256:29b23c360f22f414dc7336bb39178cc7bcbf6021ed2733cde173f09dba19abb3\", size = 1008090, upload-time = \"2026-07-04T15:31:20.885Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/94/b8/f1f62a5e3c0ad2ff1d189590bfa4c46b4f3b6e49cef6f26c6ee4e575394d/setuptools-80.10.2-py3-none-any.whl\", hash = \"sha256:95b30ddfb717250edb492926c92b5221f7ef3fbcc2b07579bcd4a27da21d0173\", size = 1064234, upload-time = \"2026-01-25T22:38:15.216Z\" },\n ]\n \n [[package]]\n", "test_patch": "diff --git a/.github/workflows/integration-lock-tests.yaml b/.github/workflows/integration-lock-tests.yaml\nnew file mode 100644\nindex 000000000000..d49204ec4b1b\n--- /dev/null\n+++ b/.github/workflows/integration-lock-tests.yaml\n@@ -0,0 +1,19 @@\n+name: Integration lock automation tests\n+on:\n+  pull_request:\n+    paths:\n+      - '.github/workflows/*integrati*.yaml'\n+      - 'scripts/update_uv_lock_integrations.py'\n+      - 'scripts/tests/test_update_uv_lock_integrations.py'\n+permissions:\n+  contents: read\n+jobs:\n+  test:\n+    runs-on: ubuntu-latest\n+    steps:\n+      - uses: actions/checkout@v7\n+      - uses: actions/setup-python@v7\n+        with:\n+          python-version: '3.12'\n+      - uses: astral-sh/setup-uv@v10.3.0\n+      - run: uv run --no-project --with packaging --with pyyaml python -m unittest discover -s scripts/tests -p test_update_uv_lock_integrations.py\ndiff --git a/scripts/tests/test_update_uv_lock_integrations.py b/scripts/tests/test_update_uv_lock_integrations.py\nnew file mode 100644\nindex 000000000000..6eff2b8435c0\n--- /dev/null\n+++ b/scripts/tests/test_update_uv_lock_integrations.py\n@@ -0,0 +1,198 @@\n+\"\"\"Safe regression tests: GitHub, index access, and sleeps are mocked.\"\"\"\n+\n+import importlib.util\n+import json\n+import os\n+import subprocess\n+import tempfile\n+import unittest\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+import yaml\n+\n+ROOT = Path(__file__).resolve().parents[2]\n+spec = importlib.util.spec_from_file_location(\n+    \"updater\", ROOT / \"scripts/update_uv_lock_integrations.py\"\n+)\n+updater = importlib.util.module_from_spec(spec)\n+spec.loader.exec_module(updater)\n+\n+\n+class UpdateTests(unittest.TestCase):\n+    def test_release_validation(self):\n+        self.assertEqual(\n+            updater.release(\"prefect-redis-0.3.0\"), (\"prefect-redis\", \"0.3.0\")\n+        )\n+        with self.assertRaises(ValueError):\n+            updater.release(\"main\")\n+\n+    @patch.object(updater.time, \"sleep\")\n+    @patch.object(updater, \"run\")\n+    @patch.object(updater, \"pins\")\n+    def test_index_eventually_available(self, pins, run, sleep):\n+        pins.side_effect = [{\"prefect-redis\": \"0.2.11\"}, {\"prefect-redis\": \"0.3.0\"}]\n+        run.side_effect = [subprocess.CalledProcessError(1, \"uv\"), \"\"]\n+        updater.upgrade(\"prefect-redis\", \"0.3.0\")\n+        self.assertEqual(run.call_count, 2)\n+        sleep.assert_called_once_with(30)\n+        self.assertIn(\"prefect-redis==0.3.0\", run.call_args.args)\n+\n+    @patch.object(updater.time, \"sleep\")\n+    @patch.object(updater, \"run\", return_value=\"\")\n+    @patch.object(updater, \"pins\", return_value={\"prefect-redis\": \"0.2.11\"})\n+    def test_version_mismatch_fails_bounded(self, pins, run, sleep):\n+        with self.assertRaises(RuntimeError):\n+            updater.upgrade(\"prefect-redis\", \"0.3.0\", attempts=3)\n+        self.assertEqual(run.call_count, 3)\n+        self.assertEqual(sleep.call_count, 2)\n+\n+    @patch.object(updater, \"run\")\n+    @patch.object(updater, \"pins\", return_value={\"prefect-redis\": \"0.4.0\"})\n+    def test_old_release_never_downgrades(self, pins, run):\n+        updater.upgrade(\"prefect-redis\", \"0.3.0\")\n+        run.assert_not_called()\n+\n+    def test_branch_recovery(self):\n+        for state in (None, \"OPEN\", \"CLOSED\", \"MERGED\"):\n+            with (\n+                self.subTest(state=state),\n+                patch.dict(\n+                    os.environ, {\"GITHUB_RUN_ID\": \"123\", \"GITHUB_RUN_ATTEMPT\": \"2\"}\n+                ),\n+            ):\n+                prs = [] if state is None else [{\"state\": state}]\n+                with patch.object(\n+                    updater,\n+                    \"run\",\n+                    side_effect=[json.dumps(prs), \"sha\", \"\", \"\", \"uv.lock\", \"\"],\n+                ) as run:\n+                    branch, is_open = updater.prepare_branch(\"automation/test\")\n+                self.assertEqual(is_open, state == \"OPEN\")\n+                self.assertEqual(\n+                    branch.endswith(\"-123-2\"), state in (\"CLOSED\", \"MERGED\")\n+                )\n+                self.assertIn(\n+                    (\"git\", \"merge\", \"--no-edit\", \"origin/main\"),\n+                    [c.args for c in run.call_args_list],\n+                )\n+\n+    @patch.object(updater, \"run\", side_effect=[\"[]\", \"sha\", \"\", \"\", \"other.py\"])\n+    def test_unrelated_branch_changes_rejected(self, run):\n+        with self.assertRaises(RuntimeError):\n+            updater.prepare_branch(\"automation/test\")\n+\n+    def test_recover_orphan_and_existing_pr_without_new_changes(self):\n+        for open_pr in (False, True):\n+            with (\n+                self.subTest(open_pr=open_pr),\n+                patch.dict(os.environ, {\"RELEASE_TAG\": \"prefect-redis-0.3.0\"}),\n+                patch.object(updater, \"pins\", return_value={\"prefect-redis\": \"0.3.0\"}),\n+                patch.object(\n+                    updater, \"prepare_branch\", return_value=(\"automation/test\", open_pr)\n+                ),\n+                patch.object(updater, \"run\") as run,\n+            ):\n+                run.side_effect = lambda *args: (\n+                    \"existing lock diff\"\n+                    if args[:3] == (\"git\", \"diff\", \"origin/main...HEAD\")\n+                    else \"\"\n+                )\n+                updater.main()\n+                calls = [c.args for c in run.call_args_list]\n+                self.assertTrue(any(c[:2] == (\"git\", \"push\") for c in calls))\n+                self.assertEqual(\n+                    any(c[:3] == (\"gh\", \"pr\", \"create\") for c in calls), not open_pr\n+                )\n+\n+    @patch.dict(os.environ, {\"RELEASE_TAG\": \"\"})\n+    @patch.object(\n+        updater,\n+        \"pins\",\n+        return_value={\"prefect-redis\": \"0.3.0\", \"prefect-aws\": \"0.7.12\"},\n+    )\n+    @patch.object(updater, \"prepare_branch\", return_value=(\"automation/sweep\", False))\n+    @patch.object(updater, \"run\", return_value=\"\")\n+    def test_weekly_upgrades_all_pins_without_empty_pr(self, run, branch, pins):\n+        updater.main()\n+        calls = [c.args for c in run.call_args_list]\n+        self.assertIn(\n+            (\n+                \"uv\",\n+                \"lock\",\n+                \"--upgrade-package\",\n+                \"prefect-aws\",\n+                \"--upgrade-package\",\n+                \"prefect-redis\",\n+            ),\n+            calls,\n+        )\n+        self.assertFalse(any(c[:2] == (\"git\", \"push\") for c in calls))\n+\n+    def test_real_git_orphan_branch_recovery_preserves_commits(self):\n+        with tempfile.TemporaryDirectory() as directory:\n+            root = Path(directory)\n+            remote, local = root / \"remote.git\", root / \"local\"\n+            subprocess.run(\n+                [\"git\", \"init\", \"--bare\", str(remote)], check=True, capture_output=True\n+            )\n+            subprocess.run(\n+                [\"git\", \"clone\", str(remote), str(local)],\n+                check=True,\n+                capture_output=True,\n+            )\n+            old = Path.cwd()\n+            os.chdir(local)\n+            try:\n+                updater.run(\"git\", \"config\", \"user.name\", \"Test\")\n+                updater.run(\"git\", \"config\", \"user.email\", \"test@example.invalid\")\n+                updater.run(\"git\", \"checkout\", \"-b\", \"main\")\n+                Path(\"uv.lock\").write_text(\"old lock\\n\")\n+                updater.run(\"git\", \"add\", \"uv.lock\")\n+                updater.run(\"git\", \"commit\", \"-m\", \"base\")\n+                updater.run(\"git\", \"push\", \"origin\", \"main\")\n+                updater.run(\"git\", \"checkout\", \"-b\", \"automation/test\")\n+                Path(\"uv.lock\").write_text(\"updated lock\\n\")\n+                updater.run(\"git\", \"commit\", \"-am\", \"upgrade\")\n+                original = updater.run(\"git\", \"rev-parse\", \"HEAD\")\n+                updater.run(\"git\", \"push\", \"origin\", \"automation/test\")\n+                updater.run(\"git\", \"checkout\", \"main\")\n+                actual_run = updater.run\n+                with patch.object(\n+                    updater,\n+                    \"run\",\n+                    side_effect=lambda *args: (\n+                        \"[]\" if args[0] == \"gh\" else actual_run(*args)\n+                    ),\n+                ):\n+                    branch, is_open = updater.prepare_branch(\"automation/test\")\n+                self.assertFalse(is_open)\n+                self.assertEqual(branch, \"automation/test\")\n+                self.assertEqual(updater.run(\"git\", \"rev-parse\", \"HEAD\"), original)\n+                self.assertEqual(Path(\"uv.lock\").read_text(), \"updated lock\\n\")\n+            finally:\n+                os.chdir(old)\n+\n+    def test_publication_dependency_and_weekly_triggers(self):\n+        # A failed/skipped publication prevents the dependent job by GitHub's\n+        # default success() condition; there is deliberately no always() override.\n+        release = yaml.load(\n+            (ROOT / \".github/workflows/integration-package-release.yaml\").read_text(),\n+            Loader=yaml.BaseLoader,\n+        )\n+        job = release[\"jobs\"][\"update-integration-lock\"]\n+        self.assertIn(\"publish-pypi-dists\", job[\"needs\"])\n+        self.assertNotIn(\"if\", job)\n+        workflow = yaml.load(\n+            (ROOT / \".github/workflows/update-uv-lock-integrations.yaml\").read_text(),\n+            Loader=yaml.BaseLoader,\n+        )\n+        self.assertNotIn(\"push\", workflow[\"on\"])\n+        self.assertEqual(\n+            set(workflow[\"on\"]), {\"workflow_call\", \"schedule\", \"workflow_dispatch\"}\n+        )\n+        self.assertEqual(workflow[\"on\"][\"schedule\"][0][\"cron\"], \"0 15 * * 1\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n", "problem_statement": "kubernetes images ship prefect-kubernetes 0.7.6 (from uv.lock) and miss observer fix #22965\n### Describe the current behavior\n\n`-kubernetes` images ship prefect-kubernetes 0.7.6, older than earlier images, so they miss observer fixes like #22965\n\nSince the Dockerfile started installing with `--constraint` from `uv.lock`\n(`uv export --frozen --all-extras` \u2192 `uv pip install --constraint /dist/constraints.txt`),\nthe `-kubernetes` images get whatever `prefect-kubernetes` version `uv.lock` pins.\n`uv.lock` pins `prefect-kubernetes` 0.7.6 and hasn't changed since 3.6.24:\n\n| ref | prefect-kubernetes in `uv.lock` |\n|---|---|\n| 3.6.24, 3.7.0, 3.8.0, 3.8.1, 3.8.8, 3.9.0, `main` | 0.7.6 |\n\nSo newer images ship an **older** prefect-kubernetes than 3.8.1 did, which was built\nbefore the constraint step:\n\n| image | prefect-kubernetes installed |\n|---|---|\n| `prefecthq/prefect:3.8.1-python3.12-kubernetes` | 0.7.11 |\n| `prefecthq/prefect:3.8.8-python3.12-kubernetes` | 0.7.6 |\n| `prefecthq/prefect:3.9.0-python3.12-kubernetes` | 0.7.6 |\n\nChecked with:\n\n    docker run --rm --entrypoint python prefecthq/prefect:3.9.0-python3.12-kubernetes \\\n      -c 'import importlib.metadata as m; print(m.version(\"prefect-kubernetes\"))'\n\n### Impact\n\nThe Kubernetes observer fix in #22965 (\"Deduplicate Kubernetes observer state checks...\",\nreleased in prefect-kubernetes 0.7.13) never reaches users of the official worker images.\nWithout it, every observer calls `GET /flow_runs/{id}` on every watch event for a Pending\npod. When many runs are submitted at once, this drove us into Prefect Cloud's\n429 rate limits.\n\nMoving from 3.8.1 to 3.9.0 also downgrades prefect-kubernetes from 0.7.11 to 0.7.6,\nwhich is unexpected for an image upgrade.\n\nNothing else blocks the newer version: `pip install --dry-run prefect-kubernetes==0.8.0`\nresolves cleanly inside the 3.9.0 image.\n\n### Version info\n\nprefect 3.9.0, image `prefecthq/prefect:3.9.0-python3.12-kubernetes`, Prefect Cloud.\n\n### Describe the proposed behavior\n\n- Bump the integration in the lock (`uv lock --upgrade-package prefect-kubernetes`), and\n- ideally upgrade the integration packages in `uv.lock` as part of the release process,\n  so the images don't silently fall behind the integrations they bundle.\n\n\n### Example Use\n\n_No response_\n\n### Additional context\n\n_No response_\nDocker images since 3.8.8 ship older prefect-redis and prefect-kubernetes\nSince #23225, the image installs integration versions from `uv.lock`, which pins old releases. Upgrading the image from 3.8.7 to 3.8.8 or later downgrades both integrations:\n\n| Package | 3.8.7 image | 3.8.8 and 3.9.0 images | Latest on PyPI |\n|---|---|---|---|\n| prefect-redis | 0.2.15 | 0.2.11 | 0.3.0 |\n| prefect-kubernetes | 0.7.13 | 0.7.6 | 0.8.0 |\n\n```bash\ndocker run --rm prefecthq/prefect:3.9.0-python3.14-kubernetes pip list | grep -E \"^prefect-(redis|kubernetes)\"\n```\n\n**Example of what breaks:** `prefect_redis.cleanup_queue` was added in prefect-redis 0.2.12 (#22109). A server set to `PREFECT_SERVER_WORKER_CHANNEL_CLEANUP_QUEUE_STORAGE=prefect_redis.cleanup_queue` fails with `ModuleNotFoundError` on these images.\n\n", "hints_text": "\n", "created_at": "2026-10-22T16:04:52Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23526, "instance_id": "PrefectHQ__prefect-23526", "issue_numbers": ["23525"], "base_commit": "b845691da027cf5c660a7daff6584067448d5fdd", "patch": "diff --git a/src/integrations/prefect-kubernetes/prefect_kubernetes/jobs.py b/src/integrations/prefect-kubernetes/prefect_kubernetes/jobs.py\nindex edc3f32c584f..8571d9e93d9c 100644\n--- a/src/integrations/prefect-kubernetes/prefect_kubernetes/jobs.py\n+++ b/src/integrations/prefect-kubernetes/prefect_kubernetes/jobs.py\n@@ -429,10 +429,12 @@ async def await_for_completion(self, print_func: Optional[Callable] = None):\n                 **self._kubernetes_job.api_kwargs,\n             )\n \n-            job_is_terminal = any(\n-                condition.type in (\"Complete\", \"Failed\") and condition.status == \"True\"\n+            true_condition_types = {\n+                condition.type\n                 for condition in v1_job.status.conditions or []\n-            )\n+                if condition.status == \"True\"\n+            }\n+            job_is_terminal = bool(true_condition_types & {\"Complete\", \"Failed\"})\n \n             for pod in v1_pod_list.items:\n                 pod_name = pod.metadata.name\n@@ -457,33 +459,30 @@ async def await_for_completion(self, print_func: Optional[Callable] = None):\n                     **self._kubernetes_job.api_kwargs,\n                 )\n \n-            if v1_job.status.active:\n+            # Only `Complete` and `Failed` are terminal. Interim conditions such as\n+            # `SuccessCriteriaMet` and `FailureTarget` (Kubernetes 1.31+) can be\n+            # observed before the terminal condition is set, so keep polling.\n+            if \"Complete\" in true_condition_types:\n+                self._completed = True\n+                self.logger.info(\n+                    f\"Job {v1_job.metadata.name!r} has \"\n+                    f\"completed with {v1_job.status.succeeded} pods.\"\n+                )\n+            elif \"Failed\" in true_condition_types:\n+                failed_conditions = [\n+                    condition.reason\n+                    for condition in v1_job.status.conditions\n+                    if condition.type == \"Failed\"\n+                ]\n+                raise RuntimeError(\n+                    f\"Job {v1_job.metadata.name!r} failed due to \"\n+                    f\"{failed_conditions}, check the Kubernetes pod logs \"\n+                    f\"for more information.\"\n+                )\n+            else:\n                 await sleep(self._kubernetes_job.interval_seconds)\n                 if self._kubernetes_job.timeout_seconds:\n                     elapsed_time += self._kubernetes_job.interval_seconds\n-            elif v1_job.status.conditions:\n-                final_completed_conditions = [\n-                    condition.type == \"Complete\"\n-                    for condition in v1_job.status.conditions\n-                    if condition.status == \"True\"\n-                ]\n-                if final_completed_conditions and any(final_completed_conditions):\n-                    self._completed = True\n-                    self.logger.info(\n-                        f\"Job {v1_job.metadata.name!r} has \"\n-                        f\"completed with {v1_job.status.succeeded} pods.\"\n-                    )\n-                elif final_completed_conditions:\n-                    failed_conditions = [\n-                        condition.reason\n-                        for condition in v1_job.status.conditions\n-                        if condition.type == \"Failed\"\n-                    ]\n-                    raise RuntimeError(\n-                        f\"Job {v1_job.metadata.name!r} failed due to \"\n-                        f\"{failed_conditions}, check the Kubernetes pod logs \"\n-                        f\"for more information.\"\n-                    )\n \n         if self._kubernetes_job.delete_after_completion:\n             await self._cleanup()\n", "test_patch": "diff --git a/src/integrations/prefect-kubernetes/tests/test_flows.py b/src/integrations/prefect-kubernetes/tests/test_flows.py\nindex ba246387d4fc..c0724b468e85 100644\n--- a/src/integrations/prefect-kubernetes/tests/test_flows.py\n+++ b/src/integrations/prefect-kubernetes/tests/test_flows.py\n@@ -310,3 +310,92 @@ async def test_run_namespaced_job_streams_logs_before_job_completes(\n     assert capsys.readouterr().out == \"test log\\n\"\n     assert pod_logs == {\"test-pod\": \"partial logs\\n\"}\n     assert read_pod_logs.call_count == 1\n+\n+\n+@pytest.fixture\n+def job_observations(mock_read_namespaced_job, mock_list_namespaced_pod):\n+    \"\"\"Configure the sequence of job statuses observed while polling.\"\"\"\n+\n+    def configure(*statuses: models.V1JobStatus):\n+        observations = iter(statuses)\n+\n+        async def read_job(*args, **kwargs):\n+            return _job_with_status(next(observations))\n+\n+        mock_read_namespaced_job.side_effect = read_job\n+        mock_list_namespaced_pod.return_value = _pod_list(\"Succeeded\")\n+\n+    return configure\n+\n+\n+async def test_run_namespaced_job_waits_for_complete_after_success_criteria_met(\n+    valid_kubernetes_job_block,\n+    mock_create_namespaced_job,\n+    mock_read_namespaced_job,\n+    mock_delete_namespaced_job,\n+    job_observations,\n+    read_pod_logs,\n+):\n+    job_observations(\n+        models.V1JobStatus(\n+            active=0,\n+            succeeded=1,\n+            conditions=[\n+                models.V1JobCondition(type=\"SuccessCriteriaMet\", status=\"True\")\n+            ],\n+        ),\n+        models.V1JobStatus(\n+            active=0,\n+            succeeded=1,\n+            conditions=[\n+                models.V1JobCondition(type=\"SuccessCriteriaMet\", status=\"True\"),\n+                models.V1JobCondition(type=\"Complete\", status=\"True\"),\n+            ],\n+        ),\n+    )\n+    valid_kubernetes_job_block.interval_seconds = 0\n+\n+    await run_namespaced_job_async(kubernetes_job=valid_kubernetes_job_block)\n+\n+    assert mock_read_namespaced_job.call_count == 2\n+    assert mock_delete_namespaced_job.call_count == 1\n+\n+\n+async def test_run_namespaced_job_waits_for_failed_after_failure_target(\n+    valid_kubernetes_job_block,\n+    mock_create_namespaced_job,\n+    mock_read_namespaced_job,\n+    mock_delete_namespaced_job,\n+    job_observations,\n+    read_pod_logs,\n+):\n+    job_observations(\n+        models.V1JobStatus(\n+            active=0,\n+            failed=1,\n+            conditions=[\n+                models.V1JobCondition(\n+                    type=\"FailureTarget\", status=\"True\", reason=\"BackoffLimitExceeded\"\n+                )\n+            ],\n+        ),\n+        models.V1JobStatus(\n+            active=0,\n+            failed=1,\n+            conditions=[\n+                models.V1JobCondition(\n+                    type=\"FailureTarget\", status=\"True\", reason=\"BackoffLimitExceeded\"\n+                ),\n+                models.V1JobCondition(\n+                    type=\"Failed\", status=\"True\", reason=\"BackoffLimitExceeded\"\n+                ),\n+            ],\n+        ),\n+    )\n+    valid_kubernetes_job_block.interval_seconds = 0\n+\n+    with pytest.raises(RuntimeError, match=r\"failed due to \\['BackoffLimitExceeded'\\]\"):\n+        await run_namespaced_job_async(kubernetes_job=valid_kubernetes_job_block)\n+\n+    assert mock_read_namespaced_job.call_count == 2\n+    assert mock_delete_namespaced_job.call_count == 0\n", "problem_statement": "KubernetesJob.wait_for_completion raises \"failed due to []\" on K8s 1.31+ SuccessCriteriaMet condition\n### Bug summary\n\nSince Kubernetes 1.31 (the `JobSuccessPolicy` / Job condition changes), a successful Job gets an interim `SuccessCriteriaMet=True` condition before `Complete=True`. If `await_for_completion` polls in that window, `final_completed_conditions` is non-empty but has no `Complete`, so it raises:\n\n```\nRuntimeError: Job 'my-job' failed due to [], check the Kubernetes pod logs for more information.\n```\n\nThe Job then goes on to succeed (exit code 0, `Complete=True` a few seconds later). In our case the caller treated the error as a real failure and discarded ~2h20m of work.\n\nRelevant code (`prefect_kubernetes/jobs.py`, current `main`):\n\n```python\nfinal_completed_conditions = [\n    condition.type == \"Complete\"\n    for condition in v1_job.status.conditions\n    if condition.status == \"True\"\n]\nif final_completed_conditions and any(final_completed_conditions):\n    self._completed = True\n    ...\nelif final_completed_conditions:\n    failed_conditions = [c.reason for c in v1_job.status.conditions if c.type == \"Failed\"]\n    raise RuntimeError(...)\n```\n\nAny true condition other than `Complete` is treated as a failure, including `SuccessCriteriaMet` (and `FailureTarget` before `Failed` is set).\n\n### Suggested fix\n\nTreat `SuccessCriteriaMet` as success (or keep polling until `Complete`), and only raise when `Failed=True`; otherwise keep polling.\n\n### Version info\n\nprefect-kubernetes 0.8.0 (same logic in earlier versions); GKE 1.35.\n\n", "hints_text": "", "created_at": "2026-10-22T15:51:30Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23521, "instance_id": "PrefectHQ__prefect-23521", "issue_numbers": ["23504"], "base_commit": "7d1688ff034a89a47c900c0e2951c78ff1979f0d", "patch": "diff --git a/src/prefect/cli/automation.py b/src/prefect/cli/automation.py\nindex 2efd2836426b..0f33c8f101ce 100644\n--- a/src/prefect/cli/automation.py\n+++ b/src/prefect/cli/automation.py\n@@ -333,15 +333,17 @@ async def delete(\n                 exit_with_error(\n                     \"Cannot provide an automation name or id when deleting all automations.\"\n                 )\n-            automations = await client.read_automations()\n-            if len(automations) == 0:\n+            total = 0\n+            while page := await client.read_automations(offset=total):\n+                total += len(page)\n+            if total == 0:\n                 exit_with_success(\"No automations found.\")\n \n             if _cli.is_interactive():\n                 from prefect.cli._prompts import confirm\n \n                 if not confirm(\n-                    f\"Are you sure you want to delete all {len(automations)} automations?\",\n+                    f\"Are you sure you want to delete all {total} automations?\",\n                     default=False,\n                     console=_cli.console,\n                 ):\n@@ -353,12 +355,16 @@ async def limited_delete(automation_id):\n                 async with semaphore:\n                     await client.delete_automation(automation_id)\n \n-            await asyncio.gather(\n-                *[limited_delete(automation.id) for automation in automations]\n-            )\n+            # Always read from the start: deleting shifts later pages.\n+            deleted = 0\n+            while page := await client.read_automations():\n+                await asyncio.gather(\n+                    *[limited_delete(automation.id) for automation in page]\n+                )\n+                deleted += len(page)\n \n-            plural = \"\" if len(automations) == 1 else \"s\"\n-            exit_with_success(f\"Deleted {len(automations)} automation{plural}.\")\n+            plural = \"\" if deleted == 1 else \"s\"\n+            exit_with_success(f\"Deleted {deleted} automation{plural}.\")\n \n         if not id and not name:\n             exit_with_error(\"Please provide either a name or an id.\")\n", "test_patch": "diff --git a/tests/events/client/cli/test_automations.py b/tests/events/client/cli/test_automations.py\nindex db8be6916ddc..7742744ff3d6 100644\n--- a/tests/events/client/cli/test_automations.py\n+++ b/tests/events/client/cli/test_automations.py\n@@ -42,7 +42,10 @@ def readchar():\n             sys.stdin.seek(position)\n         return sys.stdin.read(1)\n \n-    monkeypatch.setattr(\"readchar._posix_read.readchar\", readchar)\n+    try:\n+        monkeypatch.setattr(\"readchar._posix_read.readchar\", readchar)\n+    except (ImportError, AttributeError):\n+        monkeypatch.setattr(\"readchar._win_read.readchar\", readchar)\n \n \n @pytest.fixture\n@@ -933,7 +936,12 @@ def test_deleting_all_automations(\n     read_automations: mock.AsyncMock,\n     various_automations: List[Automation],\n ):\n-    read_automations.return_value = various_automations\n+    read_automations.side_effect = [\n+        various_automations,\n+        [],\n+        various_automations,\n+        [],\n+    ]\n     invoke_and_assert(\n         [\"automations\", \"delete\", \"--all\"],\n         prompts_and_responses=[\n@@ -954,7 +962,10 @@ def test_deleting_all_automations_aborted(\n     read_automations: mock.AsyncMock,\n     various_automations: List[Automation],\n ):\n-    read_automations.return_value = various_automations\n+    read_automations.side_effect = [\n+        various_automations,\n+        [],\n+    ]\n     invoke_and_assert(\n         [\"automations\", \"delete\", \"--all\"],\n         prompts_and_responses=[\n@@ -970,6 +981,35 @@ def test_deleting_all_automations_aborted(\n     delete_automation.assert_not_called()\n \n \n+def test_deleting_all_automations_across_pages(\n+    delete_automation: mock.AsyncMock,\n+    read_automations: mock.AsyncMock,\n+    various_automations: List[Automation],\n+):\n+    page1 = various_automations[:3]\n+    page2 = various_automations[3:]\n+    read_automations.side_effect = [\n+        page1,\n+        page2,\n+        [],\n+        page1,\n+        page2,\n+        [],\n+    ]\n+    invoke_and_assert(\n+        [\"automations\", \"delete\", \"--all\"],\n+        prompts_and_responses=[\n+            (\n+                f\"Are you sure you want to delete all {len(various_automations)} automations?\",\n+                \"y\",\n+            )\n+        ],\n+        expected_code=0,\n+        expected_output_contains=[f\"Deleted {len(various_automations)} automations.\"],\n+    )\n+    assert delete_automation.await_count == len(various_automations)\n+\n+\n def test_deleting_all_automations_when_none_exist(\n     delete_automation: mock.AsyncMock,\n     read_automations: mock.AsyncMock,\n", "problem_statement": "`prefect automation delete --all` leaves automations behind when there are more than 200\n### Bug summary\n\n`prefect automation delete --all` reads automations with a single `client.read_automations()` call and no paging. The server returns at most `PREFECT_SERVER_API_DEFAULT_LIMIT` rows (200 by default) for that call, so with more than 200 automations the command:\n\n- asks \"Are you sure you want to delete all 200 automations?\" instead of the real count,\n- deletes only the first 200,\n- reports \"Deleted 200 automations.\" and exits 0 while the remaining automations still exist.\n\nThis is the same failure that #23440 fixed for `prefect deployment delete --all`. #23449 mentions it as still present.\n\n### Reproduction\n\n1. Create 201 or more automations.\n2. Run `prefect automation delete --all` and confirm.\n3. Run `prefect automation ls`. Automations remain.\n\n### Version info\n\nCurrent `main` (1ef3e51).\n", "hints_text": "I'd like to work on this one.\n\nThis is the same failure that #23440 fixed for `prefect deployment delete --all`, so I'll mirror that fix rather than invent a new approach:\n\n- The confirmation count comes from paging `read_automations(offset=...)` until an empty page. Summing page sizes gives the exact total even if row order varies between requests.\n- Deletion repeatedly reads the first page and deletes it until nothing is left. Offset paging while collecting IDs isn't safe here: the default `NAME_ASC` sort has no tiebreaker and automation names are not unique, so when same-named automations straddle a page boundary one can be returned twice and another skipped. Reading from offset 0 each time doesn't depend on order, and every successful delete shrinks the result set, so the loop terminates.\n- The reported `Deleted N automations.` is the number actually deleted.\n\nThe CLI contract in `src/prefect/cli/AGENTS.md` calls for exactly this (\"`--all`/bulk commands must loop on `offset`... re-read from offset 0 each pass\"), so this also fixes the `automation delete --all` command's deviation from it.\n\nI'll add tests that fail on the current code: a paged server double that serves the API's 200-row default limit, plus a real-server test with several same-named automations served two at a time.\n", "created_at": "2026-10-22T06:44:25Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23515, "instance_id": "PrefectHQ__prefect-23515", "issue_numbers": ["23514"], "base_commit": "7d1688ff034a89a47c900c0e2951c78ff1979f0d", "patch": "diff --git a/src/prefect/utilities/collections.py b/src/prefect/utilities/collections.py\nindex 465f50a2a498..4f515ec1aaa4 100644\n--- a/src/prefect/utilities/collections.py\n+++ b/src/prefect/utilities/collections.py\n@@ -543,8 +543,10 @@ def visit_expression(expr: Any) -> Any:\n                 model_instance = expr.model_construct(\n                     _fields_set=expr.model_fields_set, **updated_data\n                 )\n-                for private_attr in expr.__private_attributes__:\n-                    setattr(model_instance, private_attr, getattr(expr, private_attr))\n+                # Only copy private attributes that have values; unset\n+                # private attributes are absent from `__pydantic_private__`\n+                for private_attr, value in (expr.__pydantic_private__ or {}).items():\n+                    setattr(model_instance, private_attr, value)\n                 result = model_instance\n \n     # Update the cache with the final transformed result\n", "test_patch": "diff --git a/tests/test_task_engine.py b/tests/test_task_engine.py\nindex 940b4f1a826a..23692b73210b 100644\n--- a/tests/test_task_engine.py\n+++ b/tests/test_task_engine.py\n@@ -13,6 +13,7 @@\n from uuid import UUID, uuid4\n \n import anyio\n+import pydantic\n import pytest\n \n from prefect import Task, flow, tags, task\n@@ -57,7 +58,7 @@\n from prefect.testing.utilities import exceptions_equal\n from prefect.transactions import transaction\n from prefect.types._datetime import now\n-from prefect.utilities.annotations import opaque\n+from prefect.utilities.annotations import opaque, quote\n from prefect.utilities.callables import get_call_parameters\n from prefect.utilities.engine import propose_state\n from prefect.utilities.math import clamped_poisson_interval\n@@ -4041,6 +4042,36 @@ def my_task():\n             assert engine.state.name == \"Retrying\"\n \n \n+class TestPydanticTaskArgumentWithUnsetPrivateAttributes:\n+    \"\"\"Regression tests for https://github.com/PrefectHQ/prefect/issues/23514\"\"\"\n+\n+    class Document(pydantic.BaseModel):\n+        text: Any\n+        _cache: dict[str, Any] = pydantic.PrivateAttr()\n+\n+    def test_sync_task(self):\n+        @task\n+        def read(document: Any) -> tuple[str, bool]:\n+            return document.text, hasattr(document, \"_cache\")\n+\n+        @flow\n+        def my_flow() -> tuple[str, bool]:\n+            return read(self.Document(text=quote(\"parsed text\")))\n+\n+        assert my_flow() == (\"parsed text\", False)\n+\n+    async def test_async_task(self):\n+        @task\n+        async def read(document: Any) -> tuple[str, bool]:\n+            return document.text, hasattr(document, \"_cache\")\n+\n+        @flow\n+        async def my_flow() -> tuple[str, bool]:\n+            return await read(self.Document(text=quote(\"parsed text\")))\n+\n+        assert await my_flow() == (\"parsed text\", False)\n+\n+\n class TestRunSchemaObjectAsTaskArgument:\n     \"\"\"Passing a Prefect run schema (FlowRun, TaskRun) directly to a task\n     should raise a clear error instead of silently traversing into its\ndiff --git a/tests/utilities/test_collections.py b/tests/utilities/test_collections.py\nindex 48eac033b55e..99135188d800 100644\n--- a/tests/utilities/test_collections.py\n+++ b/tests/utilities/test_collections.py\n@@ -394,6 +394,30 @@ def test_visit_collection_mutation_with_private_pydantic_attributes(\n                 f\"The field '{field}' should be set in the result\"\n             )\n \n+    @pytest.mark.parametrize(\"immutable\", [True, False])\n+    @pytest.mark.parametrize(\n+        \"private_values\", [{}, {\"_y\": 3}, {\"_z\": 4}], ids=[\"none\", \"_y\", \"_z\"]\n+    )\n+    def test_visit_collection_mutation_with_unset_private_pydantic_attributes(\n+        self, immutable: bool, private_values: dict[str, int]\n+    ):\n+        model = ImmutablePrivatePydantic if immutable else PrivatePydantic\n+        model_instance = model(x=2)\n+        for name, value in private_values.items():\n+            setattr(model_instance, name, value)\n+\n+        result = visit_collection(\n+            model_instance, visit_fn=negative_even_numbers, return_data=True\n+        )\n+\n+        assert isinstance(result, model)\n+        assert result.x == -2\n+        for name in (\"_y\", \"_z\"):\n+            if name in private_values:\n+                assert getattr(result, name) == private_values[name]\n+            else:\n+                assert not hasattr(result, name)\n+\n     def test_visit_collection_recursive_1(self):\n         obj = dict()\n         obj[\"a\"] = obj\n", "problem_statement": "Pydantic task inputs with unset private attributes fail during resolution\n### Bug summary\r\n\r\nResolving a Pydantic model containing an uninitialized private attribute fails as soon as a public field is transformed. The model itself is valid: `PrivateAttr()` does not require a value. This prevents task input resolution even though the private attribute is not a task dependency.\r\n\r\nReproduced against unchanged main `7d1688ff034a89a47c900c0e2951c78ff1979f0d`:\r\n\r\n```python\r\nimport asyncio\r\nfrom typing import Any\r\nfrom pydantic import BaseModel, PrivateAttr\r\nfrom prefect.utilities.annotations import quote\r\nfrom prefect.utilities.engine import resolve_inputs, resolve_inputs_sync\r\n\r\nclass Document(BaseModel):\r\n    text: Any\r\n    _cache: dict[str, Any] = PrivateAttr()\r\n\r\ndocument = Document(text=quote(\"parsed text\"))\r\nassert not hasattr(document, \"_cache\")\r\n\r\n# Run either line independently; both raise PrefectException caused by\r\n# AttributeError: 'Document' object has no attribute '_cache'.\r\nresolve_inputs_sync({\"document\": document})\r\nasyncio.run(resolve_inputs({\"document\": document}))\r\n```\r\n\r\nActual error:\r\n\r\n```text\r\nPrefectException: Failed to resolve inputs in parameter 'document'. If your parameter type is not supported, consider using the `quote` annotation to skip resolution of inputs, or the `opaque` annotation to resolve the value without traversing its contents.\r\nCause: AttributeError: 'Document' object has no attribute '_cache'\r\n```\r\n\r\nThe lower-level `visit_collection(Document(text=2), lambda value: -value if isinstance(value, int) else value, return_data=True)` also raises the same AttributeError. Its model-reconstruction branch iterates over all declared private attributes and calls `getattr` without checking whether they have values.\r\n\r\nExpected: resolve the public field to `\"parsed text\"`, leave `_cache` unset, and retain any private attributes that do have values without traversing them. Both synchronous and asynchronous resolution should work.\r\n\r\n### Version info\r\n\r\n```text\r\nVersion:              3.6.24\r\nAPI version:          0.8.4\r\nPython version:       3.12.8\r\nGit commit:           7d1688ff\r\nOS/Arch:              win32/AMD64\r\nProfile:              ephemeral\r\nServer type:          unconfigured\r\nPydantic version:     2.14.1\r\n```\r\n\r\n### Proposed scope\r\n\r\nI plan to add a small guard when copying private attributes in `visit_collection`, with regressions for implicit/explicit unset attributes, frozen models, retained initialized attributes, and both input resolvers. This keeps the existing reconstruction and dependency-resolution behavior; it does not change public signatures or require a server.\r\n\r\nCodex assisted with investigation and ran the reproduction above against the unmodified checkout; these are automated observations, not a claim of manual human testing.\r\n\r\n\n", "hints_text": "", "created_at": "2026-10-21T19:10:33Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23494, "instance_id": "PrefectHQ__prefect-23494", "issue_numbers": ["23491"], "base_commit": "b2be1a403d2c0e4d9eb26cfc62f48752e5a55094", "patch": "diff --git a/src/prefect/utilities/templating/__init__.py b/src/prefect/utilities/templating/__init__.py\nindex 726b76177502..7e5213105d69 100644\n--- a/src/prefect/utilities/templating/__init__.py\n+++ b/src/prefect/utilities/templating/__init__.py\n@@ -201,6 +201,7 @@ def apply_values(\n                 )\n             return value\n         else:\n+            replacements: dict[str, str] = {}\n             for full_match, name, placeholder_type in placeholders:\n                 if placeholder_type is PlaceholderType.STANDARD:\n                     value = get_from_dict(values, name, NotSet)\n@@ -217,11 +218,16 @@ def apply_values(\n                             \"the placeholder is spelled correctly and that the corresponding value is provided.\",\n                         )\n                     if remove_notset:\n-                        template = template.replace(full_match, \"\")\n+                        replacements[full_match] = \"\"\n                 else:\n-                    template = template.replace(full_match, str(value))\n+                    replacements[full_match] = str(value)\n \n-            return template\n+            # Substitute in a single pass over the original template so that\n+            # inserted values are never themselves treated as placeholders.\n+            return PLACEHOLDER_CAPTURE_REGEX.sub(\n+                lambda match: replacements.get(match.group(1), match.group(1)),\n+                template,\n+            )\n     elif isinstance(template, dict):\n         updated_template: dict[str, Any] = {}\n         for key, value in template.items():\n", "test_patch": "diff --git a/tests/utilities/test_templating.py b/tests/utilities/test_templating.py\nindex 93db9182ba80..6bd1843d5bfa 100644\n--- a/tests/utilities/test_templating.py\n+++ b/tests/utilities/test_templating.py\n@@ -156,6 +156,24 @@ def test_apply_values_simple_string_with_multiple_placeholders(self):\n             == \"Hello, Alice Smith!\"\n         )\n \n+    def test_apply_values_does_not_substitute_inserted_placeholders(self):\n+        assert (\n+            apply_values(\n+                \"prefix {{ first }} / {{ second }}\",\n+                {\"first\": \"{{ second }}\", \"second\": \"resolved\"},\n+            )\n+            == \"prefix {{ second }} / resolved\"\n+        )\n+\n+    def test_apply_values_does_not_substitute_placeholders_inserted_from_env_vars(\n+        self, monkeypatch: pytest.MonkeyPatch\n+    ):\n+        monkeypatch.setenv(\"TEMPLATED_ENV_VAR\", \"{{ name }}\")\n+        assert (\n+            apply_values(\"{{ $TEMPLATED_ENV_VAR }} and {{ name }}\", {\"name\": \"Alice\"})\n+            == \"{{ name }} and Alice\"\n+        )\n+\n     def test_apply_values_dictionary_with_placeholders(self):\n         template = {\"name\": \"{{first_name}} {{last_name}}\", \"age\": \"{{age}}\"}\n         values = {\"first_name\": \"Alice\", \"last_name\": \"Smith\", \"age\": 30}\n", "problem_statement": "apply_values can substitute inserted values again depending on hash order\n`apply_values` can replace a placeholder introduced by another replacement in the same call. Because the discovered placeholders are a set, the same template produces different deployment values with different Python hash seeds.\n\n```python\nfrom prefect.utilities.templating import apply_values\n\nprint(apply_values(\n    \"prefix {{ first }} / {{ second }}\",\n    {\"first\": \"{{ second }}\", \"second\": \"resolved\"},\n))\n```\n\nOn current main `b2be1a403d2c0e4d9eb26cfc62f48752e5a55094`, Python 3.12.14, macOS arm64:\n\n- `PYTHONHASHSEED=0`: `prefix {{ second }} / resolved`\n- `PYTHONHASHSEED=1`: `prefix resolved / resolved`\n\nExpected: substitute only the placeholders in the input for each call, consistently yielding the first result; a caller can explicitly run another pass when needed. Whole-string replacement already preserves the supplied value verbatim. This also affects environment values containing placeholder syntax.\n\nI plan a focused change that collects replacement values and substitutes the original input in a single regex pass, preserving whole-string typed values, skipped prefixes, missing-value handling and the existing explicit multi-pass deployment pipeline. Codex executed this reproduction and assisted with the report.\n\n", "hints_text": "", "created_at": "2026-10-20T21:51:50Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23493, "instance_id": "PrefectHQ__prefect-23493", "issue_numbers": ["23492"], "base_commit": "b2be1a403d2c0e4d9eb26cfc62f48752e5a55094", "patch": "diff --git a/src/prefect/utilities/urls.py b/src/prefect/utilities/urls.py\nindex 20c014b04178..b371459aad10 100644\n--- a/src/prefect/utilities/urls.py\n+++ b/src/prefect/utilities/urls.py\n@@ -345,6 +345,11 @@ def convert_class_to_name(obj: Any) -> str:\n     return \"\".join([\"-\" + i.lower() if i.isupper() else i for i in name]).lstrip(\"-\")\n \n \n+def _quote_path_segment(value: Any) -> str:\n+    \"\"\"Percent-encode a value so it is interpolated as a single URL path segment.\"\"\"\n+    return urllib.parse.quote(str(value), safe=\"\")\n+\n+\n def url_for(\n     obj: Union[\n         \"PrefectFuture[Any]\",\n@@ -473,6 +478,8 @@ def url_for(\n     )\n     assert url_format is not None\n \n+    obj_id = _quote_path_segment(obj_id)\n+\n     # Use duck-typing to handle both client-side and server-side ReceivedEvent\n     if name == \"received-event\" and hasattr(obj, \"occurred\"):\n         # Cast to ReceivedEvent for type checking - we've verified it has the\n@@ -493,7 +500,13 @@ def url_for(\n                 f\"Unable to generate URL for {name} because the following keys are missing: {', '.join(obj_keys)}\"\n             )\n \n-        url = url_format.format(obj_id=obj_id, **additional_format_kwargs)\n+        url = url_format.format(\n+            obj_id=obj_id,\n+            **{\n+                key: _quote_path_segment(additional_format_kwargs[key])\n+                for key in obj_keys\n+            },\n+        )\n \n     if not base_url.endswith(\"/\"):\n         base_url += \"/\"\n", "test_patch": "diff --git a/tests/utilities/test_urls.py b/tests/utilities/test_urls.py\nindex 11ec3d60b876..d145704e44c9 100644\n--- a/tests/utilities/test_urls.py\n+++ b/tests/utilities/test_urls.py\n@@ -1,6 +1,7 @@\n import concurrent.futures\n import socket\n import threading\n+import urllib.parse\n import uuid\n from datetime import timedelta\n from typing import Any, Literal, cast\n@@ -11,6 +12,7 @@\n import pytest\n \n from prefect.blocks.webhook import Webhook\n+from prefect.client.schemas.objects import WorkPool\n from prefect.events.schemas.automations import Automation, EventTrigger, Posture\n from prefect.events.schemas.events import ReceivedEvent, Resource\n from prefect.futures import PrefectConcurrentFuture, PrefectDistributedFuture\n@@ -465,6 +467,42 @@ def test_url_for_with_additional_format_kwargs():\n         )\n \n \n+@pytest.mark.parametrize(\n+    \"url_type, base_url, expected_path\",\n+    [\n+        (\"ui\", MOCK_PREFECT_UI_URL, \"work-pools/work-pool/gpu%23west%3Fblue\"),\n+        (\"api\", MOCK_PREFECT_API_URL, \"work_pools/gpu%23west%3Fblue\"),\n+    ],\n+)\n+def test_url_for_work_pool_encodes_name_as_single_path_segment(\n+    url_type: Literal[\"ui\", \"api\"], base_url: str, expected_path: str\n+):\n+    work_pool = WorkPool(name=\"gpu#west?blue\", type=\"process\")\n+    with temporary_settings(\n+        {PREFECT_UI_URL: MOCK_PREFECT_UI_URL, PREFECT_API_URL: MOCK_PREFECT_API_URL}\n+    ):\n+        url = url_for(obj=work_pool, url_type=url_type)\n+\n+    assert url == f\"{base_url}/{expected_path}\"\n+    parsed = urllib.parse.urlparse(url)\n+    assert parsed.query == \"\"\n+    assert parsed.fragment == \"\"\n+\n+\n+def test_url_for_worker_encodes_work_pool_name():\n+    with temporary_settings({PREFECT_UI_URL: MOCK_PREFECT_UI_URL}):\n+        url = url_for(\n+            obj=\"worker\",\n+            obj_id=\"123e4567-e89b-12d3-a456-426614174000\",\n+            work_pool_name=\"gpu#west?blue\",\n+        )\n+\n+    assert (\n+        url\n+        == f\"{MOCK_PREFECT_UI_URL}/work-pools/work-pool/gpu%23west%3Fblue/worker/123e4567-e89b-12d3-a456-426614174000\"\n+    )\n+\n+\n def test_url_for_with_additional_format_kwargs_raises_if_placeholder_not_replaced():\n     with pytest.raises(\n         ValueError,\n", "problem_statement": "url_for splits valid work pool names into URL fragments or queries\n`url_for` inserts a work pool name directly into URL paths. Work pool names containing `#` or `?` pass the current `Name` validation, but the generated link treats part of the name as a fragment or query instead of the pool's path segment. This affects both UI and API URLs, and the pool-name segment in worker UI links.\n\n```python\nfrom prefect.client.schemas.objects import WorkPool\nfrom prefect.utilities.urls import url_for\n\npool = WorkPool(name=\"gpu#west?blue\", type=\"process\")\nprint(url_for(pool, default_base_url=\"https://prefect.example.com\"))\nprint(url_for(pool, url_type=\"api\", default_base_url=\"https://prefect.example.com/api\"))\n```\n\nWith no configured UI/API URL, current main `b2be1a403d2c0e4d9eb26cfc62f48752e5a55094` produces:\n\n```text\nhttps://prefect.example.com/work-pools/work-pool/gpu#west?blue\nhttps://prefect.example.com/api/work_pools/gpu#west?blue\n```\n\nExpected: the name is encoded as `gpu%23west%3Fblue`, so it stays one path segment, with no query or fragment.\n\nI plan a narrow fix in `url_for` that percent-encodes interpolated identifier/name path values and adds behavior tests for UI, API and worker links. Existing UUIDs, base URL configuration, missing-key checks and event dates remain unchanged. This does not change name validation or the HTTP client's methods. Codex executed the reproduction locally on Python 3.12.14/macOS arm64 and assisted with this report.\n\n", "hints_text": "", "created_at": "2026-10-20T21:51:23Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23490, "instance_id": "PrefectHQ__prefect-23490", "issue_numbers": ["21566"], "base_commit": "3868a14759a02defa72f69df66ab48aaec0cc269", "patch": "diff --git a/src/prefect/server/api/__init__.py b/src/prefect/server/api/__init__.py\nindex 2d8d1b74e17a..44a39b63a62a 100644\n--- a/src/prefect/server/api/__init__.py\n+++ b/src/prefect/server/api/__init__.py\n@@ -24,6 +24,7 @@\n         flows,\n         logs,\n         middleware,\n+        observed_states,\n         root,\n         run_history,\n         saved_searches,\n@@ -58,6 +59,7 @@\n     \"flows\",\n     \"logs\",\n     \"middleware\",\n+    \"observed_states\",\n     \"root\",\n     \"run_history\",\n     \"saved_searches\",\ndiff --git a/src/prefect/server/api/observed_states.py b/src/prefect/server/api/observed_states.py\nnew file mode 100644\nindex 000000000000..ddc4489c2b10\n--- /dev/null\n+++ b/src/prefect/server/api/observed_states.py\n@@ -0,0 +1,32 @@\n+\"\"\"Routes for discovering observed state types and names.\"\"\"\n+\n+from typing import Annotated\n+\n+from fastapi import Depends, Query\n+\n+from prefect.server import models\n+from prefect.server.database import PrefectDBInterface, provide_database_interface\n+from prefect.server.schemas.observed_states import ObservedState, ObservedStateSort\n+from prefect.server.utilities.server import PrefectRouter\n+\n+router: PrefectRouter = PrefectRouter(\n+    prefix=\"/observed-states\", tags=[\"Observed States\"]\n+)\n+\n+\n+@router.get(\"\")\n+async def read_observed_states(\n+    db: Annotated[PrefectDBInterface, Depends(provide_database_interface)],\n+    query: Annotated[str | None, Query(max_length=100)] = None,\n+    order_by: ObservedStateSort = ObservedStateSort.LAST_SEEN_DESC,\n+    limit: Annotated[int, Query(ge=1, le=200)] = 200,\n+) -> list[ObservedState]:\n+    \"\"\"Discover exact state names and types from retained run transitions.\n+\n+    Search by case-insensitive name or type prefix. Timestamps describe retained\n+    history; deleting runs can change them or remove a state from the results.\n+    \"\"\"\n+    async with db.session_context() as session:\n+        return await models.observed_states.read_observed_states(\n+            session=session, query=query, order_by=order_by, limit=limit\n+        )\ndiff --git a/src/prefect/server/api/server.py b/src/prefect/server/api/server.py\nindex 76b0fc93174d..0f3a20386c99 100644\n--- a/src/prefect/server/api/server.py\n+++ b/src/prefect/server/api/server.py\n@@ -105,6 +105,7 @@\n     api.task_runs.router,\n     api.flow_run_states.router,\n     api.task_run_states.router,\n+    api.observed_states.router,\n     api.deployments.router,\n     api.saved_searches.router,\n     api.logs.router,\ndiff --git a/src/prefect/server/database/_migrations/MIGRATION-NOTES.md b/src/prefect/server/database/_migrations/MIGRATION-NOTES.md\nindex c903ced1396e..4b87e9c351ca 100644\n--- a/src/prefect/server/database/_migrations/MIGRATION-NOTES.md\n+++ b/src/prefect/server/database/_migrations/MIGRATION-NOTES.md\n@@ -8,6 +8,15 @@ Each time a database migration is written, an entry is included here with:\n \n This gives us a history of changes and will create merge conflicts if two migrations are made at once, flagging situations where a branch needs to be updated before merging.\n \n+# Add observed state covering indexes\n+SQLite: `27d8f4e1a6c9`\n+Postgres: `91e2b8f3d6a4`\n+\n+SQLite adds `(type, name, timestamp)` indexes to both run state histories for\n+observed state aggregation. Building them scans retained history and requires\n+additional disk space; SQLite holds its write lock during the migration.\n+Downgrading drops the indexes. The PostgreSQL companion is a no-op.\n+\n # Add `automation_held_event` table\n SQLite: `8f5eda7c1dd7`\n Postgres: `e7f54680bce3`\ndiff --git a/src/prefect/server/database/_migrations/versions/postgresql/2026_10_20_000000_91e2b8f3d6a4_observed_state_covering_indexes.py b/src/prefect/server/database/_migrations/versions/postgresql/2026_10_20_000000_91e2b8f3d6a4_observed_state_covering_indexes.py\nnew file mode 100644\nindex 000000000000..6061483e3ff8\n--- /dev/null\n+++ b/src/prefect/server/database/_migrations/versions/postgresql/2026_10_20_000000_91e2b8f3d6a4_observed_state_covering_indexes.py\n@@ -0,0 +1,21 @@\n+\"\"\"Companion to SQLite observed state covering indexes.\n+\n+Revision ID: 91e2b8f3d6a4\n+Revises: e7f54680bce3\n+Create Date: 2026-10-20 00:00:00.000000\n+\n+PostgreSQL's existing indexes and parallel aggregation already serve this query.\n+\"\"\"\n+\n+revision = \"91e2b8f3d6a4\"\n+down_revision = \"e7f54680bce3\"\n+branch_labels = None\n+depends_on = None\n+\n+\n+def upgrade():\n+    pass\n+\n+\n+def downgrade():\n+    pass\ndiff --git a/src/prefect/server/database/_migrations/versions/sqlite/2026_10_20_000000_27d8f4e1a6c9_observed_state_covering_indexes.py b/src/prefect/server/database/_migrations/versions/sqlite/2026_10_20_000000_27d8f4e1a6c9_observed_state_covering_indexes.py\nnew file mode 100644\nindex 000000000000..3e1534819fa3\n--- /dev/null\n+++ b/src/prefect/server/database/_migrations/versions/sqlite/2026_10_20_000000_27d8f4e1a6c9_observed_state_covering_indexes.py\n@@ -0,0 +1,25 @@\n+\"\"\"Add SQLite covering indexes for observed state discovery.\n+\n+Revision ID: 27d8f4e1a6c9\n+Revises: 8f5eda7c1dd7\n+Create Date: 2026-10-20 00:00:00.000000\n+\"\"\"\n+\n+from alembic import op\n+\n+revision = \"27d8f4e1a6c9\"\n+down_revision = \"8f5eda7c1dd7\"\n+branch_labels = None\n+depends_on = None\n+\n+\n+def upgrade():\n+    for table in (\"flow_run_state\", \"task_run_state\"):\n+        op.create_index(\n+            f\"ix_{table}__type_name_timestamp\", table, [\"type\", \"name\", \"timestamp\"]\n+        )\n+\n+\n+def downgrade():\n+    for table in (\"flow_run_state\", \"task_run_state\"):\n+        op.drop_index(f\"ix_{table}__type_name_timestamp\", table_name=table)\ndiff --git a/src/prefect/server/database/orm_models.py b/src/prefect/server/database/orm_models.py\nindex 9c47e9a3b21e..737a07557710 100644\n--- a/src/prefect/server/database/orm_models.py\n+++ b/src/prefect/server/database/orm_models.py\n@@ -218,6 +218,12 @@ def __table_args__(cls) -> Iterable[sa.Index]:\n                 cls.timestamp.desc(),\n                 unique=True,\n             ),\n+            sa.Index(\n+                \"ix_flow_run_state__type_name_timestamp\",\n+                cls.type,\n+                cls.name,\n+                cls.timestamp,\n+            ).ddl_if(dialect=\"sqlite\"),\n         )\n \n \n@@ -282,6 +288,12 @@ def __table_args__(cls) -> Iterable[sa.Index]:\n                 cls.timestamp.desc(),\n                 unique=True,\n             ),\n+            sa.Index(\n+                \"ix_task_run_state__type_name_timestamp\",\n+                cls.type,\n+                cls.name,\n+                cls.timestamp,\n+            ).ddl_if(dialect=\"sqlite\"),\n         )\n \n \ndiff --git a/src/prefect/server/models/__init__.py b/src/prefect/server/models/__init__.py\nindex 0a97c9b10ae5..167af5bf48a0 100644\n--- a/src/prefect/server/models/__init__.py\n+++ b/src/prefect/server/models/__init__.py\n@@ -14,6 +14,7 @@\n     flow_runs,\n     flows,\n     logs,\n+    observed_states,\n     saved_searches,\n     storage_defaults,\n     task_run_states,\ndiff --git a/src/prefect/server/models/observed_states.py b/src/prefect/server/models/observed_states.py\nnew file mode 100644\nindex 000000000000..10f506feb9f0\n--- /dev/null\n+++ b/src/prefect/server/models/observed_states.py\n@@ -0,0 +1,57 @@\n+\"\"\"Discover states from retained flow and task run transitions.\"\"\"\n+\n+import sqlalchemy as sa\n+from sqlalchemy.ext.asyncio import AsyncSession\n+\n+from prefect.server.database import PrefectDBInterface, db_injector\n+from prefect.server.schemas.observed_states import ObservedState, ObservedStateSort\n+\n+\n+@db_injector\n+async def read_observed_states(\n+    db: PrefectDBInterface,\n+    session: AsyncSession,\n+    query: str | None = None,\n+    order_by: ObservedStateSort = ObservedStateSort.LAST_SEEN_DESC,\n+    limit: int = 200,\n+) -> list[ObservedState]:\n+    \"\"\"Combine exact state pairs and timestamp bounds from retained run histories.\"\"\"\n+    # Group each history before combining them: the union only contains distinct\n+    # pairs, rather than every retained transition. SQLite uses covering indexes.\n+    histories = sa.union_all(\n+        *(\n+            sa.select(\n+                state.type.label(\"state_type\"),\n+                state.name.label(\"state_name\"),\n+                sa.func.min(state.timestamp).label(\"first_seen\"),\n+                sa.func.max(state.timestamp).label(\"last_seen\"),\n+            ).group_by(state.type, state.name)\n+            for state in (db.FlowRunState, db.TaskRunState)\n+        )\n+    ).subquery()\n+    observed = (\n+        sa.select(\n+            sa.cast(histories.c.state_type, sa.String).label(\"state_type\"),\n+            histories.c.state_name,\n+            sa.func.min(histories.c.first_seen).label(\"first_seen\"),\n+            sa.func.max(histories.c.last_seen).label(\"last_seen\"),\n+        )\n+        .group_by(histories.c.state_type, histories.c.state_name)\n+        # Prevent prefix predicates from being pushed into the full history scans.\n+        # OFFSET works on supported SQLite versions that predate MATERIALIZED CTEs.\n+        .offset(0)\n+        .subquery()\n+    )\n+    statement = sa.select(observed)\n+    if query and (prefix := query.strip()):\n+        statement = statement.where(\n+            sa.or_(\n+                observed.c.state_type.istartswith(prefix, autoescape=True),\n+                observed.c.state_name.istartswith(prefix, autoescape=True),\n+            )\n+        )\n+    ordering = [observed.c.state_type.asc(), observed.c.state_name.asc()]\n+    if order_by == ObservedStateSort.LAST_SEEN_DESC:\n+        ordering.insert(0, observed.c.last_seen.desc())\n+    result = await session.execute(statement.order_by(*ordering).limit(limit))\n+    return [ObservedState.model_validate(row) for row in result.mappings()]\ndiff --git a/src/prefect/server/schemas/__init__.py b/src/prefect/server/schemas/__init__.py\nindex bd99a6df96ee..aa97cb674a2a 100644\n--- a/src/prefect/server/schemas/__init__.py\n+++ b/src/prefect/server/schemas/__init__.py\n@@ -9,6 +9,7 @@\n         core,\n         filters,\n         internal,\n+        observed_states,\n         responses,\n         schedules,\n         sorting,\n@@ -22,6 +23,7 @@\n     \"core\",\n     \"filters\",\n     \"internal\",\n+    \"observed_states\",\n     \"responses\",\n     \"schedules\",\n     \"sorting\",\ndiff --git a/src/prefect/server/schemas/observed_states.py b/src/prefect/server/schemas/observed_states.py\nnew file mode 100644\nindex 000000000000..6126765a36ba\n--- /dev/null\n+++ b/src/prefect/server/schemas/observed_states.py\n@@ -0,0 +1,23 @@\n+\"\"\"Discovery of state types and exact names in retained run history.\"\"\"\n+\n+from pydantic import Field\n+\n+from prefect._internal.schemas.bases import PrefectBaseModel\n+from prefect.types._datetime import DateTime\n+from prefect.utilities.collections import AutoEnum\n+\n+\n+class ObservedStateSort(AutoEnum):\n+    \"\"\"Supported ordering for observed state discovery.\"\"\"\n+\n+    NAME_ASC = AutoEnum.auto()\n+    LAST_SEEN_DESC = AutoEnum.auto()\n+\n+\n+class ObservedState(PrefectBaseModel):\n+    \"\"\"An exact state type/name pair and the bounds of its retained transitions.\"\"\"\n+\n+    state_type: str = Field(description=\"The state type.\")\n+    state_name: str = Field(description=\"The exact state name.\")\n+    first_seen: DateTime = Field(description=\"Earliest retained transition timestamp.\")\n+    last_seen: DateTime = Field(description=\"Latest retained transition timestamp.\")\ndiff --git a/ui-v2/src/api/observed-states/index.ts b/ui-v2/src/api/observed-states/index.ts\nnew file mode 100644\nindex 000000000000..3ecd0492e4de\n--- /dev/null\n+++ b/ui-v2/src/api/observed-states/index.ts\n@@ -0,0 +1,59 @@\n+import { queryOptions, useQuery } from \"@tanstack/react-query\";\n+import { useMemo } from \"react\";\n+import { STATE_NAMES } from \"@/api/flow-runs/constants\";\n+import type { paths } from \"@/api/prefect\";\n+import { getQueryService } from \"@/api/service\";\n+import useDebounce from \"@/hooks/use-debounce\";\n+\n+type ObservedStatesQuery = NonNullable<\n+\tpaths[\"/observed-states\"][\"get\"][\"parameters\"][\"query\"]\n+>;\n+\n+export const buildObservedStatesQuery = (params: ObservedStatesQuery = {}) =>\n+\tqueryOptions({\n+\t\tqueryKey: [\"observed-states\", params],\n+\t\tqueryFn: async () => {\n+\t\t\tconst service = await getQueryService();\n+\t\t\tconst { data } = await service.GET(\"/observed-states\", {\n+\t\t\t\tparams: { query: params },\n+\t\t\t});\n+\t\t\treturn data ?? [];\n+\t\t},\n+\t\tstaleTime: 30_000,\n+\t\trefetchInterval: 30_000,\n+\t});\n+\n+// Keep built-ins and selected names available even when discovery is capped,\n+// still loading, unavailable, or the selected observation has been deleted.\n+export function useStateOptions(\n+\tsearch: string,\n+\tselected: string[],\n+\tenabled: boolean,\n+) {\n+\tconst query = useDebounce(search.trim().slice(0, 100), 300);\n+\tconst result = useQuery({\n+\t\t...buildObservedStatesQuery({ query, order_by: \"NAME_ASC\" }),\n+\t\tenabled,\n+\t});\n+\tconst names = useMemo(() => {\n+\t\tconst prefix = search.trim().toLowerCase();\n+\t\tconst local = [...STATE_NAMES, ...selected].filter((name) =>\n+\t\t\tname.toLowerCase().startsWith(prefix),\n+\t\t);\n+\t\tconst observed =\n+\t\t\tquery.toLowerCase() === prefix.slice(0, 100)\n+\t\t\t\t? (result.data ?? []).filter(\n+\t\t\t\t\t\t(state) =>\n+\t\t\t\t\t\t\tprefix.length <= 100 ||\n+\t\t\t\t\t\t\tstate.state_name.toLowerCase().startsWith(prefix),\n+\t\t\t\t\t)\n+\t\t\t\t: [];\n+\t\treturn [...new Set([...local, ...observed.map((s) => s.state_name)])];\n+\t}, [search, selected, result.data, query]);\n+\treturn {\n+\t\tdata: result.data,\n+\t\tisFetching: result.isFetching,\n+\t\tisError: result.isError,\n+\t\tnames,\n+\t};\n+}\ndiff --git a/ui-v2/src/api/prefect.ts b/ui-v2/src/api/prefect.ts\nindex 299e3ad2ed7a..72980ddb4038 100644\n--- a/ui-v2/src/api/prefect.ts\n+++ b/ui-v2/src/api/prefect.ts\n@@ -812,6 +812,29 @@ export interface paths {\n         patch?: never;\n         trace?: never;\n     };\n+    \"/observed-states\": {\n+        parameters: {\n+            query?: never;\n+            header?: never;\n+            path?: never;\n+            cookie?: never;\n+        };\n+        /**\n+         * Read Observed States\n+         * @description Discover exact state names and types from retained run transitions.\n+         *\n+         *     Search by case-insensitive name or type prefix. Timestamps describe retained\n+         *     history; deleting runs can change them or remove a state from the results.\n+         */\n+        get: operations[\"read_observed_states_observed_states_get\"];\n+        put?: never;\n+        post?: never;\n+        delete?: never;\n+        options?: never;\n+        head?: never;\n+        patch?: never;\n+        trace?: never;\n+    };\n     \"/deployments/\": {\n         parameters: {\n             query?: never;\n@@ -8949,6 +8972,40 @@ export interface components {\n             /** Artifacts */\n             artifacts: components[\"schemas\"][\"GraphArtifact\"][];\n         };\n+        /**\n+         * ObservedState\n+         * @description An exact state type/name pair and the bounds of its retained transitions.\n+         */\n+        ObservedState: {\n+            /**\n+             * State Type\n+             * @description The state type.\n+             */\n+            state_type: string;\n+            /**\n+             * State Name\n+             * @description The exact state name.\n+             */\n+            state_name: string;\n+            /**\n+             * First Seen\n+             * Format: date-time\n+             * @description Earliest retained transition timestamp.\n+             */\n+            first_seen: string;\n+            /**\n+             * Last Seen\n+             * Format: date-time\n+             * @description Latest retained transition timestamp.\n+             */\n+            last_seen: string;\n+        };\n+        /**\n+         * ObservedStateSort\n+         * @description Supported ordering for observed state discovery.\n+         * @enum {string}\n+         */\n+        ObservedStateSort: \"NAME_ASC\" | \"LAST_SEEN_DESC\";\n         /**\n          * Operator\n          * @description Operators for combining filter criteria.\n@@ -14577,6 +14634,41 @@ export interface operations {\n             };\n         };\n     };\n+    read_observed_states_observed_states_get: {\n+        parameters: {\n+            query?: {\n+                query?: string | null;\n+                order_by?: components[\"schemas\"][\"ObservedStateSort\"];\n+                limit?: number;\n+            };\n+            header?: {\n+                \"x-prefect-api-version\"?: string;\n+            };\n+            path?: never;\n+            cookie?: never;\n+        };\n+        requestBody?: never;\n+        responses: {\n+            /** @description Successful Response */\n+            200: {\n+                headers: {\n+                    [name: string]: unknown;\n+                };\n+                content: {\n+                    \"application/json\": components[\"schemas\"][\"ObservedState\"][];\n+                };\n+            };\n+            /** @description Validation Error */\n+            422: {\n+                headers: {\n+                    [name: string]: unknown;\n+                };\n+                content: {\n+                    \"application/json\": components[\"schemas\"][\"HTTPValidationError\"];\n+                };\n+            };\n+        };\n+    };\n     create_d