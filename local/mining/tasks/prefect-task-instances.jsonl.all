7 @@\n+import { describe, expect, it } from \"vitest\";\n+import {\n+\tbuildStateFilter,\n+\tparseStateNames,\n+\tserializeStateNames,\n+} from \"./state-filter-utils\";\n+\n+describe(\"state filters\", () => {\n+\tit(\"preserves legacy URLs and exact custom names\", () => {\n+\t\texpect(parseStateNames(\"Failed,Baseline NOT Met\")).toEqual([\n+\t\t\t\"Failed\",\n+\t\t\t\"Baseline NOT Met\",\n+\t\t]);\n+\t\tconst names = [\"Baseline, NOT Met\", \"baseline NOT Met\"];\n+\t\texpect(parseStateNames(serializeStateNames(names))).toEqual(names);\n+\t});\n+\tit(\"combines names and types with AND and alternatives with OR\", () => {\n+\t\texpect(\n+\t\t\tbuildStateFilter([\"Baseline NOT Met\", \"TimedOut\"], [\"FAILED\", \"CRASHED\"]),\n+\t\t).toEqual({\n+\t\t\toperator: \"and_\",\n+\t\t\tname: { any_: [\"Baseline NOT Met\", \"TimedOut\"] },\n+\t\t\ttype: { any_: [\"FAILED\", \"CRASHED\"] },\n+\t\t});\n+\t\texpect(buildStateFilter([], [])).toBeUndefined();\n+\t});\n+});\ndiff --git a/ui-v2/src/components/flow-runs/flow-runs-list/flow-runs-filters/state-filter.test.tsx b/ui-v2/src/components/flow-runs/flow-runs-list/flow-runs-filters/state-filter.test.tsx\nindex 9c2049966929..f3adbb55098a 100644\n--- a/ui-v2/src/components/flow-runs/flow-runs-list/flow-runs-filters/state-filter.test.tsx\n+++ b/ui-v2/src/components/flow-runs/flow-runs-list/flow-runs-filters/state-filter.test.tsx\n@@ -1,16 +1,69 @@\n-import { render, screen } from \"@testing-library/react\";\n+import { render as renderComponent, screen } from \"@testing-library/react\";\n import userEvent from \"@testing-library/user-event\";\n+import { buildApiUrl, createWrapper, server } from \"@tests/utils\";\n import { mockPointerEvents } from \"@tests/utils/browser\";\n+import { HttpResponse, http } from \"msw\";\n+import type { ReactElement } from \"react\";\n import { useState } from \"react\";\n-import { beforeAll, describe, expect, it } from \"vitest\";\n+import { beforeAll, describe, expect, it, vi } from \"vitest\";