}),\n+\t\t\t\t...(stateFilter && { state: stateFilter }),\n \t\t\t\t...(tagsFilter.length > 0 && {\n \t\t\t\t\ttags: { operator: \"and_\" as const, any_: tagsFilter },\n \t\t\t\t}),\n@@ -432,12 +421,14 @@ export const Route = createFileRoute(\"/runs/\")({\n \t\t// Consolidated filter state\n \t\tconst {\n \t\t\tstates: selectedStates,\n+\t\t\tstateTypes: selectedStateTypes,\n \t\t\tflows: selectedFlows,\n \t\t\tdeployments: selectedDeployments,\n \t\t\tworkPools: selectedWorkPools,\n \t\t\ttags: selectedTags,\n \t\t\tdateRange,\n \t\t\tonStatesChange: onStateFilterChange,\n+\t\t\tonStateTypesChange,\n \t\t\tonFlowsChange: onFlowFilterChange,\n \t\t\tonDeploymentsChange: onDeploymentFilterChange,\n \t\t\tonWorkPoolsChange: onWorkPoolFilterChange,\n@@ -601,6 +592,8 @@ export const Route = createFileRoute(\"/runs/\")({\n \t\t\t\tflowRunSearch={flowRunSearch}\n \t\t\t\tonFlowRunSearchChange={onFlowRunSearchChange}\n \t\t\t\tselectedStates={selectedStates}\n+\t\t\t\tselectedStateTypes={selectedStateTypes}\n+\t\t\t\tonStateTypesChange={onStateTypesChange}\n \t\t\t\tonStateFilterChange={onStateFilterChange}\n \t\t\t\tselectedFlows={selectedFlows}\n \t\t\t\tonFlowFilterChange={onFlowFilterChange}\n", "test_patch": "diff --git a/tests/server/database/test_migrations.py b/tests/server/database/test_migrations.py\nindex e69424b7ff2f..bb60b73850c4 100644\n--- a/tests/server/database/test_migrations.py\n+++ b/tests/server/database/test_migrations.py\n@@ -1842,3 +1842,34 @@ async def test_drop_db_removes_all_tables(db):\n \n     # Recreate the database for other tests\n     await db.create_db()\n+\n+\n+async def test_observed_state_covering_indexes(\n+    db: PrefectDBInterface, database_engine: AsyncEngine\n+):\n+    \"\"\"The paired revision adds covering indexes only on SQLite and rolls back.\"\"\"\n+\n+    async def indexes(table: str) -> dict[str, list[str]]:\n+        async with database_engine.connect() as connection:\n+            return await connection.run_sync(\n+                lambda conn: {\n+                    index[\"name\"]: index[\"column_names\"]\n+                    for index in sa.inspect(conn).get_indexes(table)\n+                }\n+            )\n+\n+    previous = \"8f5eda7c1dd7\" if db.dialect.name == \"sqlite\" else \"e7f54680bce3\"\n+    try:\n+        await run_sync_in_worker_thread(alembic_downgrade, revision=previous)\n+        for table in (\"flow_run_state\", \"task_run_state\"):\n+            assert f\"ix_{table}__type_name_timestamp\" not in await indexes(table)\n+        await run_sync_in_worker_thread(alembic_upgrade)\n+        for table in (\"flow_run_state\", \"task_run_state\"):\n+            actual = await indexes(table)\n+            name = f\"ix_{table}__type_name_timestamp\"\n+            if db.dialect.name == \"sqlite\":\n+                assert actual[name] == [\"type\", \"name\", \"timestamp\"]\n+            else:\n+                assert name not in actual\n+    finally:\n+        await run_sync_in_worker_thread(alembic_upgrade)\ndiff --git a/tests/server/orchestration/api/test_observed_states.py b/tests/server/orchestration/api/test_observed_states.py\nnew file mode 100644\nindex 000000000000..03491ea3710a\n--- /dev/null\n+++ b/tests/server/orchestration/api/test_observed_states.py\n@@ -0,0 +1,201 @@\n+from datetime import UTC, datetime, timedelta\n+\n+import httpx\n+import pytest\n+from sqlalchemy.ext.asyncio import AsyncSession\n+\n+from prefect.server import models, schemas\n+from prefect.server.database import orm_models\n+\n+pytestmark = pytest.mark.clear_db\n+\n+\n+async def test_empty(client: httpx.AsyncClient):\n+    response = await client.get(\"/observed-states\")\n+    assert response.status_code == 200\n+    assert response.json() == []\n+\n+\n+async def test_cloud_compatible_schema(client: httpx.AsyncClient):\n+    response = await client.get(\"/openapi.json\")\n+    schema = response.json()\n+    observed = schema[\"components\"][\"schemas\"][\"ObservedState\"]\n+    assert set(observed[\"required\"]) == {\n+        \"state_type\",\n+        \"state_name\",\n+        \"first_seen\",\n+        \"last_seen\",\n+    }\n+    assert observed[\"properties\"][\"state_type\"][\"type\"] == \"string\"\n+    assert observed[\"properties\"][\"state_name\"][\"type\"] == \"string\"\n+    for field in (\"first_seen\", \"last_seen\"):\n+        assert observed[\"properties\"][field][\"format\"] == \"date-time\"\n+    endpoint = schema[\"paths\"][\"/observed-states\"][\"get\"]\n+    assert (\n+        endpoint[\"responses\"][\"200\"][\"content\"][\"application/json\"][\"schema\"][\"type\"]\n+        == \"array\"\n+    )\n+    parameters = {param[\"name\"]: param[\"schema\"] for param in endpoint[\"parameters\"]}\n+    assert parameters[\"limit\"][\"default\"] == 200\n+    assert parameters[\"limit\"][\"minimum\"] == 1\n+    assert parameters[\"limit\"][\"maximum\"] == 200\n+    assert parameters[\"order_by\"][\"default\"] == \"LAST_SEEN_DESC\"\n+    assert schema[\"components\"][\"schemas\"][\"ObservedStateSort\"][\"enum\"] == [\n+        \"NAME_ASC\",\n+        \"LAST_SEEN_DESC\",\n+    ]\n+\n+\n+@pytest.fixture\n+async def observations(\n+    session: AsyncSession,\n+    flow_run: orm_models.FlowRun,\n+    task_run: orm_models.TaskRun,\n+) -> list[dict[str, str]]:\n+    start = datetime(2020, 1, 1, tzinfo=UTC)\n+    transitions = [\n+        (schemas.states.Scheduled(name=\"custom schedule\"), 0, False),\n+        (schemas.states.Failed(name=\"Baseline NOT Met\"), 1, False),\n+        (schemas.states.Running(name=\"Baseline NOT Met\"), 2, False),\n+        (schemas.states.Failed(name=\"Baseline NOT Met\"), 3, True),\n+        (schemas.states.Failed(name=\"baseline NOT Met\"), 4, True),\n+    ]\n+    for state, seconds, task in transitions:\n+        state.timestamp = start + timedelta(seconds=seconds)\n+        if task:\n+            await models.task_runs.set_task_run_state(\n+                session=session, task_run_id=task_run.id, state=state, force=True\n+            )\n+        else:\n+            await models.flow_runs.set_flow_run_state(\n+                session=session, flow_run_id=flow_run.id, state=state, force=True\n+            )\n+    await session.commit()\n+    return [\n+        {\n+            \"state_type\": \"FAILED\",\n+            \"state_name\": \"baseline NOT Met\",\n+            \"first_seen\": \"2020-01-01T00:00:04Z\",\n+            \"last_seen\": \"2020-01-01T00:00:04Z\",\n+        },\n+        {\n+            \"state_type\": \"FAILED\",\n+            \"state_name\": \"Baseline NOT Met\",\n+            \"first_seen\": \"2020-01-01T00:00:01Z\",\n+            \"last_seen\": \"2020-01-01T00:00:03Z\",\n+        },\n+        {\n+            \"state_type\": \"RUNNING\",\n+            \"state_name\": \"Baseline NOT Met\",\n+            \"first_seen\": \"2020-01-01T00:00:02Z\",\n+            \"last_seen\": \"2020-01-01T00:00:02Z\",\n+        },\n+        {\n+            \"state_type\": \"SCHEDULED\",\n+            \"state_name\": \"custom schedule\",\n+            \"first_seen\": \"2020-01-01T00:00:00Z\",\n+            \"last_seen\": \"2020-01-01T00:00:00Z\",\n+        },\n+    ]\n+\n+\n+async def test_retained_transition_timestamps(\n+    client: httpx.AsyncClient, observations: list[dict[str, str]]\n+):\n+    response = await client.get(\"/observed-states\")\n+    assert response.status_code == 200\n+    # Ignore fixture-created initial states, which are more recent.\n+    assert [\n+        row\n+        for row in response.json()\n+        if \"NOT Met\" in row[\"state_name\"] or row[\"state_name\"] == \"custom schedule\"\n+    ] == observations\n+\n+\n+@pytest.mark.parametrize(\"query\", [\" bAsE \", \"fAiL\", \"\", \"   \", \"no match\"])\n+async def test_prefix_search(\n+    client: httpx.AsyncClient, observations: list[dict[str, str]], query: str\n+):\n+    response = await client.get(\"/observed-states\", params={\"query\": query})\n+    assert response.status_code == 200\n+    expected = [\n+        row\n+        for row in observations\n+        if not query.strip()\n+        or row[\"state_type\"].lower().startswith(query.strip().lower())\n+        or row[\"state_name\"].lower().startswith(query.strip().lower())\n+    ]\n+    actual = [\n+        row\n+        for row in response.json()\n+        if \"NOT Met\" in row[\"state_name\"] or row[\"state_name\"] == \"custom schedule\"\n+    ]\n+    assert actual == expected\n+\n+\n+async def test_name_order_and_limit(\n+    client: httpx.AsyncClient,\n+    session: AsyncSession,\n+    flow_run: orm_models.FlowRun,\n+):\n+    for name in (\"ordering c\", \"ordering a\", \"ordering b\"):\n+        await models.flow_runs.set_flow_run_state(\n+            session=session,\n+            flow_run_id=flow_run.id,\n+            state=schemas.states.Failed(name=name),\n+            force=True,\n+        )\n+    await session.commit()\n+\n+    response = await client.get(\n+        \"/observed-states\",\n+        params={\"query\": \"ordering\", \"order_by\": \"NAME_ASC\", \"limit\": 2},\n+    )\n+    assert response.status_code == 200\n+    assert [row[\"state_name\"] for row in response.json()] == [\n+        \"ordering a\",\n+        \"ordering b\",\n+    ]\n+\n+\n+@pytest.mark.parametrize(\"prefix\", [\"%\", \"_\", \"/\", \"\\\\\", \"release%\", \"release_\"])\n+async def test_prefix_search_treats_pattern_characters_literally(\n+    client: httpx.AsyncClient,\n+    session: AsyncSession,\n+    flow_run: orm_models.FlowRun,\n+    prefix: str,\n+):\n+    expected = {f\"{prefix}one\", f\"{prefix}two\"}\n+    near_miss = prefix.translate(str.maketrans({c: \"x\" for c in \"%_/\\\\\"})) + \"other\"\n+    for name in [*expected, near_miss, \"unrelated\"]:\n+        await models.flow_runs.set_flow_run_state(\n+            session=session,\n+            flow_run_id=flow_run.id,\n+            state=schemas.states.Failed(name=name),\n+            force=True,\n+        )\n+    await session.commit()\n+\n+    response = await client.get(\"/observed-states\", params={\"query\": prefix})\n+    assert response.status_code == 200\n+    assert {row[\"state_name\"] for row in response.json()} == expected\n+\n+\n+async def test_deleted_runs_remove_observations(\n+    client: httpx.AsyncClient,\n+    session: AsyncSession,\n+    flow_run: orm_models.FlowRun,\n+    observations: list[dict[str, str]],\n+):\n+    await models.flow_runs.delete_flow_run(session=session, flow_run_id=flow_run.id)\n+    await session.commit()\n+    response = await client.get(\"/observed-states\", params={\"query\": \"base\"})\n+    assert response.json() == []\n+\n+\n+@pytest.mark.parametrize(\n+    \"params\", [{\"limit\": 0}, {\"limit\": 201}, {\"order_by\": \"bad\"}, {\"query\": \"a\" * 101}]\n+)\n+async def test_invalid_query(client: httpx.AsyncClient, params: dict[str, str | int]):\n+    response = await client.get(\"/observed-states\", params=params)\n+    assert response.status_code == 422\ndiff --git a/ui-v2/e2e/deployments/deployment-detail.spec.ts b/ui-v2/e2e/deployments/deployment-detail.spec.ts\nindex 9285fdfc4f6d..3455da1fe5e1 100644\n--- a/ui-v2/e2e/deployments/deployment-detail.spec.ts\n+++ b/ui-v2/e2e/deployments/deployment-detail.spec.ts\n@@ -188,7 +188,7 @@ test.describe(\"Deployment Detail Page\", () => {\n \n \t\tawait expect(page.getByText(depName)).toBeVisible({ timeout: 10000 });\n \n-\t\tawait page.getByRole(\"button\", { name: \"Run\" }).click();\n+\t\tawait page.getByRole(\"button\", { name: \"Run\", exact: true }).click();\n \t\tawait page.getByRole(\"menuitem\", { name: \"Quick run\" }).click();\n \n \t\tawait expect(page.getByText(\"Flow run created\")).toBeVisible({\ndiff --git a/ui-v2/src/components/automations/automations-wizard/trigger-step/flow-run-state-trigger-fields.test.tsx b/ui-v2/src/components/automations/automations-wizard/trigger-step/flow-run-state-trigger-fields.test.tsx\nindex 932ee78bbd2f..f9e1306704cd 100644\n--- a/ui-v2/src/components/automations/automations-wi