ion=orjson.OPT_INDENT_2)\n-                _cli.console.print(json_output.decode(), soft_wrap=True)\n+                print_verbatim(json_output.decode())\n                 return\n \n             for queue in sorted_queues:\n@@ -731,7 +732,7 @@ def sort_by_created_key(r: FlowRun):\n     if output and output.lower() == \"json\":\n         runs_json = [run.model_dump(mode=\"json\") for run in sorted_runs]\n         json_output = orjson.dumps(runs_json, option=orjson.OPT_INDENT_2).decode()\n-        _cli.console.print(json_output, soft_wrap=True)\n+        print_verbatim(json_output)\n         return\n \n     for run in sorted_runs:\n", "test_patch": "diff --git a/tests/cli/test_block.py b/tests/cli/test_block.py\nindex 89aa144ce3cc..181215ede1a5 100644\n--- a/tests/cli/test_block.py\n+++ b/tests/cli/test_block.py\n@@ -9,9 +9,10 @@\n from prefect.blocks import system\n from prefect.client.orchestration import PrefectClient\n from prefect.exceptions import ObjectNotFound\n-from prefect.server import models\n+from prefect.server import models, schemas\n from prefect.settings import (\n     PREFECT_API_URL,\n+    PREFECT_CLI_WRAP_LINES,\n     PREFECT_UI_URL,\n     temporary_settings,\n )\n@@ -631,3 +632,136 @@ def test_creating_a_block_selects_oss_ui_url_when_oss_server_type():\n         expected_output_contains=[\"blocks/catalog\"],\n         expected_output_does_not_contain=[\"settings/blocks/catalog\"],\n     )\n+\n+\n+LITERAL_TEXT = \"[bold]literal[/bold] :smile: [/unexpected]\"\n+\n+\n+@pytest.fixture\n+def wrap_lines_enabled():\n+    # The test suite disables line wrapping by default; enable it so long values\n+    # exercise terminal-width wrapping.\n+    with temporary_settings(updates={PREFECT_CLI_WRAP_LINES: True}):\n+        yield\n+\n+\n+@pytest.fixture\n+async def literal_block_schema(\n+    session, wrap_lines_enabled: None\n+) -> schemas.core.BlockSchema:\n+    block_type = await models.block_types.create_block_type(\n+        session,\n+        block_type=schemas.core.BlockType(\n+            name=\"Literal Markup\",\n+            slug=\"literal-markup\",\n+            description=LITERAL_TEXT,\n+            code_example=LITERAL_TEXT,\n+        ),\n+    )\n+    block_schema = await models.block_schemas.create_block_schema(\n+        session,\n+        block_schema=schemas.actions.BlockSchemaCreate(\n+            block_type_id=block_type.id,\n+            fields={\n+                \"title\": \"LiteralMarkup\",\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"message\": {\n+                        \"title\": \"Message\",\n+                        \"description\": LITERAL_TEXT,\n+                        \"type\": \"string\",\n+                    },\n+                    \"secret\": {\n+                        \"title\": \"Secret\",\n+                        \"type\": \"string\",\n+                        \"format\": \"password\",\n+                        \"writeOnly\": True,\n+                    },\n+                },\n+                \"required\": [\"message\", \"secret\"],\n+                \"secret_fields\": [\"secret\"],\n+            },\n+        ),\n+    )\n+    await session.commit()\n+    return block_schema\n+\n+\n+@pytest.fixture(\n+    params=[\n+        \"[red]literal[/red]\",\n+        \":smile:\",\n+        \"literal [/unexpected]\",\n+        \"x\" * 1000,\n+    ],\n+    ids=[\"markup\", \"emoji\", \"unmatched-closing-tag\", \"long-string\"],\n+)\n+async def literal_block_document(\n+    session,\n+    request: pytest.FixtureRequest,\n+    literal_block_schema: schemas.core.BlockSchema,\n+) -> schemas.core.BlockDocument:\n+    block_document = await models.block_documents.create_block_document(\n+        session,\n+        block_document=schemas.actions.BlockDocumentCreate(\n+            name=\"literal-block\",\n+            data={\"message\": request.param, \"secret\": \"[red]secret[/red]\"},\n+            block_schema_id=literal_block_schema.id,\n+            block_type_id=literal_block_schema.block_type_id,\n+        ),\n+    )\n+    await session.commit()\n+    return block_document\n+\n+\n+def test_listing_blocks_json_preserves_literal_content(\n+    literal_block_document: schemas.core.BlockDocument,\n+):\n+    result = invoke_and_assert([\"block\", \"ls\", \"-o\", \"json\"], expected_code=0)\n+    output = json.loads(result.stdout)\n+    assert [block[\"data\"][\"message\"] for block in output] == [\n+        literal_block_document.data[\"message\"]\n+    ]\n+\n+\n+@pytest.mark.parametrize(\"by_id\", [False, True], ids=[\"slug\", \"id\"])\n+def test_inspecting_a_block_json_preserves_literal_content(\n+    literal_block_document: schemas.core.BlockDocument, by_id: bool\n+):\n+    lookup = (\n+        [\"--id\", str(literal_block_document.id)]\n+        if by_id\n+        else [\"literal-markup/literal-block\"]\n+    )\n+    result = invoke_and_assert(\n+        [\"block\", \"inspect\", *lookup, \"-o\", \"json\"], expected_code=0\n+    )\n+    output = json.loads(result.stdout)\n+    assert output[\"data\"][\"message\"] == literal_block_document.data[\"message\"]\n+    assert output[\"data\"][\"secret\"] == \"********\"\n+\n+\n+def test_listing_block_types_json_preserves_literal_content(\n+    literal_block_schema: schemas.core.BlockSchema,\n+):\n+    result = invoke_and_assert([\"block\", \"type\", \"ls\", \"-o\", \"json\"], expected_code=0)\n+    output = json.loads(result.stdout)\n+    assert [\n+        (block_type[\"description\"], block_type[\"code_example\"]) for block_type in output\n+    ] == [(LITERAL_TEXT, LITERAL_TEXT)]\n+\n+\n+def test_inspecting_a_block_type_json_preserves_literal_content(\n+    literal_block_schema: schemas.core.BlockSchema,\n+):\n+    result = invoke_and_assert(\n+        [\"block\", \"type\", \"inspect\", \"literal-markup\", \"-o\", \"json\"],\n+        expected_code=0,\n+    )\n+    output = json.loads(result.stdout)\n+    assert output[\"block_type\"][\"description\"] == LITERAL_TEXT\n+    assert output[\"block_type\"][\"code_example\"] == LITERAL_TEXT\n+    assert (\n+        output[\"schema\"][\"fields\"][\"properties\"][\"message\"][\"description\"]\n+        == LITERAL_TEXT\n+    )\ndiff --git a/tests/cli/test_utilities.py b/tests/cli/test_utilities.py\nnew file mode 100644\nindex 000000000000..15266c046bfe\n--- /dev/null\n+++ b/tests/cli/test_utilities.py\n@@ -0,0 +1,85 @@\n+import ast\n+import io\n+import json\n+from pathlib import Path\n+\n+import pytest\n+from rich.console import Console\n+\n+import prefect.cli\n+import prefect.cli._app as _cli\n+from prefect.cli._utilities import print_verbatim\n+\n+CLI_SOURCE_DIR = Path(prefect.cli.__file__).parent\n+\n+\n+@pytest.fixture\n+def captured_console(monkeypatch: pytest.MonkeyPatch) -> io.StringIO:\n+    buffer = io.StringIO()\n+    monkeypatch.setattr(\n+        _cli, \"console\", Console(file=buffer, width=20, color_system=None)\n+    )\n+    return buffer\n+\n+\n+@pytest.mark.parametrize(\n+    \"value\",\n+    [\n+        \"[bold]literal[/bold]\",\n+        \":smile:\",\n+        \"literal [/unexpected]\",\n+        \"x\" * 1000,\n+    ],\n+)\n+def test_print_verbatim_preserves_json_output(\n+    captured_console: io.StringIO, value: str\n+):\n+    payload = json.dumps({\"value\": value, \"nested\": [{\"value\": value}]}, indent=2)\n+\n+    print_verbatim(payload)\n+\n+    assert captured_console.getvalue() == payload + \"\\n\"\n+    assert json.loads(captured_console.getvalue()) == {\n+        \"value\": value,\n+        \"nested\": [{\"value\": value}],\n+    }\n+\n+\n+def _is_serialized_output(node: ast.expr) -> bool:\n+    if isinstance(node, (ast.Constant, ast.JoinedStr)):\n+        return False\n+    if (\n+        isinstance(node, ast.Call)\n+        and isinstance(node.func, ast.Name)\n+        and node.func.id == \"Pretty\"\n+    ):\n+        return False\n+    source = ast.unparse(node).lower()\n+    return \"json\" in source or \"dump\" in source\n+\n+\n+def test_cli_serialized_output_uses_print_verbatim():\n+    \"\"\"\n+    JSON/YAML output printed via `console.print` is parsed for Rich markup and\n+    emoji aliases, which rewrites user data. Use `print_verbatim` instead.\n+    \"\"\"\n+    offenders: list[str] = []\n+    for path in sorted(CLI_SOURCE_DIR.rglob(\"*.py\")):\n+        tree = ast.parse(path.read_text(), filename=str(path))\n+        for node in ast.walk(tree):\n+            if (\n+                isinstance(node, ast.Call)\n+                and isinstance(node.func, ast.Attribute)\n+                and node.func.attr == \"print\"\n+                and \"console\" in ast.unparse(node.func.value)\n+                and node.args\n+                and _is_serialized_output(node.args[0])\n+            ):\n+                offenders.append(\n+                    f\"{path.relative_to(CLI_SOURCE_DIR)}:{node.lineno}: \"\n+                    f\"{ast.unparse(node)}\"\n+                )\n+\n+    assert not offenders, (\n+        \"Print serialized CLI output with `print_verbatim`:\\n\" + \"\\n\".join(offenders)\n+    )\ndiff --git a/tests/cli/test_work_pool.py b/tests/cli/test_work_pool.py\nindex 984984945733..401d9ca387d0 100644\n--- a/tests/cli/test_work_pool.py\n+++ b/tests/cli/test_work_pool.py\n@@ -505,6 +505,33 @@ async def test_inspect(self, prefect_client, work_pool):\n         assert work_pool.type in res.output\n         assert str(work_pool.id) in res.output\n \n+    @pytest.mark.parametrize(\n+        \"description\",\n+        [\n+            \"[bold]literal[/bold]\",\n+            \":smile:\",\n+            \"literal [/unexpected]\",\n+            \"x\" * 1000,\n+        ],\n+    )\n+    async def test_inspect_json_output_preserves_literal_description(\n+        self, prefect_client: PrefectClient, description: str\n+    ):\n+        work_pool = await prefect_client.create_work_pool(\n+            work_pool=WorkPoolCreate(\n+                name=f\"literal-{uuid.uuid4()}\",\n+                type=\"process\",\n+                description=description,\n+            )\n+        )\n+\n+        res = await run_sync_in_worker_thread(\n+            invoke_and_assert,\n+            [\"work-pool\", \"inspect\", work_pool.name, \"--output\", \"json\"],\n+        )\n+\n+        assert json.loads(res.stdout)[\"description\"] == description\n+\n     async def test_inspect_with_json_output(self, prefect_client, work_pool):\n         \"\"\"Test work-pool inspect command with JSON output flag.\"\"\"\n         import json\n", "problem_statement": "Block CLI JSON output rewrites literal markup and emoji aliases\n### Bug summary\n\nThe block CLI's JSON output interprets stored strings as Rich markup and emoji aliases. This changes the returned data, and a literal closing tag can make the command fail.\n\nReproduced on current main `da9d9dc15f`, Linux, Python 3.12.14, with an isolated local test server:\n\n```python\nfrom prefect.blocks.core import Block\nfrom prefect.testing.cli import CycloptsCliRunner\nfrom prefect.testing.utilities import prefect_test_harness\n\nclass LiteralData(Block):\n    message: str\n\nwith prefect_test_harness():\n    LiteralData(message=\"[bold]literal[/bold] :smile:\").save(\"literal-data\")\n    result = CycloptsCliRunner().invoke(\n        [\"block\", \"inspect\", \"literaldata/literal-data\", \"-o\", \"json\"]\n    )\n    print(result.stdout)\n    print(f\"exit_code={result.exit_code}\")\n```\n\nThe stored message is `[bold]literal[/bold] :smile:`, but JSON output contains `literal \ud83d\ude04`, with exit code 0. A message containing only `[/bold]` instead raises `rich.errors.MarkupError`.\n\nThe same behavior is reproduced in:\n- `prefect block ls -o json`\n- `prefect block inspect <slug> -o json` and lookup by `--id`\n- `prefect block type ls -o json` for description/code-example fields\n- `prefect block type inspect <slug> -o json` for metadata and schema descriptions\n\nExpected: JSON should preserve the stored strings literally, while continuing to mask secret values.\n\n### Verification and proposed scope\n\nA private real-API/CLI regression matrix on unchanged source produced 18 failures for markup/closing-tag/emoji cases. Six plain-text controls and the existing inspect-secret-masking test passed. No external Prefect service or real user block was used.\n\nI plan to disable markup and emoji parsing at the four JSON print calls in `src/prefect/cli/block.py`, retaining soft wrapping and adding behavior-focused regressions. This follows the existing CLI output contract and the narrow fixes in #23530 and #23692; it does not change global console behavior or human-readable tables.\n\nAI assistance: Codex prepared and ran the reproductions and drafted this report. The behavior above was observed locally; no production fix is included in this issue.\n", "hints_text": "", "created_at": "2026-11-02T13:28:04Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23692, "instance_id": "PrefectHQ__prefect-23692", "issue_numbers": ["23691"], "base_commit": "2b76fb3da359c20fc5fa4e4db615a6fc76330b1e", "patch": "diff --git a/src/prefect/cli/artifact.py b/src/prefect/cli/artifact.py\nindex a994bc40d4a3..b5b3f1b293d8 100644\n--- a/src/prefect/cli/artifact.py\n+++ b/src/prefect/cli/artifact.py\n@@ -77,7 +77,7 @@ async def list_artifacts(\n     if output and output.lower() == \"json\":\n         artifacts_json = [artifact.model_dump(mode=\"json\") for artifact in artifacts]\n         json_output = orjson.dumps(artifacts_json, option=orjson.OPT_INDENT_2).decode()\n-        _cli.console.print(json_output, soft_wrap=True)\n+        _cli.console.print(json_output, soft_wrap=True, markup=False, emoji=False)\n     else:\n         table = Table(\n             title=\"Artifacts\",\n@@ -181,7 +181,7 @@ async def inspect(\n             json_output = orjson.dumps(\n                 artifacts_json, option=orjson.OPT_INDENT_2\n             ).decode()\n-            _cli.console.print(json_output, soft_wrap=True)\n+            _cli.console.print(json_output, soft_wrap=True, markup=False, emoji=False)\n         else:\n             _cli.console.print(Pretty(artifacts_json))\n \n", "test_patch": "diff --git a/tests/cli/test_artifact.py b/tests/cli/test_artifact.py\nindex 312caed3a98f..38906593d0c8 100644\n--- a/tests/cli/test_artifact.py\n+++ b/tests/cli/test_artifact.py\n@@ -1,3 +1,4 @@\n+import json\n import sys\n from typing import TYPE_CHECKING\n from uuid import uuid4\n@@ -5,6 +6,8 @@\n import pytest\n \n from prefect.server import models, schemas\n+from prefect.server.database.orm_models import Artifact\n+from prefect.settings import PREFECT_CLI_WRAP_LINES, temporary_settings\n from prefect.testing.cli import invoke_and_assert\n \n pytestmark = pytest.mark.clear_db\n@@ -466,3 +469,59 @@ def test_deleting_artifact_without_key_or_id_raises(\n         expected_output_contains=\"Please provide a key or an artifact_id.\",\n         expected_code=1,\n     )\n+\n+\n+@pytest.fixture\n+async def literal_artifact(\n+    request: pytest.FixtureRequest, session: \"AsyncSession\"\n+) -> Artifact:\n+    artifact = await models.artifacts.create_artifact(\n+        session=session,\n+        artifact=schemas.core.Artifact(\n+            key=\"literal-artifact\",\n+            type=\"markdown\",\n+            data=request.param[0],\n+            description=request.param[1],\n+            metadata_=request.param[2],\n+        ),\n+    )\n+    await session.commit()\n+    return artifact\n+\n+\n+@pytest.mark.parametrize(\n+    \"literal_artifact\",\n+    [\n+        (\"[red]literal[/red]\", \"description\", {\"note\": \"metadata\"}),\n+        (\":smile:\", \"description\", {\"note\": \"metadata\"}),\n+        (\"literal [/unexpected]\", \"description\", {\"note\": \"metadata\"}),\n+        (\n+            {\"nested\": [\"[bold]value[/bold]\", \":warning:\"]},\n+            \"description\",\n+            {\"note\": \"metadata\"},\n+        ),\n+        (\"x\" * 600, \"description\", {\"note\": \"metadata\"}),\n+        ('caf\u00e9 \u65e5\u672c\u8a9e\\n\\t\"\\\\', \"description\", {\"note\": \"metadata\"}),\n+        (\n+            \"plain\",\n+            \"[bold]description[/bold] :smile:\",\n+            {\"note\": \"[red]metadata[/red] :warning:\"},\n+        ),\n+    ],\n+    indirect=True,\n+)\n+@pytest.mark.parametrize(\n+    \"command\", [[\"ls\"], [\"ls\", \"--all\"], [\"inspect\", \"literal-artifact\"]]\n+)\n+def test_artifact_json_preserves_literal_content(\n+    literal_artifact: Artifact, command: list[str]\n+):\n+    with temporary_settings(updates={PREFECT_CLI_WRAP_LINES: True}):\n+        result = invoke_and_assert(\n+            [\"artifact\", *command, \"--output\", \"json\"], expected_code=0\n+        )\n+    output = json.loads(result.stdout)\n+    assert len(output) == 1\n+    assert output[0][\"data\"] == literal_artifact.data\n+    assert output[0][\"description\"] == literal_artifact.description\n+    assert output[0][\"metadata_\"] == literal_artifact.metadata_\n", "problem_statement": "Artifact CLI JSON output alters literal markup/emoji and crashes on closing tags\n## Bug\n\n`prefect artifact ls --output json` (both latest and `--all`) and `prefect artifact inspect KEY --output json` pass serialized artifact records through Rich markup/emoji parsing. Stored data is silently changed, and a stray closing tag can make the command fail instead of returning JSON. This breaks scripts exporting artifact content.\n\nOn current main `2b76fb3da359c20fc5fa4e4db615a6fc76330b1e`, Linux/Python 3.12, real repository SQLite/API fixtures reproduced:\n\n- data `[red]literal[/red]` \u2192 `literal`\n- data `:smile:` \u2192 an emoji\n- data `literal [/unexpected]` \u2192 `rich.errors.MarkupError`\n- nested data, description, and metadata strings are also interpreted.\n\nMinimal reproduction against a local test server:\n\n```python\nimport asyncio\nfrom prefect.client.orchestration import get_client\nfrom prefect.client.schemas.actions import ArtifactCreate\n\nasync def create():\n    async with get_client() as client:\n        await client.create_artifact(ArtifactCreate(\n            key=\"literal-artifact\", type=\"markdown\", data=\"[red]literal[/red] :smile:\"\n        ))\n\nasyncio.run(create())\n```\n\nThen run `prefect artifact inspect literal-artifact --output json` and compare the `data` value with the submitted string; repeat with `artifact ls --output json` / `artifact ls --all --output json`.\n\n## Scope and planned fix\n\nI am preparing a focused two-call fix: disable markup and emoji interpretation only in the artifact JSON output paths, retaining `soft_wrap=True`, with real API/CLI round-trip regression tests for all three command forms. Human-readable output is unchanged. This follows the existing CLI contract and the variable-command fix in #23530, which explicitly excluded other commands; it is not a competing variable fix or a global console change.\n\nLocal reproduction: 18 parametrized cases fail on unmodified main (data/description corruption or the closing-tag crash), including nested content and long/Unicode controls with literal metadata. Initial test setup needed a writable PREFECT_HOME; no product failure was inferred from that setup error.\n\nAI assistance: Codex investigated and ran these reproductions and is preparing the focused fix/tests with independent review. No production service or private data was used.\n", "hints_text": "", "created_at": "2026-11-01T18:38:59Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23688, "instance_id": "PrefectHQ__prefect-23688", "issue_numbers": ["23888"], "base_commit": "b0479c0c26045b06321191bbad0cdfbb334d7380", "patch": "diff --git a/src/prefect/_internal/schemas/validators.py b/src/prefect/_internal/schemas/validators.py\nindex ce065eef34fe..247f5e1f4a8d 100644\n--- a/src/prefect/_internal/schemas/validators.py\n+++ b/src/prefect/_internal/schemas/validators.py\n@@ -472,6 +472,19 @@ def normalize_schedule_rrule(schedule: _T) -> _T:\n     return type(schedule)(rrule=normalized, timezone=schedule.timezone)  # type: ignore[call-arg]\n \n \n+def validate_rrule_schedule_timezone(schedule: _T) -> _T:\n+    \"\"\"`AfterValidator` for server action-schema schedule fields.\n+\n+    The server's `RRuleSchedule` timezone pattern is unanchored, so it accepts\n+    any string that merely contains a timezone name (e.g. \"UTC+2\"). It is not\n+    tightened on the class itself so that schedules already stored with such a\n+    timezone stay readable; invalid timezones are rejected on writes instead.\n+    \"\"\"\n+    if isinstance(getattr(schedule, \"rrule\", None), str):\n+        default_timezone(getattr(schedule, \"timezone\", None))\n+    return schedule\n+\n+\n ### STATE SCHEMA VALIDATORS ###\n \n \ndiff --git a/src/prefect/server/schemas/actions.py b/src/prefect/server/schemas/actions.py\nindex 9746021aeb0b..7276ee1cedb6 100644\n--- a/src/prefect/server/schemas/actions.py\n+++ b/src/prefect/server/schemas/actions.py\n@@ -30,6 +30,7 @@\n     validate_parameter_size_field,\n     validate_parameters_conform_to_schema,\n     validate_parent_and_ref_diff,\n+    validate_rrule_schedule_timezone,\n     validate_schedule_max_scheduled_runs,\n )\n from prefect.server.utilities.schemas import get_class_fields_only\n@@ -102,8 +103,13 @@ class FlowUpdate(ActionBaseModel):\n # Fields that accept `None` (e.g. `DeploymentScheduleUpdate.schedule`)\n # use `Optional[NormalizedSchedule]` directly \u2014 Pydantic only runs the\n # `AfterValidator` on the non-None branch.\n+#\n+# RRule timezones are validated here too, rather than on RRuleSchedule, so\n+# that schedules already stored with an invalid timezone stay readable.\n NormalizedSchedule = Annotated[\n-    schemas.schedules.SCHEDULE_TYPES, AfterValidator(normalize_schedule_rrule)\n+    schemas.schedules.SCHEDULE_TYPES,\n+    AfterValidator(validate_rrule_schedule_timezone),\n+    AfterValidator(normalize_schedule_rrule),\n ]\n \n \n", "test_patch": "diff --git a/tests/server/orchestration/api/test_deployment_schedules.py b/tests/server/orchestration/api/test_deployment_schedules.py\nindex 0329cc60c584..483333cac60a 100644\n--- a/tests/server/orchestration/api/test_deployment_schedules.py\n+++ b/tests/server/orchestration/api/test_deployment_schedules.py\n@@ -405,6 +405,73 @@ async def test_updating_schedule_removes_scheduled_runs(\n         assert len(flow_runs) == 0\n \n \n+class TestLegacyInvalidRRuleTimezone:\n+    @pytest.fixture\n+    async def legacy_schedule(\n+        self,\n+        db: PrefectDBInterface,\n+        get_server_session: AsyncSessionGetter,\n+        deployment,\n+    ) -> UUID:\n+        # Stored before RRule timezones were validated on write.\n+        async with get_server_session() as session:\n+            await models.deployments.delete_schedules_for_deployment(\n+                session=session, deployment_id=deployment.id\n+            )\n+            schedule = db.DeploymentSchedule(\n+                deployment_id=deployment.id,\n+                schedule=schemas.schedules.RRuleSchedule(\n+                    rrule=\"FREQ=DAILY\", timezone=\"UTC+2\"\n+                ),\n+                active=False,\n+            )\n+            session.add(schedule)\n+            await session.commit()\n+            return schedule.id\n+\n+    async def test_legacy_schedule_stays_readable(\n+        self,\n+        client: AsyncClient,\n+        schedules_url: Callable[..., str],\n+        deployment,\n+        legacy_schedule: UUID,\n+    ):\n+        response = await client.get(f\"/deployments/{deployment.id}\")\n+        assert response.status_code == status.HTTP_200_OK\n+        assert response.json()[\"schedules\"][0][\"schedule\"][\"timezone\"] == \"UTC+2\"\n+\n+        response = await client.get(schedules_url(deployment.id))\n+        assert response.status_code == status.HTTP_200_OK\n+        assert [s[\"id\"] for s in response.json()] == [str(legacy_schedule)]\n+\n+    async def test_legacy_schedule_can_be_repaired(\n+        self,\n+        get_server_session: AsyncSessionGetter,\n+        client: AsyncClient,\n+        schedules_url: Callable[..., str],\n+        deployment,\n+        legacy_schedule: UUID,\n+    ):\n+        url = schedules_url(deployment.id, schedule_id=legacy_schedule)\n+        response = await client.patch(\n+            url,\n+            json={\"schedule\": {\"rrule\": \"FREQ=DAILY\", \"timezone\": \"UTC+2\"}},\n+        )\n+        assert response.status_code == status.HTTP_422_UNPROCESSABLE_CONTENT\n+\n+        response = await client.patch(\n+            url,\n+            json={\"schedule\": {\"rrule\": \"FREQ=DAILY\", \"timezone\": \"Etc/GMT-2\"}},\n+        )\n+        assert response.status_code == status.HTTP_204_NO_CONTENT\n+\n+        async with get_server_session() as session:\n+            schedules = await models.deployments.read_deployment_schedules(\n+                session=session, deployment_id=deployment.id\n+            )\n+        assert [s.schedule.timezone for s in schedules] == [\"Etc/GMT-2\"]\n+\n+\n class TestDeleteDeploymentSchedule:\n     @pytest.fixture\n     async def schedule_to_delete(\ndiff --git a/tests/server/schemas/test_actions.py b/tests/server/schemas/test_actions.py\nindex 99ec42870978..35023fce7c53 100644\n--- a/tests/server/schemas/test_actions.py\n+++ b/tests/server/schemas/test_actions.py\n@@ -511,6 +511,36 @@ def test_deployment_schedule_validation_success(\n         assert schedule.max_scheduled_runs == max_scheduled_runs\n \n \n+class TestRRuleTimezoneValidationOnWrite:\n+    @pytest.mark.parametrize(\n+        \"schema_type\",\n+        [DeploymentScheduleCreate, DeploymentScheduleUpdate],\n+    )\n+    @pytest.mark.parametrize(\n+        \"timezone\", [\"fake\", \"UTC+2\", \"GMT-5\", \"America/New_York \", \"Not/A_UTC_Zone\"]\n+    )\n+    def test_invalid_timezone(self, schema_type, timezone: str):\n+        with pytest.raises(ValidationError):\n+            schema_type(schedule=RRuleSchedule(rrule=\"FREQ=DAILY\", timezone=timezone))\n+\n+    @pytest.mark.parametrize(\n+        \"schema_type\",\n+        [DeploymentScheduleCreate, DeploymentScheduleUpdate],\n+    )\n+    @pytest.mark.parametrize(\"timezone\", [\"Etc/GMT+5\", \"America/Port-au-Prince\"])\n+    def test_timezone_with_regex_metacharacters(self, schema_type, timezone: str):\n+        action = schema_type(\n+            schedule=RRuleSchedule(rrule=\"FREQ=DAILY\", timezone=timezone)\n+        )\n+        assert action.schedule.timezone == timezone\n+\n+    def test_rrule_schedule_constructed_directly_keeps_invalid_timezone(self):\n+        # Schedules stored before timezones were validated are read back\n+        # through `RRuleSchedule` directly and must stay loadable.\n+        legacy = RRuleSchedule(rrule=\"FREQ=DAILY\", timezone=\"UTC+2\")\n+        assert legacy.timezone == \"UTC+2\"\n+\n+\n class TestRRuleNormalizationOnWrite:\n     \"\"\"Regression tests for #21362.\n \n", "problem_statement": "Reject invalid RRule timezones on schedule writes while preserving legacy reads\nSchedule write actions accept invalid timezone strings that contain a recognized timezone name.\n\nReproduced against current `main` (`7ec97d9bd4`) plus the unrelated Windows filename fix:\n\n```python\nfrom prefect.server.schemas.actions import DeploymentScheduleCreate\nfrom prefect.server.schemas.schedules import RRuleSchedule\n\nDeploymentScheduleCreate(schedule=RRuleSchedule(rrule=\"FREQ=DAILY\", timezone=\"UTC+2\"))\n```\n\nThis succeeds, although `UTC+2` is not a valid IANA timezone. The same issue affects strings such as `GMT-5` and timezone names with trailing spaces.\n\nValidate timezones at schedule create/update boundaries. Preserve reads of legacy rows containing invalid values so those deployments remain inspectable and repairable. Valid names such as `Etc/GMT-2` must remain accepted.\n\nTracking the existing write-boundary fix and legacy-row regression coverage in #23688.\n", "hints_text": "", "created_at": "2026-10-31T19:36:49Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23683, "instance_id": "PrefectHQ__prefect-23683", "issue_numbers": ["18134"], "base_commit": "bd4807c3f402e0390e945527178e746a4ca3a6d7", "patch": "diff --git a/src/integrations/prefect-docker/prefect_docker/worker.py b/src/integrations/prefect-docker/prefect_docker/worker.py\nindex d807bf7d43c1..aa2dfa61813d 100644\n--- a/src/integrations/prefect-docker/prefect_docker/worker.py\n+++ b/src/integrations/prefect-docker/prefect_docker/worker.py\n@@ -76,7 +76,6 @@\n from prefect.settings import PREFECT_API_URL\n from prefect.states import Pending\n from prefect.utilities.asyncutils import run_sync_in_worker_thread\n-from prefect.utilities.collections import get_from_dict\n from prefect.utilities.dockerutils import (\n     format_outlier_version_name,\n     get_prefect_image_name,\n@@ -668,24 +667,8 @@ async def _submit_adhoc_run(\n                 {_bundle_execute_module: execute_step_args},\n                 f\"/tmp/{bundle_key}\",\n             )\n-            existing_volumes: list[str] = (\n-                get_from_dict(\n-                    self.work_pool.base_job_template,\n-                    \"configuration.properties.volumes.default\",\n-                )\n-                or []\n-            )\n-            job_variable_volumes: list[str] = (\n-                job_variables.get(\"volumes\", []) if job_variables else []\n-            )\n             job_variables = (job_variables or {}) | {\n                 \"command\": command_to_string(execute_command),\n-                \"volumes\": [\n-                    *existing_volumes,\n-                    *job_variable_volumes,\n-                    # This is a temporary volume for the bundle\n-                    f\"{submission_dir}:/tmp/\",\n-                ],\n             }\n         else:\n             if TYPE_CHECKING:\n@@ -744,6 +727,9 @@ async def _submit_adhoc_run(\n             values=job_variables,\n             client=self._client,\n         )\n+        if not storage_configured_on_work_pool:\n+            # Add the bundle mount after resolving the template's configured volumes.\n+            configuration.volumes = [*configuration.volumes, f\"{submission_dir}:/tmp/\"]\n         configuration.prepare_for_flow_run(\n             flow_run=flow_run,\n             flow=api_flow,\n", "test_patch": "diff --git a/src/integrations/prefect-docker/tests/test_worker.py b/src/integrations/prefect-docker/tests/test_worker.py\nindex b413a8594b6f..e2fb2f6ff74e 100644\n--- a/src/integrations/prefect-docker/tests/test_worker.py\n+++ b/src/integrations/prefect-docker/tests/test_worker.py\n@@ -31,7 +31,7 @@\n import prefect.main  # noqa\n from prefect import flow, get_client\n from prefect.client.schemas import FlowRun\n-from prefect.client.schemas.actions import WorkPoolCreate\n+from prefect.client.schemas.actions import WorkPoolCreate, WorkPoolUpdate\n from prefect.client.schemas.objects import WorkPool, WorkPoolStorageConfiguration\n from prefect.events import RelatedResource\n from prefect.flows import bind_flow_to_infrastructure\n@@ -1800,6 +1800,46 @@ def my_test_flow():\n \n         return my_test_flow\n \n+    @pytest.mark.parametrize(\n+        \"volume_source\", [\"default\", \"override\", \"hardcoded\", \"custom_variable\"]\n+    )\n+    async def test_submit_adhoc_run_preserves_configured_volumes(\n+        self, mock_docker_client, work_pool, test_flow, volume_source\n+    ):\n+        template = DockerWorker.get_default_base_job_template()\n+        template[\"variables\"][\"properties\"][\"volumes\"][\"default\"] = [\"pool:/pool\"]\n+        job_variables = None\n+        expected_volumes = [\"pool:/pool\"]\n+        if volume_source == \"override\":\n+            job_variables = {\"volumes\": [\"override:/override\"]}\n+            expected_volumes = [\"override:/override\"]\n+        elif volume_source == \"hardcoded\":\n+            template[\"job_configuration\"][\"volumes\"] = [\"literal:/literal\"]\n+            expected_volumes = [\"literal:/literal\"]\n+        elif volume_source == \"custom_variable\":\n+            template[\"variables\"][\"properties\"][\"custom_volumes\"] = {\n+                \"type\": \"array\",\n+                \"items\": {\"type\": \"string\"},\n+                \"default\": [\"custom:/custom\"],\n+            }\n+            template[\"job_configuration\"][\"volumes\"] = \"{{ custom_volumes }}\"\n+            expected_volumes = [\"custom:/custom\"]\n+\n+        async with get_client() as client:\n+            await client.update_work_pool(\n+                work_pool.name, WorkPoolUpdate(base_job_template=template)\n+            )\n+\n+        async with DockerWorker(work_pool_name=work_pool.name) as worker:\n+            await worker._submit_adhoc_run(flow=test_flow, job_variables=job_variables)\n+\n+            mock_docker_client.containers.create.assert_called_once()\n+            volumes = mock_docker_client.containers.create.call_args.kwargs[\"volumes\"]\n+            assert volumes[:-1] == expected_volumes\n+            bundle_source, bundle_target = volumes[-1].rsplit(\":\", 1)\n+            assert bundle_target == \"/tmp/\"\n+            assert Path(bundle_source).parent == Path(worker._tmp_dir)\n+\n     async def test_submit_adhoc_run_with_existing_flow_run_reuses_id(\n         self, mock_docker_client, work_pool, test_flow\n     ):\n", "problem_statement": "prefect_docker: Default volumes not mounted when running docker flows directly\n### Bug summary\n\nWhen running [flows directly in dynamic infrastructure](https://docs.prefect.io/v3/deploy/submit-flows-directly-to-dynamic-infrastructure), I believe there is a bug when spinning up new docker images when no storage is configured for the docker work pool. Let's say you create a docker work-pool 'docker' and set volumes to `[\"result-storage:/result-storage\"]`. This volume is not mounted in the flow container. Using `docker inspect {imageTag}` on the image created by the worker, I can see that:\n```json\n\"Volumes\": {\n                \"/tmp/\": {}\n            }\n```\n\nI think the issue is in the file `prefect_docker/worker.py`. Specifically [here](https://github.com/PrefectHQ/prefect/blob/7d4d41615e614b9f46eb317a2948a3d0643a07f5/src/integrations/prefect-docker/prefect_docker/worker.py#L507). The problem seems to be with the path `configuration.properties.volumes.default`. In the docker base job template, the default volumes are stored under the key `variables.properties.volumes.default`...\n\n### Version info\n\n```Text\nVersion:             3.4.0\nAPI version:         0.8.4\nPython version:      3.11.9\nGit commit:          c80e4442\nBuilt:               Fri, May 02, 2025 08:02 PM\nOS/Arch:             darwin/arm64\nProfile:             local\nServer type:         server\nPydantic version:    2.11.3\nIntegrations:\n  prefect-docker:    0.6.4\n  prefect-kubernetes: 0.5.10\n  prefect-aws:       0.5.10\n```\n\n### Additional context\n\n_No response_\n", "hints_text": "hi @Rahlir - thanks for the report! just to clarify the scenario you're talking about, it sounds like you're saying that\n\nthe `volume` that is a default on the work pool (which does not have configured storage via `prefect work-pool storage configure`) is not being inherited by the eventual flow run container\n\nis that right?\n\nif you have a complete MRE, please feel free to share\nYes, that is correct.\n\nFor the MRE (I am sorry I am unable to provide you a fully docker based setup right now, let me know if you are unable to reproduce it using the steps outlined below and I will try to spin up a docker-compose example):\n\nHere is the base job template for the docker work-pool:\n\n[local-template-copy.json](https://github.com/user-attachments/files/20384899/local-template-copy.json)\n\nNow, use this template with docker workpool by running `prefect work-pool create \"docker-example\" --type docker --base-job-template local-template-copy.json` (note that network `orchestrator-network` needs to exist, you can create one with `docker network create -d bridge orchestrator-network`; also the volume `result-storage` should exist, run `docker volume create result-storage`). You can see that the volume is specified in the GUI when checking the work-pool configuration:\n\n![Image](https://github.com/user-attachments/assets/0d456dbc-d16f-4dc8-bcf0-9110281d10a6)\n\nNow, run this code:\n\n```python\nimport asyncio\nfrom pathlib import Path\n\nfrom prefect import flow\nfrom prefect.logging import get_run_logger\n\n@flow\nasync def sample_flow():\n    run_logger = get_run_logger()\n    path_to_volume = Path(\"/result-storage\")\n    run_logger.info(f\"Does the volume exist? -> {path_to_volume.exists()}\")\n\n\nasync def main():\n    async with DockerWorker(work_pool_name=\"docker-example\") as worker:\n        await worker.submit(sample_flow)\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n```\n\nThe flow will log _\"Does the volume exist? -> False\"_. You can also see that the volume was not mounted with `docker inspect {createdImageTag}`. The only mounted volume is \"/tmp/\".\nHi! I traced this on current `main`. I have not run the full Docker MRE, but the reported configuration-path defect is still present.\n\nIn `src/integrations/prefect-docker/prefect_docker/worker.py`, the no-storage direct-submit path reads work-pool volume defaults from:\n\n`configuration.properties.volumes.default`\n\nCurrent base job templates store those defaults under:\n\n`variables.properties.volumes.default`\n\nBecause of that mismatch, the direct Docker submission path omits the work-pool default volume and retains only explicitly supplied volumes plus the temporary `/tmp` bundle mount.\n\nThe smallest fix appears to be correcting that lookup and adding focused regression coverage in `src/integrations/prefect-docker/tests/experimental/test_decorators.py` for:\n\n- a work-pool default volume with no explicit volume\n- default plus explicit volumes\n- preservation of the temporary bundle mount\n\nThe tests can use the existing mocked worker-run path, so they should not require Prefect Cloud or a real Docker daemon.\n\nWould this focused approach be welcome, and is anyone already working on the issue?\n\nI'd like to pick up this still-open bug. The incorrect template lookup is still present on current main. I saw that #22698 was closed by the stale bot, and reviewed the maintainer feedback there.\n\nI'll follow that feedback: resolve the job configuration through `from_template_and_values` first, then append the per-submission bundle mount to the resolved volumes when no bundle storage is configured. I'll add regressions at the Docker container-creation boundary for default volumes, explicit overrides, hard-coded volumes, and a custom template variable. This should preserve the normal template/override contract and keep the internal bundle available for customized templates.\n\nI'll credit #22698 in the follow-up PR and include failing-before/passing-after test evidence.\n", "created_at": "2026-10-31T04:37:40Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23682, "instance_id": "PrefectHQ__prefect-23682", "issue_numbers": ["23676"], "base_commit": "bd4807c3f402e0390e945527178e746a4ca3a6d7", "patch": "diff --git a/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.tsx b/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.tsx\nindex 2f6c5e7e81df..18b0946e117b 100644\n--- a/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.tsx\n+++ b/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.tsx\n@@ -1,5 +1,5 @@\n import { parseISO } from \"date-fns\";\n-import { formatInTimeZone, toZonedTime } from \"date-fns-tz\";\n+import { formatInTimeZone } from \"date-fns-tz\";\n import { useState } from \"react\";\n import { DateTimePicker } from \"@/components/ui/date-time-picker\";\n import { TimezoneSelect } from \"@/components/ui/timezone-select\";\n@@ -39,9 +39,8 @@ export function SchemaFormInputStringFormatDateTime({\n \n \t\tif (value) {\n \t\t\tconst date = parseISO(value);\n-\t\t\tconst zonedDate = toZonedTime(date, newTimezone);\n \t\t\tconst formattedWithTimezone = formatInTimeZone(\n-\t\t\t\tzonedDate,\n+\t\t\t\tdate,\n \t\t\t\tnewTimezone,\n \t\t\t\t\"yyyy-MM-dd'T'HH:mm:ssXXX\",\n \t\t\t);\ndiff --git a/ui-v2/src/components/schemas/stories/properties.stories.tsx b/ui-v2/src/components/schemas/stories/properties.stories.tsx\nindex c9d23fe3f3af..94fa4e27c8bd 100644\n--- a/ui-v2/src/components/schemas/stories/properties.stories.tsx\n+++ b/ui-v2/src/components/schemas/stories/properties.stories.tsx\n@@ -138,6 +138,13 @@ export const TypeStringWithFormatDateTime: Story = {\n };\n TypeStringWithFormatDateTime.storyName = \"type:string & format:date-time\";\n \n+export const DateTimeWithTimezone: Story = {\n+\targs: {\n+\t\t...TypeStringWithFormatDateTime.args,\n+\t\tvalues: { name: \"2024-01-15T15:30:00Z\" },\n+\t},\n+};\n+\n export const TypeStringWithFormatTimeDelta: Story = {\n \targs: {\n \t\tschema: {\n", "test_patch": "diff --git a/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.test.tsx b/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.test.tsx\nindex 812da6aabd7a..5ccaf4e29e52 100644\n--- a/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.test.tsx\n+++ b/ui-v2/src/components/schemas/schema-form-input-string-format-datetime.test.tsx\n@@ -1,8 +1,73 @@\n import { render, screen } from \"@testing-library/react\";\n-import { describe, expect, test, vi } from \"vitest\";\n+import userEvent from \"@testing-library/user-event\";\n+import { mockPointerEvents } from \"@tests/utils/browser\";\n+import { beforeAll, describe, expect, test, vi } from \"vitest\";\n import { SchemaFormInputStringFormatDateTime } from \"./schema-form-input-string-format-datetime\";\n \n describe(\"SchemaFormInputStringFormatDateTime\", () => {\n+\tbeforeAll(mockPointerEvents);\n+\n+\ttest.each([\n+\t\t[\n+\t\t\t\"2024-01-15T15:30:00Z\",\n+\t\t\t\"America/New_York\",\n+\t\t\t\"America / New York\",\n+\t\t\t\"2024-01-15T10:30:00-05:00\",\n+\t\t],\n+\t\t[\n+\t\t\t\"2024-07-15T15:30:00Z\",\n+\t\t\t\"America/New_York\",\n+\t\t\t\"America / New York\",\n+\t\t\t\"2024-07-15T11:30:00-04:00\",\n+\t\t],\n+\t\t[\n+\t\t\t\"2024-01-15T15:30:00Z\",\n+\t\t\t\"Asia/Katmandu\",\n+\t\t\t\"Asia / Katmandu\",\n+\t\t\t\"2024-01-15T21:15:00+05:45\",\n+\t\t],\n+\t\t[\"2024-01-15T10:30:00-05:00\", \"UTC\", \"UTC\", \"2024-01-15T15:30:00Z\"],\n+\t])(\n+\t\t\"preserves the instant when changing %s to %s\",\n+\t\tasync (value, timezone, label, expected) => {\n+\t\t\tconst user = userEvent.setup();\n+\t\t\tconst onValueChange = vi.fn();\n+\t\t\trender(\n+\t\t\t\t<SchemaFormInputStringFormatDateTime\n+\t\t\t\t\tvalue={value}\n+\t\t\t\t\tonValueChange={onValueChange}\n+\t\t\t\t\tid=\"test-id\"\n+\t\t\t\t/>,\n+\t\t\t);\n+\t\t\tawait user.click(\n+\t\t\t\tscreen.getByRole(\"button\", { name: /select timezone/i }),\n+\t\t\t);\n+\t\t\tawait user.type(screen.getByPlaceholderText(\"Search\"), timezone);\n+\t\t\tawait user.click(await screen.findByRole(\"option\", { name: label }));\n+\t\t\texpect(onValueChange).toHaveBeenLastCalledWith(expected);\n+\t\t},\n+\t);\n+\n+\ttest(\"changing timezone does not populate an unset datetime\", async () => {\n+\t\tconst user = userEvent.setup();\n+\t\tconst onValueChange = vi.fn();\n+\t\trender(\n+\t\t\t<SchemaFormInputStringFormatDateTime\n+\t\t\t\tvalue={undefined}\n+\t\t\t\tonValueChange={onValueChange}\n+\t\t\t\tid=\"test-id\"\n+\t\t\t/>,\n+\t\t);\n+\t\tawait user.click(screen.getByRole(\"button\", { name: /select timezone/i }));\n+\t\tawait user.type(screen.getByPlaceholderText(\"Search\"), \"America/New_York\");\n+\t\tawait user.click(\n+\t\t\tawait screen.findByRole(\"option\", {\n+\t\t\t\tname: \"America / New York\",\n+\t\t\t}),\n+\t\t);\n+\t\texpect(onValueChange).not.toHaveBeenCalled();\n+\t});\n+\n \ttest(\"renders without crashing\", () => {\n \t\tconst onValueChange = vi.fn();\n \n", "problem_statement": "Schema form timezone changes apply the offset twice and shift datetime values\n### Bug summary\n\nIn the React UI's schema form, changing the timezone of an existing datetime changes the instant submitted by the form. `SchemaFormInputStringFormatDateTime.handleTimezoneChange` calls `toZonedTime` and then passes that shifted `Date` to `formatInTimeZone`, applying the conversion twice. The result also depends on the browser's local timezone.\n\n### Reproduction\n\nWith the browser timezone set to UTC, render a schema form with:\n\n```json\n{\n  \"type\": \"object\",\n  \"properties\": {\n    \"start\": {\"type\": \"string\", \"format\": \"date-time\", \"title\": \"Start\"}\n  }\n}\n```\n\nand values `{\"start\":\"2024-01-15T15:30:00Z\"}`. Select `America/New_York` in the timezone selector.\n\n- Expected: `2024-01-15T10:30:00-05:00`, preserving the instant.\n- Actual: `2024-01-15T05:30:00-05:00`, five hours earlier.\n\nA summer input (`2024-07-15T15:30:00Z`) emits `07:30-04:00` instead of `11:30-04:00`. Selecting `Asia/Katmandu` for the January input emits `2024-01-16T03:00:00+05:45` instead of `2024-01-15T21:15:00+05:45`.\n\nReproduced on `main` at `bd4807c3f402e0390e945527178e746a4ca3a6d7` using the actual component and timezone selector with Vitest/Testing Library, Node 24.22.1, and `TZ=UTC`. Three added regression cases fail with the values above; the existing four tests pass.\n\n### Proposed contribution\n\nI'd like to submit a focused fix that formats the original parsed instant directly in the selected timezone, removing the intermediate `toZonedTime`. I'll include regression coverage for standard time, daylight saving time, a fractional offset, UTC, and an unset value, and validate the form in Chrome under different browser timezones. This only changes the schema-form timezone selector's conversion, with no scheduling or API changes.\n\n", "hints_text": "", "created_at": "2026-10-31T04:24:00Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23669, "instance_id": "PrefectHQ__prefect-23669", "issue_numbers": ["23668"], "base_commit": "599697348089e83823cb4ef63ff219c53eefec22", "patch": "diff --git a/src/prefect/flow_runs.py b/src/prefect/flow_runs.py\nindex 75c4cdf41646..02d85faf1ef7 100644\n--- a/src/prefect/flow_runs.py\n+++ b/src/prefect/flow_runs.py\n@@ -133,6 +133,7 @@ async def main(num_runs: int):\n     )\n \n     with anyio.move_on_after(timeout):\n+        received_final_event = False\n         async with get_events_subscriber(filter=event_filter) as subscriber:\n             flow_run = await client.read_flow_run(flow_run_id)\n             if flow_run.state and flow_run.state.is_final():\n@@ -151,7 +152,19 @@ async def main(num_runs: int):\n                     logger.info(f\"Flow run is in state {state.name!r}\")\n \n                 if state.is_final():\n-                    return await client.read_flow_run(flow_run_id)\n+                    received_final_event = True\n+                    break\n+\n+        if received_final_event:\n+            # A final state event can be delivered before the state change is\n+            # visible to API reads, so read until the run reports a final state\n+            poll_delay = 0.1\n+            while True:\n+                flow_run = await client.read_flow_run(flow_run_id)\n+                if flow_run.state and flow_run.state.is_final():\n+                    return flow_run\n+                await anyio.sleep(poll_delay)\n+                poll_delay = min(poll_delay * 2, 5)\n \n     raise FlowRunWaitTimeout(\n         f\"Flow run with ID {flow_run_id} exceeded watch timeout of {timeout} seconds\"\n", "test_patch": "diff --git a/tests/test_flow_runs.py b/tests/test_flow_runs.py\nindex 3dba383d8079..fe226745ba98 100644\n--- a/tests/test_flow_runs.py\n+++ b/tests/test_flow_runs.py\n@@ -1,12 +1,16 @@\n import asyncio\n import time\n import uuid\n+from collections.abc import AsyncIterator\n+from contextlib import asynccontextmanager\n+from typing import Any\n \n import pytest\n \n import prefect.client.schemas as client_schemas\n from prefect import flow\n from prefect.client.orchestration import PrefectClient\n+from prefect.events import Event, Resource\n from prefect.events.utilities import emit_event\n from prefect.exceptions import FlowRunWaitTimeout, NotPausedError\n from prefect.flow_engine import run_flow_async\n@@ -20,7 +24,7 @@\n     wait_for_flow_run,\n )\n from prefect.server.events.pipeline import EventsPipeline\n-from prefect.states import Completed, Pending\n+from prefect.states import Completed, Pending, Running\n \n \n async def test_create_then_wait_for_flow_run(prefect_client: PrefectClient):\n@@ -94,6 +98,92 @@ async def _emit_heartbeat():\n     assert finished_flow_run.state.is_completed()\n \n \n+class TestWaitForFlowRunAfterFinalEvent:\n+    \"\"\"\n+    Regression tests for https://github.com/PrefectHQ/prefect/issues/23668\n+    \"\"\"\n+\n+    @pytest.fixture\n+    async def flow_run(self, prefect_client: PrefectClient) -> client_schemas.FlowRun:\n+        @flow(name=f\"foo_{uuid.uuid4()}\")\n+        def foo():\n+            pass\n+\n+        return await prefect_client.create_flow_run(foo, state=Running())\n+\n+    @pytest.fixture\n+    def stale_reads(\n+        self,\n+        monkeypatch: pytest.MonkeyPatch,\n+        prefect_client: PrefectClient,\n+        flow_run: client_schemas.FlowRun,\n+    ) -> list[client_schemas.FlowRun]:\n+        \"\"\"\n+        Delivers a `Completed` event after moving the flow run to `Completed`,\n+        while API reads return the pre-transition flow run until the returned\n+        list is cleared.\n+        \"\"\"\n+        stale = [flow_run]\n+        read_flow_run = prefect_client.read_flow_run\n+\n+        async def _read_flow_run(flow_run_id: uuid.UUID) -> client_schemas.FlowRun:\n+            fresh = await read_flow_run(flow_run_id)\n+            return stale[0] if stale else fresh\n+\n+        @asynccontextmanager\n+        async def _subscriber(**kwargs: Any) -> AsyncIterator[AsyncIterator[Event]]:\n+            async def _events() -> AsyncIterator[Event]:\n+                await prefect_client.set_flow_run_state(\n+                    flow_run.id, Completed(), force=True\n+                )\n+                yield Event(\n+                    event=\"prefect.flow-run.Completed\",\n+                    resource=Resource(\n+                        {\n+                            \"prefect.resource.id\": f\"prefect.flow-run.{flow_run.id}\",\n+                            \"prefect.state-type\": \"COMPLETED\",\n+                        }\n+                    ),\n+                )\n+                await asyncio.Event().wait()\n+\n+            yield _events()\n+\n+        monkeypatch.setattr(prefect_client, \"read_flow_run\", _read_flow_run)\n+        monkeypatch.setattr(\"prefect.flow_runs.get_events_subscriber\", _subscriber)\n+        return stale\n+\n+    async def test_reads_until_final_state_after_final_event(\n+        self,\n+        prefect_client: PrefectClient,\n+        flow_run: client_schemas.FlowRun,\n+        stale_reads: list[client_schemas.FlowRun],\n+    ):\n+        async def _become_visible() -> None:\n+            await asyncio.sleep(0.5)\n+            stale_reads.clear()\n+\n+        visibility_task = asyncio.create_task(_become_visible())\n+\n+        finished_flow_run = await wait_for_flow_run(\n+            flow_run.id, timeout=10, client=prefect_client\n+        )\n+        await visibility_task\n+\n+        assert finished_flow_run.id == flow_run.id\n+        assert finished_flow_run.state is not None\n+        assert finished_flow_run.state.is_completed()\n+\n+    async def test_raises_timeout_if_final_state_never_visible(\n+        self,\n+        prefect_client: PrefectClient,\n+        flow_run: client_schemas.FlowRun,\n+        stale_reads: list[client_schemas.FlowRun],\n+    ):\n+        with pytest.raises(FlowRunWaitTimeout):\n+            await wait_for_flow_run(flow_run.id, timeout=1, client=prefect_client)\n+\n+\n class TestResumeFlowRunAsyncDispatch:\n     \"\"\"Tests for the async_dispatch migration of resume_flow_run.\"\"\"\n \n", "problem_statement": "`wait_for_flow_run` can return a non-final state after a terminal event\n## Description\n\n`wait_for_flow_run` is documented to return a finished flow run, but it can return a run in a non-final state when the read after a terminal event sees an older state. This can cause a parent flow to report a successful child as unfinished.\n\nThis issue and its analysis were prepared with AI assistance. The proposed event-before-commit mechanism below is a hypothesis based on source inspection, not a confirmed root cause for the observed incident.\n\n## Steps to Reproduce\n\nA deterministic end-to-end reproduction is not yet available. The possible ordering is:\n\n1. A flow run transitions from Running to Completed.\n2. A waiter receives the Completed event before the corresponding state update is visible to a separate API read.\n3. The waiter's subsequent read returns Running.\n4. The waiter returns that non-final FlowRun to its caller.\n\nIn one observed deployment, a parent reported a child as Running despite the child having completed before the parent reported failure. The reason for the non-final read has not been independently established.\n\n## Expected Behavior\n\n`wait_for_flow_run` returns a run in a final state, or raises its timeout exception.\n\n## Actual Behavior\n\nA non-final FlowRun can be returned after a terminal event, so callers may incorrectly treat a successful child as unfinished.\n\n## Environment\n\n- Observed with a Prefect 3.7.8 client.\n- Source inspection shows the same single-read behavior in 3.8.8 and 3.9.0; the issue has not been reproduced on those versions.\n\n## Additional Context\n\nIn the [3.7.8 server](https://github.com/PrefectHQ/prefect/blob/3.7.8/src/prefect/server/orchestration/instrumentation_policies.py), transition instrumentation publishes an event during orchestration. The [state endpoint](https://github.com/PrefectHQ/prefect/blob/3.7.8/src/prefect/server/api/flow_runs.py) runs orchestration inside a transaction, which exits afterward. This appears to allow an event to be published before commit. The [waiter](https://github.com/PrefectHQ/prefect/blob/3.7.8/src/prefect/flow_runs.py) reads once after receiving a final event and returns the result without checking whether the returned state is final.\n\nCould the waiter verify that the returned state is final, within the original timeout, or could event publication be ordered after commit? A regression test covering a terminal event followed by a stale non-final read would help establish the intended contract.\n\nRelated but different: #22549 concerns the CLI watch path and websocket disconnects.\n", "hints_text": "", "created_at": "2026-10-30T08:16:30Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23664, "instance_id": "PrefectHQ__prefect-23664", "issue_numbers": ["23663"], "base_commit": "71d4a25b006aa7a14c16c9f2abda9d8dc172a85d", "patch": "diff --git a/src/prefect/server/AGENTS.md b/src/prefect/server/AGENTS.md\nindex ae8f220681fd..3a95c23fe9ab 100644\n--- a/src/prefect/server/AGENTS.md\n+++ b/src/prefect/server/AGENTS.md\n@@ -68,7 +68,7 @@ alembic_revision(\"description\")      # Create a new migration\n \n - **CANCELLING state transitions must call `maybe_schedule_cancelling_timeout_check_for_state()`.** Any new API path that accepts a CANCELLING transition should call this after `SetStateStatus.ACCEPT`; failures are intentionally non-fatal \u2014 log and swallow, do not raise. `cancel_subflow_run` deliberately skips subflows already in CANCELLING to preserve their existing timeout deadline \u2014 this guard has no inline comment but removing it resets the deadline. The `ensure_cancelling_timeout_checks` perpetual service re-seeds missed checks on server restart.\n \n-- **`record_bulk_task_run_events` batches must be sorted by conflict key before upserting.** In `services/task_run_recorder.py`, task runs are sorted by conflict key \u2014 natural key `(flow_run_id, task_key, dynamic_key)` when available, otherwise `(\"id\", task_run_id)` \u2014 before batching into upsert groups. This enforces deterministic row-level lock acquisition order across concurrent recorder instances; removing or reordering the sort causes deadlocks. Events that collide on either `id` or natural key are coalesced via union-find to a single canonical ID \u2014 the input `TaskRun.id` and `state.state_details.task_run_id` are mutated in-place to that canonical value. Any refactor that re-batches or re-merges must re-sort by conflict key. The function retries once internally on `IntegrityError` to handle TOCTOU races between concurrent recorders, then re-raises on a second failure \u2014 callers must catch `IntegrityError` or re-queue the batch.\n+- **`record_bulk_task_run_events` batches must be sorted by conflict key before upserting.** In `services/task_run_recorder.py`, task runs are sorted by conflict key \u2014 natural key `(flow_run_id, task_key, dynamic_key)` when available, otherwise `(\"id\", task_run_id)` \u2014 before batching into upsert groups. This enforces deterministic row-level lock acquisition order across concurrent recorder instances; removing or reordering the sort causes deadlocks. Events that collide on either `id` or natural key are coalesced via union-find to a single canonical ID \u2014 the input `TaskRun.id` and `state.state_details.task_run_id` are mutated in-place to that canonical value. Any refactor that re-batches or re-merges must re-sort by conflict key. The function retries once internally on `IntegrityError` to handle TOCTOU races between concurrent recorders, then re-raises on a second failure \u2014 callers must catch `IntegrityError` or re-queue the batch. Events whose `flow_run_id` no longer exists are dropped with a warning before the upsert, since one foreign-key violation would otherwise fail the whole batch (#23663).\n \n - **`_segment_task_runs_for_upsert` must keep emitting contiguous blocks of its input.** That property, not the batch key, is what preserves the lock ordering above, so a new condition may only *close* a segment earlier \u2014 never reorder rows. Each existing condition guards a failure that is silent on at least one dialect; see its docstring and `_fillable_columns` before relaxing one. Absent keys are `NULL`-filled and restored with `coalesce(excluded.col, task_run.col)`, applied to exactly the columns that were filled \u2014 a payload asking to write a real `NULL` keeps a plain `excluded.col`, and the batch splits rather than let one statement mean both. This is also why `flow_run_id` must stay out of `_fillable_columns`: coalescing it would break detach.\n \ndiff --git a/src/prefect/server/services/task_run_recorder.py b/src/prefect/server/services/task_run_recorder.py\nindex d57c4db03356..9e8aa1e3402c 100644\n--- a/src/prefect/server/services/task_run_recorder.py\n+++ b/src/prefect/server/services/task_run_recorder.py\n@@ -231,6 +231,48 @@ def _segment_task_runs_for_upsert(\n     return segments\n \n \n+@db_injector\n+async def _drop_task_runs_of_missing_flow_runs(\n+    db: PrefectDBInterface, task_runs: list[_TaskRunRecord]\n+) -> list[_TaskRunRecord]:\n+    \"\"\"Drop the task runs whose flow run does not exist, such as a deleted one.\n+\n+    Inserting one would violate the `task_run.flow_run_id` foreign key and fail\n+    the whole batch, so every other event in it would fail along with it.\n+    \"\"\"\n+    flow_run_ids = {\n+        tr.task_run.flow_run_id\n+        for tr in task_runs\n+        if tr.task_run.flow_run_id is not None\n+    }\n+    if not flow_run_ids:\n+        return task_runs\n+\n+    async with db.session_context() as session:\n+        result = await session.execute(\n+            sa.select(db.FlowRun.id).where(db.FlowRun.id.in_(flow_run_ids))\n+        )\n+        existing_flow_run_ids = set(result.scalars().all())\n+\n+    kept: list[_TaskRunRecord] = []\n+    for tr in task_runs:\n+        task_run = tr.task_run\n+        if (\n+            task_run.flow_run_id is None\n+            or task_run.flow_run_id in existing_flow_run_ids\n+        ):\n+            kept.append(tr)\n+            continue\n+        assert task_run.state is not None\n+        logger.warning(\n+            \"Dropping event %s for task run %s: flow run %s does not exist\",\n+            task_run.state.id,\n+            task_run.id,\n+            task_run.flow_run_id,\n+        )\n+    return kept\n+\n+\n @db_injector\n async def _insert_task_run_states(\n     db: PrefectDBInterface, session: AsyncSession, task_runs: list[TaskRun]\n@@ -343,11 +385,15 @@ async def record_task_run_event(event: ReceivedEvent, depth: int = 0) -> None:\n async def record_bulk_task_run_events(events: list[ReceivedEvent]) -> None:\n     \"\"\"Record multiple task run events in the database, taking advantage of bulk inserts.\n \n+    Events whose flow run does not exist are dropped with a warning, so they\n+    cannot fail the rest of the batch on the `flow_run_id` foreign key.\n+\n     Retries once on `IntegrityError` to handle TOCTOU races between concurrent\n     recorder instances: when two batches reference the same `task_run.id` with\n     different natural keys, one batch's existence-check SELECT may run before\n     the other batch's INSERT commits. The retry re-runs the SELECT in a fresh\n-    session so the conflict target is chosen against the now-visible row.\n+    session so the conflict target is chosen against the now-visible row. It\n+    also covers a flow run deleted between its existence check and the insert.\n     \"\"\"\n \n     max_attempts = 2\n@@ -373,11 +419,15 @@ async def _record_bulk_task_run_events(events: list[ReceivedEvent]) -> None:\n \n     now = prefect.types._datetime.now(\"UTC\")\n \n-    all_task_runs = [\n-        _TaskRunRecord(task_run=task_run, task_run_dict=task_run_dict)\n-        for event in events\n-        for task_run, task_run_dict in [db_recordable_task_run_from_event(event)]\n-    ]\n+    all_task_runs = await _drop_task_runs_of_missing_flow_runs(\n+        [\n+            _TaskRunRecord(task_run=task_run, task_run_dict=task_run_dict)\n+            for event in events\n+            for task_run, task_run_dict in [db_recordable_task_run_from_event(event)]\n+        ]\n+    )\n+    if not all_task_runs:\n+        return\n \n     # Drop duplicate task run rows, keep the one with the latest state_timestamp.\n     # A single bulk flush can contain events that collide on either id or natural\n", "test_patch": "diff --git a/tests/server/services/test_task_run_recorder.py b/tests/server/services/test_task_run_recorder.py\nindex 1f98be65c691..2b181386f28c 100644\n--- a/tests/server/services/test_task_run_recorder.py\n+++ b/tests/server/services/test_task_run_recorder.py\n@@ -2159,6 +2159,77 @@ async def test_bulk_upsert_detaches_a_task_run_from_its_flow_run(\n     assert task_run.flow_run_id is None\n \n \n+async def test_bulk_upsert_drops_events_for_missing_flow_runs(\n+    session: AsyncSession,\n+    flow_run: FlowRun,\n+    caplog: pytest.LogCaptureFixture,\n+):\n+    \"\"\"An event whose flow run does not exist would violate the `flow_run_id`\n+    foreign key and fail the whole batch, so it is dropped on its own and the\n+    rest of the batch is recorded.\n+    \"\"\"\n+    flow_run_id = flow_run.id\n+    valid_task_run_id = str(uuid4())\n+    orphan_task_run_id = str(uuid4())\n+    missing_flow_run_id = str(uuid4())\n+    orphan = upsert_event(missing_flow_run_id, 1, task_run_id=orphan_task_run_id)\n+\n+    with caplog.at_level(\"WARNING\"):\n+        await task_run_recorder.record_bulk_task_run_events(\n+            [\n+                upsert_event(str(flow_run_id), 0, task_run_id=valid_task_run_id),\n+                orphan,\n+                upsert_event(None, 2),\n+            ]\n+        )\n+\n+    session.expire_all()\n+    task_run = await read_task_run(session=session, task_run_id=valid_task_run_id)\n+    assert task_run is not None\n+    assert task_run.flow_run_id == flow_run_id\n+    assert len(await read_task_run_states(session, task_run.id)) == 1\n+\n+    assert await read_task_run(session=session, task_run_id=orphan_task_run_id) is None\n+    assert str(orphan.id) in caplog.text\n+    assert missing_flow_run_id in caplog.text\n+\n+\n+async def test_bulk_upsert_with_only_events_for_missing_flow_runs(\n+    session: AsyncSession,\n+):\n+    task_run_id = str(uuid4())\n+\n+    await task_run_recorder.record_bulk_task_run_events(\n+        [upsert_event(str(uuid4()), task_run_id=task_run_id)]\n+    )\n+\n+    assert await read_task_run(session=session, task_run_id=task_run_id) is None\n+\n+\n+async def test_consumer_records_batch_containing_event_for_missing_flow_run(\n+    session: AsyncSession,\n+    flow_run: FlowRun,\n+    caplog: pytest.LogCaptureFixture,\n+):\n+    \"\"\"Regression test for https://github.com/PrefectHQ/prefect/issues/23663\"\"\"\n+    valid_task_run_id = str(uuid4())\n+\n+    async with task_run_recorder.consumer(\n+        write_batch_size=2, flush_every=1, max_persist_retries=0\n+    ) as handler:\n+        with caplog.at_level(\"ERROR\"):\n+            await handler(message(upsert_event(str(uuid4()), 0)))\n+            await handler(\n+                message(\n+                    upsert_event(str(flow_run.id), 1, task_run_id=valid_task_run_id)\n+                )\n+            )\n+\n+    assert \"Error flushing\" not in caplog.text\n+    session.expire_all()\n+    assert await read_task_run(session=session, task_run_id=valid_task_run_id)\n+\n+\n async def test_bulk_upsert_statements_stay_within_the_parameter_budget(\n     session: AsyncSession,\n     flow_run: FlowRun,\n", "problem_statement": "Task run recorder drops valid events when one event in a batch references a missing flow run\n### Bug summary\n\nThe task run recorder writes task-run events in batches. If one event in a batch refers to a flow run that doesn't exist (e.g. a deleted one), the insert hits a foreign-key violation and the whole batch fails. The failed events are retried together with new ones, so the bad event keeps failing later batches until valid events from other flow runs run out of retries and are dropped.\n\nAs a result, task runs of healthy flow runs can be left without their final state, or never be created.\n\nSuggested fix: on a foreign-key violation, drop only the offending event instead of failing the batch.\n\n### Version info\n\n```Text\nPrefect server 3.8.6 (PostgreSQL); the same code is on main.\n```\n\n", "hints_text": "", "created_at": "2026-10-29T19:15:34Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23659, "instance_id": "PrefectHQ__prefect-23659", "issue_numbers": ["23658"], "base_commit": "0473e6d78d3899f83d1b4b1a3da020f4ab06c5c2", "patch": "diff --git a/src/prefect/concurrency/AGENTS.md b/src/prefect/concurrency/AGENTS.md\nindex c978f3edd4a2..c835e721063b 100644\n--- a/src/prefect/concurrency/AGENTS.md\n+++ b/src/prefect/concurrency/AGENTS.md\n@@ -18,7 +18,7 @@ Does NOT define concurrency limits (server-side in `server/`). Does NOT handle t\n \n **`raise_on_lease_renewal_failure` (public parameter):** Controls lease renewal failure behavior independently from `strict`. When `None` (default), falls back to the value of `strict` for backward compatibility. Set to `False` to let long-running tasks continue even if a transient renewal error occurs; set to `True` to terminate immediately on renewal failure regardless of `strict`. This means `strict=True, raise_on_lease_renewal_failure=False` gives strict slot acquisition but non-fatal renewal failures, and vice versa.\n \n-**Lease renewal:** `_leases.py` starts a daemon thread that renews immediately on entry, then waits for 75% of `lease_duration` between renewals. The renewal thread uses the standard `get_client(sync_client=True)` path and retries each renewal up to 3 times with exponential backoff. If all attempts fail, a shared failure handler either cancels execution with the existing sync/async cancel scope or logs a warning, depending on `raise_on_lease_renewal_failure`.\n+**Lease renewal:** `_leases.py` starts a daemon thread that renews immediately on entry, then waits for 75% of `lease_duration` between renewals. The renewal thread uses the standard `get_client(sync_client=True)` path and retries each renewal up to 3 times with exponential backoff. If all attempts fail, a shared failure handler either cancels execution with the existing sync/async cancel scope or logs a warning, depending on `raise_on_lease_renewal_failure`. Exception: when a `flow_run_id` is given and renewal fails with `410 Gone`, the thread reads the flow run and stops without cancelling if its server state is final, because the terminal transition releases the lease before the engine receives the proposal response.\n \n **Sync/async lockstep invariant:** `asyncio.py`/`sync.py` and `_asyncio.py`/`_sync.py` are parallel implementations. Any behavior change to one must be mirrored in the other.\n \ndiff --git a/src/prefect/concurrency/_leases.py b/src/prefect/concurrency/_leases.py\nindex 3cd97ea7a1df..19435b40198b 100644\n--- a/src/prefect/concurrency/_leases.py\n+++ b/src/prefect/concurrency/_leases.py\n@@ -4,6 +4,9 @@\n from typing import TYPE_CHECKING, AsyncGenerator, Generator\n from uuid import UUID\n \n+import httpx\n+\n+from prefect._internal.compatibility.starlette import status\n from prefect._internal.concurrency.cancellation import (\n     AsyncCancelScope,\n     WatcherThreadCancelScope,\n@@ -90,6 +93,45 @@ def _lease_renewal_loop(\n             stop_event.wait(lease_duration * _RENEWAL_FRACTION)\n \n \n+def _lease_released_by_final_flow_run(\n+    exc: BaseException, lease_id: UUID, flow_run_id: UUID | None\n+) -> bool:\n+    \"\"\"\n+    Check whether a lease renewal failure is explained by the flow run having\n+    reached a final state on the server, which releases the lease before the\n+    engine has received the response to its terminal state proposal.\n+    \"\"\"\n+    if flow_run_id is None or not (\n+        isinstance(exc, httpx.HTTPStatusError)\n+        and exc.response.status_code == status.HTTP_410_GONE\n+    ):\n+        return False\n+\n+    logger = get_logger(\"concurrency\")\n+    try:\n+        with get_client(sync_client=True) as client:\n+            flow_run = client.read_flow_run(flow_run_id)\n+    except Exception:\n+        logger.debug(\n+            \"Failed to read flow run %s after its concurrency lease was not found\",\n+            flow_run_id,\n+            exc_info=True,\n+        )\n+        return False\n+\n+    if flow_run.state is None or not flow_run.state.is_final():\n+        return False\n+\n+    logger.debug(\n+        \"Concurrency lease %s was released because flow run %s reached final \"\n+        \"state %s; stopping lease renewal\",\n+        lease_id,\n+        flow_run_id,\n+        flow_run.state.type.value,\n+    )\n+    return True\n+\n+\n def _handle_lease_renewal_failure(\n     exc: BaseException,\n     lease_id: UUID,\n@@ -139,6 +181,7 @@ def _start_lease_renewal_thread(\n     raise_on_lease_renewal_failure: bool,\n     suppress_warnings: bool,\n     cancel_scope: AsyncCancelScope | WatcherThreadCancelScope,\n+    flow_run_id: UUID | None = None,\n ) -> tuple[threading.Event, threading.Thread]:\n     stop_event = threading.Event()\n     renewal_ctx = contextvars.copy_context()\n@@ -152,14 +195,17 @@ def _run_with_failure_handler() -> None:\n         try:\n             _lease_renewal_loop(lease_id, lease_duration, stop_event)\n         except Exception as exc:\n-            if not stop_event.is_set():\n-                _handle_lease_renewal_failure(\n-                    exc,\n-                    lease_id,\n-                    raise_on_lease_renewal_failure,\n-                    suppress_warnings,\n-                    cancel_scope,\n-                )\n+            if stop_event.is_set() or _lease_released_by_final_flow_run(\n+                exc, lease_id, flow_run_id\n+            ):\n+                return\n+            _handle_lease_renewal_failure(\n+                exc,\n+                lease_id,\n+                raise_on_lease_renewal_failure,\n+                suppress_warnings,\n+                cancel_scope,\n+            )\n \n     def renewal_loop() -> None:\n         renewal_ctx.run(_run_with_failure_handler)\n@@ -179,6 +225,7 @@ def maintain_concurrency_lease(\n     lease_duration: float,\n     raise_on_lease_renewal_failure: bool = False,\n     suppress_warnings: bool = False,\n+    flow_run_id: UUID | None = None,\n ) -> Generator[None, None, None]:\n     \"\"\"\n     Maintain a concurrency lease for the given lease ID.\n@@ -187,6 +234,9 @@ def maintain_concurrency_lease(\n         lease_id: The ID of the lease to maintain.\n         lease_duration: The duration of the lease in seconds.\n         raise_on_lease_renewal_failure: A boolean specifying whether to raise an error if the lease renewal fails.\n+        flow_run_id: The ID of the flow run holding the lease. When the lease is\n+            not found and this flow run is final on the server, the lease was\n+            released by the terminal transition and execution is not terminated.\n     \"\"\"\n     with WatcherThreadCancelScope() as cancel_scope:\n         stop_event: threading.Event | None = None\n@@ -198,6 +248,7 @@ def maintain_concurrency_lease(\n                 raise_on_lease_renewal_failure,\n                 suppress_warnings,\n                 cancel_scope,\n+                flow_run_id,\n             )\n             yield\n         finally:\n@@ -213,6 +264,7 @@ async def amaintain_concurrency_lease(\n     lease_duration: float,\n     raise_on_lease_renewal_failure: bool = False,\n     suppress_warnings: bool = False,\n+    flow_run_id: UUID | None = None,\n ) -> AsyncGenerator[None, None]:\n     \"\"\"\n     Maintain a concurrency lease for the given lease ID.\n@@ -221,6 +273,9 @@ async def amaintain_concurrency_lease(\n         lease_id: The ID of the lease to maintain.\n         lease_duration: The duration of the lease in seconds.\n         raise_on_lease_renewal_failure: A boolean specifying whether to raise an error if the lease renewal fails.\n+        flow_run_id: The ID of the flow run holding the lease. When the lease is\n+            not found and this flow run is final on the server, the lease was\n+            released by the terminal transition and execution is not terminated.\n     \"\"\"\n     with AsyncCancelScope() as cancel_scope:\n         stop_event: threading.Event | None = None\n@@ -231,6 +286,7 @@ async def amaintain_concurrency_lease(\n                 raise_on_lease_renewal_failure,\n                 suppress_warnings,\n                 cancel_scope,\n+                flow_run_id,\n             )\n             yield\n         finally:\ndiff --git a/src/prefect/flow_engine.py b/src/prefect/flow_engine.py\nindex a6803a902ef9..d0ca875ec015 100644\n--- a/src/prefect/flow_engine.py\n+++ b/src/prefect/flow_engine.py\n@@ -1137,7 +1137,10 @@ def setup_run_context(self, client: Optional[SyncPrefectClient] = None):\n             if lease_id := self.state.state_details.deployment_concurrency_lease_id:\n                 stack.enter_context(\n                     maintain_concurrency_lease(\n-                        lease_id, 300, raise_on_lease_renewal_failure=True\n+                        lease_id,\n+                        300,\n+                        raise_on_lease_renewal_failure=True,\n+                        flow_run_id=self.flow_run.id,\n                     )\n                 )\n \n@@ -1865,7 +1868,10 @@ async def setup_run_context(self, client: Optional[PrefectClient] = None):\n             if lease_id := self.state.state_details.deployment_concurrency_lease_id:\n                 await stack.enter_async_context(\n                     amaintain_concurrency_lease(\n-                        lease_id, 300, raise_on_lease_renewal_failure=True\n+                        lease_id,\n+                        300,\n+                        raise_on_lease_renewal_failure=True,\n+                        flow_run_id=self.flow_run.id,\n                     )\n                 )\n \n", "test_patch": "diff --git a/tests/concurrency/test_leases.py b/tests/concurrency/test_leases.py\nindex 559d1cc2a54e..585f0e947114 100644\n--- a/tests/concurrency/test_leases.py\n+++ b/tests/concurrency/test_leases.py\n@@ -1,10 +1,12 @@\n import asyncio\n import logging\n+import threading\n import time\n from contextlib import contextmanager\n from unittest import mock\n-from uuid import uuid4\n+from uuid import UUID, uuid4\n \n+import httpx\n import pytest\n \n from prefect import flow\n@@ -13,6 +15,7 @@\n     amaintain_concurrency_lease,\n     maintain_concurrency_lease,\n )\n+from prefect.states import Completed, Running, State\n \n pytestmark = pytest.mark.clear_db\n \n@@ -44,6 +47,20 @@ def _wait_for(predicate, timeout: float = 2.0) -> bool:\n     return predicate()\n \n \n+def _lease_gone() -> httpx.HTTPStatusError:\n+    request = httpx.Request(\"POST\", \"http://prefect.test/api/leases/renew\")\n+    return httpx.HTTPStatusError(\n+        \"410 Gone\", request=request, response=httpx.Response(410, request=request)\n+    )\n+\n+\n+def _renewal_thread_finished(lease_id: UUID) -> bool:\n+    return not any(\n+        thread.name == f\"concurrency-lease-renewal-{lease_id}\"\n+        for thread in threading.enumerate()\n+    )\n+\n+\n def test_maintain_concurrency_lease_renews_lease():\n     mock_client = mock.MagicMock()\n     lease_id = uuid4()\n@@ -198,3 +215,106 @@ def host_flow() -> None:\n         f\"failure log did not reach the run logger; got loggers=\"\n         f\"{[r.name for r in failure_records]}\"\n     )\n+\n+\n+@mock.patch(\n+    \"prefect.concurrency._leases.exponential_backoff_with_jitter\", _zero_backoff\n+)\n+def test_lease_gone_does_not_cancel_when_flow_run_is_final():\n+    mock_client = mock.MagicMock()\n+    mock_client.renew_concurrency_lease.side_effect = _lease_gone()\n+    mock_client.read_flow_run.return_value.state = Completed()\n+    lease_id = uuid4()\n+    flow_run_id = uuid4()\n+\n+    with _patch_renewal_client(mock_client):\n+        with maintain_concurrency_lease(\n+            lease_id=lease_id,\n+            lease_duration=60,\n+            raise_on_lease_renewal_failure=True,\n+            flow_run_id=flow_run_id,\n+        ):\n+            assert _wait_for(lambda: _renewal_thread_finished(lease_id))\n+\n+    assert mock_client.renew_concurrency_lease.call_count == 3\n+    mock_client.read_flow_run.assert_called_once_with(flow_run_id)\n+\n+\n+@mock.patch(\n+    \"prefect.concurrency._leases.exponential_backoff_with_jitter\", _zero_backoff\n+)\n+async def test_alease_gone_does_not_cancel_when_flow_run_is_final():\n+    mock_client = mock.MagicMock()\n+    mock_client.renew_concurrency_lease.side_effect = _lease_gone()\n+    mock_client.read_flow_run.return_value.state = Completed()\n+    lease_id = uuid4()\n+    flow_run_id = uuid4()\n+\n+    with _patch_renewal_client(mock_client):\n+        async with amaintain_concurrency_lease(\n+            lease_id=lease_id,\n+            lease_duration=60,\n+            raise_on_lease_renewal_failure=True,\n+            flow_run_id=flow_run_id,\n+        ):\n+            await asyncio.to_thread(\n+                _wait_for, lambda: _renewal_thread_finished(lease_id)\n+            )\n+            # A cancellation requested by the renewal thread would be delivered here\n+            await asyncio.sleep(0.1)\n+\n+    assert mock_client.renew_concurrency_lease.call_count == 3\n+    mock_client.read_flow_run.assert_called_once_with(flow_run_id)\n+\n+\n+@pytest.mark.parametrize(\n+    \"flow_run_state, renewal_error\",\n+    [\n+        pytest.param(Running(), _lease_gone(), id=\"lease-gone-flow-run-running\"),\n+        pytest.param(Completed(), RuntimeError(\"server down\"), id=\"other-failure\"),\n+    ],\n+)\n+@mock.patch(\n+    \"prefect.concurrency._leases.exponential_backoff_with_jitter\", _zero_backoff\n+)\n+async def test_lease_renewal_failure_cancels_unless_flow_run_released_lease(\n+    flow_run_state: State, renewal_error: Exception\n+):\n+    mock_client = mock.MagicMock()\n+    mock_client.renew_concurrency_lease.side_effect = renewal_error\n+    mock_client.read_flow_run.return_value.state = flow_run_state\n+\n+    with _patch_renewal_client(mock_client):\n+        with pytest.raises(asyncio.CancelledError):\n+            async with amaintain_concurrency_lease(\n+                lease_id=uuid4(),\n+                lease_duration=60,\n+                raise_on_lease_renewal_failure=True,\n+                flow_run_id=uuid4(),\n+            ):\n+                deadline = time.monotonic() + 2\n+                while time.monotonic() < deadline:\n+                    await asyncio.sleep(0.01)\n+                raise AssertionError(\"Lease renewal failure did not cancel\")\n+\n+\n+@mock.patch(\n+    \"prefect.concurrency._leases.exponential_backoff_with_jitter\", _zero_backoff\n+)\n+async def test_lease_gone_cancels_when_flow_run_cannot_be_read():\n+    mock_client = mock.MagicMock()\n+    mock_client.renew_concurrency_lease.side_effect = _lease_gone()\n+    mock_client.read_flow_run.side_effect = RuntimeError(\"server down\")\n+\n+    with _patch_renewal_client(mock_client):\n+        with pytest.raises(asyncio.CancelledError):\n+            async with amaintain_concurrency_lease(\n+                lease_id=uuid4(),\n+                lease_duration=60,\n+                raise_on_lease_renewal_failure=True,\n+                flow_run_id=uuid4(),\n+            ):\n+                deadline = time.monotonic() + 2\n+                while time.monotonic() < deadline:\n+                    await asyncio.sleep(0.01)\n+                raise AssertionError(\"Lease renewal failure did not cancel\")\ndiff --git a/tests/test_flow_engine.py b/tests/test_flow_engine.py\nindex aeb5ba20bfa6..d6bce080f813 100644\n--- a/tests/test_flow_engine.py\n+++ b/tests/test_flow_engine.py\n@@ -29,7 +29,7 @@\n from prefect.cache_policies import INPUTS\n from prefect.client.orchestration import PrefectClient, SyncPrefectClient, get_client\n from prefect.client.schemas.filters import FlowFilter, FlowFilterName, FlowRunFilter\n-from prefect.client.schemas.objects import StateType\n+from prefect.client.schemas.objects import FlowRun, StateType\n from prefect.client.schemas.sorting import FlowRunSort\n from prefect.concurrency.asyncio import concurrency as aconcurrency\n from prefect.concurrency.sync import concurrency\n@@ -5987,7 +5987,7 @@ def foo():\n         run_flow(foo, flow_run)\n \n         mock_maintain_concurrency_lease.assert_called_once_with(\n-            ANY, 300, raise_on_lease_renewal_failure=True\n+            ANY, 300, raise_on_lease_renewal_failure=True, flow_run_id=flow_run.id\n         )\n \n     async def test_lease_renewal_async(\n@@ -6022,9 +6022,108 @@ async def foo():\n         await run_flow(foo, flow_run)\n \n         mock_maintain_concurrency_lease.assert_called_once_with(\n-            ANY, 300, raise_on_lease_renewal_failure=True\n+            ANY, 300, raise_on_lease_renewal_failure=True, flow_run_id=flow_run.id\n         )\n \n+    @staticmethod\n+    def _renewal_thread(lease_id: UUID) -> threading.Thread:\n+        return next(\n+            thread\n+            for thread in threading.enumerate()\n+            if thread.name == f\"concurrency-lease-renewal-{lease_id}\"\n+        )\n+\n+    @pytest.fixture\n+    def fast_lease_renewal(self, monkeypatch: pytest.MonkeyPatch) -> None:\n+        # Renew every 30ms and retry without backoff so a renewal reaches the\n+        # server after the terminal transition has released the lease\n+        monkeypatch.setattr(\"prefect.concurrency._leases._RENEWAL_FRACTION\", 0.0001)\n+        monkeypatch.setattr(\n+            \"prefect.concurrency._leases.exponential_backoff_with_jitter\",\n+            lambda *args: 0.0,\n+        )\n+\n+    async def _create_concurrency_limited_flow_run(\n+        self, prefect_client: PrefectClient, flow_obj: Flow[Any, Any]\n+    ) -> tuple[FlowRun, UUID]:\n+        flow_id = await prefect_client.create_flow(flow_obj)\n+        deployment_id = await prefect_client.create_deployment(\n+            flow_id=flow_id,\n+            name=f\"test_lease_renewal_{uuid.uuid4()}\",\n+            concurrency_limit=1,\n+        )\n+        flow_run = await prefect_client.create_flow_run_from_deployment(deployment_id)\n+        state = await propose_state(prefect_client, states.Pending(), flow_run.id)\n+        lease_id = state.state_details.deployment_concurrency_lease_id\n+        assert lease_id is not None\n+        flow_run = await prefect_client.read_flow_run(flow_run.id)\n+        return flow_run, lease_id\n+\n+    @pytest.mark.usefixtures(\"fast_lease_renewal\")\n+    async def test_lease_released_by_terminal_state_does_not_crash_sync(\n+        self, prefect_client: PrefectClient, monkeypatch: pytest.MonkeyPatch\n+    ):\n+        @flow\n+        def foo():\n+            return 42\n+\n+        flow_run, lease_id = await self._create_concurrency_limited_flow_run(\n+            prefect_client, foo\n+        )\n+\n+        def propose_state_then_wait_for_renewal_failure(*args: Any, **kwargs: Any):\n+            # The server applies the terminal state and releases the lease, but the\n+            # engine does not process the response until renewal has given up\n+            state = propose_state_sync(*args, **kwargs)\n+            if state.is_final():\n+                self._renewal_thread(lease_id).join(timeout=10)\n+            return state\n+\n+        monkeypatch.setattr(\n+            \"prefect.flow_engine.propose_state_sync\",\n+            propose_state_then_wait_for_renewal_failure,\n+        )\n+\n+        assert run_flow(foo, flow_run) == 42\n+\n+        flow_run = await prefect_client.read_flow_run(flow_run.id)\n+        assert flow_run.state.is_completed()\n+\n+    @pytest.mark.usefixtures(\"fast_lease_renewal\")\n+    async def test_lease_released_by_terminal_state_does_not_crash_async(\n+        self, prefect_client: PrefectClient, monkeypatch: pytest.MonkeyPatch\n+    ):\n+        @flow\n+        async def foo():\n+            return 42\n+\n+        flow_run, lease_id = await self._create_concurrency_limited_flow_run(\n+            prefect_client, foo\n+        )\n+\n+        async def propose_state_then_wait_for_renewal_failure(\n+            *args: Any, **kwargs: Any\n+        ):\n+            # The server applies the terminal state and releases the lease, but the\n+            # engine does not process the response until renewal has given up\n+            state = await propose_state(*args, **kwargs)\n+            if state.is_final():\n+                await asyncio.to_thread(self._renewal_thread(lease_id).join, 10)\n+                # Give a cancellation requested by the renewal thread a chance to\n+                # be delivered before the engine records the terminal state\n+                await asyncio.sleep(0.1)\n+            return state\n+\n+        monkeypatch.setattr(\n+            \"prefect.flow_engine.propose_state\",\n+            propose_state_then_wait_for_renewal_failure,\n+        )\n+\n+        assert await run_flow(foo, flow_run) == 42\n+\n+        flow_run = await prefect_client.read_flow_run(flow_run.id)\n+        assert flow_run.state.is_completed()\n+\n \n class TestFlowRunEngineHeartbeat:\n     \"\"\"Tests for heartbeat integration in the flow run engine.\"\"\"\n", "problem_statement": "Deployment concurrency lease renewal gets 410 after the server applies the terminal state, and crashes a run that completed\n### Bug summary\n\nA deployment-concurrency lease renewal can get `410 Gone` after the server has applied the run's terminal state and released the lease, while the client has not yet processed the answer to that terminal proposal. The renewal thread then spends its three attempts and cancels the run's scope. The run had completed on the server. It is reported as Crashed. When flows run in-process inside a worker, the cancellation also ends the worker's other runs (reported separately to the worker's vendor).\n\nThis is a residual case of #18942. #19181 suppresses the cancellation when the local state is final. In this case the local state is not final yet: `AsyncFlowRunEngine.set_state` assigns `self.flow_run.state` only after `propose_state` returns.\n\n**The path, read in 3.8.6:**\n\n1. `SecureFlowConcurrencySlots` creates the lease on PENDING. `ReleaseFlowConcurrencySlots` revokes it on the transition to a terminal state (`server/orchestration/core_policy.py`).\n2. `setup_run_context` enters `amaintain_concurrency_lease(lease_id, 300, raise_on_lease_renewal_failure=True)` (`flow_engine.py`).\n3. The renewal thread renews immediately and then every 225 s, with 3 attempts and a backoff of about 1 s and 2 s (`concurrency/_leases.py`). It stops only when the run context exits.\n4. The renew route answers `410` when the lease is absent (`server/api/concurrency_limits_v2.py`; with `prefect_redis.lease_storage`, when the redis key is absent).\n5. When the context exits during the backoff, the thread returns quietly, and the result is one warning. When the context has not exited and the local state is not final after the 3rd attempt, `_handle_lease_renewal_failure` calls `cancel_scope.cancel()`, and the engine's `except BaseException` handler calls `handle_crash`.\n\nA short deployment run with a concurrency limit, finishing in under a second, reaches the terminal state on the server before the first renewal request arrives.\n\n**Observed (UTC, 2026-10-28/29; one server process, `prefect_redis.lease_storage`, deployments with `concurrency_limit=1` and `CANCEL_NEW` that run every minute):**\n\nThe harmless form. This lease was joined to its run through the flow-run states:\n\n```\n13:34:00.011927  flow run 01a187da-dd4d-7560-\u2026 RUNNING   (lease c620b987-\u2026)\n13:34:00.172190  flow run 01a187da-dd4d-7560-\u2026 COMPLETED\n13:34:00.245680  WARNING Attempt 1 of function 'concurrency lease renewal' failed with\n                 PrefectHTTPStatusError: Client error '410 Gone' for url\n                 '\u2026/v2/concurrency_limits/leases/c620b987-\u2026/renew'\n                 (no further attempt)\n```\n\nThe fatal form, on a worker whose event loop logged nothing from 20:38:04.43 to 20:38:16.40. The times come from the event ids (UUIDv7):\n\n```\n20:38:03.723  run A (concurrency-limited deployment) Completed\n20:38:04.179  run B (concurrency-limited deployment) Completed\n20:38:04.746  Attempt 1 \u2026 410 Gone (lease 9e2dde05-\u2026)\n20:38:06.258  Attempt 2 \u2026 410 Gone\n20:38:08.081  Function 'concurrency lease renewal' failed after 3 attempts\n20:38:08.116  Concurrency lease renewal failed - slots are no longer reserved.\n              Terminating execution to prevent over-allocation.\n20:38:16.397  Crash detected! Execution was cancelled by the runtime environment.\n20:38:17.904  run A Crashed\n```\n\nThe lease belongs to run A or to run B. Both had completed on the server before the first `410`. Their state history was past retention before the lease could be joined to a run. No other concurrency-limited run was active on that worker, and every candidate lease was less than 5 s old, so expiry by the repossessor does not explain it.\n\n**Possible directions:**\n\n- On a `410` from the renewal, read the flow run's state from the API before terminating, and do not terminate when the run is final on the server.\n- Or stop the renewal (set the stop event) before the engine proposes a terminal state.\n\n`concurrency/_leases.py` on `main` is byte-identical to 3.8.6, and the lease block in `flow_engine.py` is unchanged.\n\n### Version info\n\n```Text\nVersion:             3.8.6\nPython version:      3.14\nServer type:         server (self-hosted, one uvicorn process)\nIntegrations:        prefect-redis 0.2.15 (lease storage, messaging)\n```\n\n### Additional context\n\nThe flows run in-process in a custom async worker that awaits `run_flow_async` inside the worker's own event loop. That worker type comes from Infrahub (opsmill/infrahub), and it is why one renewal failure stopped every run of that worker.\n\n", "hints_text": "", "created_at": "2026-10-29T14:44:40Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23654, "instance_id": "PrefectHQ__prefect-23654", "issue_numbers": ["23653"], "base_commit": "8d31e4e63b9411cf4204d5a713e16b6d0ac22762", "patch": "diff --git a/src/integrations/prefect-redis/prefect_redis/locking.py b/src/integrations/prefect-redis/prefect_redis/locking.py\nindex d52a0301ac61..417b5c91f4d3 100644\n--- a/src/integrations/prefect-redis/prefect_redis/locking.py\n+++ b/src/integrations/prefect-redis/prefect_redis/locking.py\n@@ -220,6 +220,12 @@ def release_lock(self, key: str, holder: str) -> None:\n         lock = self._locks.get(lock_name)\n \n         if lock is not None and self.is_lock_holder(key, holder):\n+            if isinstance(lock, AsyncLock):\n+                # Release an async-acquired lock through a sync lock with the\n+                # same token since this method is called synchronously.\n+                token = lock.local.token\n+                lock = Lock(self.client, lock_name, thread_local=False)\n+                lock.local.token = token\n             lock.release()\n             del self._locks[lock_name]\n             return\n", "test_patch": "diff --git a/src/integrations/prefect-redis/tests/test_locking.py b/src/integrations/prefect-redis/tests/test_locking.py\nindex c2333007b03b..480bb045f5e1 100644\n--- a/src/integrations/prefect-redis/tests/test_locking.py\n+++ b/src/integrations/prefect-redis/tests/test_locking.py\n@@ -10,6 +10,7 @@\n from prefect_redis.locking import RedisLockManager\n \n from prefect.results import ResultStore\n+from prefect.transactions import AsyncTransaction, IsolationLevel\n \n \n class TestRedisLockManager:\n@@ -88,6 +89,29 @@ def test_acquire_lock(self, lock_manager):\n         lock_manager.release_lock(key, holder=\"holder1\")\n         assert not lock_manager.is_locked(key)\n \n+    async def test_release_lock_acquired_asynchronously(self, lock_manager):\n+        key = str(uuid4())\n+        assert await lock_manager.aacquire_lock(key, holder=\"holder1\")\n+        assert lock_manager.is_locked(key)\n+        lock_manager.release_lock(key, holder=\"holder1\")\n+        assert not lock_manager.is_locked(key)\n+        assert await lock_manager.aacquire_lock(\n+            key, holder=\"holder2\", acquire_timeout=0.1\n+        )\n+        lock_manager.release_lock(key, holder=\"holder2\")\n+\n+    async def test_async_serializable_transaction_releases_lock(self, lock_manager):\n+        key = str(uuid4())\n+        store = ResultStore(lock_manager=lock_manager)\n+\n+        async with AsyncTransaction(\n+            key=key, store=store, isolation_level=IsolationLevel.SERIALIZABLE\n+        ) as txn:\n+            assert lock_manager.is_locked(key)\n+            txn.stage(\"value\")\n+\n+        assert not lock_manager.is_locked(key)\n+\n     def test_acquire_lock_idempotent(self, lock_manager):\n         key = str(uuid4())\n         assert lock_manager.acquire_lock(key, holder=\"holder1\")\n", "problem_statement": "prefect-redis: async tasks with SERIALIZABLE isolation never release their RedisLockManager lock\n### Bug summary\n\nAn async task with `SERIALIZABLE` isolation and `RedisLockManager` leaves its lock in Redis after it finishes, with no TTL, so the next run of the same task waits on it indefinitely.\n\n```python\nimport asyncio\nfrom redis import Redis\nfrom prefect import flow, task\nfrom prefect.cache_policies import INPUTS\nfrom prefect.transactions import IsolationLevel\nfrom prefect_redis.locking import RedisLockManager\n\nr = Redis(port=6379, decode_responses=True)\npolicy = INPUTS.configure(\n    isolation_level=IsolationLevel.SERIALIZABLE,\n    lock_manager=RedisLockManager(host=\"localhost\", port=6379),\n)\n\n@task(cache_policy=policy, persist_result=True)\nasync def work(x: int) -> int:\n    return x + 1\n\n@flow\nasync def f():\n    print(await work(1))\n    print({k: r.ttl(k) for k in r.keys(\"lock:*\")})\n\nasyncio.run(f())\n```\n\nThe task returns 2, then the lock key is still there with TTL -1. Running the flow again blocks on `work(1)`; I stopped it after 30 seconds. Python also warns `coroutine 'Lock.release' was never awaited` from `prefect_redis/locking.py:223`.\n\nThe cause: `AsyncTransaction.begin()` takes the lock with `aacquire_lock` (transactions.py:464), which stores a `redis.asyncio` lock in `RedisLockManager._locks`. `commit()` and `rollback()` release it with the sync `store.release_lock` (503, 534, 609), and `release_lock` calls `lock.release()` on the async lock, which only creates a coroutine. The lock manager protocol has no async release, so the transaction has nothing else to call. The sync `Transaction` path releases fine.\n\nThe same thing at the lock manager level:\n\n```python\nmgr = RedisLockManager(host=\"localhost\", port=6379)\n\nasync def main():\n    print(await mgr.aacquire_lock(\"k1\", holder=\"h1\"))                       # True\n    mgr.release_lock(\"k1\", holder=\"h1\")\n    print(mgr.is_locked(\"k1\"))                                              # True\n    print(await mgr.aacquire_lock(\"k1\", holder=\"h2\", acquire_timeout=0.5))  # False\n\nasyncio.run(main())\n```\n\nA fix could be to release an async-held lock in `release_lock` through a sync `Lock` with the same name and token, or to add an `arelease_lock` to the protocol and have `AsyncTransaction` await it. Happy to send a PR for whichever you prefer.\n\n### Version info\n\nprefect 3.9.0, prefect-redis 0.3.0, redis-py 8.1.0, Redis server 8.10.3, Python 3.12.14, macOS. The same code is on main (8d31e4e).\n\n### Additional context\n\nI couldn't find an existing issue. #17676, #17785 and #18600 are about `No lock held by` errors, which is a different failure.\n\n", "hints_text": "", "created_at": "2026-10-29T01:20:13Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23652, "instance_id": "PrefectHQ__prefect-23652", "issue_numbers": ["23634"], "base_commit": "8d31e4e63b9411cf4204d5a713e16b6d0ac22762", "patch": "diff --git a/src/prefect/server/schemas/schedules.py b/src/prefect/server/schemas/schedules.py\nindex 94d8dddf8580..e1c9b4e47eee 100644\n--- a/src/prefect/server/schemas/schedules.py\n+++ b/src/prefect/server/schemas/schedules.py\n@@ -721,37 +721,35 @@ def _get_dates_generator(\n     def _get_dates_whenever(\n         self, n: int, start: datetime.datetime, end: Optional[datetime.datetime]\n     ) -> Generator[DateTime, None, None]:\n-        \"\"\"Generate cron dates with instant bounds and explicit fold selection.\"\"\"\n+        \"\"\"Generate cron dates with instant bounds and first-occurrence fold resolution.\"\"\"\n         start = datetime.datetime.combine(start, start.timetz())\n         start_naive = start.replace(tzinfo=None) - datetime.timedelta(seconds=1)\n         if start.microsecond > 0:\n             start_naive += datetime.timedelta(seconds=1)\n         start_instant = _whenever_zdt_from_py(start)\n+        transition = start_instant.add(seconds=1).prev_transition()\n+        gap = 0.0\n+        if transition is not None:\n+            gap = (transition.offset - transition.subtract(seconds=1).offset).total(\n+                \"seconds\"\n+            )\n+            if 0 <= (start_instant - transition).total(\"seconds\") < -gap:\n+                # Seek past repeated wall times without consuming the candidate budget.\n+                fold_end = _whenever_to_stdlib(transition).replace(\n+                    tzinfo=None\n+                ) - datetime.timedelta(seconds=gap)\n+                start_naive = fold_end - datetime.timedelta(seconds=1)\n \n         def localize(wall_time: datetime.datetime) -> datetime.datetime:\n-            first = _whenever_zdt_from_py(\n-                wall_time.replace(tzinfo=start.tzinfo, fold=0)\n+            # Resolve independently of start so scheduler refills cannot add repeats.\n+            return _whenever_to_stdlib(\n+                _whenever_zdt_from_py(wall_time.replace(tzinfo=start.tzinfo, fold=0))\n             )\n-            candidates = {first}\n-            if _whenever_to_stdlib(first).replace(tzinfo=None) == wall_time:\n-                candidates.add(\n-                    _whenever_zdt_from_py(\n-                        wall_time.replace(tzinfo=start.tzinfo, fold=1)\n-                    )\n-                )\n-            viable = [\n-                candidate for candidate in candidates if candidate >= start_instant\n-            ]\n-            return _whenever_to_stdlib(min(viable) if viable else min(candidates))\n \n         cron = croniter(self.cron, start_naive, day_or=self.day_or)  # type: ignore\n         wall_times = iter(lambda: cron.get_next(datetime.datetime), None)\n         candidate_dates: Iterator[datetime.datetime] = map(localize, wall_times)\n-        transition = start_instant.add(seconds=1).prev_transition()\n         if transition is not None:\n-            gap = (transition.offset - transition.subtract(seconds=1).offset).total(\n-                \"seconds\"\n-            )\n             if 0 <= (start_instant - transition).total(\"seconds\") < gap:\n                 lookback = croniter(\n                     self.cron,\n", "test_patch": "diff --git a/tests/server/schemas/test_schedules.py b/tests/server/schemas/test_schedules.py\nindex 1439de0ab37d..1ccdcb8fcbed 100644\n--- a/tests/server/schemas/test_schedules.py\n+++ b/tests/server/schemas/test_schedules.py\n@@ -1126,6 +1126,63 @@ async def test_berlin_fall_runs_only_at_first_occurrence(self):\n             \"2026-10-27T02:30:00+01:00\",\n         ]\n \n+    @pytest.mark.skipif(\n+        sys.version_info < (3, 13), reason=\"Legacy Pendulum resolution is unchanged\"\n+    )\n+    @pytest.mark.parametrize(\"minute\", [0, 1, 16, 31, 46])\n+    async def test_berlin_fall_query_partition_preserves_occurrences(self, minute: int):\n+        \"\"\"Splitting a query during the second hour cannot introduce occurrences.\"\"\"\n+        zone = ZoneInfo(\"Europe/Berlin\")\n+        schedule = CronSchedule(cron=\"*/15 * * * *\", timezone=zone.key)\n+        start = datetime(2026, 10, 25, tzinfo=zone)\n+        split = datetime(2026, 10, 25, 2, minute, tzinfo=zone, fold=1).astimezone(\n+            ZoneInfo(\"UTC\")\n+        )\n+        end = datetime(2026, 10, 25, 4, tzinfo=zone)\n+\n+        whole = await schedule.get_dates(start=start, end=end)\n+        before = await schedule.get_dates(start=start, end=split)\n+        after = await schedule.get_dates(start=split, end=end)\n+\n+        assert {date.timestamp() for date in whole} == {\n+            date.timestamp() for date in before + after\n+        }\n+        assert all(date.timestamp() >= split.timestamp() for date in after)\n+        assert not any(date.fold for date in whole + after)\n+\n+    @pytest.mark.skipif(\n+        sys.version_info < (3, 13), reason=\"Legacy Pendulum resolution is unchanged\"\n+    )\n+    @pytest.mark.parametrize(\n+        \"timezone, start, expected\",\n+        [\n+            (\n+                \"Europe/Berlin\",\n+                \"2026-10-25T02:00:00+01:00\",\n+                \"2026-10-25T03:00:00+01:00\",\n+            ),\n+            (\n+                \"Australia/Lord_Howe\",\n+                \"2026-04-05T01:30:00+10:30\",\n+                \"2026-04-05T02:00:00+10:30\",\n+            ),\n+        ],\n+    )\n+    async def test_second_fold_seek_preserves_candidate_budget(\n+        self, timezone: str, start: str, expected: str\n+    ):\n+        \"\"\"An every-second cron skips a fold without exhausting its candidate budget.\"\"\"\n+        schedule = CronSchedule(cron=\"* * * * * *\", timezone=timezone)\n+        dates = await schedule.get_dates(\n+            n=MAX_ITERATIONS, start=datetime.fromisoformat(start)\n+        )\n+        expected_start = datetime.fromisoformat(expected)\n+\n+        assert len(dates) == MAX_ITERATIONS\n+        assert [date.timestamp() for date in dates] == [\n+            expected_start.timestamp() + second for second in range(MAX_ITERATIONS)\n+        ]\n+\n     @pytest.mark.skipif(\n         sys.version_info < (3, 13), reason=\"Legacy Pendulum resolution is unchanged\"\n     )\n@@ -1136,31 +1193,31 @@ async def test_berlin_fall_runs_only_at_first_occurrence(self):\n                 \"0 * * * *\",\n                 \"America/New_York\",\n                 \"2018-11-04T01:00:00\",\n-                \"2018-11-04T06:00:00+00:00\",\n+                \"2018-11-04T07:00:00+00:00\",\n             ),\n             (\n                 \"* * * * *\",\n                 \"America/New_York\",\n                 \"2018-11-04T01:30:00\",\n-                \"2018-11-04T06:30:00+00:00\",\n+                \"2018-11-04T07:00:00+00:00\",\n             ),\n             (\n                 \"* * * * *\",\n                 \"America/New_York\",\n                 \"2018-11-04T01:30:00.500000\",\n-                \"2018-11-04T06:31:00+00:00\",\n+                \"2018-11-04T07:00:00+00:00\",\n             ),\n             (\n                 \"30 2 * * *\",\n                 \"Europe/Berlin\",\n                 \"2026-10-25T02:15:00\",\n-                \"2026-10-25T01:30:00+00:00\",\n+                \"2026-10-26T01:30:00+00:00\",\n             ),\n             (\n                 \"30 2 * * *\",\n                 \"Europe/Berlin\",\n                 \"2026-10-25T02:30:00\",\n-                \"2026-10-25T01:30:00+00:00\",\n+                \"2026-10-26T01:30:00+00:00\",\n             ),\n             (\n                 \"30 2 * * *\",\ndiff --git a/tests/server/services/test_scheduler.py b/tests/server/services/test_scheduler.py\nindex b1ce088e56c3..dc9ae93b7539 100644\n--- a/tests/server/services/test_scheduler.py\n+++ b/tests/server/services/test_scheduler.py\n@@ -1,4 +1,5 @@\n import datetime\n+from zoneinfo import ZoneInfo\n \n import pytest\n import sqlalchemy as sa\n@@ -27,6 +28,86 @@\n pytestmark = pytest.mark.clear_db\n \n \n+@pytest.mark.parametrize(\"schedule_type\", [\"cron\", \"interval\"])\n+async def test_berlin_fall_back_scheduler_refill(\n+    flow: schemas.core.Flow,\n+    session: AsyncSession,\n+    db: PrefectDBInterface,\n+    monkeypatch: pytest.MonkeyPatch,\n+    schedule_type: str,\n+):\n+    \"\"\"Refilling a persisted queue preserves cron's first-occurrence policy.\"\"\"\n+    zone = ZoneInfo(\"Europe/Berlin\")\n+    before = datetime.datetime(2026, 10, 25, 2, 31, tzinfo=zone)\n+    refill = datetime.datetime(2026, 10, 25, 2, 31, tzinfo=zone, fold=1).astimezone(\n+        datetime.timezone.utc\n+    )\n+    schedule = (\n+        schemas.schedules.CronSchedule(cron=\"*/15 * * * *\", timezone=zone.key)\n+        if schedule_type == \"cron\"\n+        else schemas.schedules.IntervalSchedule(\n+            interval=datetime.timedelta(minutes=15),\n+            anchor_date=before.replace(hour=0, minute=0),\n+            timezone=zone.key,\n+        )\n+    )\n+    deployment = await models.deployments.create_deployment(\n+        session=session,\n+        deployment=schemas.core.Deployment(\n+            name=\"berlin-fall-back\",\n+            flow_id=flow.id,\n+            schedules=[schemas.core.DeploymentSchedule(schedule=schedule)],\n+        ),\n+    )\n+    await session.commit()\n+\n+    with temporary_settings(\n+        {\n+            PREFECT_API_SERVICES_SCHEDULER_MIN_RUNS: 3,\n+            PREFECT_API_SERVICES_SCHEDULER_MAX_RUNS: 100,\n+            PREFECT_API_SERVICES_SCHEDULER_MIN_SCHEDULED_TIME: datetime.timedelta(\n+                hours=1\n+            ),\n+            PREFECT_API_SERVICES_SCHEDULER_MAX_SCHEDULED_TIME: datetime.timedelta(\n+                days=100\n+            ),\n+        }\n+    ):\n+        monkeypatch.setattr(\n+            \"prefect.server.services.scheduler.now\",\n+            lambda *_: before.astimezone(datetime.timezone.utc),\n+        )\n+        await schedule_deployments()\n+        initial_runs = await models.flow_runs.read_flow_runs(session)\n+        assert initial_runs\n+        initial_ids = {run.id for run in initial_runs}\n+\n+        monkeypatch.setattr(\"prefect.server.services.scheduler.now\", lambda *_: refill)\n+        query = _get_select_deployments_to_schedule_query(\n+            db, 100, 3, datetime.timedelta(hours=1)\n+        )\n+        assert deployment.id in (await session.execute(query)).scalars().all()\n+        await schedule_deployments()\n+\n+        runs = await models.flow_runs.read_flow_runs(session)\n+        dates = [run.expected_start_time.astimezone(zone) for run in runs]\n+        repeated = [date for date in dates if date.hour == 2 and date.fold == 1]\n+        assert len(repeated) == (0 if schedule_type == \"cron\" else 4)\n+        assert initial_ids <= {run.id for run in runs}\n+        assert len(runs) > len(initial_runs)\n+        assert all(\n+            run.expected_start_time.timestamp() >= refill.timestamp()\n+            for run in runs\n+            if run.id not in initial_ids\n+        )\n+        assert len({run.expected_start_time.timestamp() for run in runs}) == len(runs)\n+\n+        await schedule_deployments()\n+        assert {run.id for run in await models.flow_runs.read_flow_runs(session)} == {\n+            run.id for run in runs\n+        }\n+\n+\n @pytest.fixture\n async def deployment_without_schedules(flow: schemas.core.Flow, session: AsyncSession):\n     deployment = await models.deployments.create_deployment(\n", "problem_statement": "Preserve cron start bounds in repeated DST hours\nRelated to #23631.\n\nThis PR prevents Python 3.13+ cron queries inside a repeated DST hour from returning timestamps before `start`. It preserves the requested fold and microsecond cutoff, selects the earliest viable occurrence, and compares bounds on the UTC timeline.\n\nLayer 1 of the cron DST stack, based on `main`. Spring-gap recovery is #23636. Extracted from draft #23424; interval scheduling and Python 3.11\u20133.12 Pendulum behavior are outside this change.\n\n<details>\n<summary>Reproduction and validation</summary>\n\nFor `30 2 * * *` in `Europe/Berlin`, a start at `2026-10-25T02:15+01:00` previously returned `02:30+02:00`, before the requested instant. It now returns `02:30+01:00`. Queries made before the transition still select only the first occurrence.\n\nFive of the seven second-fold regression cases fail on main. Coverage includes New York hourly/minute schedules, Berlin daily schedules, microsecond cutoffs, bounded queries, and duplicate prevention.\n\nFull schedule suite:\n\n- Python 3.12: 136 passed, 30 skipped, 2 existing xfails.\n- Python 3.13 and 3.14: 166 passed, 2 existing xfails each.\n- Repository commit/push hooks pass, including generated OpenAPI verification.\n\nThe existing cron contract already promises dates on or after `start`; no public schema or configuration change is needed.\n</details>\n\n", "hints_text": "<!-- __CODSPEED_PERFORMANCE_REPORT_COMMENT__ -->\n## Merging this PR will **not alter performance**\n\n\n`\u2705 8` untouched benchmarks  \n`\u23e9 1` skipped benchmark[^skipped]  \n\n\n\n\n\n---\n\n<sub>Comparing <code>codex/cron-dst-folds</code> (916e426) with <code>main</code> (88c32fa)[^unexpected-base]</sub>\n\n<a href=\"https://app.codspeed.io/PrefectHQ/prefect/branches/codex%2Fcron-dst-folds?utm_source=github&utm_medium=comment-v2&utm_content=button\">\n  <picture>\n    <source media=\"(prefers-color-scheme: dark)\" srcset=\"https://codspeed.io/pr-report/open-in-codspeed-dark.svg\">\n    <source media=\"(prefers-color-scheme: light)\" srcset=\"https://codspeed.io/pr-report/open-in-codspeed-light.svg\">\n    <img alt=\"Open in CodSpeed\" src=\"https://codspeed.io/pr-report/open-in-codspeed-light.svg\" width=\"169\" height=\"32\">\n  </picture>\n</a>\n\n\n[^skipped]: 1 benchmark was skipped, so the baseline result was used instead. If it was deleted from the codebase, [click here and archive it to remove it from the performance reports](https://app.codspeed.io/PrefectHQ/prefect/branches/codex%2Fcron-dst-folds?q=is%3Askipped&utm_source=github&utm_medium=comment-v2&utm_content=archive).\n[^unexpected-base]: No successful run was found on <code>main</code> (71c4ef2) during the generation of this report, so 88c32fa was used instead as the comparison base. There might be some changes unrelated to this pull request in this report.\n\n<!-- codex-pull-request-review-summary -->\n<!-- codex-review-state:v1 {\"code_review\":{\"commit_sha\":\"916e42635f8726f5d68ec187ed6b89905ff3e24c\",\"has_any_findings\":false,\"has_unresolved_findings\":false,\"status\":\"completed\"},\"security_review\":{\"commit_sha\":null,\"has_any_findings\":null,\"has_unresolved_findings\":null,\"status\":null}} -->\n\n## Codex Review Summary\n\nThis comment shows the latest Codex review activity on this pull request.\n\n| Review | Status | Commit | Review trigger |\n| --- | --- | --- | --- |\n| \ud83d\udcdd **Code Review** | \u2705 **Completed** <relative-time datetime=\"2026-10-27T17:03:00.943216Z\">2026-10-27T17:03:00.943216Z</relative-time> | `916e426` | Draft marked ready |\n\n\n\n<details> <summary>\u2139\ufe0f About Codex in GitHub</summary>\n<br/>\n\n[Your team has set up Codex to review pull requests in this repo](https://chatgpt.com/codex/cloud/settings/general). Reviews are triggered when you\n- Open a pull request for review\n- Mark a draft as ready\n- Comment \"@codex review\" or \"@codex security review\".\n\nCodex reacts with \ud83d\udc40 while any review is running, comments if it has suggestions, and reacts with \ud83d\udc4d once all reviews finish with no findings.\n\n</details>", "created_at": "2026-10-28T21:47:29Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23649, "instance_id": "PrefectHQ__prefect-23649", "issue_numbers": ["23647"], "base_commit": "89b8b18cbdc74d6f0bf7e64e95e08e7ad7b514f2", "patch": "diff --git a/src/integrations/prefect-kubernetes/prefect_kubernetes/worker.py b/src/integrations/prefect-kubernetes/prefect_kubernetes/worker.py\nindex 69011d0d3d2a..b729a30602e7 100644\n--- a/src/integrations/prefect-kubernetes/prefect_kubernetes/worker.py\n+++ b/src/integrations/prefect-kubernetes/prefect_kubernetes/worker.py\n@@ -137,7 +137,14 @@\n     V1Secret,\n )\n from pydantic import Field, field_validator, model_validator\n-from tenacity import AsyncRetrying, stop_after_attempt, wait_fixed, wait_random\n+from tenacity import (\n+    AsyncRetrying,\n+    retry,\n+    retry_if_exception,\n+    stop_after_attempt,\n+    wait_fixed,\n+    wait_random,\n+)\n from typing_extensions import Literal, Self\n \n import prefect\n@@ -1310,6 +1317,14 @@ def _get_k8s_error_hint(\n \n         return None\n \n+    @retry(\n+        retry=retry_if_exception(\n+            lambda exc: isinstance(exc, ApiException) and exc.status == 409\n+        ),\n+        stop=stop_after_attempt(3),\n+        wait=wait_random(0, 1),\n+        reraise=True,\n+    )\n     async def _upsert_secret(\n         self, name: str, value: str, namespace: str, client: \"ApiClient\"\n     ):\n@@ -1321,6 +1336,8 @@ async def _upsert_secret(\n             current_secret = await core_client.read_namespaced_secret(\n                 name=name, namespace=namespace\n             )\n+            if current_secret.data == {\"value\": encoded_value}:\n+                return current_secret\n             current_secret.data = {\"value\": encoded_value}\n             secret = await core_client.replace_namespaced_secret(\n                 name=name, namespace=namespace, body=current_secret\n", "test_patch": "diff --git a/src/integrations/prefect-kubernetes/tests/test_worker.py b/src/integrations/prefect-kubernetes/tests/test_worker.py\nindex 2675e1a3e5ea..c8ca1d72d61b 100644\n--- a/src/integrations/prefect-kubernetes/tests/test_worker.py\n+++ b/src/integrations/prefect-kubernetes/tests/test_worker.py\n@@ -1979,6 +1979,196 @@ async def test_can_store_api_key_in_secret(\n             namespace=configuration.namespace,\n         )\n \n+    async def test_concurrent_flow_runs_share_api_key_secret(\n+        self,\n+        flow_run,\n+        mock_core_client,\n+        mock_batch_client,\n+        enable_store_api_key_in_secret,\n+    ):\n+        secrets = {}\n+        initial_reads = 0\n+        both_reads_finished = anyio.Event()\n+\n+        async def read_secret(name, namespace):\n+            nonlocal initial_reads\n+            if (name, namespace) in secrets:\n+                return secrets[name, namespace]\n+            initial_reads += 1\n+            if initial_reads == 2:\n+                both_reads_finished.set()\n+            await both_reads_finished.wait()\n+            raise ApiException(status=404)\n+\n+        async def create_secret(namespace, body):\n+            key = (body.metadata.name, namespace)\n+            if key in secrets:\n+                raise ApiException(status=409, reason=\"AlreadyExists\")\n+            secrets[key] = body\n+            return body\n+\n+        mock_core_client.return_value.read_namespaced_secret.side_effect = read_secret\n+        mock_core_client.return_value.create_namespaced_secret.side_effect = (\n+            create_secret\n+        )\n+        mock_core_client.return_value.replace_namespaced_secret.side_effect = (\n+            ApiException(status=403)\n+        )\n+\n+        with temporary_settings(updates={PREFECT_API_KEY: \"fake\"}):\n+            async with KubernetesWorker(work_pool_name=\"test\") as k8s_worker:\n+                async with anyio.create_task_group() as task_group:\n+                    for _ in range(2):\n+                        submitted_run = flow_run.model_copy(update={\"id\": uuid.uuid4()})\n+                        configuration = await KubernetesWorkerJobConfiguration.from_template_and_values(\n+                            KubernetesWorker.get_default_base_job_template(), {}\n+                        )\n+                        configuration.prepare_for_flow_run(submitted_run)\n+                        task_group.start_soon(\n+                            k8s_worker.run, submitted_run, configuration\n+                        )\n+\n+                secret_name = f\"prefect-{_slugify_name(k8s_worker.name)}-api-key\"\n+                assert secrets[secret_name, \"default\"].data == {\n+                    \"value\": base64.b64encode(b\"fake\").decode(\"utf-8\")\n+                }\n+                job_calls = (\n+                    mock_batch_client.return_value.create_namespaced_job.await_args_list\n+                )\n+                assert len(job_calls) == 2\n+                for job_call in job_calls:\n+                    env = job_call.args[1][\"spec\"][\"template\"][\"spec\"][\"containers\"][0][\n+                        \"env\"\n+                    ]\n+                    assert {\n+                        \"name\": \"PREFECT_API_KEY\",\n+                        \"valueFrom\": {\n+                            \"secretKeyRef\": {\"name\": secret_name, \"key\": \"value\"}\n+                        },\n+                    } in env\n+\n+    async def test_updates_api_key_after_secret_creation_conflict(\n+        self,\n+        flow_run,\n+        mock_core_client,\n+        mock_batch_client,\n+        enable_store_api_key_in_secret,\n+    ):\n+        configuration = await KubernetesWorkerJobConfiguration.from_template_and_values(\n+            KubernetesWorker.get_default_base_job_template(), {}\n+        )\n+        with temporary_settings(updates={PREFECT_API_KEY: \"fake\"}):\n+            async with KubernetesWorker(work_pool_name=\"test\") as k8s_worker:\n+                existing_secret = V1Secret(\n+                    metadata=V1ObjectMeta(\n+                        name=f\"prefect-{_slugify_name(k8s_worker.name)}-api-key\",\n+                        namespace=configuration.namespace,\n+                    ),\n+                    data={\"value\": base64.b64encode(b\"old\").decode(\"utf-8\")},\n+                )\n+                mock_core_client.return_value.read_namespaced_secret.side_effect = [\n+                    ApiException(status=404),\n+                    existing_secret,\n+                ]\n+                mock_core_client.return_value.create_namespaced_secret.side_effect = (\n+                    ApiException(status=409, reason=\"AlreadyExists\")\n+                )\n+                mock_core_client.return_value.replace_namespaced_secret.return_value = (\n+                    existing_secret\n+                )\n+\n+                configuration.prepare_for_flow_run(flow_run)\n+                await k8s_worker.run(flow_run, configuration)\n+\n+                assert existing_secret.data == {\n+                    \"value\": base64.b64encode(b\"fake\").decode(\"utf-8\")\n+                }\n+                mock_batch_client.return_value.create_namespaced_job.assert_awaited_once()\n+\n+    async def test_updates_api_key_after_secret_update_conflict(self, mock_core_client):\n+        secrets = [\n+            V1Secret(\n+                metadata=V1ObjectMeta(\n+                    name=\"worker-api-key\", namespace=\"default\", resource_version=version\n+                ),\n+                data={\"value\": base64.b64encode(b\"old\").decode(\"utf-8\")},\n+            )\n+            for version in (\"stale\", \"current\")\n+        ]\n+\n+        async def replace_secret(name, namespace, body):\n+            if body.metadata.resource_version != \"current\":\n+                raise ApiException(status=409, reason=\"Conflict\")\n+            return body\n+\n+        mock_core_client.return_value.read_namespaced_secret.side_effect = secrets\n+        mock_core_client.return_value.replace_namespaced_secret.side_effect = (\n+            replace_secret\n+        )\n+        worker = KubernetesWorker(work_pool_name=\"test\")\n+\n+        secret = await worker._upsert_secret(\n+            name=\"worker-api-key\", value=\"fake\", namespace=\"default\", client=MagicMock()\n+        )\n+\n+        assert secret.metadata.resource_version == \"current\"\n+        assert secret.data == {\"value\": base64.b64encode(b\"fake\").decode(\"utf-8\")}\n+\n+    @pytest.mark.parametrize(\"operation\", [\"create\", \"replace\"])\n+    async def test_secret_conflict_retries_are_bounded(\n+        self, mock_core_client, operation\n+    ):\n+        core_client = mock_core_client.return_value\n+        if operation == \"create\":\n+            core_client.read_namespaced_secret.side_effect = ApiException(status=404)\n+        else:\n+            core_client.read_namespaced_secret.side_effect = [\n+                V1Secret(data={\"value\": \"old\"}) for _ in range(3)\n+            ]\n+        error = ApiException(status=409, reason=\"Conflict\")\n+        operation_mock = getattr(core_client, f\"{operation}_namespaced_secret\")\n+        operation_mock.side_effect = error\n+        worker = KubernetesWorker(work_pool_name=\"test\")\n+\n+        with pytest.raises(ApiException) as exc_info:\n+            await worker._upsert_secret(\n+                name=\"worker-api-key\",\n+                value=\"fake\",\n+                namespace=\"default\",\n+                client=MagicMock(),\n+            )\n+\n+        assert exc_info.value is error\n+        assert operation_mock.await_count == 3\n+\n+    @pytest.mark.parametrize(\"operation\", [\"read\", \"create\", \"replace\"])\n+    @pytest.mark.parametrize(\"status\", [403, 500])\n+    async def test_secret_api_errors_propagate(\n+        self, mock_core_client, operation, status\n+    ):\n+        core_client = mock_core_client.return_value\n+        if operation == \"create\":\n+            core_client.read_namespaced_secret.side_effect = ApiException(status=404)\n+        else:\n+            core_client.read_namespaced_secret.return_value = V1Secret(\n+                data={\"value\": \"old\"}\n+            )\n+        error = ApiException(status=status)\n+        operation_mock = getattr(core_client, f\"{operation}_namespaced_secret\")\n+        operation_mock.side_effect = error\n+        worker = KubernetesWorker(work_pool_name=\"test\")\n+\n+        with pytest.raises(ApiException) as exc_info:\n+            await worker._upsert_secret(\n+                name=\"worker-api-key\",\n+                value=\"fake\",\n+                namespace=\"default\",\n+                client=MagicMock(),\n+            )\n+\n+        assert exc_info.value is error\n+        operation_mock.assert_awaited_once()\n+\n     async def test_store_api_key_in_existing_secret(\n         self,\n         flow_run,\n@@ -2004,7 +2194,7 @@ async def test_store_api_key_in_existing_secret(\n                             namespace=configuration.namespace,\n                         ),\n                         data={\n-                            \"value\": base64.b64encode(\"fake\".encode(\"utf-8\")).decode(\n+                            \"value\": base64.b64encode(\"old\".encode(\"utf-8\")).decode(\n                                 \"utf-8\"\n                             )\n                         },\n", "problem_statement": "Kubernetes worker API-key Secret creation fails during concurrent submissions\n### Bug summary\n\nConcurrent Kubernetes worker submissions can fail before their Jobs are created when automatic API-key Secret creation is enabled. Submissions from the same worker use the same Secret name in a target namespace. If both reads return 404, one create succeeds and the other returns 409 AlreadyExists. `_upsert_secret` propagates that create error instead of reading the Secret that now exists.\n\nI reproduced the failure locally against the current main branch with this deterministic API-response sequence. This example uses mocked Kubernetes responses; it does not require a cluster or real credentials.\n\n```python\nimport asyncio\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nfrom kubernetes_asyncio.client.exceptions import ApiException\nfrom kubernetes_asyncio.client.models import V1ObjectMeta, V1Secret\nfrom prefect_kubernetes.worker import KubernetesWorker\n\n\nasync def reproduce():\n    api = AsyncMock()\n    api.read_namespaced_secret.side_effect = [\n        ApiException(status=404),\n        V1Secret(metadata=V1ObjectMeta(name=\"worker-api-key\", namespace=\"default\")),\n    ]\n    api.create_namespaced_secret.side_effect = ApiException(\n        status=409, reason=\"AlreadyExists\"\n    )\n    with patch(\"prefect_kubernetes.worker.CoreV1Api\", return_value=api):\n        worker = KubernetesWorker(work_pool_name=\"test\")\n        await worker._upsert_secret(\n            \"worker-api-key\", \"example-api-key\", \"default\", MagicMock()\n        )\n\n\nasyncio.run(reproduce())\n```\n\nActual result: `kubernetes_asyncio.client.exceptions.ApiException: (409) Reason: AlreadyExists` escapes `_upsert_secret`.\n\nExpected result: re-read the Secret, ensure it contains the expected API key, and allow both submissions to proceed. Permission failures and other unrelated errors should still propagate.\n\n### Version info\n\n- `prefect-kubernetes` source: PrefectHQ/prefect main at `89b8b18cbdc74d6f0bf7e64e95e08e7ad7b514f2`\n- Prefect: 3.9.0\n- Python: 3.12.9\n- OS/architecture: macOS/arm64\n\n### Proposed fix\n\nI plan to submit a focused fix that retries Secret conflicts a bounded number of times, reads the current object before each update, and returns an existing Secret without an update when its data already matches. Tests will cover concurrent submissions, API-key updates, exhausted conflicts, and unrelated API errors. No Secret naming, settings, or public APIs need to change.\n\n\n", "hints_text": "", "created_at": "2026-10-28T15:47:56Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23644, "instance_id": "PrefectHQ__prefect-23644", "issue_numbers": ["23643"], "base_commit": "bdc282844dd7ad54b0734dcc48d0a597881591c0", "patch": "diff --git a/src/prefect/server/api/deployments.py b/src/prefect/server/api/deployments.py\nindex dda00f36ee65..0b653f8860c0 100644\n--- a/src/prefect/server/api/deployments.py\n+++ b/src/prefect/server/api/deployments.py\n@@ -20,7 +20,7 @@\n     validate_job_variables_for_deployment,\n     validate_job_variables_for_deployment_flow_run,\n )\n-from prefect.server.api.workers import WorkerLookups\n+from prefect.server.api.workers import WorkerLookups, schedule_readiness_update\n from prefect.server.database import PrefectDBInterface, provide_database_interface\n from prefect.server.exceptions import MissingVariableError, ObjectNotFoundError\n from prefect.server.models.deployments import mark_deployments_ready\n@@ -656,10 +656,16 @@ async def get_scheduled_flow_runs_for_deployments(\n             for orm_flow_run in orm_flow_runs\n         ]\n \n+        becoming_ready = await models.deployments.has_not_ready_deployments(\n+            session=session, deployment_ids=deployment_ids\n+        )\n+\n     sorted_deployment_ids = \",\".join(str(d) for d in sorted(deployment_ids))\n-    await docket.add(\n+    await schedule_readiness_update(\n+        docket,\n         mark_deployments_ready,\n         key=f\"mark_deployments_ready:deployments:{sorted_deployment_ids}\",\n+        becoming_ready=becoming_ready,\n     )(\n         deployment_ids=deployment_ids,\n     )\ndiff --git a/src/prefect/server/api/work_queues.py b/src/prefect/server/api/work_queues.py\nindex 03bba4d74bdc..4c0376c62cba 100644\n--- a/src/prefect/server/api/work_queues.py\n+++ b/src/prefect/server/api/work_queues.py\n@@ -18,6 +18,7 @@\n import prefect.server.api.dependencies as dependencies\n import prefect.server.models as models\n import prefect.server.schemas as schemas\n+from prefect.server.api.workers import schedule_readiness_update\n from prefect.server.database import (\n     PrefectDBInterface,\n     provide_database_interface,\n@@ -189,19 +190,32 @@ async def read_work_queue_runs(\n     if x_prefect_ui:\n         return flow_runs\n \n-    await docket.add(\n+    work_queue_becoming_ready = work_queue.status == WorkQueueStatus.NOT_READY\n+    if work_queue_becoming_ready:\n+        deployments_becoming_ready = True\n+    else:\n+        async with db.session_context() as session:\n+            deployments_becoming_ready = (\n+                await models.deployments.has_not_ready_deployments(\n+                    session=session, work_queue_ids=[work_queue_id]\n+                )\n+            )\n+\n+    await schedule_readiness_update(\n+        docket,\n         mark_work_queues_ready,\n         key=f\"mark_work_queues_ready:{work_queue_id}\",\n+        becoming_ready=work_queue_becoming_ready,\n     )(\n         polled_work_queue_ids=[work_queue_id],\n-        ready_work_queue_ids=(\n-            [work_queue_id] if work_queue.status == WorkQueueStatus.NOT_READY else []\n-        ),\n+        ready_work_queue_ids=[work_queue_id] if work_queue_becoming_ready else [],\n     )\n \n-    await docket.add(\n+    await schedule_readiness_update(\n+        docket,\n         mark_deployments_ready,\n         key=f\"mark_deployments_ready:work_queue:{work_queue_id}\",\n+        becoming_ready=deployments_becoming_ready,\n     )(\n         work_queue_ids=[work_queue_id],\n     )\ndiff --git a/src/prefect/server/api/workers.py b/src/prefect/server/api/workers.py\nindex a8e6468bf3c5..c1b60fe2d193 100644\n--- a/src/prefect/server/api/workers.py\n+++ b/src/prefect/server/api/workers.py\n@@ -4,10 +4,11 @@\n \n from dataclasses import dataclass\n from logging import Logger\n-from typing import TYPE_CHECKING, Any, List, Optional\n+from typing import TYPE_CHECKING, Any, Awaitable, Callable, List, Optional, ParamSpec\n from uuid import UUID\n \n import sqlalchemy as sa\n+from docket import Docket, Execution\n from fastapi import (\n     Body,\n     Depends,\n@@ -67,6 +68,30 @@\n )\n logger: Logger = get_logger(\"prefect.server.api.workers\")\n \n+P = ParamSpec(\"P\")\n+\n+\n+def schedule_readiness_update(\n+    docket: Docket,\n+    function: Callable[P, Awaitable[None]],\n+    key: str,\n+    *,\n+    becoming_ready: bool,\n+) -> Callable[P, Awaitable[Execution]]:\n+    \"\"\"\n+    Schedule a keyed readiness update from a poll.\n+\n+    Polls are deduplicated by `key` so repeated polls don't pile up tasks. When\n+    the poll would move something to READY, any pending task is replaced\n+    instead: a previous attempt can be left pending with its key still known\n+    (for example, when a worker's claim fails during a Redis disruption) and\n+    would otherwise block every later poll until docket's `redelivery_timeout`.\n+    \"\"\"\n+    if becoming_ready:\n+        return docket.replace(function, now(\"UTC\"), key)\n+    return docket.add(function, key=key)\n+\n+\n _OSS_WORKER_CHANNEL_REQUIRED_CAPABILITIES: list[WorkerChannelCapability] = [\n     WORKER_HEARTBEAT_CAPABILITY,\n     WORK_POOL_SNAPSHOT_CAPABILITY,\n@@ -851,6 +876,17 @@ async def get_scheduled_flow_runs(\n             ]\n             work_queue_ids = [wq.id for wq in work_queues]\n \n+        ready_work_queue_ids = [\n+            wq.id for wq in work_queues if wq.status == WorkQueueStatus.NOT_READY\n+        ]\n+        deployments_becoming_ready = bool(ready_work_queue_ids)\n+        if not deployments_becoming_ready:\n+            deployments_becoming_ready = (\n+                await models.deployments.has_not_ready_deployments(\n+                    session=session, work_queue_ids=[wq.id for wq in work_queues]\n+                )\n+            )\n+\n     async with db.session_context(begin_transaction=True) as session:\n         queue_response = await models.workers.get_scheduled_flow_runs(\n             session=session,\n@@ -861,21 +897,29 @@ async def get_scheduled_flow_runs(\n             limit=limit,\n         )\n \n-    await docket.add(\n+    # Filtered polls only carry their own queues, so scope their keys to those\n+    # queues; otherwise a poll for one subset could replace another's update.\n+    key_scope = f\"work_pool:{work_pool_id}\"\n+    if work_queue_ids is not None:\n+        key_scope += \":\" + \",\".join(sorted(str(id) for id in set(work_queue_ids)))\n+\n+    await schedule_readiness_update(\n+        docket,\n         mark_work_queues_ready,\n-        key=f\"mark_work_queues_ready:work_pool:{work_pool_id}\",\n+        key=f\"mark_work_queues_ready:{key_scope}\",\n+        becoming_ready=bool(ready_work_queue_ids),\n     )(\n         polled_work_queue_ids=[\n             wq.id for wq in work_queues if wq.status != WorkQueueStatus.NOT_READY\n         ],\n-        ready_work_queue_ids=[\n-            wq.id for wq in work_queues if wq.status == WorkQueueStatus.NOT_READY\n-        ],\n+        ready_work_queue_ids=ready_work_queue_ids,\n     )\n \n-    await docket.add(\n+    await schedule_readiness_update(\n+        docket,\n         mark_deployments_ready,\n-        key=f\"mark_deployments_ready:work_pool:{work_pool_id}\",\n+        key=f\"mark_deployments_ready:{key_scope}\",\n+        becoming_ready=deployments_becoming_ready,\n     )(\n         work_queue_ids=[wq.id for wq in work_queues],\n     )\ndiff --git a/src/prefect/server/models/deployments.py b/src/prefect/server/models/deployments.py\nindex e86dce9c587c..a89451374a65 100644\n--- a/src/prefect/server/models/deployments.py\n+++ b/src/prefect/server/models/deployments.py\n@@ -1359,6 +1359,37 @@ async def mark_deployments_ready(\n                 )\n \n \n+@db_injector\n+async def has_not_ready_deployments(\n+    db: PrefectDBInterface,\n+    session: AsyncSession,\n+    deployment_ids: Optional[Iterable[UUID]] = None,\n+    work_queue_ids: Optional[Iterable[UUID]] = None,\n+) -> bool:\n+    \"\"\"\n+    Whether any of the given deployments, or any deployment in the given work\n+    queues, is NOT_READY.\n+    \"\"\"\n+    deployment_ids = list(deployment_ids or [])\n+    work_queue_ids = list(work_queue_ids or [])\n+\n+    if not deployment_ids and not work_queue_ids:\n+        return False\n+\n+    not_ready_deployment_id = await session.scalar(\n+        select(db.Deployment.id)\n+        .where(\n+            or_(\n+                db.Deployment.id.in_(deployment_ids),\n+                db.Deployment.work_queue_id.in_(work_queue_ids),\n+            ),\n+            db.Deployment.status == DeploymentStatus.NOT_READY,\n+        )\n+        .limit(1)\n+    )\n+    return not_ready_deployment_id is not None\n+\n+\n @db_injector\n async def mark_deployments_not_ready(\n     db: PrefectDBInterface,\ndiff --git a/src/prefect/server/models/work_queues.py b/src/prefect/server/models/work_queues.py\nindex d18d554c2252..1e5a42721c9a 100644\n--- a/src/prefect/server/models/work_queues.py\n+++ b/src/prefect/server/models/work_queues.py\n@@ -699,24 +699,48 @@ async def record_work_queue_polls(\n     session: AsyncSession,\n     polled_work_queue_ids: Sequence[UUID],\n     ready_work_queue_ids: Sequence[UUID],\n-) -> None:\n+) -> list[UUID]:\n     \"\"\"Record that the given work queues were polled, and also update the given\n-    ready_work_queue_ids to READY.\"\"\"\n+    ready_work_queue_ids to READY.\n+\n+    Returns the IDs of the work queues that this call transitioned to READY.\n+    \"\"\"\n     polled = now(\"UTC\")\n \n-    if polled_work_queue_ids:\n+    if polled_work_queue_ids or ready_work_queue_ids:\n         await session.execute(\n             sa.update(db.WorkQueue)\n-            .where(db.WorkQueue.id.in_(polled_work_queue_ids))\n+            .where(db.WorkQueue.id.in_([*polled_work_queue_ids, *ready_work_queue_ids]))\n             .values(last_polled=polled)\n         )\n \n-    if ready_work_queue_ids:\n+    if not ready_work_queue_ids:\n+        return []\n+\n+    # The `last_polled` update above already holds the row locks, so concurrent\n+    # calls see each other's status changes here. (No `RETURNING`: it needs\n+    # SQLite 3.35+.)\n+    newly_ready_work_queue_ids = list(\n+        (\n+            await session.execute(\n+                sa.select(db.WorkQueue.id)\n+                .where(\n+                    db.WorkQueue.id.in_(ready_work_queue_ids),\n+                    db.WorkQueue.status != WorkQueueStatus.READY,\n+                )\n+                .with_for_update()\n+            )\n+        )\n+        .scalars()\n+        .all()\n+    )\n+    if newly_ready_work_queue_ids:\n         await session.execute(\n             sa.update(db.WorkQueue)\n-            .where(db.WorkQueue.id.in_(ready_work_queue_ids))\n-            .values(last_polled=polled, status=WorkQueueStatus.READY)\n+            .where(db.WorkQueue.id.in_(newly_ready_work_queue_ids))\n+            .values(status=WorkQueueStatus.READY)\n         )\n+    return newly_ready_work_queue_ids\n \n \n async def mark_work_queues_ready(\n@@ -727,7 +751,7 @@ async def mark_work_queues_ready(\n     retry: Retry = Retry(attempts=5, delay=datetime.timedelta(seconds=0.5)),\n ) -> None:\n     async with db.session_context(begin_transaction=True) as session:\n-        await record_work_queue_polls(\n+        newly_ready_work_queue_ids = await record_work_queue_polls(\n             session=session,\n             polled_work_queue_ids=polled_work_queue_ids,\n             ready_work_queue_ids=ready_work_queue_ids,\n@@ -736,12 +760,14 @@ async def mark_work_queues_ready(\n     # Emit events for any work queues that have transitioned to ready during this poll\n     # Uses a separate transaction to avoid keeping locks open longer from the updates\n     # in the previous transaction\n-    if not ready_work_queue_ids:\n+    if not newly_ready_work_queue_ids:\n         return\n \n     async with db.session_context(begin_transaction=True) as session:\n         newly_ready_work_queues = await session.execute(\n-            sa.select(db.WorkQueue).where(db.WorkQueue.id.in_(ready_work_queue_ids))\n+            sa.select(db.WorkQueue).where(\n+                db.WorkQueue.id.in_(newly_ready_work_queue_ids)\n+            )\n         )\n \n         events = [\n", "test_patch": "diff --git a/tests/server/api/test_docket_task_keys.py b/tests/server/api/test_docket_task_keys.py\nindex 320fca2af357..c6443caf35ef 100644\n--- a/tests/server/api/test_docket_task_keys.py\n+++ b/tests/server/api/test_docket_task_keys.py\n@@ -15,13 +15,16 @@\n \n import httpx\n import pytest\n-from docket import Docket\n+from docket import Docket, Worker\n from fastapi import FastAPI\n from httpx import ASGITransport, AsyncClient\n from sqlalchemy.ext.asyncio import AsyncSession\n \n from prefect._internal.compatibility.starlette import status\n from prefect.server import models, schemas\n+from prefect.server.database.orm_models import ORMDeployment, ORMWorkPool, ORMWorkQueue\n+from prefect.server.models.deployments import mark_deployments_ready\n+from prefect.server.models.work_queues import mark_work_queues_ready\n from prefect.server.schemas.statuses import DeploymentStatus\n from prefect.server.services.cancellation_cleanup import cancelling_timeout_check_key\n from prefect.settings import (\n@@ -459,3 +462,210 @@ async def test_task_run_delete_queues_single_task(\n         task_keys = {task.key for task in final_snapshot.future}\n         task_keys.update(task.key for task in final_snapshot.running)\n         assert expected_key in task_keys\n+\n+\n+class TestReadinessRecoversFromStuckTask:\n+    \"\"\"\n+    A keyed readiness task can be left pending with its key still known, e.g. when\n+    a worker's claim fails during a Redis disruption. A poll that would mark\n+    something READY must not be deduplicated against that stuck task.\n+\n+    See: https://github.com/PrefectHQ/prefect/issues/23643\n+    \"\"\"\n+\n+    @pytest.fixture\n+    async def work_pool(self, session: AsyncSession) -> ORMWorkPool:\n+        work_pool = await models.workers.create_work_pool(\n+            session=session,\n+            work_pool=schemas.actions.WorkPoolCreate(\n+                name=f\"test-pool-{uuid4().hex[:8]}\",\n+                type=\"test\",\n+            ),\n+        )\n+        await session.commit()\n+        return work_pool\n+\n+    @pytest.fixture\n+    async def work_queue(self, session: AsyncSession) -> ORMWorkQueue:\n+        work_queue = await models.work_queues.create_work_queue(\n+            session=session,\n+            work_queue=schemas.actions.WorkQueueCreate(\n+                name=f\"test-wq-{uuid4().hex[:8]}\"\n+            ),\n+        )\n+        await session.commit()\n+        return work_queue\n+\n+    @pytest.fixture\n+    async def not_ready_deployment(self, session: AsyncSession) -> ORMDeployment:\n+        flow = await models.flows.create_flow(\n+            session=session,\n+            flow=schemas.core.Flow(name=f\"test-flow-{uuid4().hex[:8]}\"),\n+        )\n+        deployment = await models.deployments.create_deployment(\n+            session=session,\n+            deployment=schemas.core.Deployment(\n+                name=f\"test-deployment-{uuid4().hex[:8]}\",\n+                flow_id=flow.id,\n+                status=DeploymentStatus.NOT_READY,\n+            ),\n+        )\n+        await session.commit()\n+        return deployment\n+\n+    @pytest.fixture\n+    async def not_ready_deployment_in_ready_queue(\n+        self, session: AsyncSession, work_queue: ORMWorkQueue\n+    ) -> ORMDeployment:\n+        flow = await models.flows.create_flow(\n+            session=session,\n+            flow=schemas.core.Flow(name=f\"test-flow-{uuid4().hex[:8]}\"),\n+        )\n+        deployment = await models.deployments.create_deployment(\n+            session=session,\n+            deployment=schemas.core.Deployment(\n+                name=f\"test-deployment-{uuid4().hex[:8]}\",\n+                flow_id=flow.id,\n+                work_queue_id=work_queue.id,\n+                status=DeploymentStatus.NOT_READY,\n+            ),\n+        )\n+        await models.work_queues.record_work_queue_polls(\n+            session=session,\n+            polled_work_queue_ids=[],\n+            ready_work_queue_ids=[work_queue.id],\n+        )\n+        await session.commit()\n+        return deployment\n+\n+    async def _run_tasks(self, docket: Docket) -> None:\n+        async with Worker(docket) as worker:\n+            await worker.run_until_finished()\n+\n+    async def test_work_pool_poll_marks_not_ready_queue_ready(\n+        self,\n+        work_pool: ORMWorkPool,\n+        real_docket: Docket,\n+        client_with_real_docket: AsyncClient,\n+    ):\n+        queue_id = work_pool.default_queue_id\n+        await models.work_queues.mark_work_queues_not_ready(work_queue_ids=[queue_id])\n+        await real_docket.add(\n+            mark_work_queues_ready,\n+            key=f\"mark_work_queues_ready:work_pool:{work_pool.id}\",\n+        )(polled_work_queue_ids=[], ready_work_queue_ids=[])\n+\n+        response = await client_with_real_docket.post(\n+            f\"/work_pools/{work_pool.name}/get_scheduled_flow_runs\", json={}\n+        )\n+        assert response.status_code == status.HTTP_200_OK\n+\n+        await self._run_tasks(real_docket)\n+\n+        response = await client_with_real_docket.get(f\"/work_queues/{queue_id}\")\n+        assert response.json()[\"status\"] == \"READY\"\n+\n+    async def test_filtered_work_pool_polls_do_not_replace_each_other(\n+        self,\n+        session: AsyncSession,\n+        work_pool: ORMWorkPool,\n+        real_docket: Docket,\n+        client_with_real_docket: AsyncClient,\n+    ):\n+        other_queue = await models.workers.create_work_queue(\n+            session=session,\n+            work_pool_id=work_pool.id,\n+            work_queue=schemas.actions.WorkQueueCreate(\n+                name=f\"test-wq-{uuid4().hex[:8]}\"\n+            ),\n+        )\n+        await session.commit()\n+        queue_ids = [work_pool.default_queue_id, other_queue.id]\n+        await models.work_queues.mark_work_queues_not_ready(work_queue_ids=queue_ids)\n+\n+        for name in [\"default\", other_queue.name]:\n+            response = await client_with_real_docket.post(\n+                f\"/work_pools/{work_pool.name}/get_scheduled_flow_runs\",\n+                json={\"work_queue_names\": [name]},\n+            )\n+            assert response.status_code == status.HTTP_200_OK\n+\n+        await self._run_tasks(real_docket)\n+\n+        for queue_id in queue_ids:\n+            response = await client_with_real_docket.get(f\"/work_queues/{queue_id}\")\n+            assert response.json()[\"status\"] == \"READY\"\n+\n+    async def test_work_queue_poll_marks_not_ready_queue_ready(\n+        self,\n+        work_queue: ORMWorkQueue,\n+        real_docket: Docket,\n+        client_with_real_docket: AsyncClient,\n+    ):\n+        await models.work_queues.mark_work_queues_not_ready(\n+            work_queue_ids=[work_queue.id]\n+        )\n+        await real_docket.add(\n+            mark_work_queues_ready,\n+            key=f\"mark_work_queues_ready:{work_queue.id}\",\n+        )(polled_work_queue_ids=[], ready_work_queue_ids=[])\n+\n+        response = await client_with_real_docket.post(\n+            f\"/work_queues/{work_queue.id}/get_runs\"\n+        )\n+        assert response.status_code == status.HTTP_200_OK\n+\n+        await self._run_tasks(real_docket)\n+\n+        response = await client_with_real_docket.get(f\"/work_queues/{work_queue.id}\")\n+        assert response.json()[\"status\"] == \"READY\"\n+\n+    async def test_deployment_poll_marks_not_ready_deployment_ready(\n+        self,\n+        not_ready_deployment: ORMDeployment,\n+        real_docket: Docket,\n+        client_with_real_docket: AsyncClient,\n+    ):\n+        await real_docket.add(\n+            mark_deployments_ready,\n+            key=f\"mark_deployments_ready:deployments:{not_ready_deployment.id}\",\n+        )(deployment_ids=[])\n+\n+        response = await client_with_real_docket.post(\n+            \"/deployments/get_scheduled_flow_runs\",\n+            json={\"deployment_ids\": [str(not_ready_deployment.id)]},\n+        )\n+        assert response.status_code == status.HTTP_200_OK\n+\n+        await self._run_tasks(real_docket)\n+\n+        response = await client_with_real_docket.get(\n+            f\"/deployments/{not_ready_deployment.id}\"\n+        )\n+        assert response.json()[\"status\"] == \"READY\"\n+\n+    async def test_work_queue_poll_marks_not_ready_deployment_in_ready_queue_ready(\n+        self,\n+        work_queue: ORMWorkQueue,\n+        not_ready_deployment_in_ready_queue: ORMDeployment,\n+        real_docket: Docket,\n+        client_with_real_docket: AsyncClient,\n+    ):\n+        response = await client_with_real_docket.get(f\"/work_queues/{work_queue.id}\")\n+        assert response.json()[\"status\"] == \"READY\"\n+        await real_docket.add(\n+            mark_deployments_ready,\n+            key=f\"mark_deployments_ready:work_queue:{work_queue.id}\",\n+        )(work_queue_ids=[])\n+\n+        response = await client_with_real_docket.post(\n+            f\"/work_queues/{work_queue.id}/get_runs\"\n+        )\n+        assert response.status_code == status.HTTP_200_OK\n+\n+        await self._run_tasks(real_docket)\n+\n+        response = await client_with_real_docket.get(\n+            f\"/deployments/{not_ready_deployment_in_ready_queue.id}\"\n+        )\n+        assert response.json()[\"status\"] == \"READY\"\ndiff --git a/tests/server/models/test_work_queues.py b/tests/server/models/test_work_queues.py\nindex 251fa205d412..aaeac97774d6 100644\n--- a/tests/server/models/test_work_queues.py\n+++ b/tests/server/models/test_work_queues.py\n@@ -5,6 +5,9 @@\n from sqlalchemy.exc import IntegrityError\n \n from prefect.server import models, schemas\n+from prefect.server.database import provide_database_interface\n+from prefect.server.database.orm_models import ORMWorkQueue\n+from prefect.server.events.clients import AssertingEventsClient\n from prefect.server.exceptions import ObjectNotFoundError\n from prefect.server.models.workers import DEFAULT_AGENT_WORK_POOL_NAME\n from prefect.types._datetime import now\n@@ -506,3 +509,33 @@ async def test_legacy_queue_excludes_cancelling(self, session, flow, deployment)\n             session=session, work_queue_id=wq.id\n         )\n         assert result == 0\n+\n+\n+class TestMarkWorkQueuesReady:\n+    async def test_emits_ready_event_once_for_repeated_calls(\n+        self, work_queue: ORMWorkQueue, monkeypatch: pytest.MonkeyPatch\n+    ):\n+        monkeypatch.setattr(\n+            \"prefect.server.models.work_queues.PrefectServerEventsClient\",\n+            AssertingEventsClient,\n+        )\n+        await models.work_queues.mark_work_queues_not_ready(\n+            work_queue_ids=[work_queue.id]\n+        )\n+        AssertingEventsClient.reset()\n+\n+        for _ in range(2):\n+            await models.work_queues.mark_work_queues_ready(\n+                db=provide_database_interface(),\n+                polled_work_queue_ids=[],\n+                ready_work_queue_ids=[work_queue.id],\n+            )\n+\n+        ready_events = [\n+            event\n+            for client in AssertingEventsClient.all\n+            for event in client.events\n+            if event.event == \"prefect.work-queue.ready\"\n+            and event.resource.id == f\"prefect.work-queue.{work_queue.id}\"\n+        ]\n+        assert len(ready_events) == 1\n", "problem_statement": "Work queues stay Not Ready for ~5 minutes after Redis recovers, even though workers are polling\n### Bug summary\n\nOn a self-hosted server using Redis-backed docket (`PREFECT_SERVER_DOCKET_URL=redis://...`), a Redis restart can leave work queues **Not Ready** for about 5 minutes after Redis is back, even though the worker is online and polling normally. Restarting the API server clears it immediately, so it looks like a restart is required.\n\nExpected: the first worker poll after Redis recovers marks the queue Ready again.\n\n#### What happens\n\n1. While Redis is down, the foreman doesn't run and `last_polled` stops updating. Both are expected.\n2. Redis comes back. The foreman runs again and marks the queue `NOT_READY` because `last_polled` is stale. Also expected.\n3. The worker keeps polling. Each poll of `POST /work_pools/{name}/get_scheduled_flow_runs` schedules `mark_work_queues_ready` on docket with `key=f\"mark_work_queues_ready:work_pool:{id}\"`.\n4. The API process's background docket worker picks up the first of these tasks. Its `execution.claim()` fails with `redis.exceptions.ConnectionError: Connection closed by server.`, which looks like a pooled connection left over from before the restart. The worker logs `Redis is unavailable, retrying in 0:00:05...` and reconnects.\n5. The task was never claimed, so its stream message stays pending (`XPENDING` shows 1 entry, delivery count 1) and its key stays known to docket.\n6. While that key is known, every `mark_work_queues_ready` scheduled by later polls is deduplicated away. `last_polled` stays frozen and the queue stays `NOT_READY`.\n7. The pending message is redelivered once `redelivery_timeout` has passed. The API's background worker uses docket's default of 5 minutes. In my run, the claim on the redelivered message failed the same way once more. The next attempt succeeded and the queue went `READY` without a restart.\n\n#### Reproduction\n\n1. Start Redis:\n\n   ```bash\n   docker run -d --name redis-test -p 6390:6379 redis:7\n   ```\n\n2. Point the server's messaging, lease storage and docket at that Redis instance. Shorten the foreman's `last_polled` timeout so Not Ready shows up quickly:\n\n   ```bash\n   export PREFECT_API_DATABASE_CONNECTION_URL=\"sqlite+aiosqlite:///$PWD/prefect.db\"\n   export PREFECT_MESSAGING_BROKER=prefect_redis.messaging\n   export PREFECT_MESSAGING_CACHE=prefect_redis.messaging\n   export PREFECT_SERVER_EVENTS_CAUSAL_ORDERING=prefect_redis.ordering\n   export PREFECT_SERVER_CONCURRENCY_LEASE_STORAGE=prefect_redis.lease_storage\n   export PREFECT_REDIS_MESSAGING_HOST=localhost\n   export PREFECT_REDIS_MESSAGING_PORT=6390\n   export PREFECT_SERVER_DOCKET_URL=redis://localhost:6390/0\n   export PREFECT_SERVER_SERVICES_FOREMAN_WORK_QUEUE_LAST_POLLED_TIMEOUT_SECONDS=30\n   export PREFECT_API_URL=http://127.0.0.1:4299/api\n   ```\n\n3. Start the API and the background services as separate processes, then create a work pool and start a worker:\n\n   ```bash\n   prefect server start --no-services --port 4299 > api.log 2>&1 &\n   prefect server services start > services.log 2>&1 &\n   prefect work-pool create test-pool --type process\n   prefect worker start --pool test-pool > worker.log 2>&1 &\n   ```\n\n4. Wait until the pool's `default` queue shows **Ready**.\n\n5. Stop Redis for about 90 seconds, then start it again:\n\n   ```bash\n   docker stop redis-test; sleep 90; docker start redis-test\n   ```\n\n6. Check the queue's status and `last_polled` every few seconds, either in the UI or with `POST /work_pools/test-pool/queues/filter`. Also check that the worker stays Online.\n\nWhat I saw, timed from when Redis came back:\n\n- **Within a few seconds:** the queue goes **Not Ready** and `last_polled` is still the time Redis went down. This is expected.\n- **For about the next 6 minutes:** the queue stays **Not Ready** and `last_polled` doesn't change. The worker stays Online, keeps heartbeating, and keeps polling the whole time. `api.log` shows `docket.worker - Redis is unavailable, retrying in 0:00:05...` with `Connection closed by server.` shortly after Redis came back. No restart happens.\n- **About 6 minutes after Redis returned:** `last_polled` starts updating again and the queue goes **Ready** without a restart.\n\n### Version info\n\n```\nVersion:             3.8.6\nPython version:      3.12\nServer type:         server (self-hosted; API and background services run as separate processes)\nIntegrations:\n  prefect-redis:     0.2.15\npydocket:            0.25.2\nredis (redis-py):    8.1.0\nDatabase:            sqlite (repro)\n```\n\n### Additional context\n\n- Docket appears to behave as designed. An unclaimed message stays pending with its key known until the redelivery sweep picks it up again. The 5-minute window comes from that combined with the keyed `mark_work_queues_ready` task (added in #20210) and the default `redelivery_timeout` on the API's background worker.\n- Only work queue readiness is stuck. The worker stays `ONLINE`, heartbeats, and keeps polling.\n- `mark_deployments_ready` is scheduled the same way, with a key, from the same endpoint, so deployment readiness probably has the same window. I haven't checked it separately.\n- With the default `memory://` docket there's no Redis connection to lose, so this only affects setups using Redis-backed docket, such as HA deployments.\n\n", "hints_text": "", "created_at": "2026-10-27T21:36:02Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23640, "instance_id": "PrefectHQ__prefect-23640", "issue_numbers": ["23638"], "base_commit": "71c4ef271d74b91d98e4eae294c7db579d61c2b0", "patch": "diff --git a/ui-v2/src/components/deployments/data-table/cells.tsx b/ui-v2/src/components/deployments/data-table/cells.tsx\nindex d4d79e710f48..ba4c3dd14035 100644\n--- a/ui-v2/src/components/deployments/data-table/cells.tsx\n+++ b/ui-v2/src/components/deployments/data-table/cells.tsx\n@@ -1,4 +1,4 @@\n-import { useQuery } from \"@tanstack/react-query\";\n+import { keepPreviousData, useQuery } from \"@tanstack/react-query\";\n import { Link } from \"@tanstack/react-router\";\n import { subSeconds } from \"date-fns\";\n import { secondsInWeek } from \"date-fns/constants\";\n@@ -19,6 +19,7 @@ import {\n import { FlowRunActivityBarChart } from \"@/components/ui/flow-run-activity-bar-graph\";\n import { Icon } from \"@/components/ui/icons\";\n import useDebounce from \"@/hooks/use-debounce\";\n+import { useNow } from \"@/hooks/use-now\";\n import type { CellContext } from \"@/lib/tanstack-table\";\n \n type ActionsCellProps = CellContext<DeploymentWithFlow, unknown> & {\n@@ -125,19 +126,31 @@ export const ActivityCell = ({\n \t\t};\n \t}, []);\n \n-\tconst { data: flowRuns } = useQuery(\n-\t\tbuildFilterFlowRunsQuery({\n+\tconst now = useNow({ interval: 60_000 });\n+\tconst startDate = subSeconds(now, secondsInWeek);\n+\n+\tconst { data: flowRuns } = useQuery({\n+\t\t...buildFilterFlowRunsQuery({\n \t\t\tdeployments: {\n \t\t\t\toperator: \"and_\",\n \t\t\t\tid: {\n \t\t\t\t\tany_: [row.original.id],\n \t\t\t\t},\n \t\t\t},\n+\t\t\t// Bound to the charted window so future scheduled runs don't crowd out recent runs\n+\t\t\tflow_runs: {\n+\t\t\t\toperator: \"and_\",\n+\t\t\t\tstart_time: {\n+\t\t\t\t\tafter_: startDate.toISOString(),\n+\t\t\t\t\tbefore_: now.toISOString(),\n+\t\t\t\t},\n+\t\t\t},\n \t\t\tsort: \"START_TIME_DESC\",\n \t\t\tlimit: debouncedNumberOfBars || numberOfBars,\n \t\t\toffset: 0,\n \t\t}),\n-\t);\n+\t\tplaceholderData: keepPreviousData,\n+\t});\n \n \tconst { flow, ...deployment } = row.original;\n \tconst enrichedFlowRuns =\n@@ -150,8 +163,8 @@ export const ActivityCell = ({\n \treturn (\n \t\t<div className=\"w-full\" ref={chartRef}>\n \t\t\t<FlowRunActivityBarChart\n-\t\t\t\tstartDate={subSeconds(new Date(), secondsInWeek)}\n-\t\t\t\tendDate={new Date()}\n+\t\t\t\tstartDate={startDate}\n+\t\t\t\tendDate={now}\n \t\t\t\t// If debouncedNumberOfBars is 0, use numberOfBars for an asymmetric debounce to avoid rendering an empty chart on initial paint.\n \t\t\t\tnumberOfBars={debouncedNumberOfBars || numberOfBars}\n \t\t\t\tbarWidth={BAR_WIDTH}\ndiff --git a/ui-v2/src/components/flows/detail/mini-deployment-activity.tsx b/ui-v2/src/components/flows/detail/mini-deployment-activity.tsx\nindex b4c91aac3fa0..96dba2c17399 100644\n--- a/ui-v2/src/components/flows/detail/mini-deployment-activity.tsx\n+++ b/ui-v2/src/components/flows/detail/mini-deployment-activity.tsx\n@@ -1,10 +1,11 @@\n-import { useQuery } from \"@tanstack/react-query\";\n+import { keepPreviousData, useQuery } from \"@tanstack/react-query\";\n import { subSeconds } from \"date-fns\";\n import { secondsInWeek } from \"date-fns/constants\";\n import { useCallback, useState } from \"react\";\n import { buildFilterFlowRunsQuery } from \"@/api/flow-runs\";\n import { FlowRunActivityBarChart } from \"@/components/ui/flow-run-activity-bar-graph\";\n import useDebounce from \"@/hooks/use-debounce\";\n+import { useNow } from \"@/hooks/use-now\";\n \n const BAR_WIDTH = 4;\n const BAR_GAP = 2;\n@@ -38,17 +39,29 @@ export const MiniDeploymentActivity = ({\n \n \tconst effectiveNumberOfBars = debouncedNumberOfBars || numberOfBars;\n \n-\tconst { data: flowRuns } = useQuery(\n-\t\tbuildFilterFlowRunsQuery({\n+\tconst now = useNow({ interval: 60_000 });\n+\tconst startDate = subSeconds(now, secondsInWeek);\n+\n+\tconst { data: flowRuns } = useQuery({\n+\t\t...buildFilterFlowRunsQuery({\n \t\t\tdeployments: {\n \t\t\t\toperator: \"and_\",\n \t\t\t\tid: { any_: [deploymentId] },\n \t\t\t},\n+\t\t\t// Bound to the charted window so future scheduled runs don't crowd out recent runs\n+\t\t\tflow_runs: {\n+\t\t\t\toperator: \"and_\",\n+\t\t\t\tstart_time: {\n+\t\t\t\t\tafter_: startDate.toISOString(),\n+\t\t\t\t\tbefore_: now.toISOString(),\n+\t\t\t\t},\n+\t\t\t},\n \t\t\tlimit: Math.min(60, effectiveNumberOfBars || 60),\n \t\t\tsort: \"START_TIME_DESC\",\n \t\t\toffset: 0,\n \t\t}),\n-\t);\n+\t\tplaceholderData: keepPreviousData,\n+\t});\n \n \tconst enrichedFlowRuns =\n \t\tflowRuns?.map((flowRun) => ({\n@@ -59,8 +72,8 @@ export const MiniDeploymentActivity = ({\n \t\t<div className=\"w-full\" ref={chartRef}>\n \t\t\t<FlowRunActivityBarChart\n \t\t\t\tenrichedFlowRuns={enrichedFlowRuns}\n-\t\t\t\tstartDate={subSeconds(new Date(), secondsInWeek)}\n-\t\t\t\tendDate={new Date()}\n+\t\t\t\tstartDate={startDate}\n+\t\t\t\tendDate={now}\n \t\t\t\tbarWidth={BAR_WIDTH}\n \t\t\t\tnumberOfBars={effectiveNumberOfBars}\n \t\t\t\tclassName=\"h-8 w-full\"\n", "test_patch": "diff --git a/ui-v2/src/components/deployments/data-table/data-table.test.tsx b/ui-v2/src/components/deployments/data-table/data-table.test.tsx\nindex 55828ce28bc6..85ed13e26af2 100644\n--- a/ui-v2/src/components/deployments/data-table/data-table.test.tsx\n+++ b/ui-v2/src/components/deployments/data-table/data-table.test.tsx\n@@ -151,6 +151,41 @@ describe(\"DeploymentsDataTable\", () => {\n \t\texpect(screen.getByText(\"tag2\")).toBeInTheDocument();\n \t});\n \n+\tit(\"limits activity runs to the charted window so future scheduled runs don't crowd out recent runs\", async () => {\n+\t\tconst activityRequests: {\n+\t\t\tflow_runs?: {\n+\t\t\t\tstart_time?: { after_?: string; before_?: string };\n+\t\t\t};\n+\t\t}[] = [];\n+\t\tserver.use(\n+\t\t\thttp.post(buildApiUrl(\"/flow_runs/filter\"), async ({ request }) => {\n+\t\t\t\tconst body = (await request.json()) as {\n+\t\t\t\t\tdeployments?: { id?: { any_?: string[] } };\n+\t\t\t\t};\n+\t\t\t\tif (body.deployments?.id?.any_?.includes(mockDeployment.id)) {\n+\t\t\t\t\tactivityRequests.push(body as (typeof activityRequests)[number]);\n+\t\t\t\t}\n+\t\t\t\treturn HttpResponse.json([]);\n+\t\t\t}),\n+\t\t);\n+\n+\t\tconst before = Date.now();\n+\t\trender(<DeploymentsDataTableRouter {...defaultProps} />, {\n+\t\t\twrapper: createWrapper(),\n+\t\t});\n+\n+\t\tawait waitFor(() => expect(activityRequests.length).toBeGreaterThan(0));\n+\n+\t\tconst window = activityRequests[0].flow_runs?.start_time;\n+\t\texpect(window?.after_).toBeDefined();\n+\t\texpect(window?.before_).toBeDefined();\n+\t\tconst after = new Date(window?.after_ ?? \"\").getTime();\n+\t\tconst beforeTime = new Date(window?.before_ ?? \"\").getTime();\n+\t\texpect(beforeTime).toBeGreaterThanOrEqual(before - 1000);\n+\t\texpect(beforeTime).toBeLessThanOrEqual(Date.now());\n+\t\texpect(beforeTime - after).toBe(7 * 24 * 60 * 60 * 1000);\n+\t});\n+\n \tit(\"renders with empty deployments array\", async () => {\n \t\tawait waitFor(() =>\n \t\t\trender(\ndiff --git a/ui-v2/src/components/flows/detail/flow-deployments-tab.test.tsx b/ui-v2/src/components/flows/detail/flow-deployments-tab.test.tsx\nindex 36519807afb7..14919ad30f7c 100644\n--- a/ui-v2/src/components/flows/detail/flow-deployments-tab.test.tsx\n+++ b/ui-v2/src/components/flows/detail/flow-deployments-tab.test.tsx\n@@ -66,6 +66,37 @@ describe(\"FlowDeploymentsTab\", () => {\n \t\t});\n \t});\n \n+\tit(\"limits deployment activity runs to the charted window so future scheduled runs don't crowd out recent runs\", async () => {\n+\t\tconst activityRequests: {\n+\t\t\tflow_runs?: {\n+\t\t\t\tstart_time?: { after_?: string; before_?: string };\n+\t\t\t};\n+\t\t}[] = [];\n+\t\tserver.use(\n+\t\t\thttp.post(buildApiUrl(\"/flow_runs/filter\"), async ({ request }) => {\n+\t\t\t\tconst body = (await request.json()) as {\n+\t\t\t\t\tdeployments?: { id?: { any_?: string[] } };\n+\t\t\t\t};\n+\t\t\t\tif (body.deployments?.id?.any_?.includes(deployment.id)) {\n+\t\t\t\t\tactivityRequests.push(body as (typeof activityRequests)[number]);\n+\t\t\t\t}\n+\t\t\t\treturn HttpResponse.json([]);\n+\t\t\t}),\n+\t\t);\n+\n+\t\tconst before = Date.now();\n+\t\trenderTab();\n+\n+\t\tawait waitFor(() => expect(activityRequests.length).toBeGreaterThan(0));\n+\n+\t\tconst window = activityRequests[0].flow_runs?.start_time;\n+\t\tconst after = new Date(window?.after_ ?? \"\").getTime();\n+\t\tconst beforeTime = new Date(window?.before_ ?? \"\").getTime();\n+\t\texpect(beforeTime).toBeGreaterThanOrEqual(before - 1000);\n+\t\texpect(beforeTime).toBeLessThanOrEqual(Date.now());\n+\t\texpect(beforeTime - after).toBe(7 * 24 * 60 * 60 * 1000);\n+\t});\n+\n \tit(\"shows NOT_READY status even when paused is true\", async () => {\n \t\tconst pausedDeployment = createFakeDeployment({\n \t\t\tpaused: true,\n", "problem_statement": "V2 UI feedback: Navigation or usability\n### UI switch feedback\n\n- From UI: V2 UI\n- To UI: V1 UI\n- Current path: /deployments\n- Reason: Navigation or usability\n\n### Additional notes\nreally bad overview for the upcoming runs, if there are too many scheduled you cant see the recent runs, the deployment overview page should alsways show the next x and the most recent x centered with an indication of the current ones running as well\n", "hints_text": "", "created_at": "2026-10-27T16:41:11Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23636, "instance_id": "PrefectHQ__prefect-23636", "issue_numbers": ["23631"], "base_commit": "916e42635f8726f5d68ec187ed6b89905ff3e24c", "patch": "diff --git a/src/prefect/server/schemas/schedules.py b/src/prefect/server/schemas/schedules.py\nindex 0f8aedac2ccb..94d8dddf8580 100644\n--- a/src/prefect/server/schemas/schedules.py\n+++ b/src/prefect/server/schemas/schedules.py\n@@ -7,7 +7,9 @@\n import calendar\n import datetime\n import sys\n-from collections.abc import Callable\n+from collections.abc import Callable, Iterator\n+from heapq import merge\n+from itertools import islice, takewhile\n from math import gcd\n from typing import (\n     Annotated,\n@@ -743,11 +745,34 @@ def localize(wall_time: datetime.datetime) -> datetime.datetime:\n             return _whenever_to_stdlib(min(viable) if viable else min(candidates))\n \n         cron = croniter(self.cron, start_naive, day_or=self.day_or)  # type: ignore\n+        wall_times = iter(lambda: cron.get_next(datetime.datetime), None)\n+        candidate_dates: Iterator[datetime.datetime] = map(localize, wall_times)\n+        transition = start_instant.add(seconds=1).prev_transition()\n+        if transition is not None:\n+            gap = (transition.offset - transition.subtract(seconds=1).offset).total(\n+                \"seconds\"\n+            )\n+            if 0 <= (start_instant - transition).total(\"seconds\") < gap:\n+                lookback = croniter(\n+                    self.cron,\n+                    start_naive - datetime.timedelta(seconds=gap),\n+                    day_or=self.day_or,\n+                )\n+                gap_end = _whenever_to_stdlib(transition).replace(tzinfo=None)\n+                shifted_times = takewhile(\n+                    lambda wall: wall < gap_end,\n+                    iter(lambda: lookback.get_next(datetime.datetime), None),\n+                )\n+                candidate_dates = merge(\n+                    map(localize, shifted_times),\n+                    candidate_dates,\n+                    key=lambda date: date.astimezone(datetime.timezone.utc),\n+                )\n+\n         start_utc = start.astimezone(datetime.timezone.utc)\n         end_utc = end.astimezone(datetime.timezone.utc) if end else None\n         dates = set()\n-        for _ in range(MAX_ITERATIONS + 2):\n-            next_date = localize(cron.get_next(datetime.datetime))\n+        for next_date in islice(candidate_dates, MAX_ITERATIONS + 2):\n             next_utc = next_date.astimezone(datetime.timezone.utc)\n             if end_utc and next_utc > end_utc:\n                 break\n", "test_patch": "diff --git a/tests/server/schemas/test_schedules.py b/tests/server/schemas/test_schedules.py\nindex 20fb6d477339..1439de0ab37d 100644\n--- a/tests/server/schemas/test_schedules.py\n+++ b/tests/server/schemas/test_schedules.py\n@@ -1015,6 +1015,105 @@ class TestCronScheduleDaylightSavingsTime:\n     Tests that DST boundaries are respected\n     \"\"\"\n \n+    async def test_berlin_spring_gap_resolution(self):\n+        zone = ZoneInfo(\"Europe/Berlin\")\n+        schedule = CronSchedule(cron=\"30 2 * * *\", timezone=zone.key)\n+        dates = await schedule.get_dates(n=3, start=datetime(2027, 3, 28, tzinfo=zone))\n+        expected_first = (\n+            \"2027-03-28T01:30:00+01:00\"\n+            if sys.version_info < (3, 13)\n+            else \"2027-03-28T03:30:00+02:00\"\n+        )\n+        assert [value.isoformat() for value in dates] == [\n+            expected_first,\n+            \"2027-03-29T02:30:00+02:00\",\n+            \"2027-03-30T02:30:00+02:00\",\n+        ]\n+\n+    @pytest.mark.skipif(\n+        sys.version_info < (3, 13), reason=\"Legacy Pendulum resolution is unchanged\"\n+    )\n+    @pytest.mark.parametrize(\n+        \"timezone, day\",\n+        [(\"Europe/Berlin\", \"2027-03-28\"), (\"America/New_York\", \"2024-03-10\")],\n+    )\n+    @pytest.mark.parametrize(\n+        \"start_time, end_time, expected_shift\",\n+        [\n+            (\"00:00:00\", \"04:00:00\", True),\n+            (\"01:45:00\", \"04:00:00\", True),\n+            (\"03:00:00\", \"03:20:00\", False),\n+            (\"03:00:00\", \"03:30:00\", True),\n+            (\"03:30:00\", \"04:00:00\", True),\n+            (\"03:30:00.000001\", \"04:00:00\", False),\n+            (\"04:00:00\", \"05:00:00\", False),\n+        ],\n+    )\n+    async def test_cron_gap_shifted_start_and_end_bounds(\n+        self,\n+        timezone: str,\n+        day: str,\n+        start_time: str,\n+        end_time: str,\n+        expected_shift: bool,\n+    ):\n+        zone = ZoneInfo(timezone)\n+        schedule = CronSchedule(cron=\"30 2 * * *\", timezone=timezone)\n+        start = datetime.fromisoformat(f\"{day}T{start_time}\").replace(tzinfo=zone)\n+        end = datetime.fromisoformat(f\"{day}T{end_time}\").replace(tzinfo=zone)\n+        shifted = datetime.fromisoformat(f\"{day}T03:30:00\").replace(tzinfo=zone)\n+\n+        dates = await schedule.get_dates(start=start, end=end)\n+\n+        assert dates == ([shifted] if expected_shift else [])\n+        next_dates = await schedule.get_dates(n=2, start=start)\n+        next_day = (shifted + timedelta(days=1)).replace(hour=2)\n+        assert next_dates[0] == (shifted if start <= shifted else next_day)\n+        assert all(value.timestamp() >= start.timestamp() for value in next_dates)\n+\n+    @pytest.mark.parametrize(\n+        \"cron, timezone, start, expected\",\n+        [\n+            (\n+                \"20,40 2 * * *\",\n+                \"Australia/Lord_Howe\",\n+                \"2024-10-06T02:30:00+11:00\",\n+                [\n+                    \"2024-10-06T02:40:00+11:00\",\n+                    \"2024-10-06T02:50:00+11:00\",\n+                    \"2024-10-07T02:20:00+11:00\",\n+                ],\n+            ),\n+            (\n+                \"0 12 * * 5\",\n+                \"Pacific/Apia\",\n+                \"2011-12-31T00:00:00+14:00\",\n+                [\n+                    \"2011-12-31T12:00:00+14:00\",\n+                    \"2012-01-06T12:00:00+14:00\",\n+                    \"2012-01-13T12:00:00+14:00\",\n+                ],\n+            ),\n+        ],\n+    )\n+    @pytest.mark.skipif(\n+        sys.version_info < (3, 13),\n+        reason=\"Corrected DST resolution applies to the Python 3.13+ whenever engine\",\n+    )\n+    async def test_cron_gap_lookback_preserves_order(\n+        self, cron: str, timezone: str, start: str, expected: list[str]\n+    ):\n+        schedule = CronSchedule(cron=cron, timezone=timezone)\n+        start_date = datetime.fromisoformat(start)\n+\n+        dates = await schedule.get_dates(n=3, start=start_date)\n+\n+        assert [value.astimezone(ZoneInfo(\"UTC\")) for value in dates] == [\n+            datetime.fromisoformat(value).astimezone(ZoneInfo(\"UTC\"))\n+            for value in expected\n+        ]\n+        assert await schedule.get_dates(n=1, start=start_date) == dates[:1]\n+\n     async def test_berlin_fall_runs_only_at_first_occurrence(self):\n         zone = ZoneInfo(\"Europe/Berlin\")\n         schedule = CronSchedule(cron=\"30 2 * * *\", timezone=zone.key)\n", "problem_statement": "Preserve cron start bounds across DST folds and gaps\n### Problem\n\nOn Python 3.13+, timezone-aware cron generation can return dates before its requested start during a fall-back fold, and can skip a still-upcoming occurrence shifted out of a spring-forward gap.\n\n### Reproduction\n\nFor `CronSchedule(cron=\"30 2 * * *\", timezone=\"Europe/Berlin\")`:\n\n- Starting at `2026-10-25T02:15:00+01:00` (the second fold) returns `2026-10-25T02:30:00+02:00`, before the requested start.\n- Starting at `2027-03-28T03:00:00+02:00` skips that day's shifted `03:30+02:00` occurrence and starts on March 29 instead.\n\nReproduced against current main on Python 3.13 and 3.14 with Whenever 0.11. Python 3.11\u20133.12 use a legacy Pendulum path whose behavior is outside this fix.\n\n### Scope\n\nExtract the cron fixes and regressions from draft #23424 into two reviewable PRs against main: first preserve fold/start bounds, then recover gap-shifted occurrences. Keep interval changes and SDK contract changes out of this stack.\n\n", "hints_text": "", "created_at": "2026-10-27T16:29:51Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23630, "instance_id": "PrefectHQ__prefect-23630", "issue_numbers": ["23629"], "base_commit": "88c32fa42b1b9f6da12cf757c9c543fa50a6eb09", "patch": "diff --git a/src/prefect/flows.py b/src/prefect/flows.py\nindex 8e3d16775fa8..72e90aa3b018 100644\n--- a/src/prefect/flows.py\n+++ b/src/prefect/flows.py\n@@ -706,11 +706,11 @@ def serialize_parameters(\n                 from fastapi.encoders import jsonable_encoder\n \n                 serialized_parameters[key] = jsonable_encoder(value)\n-            except (TypeError, ValueError, RecursionError):\n-                # `jsonable_encoder` recurses into unknown objects with no cycle\n-                # or depth limit, so a deeply-nested or self-referential value\n-                # raises `RecursionError`. Treat it like any other unserializable\n-                # value and fall back to the placeholder below.\n+            except Exception:\n+                # `jsonable_encoder` can raise arbitrary errors for values it\n+                # cannot encode (e.g. `RecursionError` for self-referential\n+                # objects, or any error from `__reduce__` while deep-copying a\n+                # dataclass). Fall back to the placeholder below.\n                 logger.debug(\n                     f\"Parameter {key!r} for flow {self.name!r} is unserializable. \"\n                     f\"Type {type(value).__name__!r} and will not be stored \"\n", "test_patch": "diff --git a/tests/test_flows.py b/tests/test_flows.py\nindex f1ab02f51c46..867fc0515708 100644\n--- a/tests/test_flows.py\n+++ b/tests/test_flows.py\n@@ -1,4 +1,5 @@\n import asyncio\n+import dataclasses\n import datetime\n import enum\n import inspect\n@@ -1849,6 +1850,25 @@ def __init__(self):\n         # See #22244.\n         assert my_flow.serialize_parameters({\"x\": data}) == {\"x\": \"<Cyclic>\"}\n \n+    def test_serialize_parameters_falls_back_on_arbitrary_encoder_errors(self):\n+        @flow\n+        def my_flow(x):\n+            return x\n+\n+        class Uncopyable:\n+            def __reduce__(self):\n+                raise NotImplementedError\n+\n+        @dataclasses.dataclass\n+        class Holder:\n+            value: Uncopyable\n+\n+        # jsonable_encoder deep-copies dataclasses, so any error raised by\n+        # `__reduce__` escapes the encoder. See #23629.\n+        assert my_flow.serialize_parameters({\"x\": Holder(Uncopyable())}) == {\n+            \"x\": \"<Holder>\"\n+        }\n+\n     def test_flow_parameter_annotations_can_be_non_pydantic_classes(self):\n         class Test:\n             pass\n", "problem_statement": "`Flow.serialize_parameters` crashes on errors other than `TypeError`/`ValueError`/`RecursionError` from `jsonable_encoder`\n### Bug summary\n\n`Flow.serialize_parameters` falls back to the `\"<Type>\"` placeholder only for `TypeError`, `ValueError` and `RecursionError`. `jsonable_encoder` deep-copies dataclasses, so any other exception raised by a parameter's `__reduce__` escapes, and the flow run fails before it starts.\n\n```python\nimport dataclasses\n\nfrom prefect import flow\n\n\nclass Uncopyable:\n    def __reduce__(self):\n        raise NotImplementedError\n\n\n@dataclasses.dataclass\nclass Holder:\n    value: Uncopyable\n\n\n@flow\ndef f(x): ...\n\n\nprint(f.serialize_parameters({\"x\": Holder(Uncopyable())}))\n```\n\nOutput:\n\n```\n  File \"prefect/flows.py\", line 708, in serialize_parameters\n    serialized_parameters[key] = jsonable_encoder(value)\n  File \"fastapi/encoders.py\", line 261, in jsonable_encoder\n    obj_dict = dataclasses.asdict(obj)\n  ...\nNotImplementedError\n```\n\nExpected: `{'x': '<Holder>'}`.\n\n### Version info\n\n```Text\nVersion:              3.9.0\nAPI version:          0.8.4\nPython version:       3.13.12\nGit commit:           1ef3e516\nBuilt:                Wed, Oct 21, 2026 03:29 AM\nOS/Arch:              linux/x86_64\nPydantic version:     2.13.4\n```\n\n`main` has the same `except` clause (`src/prefect/flows.py:709`).\n\n### Additional context\n\nRelated: #22245.\n\n", "hints_text": "", "created_at": "2026-10-27T16:07:52Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23626, "instance_id": "PrefectHQ__prefect-23626", "issue_numbers": ["23625"], "base_commit": "dbae04e2f8201ce079c9a551498d45240e6b92c8", "patch": "diff --git a/ui-v2/src/components/ui/app-sidebar.tsx b/ui-v2/src/components/ui/app-sidebar.tsx\nindex 19e60a28f81d..fbd1fa69396b 100644\n--- a/ui-v2/src/components/ui/app-sidebar.tsx\n+++ b/ui-v2/src/components/ui/app-sidebar.tsx\n@@ -1,6 +1,6 @@\n import { useQuery } from \"@tanstack/react-query\";\n import { Link, useNavigate } from \"@tanstack/react-router\";\n-import { LogOut } from \"lucide-react\";\n+import { LogOut, X } from \"lucide-react\";\n import { useState } from \"react\";\n import { buildGetSettingsQuery } from \"@/api/admin\";\n import { buildUiSettingsQuery } from \"@/api/ui-settings\";\n@@ -14,6 +14,7 @@ import {\n \tSidebarGroup,\n \tSidebarHeader,\n \tSidebarMenu,\n+\tSidebarMenuAction,\n \tSidebarMenuButton,\n \tSidebarMenuItem,\n } from \"@/components/ui/sidebar\";\n@@ -22,12 +23,17 @@ import {\n \tUiVersionSwitchDialog,\n \ttype UiVersionSwitchDialogValues,\n } from \"@/components/ui-version-switch\";\n+import { useLocalStorage } from \"@/hooks/use-local-storage\";\n import { isUiAvailable } from \"@/utils/ui-version\";\n \n export function AppSidebar() {\n \tconst auth = useAuthSafe();\n \tconst navigate = useNavigate();\n \tconst [isSwitchDialogOpen, setIsSwitchDialogOpen] = useState(false);\n+\tconst [isV1ShortcutHidden, setIsV1ShortcutHidden] = useLocalStorage(\n+\t\t\"prefect-v1-ui-shortcut-hidden\",\n+\t\tfalse,\n+\t);\n \n \tconst handleLogout = () => {\n \t\tauth?.logout();\n@@ -202,11 +208,18 @@ export function AppSidebar() {\n \t\t\t\t\t\t\t)}\n \t\t\t\t\t\t</Link>\n \t\t\t\t\t</SidebarMenuItem>\n-\t\t\t\t\t{canSwitchToV1 && (\n+\t\t\t\t\t{canSwitchToV1 && !isV1ShortcutHidden && (\n \t\t\t\t\t\t<SidebarMenuItem>\n \t\t\t\t\t\t\t<SidebarMenuButton onClick={() => setIsSwitchDialogOpen(true)}>\n \t\t\t\t\t\t\t\t<span>Switch to V1 UI</span>\n \t\t\t\t\t\t\t</SidebarMenuButton>\n+\t\t\t\t\t\t\t<SidebarMenuAction\n+\t\t\t\t\t\t\t\taria-label=\"Hide Switch to V1 UI shortcut\"\n+\t\t\t\t\t\t\t\ttitle=\"Hide shortcut (still available in Settings)\"\n+\t\t\t\t\t\t\t\tonClick={() => setIsV1ShortcutHidden(true)}\n+\t\t\t\t\t\t\t>\n+\t\t\t\t\t\t\t\t<X aria-hidden=\"true\" />\n+\t\t\t\t\t\t\t</SidebarMenuAction>\n \t\t\t\t\t\t</SidebarMenuItem>\n \t\t\t\t\t)}\n \t\t\t\t\t{authRequired && (\n", "test_patch": "diff --git a/ui-v2/src/components/ui/app-sidebar.test.tsx b/ui-v2/src/components/ui/app-sidebar.test.tsx\nindex 13e0a31ba417..6a2c799afc90 100644\n--- a/ui-v2/src/components/ui/app-sidebar.test.tsx\n+++ b/ui-v2/src/components/ui/app-sidebar.test.tsx\n@@ -9,7 +9,8 @@ import { render, screen, waitFor } from \"@testing-library/react\";\n import userEvent from \"@testing-library/user-event\";\n import { buildApiUrl, createWrapper, server } from \"@tests/utils\";\n import { delay, HttpResponse, http } from \"msw\";\n-import { afterEach, describe, expect, it, vi } from \"vitest\";\n+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\n+import { buildUiSettingsQuery } from \"@/api/ui-settings\";\n import { AuthContext, type AuthState } from \"@/auth\";\n import { SidebarProvider } from \"@/components/ui/sidebar\";\n import * as uiVersionSwitch from \"@/components/ui-version-switch\";\n@@ -37,11 +38,52 @@ const createTestRouter = (authState: AuthState | null) => {\n };\n \n describe(\"AppSidebar\", () => {\n+\tbeforeEach(() => {\n+\t\tconst items = new Map<string, string>();\n+\t\tvi.spyOn(localStorage, \"getItem\").mockImplementation(\n+\t\t\t(key) => items.get(key) ?? null,\n+\t\t);\n+\t\tvi.spyOn(localStorage, \"setItem\").mockImplementation((key, value) => {\n+\t\t\titems.set(key, value);\n+\t\t});\n+\t});\n \tafterEach(() => {\n \t\tvi.restoreAllMocks();\n \t});\n \n \tdescribe(\"ui switching\", () => {\n+\t\tit(\"dismisses the shortcut without switching UIs and remembers it after remount\", async () => {\n+\t\t\tconst user = userEvent.setup();\n+\t\t\tconst switchToV1UiSpy = vi.spyOn(uiVersionSwitch, \"switchToV1Ui\");\n+\t\t\tconst { unmount } = render(\n+\t\t\t\t<RouterProvider router={createTestRouter(null)} />,\n+\t\t\t\t{ wrapper: createWrapper() },\n+\t\t\t);\n+\n+\t\t\tawait user.click(\n+\t\t\t\tawait screen.findByRole(\"button\", {\n+\t\t\t\t\tname: \"Hide Switch to V1 UI shortcut\",\n+\t\t\t\t}),\n+\t\t\t);\n+\n+\t\t\texpect(screen.queryByText(\"Switch to V1 UI\")).not.toBeInTheDocument();\n+\t\t\texpect(screen.queryByRole(\"dialog\")).not.toBeInTheDocument();\n+\t\t\texpect(switchToV1UiSpy).not.toHaveBeenCalled();\n+\t\t\texpect(\n+\t\t\t\tscreen.getByRole(\"link\", { name: \"Settings\" }),\n+\t\t\t).toBeInTheDocument();\n+\n+\t\t\tunmount();\n+\t\t\tconst queryClient = new QueryClient();\n+\t\t\tawait queryClient.ensureQueryData(buildUiSettingsQuery());\n+\t\t\trender(<RouterProvider router={createTestRouter(null)} />, {\n+\t\t\t\twrapper: createWrapper({ queryClient }),\n+\t\t\t});\n+\n+\t\t\tawait screen.findByRole(\"link\", { name: \"Settings\" });\n+\t\t\texpect(screen.queryByText(\"Switch to V1 UI\")).not.toBeInTheDocument();\n+\t\t});\n+\n \t\tit(\"renders the switch-back action when the current UI is available\", async () => {\n \t\t\tconst router = createTestRouter(null);\n \n", "problem_statement": "Allow dismissing the V1 UI sidebar shortcut\n### Problem\n\nIn the V2 UI, the sidebar always shows \u201cSwitch to V1 UI\u201d when both UI bundles are available. Users who have settled on V2 cannot dismiss the shortcut, even though the same switch is already available on Settings.\n\n### Reproduction\n\nOn current main (`dbae04e2f8`), open V2 with both UI bundles available. The sidebar footer shows the switch action and offers no way to hide it. A component regression that attempts to dismiss the shortcut fails because no dismiss control exists; the existing nine sidebar tests pass.\n\n### Proposed change\n\nAdd an accessible dismiss action alongside the sidebar shortcut, persist dismissal in this browser using the existing local-storage hook, and retain the switch on Settings. This preserves rollback access while allowing users to clear the persistent shortcut.\n\n", "hints_text": "", "created_at": "2026-10-27T15:00:35Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23624, "instance_id": "PrefectHQ__prefect-23624", "issue_numbers": ["23623"], "base_commit": "7c7b28a1be2b6db40bd61baecc1925c472f6df75", "patch": "diff --git a/.github/scripts/comment-api-compatibility.cjs b/.github/scripts/comment-api-compatibility.cjs\nnew file mode 100644\nindex 000000000000..75734148808d\n--- /dev/null\n+++ b/.github/scripts/comment-api-compatibility.cjs\n@@ -0,0 +1,81 @@\n+const fs = require('node:fs');\n+\n+const marker = '<!-- cloud-api-compatibility -->';\n+\n+module.exports = async ({github, context, core}) => {\n+  const run = context.payload.workflow_run;\n+  const repository = context.repo;\n+  if (run.path !== '.github/workflows/api-compatibility-tests.yaml') return;\n+  const {data: latest} = await github.rest.actions.listWorkflowRuns({\n+    ...repository, workflow_id: run.workflow_id, event: 'pull_request', head_sha: run.head_sha, per_page: 1,\n+  });\n+  if (latest.workflow_runs[0]?.id !== run.id || latest.workflow_runs[0]?.run_attempt !== run.run_attempt) return;\n+  // Resolve the PR from GitHub, never from the artifact uploaded by PR code.\n+  const pulls = await github.paginate(github.rest.repos.listPullRequestsAssociatedWithCommit, {\n+    ...repository, commit_sha: run.head_sha,\n+  });\n+  const matching = pulls.filter(pr => pr.state === 'open' &&\n+    pr.base.repo.full_name === `${repository.owner}/${repository.repo}` &&\n+    pr.head.repo?.full_name === run.head_repository.full_name && pr.head.sha === run.head_sha);\n+  if (matching.length !== 1) return;\n+  const issue_number = matching[0].number;\n+  const comments = await github.paginate(github.rest.issues.listComments, {...repository, issue_number});\n+  const previous = comments.find(comment => comment.user.login === 'github-actions[bot]' &&\n+    comment.body.startsWith(marker));\n+\n+  let report = {status: 'unavailable'};\n+  try {\n+    const fd = fs.openSync(process.env.COMPATIBILITY_REPORT, 'r');\n+    try {\n+      const limit = 1024 * 1024;\n+      const buffer = Buffer.alloc(limit + 1);\n+      let bytesRead = 0;\n+      while (bytesRead < buffer.length) {\n+        const count = fs.readSync(fd, buffer, bytesRead, buffer.length - bytesRead, null);\n+        if (count === 0) break;\n+        bytesRead += count;\n+      }\n+      if (bytesRead > limit) throw new Error('Report exceeds size limit');\n+      report = JSON.parse(buffer.toString('utf8', 0, bytesRead));\n+    } finally {\n+      fs.closeSync(fd);\n+    }\n+    if (!['compatible', 'incompatible', 'unavailable'].includes(report.status) ||\n+        (report.status !== 'unavailable' && (!Array.isArray(report.new_failures) ||\n+          report.new_failures.length > 10000 || report.new_failures.some(name =>\n+            typeof name !== 'string' || name.length > 2000) ||\n+          (report.status === 'incompatible') !== (report.new_failures.length > 0)))) {\n+      throw new Error('Invalid compatibility report');\n+    }\n+  } catch (error) {\n+    core.warning(`Compatibility report unavailable: ${error.message}`);\n+    report = {status: 'unavailable'};\n+  }\n+  if (!previous && report.status !== 'incompatible') return;\n+\n+  const url = `https://github.com/${repository.owner}/${repository.repo}/actions/runs/${run.id}`;\n+  let body = `${marker}\\n**Cloud API compatibility (advisory)**\\n\\n`;\n+  if (report.status === 'incompatible') {\n+    // Escape artifact content before including it in a privileged bot comment.\n+    const escape = value => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;')\n+      .replaceAll('>', '&gt;').replaceAll('@', '&#64;');\n+    body += 'The compatibility suite found new or changed failures against the deployed Cloud API. ' +\n+      'A maintainer should check whether Cloud needs a corresponding change before merging. ' +\n+      'This check is non-blocking; contributors do not need to coordinate Cloud changes unless a maintainer asks.\\n\\n';\n+    body += report.new_failures.slice(0, 20).map(name => `- <code>${escape(name)}</code>`).join('\\n');\n+    if (report.new_failures.length > 20) body += '\\n\\nAdditional failures are in the report.';\n+  } else if (report.status === 'compatible') {\n+    body += 'The latest run found no new compatibility failures. Existing differences on the base revision are excluded.';\n+  } else {\n+    body += 'Compatibility could not be evaluated in the latest run. See the logs for the test or infrastructure error.';\n+  }\n+  body += `\\n\\n[View the report and logs](${url}).`;\n+  // Recheck after reading artifacts and comments so an obsolete run cannot clear a newer warning.\n+  const {data: current} = await github.rest.pulls.get({...repository, pull_number: issue_number});\n+  if (current.state !== 'open' || current.head.sha !== run.head_sha) return;\n+  if (previous) {\n+    await github.rest.issues.updateComment({...repository, comment_id: previous.id, body});\n+  } else {\n+    await github.rest.issues.createComment({...repository, issue_number, body});\n+  }\n+};\ndiff --git a/.github/workflows/api-compatibility-comment.yaml b/.github/workflows/api-compatibility-comment.yaml\nnew file mode 100644\nindex 000000000000..822903dd8fa6\n--- /dev/null\n+++ b/.github/workflows/api-compatibility-comment.yaml\n@@ -0,0 +1,43 @@\n+---\n+name: Cloud API Compatibility Comment\n+on:\n+  workflow_run:\n+    workflows: [Cloud API Compatibility]\n+    types: [completed]\n+\n+permissions:\n+  actions: read\n+  contents: read\n+  pull-requests: write\n+\n+concurrency:\n+  group: cloud-api-comment-${{ github.event.workflow_run.head_repository.full_name }}-${{ github.event.workflow_run.head_branch }}\n+  cancel-in-progress: false\n+\n+jobs:\n+  comment:\n+    if: ${{ github.event.workflow_run.event == 'pull_request' && github.event.workflow_run.conclusion != 'cancelled' }}\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 5\n+    steps:\n+      # Only trusted default-branch code runs with permission to comment.\n+      - uses: actions/checkout@v7\n+        with:\n+          persist-credentials: false\n+\n+      - name: Download the report as untrusted data\n+        continue-on-error: true\n+        uses: actions/download-artifact@v8\n+        with:\n+          name: cloud-api-compatibility\n+          path: ${{ runner.temp }}/cloud-api-compatibility\n+          run-id: ${{ github.event.workflow_run.id }}\n+          github-token: ${{ secrets.GITHUB_TOKEN }}\n+\n+      - uses: actions/github-script@v8\n+        env:\n+          COMPATIBILITY_REPORT: ${{ runner.temp }}/cloud-api-compatibility/report.json\n+        with:\n+          script: |\n+            const comment = require('./.github/scripts/comment-api-compatibility.cjs');\n+            await comment({github, context, core});\ndiff --git a/scripts/generate_oss_openapi_schema.py b/scripts/generate_oss_openapi_schema.py\nindex 440e4a33a6dd..12f2bbd0fbab 100644\n--- a/scripts/generate_oss_openapi_schema.py\n+++ b/scripts/generate_oss_openapi_schema.py\n@@ -1,27 +1,32 @@\n+import argparse\n import json\n \n from prefect.server.api.server import create_api_app, create_ui_app\n \n-# Generate schema from main API app\n+parser = argparse.ArgumentParser()\n+parser.add_argument(\"--api-compatibility\", action=\"store_true\")\n+args = parser.parse_args()\n+\n api_app = create_api_app()\n openapi_schema = api_app.openapi()\n \n-# Generate schema from UI app and merge relevant routes\n-ui_app = create_ui_app(ephemeral=True)\n-ui_schema = ui_app.openapi()\n-\n-# Merge /ui-settings path from ui_app into main schema\n-for path, path_item in ui_schema.get(\"paths\", {}).items():\n-    if \"ui-settings\" in path:\n-        # Use the path without any base URL prefix\n-        openapi_schema[\"paths\"][\"/ui-settings\"] = path_item\n-\n-# Merge UISettings schema component\n-for schema_name, schema_def in (\n-    ui_schema.get(\"components\", {}).get(\"schemas\", {}).items()\n-):\n-    if schema_name not in openapi_schema.get(\"components\", {}).get(\"schemas\", {}):\n-        openapi_schema[\"components\"][\"schemas\"][schema_name] = schema_def\n+if args.api_compatibility:\n+    # The shared suite expects the API mount prefix and excludes the root UI.\n+    openapi_schema[\"paths\"] = {\n+        f\"/api{path}\": item for path, item in openapi_schema[\"paths\"].items()\n+    }\n+else:\n+    # UI type generation also needs the root webserver's settings endpoint.\n+    ui_app = create_ui_app(ephemeral=True)\n+    ui_schema = ui_app.openapi()\n+    for path, path_item in ui_schema.get(\"paths\", {}).items():\n+        if \"ui-settings\" in path:\n+            openapi_schema[\"paths\"][\"/ui-settings\"] = path_item\n+    for schema_name, schema_def in (\n+        ui_schema.get(\"components\", {}).get(\"schemas\", {}).items()\n+    ):\n+        if schema_name not in openapi_schema.get(\"components\", {}).get(\"schemas\", {}):\n+            openapi_schema[\"components\"][\"schemas\"][schema_name] = schema_def\n \n with open(\"oss_schema.json\", \"w\") as f:\n     json.dump(openapi_schema, f)\ndiff --git a/scripts/report_api_compatibility.py b/scripts/report_api_compatibility.py\nnew file mode 100644\nindex 000000000000..9306bc286ebc\n--- /dev/null\n+++ b/scripts/report_api_compatibility.py\n@@ -0,0 +1,79 @@\n+\"\"\"Report newly observed shared-suite failures against one Cloud schema snapshot.\"\"\"\n+\n+import argparse\n+import hashlib\n+import json\n+import os\n+import xml.etree.ElementTree as ET\n+from pathlib import Path\n+\n+\n+def read_results(directory: Path) -> tuple[int, dict[tuple[str, str], str]]:\n+    \"\"\"Read completed pytest results and fingerprint their assertion failures.\"\"\"\n+    status = int((directory / \"status\").read_text())\n+    root = ET.parse(directory / \"pytest.xml\").getroot()\n+    cases = list(root.iter(\"testcase\"))\n+    if status not in (0, 1) or not cases or root.find(\".//error\") is not None:\n+        raise ValueError(f\"{directory.name} compatibility tests did not complete\")\n+    failures = {}\n+    for case in cases:\n+        failure = case.find(\"failure\")\n+        if failure is None:\n+            continue\n+        message = failure.get(\"message\", \"\")\n+        if not message.startswith(\"AssertionError\"):\n+            raise ValueError(f\"{directory.name} tests encountered a harness error\")\n+        # A changed failure in an already-failing test still needs attention.\n+        digest = hashlib.sha256(message.encode()).hexdigest()\n+        name = case.attrib[\"name\"]\n+        failures[name, digest] = name\n+    if bool(status) != bool(failures):\n+        raise ValueError(f\"{directory.name} exit status disagrees with its report\")\n+    return len(cases), failures\n+\n+\n+def compare_results(directory: Path) -> dict:\n+    \"\"\"Exclude unchanged base failures and distinguish incomplete checks.\"\"\"\n+    try:\n+        base_count, base = read_results(directory / \"base\")\n+        head_count, head = read_results(directory / \"head\")\n+    except (OSError, ValueError, ET.ParseError) as exc:\n+        return {\"status\": \"unavailable\", \"reason\": str(exc)}\n+    new_failures = sorted(head[key] for key in head.keys() - base.keys())\n+    return {\n+        \"status\": \"incompatible\" if new_failures else \"compatible\",\n+        \"base_tests\": base_count,\n+        \"head_tests\": head_count,\n+        \"base_failures\": len(base),\n+        \"head_failures\": len(head),\n+        \"new_failures\": new_failures,\n+    }\n+\n+\n+def main() -> int:\n+    \"\"\"Write the comparison report and return its advisory exit status.\"\"\"\n+    parser = argparse.ArgumentParser(description=__doc__)\n+    parser.add_argument(\"directory\", type=Path)\n+    args = parser.parse_args()\n+    args.directory.mkdir(parents=True, exist_ok=True)\n+    report = compare_results(args.directory)\n+    (args.directory / \"report.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\n+    if report[\"status\"] == \"unavailable\":\n+        summary = \"Cloud API compatibility could not be evaluated. See the test logs.\"\n+    else:\n+        summary = (\n+            f\"Cloud API compatibility: {len(report['new_failures'])} new failures \"\n+            f\"({report['base_failures']} on base, {report['head_failures']} on head).\"\n+        )\n+    print(summary)\n+    if summary_path := os.environ.get(\"GITHUB_STEP_SUMMARY\"):\n+        with open(summary_path, \"a\") as output:\n+            output.write(summary + \"\\n\")\n+    if report[\"status\"] != \"compatible\":\n+        print(f\"::warning::{summary}\")\n+        return 1\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n", "test_patch": "diff --git a/.github/scripts/comment-api-compatibility.test.cjs b/.github/scripts/comment-api-compatibility.test.cjs\nnew file mode 100644\nindex 000000000000..f0cb24041c77\n--- /dev/null\n+++ b/.github/scripts/comment-api-compatibility.test.cjs\n@@ -0,0 +1,126 @@\n+const assert = require('node:assert/strict');\n+const {test} = require('node:test');\n+const fs = require('node:fs');\n+const os = require('node:os');\n+const path = require('node:path');\n+const comment = require('./comment-api-compatibility.cjs');\n+\n+async function run(t, report, {previous = false, stale = false, changed = false, superseded = false} = {}) {\n+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'compat-comment-'));\n+  t.after(() => fs.rmSync(directory, {recursive: true, force: true}));\n+  process.env.COMPATIBILITY_REPORT = path.join(directory, 'report.json');\n+  if (report !== null) fs.writeFileSync(process.env.COMPATIBILITY_REPORT, JSON.stringify(report));\n+  const pr = {number: 12, state: 'open', base: {repo: {full_name: 'PrefectHQ/prefect'}},\n+    head: {sha: stale ? 'new' : 'head', repo: {full_name: 'contributor/prefect'}}};\n+  const writes = [];\n+  const github = {\n+    rest: {\n+      actions: {listWorkflowRuns: async () => ({data: {workflow_runs: [{id: 42, run_attempt: superseded ? 2 : 1}]}})},\n+      repos: {listPullRequestsAssociatedWithCommit: 'pulls'},\n+      pulls: {get: async () => ({data: changed ? {...pr, head: {...pr.head, sha: 'new'}} : pr})},\n+      issues: {listComments: 'comments',\n+        createComment: async data => writes.push({action: 'create', ...data}),\n+        updateComment: async data => writes.push({action: 'update', ...data})},\n+    },\n+    paginate: async method => method === 'pulls' ? [pr] : previous ? [\n+      {id: 7, user: {login: 'github-actions[bot]'}, body: '<!-- cloud-api-compatibility --> old warning'},\n+    ] : [],\n+  };\n+  await comment({github, core: {warning: () => {}}, context: {\n+    repo: {owner: 'PrefectHQ', repo: 'prefect'},\n+    payload: {workflow_run: {id: 42, run_attempt: 1, workflow_id: 9,\n+      path: '.github/workflows/api-compatibility-tests.yaml',\n+      head_sha: 'head', head_repository: {full_name: 'contributor/prefect'}}},\n+  }});\n+  return writes;\n+}\n+\n+test('creates one advisory for a new incompatibility on a fork PR', async t => {\n+  const writes = await run(t, {status: 'incompatible', new_failures: ['test_route[POST: /api/new]']});\n+  assert.equal(writes.length, 1);\n+  assert.equal(writes[0].action, 'create');\n+  assert.equal(writes[0].issue_number, 12);\n+  assert.match(writes[0].body, /non-blocking/);\n+  assert.match(writes[0].body, /test_route\\[POST: \\/api\\/new\\]/);\n+});\n+\n+test('updates the existing warning instead of adding a comment', async t => {\n+  const writes = await run(t, {status: 'incompatible', new_failures: ['test_sort']}, {previous: true});\n+  assert.equal(writes.length, 1);\n+  assert.equal(writes[0].action, 'update');\n+  assert.equal(writes[0].comment_id, 7);\n+});\n+\n+test('clears the existing warning when the new incompatibility is resolved', async t => {\n+  const writes = await run(t, {status: 'compatible', new_failures: []}, {previous: true});\n+  assert.equal(writes[0].action, 'update');\n+  assert.match(writes[0].body, /no new compatibility failures/);\n+});\n+\n+test('does not create comments for passing or unavailable checks', async t => {\n+  for (const report of [{status: 'compatible', new_failures: []}, {status: 'unavailable'}, null]) {\n+    assert.deepEqual(await run(t, report), []);\n+  }\n+});\n+\n+test('updates an existing warning when a check is unavailable or malformed', async t => {\n+  for (const report of [null, {status: 'incompatible', new_failures: []}, {status: 'compatible', new_failures: [1]}]) {\n+    const writes = await run(t, report, {previous: true});\n+    assert.match(writes[0].body, /could not be evaluated/);\n+  }\n+});\n+\n+test('ignores obsolete runs, including a head changed during processing', async t => {\n+  const report = {status: 'incompatible', new_failures: ['test_route']};\n+  assert.deepEqual(await run(t, report, {stale: true}), []);\n+  assert.deepEqual(await run(t, report, {changed: true}), []);\n+  assert.deepEqual(await run(t, report, {superseded: true}), []);\n+});\n+\n+test('escapes report content instead of posting markup or mentions', async t => {\n+  const writes = await run(t, {status: 'incompatible', new_failures: ['</code>@someone & <img>']});\n+  assert.match(writes[0].body, /&lt;\\/code&gt;&#64;someone &amp; &lt;img&gt;/);\n+  assert.doesNotMatch(writes[0].body, /@someone|<img>/);\n+});\n+\n+test('uses the opened report when its path is replaced before partial reads', async t => {\n+  let replaced = false;\n+  const replace = () => {\n+    if (replaced) return;\n+    const reportPath = process.env.COMPATIBILITY_REPORT;\n+    const replacement = `${reportPath}.replacement`;\n+    fs.writeFileSync(replacement, JSON.stringify({status: 'incompatible', new_failures: ['replacement']}) + ' '.repeat(1024 * 1024));\n+    fs.renameSync(replacement, reportPath);\n+    replaced = true;\n+  };\n+  const readFile = fs.readFileSync;\n+  t.mock.method(fs, 'readFileSync', (file, ...args) => {replace(); return readFile(file, ...args);});\n+  const read = fs.readSync;\n+  t.mock.method(fs, 'readSync', (fd, buffer, offset, length, position) => {\n+    replace();\n+    return read(fd, buffer, offset, Math.min(length, 13), position);\n+  });\n+  const writes = await run(t, {status: 'compatible', new_failures: [], padding: '\ud83d\ude80'}, {previous: true});\n+  assert.equal(replaced, true);\n+  assert.match(writes[0].body, /no new compatibility failures/);\n+});\n+\n+for (const bytes of [1024 * 1024, 1024 * 1024 + 1]) {\n+  test(`enforces the ${bytes}-byte report boundary and closes its descriptor`, async t => {\n+    const report = {status: 'incompatible', new_failures: ['test_route'], padding: '\ud83d\ude80'};\n+    report.padding += ' '.repeat(bytes - Buffer.byteLength(JSON.stringify(report)));\n+    let descriptor;\n+    let bytesRead = 0;\n+    const read = fs.readSync;\n+    t.mock.method(fs, 'readSync', (...args) => {\n+      descriptor = args[0];\n+      const count = read(...args);\n+      bytesRead += count;\n+      return count;\n+    });\n+    const writes = await run(t, report, {previous: true});\n+    assert.match(writes[0].body, bytes === 1024 * 1024 ? /new or changed failures/ : /could not be evaluated/);\n+    assert.ok(bytesRead <= 1024 * 1024 + 1);\n+    assert.throws(() => fs.fstatSync(descriptor), {code: 'EBADF'});\n+  });\n+}\ndiff --git a/.github/workflows/api-compatibility-tests.yaml b/.github/workflows/api-compatibility-tests.yaml\nindex a898a0f5958d..6bd3074913a3 100644\n--- a/.github/workflows/api-compatibility-tests.yaml\n+++ b/.github/workflows/api-compatibility-tests.yaml\n@@ -1,76 +1,97 @@\n ---\n name: Cloud API Compatibility\n on:\n+  # Run even when the last API change is removed, so an earlier warning clears.\n   pull_request:\n-    paths:\n-      - .github/workflows/api-compatibility-tests.yaml\n-      - \"**/*.py\"\n-      - pyproject.toml\n-      - compat-tests\n   push:\n-    branches:\n-      - main\n+    branches: [main]\n+  workflow_dispatch:\n+\n+permissions:\n+  contents: read\n \n-# Limit concurrency by workflow/branch combination.\n-#\n-# For pull request builds, pushing additional changes to the\n-# branch will cancel prior in-progress and pending builds.\n-#\n-# For builds triggered on a branch push, additional changes\n-# will wait for prior builds to complete before starting.\n-#\n-# https://docs.github.com/en/actions/using-jobs/using-concurrency\n concurrency:\n   group: ${{ github.workflow }}-${{ github.ref }}\n   cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n \n jobs:\n   compatibility-tests:\n-\n-    if: false # temporarily pausing compat tests on OSS\n-\n-    timeout-minutes: 10\n-\n+    name: Cloud API compatibility (advisory)\n+    # Keep compatibility and harness failures advisory for contributors.\n+    continue-on-error: true\n+    timeout-minutes: 20\n     runs-on: ubuntu-latest\n+    env:\n+      PREFECT_SERVER_ANALYTICS_ENABLED: \"false\"\n+      PYTHONHASHSEED: \"0\"\n \n     steps:\n+      - name: Prepare the report directory\n+        run: echo \"REPORT_DIR=$RUNNER_TEMP/cloud-api-compatibility\" >> \"$GITHUB_ENV\"\n+\n       - uses: actions/checkout@v7\n         with:\n-          # Versioningit only generates correct versions with a full fetch\n+          path: head\n           fetch-depth: 0\n           filter: blob:none\n           persist-credentials: false\n           submodules: true\n \n-      - name: Set up Python 3.12\n-        uses: actions/setup-python@v7\n-        id: setup_python\n+      - uses: actions/checkout@v7\n         with:\n-          python-version: \"3.15\"\n+          path: base\n+          ref: ${{ github.event.pull_request.base.sha || github.event.before || github.sha }}\n+          fetch-depth: 0\n+          filter: blob:none\n+          persist-credentials: false\n \n-      - name: UV Cache\n-        # Manually cache the uv cache directory\n-        # until setup-python supports it:\n-        # https://github.com/actions/setup-python/issues/822\n-        uses: actions/cache@v6\n-        id: cache-uv\n+      - uses: astral-sh/setup-uv@v10.3.0\n         with:\n-          path: ~/.cache/uv\n-          key: uvcache-${{ runner.os }}-${{ steps.setup_python.outputs.python-version }}-${{ hashFiles('requirements-client.txt', 'requirements.txt', 'requirements-dev.txt') }}\n+          python-version: \"3.12\"\n+          enable-cache: true\n \n-      - name: Install packages\n+      - name: Install both revisions\n         run: |\n-          python -m pip install -U uv\n-          uv pip install --upgrade --system -e .[dev] 'pydantic>=2.4,<3'\n+          uv sync --project base --locked\n+          uv sync --project head --locked\n \n-      - name: Create Cloud OpenAPI JSON\n-        working-directory: compat-tests\n-        run: curl https://api.prefect.cloud/api/openapi.json > cloud_schema.json\n+      - name: Download the deployed Cloud schema once\n+        run: |\n+          mkdir -p \"$REPORT_DIR/base\" \"$REPORT_DIR/head\"\n+          curl --fail --silent --show-error --location --retry 3 \\\n+            --connect-timeout 15 --max-time 120 \\\n+            https://api.prefect.cloud/api/openapi.json -o \"$REPORT_DIR/cloud_schema.json\"\n \n-      - name: Create OSS OpenAPI JSON\n-        working-directory: compat-tests\n-        run: python ../scripts/generate_oss_openapi_schema.py\n+      - name: Test compatibility reporting\n+        run: |\n+          uv run --project head --no-sync pytest -c head/compat-tests/pytest.ini \\\n+            head/scripts/tests/test_report_api_compatibility.py -q\n+          node --test head/.github/scripts/comment-api-compatibility.test.cjs\n \n-      - name: Run API compatibility tests\n-        working-directory: compat-tests\n-        run: pytest -vv\n+      - name: Compare both revisions with the same suite and Cloud schema\n+        run: |\n+          for revision in base head; do\n+            project=\"$GITHUB_WORKSPACE/$revision\"\n+            cd \"$REPORT_DIR/$revision\"\n+            cp \"$REPORT_DIR/cloud_schema.json\" cloud_schema.json\n+            uv run --project \"$project\" --no-sync python \\\n+              \"$GITHUB_WORKSPACE/head/scripts/generate_oss_openapi_schema.py\" --api-compatibility\n+            uv run --project \"$project\" --no-sync pytest \\\n+              -c \"$GITHUB_WORKSPACE/head/compat-tests/pytest.ini\" \\\n+              \"$GITHUB_WORKSPACE/head/compat-tests/test_oss_cloud_api_compatibility.py\" \\\n+              --junitxml=pytest.xml --tb=short -q > pytest.log 2>&1 && compat_exit=0 || compat_exit=$?\n+            echo \"$compat_exit\" > status\n+            tail -n 20 pytest.log\n+          done\n+\n+      - name: Report new incompatibilities\n+        if: ${{ always() }}\n+        run: python head/scripts/report_api_compatibility.py \"$REPORT_DIR\"\n+\n+      - name: Save the compatibility report and logs\n+        if: ${{ always() }}\n+        uses: actions/upload-artifact@v7\n+        with:\n+          name: cloud-api-compatibility\n+          path: ${{ env.REPORT_DIR }}\n+          retention-days: 7\ndiff --git a/scripts/run-compatibility-tests b/scripts/run-compatibility-tests\nindex 5ac0ab01be65..2b57a14dfcf2 100755\n--- a/scripts/run-compatibility-tests\n+++ b/scripts/run-compatibility-tests\n@@ -1,5 +1,6 @@\n #!/bin/bash\n-cd compat-tests\n-curl https://api.prefect.cloud/api/openapi.json > cloud_schema.json\n-python ../scripts/generate_oss_openapi_schema.py\n+set -euo pipefail\n+cd \"$(dirname \"$0\")/../compat-tests\"\n+curl --fail --silent --show-error --location --retry 3 https://api.prefect.cloud/api/openapi.json > cloud_schema.json\n+python ../scripts/generate_oss_openapi_schema.py --api-compatibility\n pytest -vv test_oss_cloud_api_compatibility.py\ndiff --git a/scripts/tests/test_report_api_compatibility.py b/scripts/tests/test_report_api_compatibility.py\nnew file mode 100644\nindex 000000000000..38135dce223f\n--- /dev/null\n+++ b/scripts/tests/test_report_api_compatibility.py\n@@ -0,0 +1,141 @@\n+import importlib.util\n+import json\n+import subprocess\n+import sys\n+import xml.etree.ElementTree as ET\n+from pathlib import Path\n+\n+import pytest\n+\n+SCRIPTS = Path(__file__).resolve().parents[1]\n+spec = importlib.util.spec_from_file_location(\n+    \"report_api_compatibility\", SCRIPTS / \"report_api_compatibility.py\"\n+)\n+reporter = importlib.util.module_from_spec(spec)\n+spec.loader.exec_module(reporter)\n+\n+\n+@pytest.fixture\n+def results(tmp_path: Path) -> Path:\n+    for revision in (\"base\", \"head\"):\n+        directory = tmp_path / revision\n+        directory.mkdir()\n+        write_results(directory, {})\n+    return tmp_path\n+\n+\n+def write_results(\n+    directory: Path, failures: dict[str, str], status: int | None = None\n+) -> None:\n+    suite = ET.Element(\"testsuite\")\n+    ET.SubElement(suite, \"testcase\", name=\"passing_test\")\n+    for name, message in failures.items():\n+        case = ET.SubElement(suite, \"testcase\", name=name)\n+        ET.SubElement(case, \"failure\", message=message)\n+    ET.ElementTree(suite).write(directory / \"pytest.xml\")\n+    (directory / \"status\").write_text(\n+        str(int(bool(failures)) if status is None else status)\n+    )\n+\n+\n+def test_existing_failures_do_not_warn(results: Path):\n+    for revision in (\"base\", \"head\"):\n+        write_results(\n+            results / revision, {\"test_sort[TaskRunSort]\": \"AssertionError: duration\"}\n+        )\n+    report = reporter.compare_results(results)\n+    assert report[\"status\"] == \"compatible\"\n+    assert report[\"new_failures\"] == []\n+    assert report[\"base_failures\"] == report[\"head_failures\"] == 1\n+\n+\n+def test_new_and_changed_failures_warn(results: Path):\n+    write_results(\n+        results / \"base\", {\"test_sort[TaskRunSort]\": \"AssertionError: duration\"}\n+    )\n+    write_results(\n+        results / \"head\",\n+        {\n+            \"test_sort[TaskRunSort]\": \"AssertionError: duration, new_sort\",\n+            \"test_route[POST: /api/new]\": \"AssertionError: missing endpoint\",\n+        },\n+    )\n+    report = reporter.compare_results(results)\n+    assert report[\"status\"] == \"incompatible\"\n+    assert report[\"new_failures\"] == [\n+        \"test_route[POST: /api/new]\",\n+        \"test_sort[TaskRunSort]\",\n+    ]\n+\n+\n+def test_resolved_failures_do_not_warn(results: Path):\n+    write_results(results / \"base\", {\"test_sort\": \"AssertionError: duration\"})\n+    assert reporter.compare_results(results)[\"status\"] == \"compatible\"\n+\n+\n+@pytest.mark.parametrize(\"revision\", [\"base\", \"head\"])\n+@pytest.mark.parametrize(\n+    \"failure\",\n+    [\n+        \"missing\",\n+        \"invalid_xml\",\n+        \"collection\",\n+        \"harness\",\n+        \"empty\",\n+        \"inconsistent\",\n+        \"error\",\n+    ],\n+)\n+def test_incomplete_checks_are_unavailable(results: Path, revision: str, failure: str):\n+    directory = results / revision\n+    if failure == \"missing\":\n+        (directory / \"pytest.xml\").unlink()\n+    elif failure == \"invalid_xml\":\n+        (directory / \"pytest.xml\").write_text(\"not xml\")\n+    elif failure == \"collection\":\n+        (directory / \"status\").write_text(\"2\")\n+    elif failure == \"harness\":\n+        write_results(directory, {\"test_route\": \"KeyError: tags\"})\n+    elif failure == \"empty\":\n+        (directory / \"pytest.xml\").write_text(\"<testsuite/>\")\n+    elif failure == \"inconsistent\":\n+        write_results(directory, {\"test_sort\": \"AssertionError: duration\"}, status=0)\n+    else:\n+        write_results(directory, {\"test_sort\": \"AssertionError: duration\"})\n+        root = ET.parse(directory / \"pytest.xml\")\n+        ET.SubElement(root.getroot(), \"error\", message=\"fixture failed\")\n+        root.write(directory / \"pytest.xml\")\n+    assert reporter.compare_results(results)[\"status\"] == \"unavailable\"\n+\n+\n+def test_cli_preserves_the_advisory_result(results: Path):\n+    write_results(results / \"head\", {\"test_route\": \"AssertionError: new endpoint\"})\n+    result = subprocess.run(\n+        [sys.executable, str(SCRIPTS / \"report_api_compatibility.py\"), str(results)],\n+        check=False,\n+        capture_output=True,\n+        text=True,\n+    )\n+    assert result.returncode == 1\n+    assert \"::warning::\" in result.stdout\n+    assert json.loads((results / \"report.json\").read_text())[\"status\"] == \"incompatible\"\n+\n+\n+@pytest.mark.parametrize(\"compatibility\", [False, True])\n+def test_schema_generation_preserves_the_ui_contract(\n+    tmp_path: Path, compatibility: bool\n+):\n+    command = [sys.executable, str(SCRIPTS / \"generate_oss_openapi_schema.py\")]\n+    if compatibility:\n+        command.append(\"--api-compatibility\")\n+    subprocess.run(command, cwd=tmp_path, check=True, capture_output=True, text=True)\n+    schema = json.loads((tmp_path / \"oss_schema.json\").read_text())\n+    if compatibility:\n+        assert \"/api/flows/\" in schema[\"paths\"]\n+        assert \"/api/ui-settings\" not in schema[\"paths\"]\n+        assert \"UISettings\" not in schema[\"components\"][\"schemas\"]\n+        assert all(path.startswith(\"/api/\") for path in schema[\"paths\"])\n+    else:\n+        assert \"/flows/\" in schema[\"paths\"]\n+        assert \"/ui-settings\" in schema[\"paths\"]\n+        assert \"UISettings\" in schema[\"components\"][\"schemas\"]\n", "problem_statement": "Restore advisory Cloud API compatibility checks on pull requests\nThe OSS Cloud API compatibility workflow is disabled, so API changes can merge before the corresponding changes reach Prefect Cloud. This can break the compatibility tests downstream.\n\nRestore the shared suite as a non-blocking check. Compare the base and proposed changes against the same deployed Cloud schema so existing drift does not warn on unrelated pull requests. Maintain one PR comment for new failures, explain that Cloud coordination belongs to maintainers, and update the comment when the failures are resolved.\n\nThe earlier workflow was paused in #14773.\n", "hints_text": "", "created_at": "2026-10-27T13:54:14Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23619, "instance_id": "PrefectHQ__prefect-23619", "issue_numbers": ["23615"], "base_commit": "77e0b94dd977f4a8c7a9454dbedcdc930d4c3dde", "patch": "diff --git a/src/prefect/server/api/server.py b/src/prefect/server/api/server.py\nindex 0f3a20386c99..e8e3f69e51e9 100644\n--- a/src/prefect/server/api/server.py\n+++ b/src/prefect/server/api/server.py\n@@ -11,7 +11,9 @@\n import gc\n import hmac\n import importlib.metadata\n+import json\n import logging\n+import math\n import mimetypes\n import os\n import random\n@@ -292,16 +294,34 @@ async def validation_exception_handler(\n     \"\"\"Provide a detailed message for request validation errors.\"\"\"\n     return JSONResponse(\n         status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n-        content=jsonable_encoder(\n-            {\n-                \"exception_message\": \"Invalid request received.\",\n-                \"exception_detail\": exc.errors(),\n-                \"request_body\": exc.body,\n-            }\n+        content=_json_safe(\n+            jsonable_encoder(\n+                {\n+                    \"exception_message\": \"Invalid request received.\",\n+                    \"exception_detail\": exc.errors(),\n+                    \"request_body\": exc.body,\n+                }\n+            )\n         ),\n     )\n \n \n+def _json_safe(value: Any) -> Any:\n+    \"\"\"\n+    Replace values that cannot be rendered as strict JSON, such as `NaN` or strings\n+    containing unpaired surrogates, so that invalid input can be echoed back.\n+    \"\"\"\n+    if isinstance(value, float) and not math.isfinite(value):\n+        return json.dumps(value)\n+    if isinstance(value, str):\n+        return value.encode(\"utf-8\", \"backslashreplace\").decode(\"utf-8\")\n+    if isinstance(value, dict):\n+        return {_json_safe(k): _json_safe(v) for k, v in value.items()}\n+    if isinstance(value, list):\n+        return [_json_safe(v) for v in value]\n+    return value\n+\n+\n async def integrity_exception_handler(request: Request, exc: Exception) -> JSONResponse:\n     \"\"\"Capture database integrity errors.\"\"\"\n     logger.error(\"Encountered exception in request:\", exc_info=True)\n@@ -317,7 +337,20 @@ async def integrity_exception_handler(request: Request, exc: Exception) -> JSONR\n     )\n \n \n+def is_invalid_data_exception(exc: Exception) -> bool:\n+    \"\"\"\n+    Whether the database rejected a value as invalid (SQLSTATE class 22, \"data\n+    exception\"), e.g. a NUL character or `NaN` in a PostgreSQL JSON value.\n+    \"\"\"\n+    orig = exc.orig if isinstance(exc, sqlalchemy.exc.DBAPIError) else exc\n+    sqlstate = getattr(orig, \"sqlstate\", None)\n+    return isinstance(sqlstate, str) and sqlstate.startswith(\"22\")\n+\n+\n def is_client_retryable_exception(exc: Exception) -> bool:\n+    if is_invalid_data_exception(exc):\n+        return False\n+\n     if isinstance(exc, sqlalchemy.exc.OperationalError) and isinstance(\n         exc.orig, sqlite3.OperationalError\n     ):\n@@ -399,8 +432,29 @@ async def custom_internal_exception_handler(\n     \"\"\"\n     Log a detailed exception for internal server errors before returning.\n \n-    Send 503 for errors clients can retry on.\n+    Send 422 for values the database rejected and 503 for errors clients can retry on.\n     \"\"\"\n+    if is_invalid_data_exception(exc):\n+        logger.warning(\"Database rejected a value in request:\", exc_info=True)\n+        return JSONResponse(\n+            content={\n+                \"exception_message\": \"Invalid request received.\",\n+                \"exception_detail\": [\n+                    {\n+                        \"type\": \"value_error\",\n+                        \"loc\": [\"body\"],\n+                        \"msg\": (\n+                            \"The database rejected a value in the request. This \"\n+                            \"usually means a string contains a NUL character or a \"\n+                            \"JSON value contains NaN or Infinity. See server logs \"\n+                            \"for details.\"\n+                        ),\n+                    }\n+                ],\n+            },\n+            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n+        )\n+\n     if is_client_retryable_exception(exc):\n         if PREFECT_API_LOG_RETRYABLE_ERRORS.value():\n             logger.error(\"Encountered retryable exception in request:\", exc_info=True)\ndiff --git a/src/prefect/server/utilities/server.py b/src/prefect/server/utilities/server.py\nindex 62658dd21041..f87c65d16c82 100644\n--- a/src/prefect/server/utilities/server.py\n+++ b/src/prefect/server/utilities/server.py\n@@ -2,11 +2,13 @@\n Utilities for the Prefect REST API server.\n \"\"\"\n \n+import re\n from collections.abc import Coroutine, Sequence\n from contextlib import AsyncExitStack\n from typing import TYPE_CHECKING, Any, Callable, get_type_hints\n \n from fastapi import APIRouter, Request, Response, status\n+from fastapi.exceptions import RequestValidationError\n from fastapi.routing import APIRoute\n from starlette.routing import BaseRoute\n \n@@ -38,6 +40,62 @@ def method_paths_from_routes(routes: Sequence[BaseRoute]) -> set[str]:\n     return method_paths\n \n \n+# A JSON `\\uD800`-`\\uDFFF` escape, or the raw bytes of a surrogate, which\n+# `json.loads` decodes with `surrogatepass`\n+_SURROGATE_PATTERN = re.compile(rb\"\\\\u[dD][89a-fA-F]|\\xed[\\xa0-\\xbf]\")\n+\n+\n+def _find_unpaired_surrogate(\n+    value: Any, loc: tuple[str | int, ...]\n+) -> tuple[str | int, ...] | None:\n+    \"\"\"Return the location of the first string that is not encodable as UTF-8.\"\"\"\n+    if isinstance(value, str):\n+        try:\n+            value.encode(\"utf-8\")\n+        except UnicodeEncodeError:\n+            return loc\n+    elif isinstance(value, dict):\n+        for key, item in value.items():\n+            if _find_unpaired_surrogate(key, loc) is not None:\n+                return loc\n+            if (found := _find_unpaired_surrogate(item, (*loc, key))) is not None:\n+                return found\n+    elif isinstance(value, list):\n+        for index, item in enumerate(value):\n+            if (found := _find_unpaired_surrogate(item, (*loc, index))) is not None:\n+                return found\n+    return None\n+\n+\n+async def _reject_unpaired_surrogates(request: Request) -> None:\n+    \"\"\"\n+    Reject JSON bodies containing unpaired surrogates (e.g. `\"\\\\ud800\"`), which\n+    cannot be encoded as UTF-8 and so can neither be stored nor returned.\n+    \"\"\"\n+    if \"json\" not in request.headers.get(\"content-type\", \"application/json\"):\n+        return\n+    if not _SURROGATE_PATTERN.search(await request.body()):\n+        return\n+    try:\n+        body = await request.json()\n+    except ValueError:\n+        # Leave reporting malformed JSON to FastAPI\n+        return\n+    loc = _find_unpaired_surrogate(body, (\"body\",))\n+    if loc is not None:\n+        raise RequestValidationError(\n+            [\n+                {\n+                    \"type\": \"string_unicode\",\n+                    \"loc\": loc,\n+                    \"msg\": \"String should not contain unpaired surrogates\",\n+                    \"input\": None,\n+                }\n+            ],\n+            body=body,\n+        )\n+\n+\n class PrefectAPIRoute(APIRoute):\n     \"\"\"\n     A FastAPIRoute class which attaches an async stack to requests that exits before\n@@ -55,6 +113,9 @@ def get_route_handler(self) -> Callable[[Request], Coroutine[Any, Any, Response]\n \n         async def handle_response_scoped_depends(request: Request) -> Response:\n             # Create a new stack scoped to exit before the response is returned\n+            if self.body_field is not None:\n+                await _reject_unpaired_surrogates(request)\n+\n             response = None\n             async with AsyncExitStack() as stack:\n                 request.state.response_scoped_stack = stack\n", "test_patch": "diff --git a/tests/server/api/test_server.py b/tests/server/api/test_server.py\nindex ea1c49990414..815f6d5d6498 100644\n--- a/tests/server/api/test_server.py\n+++ b/tests/server/api/test_server.py\n@@ -31,7 +31,9 @@\n     create_api_app,\n     create_app,\n     create_ui_app,\n+    is_client_retryable_exception,\n )\n+from prefect.server.database import PrefectDBInterface, orm_models\n from prefect.server.utilities.server import method_paths_from_routes\n from prefect.settings import (\n     PREFECT_API_DATABASE_CONNECTION_URL,\n@@ -69,6 +71,81 @@ async def test_validation_error_handler_422(client):\n     assert response.json()[\"request_body\"] == bad_flow_data\n \n \n+async def test_validation_error_handler_renders_non_finite_floats(client: AsyncClient):\n+    response = await client.post(\n+        \"/flows/\",\n+        content=b'{\"name\": \"my-flow\", \"tags\": NaN}',\n+        headers={\"content-type\": \"application/json\"},\n+    )\n+    assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY\n+    assert response.json()[\"exception_detail\"][0][\"input\"] == \"NaN\"\n+    assert response.json()[\"request_body\"] == {\"name\": \"my-flow\", \"tags\": \"NaN\"}\n+\n+\n+@pytest.mark.parametrize(\n+    \"body\",\n+    [\n+        b'{\"name\": \"my-flow\", \"tags\": [\"ok\", \"\\\\ud800\"]}',\n+        b'{\"name\": \"my-flow\", \"tags\": [\"ok\", \"\\xed\\xa0\\x80\"]}',\n+    ],\n+    ids=[\"escaped\", \"raw\"],\n+)\n+async def test_unpaired_surrogates_are_rejected(client: AsyncClient, body: bytes):\n+    response = await client.post(\n+        \"/flows/\", content=body, headers={\"content-type\": \"application/json\"}\n+    )\n+    assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY\n+    assert response.json()[\"exception_detail\"] == [\n+        {\n+            \"type\": \"string_unicode\",\n+            \"loc\": [\"body\", \"tags\", 1],\n+            \"msg\": \"String should not contain unpaired surrogates\",\n+            \"input\": None,\n+        }\n+    ]\n+    assert response.json()[\"request_body\"] == {\n+        \"name\": \"my-flow\",\n+        \"tags\": [\"ok\", \"\\\\ud800\"],\n+    }\n+\n+\n+async def test_unpaired_surrogate_in_variable_value_is_rejected(client: AsyncClient):\n+    response = await client.post(\n+        \"/variables/\",\n+        content=b'{\"name\": \"my_variable\", \"value\": {\"x\": \"\\\\udc00\"}}',\n+        headers={\"content-type\": \"application/json\"},\n+    )\n+    assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY\n+    assert response.json()[\"exception_detail\"][0][\"loc\"] == [\"body\", \"value\", \"x\"]\n+\n+\n+async def test_surrogate_pairs_are_accepted(client: AsyncClient):\n+    name = f\"my-flow-{uuid4()}\"\n+    response = await client.post(\n+        \"/flows/\",\n+        content=b'{\"name\": \"%s-\\\\ud83d\\\\ude00\"}' % name.encode(),\n+        headers={\"content-type\": \"application/json\"},\n+    )\n+    assert response.status_code == status.HTTP_201_CREATED\n+    assert response.json()[\"name\"] == f\"{name}-\\U0001f600\"\n+\n+\n+async def test_values_rejected_by_the_database_return_422(\n+    client_without_exceptions: AsyncClient,\n+    flow: orm_models.Flow,\n+    db: PrefectDBInterface,\n+):\n+    response = await client_without_exceptions.post(\n+        \"/flow_runs/\",\n+        json={\"flow_id\": str(flow.id), \"parameters\": {\"x\": \"a\\x00b\"}},\n+    )\n+    if db.dialect.name == \"postgresql\":\n+        assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY\n+        assert response.json()[\"exception_message\"] == \"Invalid request received.\"\n+    else:\n+        assert response.status_code == status.HTTP_201_CREATED\n+\n+\n async def test_validation_error_handler_409(client):\n     # generate deployment with invalid foreign key\n     bad_deployment_data = {\n@@ -244,6 +321,47 @@ async def raise_other_error():\n         assert response.status_code == 500\n \n \n+def _asyncpg_dbapi_error(sqlstate: str) -> sa.exc.DBAPIError:\n+    orig = Exception(\"orig\")\n+    orig.sqlstate = orig.pgcode = sqlstate  # pyright: ignore[reportAttributeAccessIssue]\n+    return sa.exc.DBAPIError(\"statement\", {}, orig)\n+\n+\n+@pytest.mark.parametrize(\n+    \"exc\",\n+    (\n+        _asyncpg_dbapi_error(\"22P05\"),\n+        _asyncpg_dbapi_error(\"22P02\"),\n+        _asyncpg_dbapi_error(\"22021\"),\n+        asyncpg.exceptions.UntranslatableCharacterError(),\n+        asyncpg.exceptions.InvalidTextRepresentationError(),\n+    ),\n+)\n+async def test_invalid_data_exception_handler(exc: Exception):\n+    assert not is_client_retryable_exception(exc)\n+\n+    async def raise_invalid_data_error():\n+        raise exc\n+\n+    with temporary_settings(\n+        {PREFECT_SERVER_DOCKET_NAME: f\"test-docket-{uuid4().hex[:8]}\"}\n+    ):\n+        app = create_app(ephemeral=True, ignore_cache=True)\n+    app.api_app.add_api_route(\"/raise_invalid_data_error\", raise_invalid_data_error)\n+\n+    async with AsyncClient(\n+        transport=ASGITransport(app=app, raise_app_exceptions=False),\n+        base_url=\"https://test\",\n+    ) as client:\n+        response = await client.get(\"/api/raise_invalid_data_error\")\n+        assert response.status_code == 422\n+        assert response.json()[\"exception_message\"] == \"Invalid request received.\"\n+\n+\n+def test_non_data_database_errors_remain_retryable():\n+    assert is_client_retryable_exception(_asyncpg_dbapi_error(\"57014\"))\n+\n+\n def _write_fake_ui_bundle(directory: pathlib.Path, marker: str) -> pathlib.Path:\n     directory.mkdir(parents=True)\n     (directory / \"index.html\").write_text(\n", "problem_statement": "Invalid values in request bodies return 503 (retried by the client) or 500 instead of 422\n### Bug summary\n\nSome request bodies containing invalid values get a 5xx response instead of 422.\n\n- **503 on PostgreSQL:** NUL (`\"\\u0000\"`) or a lone surrogate (`\"\\ud800\"`) in a JSONB field, or `NaN` in artifact `data`. The Python client retries 503s, so `create_flow_run_from_deployment(..., parameters={\"x\": \"a\\x00b\"})` takes 127 s before it fails.\n- **500:** `NaN` in a validated field, or a lone surrogate in a variable value. Validation fails, and then rendering the 422 body raises.\n\n```python\nimport sys\nimport uuid\n\nimport httpx\n\napi = sys.argv[1] if len(sys.argv) > 1 else \"http://127.0.0.1:4200/api\"\nc = httpx.Client(base_url=api, limits=httpx.Limits(max_keepalive_connections=0))\nflow_id = c.post(\"/flows/\", json={\"name\": f\"repro-{uuid.uuid4().hex[:8]}\"}).json()[\"id\"]\n\n\ndef post(label, path, body):\n    r = c.post(path, content=body.encode(), headers={\"content-type\": \"application/json\"})\n    print(f\"{label:42} -> {r.status_code} {r.text[:40]}\")\n    return r\n\n\nrun = '{\"flow_id\": \"%s\", %%s}' % flow_id\nkey = uuid.uuid4().hex[:8]\n\n# PostgreSQL rejects these values; the server answers 503, which clients retry.\npost(\"flow run parameters: NUL in a string\", \"/flow_runs/\", run % '\"parameters\": {\"x\": \"a\\\\u0000b\"}')\npost(\"flow run parameters: lone surrogate\", \"/flow_runs/\", run % '\"parameters\": {\"x\": \"\\\\ud800\"}')\npost(\"artifact data: NaN\", \"/artifacts/\", '{\"key\": \"a-%s\", \"type\": \"json\", \"data\": {\"x\": NaN}}' % key)\n\n# Validation fails, then the 422 body cannot be rendered.\npost(\"retries: \\\"abc\\\" (control)\", \"/flow_runs/\", run % '\"empirical_policy\": {\"retries\": \"abc\"}')\npost(\"retries: NaN\", \"/flow_runs/\", run % '\"empirical_policy\": {\"retries\": NaN}')\npost(\"variable value: lone surrogate\", \"/variables/\", '{\"name\": \"v_%s\", \"value\": \"\\\\ud800\"}' % key)\n```\n\nOutput (PostgreSQL 16):\n\n```\nflow run parameters: NUL in a string       -> 503 {\"exception_message\":\"Service Unavailabl\nflow run parameters: lone surrogate        -> 503 {\"exception_message\":\"Service Unavailabl\nartifact data: NaN                         -> 503 {\"exception_message\":\"Service Unavailabl\nretries: \"abc\" (control)                   -> 422 {\"exception_message\":\"Invalid request re\nretries: NaN                               -> 500 {\"exception_message\":\"Internal Server Er\nvariable value: lone surrogate             -> 500 {\"exception_message\":\"Internal Server Er\n```\n\nErrors:\n\n```\nasyncpg.exceptions.UntranslatableCharacterError: unsupported Unicode escape sequence\nasyncpg.exceptions.InvalidTextRepresentationError: invalid input syntax for type json\nDETAIL:  Unicode low surrogate must follow a high surrogate.\nasyncpg.exceptions.InvalidTextRepresentationError: invalid input syntax for type json\nDETAIL:  Token \"NaN\" is invalid.\nValueError: Out of range float values are not JSON compliant: nan\nUnicodeEncodeError: 'utf-8' codec can't encode character '\\ud800' in position 232: surrogates not allowed\n```\n\nExpected: 422 with a validation message. A 503 should mean the database is unavailable, not that the data is invalid.\n\n### Version info\n\n```Text\nVersion:              3.8.6\nAPI version:          0.8.4\nPython version:       3.12.13\nGit commit:           33de4078\nBuilt:                Mon, Sep 14, 2026 02:21 PM\nOS/Arch:              linux/x86_64\nProfile:              ephemeral\nServer type:          server\nPydantic version:     2.13.4\n```\n\nServer database: PostgreSQL 16.15. Same output on `main` (849df73).\n\n### Additional context\n\nRelated: #23197 (NUL bytes in events).\n\n", "hints_text": "", "created_at": "2026-10-27T03:29:06Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23617, "instance_id": "PrefectHQ__prefect-23617", "issue_numbers": ["23616"], "base_commit": "41d6d9c10c5f22c026a11d70b37ccdc41be4f614", "patch": "diff --git a/src/prefect/client/schemas/objects.py b/src/prefect/client/schemas/objects.py\nindex c6bdb1a6b849..7617e52d583f 100644\n--- a/src/prefect/client/schemas/objects.py\n+++ b/src/prefect/client/schemas/objects.py\n@@ -1,6 +1,7 @@\n from __future__ import annotations\n \n import datetime\n+import json\n import warnings\n from collections.abc import Callable, Mapping\n from enum import Enum\n@@ -17,7 +18,6 @@\n )\n from uuid import UUID\n \n-import orjson\n from pydantic import (\n     AfterValidator,\n     ConfigDict,\n@@ -1768,7 +1768,7 @@ def decoded_value(self) -> Any:\n         Returns:\n             Any: the decoded value\n         \"\"\"\n-        return orjson.loads(self.value)\n+        return json.loads(self.value)\n \n \n class GlobalConcurrencyLimit(ObjectBaseModel):\ndiff --git a/src/prefect/input/actions.py b/src/prefect/input/actions.py\nindex 6ffa47b23630..32f8978b634f 100644\n--- a/src/prefect/input/actions.py\n+++ b/src/prefect/input/actions.py\n@@ -1,3 +1,4 @@\n+import json\n from typing import TYPE_CHECKING, Any, Optional, Set\n from uuid import UUID\n \n@@ -236,7 +237,7 @@ async def aread_flow_run_input(\n             return None\n         raise\n     else:\n-        return orjson.loads(value)\n+        return json.loads(value)\n \n \n @async_dispatch(aread_flow_run_input)\n@@ -261,7 +262,7 @@ def read_flow_run_input(key: str, flow_run_id: Optional[UUID] = None) -> Any:\n                 return None\n             raise\n         else:\n-            return orjson.loads(value)\n+            return json.loads(value)\n \n \n @client_injector\ndiff --git a/src/prefect/server/api/flow_runs.py b/src/prefect/server/api/flow_runs.py\nindex ffa9093455e5..5bbc997381dd 100644\n--- a/src/prefect/server/api/flow_runs.py\n+++ b/src/prefect/server/api/flow_runs.py\n@@ -11,6 +11,7 @@\n from uuid import UUID\n \n import orjson\n+import pydantic_core\n import sqlalchemy as sa\n from docket import Depends as DocketDepends\n from docket import Docket, Retry\n@@ -565,7 +566,9 @@ async def resume_flow_run(\n                 flow_run_input=schemas.core.FlowRunInput(\n                     flow_run_id=flow_run_id,\n                     key=keyset[\"response\"],\n-                    value=orjson.dumps(run_input).decode(\"utf-8\"),\n+                    value=pydantic_core.to_json(run_input, inf_nan_mode=\"null\").decode(\n+                        \"utf-8\"\n+                    ),\n                 ),\n             )\n \n", "test_patch": "diff --git a/tests/input/test_run_input.py b/tests/input/test_run_input.py\nindex fd0eabadff3c..11956c794bf9 100644\n--- a/tests/input/test_run_input.py\n+++ b/tests/input/test_run_input.py\n@@ -5,7 +5,9 @@\n import pydantic\n import pytest\n \n+from prefect.client.orchestration import PrefectClient\n from prefect.client.schemas.objects import FlowRunInput\n+from prefect.client.schemas.responses import SetStateStatus\n from prefect.context import FlowRunContext\n from prefect.flows import flow\n from prefect.input import (\n@@ -22,6 +24,7 @@\n     run_input_subclass_from_type,\n     send_input,\n )\n+from prefect.server.database import orm_models\n from prefect.states import Paused, Running, Suspended\n \n \n@@ -206,6 +209,42 @@ async def test_load_from_flow_run_input(flow_run_context):\n     )\n \n \n+class Count(RunInput):\n+    count: int\n+\n+\n+async def test_load_after_resume_preserves_integer_beyond_64_bit_range(\n+    flow_run: orm_models.FlowRun, prefect_client: PrefectClient\n+):\n+    count = 2**64 + 1\n+    paused = Paused(pause_key=\"1\")\n+    keyset = keyset_from_paused_state(paused)\n+    paused.state_details.run_input_keyset = keyset\n+    await prefect_client.set_flow_run_state(flow_run.id, Running(), force=True)\n+    await prefect_client.set_flow_run_state(flow_run.id, paused, force=True)\n+    await Count.save(keyset, flow_run_id=flow_run.id)\n+\n+    result = await prefect_client.resume_flow_run(\n+        flow_run.id, run_input={\"count\": count}\n+    )\n+    assert result.status == SetStateStatus.ACCEPT\n+\n+    assert (await Count.load(keyset, flow_run_id=flow_run.id)).count == count\n+    assert read_flow_run_input(\n+        keyset[\"response\"], flow_run_id=flow_run.id, _sync=True\n+    ) == {\"count\": count}\n+\n+\n+def test_load_from_flow_run_input_preserves_integer_beyond_64_bit_range():\n+    flow_run_input = FlowRunInput(\n+        flow_run_id=uuid4(),\n+        key=\"count-response\",\n+        value=f'{{\"count\": {2**64 + 1}}}',\n+    )\n+\n+    assert Count.load_from_flow_run_input(flow_run_input).count == 2**64 + 1\n+\n+\n async def test_with_initial_data(flow_run_context):\n     keyset = keyset_from_base_key(\"bob\")\n \ndiff --git a/tests/server/orchestration/api/test_flow_runs.py b/tests/server/orchestration/api/test_flow_runs.py\nindex 0a5d78a88c3a..9668bbb583e9 100644\n--- a/tests/server/orchestration/api/test_flow_runs.py\n+++ b/tests/server/orchestration/api/test_flow_runs.py\n@@ -2,6 +2,7 @@\n \n import asyncio\n import datetime\n+import json\n import logging\n import shutil\n from typing import Any, AsyncGenerator, Generator, List, Optional\n@@ -1722,6 +1723,50 @@ async def test_resume_flow_run_waiting_for_input_valid_data(\n         assert flow_run_input\n         assert orjson.loads(flow_run_input.value) == {\"approved\": True}\n \n+    async def test_resume_flow_run_waiting_for_input_with_integer_beyond_64_bit_range(\n+        self,\n+        client: AsyncClient,\n+        session: AsyncSession,\n+        flow: Flow,\n+    ):\n+        class BigIntInput(RunInput):\n+            count: int\n+\n+        server_state = schemas.states.Paused(pause_key=\"1\")\n+        keyset = keyset_from_paused_state(Paused(pause_key=\"1\"))\n+        server_state.state_details.run_input_keyset = keyset\n+\n+        flow_run = await models.flow_runs.create_flow_run(\n+            session=session,\n+            flow_run=schemas.core.FlowRun(flow_id=flow.id, state=server_state),\n+        )\n+        await models.flow_run_input.create_flow_run_input(\n+            session=session,\n+            flow_run_input=schemas.core.FlowRunInput(\n+                flow_run_id=flow_run.id,\n+                key=keyset[\"schema\"],\n+                value=orjson.dumps(BigIntInput.model_json_schema()).decode(),\n+            ),\n+        )\n+        await session.commit()\n+\n+        response = await client.post(\n+            f\"/flow_runs/{flow_run.id}/resume\",\n+            json={\"run_input\": {\"count\": 2**64 + 1}},\n+        )\n+\n+        assert response.status_code == 201, response.text\n+        assert response.json()[\"status\"] == \"ACCEPT\"\n+\n+        flow_run_input = await models.flow_run_input.read_flow_run_input(\n+            session=session,\n+            flow_run_id=flow_run.id,\n+            key=keyset[\"response\"],\n+        )\n+\n+        assert flow_run_input\n+        assert json.loads(flow_run_input.value) == {\"count\": 2**64 + 1}\n+\n     async def test_resume_flow_run_waiting_for_input_with_json_hydrated_input(\n         self,\n         session,\n", "problem_statement": "`POST /flow_runs/{id}/resume` returns 500 when `run_input` contains an integer outside the 64-bit range\n### Bug summary\n\nResuming a paused flow run returns 500 when `run_input` contains an integer outside the 64-bit range. The run stays `PAUSED` and no input is stored. #23429 fixes the same error in the flow run list endpoints, but doesn't change this one.\n\n```python\nimport sys\nimport uuid\n\nimport httpx\n\napi = sys.argv[1] if len(sys.argv) > 1 else \"http://127.0.0.1:4200/api\"\nc = httpx.Client(base_url=api, limits=httpx.Limits(max_keepalive_connections=0))\nflow_id = c.post(\"/flows/\", json={\"name\": f\"repro-{uuid.uuid4().hex[:8]}\"}).json()[\"id\"]\nkeyset = {\"description\": \"d\", \"response\": \"resp\", \"schema\": \"sch\"}\n\nfor value in [\"1\", str(2**64)]:\n    run_id = c.post(\"/flow_runs/\", json={\"flow_id\": flow_id}).json()[\"id\"]\n    c.post(f\"/flow_runs/{run_id}/set_state\", json={\"state\": {\"type\": \"RUNNING\"}, \"force\": True})\n    c.post(\n        f\"/flow_runs/{run_id}/set_state\",\n        json={\n            \"state\": {\"type\": \"PAUSED\", \"state_details\": {\"pause_key\": \"p\", \"run_input_keyset\": keyset}},\n            \"force\": True,\n        },\n    )\n    c.post(f\"/flow_runs/{run_id}/input\", json={\"key\": \"sch\", \"value\": '{\"type\": \"object\"}'})\n    r = c.post(\n        f\"/flow_runs/{run_id}/resume\",\n        content=b'{\"run_input\": {\"x\": %s}}' % value.encode(),\n        headers={\"content-type\": \"application/json\"},\n    )\n    state = c.get(f\"/flow_runs/{run_id}\").json()[\"state\"][\"type\"]\n    print(f\"run_input x={value}: resume -> {r.status_code}; state after: {state}\")\n```\n\nOutput:\n\n```\nrun_input x=1: resume -> 201; state after: RUNNING\nrun_input x=18446744073709551616: resume -> 500; state after: PAUSED\n```\n\nServer error:\n\n```\n  File \"prefect/server/api/flow_runs.py\", line 569, in resume_flow_run\n    value=orjson.dumps(run_input).decode(\"utf-8\"),\n          ^^^^^^^^^^^^^^^^^^^^^^^\nTypeError: Integer exceeds 64-bit range\n```\n\nExpected: the run resumes and the input is stored, or the request gets a 422.\n\n### Version info\n\n```Text\nVersion:              3.8.6\nAPI version:          0.8.4\nPython version:       3.12.13\nGit commit:           33de4078\nBuilt:                Mon, Sep 14, 2026 02:21 PM\nOS/Arch:              linux/x86_64\nProfile:              ephemeral\nServer type:          server\nPydantic version:     2.13.4\nServer:\n  Database:           sqlite\n  SQLite version:     3.53.1\n```\n\n`main` has the same `orjson.dumps(run_input)` call (`src/prefect/server/api/flow_runs.py:568`).\n\n### Additional context\n\nRelated: #15031, #23429.\n\n", "hints_text": "", "created_at": "2026-10-27T03:20:43Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23604, "instance_id": "PrefectHQ__prefect-23604", "issue_numbers": ["23603"], "base_commit": "21a1f025480406046668edf22705234ce6b1c31f", "patch": "diff --git a/src/prefect/server/events/triggers.py b/src/prefect/server/events/triggers.py\nindex fdba65b8e274..48acb47cac2c 100644\n--- a/src/prefect/server/events/triggers.py\n+++ b/src/prefect/server/events/triggers.py\n@@ -1011,17 +1011,17 @@ async def read_bucket_by_trigger_id(\n ) -> \"ORMAutomationBucket | None\":\n     \"\"\"Gets the bucket this event would fall into for the given Automation, if there is\n     one currently\"\"\"\n-    query = sa.select(db.AutomationBucket).where(\n-        db.AutomationBucket.automation_id == automation_id,\n-        db.AutomationBucket.trigger_id == trigger_id,\n-        db.AutomationBucket.bucketing_key == bucketing_key,\n+    query = (\n+        sa.select(db.AutomationBucket)\n+        .where(\n+            db.AutomationBucket.automation_id == automation_id,\n+            db.AutomationBucket.trigger_id == trigger_id,\n+            db.AutomationBucket.bucketing_key == bucketing_key,\n+        )\n+        .execution_options(populate_existing=True)\n     )\n     result = await session.execute(query)\n-    bucket = result.scalars().first()\n-    if bucket:\n-        await session.refresh(bucket)\n-\n-    return bucket\n+    return result.scalars().first()\n \n \n async def hold_expect_event(\n", "test_patch": "diff --git a/tests/events/server/triggers/test_regressions.py b/tests/events/server/triggers/test_regressions.py\nindex 98a7d913b174..854d4d4143c9 100644\n--- a/tests/events/server/triggers/test_regressions.py\n+++ b/tests/events/server/triggers/test_regressions.py\n@@ -1,13 +1,15 @@\n import asyncio\n import random\n from datetime import timedelta\n-from typing import Callable, List, Union\n+from typing import Any, Callable, List, Union\n from unittest import mock\n from uuid import UUID, uuid4\n \n import pytest\n+import sqlalchemy as sa\n from sqlalchemy.ext.asyncio import AsyncSession\n \n+from prefect.server.database import PrefectDBInterface\n from prefect.server.events import actions, triggers\n from prefect.server.events.models import automations\n from prefect.server.events.schemas.automations import (\n@@ -1041,3 +1043,101 @@ async def test_concurrent_bucket_updates_count_each_event_once(\n     assert bucket\n     assert bucket.count == len(events)\n     act.assert_not_awaited()\n+\n+\n+@pytest.fixture\n+async def bucketed_automation(\n+    cleared_buckets: None,\n+    cleared_automations: None,\n+    automations_session: AsyncSession,\n+) -> Automation:\n+    automation = await automations.create_automation(\n+        automations_session,\n+        Automation(\n+            name=\"Counts events into a bucket\",\n+            trigger=EventTrigger(\n+                expect={\"counted-event\"},\n+                posture=Posture.Reactive,\n+                threshold=1000,\n+                within=timedelta(hours=1),\n+            ),\n+            actions=[actions.DoNothing()],\n+        ),\n+    )\n+    triggers.load_automation(automation)\n+    await automations_session.commit()\n+    return automation\n+\n+\n+async def test_read_bucket_tolerates_bucket_deleted_after_select(\n+    db: PrefectDBInterface,\n+    start_of_test: DateTime,\n+    bucketed_automation: Automation,\n+    automations_session: AsyncSession,\n+    monkeypatch: pytest.MonkeyPatch,\n+):\n+    \"\"\"Regression test for https://github.com/PrefectHQ/prefect/issues/23603, where a\n+    bucket deleted by a concurrent evaluation between reading it and refreshing it\n+    raised `InvalidRequestError: Could not refresh instance`.\"\"\"\n+    trigger = bucketed_automation.trigger\n+    assert isinstance(trigger, EventTrigger)\n+\n+    await triggers.start_new_bucket(\n+        automations_session,\n+        trigger,\n+        bucketing_key=(),\n+        start=start_of_test,\n+        end=start_of_test + timedelta(hours=1),\n+        count=0,\n+    )\n+    await automations_session.commit()\n+\n+    original_execute = automations_session.execute\n+    deleted = False\n+\n+    async def execute_then_delete_bucket(statement: Any, *args: Any, **kwargs: Any):\n+        nonlocal deleted\n+        result = await original_execute(statement, *args, **kwargs)\n+        if not deleted and isinstance(statement, sa.Select):\n+            deleted = True\n+            # Simulate another transaction deleting the bucket right after the read\n+            await original_execute(\n+                sa.delete(db.AutomationBucket)\n+                .where(db.AutomationBucket.trigger_id == trigger.id)\n+                .execution_options(synchronize_session=False)\n+            )\n+        return result\n+\n+    monkeypatch.setattr(automations_session, \"execute\", execute_then_delete_bucket)\n+\n+    bucket = await triggers.read_bucket(automations_session, trigger, ())\n+\n+    assert deleted\n+    assert bucket\n+    assert bucket.trigger_id == trigger.id\n+\n+\n+async def test_increment_bucket_returns_fresh_bucket_from_identity_map(\n+    start_of_test: DateTime,\n+    bucketed_automation: Automation,\n+    automations_session: AsyncSession,\n+):\n+    trigger = bucketed_automation.trigger\n+    assert isinstance(trigger, EventTrigger)\n+\n+    bucket = await triggers.start_new_bucket(\n+        automations_session,\n+        trigger,\n+        bucketing_key=(),\n+        start=start_of_test,\n+        end=start_of_test + timedelta(hours=1),\n+        count=1,\n+    )\n+    assert bucket.count == 1\n+\n+    incremented = await triggers.increment_bucket(\n+        automations_session, bucket, count=2, last_event=None\n+    )\n+\n+    assert incremented is bucket\n+    assert incremented.count == 3\n", "problem_statement": "Triggers service: `InvalidRequestError: Could not refresh instance '<AutomationBucket ...>'` in `read_bucket_by_trigger_id` (race between SELECT and refresh)\n### Bug summary\n\nThe triggers service intermittently logs `Failed in consume_loop` with:\n\n```\nsqlalchemy.exc.InvalidRequestError: Could not refresh instance '<AutomationBucket at 0x75b6da6d3a30>'\n```\n\n`read_bucket_by_trigger_id` SELECTs the bucket and then calls `await session.refresh(bucket)`. If the row is deleted or replaced by another coroutine between those two statements, `refresh` loads nothing and SQLAlchemy raises. The memory broker catches it and retries the message, so nothing crashes, but every occurrence logs a full ERROR traceback and the event goes through reactive evaluation again.\n\nFrequency on our server: 23 occurrences in 96 h. They are isolated (1 to 6 h apart, no bursts) and often fall on :10 / :30 minute marks, which match our scheduled deployment chains.\n\n### Traceback\n\n```\nprefect/server/utilities/messaging/memory.py:375 _consume_loop -> await handler(message)\nprefect/server/events/triggers.py:1293 message_handler -> await reactive_evaluation(event)\nprefect/server/events/triggers.py:658 reactive_evaluation -> bucket = await read_bucket(session, trigger, bucketing_key)\nprefect/server/events/triggers.py:949 read_bucket -> return await read_bucket_by_trigger_id(\nprefect/server/events/triggers.py:975 read_bucket_by_trigger_id -> await session.refresh(bucket)\nsqlalchemy/ext/asyncio/session.py:329 refresh\nsqlalchemy/orm/session.py:3170 refresh -> raise sa_exc.InvalidRequestError(\nsqlalchemy.exc.InvalidRequestError: Could not refresh instance '<AutomationBucket at 0x75b6da6d3a30>'\n```\n\nThe same `session.refresh(bucket)` call is still present in 3.9.0 (`triggers.py:1016`) and on `main`. #23445 (3.9.0) adds advisory locks for proactive triggers with `after`, and #23471 (3.9.1) only affects SQLite, so neither seems to cover this path on Postgres.\n\n### Setup\n\n- Single `prefect server start` process. Services run in-process, with the in-memory messaging broker.\n- PostgreSQL 14 on RDS, `asyncpg`, connecting directly with no pgbouncer.\n- 87 automations:\n  - 86 reactive automations (`run-deployment` on `prefect.flow-run.Completed`, `within: 0`, threshold 1).\n  - 1 proactive automation: threshold 1, `within: 120`, `after: [Running, heartbeat]`, `for_each: prefect.resource.id`, action `change-flow-run-state`. This is the zombie-run detector from the docs.\n\n### Possible fix\n\nTreat a vanished row as \"no bucket\": catch `InvalidRequestError` / `ObjectDeletedError` around the refresh and return `None`. Alternatively, drop the separate refresh and use `.execution_options(populate_existing=True)` on the SELECT, so there is no window between the two statements.\n\n### Version info\n\n```\nVersion:             3.8.8\nAPI version:         0.8.4\nPython version:      3.10.22\nPydantic version:    2.13.4\nSQLAlchemy:          2.0.45\nasyncpg:             0.31.0\nServer type:         server (self-hosted, Docker)\nDatabase:            postgresql 14.22\n```\n\n", "hints_text": "", "created_at": "2026-10-26T16:53:02Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23557, "instance_id": "PrefectHQ__prefect-23557", "issue_numbers": ["20237"], "base_commit": "213a369488c4983e8c4e7256b6eb4b62ac5540d4", "patch": "diff --git a/docs/v3/how-to-guides/deployment_infra/serverless.mdx b/docs/v3/how-to-guides/deployment_infra/serverless.mdx\nindex c5c531dd3442..b339304fd5f6 100644\n--- a/docs/v3/how-to-guides/deployment_infra/serverless.mdx\n+++ b/docs/v3/how-to-guides/deployment_infra/serverless.mdx\n@@ -74,6 +74,8 @@ To use automatic infrastructure provisioning, you need:\n     - iam:CreateRole\n     - iam:GetRole\n     - iam:AttachRolePolicy\n+    - iam:GetRolePolicy\n+    - iam:PutRolePolicy\n     - iam:ListRoles\n     - iam:PassRole\n \ndiff --git a/src/prefect/infrastructure/provisioners/ecs.py b/src/prefect/infrastructure/provisioners/ecs.py\nindex 2f63a237bb23..5fd120c1dfc1 100644\n--- a/src/prefect/infrastructure/provisioners/ecs.py\n+++ b/src/prefect/infrastructure/provisioners/ecs.py\n@@ -1005,7 +1005,25 @@ def __init__(self, execution_role_name: str = \"PrefectEcsTaskExecutionRole\"):\n                 ],\n             }\n         )\n-        self._requires_provisioning = None\n+        # `AmazonECSTaskExecutionRolePolicy` allows creating log streams and\n+        # putting log events, but not creating the log group that the ECS worker\n+        # asks for with `awslogs-create-group` when CloudWatch logs are enabled.\n+        self._logs_policy_name = \"PrefectEcsTaskExecutionRoleLogsPolicy\"\n+        self._logs_policy_document = json.dumps(\n+            {\n+                \"Version\": \"2012-10-17\",\n+                \"Statement\": [\n+                    {\n+                        \"Sid\": \"AllowCreateLogGroup\",\n+                        \"Effect\": \"Allow\",\n+                        \"Action\": \"logs:CreateLogGroup\",\n+                        \"Resource\": \"*\",\n+                    }\n+                ],\n+            }\n+        )\n+        self._requires_role_provisioning = None\n+        self._requires_logs_policy_provisioning = None\n \n     async def get_task_count(self) -> int:\n         \"\"\"\n@@ -1014,27 +1032,58 @@ async def get_task_count(self) -> int:\n         Returns:\n             int: The number of tasks to be provisioned.\n         \"\"\"\n-        return 1 if await self.requires_provisioning() else 0\n-\n-    async def requires_provisioning(self) -> bool:\n-        \"\"\"\n-        Check if this resource requires provisioning.\n+        role_count = 1 if await self._role_requires_provisioning() else 0\n+        logs_policy_count = 1 if await self._logs_policy_requires_provisioning() else 0\n+        return role_count + logs_policy_count\n \n-        Returns:\n-            bool: True if provisioning is required, False otherwise.\n-        \"\"\"\n-        if self._requires_provisioning is None:\n+    async def _role_requires_provisioning(self) -> bool:\n+        if self._requires_role_provisioning is None:\n             try:\n                 await anyio.to_thread.run_sync(\n                     partial(\n                         self._iam_client.get_role, RoleName=self._execution_role_name\n                     )\n                 )\n-                self._requires_provisioning = False\n+                self._requires_role_provisioning = False\n             except self._iam_client.exceptions.NoSuchEntityException:\n-                self._requires_provisioning = True\n+                self._requires_role_provisioning = True\n \n-        return self._requires_provisioning\n+        return self._requires_role_provisioning\n+\n+    async def _logs_policy_requires_provisioning(self) -> bool:\n+        \"\"\"\n+        Checked separately from role creation so that roles provisioned before\n+        the logs policy existed get it when provisioning is run again.\n+        \"\"\"\n+        if self._requires_logs_policy_provisioning is None:\n+            if await self._role_requires_provisioning():\n+                self._requires_logs_policy_provisioning = True\n+            else:\n+                try:\n+                    await anyio.to_thread.run_sync(\n+                        partial(\n+                            self._iam_client.get_role_policy,\n+                            RoleName=self._execution_role_name,\n+                            PolicyName=self._logs_policy_name,\n+                        )\n+                    )\n+                    self._requires_logs_policy_provisioning = False\n+                except self._iam_client.exceptions.NoSuchEntityException:\n+                    self._requires_logs_policy_provisioning = True\n+\n+        return self._requires_logs_policy_provisioning\n+\n+    async def requires_provisioning(self) -> bool:\n+        \"\"\"\n+        Check if this resource requires provisioning.\n+\n+        Returns:\n+            bool: True if provisioning is required, False otherwise.\n+        \"\"\"\n+        return (\n+            await self._role_requires_provisioning()\n+            or await self._logs_policy_requires_provisioning()\n+        )\n \n     async def get_planned_actions(self) -> List[str]:\n         \"\"\"\n@@ -1044,12 +1093,18 @@ async def get_planned_actions(self) -> List[str]:\n             Optional[str]: A description of the planned actions for provisioning the resource,\n                 or None if provisioning is not required.\n         \"\"\"\n-        if await self.requires_provisioning():\n-            return [\n+        actions: list[str] = []\n+        if await self._role_requires_provisioning():\n+            actions.append(\n                 \"Creating an IAM role assigned to ECS tasks:\"\n                 f\" [blue]{self._execution_role_name}[/]\"\n-            ]\n-        return []\n+            )\n+        if await self._logs_policy_requires_provisioning():\n+            actions.append(\n+                \"Allowing the ECS task execution role to create CloudWatch log\"\n+                f\" groups: [blue]{self._logs_policy_name}[/]\"\n+            )\n+        return actions\n \n     async def provision(\n         self,\n@@ -1064,8 +1119,8 @@ async def provision(\n                 infrastructure for.\n             advance: A callback function to indicate progress.\n         \"\"\"\n-        if await self.requires_provisioning():\n-            console = current_console.get()\n+        console = current_console.get()\n+        if await self._role_requires_provisioning():\n             console.print(\"Provisioning execution role\")\n             response = await anyio.to_thread.run_sync(\n                 partial(\n@@ -1088,6 +1143,18 @@ async def provision(\n                 partial(self._iam_client.get_role, RoleName=self._execution_role_name)\n             )\n \n+        if await self._logs_policy_requires_provisioning():\n+            console.print(\"Adding CloudWatch logs policy to execution role\")\n+            await anyio.to_thread.run_sync(\n+                partial(\n+                    self._iam_client.put_role_policy,\n+                    RoleName=self._execution_role_name,\n+                    PolicyName=self._logs_policy_name,\n+                    PolicyDocument=self._logs_policy_document,\n+                )\n+            )\n+            advance()\n+\n         base_job_template[\"variables\"][\"properties\"][\"execution_role_arn\"][\n             \"default\"\n         ] = response[\"Role\"][\"Arn\"]\n", "test_patch": "diff --git a/tests/infrastructure/provisioners/test_ecs.py b/tests/infrastructure/provisioners/test_ecs.py\nindex 81e559999763..7a896e743b21 100644\n--- a/tests/infrastructure/provisioners/test_ecs.py\n+++ b/tests/infrastructure/provisioners/test_ecs.py\n@@ -178,7 +178,8 @@ def existing_iam_user():\n \n \n @pytest.fixture\n-def existing_execution_role():\n+def existing_execution_role_without_logs_policy():\n+    \"\"\"An execution role created before the provisioner added the logs policy.\"\"\"\n     iam_client = boto3.client(\"iam\")\n     iam_client.create_role(\n         RoleName=\"PrefectEcsTaskExecutionRole\",\n@@ -199,9 +200,38 @@ def existing_execution_role():\n \n     yield\n \n+    for policy_name in iam_client.list_role_policies(\n+        RoleName=\"PrefectEcsTaskExecutionRole\"\n+    )[\"PolicyNames\"]:\n+        iam_client.delete_role_policy(\n+            RoleName=\"PrefectEcsTaskExecutionRole\", PolicyName=policy_name\n+        )\n     iam_client.delete_role(RoleName=\"PrefectEcsTaskExecutionRole\")\n \n \n+@pytest.fixture\n+def existing_execution_role(existing_execution_role_without_logs_policy):\n+    iam_client = boto3.client(\"iam\")\n+    iam_client.put_role_policy(\n+        RoleName=\"PrefectEcsTaskExecutionRole\",\n+        PolicyName=\"PrefectEcsTaskExecutionRoleLogsPolicy\",\n+        PolicyDocument=json.dumps(\n+            {\n+                \"Version\": \"2012-10-17\",\n+                \"Statement\": [\n+                    {\n+                        \"Effect\": \"Allow\",\n+                        \"Action\": \"logs:CreateLogGroup\",\n+                        \"Resource\": \"*\",\n+                    }\n+                ],\n+            }\n+        ),\n+    )\n+\n+    yield\n+\n+\n class TestIamUserResource:\n     async def test_requires_provisioning_no_user(self, iam_user_resource):\n         needs_provisioning = await iam_user_resource.requires_provisioning()\n@@ -431,7 +461,7 @@ async def test_needs_provisioning_existing_resources(self, authentication_resour\n     async def test_get_task_count(self, authentication_resource):\n         count = await authentication_resource.get_task_count()\n \n-        assert count == 5\n+        assert count == 6\n \n     async def test_get_planned_actions(self, authentication_resource):\n         actions = await authentication_resource.get_planned_actions()\n@@ -455,6 +485,10 @@ async def test_get_planned_actions_existing_user(self, authentication_resource):\n                 \"Creating an IAM role assigned to ECS tasks:\"\n                 \" [blue]PrefectEcsTaskExecutionRole[/]\"\n             ),\n+            (\n+                \"Allowing the ECS task execution role to create CloudWatch log\"\n+                \" groups: [blue]PrefectEcsTaskExecutionRoleLogsPolicy[/]\"\n+            ),\n             \"Storing generated AWS credentials in a block\",\n         ]\n \n@@ -483,7 +517,7 @@ async def test_provision(self, authentication_resource, prefect_client):\n             \"default\": {\"$ref\": {\"block_document_id\": str(block_document.id)}},\n         }\n \n-        assert advance_mock.call_count == 5\n+        assert advance_mock.call_count == 6\n \n \n @pytest.fixture\n@@ -1160,6 +1194,14 @@ class TestExecutionRoleResource:\n     async def test_get_task_count_requires_provisioning(self, execution_role_resource):\n         count = await execution_role_resource.get_task_count()\n \n+        assert count == 2\n+\n+    @pytest.mark.usefixtures(\"existing_execution_role_without_logs_policy\")\n+    async def test_get_task_count_existing_role_without_logs_policy(\n+        self, execution_role_resource\n+    ):\n+        count = await execution_role_resource.get_task_count()\n+\n         assert count == 1\n \n     @pytest.mark.usefixtures(\"existing_execution_role\")\n@@ -1181,6 +1223,14 @@ async def test_requires_provisioning_false(self, execution_role_resource):\n \n         assert requires_provisioning is False\n \n+    @pytest.mark.usefixtures(\"existing_execution_role_without_logs_policy\")\n+    async def test_requires_provisioning_existing_role_without_logs_policy(\n+        self, execution_role_resource\n+    ):\n+        requires_provisioning = await execution_role_resource.requires_provisioning()\n+\n+        assert requires_provisioning is True\n+\n     async def test_get_planned_actions_requires_provisioning(\n         self, execution_role_resource\n     ):\n@@ -1188,7 +1238,20 @@ async def test_get_planned_actions_requires_provisioning(\n \n         assert actions == [\n             \"Creating an IAM role assigned to ECS tasks:\"\n-            \" [blue]PrefectEcsTaskExecutionRole[/]\"\n+            \" [blue]PrefectEcsTaskExecutionRole[/]\",\n+            \"Allowing the ECS task execution role to create CloudWatch log\"\n+            \" groups: [blue]PrefectEcsTaskExecutionRoleLogsPolicy[/]\",\n+        ]\n+\n+    @pytest.mark.usefixtures(\"existing_execution_role_without_logs_policy\")\n+    async def test_get_planned_actions_existing_role_without_logs_policy(\n+        self, execution_role_resource\n+    ):\n+        actions = await execution_role_resource.get_planned_actions()\n+\n+        assert actions == [\n+            \"Allowing the ECS task execution role to create CloudWatch log\"\n+            \" groups: [blue]PrefectEcsTaskExecutionRoleLogsPolicy[/]\",\n         ]\n \n     @pytest.mark.usefixtures(\"existing_execution_role\")\n@@ -1214,8 +1277,52 @@ async def test_provision_requires_provisioning(self, execution_role_resource):\n             advance=advance_mock,\n         )\n \n+        assert arn == \"arn:aws:iam::123456789012:role/PrefectEcsTaskExecutionRole\"\n+        assert advance_mock.call_count == 2\n+        iam_client = boto3.client(\"iam\")\n+        attached_policies = iam_client.list_attached_role_policies(\n+            RoleName=\"PrefectEcsTaskExecutionRole\"\n+        )[\"AttachedPolicies\"]\n+        assert [policy[\"PolicyName\"] for policy in attached_policies] == [\n+            \"AmazonECSTaskExecutionRolePolicy\"\n+        ]\n+        logs_policy = iam_client.get_role_policy(\n+            RoleName=\"PrefectEcsTaskExecutionRole\",\n+            PolicyName=\"PrefectEcsTaskExecutionRoleLogsPolicy\",\n+        )[\"PolicyDocument\"]\n+        assert logs_policy[\"Statement\"] == [\n+            {\n+                \"Sid\": \"AllowCreateLogGroup\",\n+                \"Effect\": \"Allow\",\n+                \"Action\": \"logs:CreateLogGroup\",\n+                \"Resource\": \"*\",\n+            }\n+        ]\n+\n+    @pytest.mark.usefixtures(\"existing_execution_role_without_logs_policy\")\n+    async def test_provision_adds_logs_policy_to_existing_role(\n+        self, execution_role_resource\n+    ):\n+        advance_mock = MagicMock()\n+\n+        arn = await execution_role_resource.provision(\n+            base_job_template={\n+                \"variables\": {\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"execution_role_arn\": {},\n+                    },\n+                }\n+            },\n+            advance=advance_mock,\n+        )\n+\n         assert arn == \"arn:aws:iam::123456789012:role/PrefectEcsTaskExecutionRole\"\n         advance_mock.assert_called_once()\n+        iam_client = boto3.client(\"iam\")\n+        assert iam_client.list_role_policies(RoleName=\"PrefectEcsTaskExecutionRole\")[\n+            \"PolicyNames\"\n+        ] == [\"PrefectEcsTaskExecutionRoleLogsPolicy\"]\n \n     @pytest.mark.usefixtures(\"existing_execution_role\")\n     async def test_provision_does_not_require_provisioning(\n", "problem_statement": "AWS `prefect work-pool create --provision-infra` doesn't add cloudwatch permissions to assumed role\n### Bug summary\n\nI use `prefect work-pool create --type ecs:push --overwrite --provision-infra ecs-push-pool` to provision items in my AWS account for running an ECS Push work pool.\n\nIn prefect cloud I edited the work pool to enable CloudWatch logging.\n\nAfter submitting the flow, I get an error in AWS when trying to start the task (the same error is also returned to prefect cloud)\n\n> Flow run could not be submitted to infrastructure: TaskFailedToStart - ResourceInitializationError: failed to validate logger args: create stream has been retried 1 times: failed to create Cloudwatch log group: operation error CloudWatch Logs: CreateLogGroup, https response error StatusCode: 400, RequestID: c8e093f6-7267-4fe9-b8a0-2a35dc60d982, api error AccessDeniedException: User: arn:aws:sts::xxxx:assumed-role/PrefectEcsTaskExecutionRole/7a29b7fb28d7464198e5a95d259867b5 is not authorized to perform: logs:CreateLogGroup on resource: arn:aws:logs:us-east-2:xxxx:log-group:prefect:log-stream: because no identity-based policy allows the logs:CreateLogGroup action : exit status 1\n\nI see that the `prefect-ecs-user` user which was created does have access to some `logs:` permissions via the `prefect-ecs-policy` policy.\n\nHowever the `PrefectEcsTaskExecutionRole` role only has `AmazonECSTaskExecutionRolePolicy` attached to it. If I edit the role and add `logs:*` (or a more limited set of permissions) then it works fine.\n\nI'm not sure the best way to surface this in the setup script. It could be via an additional flag `--enable-logs` which adds the permissions to the Role and also enables the setting in the work pool. However with this option then you'd need to work out the behaviour when the user turns off this setting (remove permissions from the role?) or turns it on without having used the flag (you'd need to add them but don't have access to a key/secret with enough permissions to add it).\n\nPerhaps since the user already has these permissions it's OK to add them directly to the Role as well.\n\n### Version info\n\n```Text\nVersion:              3.6.6\nAPI version:          0.8.4\nPython version:       3.13.11\nGit commit:           f7d4baf4\nBuilt:                Thu, Dec 11, 2025 08:20 PM\nOS/Arch:              darwin/arm64\nProfile:              ephemeral\nServer type:          cloud\nPydantic version:     2.12.5\nServer:\n  Database:           sqlite\n  SQLite version:     3.51.1\nIntegrations:\n  prefect-aws:        0.7.2\n  prefect-slack:      0.3.1\n  prefect-github:     0.3.2\n```\n\n### Additional context\n\n_No response_\n", "hints_text": " I pushed a fix for this.\n\n  The ECS provisioner now attaches CloudWatch Logs permissions to the execution role during provisioning, in addition to\n  the existing ECS task execution policy. I also added a regression test covering the expected role policy set.\n\n  The focused ECS tests passed locally: `15 passed, 66 deselected`", "created_at": "2026-10-24T15:01:00Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23537, "instance_id": "PrefectHQ__prefect-23537", "issue_numbers": ["23536"], "base_commit": "43cb1704124ab6b5a4accbed0a680c2118517f02", "patch": "diff --git a/pyproject.toml b/pyproject.toml\nindex 711f7b9c6dec..e588766bfebb 100644\n--- a/pyproject.toml\n+++ b/pyproject.toml\n@@ -228,18 +228,20 @@ source = \"versioningit\"\n \n [tool.versioningit]\n # This fallback is used in git-less environments (e.g. archive builds).\n-# It must stay above the highest prefect>= floor declared by in-repo integrations\n-# (currently >=3.6.22 in prefect-aws / prefect-kubernetes) so that uv lock can\n-# resolve integration dependencies against the local package.\n-default-version = \"3.6.24+nogit\"\n+# It must stay at or above the highest prefect>= floor declared by in-repo\n+# integrations (currently >=3.8.4) so that\n+# uv lock can resolve the latest integration releases against the local package.\n+default-version = \"3.9.0+nogit\"\n \n [tool.versioningit.vcs]\n match = [\"[0-9]*.[0-9]*.[0-9]*\", \"[0-9]*.[0-9]*.[0-9]*.dev[0-9]*\"]\n # Dependabot clones with `--no-tags --depth 1`, so .git exists but\n # `git describe` finds no tags.  versioningit then uses default-tag as the\n-# base version.  Keep this above the highest in-repo prefect>= floor\n-# (currently >=3.6.22) so the local wheel satisfies integration constraints.\n-default-tag = \"3.6.24\"\n+# base version.  Keep this at or above the highest in-repo prefect>= floor\n+# (currently >=3.8.4) so the local wheel satisfies integration constraints.\n+# Otherwise, lock updates from these clones silently pin integrations to old\n+# releases, and the Docker image (which installs from uv.lock) ships them.\n+default-tag = \"3.9.0\"\n \n [tool.versioningit.write]\n method = { module = \"write_build_info\", value = \"write_build_info\", module-dir = \"tools\" }\ndiff --git a/uv.lock b/uv.lock\nindex 7b417ba00049..2cf7c057fc3d 100644\n--- a/uv.lock\n+++ b/uv.lock\n@@ -4638,7 +4638,7 @@ wheels = [\n \n [[package]]\n name = \"prefect-kubernetes\"\n-version = \"0.7.6\"\n+version = \"0.8.0\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"exceptiongroup\" },\n@@ -4649,9 +4649,9 @@ dependencies = [\n     { name = \"python-json-logger\" },\n     { name = \"tenacity\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/08/10/11655017500d3c9e8251482d251efd40f776e8b98be091de8965cc2c6f58/prefect_kubernetes-0.7.6.tar.gz\", hash = \"sha256:3e657748d8941efdc478acbb3f843ff2b4ef58adf9ab3801221a041d64efd4d8\", size = 94694, upload-time = \"2026-03-19T18:55:44.383Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/7b/9d/d24eb785edd096b50deedb8c1f3491b0f221f93db194d7c48561d4e78a57/prefect_kubernetes-0.8.0.tar.gz\", hash = \"sha256:24f94881f54ba656cd48f72411a3c2dd355a376ddd60f3a42f49b6033c58b1f0\", size = 119234, upload-time = \"2026-10-19T19:36:27.557Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/82/c1/c84b4ccdec4f2da91ed686086e5c46bd4bed3e4463d69682a205faed6589/prefect_kubernetes-0.7.6-py3-none-any.whl\", hash = \"sha256:047407f59f997831eb8eb9155a4b19c94239b9f36279d221cf7198ca364aa7e5\", size = 49220, upload-time = \"2026-03-19T18:55:43.084Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/1b/ff/17a3c6cd43f4e788ce3ce7dc9408d51af3bff3471c42f8954e6e84f05663/prefect_kubernetes-0.8.0-py3-none-any.whl\", hash = \"sha256:9c545503f0f1b4ff4228b50308abce749022706eaf461193adad27d920fd17fd\", size = 58988, upload-time = \"2026-10-19T19:36:26.268Z\" },\n ]\n \n [[package]]\n@@ -4669,15 +4669,15 @@ wheels = [\n \n [[package]]\n name = \"prefect-redis\"\n-version = \"0.2.11\"\n+version = \"0.3.0\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"prefect\" },\n     { name = \"redis\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/69/48/18202d60ec4a093178cc76fe4a227ec6827ef1f112eb241a480ff3a1e0a7/prefect_redis-0.2.11.tar.gz\", hash = \"sha256:fa1b4ce79ea07fa3e87b4ee403070698e22de67e838e6327c74015319de13fd2\", size = 45304, upload-time = \"2026-04-24T18:36:02.832Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/3c/58/d23ac6b0023406f637aea0f2c65faa16914d23fe496305d673e5fe980bf7/prefect_redis-0.3.0.tar.gz\", hash = \"sha256:724a65bb2ceed9a0eb9ad6af129e66e5427f0c4b364282f7ee5c9bacf8638549\", size = 74363, upload-time = \"2026-10-07T17:38:52.088Z\" }\n wheels = [\n-    { url = \"https://files.pythonhosted.org/packages/fe/64/c2f2dddcce4b9a0889edd32ca0a3b886e53a68ab0e3258b0ddeb6b2a5b95/prefect_redis-0.2.11-py3-none-any.whl\", hash = \"sha256:dfb5be0ceb3c021a75f81b02471bc6f06147dcc7de602d5e82569c48d67666db\", size = 28851, upload-time = \"2026-04-24T18:36:01.288Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/d8/82/0635d455c00ed4cfd4d730555feedc3552786c5c2741fe2ae2d2c103a4dc/prefect_redis-0.3.0-py3-none-any.whl\", hash = \"sha256:d1ca0865a37f1c90a83d7c04127609c683c0f794d83ed491c5d0f33128dc1e42\", size = 44819, upload-time = \"2026-10-07T17:38:50.683Z\" },\n ]\n \n [[package]]\n", "test_patch": "diff --git a/tests/_internal/test_integrations.py b/tests/_internal/test_integrations.py\nindex d11f37dc55c4..f3e45719c31b 100644\n--- a/tests/_internal/test_integrations.py\n+++ b/tests/_internal/test_integrations.py\n@@ -1,4 +1,6 @@\n import toml\n+from packaging.requirements import Requirement\n+from packaging.version import Version\n \n import prefect\n from prefect._internal.integrations import KNOWN_EXTRAS_FOR_PACKAGES\n@@ -16,3 +18,34 @@ def test_known_extras_for_packages():\n         assert extra_name in extras_require, (\n             f\"Extra '{extra_name}' for package '{package}' not found in setup.py\"\n         )\n+\n+\n+def test_versioningit_fallbacks_satisfy_integration_prefect_floors():\n+    \"\"\"\n+    Lock updates run from clones without tags resolve integrations against the\n+    versioningit fallback version. If that version is below an integration's\n+    `prefect` floor, `uv lock` silently keeps an older integration release,\n+    which the Docker image then ships.\n+    \"\"\"\n+    base_path = prefect.__development_base_path__\n+    versioningit = toml.load(base_path / \"pyproject.toml\")[\"tool\"][\"versioningit\"]\n+    fallback_versions = [\n+        Version(versioningit[\"default-version\"]),\n+        Version(versioningit[\"vcs\"][\"default-tag\"]),\n+    ]\n+\n+    integration_pyprojects = sorted(\n+        (base_path / \"src\" / \"integrations\").glob(\"*/pyproject.toml\")\n+    )\n+    assert integration_pyprojects\n+\n+    for pyproject_path in integration_pyprojects:\n+        dependencies = toml.load(pyproject_path)[\"project\"][\"dependencies\"]\n+        for requirement in map(Requirement, dependencies):\n+            if requirement.name != \"prefect\":\n+                continue\n+            for version in fallback_versions:\n+                assert requirement.specifier.contains(version, prereleases=True), (\n+                    f\"versioningit fallback {version} in pyproject.toml does not \"\n+                    f\"satisfy {requirement} from {pyproject_path.parent.name}\"\n+                )\n", "problem_statement": "Docker images since 3.8.8 ship older prefect-redis and prefect-kubernetes\nSince #23225, the image installs integration versions from `uv.lock`, which pins old releases. Upgrading the image from 3.8.7 to 3.8.8 or later downgrades both integrations:\n\n| Package | 3.8.7 image | 3.8.8 and 3.9.0 images | Latest on PyPI |\n|---|---|---|---|\n| prefect-redis | 0.2.15 | 0.2.11 | 0.3.0 |\n| prefect-kubernetes | 0.7.13 | 0.7.6 | 0.8.0 |\n\n```bash\ndocker run --rm prefecthq/prefect:3.9.0-python3.14-kubernetes pip list | grep -E \"^prefect-(redis|kubernetes)\"\n```\n\n**Example of what breaks:** `prefect_redis.cleanup_queue` was added in prefect-redis 0.2.12 (#22109). A server set to `PREFECT_SERVER_WORKER_CHANNEL_CLEANUP_QUEUE_STORAGE=prefect_redis.cleanup_queue` fails with `ModuleNotFoundError` on these images.\n\n", "hints_text": "", "created_at": "2026-10-23T14:30:05Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23535, "instance_id": "PrefectHQ__prefect-23535", "issue_numbers": ["23534"], "base_commit": "a0cb644eb9c937b5e78c957ea06c39d4f5c59093", "patch": "diff --git a/src/prefect/flow_engine.py b/src/prefect/flow_engine.py\nindex c7993ffa537c..a6803a902ef9 100644\n--- a/src/prefect/flow_engine.py\n+++ b/src/prefect/flow_engine.py\n@@ -811,7 +811,16 @@ def handle_success(self, result: R) -> R:\n         )\n         raise_if_flow_run_suspension_requested()\n         self._return_value = resolved_result\n-        self.set_state(terminal_state)\n+        state = self.set_state(terminal_state)\n+        if terminal_state.is_failed() and state.is_scheduled():\n+            self.logger.info(\n+                f\"Received non-final state {state.name!r} when proposing final\"\n+                f\" state {terminal_state.name!r} and will attempt to run again...\"\n+            )\n+            raise_if_flow_run_suspension_requested()\n+            self._return_value = NotSet\n+            self.set_state(Running())\n+            return result\n \n         link_state_to_flow_run_result(terminal_state, resolved_result)\n         self._telemetry.end_span_on_success()\n@@ -1534,7 +1543,16 @@ async def handle_success(self, result: R) -> R:\n         )\n         raise_if_flow_run_suspension_requested()\n         self._return_value = resolved_result\n-        await self.set_state(terminal_state)\n+        state = await self.set_state(terminal_state)\n+        if terminal_state.is_failed() and state.is_scheduled():\n+            self.logger.info(\n+                f\"Received non-final state {state.name!r} when proposing final\"\n+                f\" state {terminal_state.name!r} and will attempt to run again...\"\n+            )\n+            raise_if_flow_run_suspension_requested()\n+            self._return_value = NotSet\n+            await self.set_state(Running())\n+            return result\n \n         self._telemetry.end_span_on_success()\n \n", "test_patch": "diff --git a/tests/test_flows.py b/tests/test_flows.py\nindex b33662f85f83..9627f7a65722 100644\n--- a/tests/test_flows.py\n+++ b/tests/test_flows.py\n@@ -73,10 +73,13 @@\n     temporary_settings,\n )\n from prefect.states import (\n+    AwaitingRetry,\n     Cancelled,\n     Cancelling,\n+    Failed,\n     Paused,\n     PausedRun,\n+    Scheduled,\n     State,\n     StateType,\n     raise_state_exception,\n@@ -2320,6 +2323,132 @@ def foo():\n         assert foo() == \"hello\"\n         assert run_count == 2\n \n+    def test_flow_retry_with_returned_failed_state(self):\n+        run_count = 0\n+\n+        @flow(retries=1)\n+        def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            return [Failed(message=\"boom\")]\n+\n+        state = foo(return_state=True)\n+        assert state.is_failed()\n+        assert run_count == 2\n+\n+    async def test_async_flow_retry_with_returned_failed_state(self):\n+        run_count = 0\n+\n+        @flow(retries=1)\n+        async def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            return Failed(message=\"boom\")\n+\n+        state = await foo(return_state=True)\n+        assert state.is_failed()\n+        assert run_count == 2\n+\n+    @pytest.mark.parametrize(\"returned_state\", [Scheduled, AwaitingRetry])\n+    @pytest.mark.parametrize(\"retries\", [0, 1])\n+    def test_flow_returning_scheduled_state_is_not_retried(\n+        self, returned_state, retries\n+    ):\n+        run_count = 0\n+\n+        @flow(retries=retries)\n+        def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            return returned_state()\n+\n+        state = foo(return_state=True)\n+        assert state.is_scheduled()\n+        assert run_count == 1\n+\n+    @pytest.mark.parametrize(\"returned_state\", [Scheduled, AwaitingRetry])\n+    @pytest.mark.parametrize(\"retries\", [0, 1])\n+    async def test_async_flow_returning_scheduled_state_is_not_retried(\n+        self, returned_state, retries\n+    ):\n+        run_count = 0\n+\n+        @flow(retries=retries)\n+        async def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            return returned_state()\n+\n+        state = await foo(return_state=True)\n+        assert state.is_scheduled()\n+        assert run_count == 1\n+\n+    def test_flow_retry_with_returned_failed_state_then_success(self):\n+        run_count = 0\n+\n+        @flow(retries=1)\n+        def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            if run_count == 1:\n+                return Failed(message=\"boom\")\n+            return \"hello\"\n+\n+        assert foo() == \"hello\"\n+        assert run_count == 2\n+\n+    async def test_async_flow_retry_with_returned_failed_state_then_success(self):\n+        run_count = 0\n+\n+        @flow(retries=1)\n+        async def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            if run_count == 1:\n+                return Failed(message=\"boom\")\n+            return \"hello\"\n+\n+        assert await foo() == \"hello\"\n+        assert run_count == 2\n+\n+    def test_flow_retry_with_returned_failed_state_then_error(self):\n+        run_count = 0\n+\n+        @flow(retries=1)\n+        def foo():\n+            nonlocal run_count\n+            run_count += 1\n+            if run_count == 1:\n+                return Failed(message=\"boom\")\n+            raise ValueError(\"second attempt\")\n+\n+        with pytest.raises(ValueError, match=\"second attempt\"):\n+            foo()\n+        assert run_count == 2\n+\n+    def test_flow_retry_with_returned_failed_task_future(self):\n+        flow_run_count = 0\n+        task_run_count = 0\n+\n+        @task\n+        def my_task():\n+            nonlocal task_run_count\n+            task_run_count += 1\n+            if flow_run_count == 1:\n+                raise ValueError()\n+            return \"hello\"\n+\n+        @flow(retries=1)\n+        def foo():\n+            nonlocal flow_run_count\n+            flow_run_count += 1\n+            return my_task.submit()\n+\n+        state = foo(return_state=True)\n+        assert state.is_completed()\n+        assert flow_run_count == 2\n+        assert task_run_count == 2\n+\n     async def test_flow_retry_with_error_in_flow_and_successful_task(self):\n         task_run_count = 0\n         flow_run_count = 0\n", "problem_statement": "Flow-level `retries` never run when a flow *returns* a non-completed state; run is stranded in `AwaitingRetry` with `retry_type=\"in_process\"`\n### Bug summary\n\nWhen a flow with `retries >= 1` **returns** a state (or futures/states) that aggregate to `Failed`, instead of raising, the flow body runs only once. The run is left in `SCHEDULED/AwaitingRetry` with `empirical_policy.retry_type = \"in_process\"`. Nothing ever picks it up after that: the process has exited, and workers skip `in_process` runs. A flow that raises instead retries as expected.\n\n```python\nimport asyncio\n\nimport prefect\nfrom prefect import flow, get_client\nfrom prefect.states import Failed\n\ncalls = {\"returns\": 0, \"raises\": 0}\n\n\n@flow(retries=1, retry_delay_seconds=0)\ndef returns_failed_state():\n    calls[\"returns\"] += 1\n    return [Failed(message=\"boom\")]\n\n\n@flow(retries=1, retry_delay_seconds=0)\ndef raises():\n    calls[\"raises\"] += 1\n    raise ValueError(\"boom\")\n\n\nasync def report(name, key, state):\n    async with get_client() as client:\n        run = await client.read_flow_run(state.state_details.flow_run_id)\n    print(\n        f\"{name:<22} body runs={calls[key]}  \"\n        f\"final={run.state.type.value}/{run.state.name}  \"\n        f\"run_count={run.run_count}  retry_type={run.empirical_policy.retry_type!r}\"\n    )\n\n\nasync def main():\n    print(\"prefect\", prefect.__version__)\n    await report(\"returns_failed_state\", \"returns\", returns_failed_state(return_state=True))\n    await report(\"raises (control)\", \"raises\", raises(return_state=True))\n\n\nasyncio.run(main())\n```\n\nOutput:\n\n```\nprefect 3.8.6\nreturns_failed_state   body runs=1  final=SCHEDULED/AwaitingRetry  run_count=1  retry_type='in_process'\nraises (control)       body runs=2  final=FAILED/Failed  run_count=2  retry_type=None\nprefect 3.9.0\nreturns_failed_state   body runs=1  final=SCHEDULED/AwaitingRetry  run_count=1  retry_type='in_process'\nraises (control)       body runs=2  final=FAILED/Failed  run_count=2  retry_type=None\n```\n\n**Expected:** `returns_failed_state` runs its body twice and ends `FAILED`, the same as the raising control.\n**Actual:** the body runs once, and the run is left non-terminal in `AwaitingRetry` with `retry_type='in_process'`.\n\n### Version info\n\n```Text\nVersion:              3.9.0\nAPI version:          0.8.4\nPython version:       3.12.14\nGit commit:           1ef3e516\nBuilt:                Wed, Oct 21, 2026 03:29 AM\nOS/Arch:              win32/AMD64\nProfile:              ephemeral\nServer type:          ephemeral\nPydantic version:     2.14.1\nServer:\n  Database:           sqlite\n  SQLite version:     3.53.1\n```\n\n### Additional context\n\n**Seen in production.** We hit this on a self-hosted server with an ECS work pool. The flow has `retries=1`, submits about 25 tasks, and returns their futures. One upstream task failed, so its downstream tasks finished as `NotReady` (`PENDING`). State history, relative to the start of the run:\n\n```\n+0:00  RUNNING/Running\n+4:08  SCHEDULED/AwaitingRetry   \"2/25 states are not final.\"\n        (engine log: Finished in state AwaitingRetry('2/25 states are not final.', type=SCHEDULED))\n        (the flow process exits right after; no further engine logs)\n+5:10  CANCELLING/Cancelling     (manual intervention)\n+5:15  CANCELLED/Cancelled       \"Flow run cancellation timed out; marked this flow run as Cancelled.\"\n```\n\n`empirical_policy` while stuck: `{\"retries\": 1, \"retry_type\": \"in_process\", ...}`, `run_count: 1`. It has happened more than once, on more than one server.\n\n**Where it comes from.** `RetryFailedFlows` converts the proposed `Failed` into `AwaitingRetry` and sets `retry_type = \"in_process\"`. `handle_exception` and `handle_timeout` then check `self.state.is_scheduled()` and go back to `Running`. `handle_success`, in both the sync and the async engine, has no such check, so the engine loop exits. The same code is on `main` as of a0cb644eb.\n- [`flow_engine.py` `handle_success` (sync)](https://github.com/PrefectHQ/prefect/blob/3.8.6/src/prefect/flow_engine.py#L799-L827)\n- [`flow_engine.py` `handle_exception`](https://github.com/PrefectHQ/prefect/blob/3.8.6/src/prefect/flow_engine.py#L829-L863), with the check at L850\n- [`flow_engine.py` async `handle_success`](https://github.com/PrefectHQ/prefect/blob/3.8.6/src/prefect/flow_engine.py#L1511-L1536)\n- [`core_policy.py` `RetryFailedFlows`](https://github.com/PrefectHQ/prefect/blob/3.8.6/src/prefect/server/orchestration/core_policy.py#L1067-L1151), which sets `in_process` at L1136\n- [`get-runs-from-worker-queues.sql.jinja`](https://github.com/PrefectHQ/prefect/blob/3.8.6/src/prefect/server/database/sql/postgres/get-runs-from-worker-queues.sql.jinja), which excludes `in_process` runs (#15482)\n\n**Related:** #22847 reaches the same stranded state through a SIGTERM in reschedule mode. This path doesn't involve a signal or a race. See also #17913 and #15458.\n\n", "hints_text": "", "created_at": "2026-10-23T10:02:40Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23533, "instance_id": "PrefectHQ__prefect-23533", "issue_numbers": ["23532"], "base_commit": "7ec97d9bd4a941a7ace4f10e4325bf597902e31e", "patch": "diff --git a/src/prefect/settings/base.py b/src/prefect/settings/base.py\nindex bcdc7fb4684d..732d69370cb0 100644\n--- a/src/prefect/settings/base.py\n+++ b/src/prefect/settings/base.py\n@@ -28,6 +28,19 @@\n from prefect.utilities.collections import visit_collection\n \n \n+class _DefaultEnvFile(tuple[str, ...]):\n+    \"\"\"The `env_file` value set by `build_settings_config`.\n+\n+    It is empty, so the dotenv source that pydantic-settings builds (and\n+    Prefect discards) does not read `.env`. `FilteredDotEnvSettingsSource`\n+    reads `.env` in its place. Subclasses can still set `env_file` to another\n+    path, or to `None` to not load a dotenv file.\n+    \"\"\"\n+\n+\n+_DEFAULT_ENV_FILE = _DefaultEnvFile()\n+\n+\n class PrefectBaseSettings(BaseSettings):\n     @classmethod\n     def settings_customise_sources(\n@@ -72,7 +85,13 @@ def settings_customise_sources(\n             ),\n             FilteredDotEnvSettingsSource(\n                 settings_cls,\n-                env_file=cls.model_config.get(\"env_file\"),\n+                env_file=(\n+                    \".env\"\n+                    if isinstance(\n+                        env_file := cls.model_config.get(\"env_file\"), _DefaultEnvFile\n+                    )\n+                    else env_file\n+                ),\n                 env_file_encoding=cls.model_config.get(\"env_file_encoding\"),\n                 case_sensitive=cls.model_config.get(\"case_sensitive\"),\n                 env_prefix=cls.model_config.get(\"env_prefix\"),\n@@ -252,7 +271,7 @@ def build_settings_config(\n     env_prefix = f\"PREFECT_{'_'.join(path).upper()}_\" if path else \"PREFECT_\"\n     return PrefectSettingsConfigDict(\n         env_prefix=env_prefix,\n-        env_file=\".env\",\n+        env_file=_DEFAULT_ENV_FILE,\n         extra=\"ignore\",\n         toml_file=\"prefect.toml\",\n         prefect_toml_table_header=path,\ndiff --git a/src/prefect/settings/sources.py b/src/prefect/settings/sources.py\nindex c753faa5d105..f48b883532b9 100644\n--- a/src/prefect/settings/sources.py\n+++ b/src/prefect/settings/sources.py\n@@ -1,4 +1,6 @@\n+import io\n import os\n+import stat\n import sys\n import threading\n import warnings\n@@ -21,13 +23,15 @@\n     ConfigFileSourceMixin,\n     DotenvType,\n )\n+from pydantic_settings.sources.utils import parse_env_vars\n \n from prefect._internal.compatibility.backports import tomllib\n from prefect.settings.constants import DEFAULT_PREFECT_HOME, DEFAULT_PROFILES_PATH\n from prefect.utilities.collections import get_from_dict\n \n-_file_cache: TTLCache[str, dict[str, Any]] = TTLCache(maxsize=100, ttl=60)\n+_file_cache: TTLCache[str, Any] = TTLCache(maxsize=100, ttl=60)\n _file_cache_lock = threading.Lock()\n+_dotenv_file_lock = threading.Lock()\n \n \n def _read_toml_file(path: Path) -> dict[str, Any]:\n@@ -47,6 +51,36 @@ def _read_toml_file(path: Path) -> dict[str, Any]:\n     return data\n \n \n+def _read_dotenv_file(path: Path, encoding: str | None = None) -> dict[str, str | None]:\n+    \"\"\"Read a dotenv file, sharing its contents across all settings sources.\n+\n+    Each settings class builds its own dotenv source, so without a cache `.env`\n+    is opened once per settings class every time settings are loaded. Regular\n+    files are re-read when they change. FIFOs (e.g. 1Password Environments\n+    mounts) are slow to open and their `stat` may not reflect content\n+    changes, so they are re-read once the cache TTL expires.\n+\n+    Only the file contents are cached. Values are parsed on each call, so\n+    `${VAR}` interpolation uses the current environment. Loads are serialized\n+    so that concurrent cache misses open the file only once.\n+    \"\"\"\n+    path_stat = path.stat()\n+    if stat.S_ISFIFO(path_stat.st_mode):\n+        version = \"fifo\"\n+    else:\n+        version = f\"{path_stat.st_ino}:{path_stat.st_size}:{path_stat.st_mtime_ns}\"\n+    cache_key = f\"dotenv_file:{path.absolute()}:{encoding}:{version}\"\n+    with _dotenv_file_lock:\n+        with _file_cache_lock:\n+            content: str | None = _file_cache.get(cache_key)\n+        if content is None:\n+            with open(path, encoding=encoding or \"utf8\") as f:\n+                content = f.read()\n+            with _file_cache_lock:\n+                _file_cache[cache_key] = content\n+    return dotenv.dotenv_values(stream=io.StringIO(content))\n+\n+\n class EnvFilterSettingsSource(EnvSettingsSource):\n     \"\"\"\n     Custom pydantic settings source to filter out specific environment variables.\n@@ -127,6 +161,14 @@ def __init__(\n                     if key.lower() not in env_blacklist\n                 }\n \n+    def _read_env_file(self, file_path: Path) -> Mapping[str, str | None]:\n+        return parse_env_vars(\n+            _read_dotenv_file(file_path, self.env_file_encoding),\n+            self.case_sensitive,\n+            self.env_ignore_empty,\n+            self.env_parse_none_str,\n+        )\n+\n \n class ProfileSettingsTomlLoader(PydanticBaseSettingsSource):\n     \"\"\"\n@@ -360,7 +402,7 @@ def _get_profiles_path() -> Path:\n     if env_path := os.getenv(\"PREFECT_PROFILES_PATH\"):\n         return Path(env_path)\n     if Path(\".env\").is_file() and (\n-        dotenv_path := dotenv.dotenv_values(\".env\").get(\"PREFECT_PROFILES_PATH\")\n+        dotenv_path := _read_dotenv_file(Path(\".env\")).get(\"PREFECT_PROFILES_PATH\")\n     ):\n         return Path(dotenv_path)\n     if toml_path := _get_profiles_path_from_toml(\"prefect.toml\", [\"profiles_path\"]):\n", "test_patch": "diff --git a/tests/test_settings.py b/tests/test_settings.py\nindex 88bda3890209..6e28e07e0749 100644\n--- a/tests/test_settings.py\n+++ b/tests/test_settings.py\n@@ -1,21 +1,26 @@\n from __future__ import annotations\n \n+import builtins\n import copy\n import json\n import os\n import sys\n import textwrap\n+import threading\n import warnings\n from concurrent.futures import ThreadPoolExecutor\n from datetime import timedelta\n from pathlib import Path\n-from typing import Any, Callable, Generator\n+from typing import Any, Callable, ClassVar, Generator\n \n import pydantic\n+import pydantic_settings\n import pytest\n import toml\n from cachetools import TTLCache\n+from packaging.version import Version\n from pydantic_core import to_jsonable_python\n+from pydantic_settings import SettingsConfigDict\n from sqlalchemy import make_url\n \n import prefect.context\n@@ -1748,6 +1753,157 @@ def test_env_fifo_does_not_hang(\n \n         _get_profiles_path()\n \n+    @pytest.fixture\n+    def dotenv_opens(self, monkeypatch: pytest.MonkeyPatch) -> list[str]:\n+        \"\"\"Records every open of a `.env` file, starting from an empty settings\n+        file cache.\"\"\"\n+        monkeypatch.setattr(\n+            \"prefect.settings.sources._file_cache\", TTLCache(maxsize=100, ttl=60)\n+        )\n+        opened: list[str] = []\n+        original_open = builtins.open\n+\n+        def counting_open(file: Any, *args: Any, **kwargs: Any) -> Any:\n+            if str(file).endswith(\".env\"):\n+                opened.append(str(file))\n+            return original_open(file, *args, **kwargs)\n+\n+        monkeypatch.setattr(builtins, \"open\", counting_open)\n+        return opened\n+\n+    def test_dotenv_file_read_once_across_settings_sources(\n+        self, temporary_env_file: Callable[[str], None], dotenv_opens: list[str]\n+    ):\n+        \"\"\"Regression test for https://github.com/PrefectHQ/prefect/issues/23532\"\"\"\n+        temporary_env_file(\"PREFECT_API_URL=http://from-dotenv:4200/api\")\n+\n+        assert Settings().api.url == \"http://from-dotenv:4200/api\"\n+        assert Settings().api.url == \"http://from-dotenv:4200/api\"\n+\n+        assert len(dotenv_opens) == 1\n+\n+    def test_dotenv_file_changes_are_reloaded(\n+        self, temporary_env_file: Callable[[str], None], dotenv_opens: list[str]\n+    ):\n+        temporary_env_file(\"PREFECT_CLIENT_RETRY_EXTRA_CODES=420\")\n+        assert Settings().client.retry_extra_codes == {420}\n+\n+        temporary_env_file(\"PREFECT_CLIENT_RETRY_EXTRA_CODES=420,500\")\n+        assert Settings().client.retry_extra_codes == {420, 500}\n+\n+        assert len(dotenv_opens) == 2\n+\n+    @pytest.mark.skipif(\n+        Version(pydantic_settings.__version__) < Version(\"2.14\"),\n+        reason=\"pydantic-settings < 2.14 does not read FIFO dotenv files\",\n+    )\n+    def test_dotenv_fifo_read_once_across_settings_sources(\n+        self,\n+        monkeypatch: pytest.MonkeyPatch,\n+        tmp_path: Path,\n+        dotenv_opens: list[str],\n+    ):\n+        \"\"\"Regression test for https://github.com/PrefectHQ/prefect/issues/23532\n+\n+        1Password Environments mounts `.env` as a FIFO, where every open is\n+        served by 1Password, so it must only be read once.\n+        \"\"\"\n+        monkeypatch.chdir(tmp_path)\n+        os.mkfifo(\".env\")\n+        stop = threading.Event()\n+\n+        def serve() -> None:\n+            while not stop.is_set():\n+                fd = os.open(\".env\", os.O_WRONLY)\n+                try:\n+                    os.write(fd, b\"PREFECT_API_URL=http://from-fifo:4200/api\\n\")\n+                except BrokenPipeError:\n+                    pass\n+                finally:\n+                    os.close(fd)\n+\n+        server = threading.Thread(target=serve, daemon=True)\n+        server.start()\n+        try:\n+            assert Settings().api.url == \"http://from-fifo:4200/api\"\n+            assert Settings().api.url == \"http://from-fifo:4200/api\"\n+        finally:\n+            stop.set()\n+            # unblock the server if it is waiting for a reader\n+            fd = os.open(\".env\", os.O_RDONLY | os.O_NONBLOCK)\n+            server.join(timeout=5)\n+            os.close(fd)\n+\n+        assert len(dotenv_opens) == 1\n+\n+    def test_dotenv_file_read_once_by_concurrent_settings_loads(\n+        self, temporary_env_file: Callable[[str], None], dotenv_opens: list[str]\n+    ):\n+        temporary_env_file(\"PREFECT_API_URL=http://from-dotenv:4200/api\")\n+        barrier = threading.Barrier(8)\n+\n+        def load() -> str | None:\n+            barrier.wait()\n+            return Settings().api.url\n+\n+        with ThreadPoolExecutor(max_workers=8) as executor:\n+            urls = list(executor.map(lambda _: load(), range(8)))\n+\n+        assert urls == [\"http://from-dotenv:4200/api\"] * 8\n+        assert len(dotenv_opens) == 1\n+\n+    def test_dotenv_file_interpolation_uses_current_environment(\n+        self,\n+        monkeypatch: pytest.MonkeyPatch,\n+        temporary_env_file: Callable[[str], None],\n+        dotenv_opens: list[str],\n+    ):\n+        temporary_env_file(\"PREFECT_API_URL=${API_HOST}/api\")\n+\n+        monkeypatch.setenv(\"API_HOST\", \"http://host-a:4200\")\n+        assert Settings().api.url == \"http://host-a:4200/api\"\n+\n+        monkeypatch.setenv(\"API_HOST\", \"http://host-b:4200\")\n+        assert Settings().api.url == \"http://host-b:4200/api\"\n+\n+        assert len(dotenv_opens) == 1\n+\n+    def test_env_file_can_be_overridden(\n+        self, temporary_env_file: Callable[[str], None]\n+    ):\n+        temporary_env_file(\"PREFECT_DOTENV_TEST_VALUE=from-dotenv\")\n+        Path(\"custom.env\").write_text(\"PREFECT_DOTENV_TEST_VALUE=from-custom\")\n+\n+        class DefaultEnvFileSettings(PrefectBaseSettings):\n+            model_config: ClassVar[SettingsConfigDict] = build_settings_config(\n+                (\"dotenv_test\",)\n+            )\n+\n+            value: str = \"default\"\n+\n+        class CustomEnvFileSettings(DefaultEnvFileSettings):\n+            model_config: ClassVar[SettingsConfigDict] = SettingsConfigDict(\n+                env_file=\"custom.env\"\n+            )\n+\n+        class SubclassNoEnvFileSettings(DefaultEnvFileSettings):\n+            model_config: ClassVar[SettingsConfigDict] = SettingsConfigDict(\n+                env_file=None\n+            )\n+\n+        class NoEnvFileSettings(PrefectBaseSettings):\n+            model_config: ClassVar[SettingsConfigDict] = {\n+                **build_settings_config((\"dotenv_test\",)),\n+                \"env_file\": None,\n+            }\n+\n+            value: str = \"default\"\n+\n+        assert DefaultEnvFileSettings().value == \"from-dotenv\"\n+        assert CustomEnvFileSettings().value == \"from-custom\"\n+        assert SubclassNoEnvFileSettings().value == \"default\"\n+        assert NoEnvFileSettings().value == \"default\"\n+\n     def test_resolution_order(\n         self,\n         temporary_env_file: Callable[[str], None],\n", "problem_statement": "Import prefect opens .env 216 times, which stalls on a 1Password Environments (FIFO) .env\n### Bug summary\n`import prefect` opens and parses `./.env` once per settings source: 216 times with Prefect 3.9.0. With a regular file you don't notice. With a [1Password Environments](https://developer.1password.com/docs/environments/local-env-file) mount it stalls startup, because 1Password serves `.env` through a named pipe (FIFO) and each open goes through 1Password. Their docs also say the mount isn't designed for concurrent access.\n\nSince pydantic-settings 2.14 reads FIFO `.env` files instead of skipping them (pydantic/pydantic-settings#776, added for 1Password), anyone who mounts their 1Password environment at `./.env` gets this as soon as they upgrade pydantic-settings.\n\nReproduction. A thread stands in for 1Password and serves the pipe, and we count opens of `.env`:\n\n```python\nimport builtins\nimport os\nimport tempfile\nimport threading\nimport time\n\nos.chdir(tempfile.mkdtemp())\nos.mkfifo(\".env\")  # what 1Password Environments mounts\n\n\ndef serve() -> None:  # stand-in for 1Password: hand the contents to each reader\n    while True:\n        fd = os.open(\".env\", os.O_WRONLY)\n        try:\n            os.write(fd, b\"MY_SECRET=value\\n\")\n        except BrokenPipeError:\n            pass\n        os.close(fd)\n        time.sleep(0.001)\n\n\nthreading.Thread(target=serve, daemon=True).start()\n\nopens = 0\n_open = builtins.open\n\n\ndef counting_open(file, *args, **kwargs):\n    global opens\n    if str(file).endswith(\".env\"):\n        opens += 1\n    return _open(file, *args, **kwargs)\n\n\nbuiltins.open = counting_open\n\nimport prefect  # noqa: E402\nimport pydantic_settings  # noqa: E402\n\nprint(f\"prefect {prefect.__version__}, pydantic-settings {pydantic_settings.__version__}\")\nprint(f\".env opened {opens} times during `import prefect`\")\n```\n\n```\n$ uv run --no-project --with prefect==3.9.0 --with pydantic-settings==2.13.1 python repro.py\nprefect 3.9.0, pydantic-settings 2.13.1\n.env opened 0 times during `import prefect`\n\n$ uv run --no-project --with prefect==3.9.0 --with pydantic-settings==2.16.1 python repro.py\nprefect 3.9.0, pydantic-settings 2.16.1\n.env opened 216 times during `import prefect`\n```\n\nAll 216 opens come from `FilteredDotEnvSettingsSource`: 54 settings classes, each building its dotenv source 4 times during import. With a regular `.env` file, the count is 324.\n\nWith a real 1Password mount at `./.env` (Prefect 3.8.8, pydantic-settings 2.16.1), loading Prefect settings in our project was still blocked after 20 s, and we stopped it there. With the mount moved out of the working directory, it loaded in 1.0 s.\n\nProposed fix: read and parse each `.env` path once per process and share the result across all `FilteredDotEnvSettingsSource` instances, with a way to clear it for tests and profile switches. This builds on the FIFO guard from #21319 / #21320, which covers the direct `dotenv_values(\".env\")` calls but not the settings sources. We're happy to send the PR if this approach works for you.\n\n### Version info\n\n```Text\nVersion:              3.9.0\nAPI version:          0.8.4\nPython version:       3.13.12\nGit commit:           1ef3e516\nBuilt:                Wed, Oct 21, 2026 03:29 AM\nOS/Arch:              darwin/arm64\nProfile:              ephemeral\nServer type:          ephemeral\nPydantic version:     2.14.1\npydantic-settings:    2.16.1\n```\n\n### Additional context\n\nWorkarounds today are pinning `pydantic-settings<2.14`, which skips FIFO `.env` files, or mounting the 1Password `.env` outside the directory you run Prefect from.\n", "hints_text": "", "created_at": "2026-10-23T09:13:06Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23530, "instance_id": "PrefectHQ__prefect-23530", "issue_numbers": ["23529"], "base_commit": "a0cb644eb9c937b5e78c957ea06c39d4f5c59093", "patch": "diff --git a/src/prefect/cli/variable.py b/src/prefect/cli/variable.py\nindex b716eaa649c8..6934d67b0242 100644\n--- a/src/prefect/cli/variable.py\n+++ b/src/prefect/cli/variable.py\n@@ -69,7 +69,7 @@ async def list_variables(\n     if output and output.lower() == \"json\":\n         variables_json = [variable.model_dump(mode=\"json\") for variable in variables]\n         json_output = orjson.dumps(variables_json, option=orjson.OPT_INDENT_2).decode()\n-        _cli.console.print(json_output, soft_wrap=True)\n+        _cli.console.print(json_output, soft_wrap=True, markup=False, emoji=False)\n     else:\n         table = Table(\n             title=\"Variables\",\n@@ -128,7 +128,7 @@ async def inspect(\n             json_output = orjson.dumps(\n                 variable_json, option=orjson.OPT_INDENT_2\n             ).decode()\n-            _cli.console.print(json_output, soft_wrap=True)\n+            _cli.console.print(json_output, soft_wrap=True, markup=False, emoji=False)\n         else:\n             _cli.console.print(Pretty(variable))\n \n@@ -142,7 +142,12 @@ async def get(name: str):\n     async with get_client() as client:\n         variable = await client.read_variable_by_name(name=name)\n         if variable:\n-            _cli.console.print(json.dumps(variable.value))\n+            _cli.console.print(\n+                json.dumps(variable.value),\n+                soft_wrap=True,\n+                markup=False,\n+                emoji=False,\n+            )\n         else:\n             exit_with_error(f\"Variable {name!r} not found.\")\n \n", "test_patch": "diff --git a/tests/cli/test_variable.py b/tests/cli/test_variable.py\nindex b6a57c2e5353..7396061a7d32 100644\n--- a/tests/cli/test_variable.py\n+++ b/tests/cli/test_variable.py\n@@ -1,10 +1,13 @@\n+import json\n import sys\n+from typing import Any\n \n import pytest\n from sqlalchemy.ext.asyncio import AsyncSession\n \n from prefect.server.models.variables import create_variable\n from prefect.server.schemas.actions import VariableCreate\n+from prefect.settings import PREFECT_CLI_WRAP_LINES, temporary_settings\n from prefect.testing.cli import invoke_and_assert\n \n pytestmark = pytest.mark.clear_db\n@@ -61,6 +64,65 @@ async def variables(\n     return models\n \n \n+LITERAL_TAGS = [\"[red]tag[/red]\", \":smile:\"]\n+\n+LITERAL_VALUES: list[Any] = [\n+    \"[red]literal[/red]\",\n+    \":smile:\",\n+    \"literal [/unexpected]\",\n+    \"x\" * 1000,\n+    {\"nested\": [\"[bold]value[/bold]\", \":thumbs_up:\", {\"deep\": \"[/close]\"}]},\n+]\n+\n+\n+@pytest.fixture\n+def wrap_lines_enabled():\n+    # The test suite disables line wrapping by default; enable it so long values\n+    # exercise terminal-width wrapping.\n+    with temporary_settings(updates={PREFECT_CLI_WRAP_LINES: True}):\n+        yield\n+\n+\n+@pytest.fixture(\n+    params=LITERAL_VALUES,\n+    ids=[\"markup\", \"emoji\", \"unmatched-closing-tag\", \"long-string\", \"nested\"],\n+)\n+async def literal_variable(\n+    session: AsyncSession, request: pytest.FixtureRequest, wrap_lines_enabled: None\n+):\n+    model = await create_variable(\n+        session,\n+        VariableCreate(name=\"literal_value\", value=request.param, tags=LITERAL_TAGS),\n+    )\n+    await session.commit()\n+\n+    return model\n+\n+\n+def test_get_variable_preserves_literal_value(literal_variable):\n+    result = invoke_and_assert(\n+        [\"variable\", \"get\", literal_variable.name], expected_code=0\n+    )\n+    assert json.loads(result.stdout) == literal_variable.value\n+\n+\n+def test_inspect_variable_json_preserves_literal_value(literal_variable):\n+    result = invoke_and_assert(\n+        [\"variable\", \"inspect\", literal_variable.name, \"--output\", \"json\"],\n+        expected_code=0,\n+    )\n+    output = json.loads(result.stdout)\n+    assert output[\"value\"] == literal_variable.value\n+    assert output[\"tags\"] == LITERAL_TAGS\n+\n+\n+def test_list_variables_json_preserves_literal_value(literal_variable):\n+    result = invoke_and_assert([\"variable\", \"ls\", \"--output\", \"json\"], expected_code=0)\n+    output = json.loads(result.stdout)\n+    assert [v[\"value\"] for v in output] == [literal_variable.value]\n+    assert [v[\"tags\"] for v in output] == [LITERAL_TAGS]\n+\n+\n def test_list_output_variables_with_limit(variables):\n     name = sorted([variable.name for variable in variables])[0]\n     invoke_and_assert(\n@@ -145,8 +207,6 @@ def test_inspect_variable(variable):\n \n def test_inspect_variable_with_json_output(variable):\n     \"\"\"Test variable inspect command with JSON output flag.\"\"\"\n-    import json\n-\n     result = invoke_and_assert(\n         [\"variable\", \"inspect\", variable.name, \"--output\", \"json\"],\n         expected_code=0,\n", "problem_statement": "Variable CLI JSON output changes literal markup and emoji aliases\n### Bug summary\n\nThe variable CLI renders serialized JSON as Rich markup and emoji aliases. This silently changes stored values in `variable get`, `variable inspect --output json`, and `variable ls --output json`; an unmatched closing tag raises `rich.errors.MarkupError`.\n\n### Reproduction\n\nAgainst a local Prefect server, create a variable with a literal value such as `[red]literal[/red]`, `:smile:`, or `literal [/unexpected]`, then read it with each command above.\n\nA minimal regression using the existing test fixtures (an async fixture is needed because the CLI runner itself starts an event loop):\n\n```python\nimport json\nimport pytest\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom prefect.server.models.variables import create_variable\nfrom prefect.server.schemas.actions import VariableCreate\nfrom prefect.testing.cli import invoke_and_assert\n\npytestmark = pytest.mark.clear_db\n\n@pytest.fixture\nasync def literal_variable(session: AsyncSession):\n    await create_variable(\n        session, VariableCreate(name=\"literal_value\", value=\"[red]literal[/red]\")\n    )\n    await session.commit()\n\ndef test_variable_value_round_trips(literal_variable):\n    result = invoke_and_assert([\"variable\", \"get\", \"literal_value\"], expected_code=0)\n    assert json.loads(result.stdout) == \"[red]literal[/red]\"\n```\n\nExpected: the decoded output equals the stored value.\n\nActual: `\"literal\"` instead of `\"[red]literal[/red]\"`. Likewise `:smile:` becomes an emoji. Nested values are affected too. `literal [/unexpected]` raises a Rich markup error.\n\n### Verification\n\nReproduced on main commit a0cb644eb9c937b5e78c957ea06c39d4f5c59093, Python 3.12.14, with locked project dependencies in an isolated environment. A 12-case real CLI/API regression matrix (three commands by four values including nested JSON) failed for these exact reasons. The existing variable CLI suite passes 20/20; collection utility tests pass 122/122. These are local tests, not tests against Prefect Cloud.\n\n### Proposed scope\n\nI plan a focused fix to disable markup and emoji processing only for these three serialized-JSON print calls, and use soft_wrap=True to avoid terminal-width line breaks in get output. Human-readable tables and global console behavior would remain unchanged. Regression tests will assert exact decoded values, including long strings and nested content.\n\nRelated to the machine-readable CLI goal in #19903. Searches for variable CLI JSON, markup and emoji issues/PRs did not find this specific bug.\n\nAI disclosure: this investigation, reproduction and proposed contribution are being prepared with OpenAI Codex assistance; the reported checks were actually executed locally.\n", "hints_text": "", "created_at": "2026-10-23T00:12:27Z"}
{"repo": "PrefectHQ/prefect", "pull_number": 23527, "instance_id": "PrefectHQ__prefect-23527", "issue_numbers": ["23524", "23536"], "base_commit": "f7fe68f109854144f1a9d9d5794a1cd6f2a46050", "patch": "diff --git a/.github/workflows/integration-package-release.yaml b/.github/workflows/integration-package-release.yaml\nindex d37b122dfdcb..09e2adae6de3 100644\n--- a/.github/workflows/integration-package-release.yaml\n+++ b/.github/workflows/integration-package-release.yaml\n@@ -116,6 +116,13 @@ jobs:\n       - name: Publish distribution to PyPI\n         uses: pypa/gh-action-pypi-publish@release/v1\n \n+  update-integration-lock:\n+    needs: [build-pypi-dists, publish-pypi-dists]\n+    uses: ./.github/workflows/update-uv-lock-integrations.yaml\n+    with:\n+      tag: ${{ github.ref_name }}\n+    secrets: inherit\n+\n   get-prefect-version:\n     name: Get latest Prefect version\n     needs: [build-pypi-dists, publish-pypi-dists]\ndiff --git a/.github/workflows/update-uv-lock-integrations.yaml b/.github/workflows/update-uv-lock-integrations.yaml\nnew file mode 100644\nindex 000000000000..2e28aee4e83b\n--- /dev/null\n+++ b/.github/workflows/update-uv-lock-integrations.yaml\n@@ -0,0 +1,54 @@\n+# Called only after PyPI publication succeeds; scheduled runs cover missed releases.\n+name: Update uv.lock integration pins\n+\n+on:\n+  workflow_call:\n+    inputs:\n+      tag:\n+        required: true\n+        type: string\n+  schedule:\n+    - cron: \"0 15 * * 1\"\n+  workflow_dispatch:\n+\n+permissions:\n+  contents: read\n+\n+# Serialize releases and sweeps so they cannot race over automation branches.\n+concurrency:\n+  group: update-uv-lock-integrations\n+  cancel-in-progress: false\n+\n+jobs:\n+  update:\n+    runs-on: ubuntu-latest\n+    steps:\n+      - name: Generate prefect-ci-bot-public token\n+        id: app_token\n+        uses: actions/create-github-app-token@v3\n+        with:\n+          client-id: ${{ secrets.PREFECT_CI_BOT_PUBLIC_CLIENT_ID }}\n+          private-key: ${{ secrets.PREFECT_CI_BOT_PUBLIC_PRIVATE_KEY }}\n+          permission-contents: write\n+          permission-pull-requests: write\n+\n+      - name: Check out main\n+        uses: actions/checkout@v7\n+        with:\n+          ref: main\n+          fetch-depth: 0\n+          token: ${{ steps.app_token.outputs.token }}\n+\n+      - uses: actions/setup-python@v7\n+        with:\n+          python-version: \"3.12\"\n+\n+      - uses: astral-sh/setup-uv@v10.3.0\n+        with:\n+          version: latest\n+\n+      - name: Update integration pins and recover or open a PR\n+        env:\n+          GH_TOKEN: ${{ steps.app_token.outputs.token }}\n+          RELEASE_TAG: ${{ inputs.tag }}\n+        run: uv run --no-project --with packaging scripts/update_uv_lock_integrations.py\ndiff --git a/scripts/update_uv_lock_integrations.py b/scripts/update_uv_lock_integrations.py\nnew file mode 100644\nindex 000000000000..903662aec6a3\n--- /dev/null\n+++ b/scripts/update_uv_lock_integrations.py\n@@ -0,0 +1,153 @@\n+\"\"\"Refresh Docker integration constraints after publication or on a weekly sweep.\"\"\"\n+\n+import datetime\n+import json\n+import os\n+import re\n+import subprocess\n+import time\n+import tomllib\n+from pathlib import Path\n+\n+from packaging.version import Version\n+\n+\n+def run(*args: str) -> str:\n+    return subprocess.check_output(args, text=True).strip()\n+\n+\n+def pins() -> dict[str, str]:\n+    with Path(\"uv.lock\").open(\"rb\") as f:\n+        return {\n+            p[\"name\"]: p[\"version\"]\n+            for p in tomllib.load(f)[\"package\"]\n+            if p[\"name\"].startswith(\"prefect-\") and \"version\" in p\n+        }\n+\n+\n+def release(tag: str) -> tuple[str, str]:\n+    match = re.fullmatch(r\"(prefect-[a-z0-9-]+)-(\\d[^/]*)\", tag)\n+    if not match:\n+        raise ValueError(f\"Invalid integration tag: {tag}\")\n+    package, version = match.groups()\n+    return package, str(Version(version))\n+\n+\n+def upgrade(package: str, version: str, attempts: int = 6) -> None:\n+    # Do not downgrade a newer pin when an older release is retried.\n+    if Version(pins()[package]) >= Version(version):\n+        return\n+    for attempt in range(attempts):\n+        try:\n+            run(\n+                \"uv\",\n+                \"lock\",\n+                \"--refresh-package\",\n+                package,\n+                \"--upgrade-package\",\n+                f\"{package}=={version}\",\n+            )\n+            if Version(pins()[package]) != Version(version):\n+                raise RuntimeError(f\"Lock does not contain {package}=={version}\")\n+            return\n+        except (subprocess.CalledProcessError, RuntimeError):\n+            if attempt == attempts - 1:\n+                raise\n+            # PyPI's index may lag successful upload. Never publish a stale update.\n+            time.sleep(30)\n+\n+\n+def prepare_branch(branch: str) -> tuple[str, bool]:\n+    prs = json.loads(\n+        run(\n+            \"gh\",\n+            \"pr\",\n+            \"list\",\n+            \"--head\",\n+            branch,\n+            \"--base\",\n+            \"main\",\n+            \"--state\",\n+            \"all\",\n+            \"--json\",\n+            \"state,url\",\n+        )\n+    )\n+    open_pr = any(pr[\"state\"] == \"OPEN\" for pr in prs)\n+    if prs and not open_pr:\n+        # Retained branches from closed/merged PRs must not suppress a new update.\n+        branch += f\"-{os.environ['GITHUB_RUN_ID']}-{os.environ['GITHUB_RUN_ATTEMPT']}\"\n+    remote = run(\"git\", \"ls-remote\", \"--heads\", \"origin\", f\"refs/heads/{branch}\")\n+    if remote:\n+        run(\"git\", \"fetch\", \"origin\", f\"refs/heads/{branch}\")\n+        run(\"git\", \"checkout\", \"-B\", branch, \"FETCH_HEAD\")\n+        # Preserve existing commits and refuse to overwrite unrelated changes.\n+        changed = run(\"git\", \"diff\", \"--name-only\", \"origin/main...HEAD\").splitlines()\n+        if any(path != \"uv.lock\" for path in changed):\n+            raise RuntimeError(\n+                f\"Unexpected changes on {branch}; manual review required\"\n+            )\n+        run(\"git\", \"merge\", \"--no-edit\", \"origin/main\")\n+    else:\n+        run(\"git\", \"checkout\", \"-b\", branch, \"origin/main\")\n+    return branch, open_pr\n+\n+\n+def main() -> None:\n+    tag = os.environ.get(\"RELEASE_TAG\", \"\")\n+    package, version = release(tag) if tag else (\"\", \"\")\n+    if package and package not in pins():\n+        print(f\"{package} is not in uv.lock; nothing to update\")\n+        return\n+    branch = (\n+        f\"automation/uv-lock-{package}-{version}\"\n+        if tag\n+        else f\"automation/uv-lock-sweep-{datetime.date.today():%Y%m%d}\"\n+    )\n+    run(\"git\", \"config\", \"user.name\", \"github-actions[bot]\")\n+    run(\"git\", \"config\", \"user.email\", \"github-actions[bot]@users.noreply.github.com\")\n+    branch, open_pr = prepare_branch(branch)\n+    before = pins()\n+    if package:\n+        upgrade(package, version)\n+    else:\n+        args = [arg for name in sorted(before) for arg in (\"--upgrade-package\", name)]\n+        if args:\n+            run(\"uv\", \"lock\", *args)\n+    after = pins()\n+    if run(\"git\", \"diff\", \"--name-only\", \"--\", \"uv.lock\"):\n+        run(\"git\", \"add\", \"uv.lock\")\n+        run(\"git\", \"commit\", \"-m\", \"Update released integration pins in uv.lock\")\n+    # Recover an earlier successful push even if there are no new lock changes.\n+    if not run(\"git\", \"diff\", \"origin/main...HEAD\", \"--\", \"uv.lock\"):\n+        print(\"Integration pins already current\")\n+        return\n+    run(\"git\", \"push\", \"--set-upstream\", \"origin\", branch)\n+    if not open_pr:\n+        title = (\n+            f\"Update {package} integration pin\"\n+            if package\n+            else \"Sweep stale integration pins in uv.lock\"\n+        )\n+        body = \"Update Docker integration constraints in uv.lock. \" + (\n+            f\"After publication of {tag}, verified {package}=={after[package]}.\"\n+            if tag\n+            else \"Weekly integration maintenance.\"\n+        )\n+        run(\n+            \"gh\",\n+            \"pr\",\n+            \"create\",\n+            \"--base\",\n+            \"main\",\n+            \"--head\",\n+            branch,\n+            \"--title\",\n+            title,\n+            \"--body\",\n+            body,\n+        )\n+\n+\n+if __name__ == \"__main__\":\n+    main()\ndiff --git a/ui-v2/src/api/prefect.ts b/ui-v2/src/api/prefect.ts\nindex 299e3ad2ed7a..ae5975a053d7 100644\n--- a/ui-v2/src/api/prefect.ts\n+++ b/ui-v2/src/api/prefect.ts\n@@ -8616,7 +8616,7 @@ export interface components {\n          */\n         \"IntervalSchedule-Output\": {\n             /** Interval */\n-            interval: number | string;\n+            interval: number;\n             /**\n              * Anchor Date\n              * Format: date-time\ndiff --git a/uv.lock b/uv.lock\nindex 8e7565e94162..30f98d240558 100644\n--- a/uv.lock\n+++ b/uv.lock\n@@ -4477,7 +4477,7 @@ type-checking = [\n \n [[package]]\n name = \"prefect-aws\"\n-version = \"0.7.7\"\n+version = \"0.7.12\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n     { name = \"aiobotocore\" },\n@@ -4489,14 +4489,14 @@ dependencies = [\n     { name = \"tenacity\" },\n     { name = \"typer\" },\n ]\n-sdist = { url = \"https://files.pythonhosted.org/packages/c4/80/f2f159f60f5ccf3832df1dd5bb166db21bb33f6842598632f2ee479a897a/prefect_aws-0.7.7.tar.gz\", hash = \"sha256:939d5dad269c3cfc59a7c44c8b77d123bec83c0aede236e225e35c426d3d6f49\", size = 158979, upload-time = \"2026-03-30T20:29:11.983Z\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/9a/c2/af6404a9650854dfab845b43e900cf9fdffdc1b0e1e386fe643d9905e32e/prefect_aws-0.7.12.tar.gz\", hash = \"sha256:54c10e90b4819a5f8a151937b299a2e585b4410ebd7662305f315ab