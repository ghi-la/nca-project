an be used to create standalone reproduction scripts\nthat can be added to this report. See the pytest-celery documentation for more information at\npytest-celery.readthedocs.io\n-->\n\n<details>\n<p>\n\n```python\nfrom uuid import uuid4\nfrom celery import Celery\nfrom celery import chain, group\n\napp = Celery(\"bug-example\", backend=\"redis://localhost:6379/0\", broker=\"amqp://guest:guest@localhost:5672//\")\n\n@app.task(name=\"test1\")\ndef task1():\n    return None\n\ntasks_length = 5\n\nworker_tasks = [\n    chain(\n        app.signature(\"test1\"), app.signature(\"test1\")\n    )\n    for i in range(tasks_length)\n]\n\n\npost_processing_tasks = []\nfor i in range(tasks_length):\n    t = [\n        task1.s(),\n        task1.s(),\n        task1.s(),\n        task1.s(),\n    ]\n    post_processing_tasks.append(chain(*t))\n\ntasks = [\n    task1.s(),\n    group(worker_tasks),\n    group(post_processing_tasks),\n    task1.s(),\n    task1.s(),\n]\n\nlast_task1 = chain(*tasks, task_id=str(uuid4())).apply_async()\nlast_task2 = chain(*tasks, task_id=\"hello\").apply_async()\nlast_task3 = chain(*tasks).apply_async()\nprint(last_task1.as_tuple())\nprint(\"------------------------------------------------------------------\")\nprint(last_task2.as_tuple())\nprint(\"------------------------------------------------------------------\")\nprint(last_task3.as_tuple())\n```\n\n</p>\n</details>\n\n# Expected Behavior\n<!-- Describe in detail what you expect to happen -->\nI except the tasks tuple to have the same structure no matter if a custom `task_id` is specified or not. \n# Actual Behavior\n<!--\nDescribe in detail what actually happened.\nPlease include a backtrace and surround it with triple backticks (```).\nIn addition, include the Celery daemon logs, the broker logs,\nthe result backend logs and system logs below if they will help us debug\nthe issue.\n-->\nHeres a sample output of my test case above: \n\n```\n(('58ab2d54-850f-4cae-99b8-76f48287de94', (('b1a8d44c-1a13-40a9-b65c-908234f625a1', None), None)), None)\n------------------------------------------------------------------\n(('hello', (('b60e44f8-0fe8-44db-a244-87e10669dab2', None), None)), None)\n------------------------------------------------------------------\n(('3b000dc7-0aba-4f40-b5e7-05c6f47c489b', (('98f93a50-bf03-47f1-bb3e-cb2fbf14b667', (('416dfcfe-93f7-4109-88ee-c42645db3092', (('e998f97c-bc5f-478c-8650-6e71869d1c38', (('a2463049-e6dd-4ec9-a5ab-3f182f0c8d02', None), None)), [(('5c760a95-e3a5-4be0-864d-7cbc95b583e0', (('2c07945c-0875-4c55-872c-7db2d1266236', None), None)), None), (('12fa7d1f-9711-4836-92a8-55191ce12002', (('be9fa89c-74d2-4614-ab57-b12534ecc428', None), None)), None), (('0e3341fb-3f45-40a3-a702-8ef8e845ad68', (('8aeab35b-e22f-47c6-b0c5-a6041e2c6233', None), None)), None), (('1779ece4-0bd2-49b3-838a-c2e1b1087c27', (('b5c3f7c7-c7c7-4c1f-8e11-aafd99e8d589', None), None)), None), (('212119fd-8bf9-4818-9ba4-d779e027897c', (('6d5fff40-b555-4ee3-bba7-725950f90711', None), None)), None)])), [(('133b9ce8-2d14-4bc2-84b4-7dbea0724a99', (('26230983-a52b-4c54-8042-0d0af471ba24', (('c7883d1b-f584-4bb5-a528-effaa8fe19ea', (('fc5ae86f-d4f7-45bf-8a4c-e0c9002d5a8c', None), None)), None)), None)), None), (('a2cae871-9e7e-46fd-a93a-469f81e184f6', (('6de6b245-db29-46ee-8275-10c7ffad6571', (('6f2e4c5e-247a-4897-932e-32c62c65f9a5', (('7a6b15b8-1bf9-4660-a7bf-127587b30375', None), None)), None)), None)), None), (('0ef2b576-63f3-41d8-abd4-259e1a0fa4a2', (('9b7c2da7-049f-49cb-a099-b5d89aae9038', (('7e7649bb-7846-409f-a61f-a4dffa243f4c', (('044266f9-d93d-439f-a399-b82ff93370e9', None), None)), None)), None)), None), (('a17715ad-961f-458b-8487-29b6475dcb51', (('9acc6205-cb6c-4c0a-8d05-415092a6a016', (('cf0c7a7b-e386-49e1-9734-61388424b981', (('7c97bac5-ed57-484f-aa83-ecee842da180', None), None)), None)), None)), None), (('c902885f-f736-435b-8bd8-ed6686c98764', (('04791248-92f5-4245-9a57-72dfbe47d206', (('183e1a95-57d5-42e2-827e-daace5051457', (('c2cfe903-0d98-42f3-acb0-b6e152d82379', None), None)), None)), None)), None)])), None)), None)\n```\nYou can see that a lot of tasks are missing from the tuple in the first couple prints where I used a custom `task_id`. Removing `task_id` fixes this.\n\nAlso, downgrading to celery version 5.3.6 fixes the issue without removing `task_id` from the chain call. \n\n\n\n", "hints_text": "\nMay be this will solve the issue? https://github.com/celery/celery/pull/9713\nYes #9713 could solve this issue... should I update the PR with tests to verify the behavior of chains with custom task ID...\nyou can come with tests to verify that", "created_at": "2026-10-09T11:53:55Z"}
{"repo": "celery/celery", "pull_number": 10828, "instance_id": "celery__celery-10828", "issue_numbers": ["7278"], "base_commit": "22dd36fd85ec72a7542cbcb113336f39079a6e18", "patch": "diff --git a/celery/apps/worker.py b/celery/apps/worker.py\nindex 8cfbeda8295..092450ea95e 100644\n--- a/celery/apps/worker.py\n+++ b/celery/apps/worker.py\n@@ -114,7 +114,6 @@ def on_after_init(self, purge=False, no_color=None,\n             'worker_redirect_stdouts', redirect_stdouts)\n         self.redirect_stdouts_level = self.app.either(\n             'worker_redirect_stdouts_level', redirect_stdouts_level)\n-        super().setup_defaults(**kwargs)\n         self.purge = purge\n         self.no_color = no_color\n         self._isatty = isatty(sys.stdout)\n", "test_patch": "diff --git a/t/unit/apps/test_worker.py b/t/unit/apps/test_worker.py\nindex 2e18ecebaaa..15e9001ea7b 100644\n--- a/t/unit/apps/test_worker.py\n+++ b/t/unit/apps/test_worker.py\n@@ -3,6 +3,7 @@\n import pytest\n \n from celery.apps.worker import Worker\n+from celery.worker import WorkController\n \n \n class test_Worker_purge:\n@@ -70,3 +71,35 @@ def test_purge_falls_back_to_broker_connection_retry(self):\n \n         connection.ensure_connection.assert_called_once()\n         connection.connect.assert_not_called()\n+\n+\n+class test_Worker_setup_defaults:\n+    \"\"\"``setup_defaults`` must only run once per worker.\n+\n+    ``WorkController.__init__`` already calls it, so ``on_after_init`` calling\n+    it again bypassed subclass overrides.\n+    See https://github.com/celery/celery/issues/7278.\n+    \"\"\"\n+\n+    @pytest.fixture(autouse=True)\n+    def _setup_app(self, app):\n+        self.app = app\n+\n+    def test_setup_defaults_called_once(self):\n+        with patch.object(WorkController, 'setup_defaults',\n+                          autospec=True,\n+                          side_effect=WorkController.setup_defaults) as setup_defaults:\n+            Worker(app=self.app, hostname='test@example.com',\n+                   concurrency=2, pool='solo')\n+        setup_defaults.assert_called_once()\n+\n+    def test_setup_defaults_override_is_kept(self):\n+        class CustomWorker(Worker):\n+\n+            def setup_defaults(self, **kwargs):\n+                super().setup_defaults(**kwargs)\n+                self.concurrency = 7\n+\n+        worker = CustomWorker(app=self.app, hostname='test@example.com',\n+                              concurrency=2, pool='solo')\n+        assert worker.concurrency == 7\n", "problem_statement": "Unnecessary duplicate call to WorkerController.setup_defaults() overwrites custom configuration options.\n<!--\r\nPlease fill this template entirely and do not erase parts of it.\r\nWe reserve the right to close without a response\r\nbug reports which are incomplete.\r\n-->\r\n# Checklist\r\n<!--\r\nTo check an item on the list replace [ ] with [x].\r\n-->\r\n- [x] I have verified that the issue exists against the `master` branch of Celery.\r\n- [ ] This has already been asked to the [discussions forum](https://github.com/celery/celery/discussions) first.\r\n- [x] I have read the relevant section in the\r\n  [contribution guide](http://docs.celeryproject.org/en/latest/contributing.html#other-bugs)\r\n  on reporting bugs.\r\n- [x] I have checked the [issues list](https://github.com/celery/celery/issues?q=is%3Aissue+label%3A%22Issue+Type%3A+Bug+Report%22+-label%3A%22Category%3A+Documentation%22)\r\n  for similar or identical bug reports.\r\n- [x] I have checked the [pull requests list](https://github.com/celery/celery/pulls?q=is%3Apr+label%3A%22PR+Type%3A+Bugfix%22+-label%3A%22Category%3A+Documentation%22)\r\n  for existing proposed fixes.\r\n- [X] I have checked the [commit log](https://github.com/celery/celery/commits/master)\r\n  to find out if the bug was already fixed in the master branch.\r\n- [X] I have included all related issues and possible duplicate issues\r\n  in this issue (If there are none, check this box anyway).\r\n\r\n## Mandatory Debugging Information\r\n\r\n- [ ] I have included the output of ``celery -A proj report`` in the issue.\r\n    (if you are not able to do this, then at least specify the Celery\r\n     version affected).\r\n- [X] I have verified that the issue exists against the `master` branch of Celery.\r\n- [ ] I have included the contents of ``pip freeze`` in the issue.\r\n- [X] I have included all the versions of all the external dependencies required\r\n  to reproduce this bug.\r\n\r\n## Optional Debugging Information\r\n<!--\r\nTry some of the below if you think they are relevant.\r\nIt will help us figure out the scope of the bug and how many users it affects.\r\n-->\r\n- [ ] I have tried reproducing the issue on more than one Python version\r\n  and/or implementation.\r\n- [ ] I have tried reproducing the issue on more than one message broker and/or\r\n  result backend.\r\n- [ ] I have tried reproducing the issue on more than one version of the message\r\n  broker and/or result backend.\r\n- [ ] I have tried reproducing the issue on more than one operating system.\r\n- [ ] I have tried reproducing the issue on more than one workers pool.\r\n- [ ] I have tried reproducing the issue with autoscaling, retries,\r\n  ETA/Countdown & rate limits disabled.\r\n- [ ] I have tried reproducing the issue after downgrading\r\n  and/or upgrading Celery and its dependencies.\r\n\r\n## Related Issues and Possible Duplicates\r\n<!--\r\nPlease make sure to search and mention any related issues\r\nor possible duplicates to this issue as requested by the checklist above.\r\n\r\nThis may or may not include issues in other repositories that the Celery project\r\nmaintains or other repositories that are dependencies of Celery.\r\n\r\nIf you don't know how to mention issues, please refer to Github's documentation\r\non the subject: https://help.github.com/en/articles/autolinked-references-and-urls#issues-and-pull-requests\r\n-->\r\n\r\n#### Related Issues\r\n\r\n- None\r\n\r\n#### Possible Duplicates\r\n\r\n- None\r\n\r\n## Environment & Settings\r\n<!-- Include the contents of celery --version below -->\r\n**Celery version**: 5.1.2\r\n<!-- Include the output of celery -A proj report below -->\r\n<details>\r\n<summary><b><code>n/a</code> Output:</b></summary>\r\n<p>\r\n\r\nn/a\r\n\r\n</p>\r\n</details>\r\n\r\n# Steps to Reproduce\r\n\r\n## Required Dependencies\r\n<!-- Please fill the required dependencies to reproduce this issue -->\r\n* **Minimal Python Version**: N/A\r\n* **Minimal Celery Version**: N/A\r\n* **Minimal Kombu Version**: N/A \r\n* **Minimal Broker Version**: N/A \r\n* **Minimal Result Backend Version**: N/A\r\n* **Minimal OS and/or Kernel Version**: N/A\r\n* **Minimal Broker Client Version**: N/A\r\n* **Minimal Result Backend Client Version**: N/A\r\n\r\n### Python Packages\r\n<!-- Please fill the contents of pip freeze below -->\r\n<details>\r\n<summary><b><code>pip freeze</code> Output:</b></summary>\r\n<p>\r\n\r\nn/a\r\n\r\n</p>\r\n</details>\r\n\r\n### Other Dependencies\r\n<!--\r\nPlease provide system dependencies, configuration files\r\nand other dependency information if applicable\r\n-->\r\n<details>\r\n<p>\r\nN/A\r\n</p>\r\n</details>\r\n\r\n## Minimally Reproducible Test Case\r\n<!--\r\nPlease provide a reproducible test case.\r\nRefer to the Reporting Bugs section in our contribution guide.\r\n\r\nWe prefer submitting test cases in the form of a PR to our integration test suite.\r\nIf you can provide one, please mention the PR number below.\r\nIf not, please attach the most minimal code example required to reproduce the issue below.\r\nIf the test case is too large, please include a link to a gist or a repository below.\r\n-->\r\n\r\n<details>\r\n<p>\r\n\r\n```python\r\n```\r\n\r\n</p>\r\n</details>\r\n\r\n# Expected Behavior\r\n<!-- Describe in detail what you expect to happen -->\r\nI would expect the WorkerController.setup_defaults() method to be only called once, after the on_before_init() method is called. \r\n\r\n# Actual Behavior\r\n<!--\r\nDescribe in detail what actually happened.\r\nPlease include a backtrace and surround it with triple backticks (```).\r\nIn addition, include the Celery daemon logs, the broker logs,\r\nthe result backend logs and system logs below if they will help us debug\r\nthe issue.\r\n-->\r\n\r\nInstead of the expected behaviour, the method is again called in celery.apps.worker.Worker.on_after_init(), using the same, unmodified kwargs. This results in some parsing to compare instance attributes to items from self.app.config to be performed twice, which results in some values to be ignored or overwritten. \r\n\r\nIt seems to me this issue was introduced way back in 2013 with this commit https://github.com/celery/celery/commit/2a1b6b92f386de48b1e4d5bfb226603343c4f7d8 \r\nYou can see here that the method is now called twice, without any apparent reason behind that. \r\n\n", "hints_text": "Hey @afittkau :wave:,\nThank you for opening an issue. We will get back to you as soon as we can.\nAlso, check out our [Open Collective](https://opencollective.com/celery) and consider backing us - every little helps!\n\nWe also offer priority support for our sponsors.\nIf you require immediate assistance please consider sponsoring us.\n\ncan you work on fixing this? thanks for tracking down the old commit", "created_at": "2026-10-09T04:23:13Z"}
{"repo": "celery/celery", "pull_number": 10827, "instance_id": "celery__celery-10827", "issue_numbers": ["4207"], "base_commit": "e39d0313e6cb80578c313e90a3b05c72417363d5", "patch": "diff --git a/celery/app/defaults.py b/celery/app/defaults.py\nindex a72d54b994e..da0078fc7e8 100644\n--- a/celery/app/defaults.py\n+++ b/celery/app/defaults.py\n@@ -219,6 +219,7 @@ def __repr__(self):\n             timedelta(days=1),\n             type='float', old={'celery_task_result_expires'},\n         ),\n+        chord_expires=Option(None, type='float'),\n         persistent=Option(None, type='bool'),\n         extended=Option(False, type='bool'),\n         serializer=Option('json'),\ndiff --git a/celery/backends/redis.py b/celery/backends/redis.py\nindex 2b7fe8e54d7..3ea3487f9c4 100644\n--- a/celery/backends/redis.py\n+++ b/celery/backends/redis.py\n@@ -399,6 +399,7 @@ def __init__(self, host=None, port=None, db=None, password=None,\n                  connection_pool=None, **kwargs):\n         super().__init__(expires_type=int, **kwargs)\n         _get = self.app.conf.get\n+        self._chord_expires = _get('result_chord_expires')\n         if self.redis is None:\n             raise ImproperlyConfigured(E_REDIS_MISSING.strip())\n \n@@ -741,8 +742,20 @@ def _unpack_chord_result(self, tup, decode,\n             raise chord_error\n         return retval\n \n+    @property\n+    def chord_expires(self):\n+        if self._chord_expires is None:\n+            return self.expires\n+        return self.prepare_expires(self._chord_expires, type=int)\n+\n+    def _set_chord_key(self, key, value):\n+        if isinstance(value, str) and len(value) > self._MAX_STR_VALUE_SIZE:\n+            raise BackendStoreError('value too large for Redis backend')\n+        set_key = partial(self.client.set, ex=self.chord_expires or None)\n+        return self.ensure(set_key, (key, value))\n+\n     def set_chord_size(self, group_id, chord_size):\n-        self.set(self.get_key_for_group(group_id, '.s'), chord_size)\n+        self._set_chord_key(self.get_key_for_group(group_id, '.s'), chord_size)\n \n     def apply_chord(self, header_result_args, body, **kwargs):\n         # If any of the child results of this chord are complex (ie. group\n@@ -754,7 +767,9 @@ def apply_chord(self, header_result_args, body, **kwargs):\n         if not isinstance(header_result_args[1], _regen):\n             header_result = self.app.GroupResult(*header_result_args)\n             if any(isinstance(nr, GroupResult) for nr in header_result.results):\n-                header_result.save(backend=self)\n+                self._set_chord_key(\n+                    self.get_key_for_group(header_result.id),\n+                    self.encode({'result': header_result.as_tuple()}))\n \n     @cached_property\n     def _chord_zset(self):\n@@ -785,11 +800,17 @@ def on_chord_part_return(self, request, state, result,\n                 if self._chord_zset\n                 else pipe.rpush(jkey, encoded).llen(jkey)\n             ).get(tkey).get(skey)\n-            if self.expires:\n+            expires = self.chord_expires\n+            if expires:\n                 pipeline = pipeline \\\n-                    .expire(jkey, self.expires) \\\n-                    .expire(tkey, self.expires) \\\n-                    .expire(skey, self.expires)\n+                    .expire(jkey, expires) \\\n+                    .expire(tkey, expires) \\\n+                    .expire(skey, expires)\n+                if self.expires:\n+                    # The group key can also hold a GroupResult the user\n+                    # saved, so never shorten it below result_expires.\n+                    pipeline = pipeline.expire(\n+                        self.get_key_for_group(gid), max(expires, self.expires))\n \n             _, readycount, totaldiff, chord_size_bytes = pipeline.execute()[:4]\n \ndiff --git a/docs/userguide/canvas.rst b/docs/userguide/canvas.rst\nindex 01cf41bf08f..c2ccb9e96df 100644\n--- a/docs/userguide/canvas.rst\n+++ b/docs/userguide/canvas.rst\n@@ -1065,6 +1065,10 @@ Example decorated task:\n     def another_task(project):\n         do_something()\n \n+A chord whose header tasks take longer than :setting:`result_expires` can\n+lose its bookkeeping, and its body then never runs. Set\n+:setting:`result_chord_expires` for chords that run that long.\n+\n By default the synchronization step is implemented by having a recurring task\n poll the completion of the group every second, calling the signature when\n ready.\ndiff --git a/docs/userguide/configuration.rst b/docs/userguide/configuration.rst\nindex 5b4cde24a62..a1583d5d175 100644\n--- a/docs/userguide/configuration.rst\n+++ b/docs/userguide/configuration.rst\n@@ -1041,6 +1041,31 @@ on backend specifications).\n     When using the database or filesystem backend, ``celery beat`` must be\n     running for the results to be expired.\n \n+See :setting:`result_chord_expires` for chords whose header tasks run longer\n+than this.\n+\n+.. setting:: result_chord_expires\n+\n+``result_chord_expires``\n+~~~~~~~~~~~~~~~~~~~~~~~~\n+\n+.. versionadded:: 5.7\n+\n+Default: Same as :setting:`result_expires`.\n+\n+Time (in seconds, or a :class:`~datetime.timedelta` object) a chord's\n+bookkeeping is kept after the chord starts or after one of its header tasks\n+finishes. If it runs out before the next header task finishes, the chord's\n+body never runs, so set it longer than the slowest header task.\n+A value of 0 means the chord's bookkeeping never expires while the chord is\n+open, and the saved header of a chord with nested groups never expires.\n+The bookkeeping of a chord that never completes, for example after a lost\n+header task, is then never removed.\n+\n+.. note::\n+\n+    For the moment this only works with the Redis backend.\n+\n .. setting:: result_cache_max\n \n ``result_cache_max``\n", "test_patch": "diff --git a/t/integration/test_redis_backend.py b/t/integration/test_redis_backend.py\nindex 0cd616c5750..6b47a510172 100644\n--- a/t/integration/test_redis_backend.py\n+++ b/t/integration/test_redis_backend.py\n@@ -1,8 +1,10 @@\n import threading\n+from types import SimpleNamespace\n \n import pytest\n \n from celery import states, uuid\n+from celery.result import AsyncResult, GroupResult\n from t.integration.conftest import get_active_redis_channels\n from t.integration.tasks import identity\n \n@@ -205,3 +207,27 @@ def run():\n         channel for channel in get_active_redis_channels()\n         if channel.startswith(b'celery-task-meta-')]\n     assert meta_channels == []\n+\n+\n+@pytest.mark.celery(result_expires=60, result_chord_expires=600)\n+def test_chord_expires(app):\n+    if not app.conf.result_backend.startswith('redis'):\n+        pytest.skip('Requires redis result backend.')\n+\n+    backend = app.backend\n+    group_id = uuid()\n+    header = GroupResult(group_id, [GroupResult(uuid(), [AsyncResult(uuid())])])\n+    request = SimpleNamespace(id=uuid(), group=group_id, group_index=0, chord=None)\n+    keys = [backend.get_key_for_group(group_id, suffix)\n+            for suffix in ('', '.j', '.s')]\n+    try:\n+        backend.apply_chord((group_id, header.results), None)\n+        backend.set_chord_size(group_id, 2)\n+        assert 60 < backend.client.ttl(keys[2]) <= 600\n+        backend.on_chord_part_return(request, states.SUCCESS, 1)\n+\n+        for key in keys:\n+            assert 60 < backend.client.ttl(key) <= 600\n+        assert GroupResult.restore(group_id, backend=backend) == header\n+    finally:\n+        backend.client.delete(*keys)\ndiff --git a/t/unit/backends/test_redis.py b/t/unit/backends/test_redis.py\nindex 5b39ee36eaf..7b7dd9cf1d7 100644\n--- a/t/unit/backends/test_redis.py\n+++ b/t/unit/backends/test_redis.py\n@@ -114,8 +114,10 @@ def setex(self, key, expires, value):\n         self.set(key, value)\n         self.expire(key, expires)\n \n-    def set(self, key, value):\n+    def set(self, key, value, ex=None):\n         self.keyspace[key] = value\n+        if ex:\n+            self.expire(key, ex)\n \n     def expire(self, key, expires):\n         self.expiry[key] = expires\n@@ -1920,7 +1922,21 @@ def test_set_chord_size(self):\n         b = self.Backend('redis://', app=self.app)\n         gid = uuid()\n         b.set_chord_size(gid, 10)\n-        b.client.set.assert_called_with(b.get_key_for_group(gid, '.s'), 10)\n+        b.client.set.assert_called_with(\n+            b.get_key_for_group(gid, '.s'), 10, ex=86400)\n+\n+    @pytest.mark.parametrize('chord_expires,ex', [\n+        (600, 600),\n+        (timedelta(hours=1), 3600),\n+        (0, None),\n+    ])\n+    def test_set_chord_size_uses_chord_expires(self, chord_expires, ex):\n+        self.app.conf.result_chord_expires = chord_expires\n+        b = self.Backend('redis://', app=self.app)\n+        gid = uuid()\n+        b.set_chord_size(gid, 10)\n+        b.client.set.assert_called_with(\n+            b.get_key_for_group(gid, '.s'), 10, ex=ex)\n \n     def test_expires_is_None(self):\n         b = self.Backend(expires=None, app=self.app)\n@@ -2143,6 +2159,33 @@ def test_on_chord_part_return(self):\n             call(jkey, 86400), call(tkey, 86400), call(skey, 86400),\n         ])\n \n+    @pytest.mark.parametrize('result_expires,group_expires', [\n+        (100, 600),\n+        (86400, 86400),\n+        (None, None),\n+    ])\n+    def test_on_chord_part_return_uses_chord_expires(\n+            self, result_expires, group_expires):\n+        self.app.conf.result_expires = result_expires\n+        self.app.conf.result_chord_expires = 600\n+        self.b = self.Backend(app=self.app)\n+        task = self.create_task(0)\n+        self.b.client.expire.reset_mock()\n+        self.b.on_chord_part_return(task.request, states.SUCCESS, 0)\n+        jkey = self.b.get_key_for_group('group_id', '.j')\n+        tkey = self.b.get_key_for_group('group_id', '.t')\n+        skey = self.b.get_key_for_group('group_id', '.s')\n+        gkey = self.b.get_key_for_group('group_id')\n+        expected = [call(jkey, 600), call(tkey, 600), call(skey, 600)]\n+        if group_expires:\n+            expected.append(call(gkey, group_expires))\n+        assert self.b.client.expire.call_args_list == expected\n+\n+    def test_set_chord_key_raises_error_on_large_value(self):\n+        with pytest.raises(BackendStoreError):\n+            self.b._set_chord_key(\n+                'key', 'x' * (self.b._MAX_STR_VALUE_SIZE + 1))\n+\n     def test_on_chord_part_return__unordered(self):\n         self.app.conf.result_backend_transport_options = dict(\n             result_chord_ordered=False,\n@@ -2329,7 +2372,7 @@ def test_on_chord_part_return__ChordError(self):\n             self.b.client.pipeline = ContextMock()\n             raise_on_second_call(self.b.client.pipeline, ChordError())\n             self.b.client.pipeline.return_value.zadd().zcount().get().get().expire(\n-            ).expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n+            ).expire().expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n             task = self.app._tasks['add'] = Mock(name='add_task')\n             self.b.on_chord_part_return(request, states.SUCCESS, 10)\n             task.backend.fail_from_current_stack.assert_called_with(\n@@ -2345,7 +2388,7 @@ def test_on_chord_part_return__ChordError__unordered(self):\n             self.b.client.pipeline = ContextMock()\n             raise_on_second_call(self.b.client.pipeline, ChordError())\n             self.b.client.pipeline.return_value.rpush().llen().get().get().expire(\n-            ).expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n+            ).expire().expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n             task = self.app._tasks['add'] = Mock(name='add_task')\n             self.b.on_chord_part_return(request, states.SUCCESS, 10)\n             task.backend.fail_from_current_stack.assert_called_with(\n@@ -2361,7 +2404,7 @@ def test_on_chord_part_return__ChordError__ordered(self):\n             self.b.client.pipeline = ContextMock()\n             raise_on_second_call(self.b.client.pipeline, ChordError())\n             self.b.client.pipeline.return_value.zadd().zcount().get().get().expire(\n-            ).expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n+            ).expire().expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n             task = self.app._tasks['add'] = Mock(name='add_task')\n             self.b.on_chord_part_return(request, states.SUCCESS, 10)\n             task.backend.fail_from_current_stack.assert_called_with(\n@@ -2373,7 +2416,7 @@ def test_on_chord_part_return__other_error(self):\n             self.b.client.pipeline = ContextMock()\n             raise_on_second_call(self.b.client.pipeline, RuntimeError())\n             self.b.client.pipeline.return_value.zadd().zcount().get().get().expire(\n-            ).expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n+            ).expire().expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n             task = self.app._tasks['add'] = Mock(name='add_task')\n             self.b.on_chord_part_return(request, states.SUCCESS, 10)\n             task.backend.fail_from_current_stack.assert_called_with(\n@@ -2389,7 +2432,7 @@ def test_on_chord_part_return__other_error__unordered(self):\n             self.b.client.pipeline = ContextMock()\n             raise_on_second_call(self.b.client.pipeline, RuntimeError())\n             self.b.client.pipeline.return_value.rpush().llen().get().get().expire(\n-            ).expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n+            ).expire().expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n             task = self.app._tasks['add'] = Mock(name='add_task')\n             self.b.on_chord_part_return(request, states.SUCCESS, 10)\n             task.backend.fail_from_current_stack.assert_called_with(\n@@ -2405,7 +2448,7 @@ def test_on_chord_part_return__other_error__ordered(self):\n             self.b.client.pipeline = ContextMock()\n             raise_on_second_call(self.b.client.pipeline, RuntimeError())\n             self.b.client.pipeline.return_value.zadd().zcount().get().get().expire(\n-            ).expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n+            ).expire().expire().expire().execute.return_value = (1, 1, 0, b'1', 4, 5, 6)\n             task = self.app._tasks['add'] = Mock(name='add_task')\n             self.b.on_chord_part_return(request, states.SUCCESS, 10)\n             task.backend.fail_from_current_stack.assert_called_with(\n@@ -2439,14 +2482,27 @@ def complex_header_result(self):\n     ])\n     def test_apply_chord_complex_header(self, results, assert_save_called):\n         mock_group_result = Mock()\n+        mock_group_result.return_value.id = \"gid11\"\n         mock_group_result.return_value.results = results\n+        mock_group_result.return_value.as_tuple.return_value = ((\"gid11\", None), [])\n         self.app.GroupResult = mock_group_result\n         header_result_args = (\"gid11\", results)\n         self.b.apply_chord(header_result_args, None)\n         if assert_save_called:\n-            mock_group_result.return_value.save.assert_called_once_with(backend=self.b)\n+            self.b.client.set.assert_called_once_with(\n+                self.b.get_key_for_group(\"gid11\"),\n+                self.b.encode({\"result\": ((\"gid11\", None), [])}),\n+                ex=86400,\n+            )\n         else:\n-            mock_group_result.return_value.save.assert_not_called()\n+            self.b.client.set.assert_not_called()\n+\n+    def test_apply_chord_complex_header_uses_chord_expires(self):\n+        self.app.conf.result_chord_expires = 600\n+        self.b = self.Backend(app=self.app)\n+        self.b.apply_chord((\"gid11\", (GroupResult(\"foo\", []),)), None)\n+        _, kwargs = self.b.client.set.call_args\n+        assert kwargs == {\"ex\": 600}\n \n     def test_on_chord_part_return_timeout(self, complex_header_result):\n         tasks = [self.create_task(i) for i in range(10)]\n", "problem_statement": "Chord body will not be called if result_expires is too low\n## Checklist\n* [x] I have included the output of ``celery -A proj report`` in the issue.\n      (if you are not able to do this, then at least specify the Celery\n       version affected).\n\nsoftware -> celery:4.0.2 (latentcall) kombu:4.0.2 py:2.7.12\n            billiard:3.5.0.2 redis:2.10.5\nplatform -> system:Linux arch:64bit, ELF imp:CPython\nloader   -> celery.loaders.app.AppLoader\nsettings -> transport:redis results:redis://localhost:6379/\n\nBROKER_TRANSPORT_OPTIONS: {\n    'fanout_patterns': True, 'fanout_prefix': True}\nCELERY_TASK_COMPRESSION: 'gzip'\nCELERY_RESULT_SERIALIZER: 'json'\nCELERY_BROKER_URL: u'redis://localhost:6379//'\nDEBUG_PROPAGATE_EXCEPTIONS: False\nCELERY_ACCEPT_CONTENT: ['application/json']\nCELERY_TIMEZONE: 'UTC'\nCELERY_MESSAGE_COMPRESSION: 'gzip'\nUSE_TZ: True\nCELERY_RESULT_BACKEND: u'redis://localhost:6379/'\nCELERY_FLOWER_URL: 'http://localhost:5556'\n\n\n* [x] I have verified that the issue exists against the `master` branch of Celery.\nI do not have the time resource to test different versions of celery while at work. This project is at work and I have other things to do while worrying about callbacks not being queued/called. If I do get time to test on master, I will.\n\n## Steps to reproduce\nRun about 100 task header of a chord, with a callback. The chord is started through `.delay()`.\nUsage is similar to what the docs have:\n`chord((import_contact.s(c) for c in contacts), notify_complete.si(import_id)).apply_async()`. In my case, I do not use an immutable signature, and i pass many `kwargs` into the callback/body.\n\n\n## Expected behavior\nI expect that once my header has completed, that the callback will run.\n\n\n## Actual behavior\nDepending on how long the header tasks run for, the callback is not called. I'm still trying to figure out if it is a time or memory or other sort of issue. But, I wanted to get the issue created while I'm looking through it further.\n\nIt's also possible that it doesn't have to do with how long it takes at all. I'll try updating further.\n\n\n", "hints_text": "If you could verify this again on top of latest master plz ping me to reopen\nMy new leading hypothesis is that this is related to my project's use of `result_expires`. We used to have this set at 60 seconds, and now we have it at 10 seconds.\r\n\r\nTonight I decided to revisit this (we're using celery `4.2.0`). There are a few workflows that would benefit us from having this work _all_ of the time; we've been hesitant to utilize the `chord` because we were having issues with it running the body all the time.\r\n\r\nNow, if we have, say, 1 task, and we have a header of 2 of them being called (say `add` each), and then let the body also be an `add`, if we lower the result expire to 1 second, and also include a `time.sleep(2)` in the `add` implementation, I've never seen the `body` task run.\r\n\r\nPlaying with the result expires and the \"task time\" (fake long task with a time.sleep) seems like the culprit.\r\n\r\nThere is documentation around result expires, however, if this is the issue for the `redis` backend, then the docs should warn against setting a low task expire results time, in the case of a `chord`.\r\n\r\nAt this point, I'm fairly confident that this is the bug.\r\nBelow is the section of code which introduces the notion of the adjusted completed task count.\r\nWhen I add more logs around the readycount vs total (chord_size), and when I see the issue rear its head, its because it never reaches the `total`. You'll note the `self.expires`\r\n```        with client.pipeline() as pipe:\r\n            _, readycount, totaldiff, _, _ = pipe \\\r\n                .rpush(jkey, self.encode([1, tid, state, result])) \\\r\n                .llen(jkey) \\\r\n                .get(tkey) \\\r\n                .expire(jkey, self.expires) \\\r\n                .expire(tkey, self.expires) \\\r\n                .execute()\r\n```\r\n\r\nAnd `self.expires` gets its value from:\r\n```    def prepare_expires(self, value, type=None):\r\n        if value is None:\r\n            value = self.app.conf.result_expires\r\n        if isinstance(value, timedelta):\r\n            value = value.total_seconds()\r\n        if value is not None and type:\r\n            return type(value)\r\n        return value\r\n```\r\n\r\n\r\nSo, I wonder, should the tkey and jkey be honoring the result expires (or at least, the one set in the config, as opposed to the `day` default)? Is there any harm in having it be no less than 1 day, or perhaps, making it its own setting?\r\n\r\nOr, is this really just a documentation update to help users?\n@auvipy please see above.\nWould it be possible to have a per-task (possibly even on `chord`, too) result expires setting? My team would be very interested in that usage.\r\n\r\nWe don't care about most of the results of our task runs (in practice), but we don't necessarily wish to always use `ignore_result`, especially if we need the task result around at least briefly but we forget about the global setting.\n> Would it be possible to have a per-task (possibly even on `chord`, too) result expires setting? My team would be very interested in that usage.\r\n> \r\n> We don't care about most of the results of our task runs (in practice), but we don't necessarily wish to always use `ignore_result`, especially if we need the task result around at least briefly but we forget about the global setting.\r\n\r\nwhen you have time can you revisit the current codes & share your current consensus on that? we can dig further based on your finding. I know it so old & sorry for taking so long to reply.\nThis still reproduces on 5.6.3 with the Redis backend. A chord of three tasks that each sleep 3 seconds, on a single worker with `result_expires=1`, never runs its body. With `result_expires=60` it runs.\n\nThe cause looks like `on_chord_part_return`: each finished header task resets the chord's `.j`, `.t` and `.s` keys to expire after `result_expires`. If the gap between two header tasks finishing is longer than that, the keys are gone and the body never fires. `main` has the same code.\n\nOne narrow fix would be to keep those keys until the body is sent. They're already deleted at that point, so no expiry is needed while the chord is open. Another option is a separate expiry for chord keys. Would either be welcome? Happy to send a PR with tests.\ncan you reproduce with v5.7.0b1?\nYes, it still reproduces on 5.7.0b1 with the same chord setup. I can send a PR.", "created_at": "2026-10-09T00:17:46Z"}
{"repo": "celery/celery", "pull_number": 10822, "instance_id": "celery__celery-10822", "issue_numbers": ["10821"], "base_commit": "8a2f387233e6e82a3b59d05e929878a302d26df8", "patch": "diff --git a/celery/app/utils.py b/celery/app/utils.py\nindex ddbebd1472a..6039873ff74 100644\n--- a/celery/app/utils.py\n+++ b/celery/app/utils.py\n@@ -335,6 +335,40 @@ def _unpickle_app_v2(cls, kwargs):\n     return cls(**kwargs)\n \n \n+def _redact_azure_connection_string(connection_string, mask='**'):\n+    \"\"\"Redact sensitive credentials in Azure Storage connection strings.\n+\n+    Azure connection strings use semicolon-separated key=value pairs.\n+    This function redacts known secret keys while preserving other fields.\n+\n+    Args:\n+        connection_string: The Azure connection string to redact.\n+        mask: The mask string to replace secrets with (default: '**').\n+\n+    Returns:\n+        The redacted connection string with AccountKey and SharedAccessSignature\n+        values replaced by the mask.\n+    \"\"\"\n+    # Azure matches connection string keys case-insensitively\n+    secret_keys = {'accountkey', 'sharedaccesssignature'}\n+    redacted_parts = []\n+    for part in connection_string.split(';'):\n+        key, sep, value = part.partition('=')\n+        if sep and key.strip().lower() in secret_keys:\n+            # Redact the entire value of secret keys\n+            part = f'{key}={mask}'\n+        else:\n+            # Redact sig parameters in endpoint URLs (case-insensitive)\n+            # Pattern: (?|&)sig=VALUE, preserving the parameter name and separator\n+            if value:\n+                # Use case-insensitive regex to find and redact sig parameters\n+                value = re.sub(r'([?&]sig=)[^&;#]*', r'\\1' + mask, value, flags=re.IGNORECASE)\n+                part = f'{key}={value}'\n+        redacted_parts.append(part)\n+\n+    return ';'.join(redacted_parts)\n+\n+\n def sanitize_url(url, mask='*' * 8):\n     \"\"\"Sanitize URL, masking passwords.\n \n@@ -345,6 +379,7 @@ def sanitize_url(url, mask='*' * 8):\n     - Redis Sentinel multi-node URLs (e.g. ``sentinel://:secret@h1:26379;sentinel://:secret@h2:26379/0``\n       or ``sentinel://:secret@h1:26379;h2:26379/0``)\n     - URLs with query strings containing semicolons (e.g. ``redis://user:secret@localhost:6379?a=1;b=2``)\n+    - Azure Storage connection strings (e.g. ``azureblockblob://AccountKey=SECRET;...``)\n \n     Fails closed on malformed URLs to prevent credential leakage.\n     \"\"\"\n@@ -368,6 +403,15 @@ def _mask_uinfo(uinfo):\n \n         scheme, _, rest = url.partition('://')\n \n+        # Azure connection strings use semicolon-separated key=value pairs\n+        # Handle them specially before generic URL parsing\n+        if scheme == 'azureblockblob':\n+            # For Azure, treat the entire remainder as the connection string\n+            # Azure connection strings can contain ? and # within SAS tokens or endpoint URLs\n+            # so we must not split at these characters\n+            redacted_connection_string = _redact_azure_connection_string(rest, mask=mask)\n+            return f'{scheme}://{redacted_connection_string}'\n+\n         # Separate authority from path/query/fragment\n         idx = len(rest)\n         for sep in ('/', '?', '#'):\ndiff --git a/celery/backends/azureblockblob.py b/celery/backends/azureblockblob.py\nindex 3ab0a9fc8e6..9560a5d564c 100644\n--- a/celery/backends/azureblockblob.py\n+++ b/celery/backends/azureblockblob.py\n@@ -3,6 +3,7 @@\n from kombu.utils import cached_property\n from kombu.utils.encoding import bytes_to_str\n \n+from celery.app.utils import _redact_azure_connection_string\n from celery.exceptions import ImproperlyConfigured\n from celery.utils.log import get_logger\n \n@@ -188,17 +189,12 @@ def as_uri(self, include_password=False):\n                 f'{self._connection_string}'\n             )\n \n-        # Azure matches connection string keys case-insensitively, and a\n-        # SharedAccessSignature is as much a secret as an AccountKey.\n-        secret_keys = {'accountkey', 'sharedaccesssignature'}\n-        redacted_connection_string_parts = []\n-        for part in self._connection_string.split(';'):\n-            key, sep, _ = part.partition('=')\n-            if sep and key.strip().lower() in secret_keys:\n-                part = f'{key}=**'\n-            redacted_connection_string_parts.append(part)\n+        # Use shared helper to redact Azure connection string secrets\n+        redacted_connection_string = _redact_azure_connection_string(\n+            self._connection_string, mask='**'\n+        )\n \n         return (\n             f'{AZURE_BLOCK_BLOB_CONNECTION_PREFIX}'\n-            f'{\";\".join(redacted_connection_string_parts)}'\n+            f'{redacted_connection_string}'\n         )\n", "test_patch": "diff --git a/t/unit/app/test_utils.py b/t/unit/app/test_utils.py\nindex 72faa58dd64..d5507b440f2 100644\n--- a/t/unit/app/test_utils.py\n+++ b/t/unit/app/test_utils.py\n@@ -127,6 +127,76 @@ def test_censors_multiserver_backend_url(self):\n         assert 'user:********@172.19.26.240:11211' in censored['result_backend']\n         assert 'user:********@172.19.26.242:11211' in censored['result_backend']\n \n+    def test_censors_azure_account_key_in_backend_url(self):\n+        conf = {\n+            'result_backend': (\n+                'azureblockblob://'\n+                'DefaultEndpointsProtocol=https;'\n+                'AccountName=acct;'\n+                'AccountKey=SECRET==;'\n+                'EndpointSuffix=core.windows.net'\n+            ),\n+        }\n+        censored = filter_hidden_settings(conf)\n+        assert 'SECRET==' not in censored['result_backend']\n+        assert 'AccountKey=********' in censored['result_backend']\n+\n+    def test_censors_azure_shared_access_signature_in_backend_url(self):\n+        conf = {\n+            'result_backend': (\n+                'azureblockblob://'\n+                'BlobEndpoint=https://name.blob.core.windows.net/;'\n+                'SharedAccessSignature=sv=2022-11-02&sig=signature'\n+            ),\n+        }\n+        censored = filter_hidden_settings(conf)\n+        assert 'signature' not in censored['result_backend']\n+        assert 'SharedAccessSignature=********' in censored['result_backend']\n+\n+    def test_censors_azure_sas_token_beginning_with_question_mark(self):\n+        \"\"\"Test that SAS tokens beginning with ? are fully redacted in filter_hidden_settings.\"\"\"\n+        conf = {\n+            'result_backend': (\n+                'azureblockblob://'\n+                'DefaultEndpointsProtocol=https;'\n+                'AccountName=acct;'\n+                'SharedAccessSignature=?sv=2022-11-02&sig=SECRET'\n+            ),\n+        }\n+        censored = filter_hidden_settings(conf)\n+        assert 'SECRET' not in censored['result_backend']\n+        assert 'sv=2022-11-02' not in censored['result_backend']\n+        assert 'SharedAccessSignature=********' in censored['result_backend']\n+\n+    def test_censors_azure_sas_signature_in_blob_endpoint(self):\n+        \"\"\"Test that sig parameters in BlobEndpoint are redacted in filter_hidden_settings.\"\"\"\n+        conf = {\n+            'result_backend': (\n+                'azureblockblob://'\n+                'BlobEndpoint=https://acct.blob.core.windows.net/?sv=2022-11-02&sig=SECRET;'\n+                'AccountName=acct'\n+            ),\n+        }\n+        censored = filter_hidden_settings(conf)\n+        assert 'SECRET' not in censored['result_backend']\n+        assert 'sig=********' in censored['result_backend']\n+        assert 'sv=2022-11-02' in censored['result_backend']\n+\n+    def test_censors_azure_account_key_containing_hash(self):\n+        \"\"\"Test that AccountKey values containing # are fully redacted in filter_hidden_settings.\"\"\"\n+        conf = {\n+            'result_backend': (\n+                'azureblockblob://'\n+                'AccountName=acct;'\n+                'AccountKey=SEC#RET;'\n+                'EndpointSuffix=core.windows.net'\n+            ),\n+        }\n+        censored = filter_hidden_settings(conf)\n+        assert 'SEC#RET' not in censored['result_backend']\n+        assert 'RET' not in censored['result_backend']\n+        assert 'AccountKey=********' in censored['result_backend']\n+\n \n class test_bugreport:\n \n@@ -169,6 +239,66 @@ def test_bugreport_with_redis_password_containing_both_comma_and_at(self):\n         assert 'p,a@ss' not in report_user\n         assert 'redis://user:********@localhost:6379/0' in report_user\n \n+    def test_bugreport_with_azure_account_key(self):\n+        self.app.conf.result_backend = (\n+            'azureblockblob://'\n+            'DefaultEndpointsProtocol=https;'\n+            'AccountName=acct;'\n+            'AccountKey=SECRET==;'\n+            'EndpointSuffix=core.windows.net'\n+        )\n+        report = bugreport(self.app)\n+        assert 'SECRET==' not in report\n+        assert 'AccountKey=********' in report\n+\n+    def test_bugreport_with_azure_shared_access_signature(self):\n+        self.app.conf.result_backend = (\n+            'azureblockblob://'\n+            'BlobEndpoint=https://name.blob.core.windows.net/;'\n+            'SharedAccessSignature=sv=2022-11-02&sig=signature'\n+        )\n+        report = bugreport(self.app)\n+        assert 'signature' not in report\n+        assert 'SharedAccessSignature=********' in report\n+\n+    def test_bugreport_with_azure_sas_token_beginning_with_question_mark(self):\n+        \"\"\"Test that SAS tokens beginning with ? are fully redacted in bugreport.\"\"\"\n+        self.app.conf.result_backend = (\n+            'azureblockblob://'\n+            'DefaultEndpointsProtocol=https;'\n+            'AccountName=acct;'\n+            'SharedAccessSignature=?sv=2022-11-02&sig=SECRET'\n+        )\n+        report = bugreport(self.app)\n+        assert 'SECRET' not in report\n+        assert 'sv=2022-11-02' not in report\n+        assert 'SharedAccessSignature=********' in report\n+\n+    def test_bugreport_with_azure_sas_signature_in_blob_endpoint(self):\n+        \"\"\"Test that sig parameters in BlobEndpoint are redacted in bugreport.\"\"\"\n+        self.app.conf.result_backend = (\n+            'azureblockblob://'\n+            'BlobEndpoint=https://acct.blob.core.windows.net/?sv=2022-11-02&sig=SECRET;'\n+            'AccountName=acct'\n+        )\n+        report = bugreport(self.app)\n+        assert 'SECRET' not in report\n+        assert 'sig=********' in report\n+        assert 'sv=2022-11-02' in report\n+\n+    def test_bugreport_with_azure_account_key_containing_hash(self):\n+        \"\"\"Test that AccountKey values containing # are fully redacted in bugreport.\"\"\"\n+        self.app.conf.result_backend = (\n+            'azureblockblob://'\n+            'AccountName=acct;'\n+            'AccountKey=SEC#RET;'\n+            'EndpointSuffix=core.windows.net'\n+        )\n+        report = bugreport(self.app)\n+        assert 'SEC#RET' not in report\n+        assert 'RET' not in report\n+        assert 'AccountKey=********' in report\n+\n \n class test_sanitize_url:\n \n@@ -296,3 +426,119 @@ def test_sentinel_mixed_auth_with_empty_chunk(self):\n         url = 'sentinel://u1:p1@h1:26379;;h2:26379;u3:p3@h3:26379/0'\n         expected = 'sentinel://u1:********@h1:26379;h2:26379;u3:********@h3:26379/0'\n         assert sanitize_url(url) == expected\n+\n+    def test_azure_connection_string_account_key_redaction(self):\n+        url = (\n+            'azureblockblob://'\n+            'DefaultEndpointsProtocol=https;'\n+            'AccountName=acct;'\n+            'AccountKey=SECRET==;'\n+            'EndpointSuffix=core.windows.net'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET==' not in sanitized\n+        assert 'AccountName=acct' in sanitized\n+        assert 'EndpointSuffix=core.windows.net' in sanitized\n+        assert 'AccountKey=********' in sanitized\n+\n+    def test_azure_connection_string_shared_access_signature_redaction(self):\n+        url = (\n+            'azureblockblob://'\n+            'BlobEndpoint=https://name.blob.core.windows.net/;'\n+            'SharedAccessSignature=sv=2022-11-02&sig=signature'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'signature' not in sanitized\n+        assert 'SharedAccessSignature=********' in sanitized\n+        assert 'BlobEndpoint=https://name.blob.core.windows.net/' in sanitized\n+\n+    def test_azure_connection_string_case_insensitive_key(self):\n+        url = (\n+            'azureblockblob://'\n+            'AccountName=name;'\n+            'accountkey=SECRET'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET' not in sanitized\n+        assert 'accountkey=********' in sanitized\n+\n+    def test_azure_connection_string_uppercase_key(self):\n+        url = (\n+            'azureblockblob://'\n+            'AccountName=name;'\n+            'ACCOUNTKEY=SECRET'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET' not in sanitized\n+        assert 'ACCOUNTKEY=********' in sanitized\n+\n+    def test_azure_sas_token_beginning_with_question_mark(self):\n+        \"\"\"Test that SAS tokens beginning with ? are fully redacted.\"\"\"\n+        url = (\n+            'azureblockblob://'\n+            'DefaultEndpointsProtocol=https;'\n+            'AccountName=acct;'\n+            'SharedAccessSignature=?sv=2022-11-02&sig=SECRET'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET' not in sanitized\n+        assert 'sv=2022-11-02' not in sanitized\n+        assert 'sig=SECRET' not in sanitized\n+        assert 'SharedAccessSignature=********' in sanitized\n+        assert 'AccountName=acct' in sanitized\n+\n+    def test_azure_sas_signature_in_blob_endpoint(self):\n+        \"\"\"Test that sig parameters in BlobEndpoint URLs are redacted.\"\"\"\n+        url = (\n+            'azureblockblob://'\n+            'BlobEndpoint=https://acct.blob.core.windows.net/?sv=2022-11-02&sig=SECRET;'\n+            'AccountName=acct'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET' not in sanitized\n+        assert 'sig=********' in sanitized\n+        assert 'sv=2022-11-02' in sanitized\n+        assert 'BlobEndpoint=https://acct.blob.core.windows.net/' in sanitized\n+        assert 'AccountName=acct' in sanitized\n+\n+    def test_azure_account_key_containing_hash(self):\n+        \"\"\"Test that AccountKey values containing # are fully redacted.\"\"\"\n+        url = (\n+            'azureblockblob://'\n+            'AccountName=acct;'\n+            'AccountKey=SEC#RET;'\n+            'EndpointSuffix=core.windows.net'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SEC#RET' not in sanitized\n+        assert 'RET' not in sanitized\n+        assert 'AccountKey=********' in sanitized\n+        assert 'AccountName=acct' in sanitized\n+        assert 'EndpointSuffix=core.windows.net' in sanitized\n+\n+    def test_azure_case_insensitive_signature_parameter(self):\n+        \"\"\"Test that sig parameter is redacted case-insensitively.\"\"\"\n+        url = (\n+            'azureblockblob://'\n+            'BlobEndpoint=https://acct.blob.core.windows.net/?SIG=SECRET;'\n+            'AccountName=acct'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET' not in sanitized\n+        assert 'SIG=********' in sanitized\n+        assert 'BlobEndpoint=https://acct.blob.core.windows.net/' in sanitized\n+\n+    def test_azure_multiple_query_parameters_in_endpoint(self):\n+        \"\"\"Test that unrelated query parameters are preserved while sig is redacted.\"\"\"\n+        url = (\n+            'azureblockblob://'\n+            'BlobEndpoint=https://acct.blob.core.windows.net/?sv=version&sig=SECRET&comp=list;'\n+            'AccountName=acct'\n+        )\n+        sanitized = sanitize_url(url)\n+        assert 'SECRET' not in sanitized\n+        assert 'sig=********' in sanitized\n+        assert 'sv=version' in sanitized\n+        assert 'comp=list' in sanitized\n+        assert 'BlobEndpoint=https://acct.blob.core.windows.net/' in sanitized\n+        assert 'AccountName=acct' in sanitized\ndiff --git a/t/unit/backends/test_azureblockblob.py b/t/unit/backends/test_azureblockblob.py\nindex a5b1ecbae80..8eba4ee678b 100644\n--- a/t/unit/backends/test_azureblockblob.py\n+++ b/t/unit/backends/test_azureblockblob.py\n@@ -305,3 +305,83 @@ def test_as_uri_exclude_password_case_insensitive_key(self):\n             \"AccountName=name;\"\n             \"accountkey=**\"\n         )\n+\n+    def test_as_uri_exclude_sas_token_beginning_with_question_mark(self):\n+        \"\"\"Test that SAS tokens beginning with ? are fully redacted.\"\"\"\n+        backend = AzureBlockBlobBackend(\n+            app=self.app,\n+            url=(\n+                \"azureblockblob://\"\n+                \"DefaultEndpointsProtocol=https;\"\n+                \"AccountName=acct;\"\n+                \"SharedAccessSignature=?sv=2022-11-02&sig=SECRET\"\n+            )\n+        )\n+        result = backend.as_uri(include_password=False)\n+        assert \"SECRET\" not in result\n+        assert \"sv=2022-11-02\" not in result\n+        assert \"SharedAccessSignature=**\" in result\n+        assert \"AccountName=acct\" in result\n+\n+    def test_as_uri_exclude_sas_signature_in_blob_endpoint(self):\n+        \"\"\"Test that sig parameters in BlobEndpoint URLs are redacted.\"\"\"\n+        backend = AzureBlockBlobBackend(\n+            app=self.app,\n+            url=(\n+                \"azureblockblob://\"\n+                \"BlobEndpoint=https://acct.blob.core.windows.net/?sv=2022-11-02&sig=SECRET;\"\n+                \"AccountName=acct\"\n+            )\n+        )\n+        result = backend.as_uri(include_password=False)\n+        assert \"SECRET\" not in result\n+        assert \"sig=**\" in result\n+        assert \"sv=2022-11-02\" in result\n+        assert \"BlobEndpoint=https://acct.blob.core.windows.net/\" in result\n+\n+    def test_as_uri_exclude_account_key_containing_hash(self):\n+        \"\"\"Test that AccountKey values containing # are fully redacted.\"\"\"\n+        backend = AzureBlockBlobBackend(\n+            app=self.app,\n+            url=(\n+                \"azureblockblob://\"\n+                \"AccountName=acct;\"\n+                \"AccountKey=SEC#RET;\"\n+                \"EndpointSuffix=core.windows.net\"\n+            )\n+        )\n+        result = backend.as_uri(include_password=False)\n+        assert \"SEC#RET\" not in result\n+        assert \"RET\" not in result\n+        assert \"AccountKey=**\" in result\n+        assert \"AccountName=acct\" in result\n+\n+    def test_as_uri_case_insensitive_signature_parameter(self):\n+        \"\"\"Test that sig parameter is redacted case-insensitively.\"\"\"\n+        backend = AzureBlockBlobBackend(\n+            app=self.app,\n+            url=(\n+                \"azureblockblob://\"\n+                \"BlobEndpoint=https://acct.blob.core.windows.net/?SIG=SECRET;\"\n+                \"AccountName=acct\"\n+            )\n+        )\n+        result = backend.as_uri(include_password=False)\n+        assert \"SECRET\" not in result\n+        assert \"SIG=**\" in result\n+\n+    def test_as_uri_multiple_query_parameters_in_endpoint(self):\n+        \"\"\"Test that unrelated query parameters are preserved while sig is redacted.\"\"\"\n+        backend = AzureBlockBlobBackend(\n+            app=self.app,\n+            url=(\n+                \"azureblockblob://\"\n+                \"BlobEndpoint=https://acct.blob.core.windows.net/?sv=version&sig=SECRET&comp=list;\"\n+                \"AccountName=acct\"\n+            )\n+        )\n+        result = backend.as_uri(include_password=False)\n+        assert \"SECRET\" not in result\n+        assert \"sig=**\" in result\n+        assert \"sv=version\" in result\n+        assert \"comp=list\" in result\n", "problem_statement": "Azure Block Blob credentials are exposed by celery report and configuration sanitization\n<!--\nPlease fill this template entirely and do not erase parts of it.\nWe reserve the right to close without a response\nbug reports which are incomplete.\n-->\n\n# Checklist\n\n<!--\nTo check an item on the list replace [ ] with [x].\n-->\n\n* [x] I have verified that the issue exists against the `main` branch of Celery.\n* [ ] This has already been asked to the [[discussions forum](https://github.com/celery/celery/discussions)](https://github.com/celery/celery/discussions) first.\n* [x] I have read the relevant section in the\n  [[contribution guide](https://docs.celeryq.dev/en/main/contributing.html#other-bugs)](https://docs.celeryq.dev/en/main/contributing.html#other-bugs)\n  on reporting bugs.\n* [x] I have checked the [[issues list](https://github.com/celery/celery/issues?q=is%3Aissue+label%3A%22Issue+Type%3A+Bug+Report%22+-label%3A%22Category%3A+Documentation%22)](https://github.com/celery/celery/issues?q=is%3Aissue+label%3A%22Issue+Type%3A+Bug+Report%22+-label%3A%22Category%3A+Documentation%22)\n  for similar or identical bug reports.\n* [x] I have checked the [[pull requests list](https://github.com/celery/celery/pulls?q=is%3Apr+label%3A%22PR+Type%3A+Bugfix%22+-label%3A%22Category%3A+Documentation%22)](https://github.com/celery/celery/pulls?q=is%3Apr+label%3A%22PR+Type%3A+Bugfix%22+-label%3A%22Category%3A+Documentation%22)\n  for existing proposed fixes.\n* [x] I have checked the [[commit log](https://github.com/celery/celery/commits/main)](https://github.com/celery/celery/commits/main)\n  to find out if the bug was already fixed in the main branch.\n* [x] I have included all related issues and possible duplicate issues\n  in this issue (If there are none, check this box anyway).\n* [ ] I have tried to reproduce the issue with [[pytest-celery](https://docs.celeryq.dev/projects/pytest-celery/en/latest/userguide/celery-bug-report.html)](https://docs.celeryq.dev/projects/pytest-celery/en/latest/userguide/celery-bug-report.html) and added the reproduction script below.\n\n## Mandatory Debugging Information\n\n* [x] I have included the output of `celery -A proj report` in the issue.\n  (if you are not able to do this, then at least specify the Celery\n  version affected).\n* [x] I have verified that the issue exists against the `main` branch of Celery.\n* [ ] I have included the contents of `pip freeze` in the issue.\n* [x] I have included all the versions of all the external dependencies required\n  to reproduce this bug.\n\n## Optional Debugging Information\n\n<!--\nTry some of the below if you think they are relevant.\nIt will help us figure out the scope of the bug and how many users it affects.\n-->\n\n* [ ] I have tried reproducing the issue on more than one Python version\n  and/or implementation.\n* [ ] I have tried reproducing the issue on more than one message broker and/or\n  result backend.\n* [ ] I have tried reproducing the issue on more than one version of the message\n  broker and/or result backend.\n* [x] I have tried reproducing the issue on more than one operating system.\n* [ ] I have tried reproducing the issue on more than one workers pool.\n* [ ] I have tried reproducing the issue with autoscaling, retries,\n  ETA/Countdown & rate limits disabled.\n* [ ] I have tried reproducing the issue after downgrading\n  and/or upgrading Celery and its dependencies.\n\n## Related Issues and Possible Duplicates\n\n<!--\nPlease make sure to search and mention any related issues\nor possible duplicates to this issue as requested by the checklist above.\n\nThis may or may not include issues in other repositories that the Celery project\nmaintains or other repositories that are dependencies of Celery.\n\nIf you don't know how to mention issues, please refer to Github's documentation\non the subject: https://help.github.com/en/articles/autolinked-references-and-urls#issues-and-pull-requests\n-->\n\n#### Related Issues\n\n* #10620 \u2014 related Azure Block Blob credential redaction fix in `AzureBlockBlobBackend.as_uri()`.\n\n#### Possible Duplicates\n\n* None found.\n\n## Environment & Settings\n\n<!-- Include the contents of celery --version below -->\n\n**Celery version**: `main` (current upstream source)\n\n<!-- Include the output of celery -A proj report below -->\n\n<details>\n<summary><b><code>celery report</code> Output:</b></summary>\n<p>\n\n```\nsoftware -> celery:main kombu:... py:3.13.15\n            billiard:... py-amqp:... \nplatform -> system:... arch:...\n            kernel version:...\n            python:3.13.15\n            implementation:CPython\nloader   -> celery.loaders.app.AppLoader\nsettings -> broker_url:...\n            result_backend:azureblockblob://DefaultEndpointsProtocol=https;AccountName=acct;AccountKey=SECRET==;EndpointSuffix=core.windows.net\n            ...\n```\n\n</p>\n</details>\n\n# Steps to Reproduce\n\n## Required Dependencies\n\n<!-- Please fill the required dependencies to reproduce this issue -->\n\n* **Minimal Python Version**: Python 3.13\n* **Minimal Celery Version**: Current `main`\n* **Minimal Kombu Version**: Current version from `main` environment\n* **Minimal Broker Version**: Not relevant; reproduction uses the in-memory broker\n* **Minimal Result Backend Version**: Azure Blob Storage backend\n* **Minimal OS and/or Kernel Version**: Reproduced on Windows\n* **Minimal Broker Client Version**: Not relevant\n* **Minimal Result Backend Client Version**: Azure Storage Blob client\n\n### Python Packages\n\n<!-- Please fill the contents of pip freeze below -->\n\n<details>\n<summary><b><code>pip freeze</code> Output:</b></summary>\n<p>\n\n```\nPlease replace this with the output of `pip freeze` from the reproduction environment.\n```\n\n</p>\n</details>\n\n### Other Dependencies\n\n<!--\nPlease provide system dependencies, configuration files\nand other dependency information if applicable\n-->\n\n<details>\n<p>\n\nAzure Blob Storage backend configuration is required. A live Azure account is not required to reproduce the redaction issue because the problem occurs while sanitizing the connection-string value.\n\n</p>\n</details>\n\n## Minimally Reproducible Test Case\n\n<!--\nPlease provide a reproducible test case.\nRefer to the Reporting Bugs section in our contribution guide.\n\nWe prefer submitting test cases in the form of a PR to our integration test suite.\nIf you can provide one, please mention the PR number below.\nIf not, please attach the most minimal code example required to reproduce the issue below.\nIf the test case is too large, please include a link to a gist or a repository below.\n\nAlternatively, the pytest-celery plugin can be used to create standalone reproduction scripts\nthat can be added to this report. See the pytest-celery documentation for more information at\npytest-celery.readthedocs.io\n-->\n\n<details>\n<p>\n\n```python\nfrom celery import Celery\nfrom celery.app.utils import sanitize_url\n\nbackend = (\n    \"azureblockblob://\"\n    \"DefaultEndpointsProtocol=https;\"\n    \"AccountName=acct;\"\n    \"AccountKey=SECRET==;\"\n    \"EndpointSuffix=core.windows.net\"\n)\n\nprint(sanitize_url(backend))\n```\n\nThe current implementation returns the connection string with `AccountKey=SECRET==` unchanged.\n\nThe same value can reach Celery's diagnostic/configuration output through the bug-report path:\n\n```text\ncelery -A proj report\n```\n\nWhen an Azure Block Blob result backend is configured, the generated report can contain the storage account key in plaintext.\n\nA representative connection string is:\n\n```text\nazureblockblob://DefaultEndpointsProtocol=https;AccountName=acct;AccountKey=SECRET==;EndpointSuffix=core.windows.net\n```\n\nNo real credential should be used when reproducing or reporting this issue.\n\n</p>\n</details>\n\n# Expected Behavior\n\n<!-- Describe in detail what you expect to happen -->\n\nSensitive credentials contained in Azure Block Blob connection strings should be redacted anywhere Celery sanitizes configuration values or generates diagnostic output.\n\nIn particular, `celery report` should not expose values such as:\n\n```text\nAccountKey=SECRET==\n```\n\nor:\n\n```text\nSharedAccessSignature=...\n```\n\nThe redaction behavior should be consistent with the existing redaction performed by `AzureBlockBlobBackend.as_uri()`.\n\n# Actual Behavior\n\n<!--\nDescribe in detail what actually happened.\nPlease include a backtrace and surround it with triple backticks (```).\nIn addition, include the Celery daemon logs, the broker logs,\nthe result backend logs and system logs below if they will help us debug\nthe issue.\n-->\n\n`sanitize_url()` does not redact credentials contained in Azure Blob Storage connection strings.\n\nThe current sanitization logic handles credentials represented in the URL authority portion, such as:\n\n```text\nredis://:password@host\n```\n\nHowever, Azure Block Blob credentials are embedded directly in the connection string:\n\n```text\nazureblockblob://DefaultEndpointsProtocol=https;AccountName=acct;AccountKey=SECRET==;EndpointSuffix=core.windows.net\n```\n\nBecause there is no `user:password@host` component, the Azure connection string passes through `sanitize_url()` without the `AccountKey` being redacted.\n\nThis affects the configuration/diagnostic path used by `bugreport()` and therefore `celery report`.\n\nFor example, the resulting report can contain:\n\n```text\nresult_backend: azureblockblob://DefaultEndpointsProtocol=https;AccountName=acct;AccountKey=SECRET==;EndpointSuffix=core.windows.net\n```\n\nThe credential can therefore be exposed if a user copies the output of `celery report` into a public bug report.\n\nThere is a related existing fix in #10620 where `AzureBlockBlobBackend.as_uri()` redacts Azure credentials. However, the configuration-level sanitization path does not use the same redaction logic, so the credentials can still be exposed through `celery report` and other paths based on `sanitize_url()`.\n\nThe issue also applies to Azure connection strings containing `SharedAccessSignature`.\n\nA possible fix would be to share the Azure connection-string redaction logic between `sanitize_url()` and `AzureBlockBlobBackend.as_uri()` so that both paths consistently protect the same sensitive fields.\n", "hints_text": "is this a regression or old problem?", "created_at": "2026-10-08T15:03:18Z"}
{"repo": "celery/celery", "pull_number": 10818, "instance_id": "celery__celery-10818", "issue_numbers": ["10817"], "base_commit": "c09b6ff37bad5e748442998b2d4a283c5c70a86b", "patch": "diff --git a/celery/schedules.py b/celery/schedules.py\nindex c218eb9d956..3f8d59b63db 100644\n--- a/celery/schedules.py\n+++ b/celery/schedules.py\n@@ -177,7 +177,19 @@ def is_due(self, last_run_at: datetime) -> tuple[bool, datetime]:\n         rem_delta = self.remaining_estimate(last_run_at)\n         remaining_s = max(rem_delta.total_seconds(), 0)\n         if remaining_s == 0:\n-            return schedstate(is_due=True, next=self.seconds)\n+            next_s = self.seconds\n+            if self.relative:\n+                # The next rounded deadline can differ from the interval,\n+                # especially across DST or after a late run / restart. Realign\n+                # to the next rounded clock boundary and do not check past it.\n+                now = self.maybe_make_aware(self.now())\n+                now = now.astimezone(last_run_at.tzinfo)\n+                next_s = self.remaining_estimate(now).total_seconds()\n+                if next_s <= 0:\n+                    # Preserve the interval for subsecond rounding and\n+                    # zero or negative intervals with no future boundary.\n+                    next_s = self.seconds\n+            return schedstate(is_due=True, next=next_s)\n         return schedstate(is_due=False, next=remaining_s)\n \n     def __repr__(self) -> str:\ndiff --git a/celery/utils/time.py b/celery/utils/time.py\nindex 5ae2e1e0ec2..0e346e438c4 100644\n--- a/celery/utils/time.py\n+++ b/celery/utils/time.py\n@@ -217,6 +217,22 @@ def delta_resolution(dt: datetime, delta: timedelta) -> datetime:\n     return dt\n \n \n+def _relative_end_dates(dt: datetime, delta: timedelta) -> list[datetime]:\n+    \"\"\"Return UTC occurrences of a rounded local deadline.\"\"\"\n+    rounded = delta_resolution(dt, delta).replace(microsecond=0)\n+    dates = []\n+    for fold in (0, 1):\n+        candidate = rounded.replace(fold=fold)\n+        if _is_imaginary(candidate, candidate.tzinfo):\n+            resolved = dateutil_tz.resolve_imaginary(candidate)\n+            # Some timezone implementations misidentify rollback times as\n+            # gaps. A genuine gap must resolve forwards, never backwards.\n+            if resolved > candidate:\n+                candidate = resolved\n+        dates.append(candidate.astimezone(timezone.utc))\n+    return dates\n+\n+\n def remaining(\n         start: datetime, ends_in: timedelta | ffwd, now: datetime | None = None,\n         relative: bool = False) -> timedelta:\n@@ -224,6 +240,10 @@ def remaining(\n \n     For example, \"how many seconds left for 30 seconds after start?\"\n \n+    For relative schedules, the deadline is the last rounded local boundary at\n+    or before ``start + ends_in`` in real time, never at or before ``start``;\n+    day intervals use calendar days.\n+\n     Arguments:\n         start (~datetime.datetime): Starting date.\n         ends_in (~datetime.timedelta, ~celery.utils.time.ffwd): The end delta.\n@@ -237,12 +257,40 @@ def remaining(\n         ~datetime.timedelta: Remaining time.\n     \"\"\"\n     now = now or datetime.now(datetime_timezone.utc)\n-    if isinstance(ends_in, timedelta):\n+    if isinstance(ends_in, timedelta) and not (\n+            relative and ends_in >= timedelta(days=1)):\n         end_date = add_seconds_to_datetime(start, ends_in.total_seconds())\n     else:\n+        # Day-resolution relative schedules advance by local calendar days.\n+        # An elapsed-time addition can land on the wrong date across DST.\n         end_date = start + ends_in\n     if relative:\n-        end_date = delta_resolution(end_date, ends_in).replace(microsecond=0)\n+        candidates = _relative_end_dates(end_date, ends_in)\n+        start_utc = start.astimezone(timezone.utc)\n+        if ends_in >= timedelta(days=1):\n+            # Use the first midnight after start, including a repeated\n+            # midnight whose first occurrence has already passed.\n+            future = [dt for dt in candidates if dt > start_utc]\n+            end_date = min(future, default=end_date.astimezone(timezone.utc))\n+        else:\n+            end_utc = start_utc + ends_in\n+            # Rounding may enter an ambiguous period even when the\n+            # unrounded time is outside it. Choose by the UTC occurrence.\n+            before_end = [dt for dt in candidates if dt <= end_utc]\n+            rounded = max(before_end) if before_end else min(candidates)\n+            if ends_in >= timedelta(minutes=1) and rounded <= start_utc:\n+                # A partial-hour rollback can put the rounded boundary\n+                # before start. Consider both the next clock boundary and\n+                # the calendar boundary, including both occurrences.\n+                unit = (timedelta(hours=1) if ends_in >= timedelta(hours=1)\n+                        else timedelta(minutes=1))\n+                candidates += _relative_end_dates(end_date + unit, ends_in)\n+                candidates += _relative_end_dates(start + ends_in, ends_in)\n+                future = [dt for dt in candidates if dt > start_utc]\n+                before_end = [dt for dt in future if dt <= end_utc]\n+                rounded = (max(before_end) if before_end\n+                           else min(future, default=end_utc))\n+            end_date = rounded\n \n     # Using UTC to calculate real time difference.\n     # Python by default uses wall time in arithmetic between datetimes with\ndiff --git a/docs/userguide/periodic-tasks.rst b/docs/userguide/periodic-tasks.rst\nindex 2a943b12c44..0fa389d1b51 100644\n--- a/docs/userguide/periodic-tasks.rst\n+++ b/docs/userguide/periodic-tasks.rst\n@@ -257,6 +257,18 @@ Available Fields\n     second, minute, hour or day depending on the period of the\n     :class:`~datetime.timedelta`.\n \n+    Intervals of a day or more advance by local calendar days before\n+    rounding to midnight. For example, ``timedelta(days=1)`` becomes due\n+    at the next midnight even when a DST change makes the day 23 or 25\n+    hours long. If midnight falls in a DST gap, the deadline moves forward\n+    by the change in UTC offset to an existing local time.\n+    If midnight occurs twice, the first occurrence after the previous run\n+    is used.\n+\n+    When an entry runs late, such as after a :program:`celery beat` restart,\n+    the next check aligns to the next rounded clock boundary rather than\n+    drifting from the actual execution time.\n+\n     By default `relative` is false, the frequency isn't rounded and will be\n     relative to the time when :program:`celery beat` was started.\n \n", "test_patch": "diff --git a/t/integration/test_beat.py b/t/integration/test_beat.py\nindex 499813e69ff..ead4692365f 100644\n--- a/t/integration/test_beat.py\n+++ b/t/integration/test_beat.py\n@@ -1,9 +1,11 @@\n-from datetime import datetime, timedelta\n+from datetime import datetime, timedelta, timezone\n from threading import Event, Thread\n from time import monotonic, sleep\n from uuid import uuid4\n+from zoneinfo import ZoneInfo\n \n import pytest\n+from dateutil import tz as dateutil_tz\n \n from celery import beat\n from celery.schedules import crontab\n@@ -12,6 +14,155 @@\n from .conftest import flaky\n \n \n+class test_beat_interval_timezones:\n+    @flaky\n+    @pytest.mark.usefixtures('celery_session_worker')\n+    @pytest.mark.parametrize('tz_factory', [\n+        pytest.param(ZoneInfo, id='zoneinfo'),\n+        pytest.param(dateutil_tz.gettz, id='dateutil'),\n+    ])\n+    @pytest.mark.parametrize(\n+        'timezone_name,interval,relative,last_run,due_at,next_due_at', [\n+            pytest.param(\n+                'America/New_York', timedelta(days=1), True,\n+                datetime(2026, 11, 1, 0, 30), datetime(2026, 11, 2),\n+                datetime(2026, 11, 3),\n+                id='daily-fall-back',\n+            ),\n+            pytest.param(\n+                'America/New_York', timedelta(days=1), True,\n+                datetime(2026, 3, 7, 23, 30), datetime(2026, 3, 8),\n+                datetime(2026, 3, 9),\n+                id='daily-spring-forward',\n+            ),\n+            pytest.param(\n+                'America/New_York', timedelta(days=1), True,\n+                datetime(2026, 3, 8, 0, 30), datetime(2026, 3, 9),\n+                datetime(2026, 3, 10),\n+                id='daily-across-spring-forward',\n+            ),\n+            pytest.param(\n+                'America/New_York', timedelta(hours=1), True,\n+                datetime(2026, 3, 8, 1, 30), datetime(2026, 3, 8, 3),\n+                datetime(2026, 3, 8, 4),\n+                id='hourly-across-spring-forward',\n+            ),\n+            pytest.param(\n+                'Australia/Lord_Howe', timedelta(hours=1), True,\n+                datetime(2026, 10, 4, 1, 15), datetime(2026, 10, 4, 2, 30),\n+                datetime(2026, 10, 4, 3),\n+                id='hourly-half-hour-spring-forward',\n+            ),\n+            pytest.param(\n+                'Africa/Cairo', timedelta(days=1), True,\n+                datetime(2026, 4, 23, 23, 30), datetime(2026, 4, 24, 1),\n+                datetime(2026, 4, 25),\n+                id='daily-cairo-midnight-gap',\n+            ),\n+            pytest.param(\n+                'America/Havana', timedelta(days=1), True,\n+                datetime(2026, 3, 7, 23, 30), datetime(2026, 3, 8, 1),\n+                datetime(2026, 3, 9),\n+                id='daily-havana-midnight-gap',\n+            ),\n+            pytest.param(\n+                'America/Goose_Bay', timedelta(days=1), True,\n+                datetime(2000, 10, 28, 23, 30, fold=1),\n+                datetime(2000, 10, 29, fold=1),\n+                datetime(2000, 10, 30),\n+                id='daily-repeated-midnight',\n+            ),\n+            pytest.param(\n+                'Pacific/Chatham', timedelta(hours=2), True,\n+                datetime(2026, 4, 5, 2, 45),\n+                datetime(2026, 4, 5, 3, fold=1),\n+                datetime(2026, 4, 5, 5),\n+                id='two-hours-after-repeated-period',\n+            ),\n+            pytest.param(\n+                'Australia/Lord_Howe', timedelta(hours=1), True,\n+                datetime(2026, 4, 5, 1), datetime(2026, 4, 5, 2),\n+                datetime(2026, 4, 5, 3),\n+                id='hourly-half-hour-fall-back',\n+            ),\n+            pytest.param(\n+                'America/New_York', timedelta(days=1), False,\n+                datetime(2026, 11, 1, 0, 30), datetime(2026, 11, 1, 23, 30),\n+                datetime(2026, 11, 2, 23, 30),\n+                id='elapsed-day-fall-back',\n+            ),\n+            pytest.param(\n+                'America/New_York', timedelta(days=1), False,\n+                datetime(2026, 3, 7, 23, 30), datetime(2026, 3, 9, 0, 30),\n+                datetime(2026, 3, 10, 0, 30),\n+                id='elapsed-day-spring-forward',\n+            ),\n+            pytest.param(\n+                'Africa/Cairo', timedelta(days=1), False,\n+                datetime(2026, 4, 23, 23, 30), datetime(2026, 4, 25, 0, 30),\n+                datetime(2026, 4, 26, 0, 30),\n+                id='elapsed-day-midnight-gap',\n+            ),\n+        ],\n+    )\n+    def test_dispatches_once_at_deadline(\n+        self, app, monkeypatch, timezone_name, interval, relative,\n+        last_run, due_at, next_due_at, tz_factory,\n+    ):\n+        zone = tz_factory(timezone_name)\n+        app.conf.timezone = zone\n+        last_run = last_run.replace(tzinfo=zone)\n+        due_utc = due_at.replace(tzinfo=zone).astimezone(timezone.utc)\n+        now = last_run\n+        # Control only Beat's clock; the broker and worker use real time.\n+        monkeypatch.setattr(app, 'now', lambda: now)\n+        task_id = uuid4().hex\n+        scheduler = beat.Scheduler(app=app, lazy=True)\n+        entry = scheduler.add(\n+            name='timezone-interval', task=add.name, args=(1, 2),\n+            schedule=interval, relative=relative, last_run_at=last_run,\n+            options={'task_id': task_id},\n+        )\n+\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 0\n+\n+        # Move through the transition without waiting for wall-clock time.\n+        now = (due_utc - timedelta(seconds=1)).astimezone(zone)\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 0\n+\n+        now = due_utc.astimezone(zone)\n+        assert scheduler.tick() == 0\n+        assert app.AsyncResult(task_id).get(timeout=30) == 3\n+        assert scheduler.schedule[entry.name].total_run_count == 1\n+        last_dispatch = scheduler.schedule[entry.name].last_run_at\n+        assert last_dispatch.astimezone(timezone.utc) == due_utc\n+\n+        # Further ticks must not dispatch the same deadline again.\n+        assert scheduler.tick() > 0\n+        now = (due_utc + timedelta(seconds=1)).astimezone(zone)\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 1\n+\n+        # Keep the populated heap and verify the following run as well.\n+        next_due_utc = next_due_at.replace(tzinfo=zone).astimezone(timezone.utc)\n+        next_task_id = uuid4().hex\n+        scheduler.schedule[entry.name].options['task_id'] = next_task_id\n+        now = (next_due_utc - timedelta(seconds=1)).astimezone(zone)\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 1\n+\n+        now = next_due_utc.astimezone(zone)\n+        assert scheduler.tick() == 0\n+        assert app.AsyncResult(next_task_id).get(timeout=30) == 3\n+        assert scheduler.schedule[entry.name].total_run_count == 2\n+        last_dispatch = scheduler.schedule[entry.name].last_run_at\n+        assert last_dispatch.astimezone(timezone.utc) == next_due_utc\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 2\n+\n+\n class test_beat_cron_starting_deadline:\n     @flaky\n     @pytest.mark.usefixtures('celery_session_worker')\ndiff --git a/t/unit/app/test_beat.py b/t/unit/app/test_beat.py\nindex 99a8a75a1fe..339426db3ba 100644\n--- a/t/unit/app/test_beat.py\n+++ b/t/unit/app/test_beat.py\n@@ -446,6 +446,35 @@ def test_ticks_microseconds(self):\n         expected_time = now_ts + 0.5 - 0.010\n         assert scheduler._heap[0].time == expected_time\n \n+    def test_tick_daily_relative_spring_forward(self, monkeypatch):\n+        self.app.conf.timezone = 'America/New_York'\n+        tz = ZoneInfo('America/New_York')\n+        now = datetime(2026, 3, 8, tzinfo=tz)\n+        monkeypatch.setattr(self.app, 'now', lambda: now)\n+        scheduler = mScheduler(app=self.app, lazy=True)\n+        entry = scheduler.add(\n+            name='daily', task='t.fake.task',\n+            schedule=timedelta(days=1), relative=True,\n+            last_run_at=datetime(2026, 3, 7, tzinfo=tz),\n+        )\n+\n+        assert scheduler.tick() == 0\n+        assert scheduler.schedule[entry.name].total_run_count == 1\n+\n+        # The next midnight is 23 elapsed hours away, including heap drift.\n+        next_delay = scheduler._heap[0].time - now.timestamp()\n+        assert next_delay == pytest.approx(82800, abs=0.02, rel=0)\n+\n+        now = datetime(2026, 3, 8, 23, 59, 59, tzinfo=tz)\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 1\n+\n+        now = datetime(2026, 3, 9, tzinfo=tz)\n+        assert scheduler.tick() == 0\n+        assert scheduler.schedule[entry.name].total_run_count == 2\n+        assert scheduler.tick() > 0\n+        assert scheduler.schedule[entry.name].total_run_count == 2\n+\n     def test_ticks_schedule_change(self):\n         # initialise schedule and check heap is not initialized\n         scheduler = mScheduler(app=self.app)\ndiff --git a/t/unit/app/test_schedules.py b/t/unit/app/test_schedules.py\nindex dae466be2e6..0bd952fea67 100644\n--- a/t/unit/app/test_schedules.py\n+++ b/t/unit/app/test_schedules.py\n@@ -7,6 +7,7 @@\n from unittest.mock import Mock\n \n import pytest\n+from dateutil import tz as dateutil_tz\n \n from celery.exceptions import ImproperlyConfigured\n from celery.schedules import ParseException, crontab, crontab_parser, schedule, solar\n@@ -252,6 +253,233 @@ def test_is_not_due_before_fall_back_relative(self):\n         s = schedule(timedelta(hours=1), relative=True, nowfun=lambda: now, app=self.app)\n         assert s.is_due(last_run_at) == (False, 2)\n \n+    @pytest.mark.parametrize('relative', [False, True])\n+    @pytest.mark.parametrize('interval,relative_next', [\n+        pytest.param(timedelta(seconds=0.1), 0.1, id='subsecond'),\n+        pytest.param(timedelta(seconds=1), 0.25, id='second'),\n+        pytest.param(timedelta(0), 0, id='zero'),\n+        pytest.param(timedelta(seconds=-1), 0, id='negative'),\n+    ])\n+    def test_next_check_for_short_intervals(\n+        self, interval, relative_next, relative,\n+    ):\n+        now = datetime(2026, 1, 1, microsecond=750000, tzinfo=timezone.utc)\n+        s = schedule(\n+            interval, relative=relative, nowfun=lambda: now, app=self.app,\n+        )\n+        next_check = (relative_next if relative\n+                      else max(interval.total_seconds(), 0))\n+        assert s.is_due(now - timedelta(seconds=10)) == (True, next_check)\n+\n+    @pytest.mark.parametrize('relative,expected_next', [\n+        (True, 30),\n+        (False, 3600),\n+    ])\n+    def test_next_check_realigns_after_late_run(self, relative, expected_next):\n+        # When an hourly task runs late at 10:59:30, relative=True realigns\n+        # to the next hour boundary (11:00:00) in 30 seconds.\n+        last_run_at = datetime(2026, 1, 1, 9, 0, 0, tzinfo=timezone.utc)\n+        now = datetime(2026, 1, 1, 10, 59, 30, tzinfo=timezone.utc)\n+        s = schedule(\n+            timedelta(hours=1), relative=relative, nowfun=lambda: now,\n+            app=self.app,\n+        )\n+        assert s.is_due(last_run_at) == (True, expected_next)\n+\n+    @pytest.mark.parametrize('tz_factory', [\n+        pytest.param(ZoneInfo, id='zoneinfo'),\n+        pytest.param(dateutil_tz.gettz, id='dateutil'),\n+    ])\n+    @pytest.mark.parametrize('zone,interval,last_run_at,due_at,next_check', [\n+        pytest.param(\n+            'America/New_York', timedelta(days=1),\n+            datetime(2026, 11, 1, 0, 30), datetime(2026, 11, 2),\n+            86400,\n+            id='daily-fall-back',\n+        ),\n+        pytest.param(\n+            'America/New_York', timedelta(days=2),\n+            datetime(2026, 10, 31, 0, 30), datetime(2026, 11, 2),\n+            172800,\n+            id='two-days-fall-back',\n+        ),\n+        pytest.param(\n+            'America/New_York', timedelta(days=1),\n+            datetime(2026, 3, 7, 23, 30), datetime(2026, 3, 8),\n+            82800,\n+            id='daily-spring-forward',\n+        ),\n+        pytest.param(\n+            'America/New_York', timedelta(days=1),\n+            datetime(2026, 3, 8, 0, 30), datetime(2026, 3, 9),\n+            86400,\n+            id='daily-across-spring-forward',\n+        ),\n+        pytest.param(\n+            'America/New_York', timedelta(hours=1),\n+            datetime(2026, 3, 8, 1, 30), datetime(2026, 3, 8, 3),\n+            3600,\n+            id='hourly-across-spring-forward',\n+        ),\n+        pytest.param(\n+            'Australia/Lord_Howe', timedelta(hours=1),\n+            datetime(2026, 10, 4, 1, 15), datetime(2026, 10, 4, 2, 30),\n+            1800,\n+            id='hourly-half-hour-spring-forward',\n+        ),\n+        pytest.param(\n+            'America/New_York', timedelta(days=2),\n+            datetime(2026, 3, 6, 23, 30), datetime(2026, 3, 8),\n+            169200,\n+            id='two-days-spring-forward',\n+        ),\n+        pytest.param(\n+            'Australia/Lord_Howe', timedelta(hours=1),\n+            datetime(2026, 4, 5, 1), datetime(2026, 4, 5, 2),\n+            3600,\n+            id='hourly-half-hour-fall-back',\n+        ),\n+        pytest.param(\n+            'America/New_York', timedelta(hours=1),\n+            datetime(2026, 11, 1, 1, 15),\n+            datetime(2026, 11, 1, 1, fold=1),\n+            3600,\n+            id='hourly-repeated-hour',\n+        ),\n+        pytest.param(\n+            'America/Havana', timedelta(days=1),\n+            datetime(2026, 3, 7, 23, 30), datetime(2026, 3, 8, 1),\n+            82800,\n+            id='daily-midnight-spring-forward',\n+        ),\n+        pytest.param(\n+            'America/Havana', timedelta(days=2),\n+            datetime(2026, 3, 6, 23, 30), datetime(2026, 3, 8, 1),\n+            169200,\n+            id='two-days-midnight-spring-forward',\n+        ),\n+        pytest.param(\n+            'America/Havana', timedelta(days=1),\n+            datetime(2026, 10, 31, 23, 30), datetime(2026, 11, 1),\n+            90000,\n+            id='daily-midnight-fall-back',\n+        ),\n+        pytest.param(\n+            'Asia/Singapore', timedelta(hours=1),\n+            datetime(1945, 9, 11, 23),\n+            datetime(1945, 9, 11, 23, fold=1),\n+            3600,\n+            id='hourly-ninety-minute-fall-back',\n+        ),\n+        pytest.param(\n+            'Pacific/Nauru', timedelta(hours=1),\n+            datetime(1942, 8, 28, 23),\n+            datetime(1942, 8, 28, 22, fold=1),\n+            3600,\n+            id='hourly-two-and-half-hours-fall-back',\n+        ),\n+        pytest.param(\n+            'Asia/Kathmandu', timedelta(days=1),\n+            datetime(1985, 12, 31, 23, 50), datetime(1986, 1, 1, 0, 15),\n+            85500,\n+            id='daily-quarter-hour-midnight-gap',\n+        ),\n+        pytest.param(\n+            'Pacific/Apia', timedelta(days=1),\n+            datetime(2011, 12, 29, 23, 30), datetime(2011, 12, 31),\n+            86400,\n+            id='daily-skipped-date',\n+        ),\n+        pytest.param(\n+            'Pacific/Kwajalein', timedelta(days=1),\n+            datetime(1969, 9, 30, 0, 30), datetime(1969, 10, 1),\n+            86400,\n+            id='daily-twenty-three-hour-fall-back',\n+        ),\n+        pytest.param(\n+            'America/Goose_Bay', timedelta(days=1),\n+            datetime(2000, 10, 28, 23, 30, fold=1),\n+            datetime(2000, 10, 29, fold=1),\n+            86400,\n+            id='daily-second-midnight',\n+        ),\n+        pytest.param(\n+            'America/Goose_Bay', timedelta(hours=1),\n+            datetime(2000, 10, 28, 23, 1), datetime(2000, 10, 29),\n+            3600,\n+            id='hourly-first-midnight',\n+        ),\n+        pytest.param(\n+            'America/Goose_Bay', timedelta(hours=1),\n+            datetime(2000, 10, 28, 23, 1, fold=1),\n+            datetime(2000, 10, 29, fold=1),\n+            3600,\n+            id='hourly-second-midnight',\n+        ),\n+        pytest.param(\n+            'Pacific/Chatham', timedelta(hours=2),\n+            datetime(2026, 4, 5, 2, 45),\n+            datetime(2026, 4, 5, 3, fold=1),\n+            7200,\n+            id='two-hours-after-repeated-period',\n+        ),\n+        pytest.param(\n+            'Antarctica/Casey', timedelta(days=1),\n+            datetime(2010, 3, 4, 23, 30, fold=1),\n+            datetime(2010, 3, 5, fold=1),\n+            86400,\n+            id='daily-three-hours-fall-back',\n+        ),\n+        pytest.param(\n+            'Africa/Cairo', timedelta(days=1),\n+            datetime(2026, 4, 23, 23, 30), datetime(2026, 4, 24, 1),\n+            82800,\n+            id='daily-cairo-midnight-gap',\n+        ),\n+    ])\n+    def test_relative_schedule_across_dst(\n+        self, zone, interval, last_run_at, due_at, next_check,\n+        tz_factory,\n+    ):\n+        self.app.conf.timezone = tz_factory(zone)\n+        last_run_at = last_run_at.replace(tzinfo=self.app.timezone)\n+        due_at = due_at.replace(tzinfo=self.app.timezone)\n+        now = last_run_at\n+        s = schedule(\n+            interval, relative=True, nowfun=lambda: now, app=self.app,\n+        )\n+        expected_remaining = (\n+            due_at.astimezone(timezone.utc) - now.astimezone(timezone.utc)\n+        ).total_seconds()\n+\n+        assert s.is_due(last_run_at) == (False, expected_remaining)\n+\n+        now = due_at.astimezone(timezone.utc) - timedelta(seconds=1)\n+        assert s.is_due(last_run_at) == (False, 1)\n+\n+        now = due_at\n+        assert s.is_due(last_run_at) == (True, next_check)\n+\n+        now = due_at.astimezone(timezone.utc) + timedelta(seconds=10)\n+        assert s.is_due(last_run_at) == (True, next_check - 10)\n+\n+    @pytest.mark.parametrize('last_run_at', [\n+        datetime(2026, 11, 1, 0, 30),\n+        datetime(2026, 3, 7, 23, 30),\n+    ])\n+    def test_non_relative_daily_schedule_uses_elapsed_time(\n+        self, last_run_at,\n+    ):\n+        self.app.conf.timezone = 'America/New_York'\n+        last_run_at = last_run_at.replace(tzinfo=self.app.timezone)\n+        now = last_run_at\n+        s = schedule(timedelta(days=1), nowfun=lambda: now, app=self.app)\n+\n+        assert s.is_due(last_run_at) == (False, 86400)\n+\n+        now = last_run_at.astimezone(timezone.utc) + timedelta(days=1)\n+        assert s.is_due(last_run_at) == (True, 86400)\n+\n \n # Module-level helper used as crontab(nowfun=...) in pickling tests.\n # Defined at top level so it is picklable/serializable.\n", "problem_statement": "Celery Beat: daily relative schedules become immediately due across DST fall-back\n\n\n<!--\nPlease fill this template entirely and do not erase parts of it.\nWe reserve the right to close without a response\nbug reports which are incomplete.\n-->\n# Checklist\n<!--\nTo check an item on the list replace [ ] with [x].\n-->\n- [x] I have verified that the issue exists against the `main` branch of Celery.\n- [ ] This has already been asked to the [discussions forum](https://github.com/celery/celery/discussions) first.\n- [x] I have read the relevant section in the\n  [contribution guide](https://docs.celeryq.dev/en/main/contributing.html#other-bugs)\n  on reporting bugs.\n- [x] I have checked the [issues list](https://github.com/celery/celery/issues?q=is%3Aissue+label%3A%22Issue+Type%3A+Bug+Report%22+-label%3A%22Category%3A+Documentation%22)\n  for similar or identical bug reports.\n- [x] I have checked the [pull requests list](https://github.com/celery/celery/pulls?q=is%3Apr+label%3A%22PR+Type%3A+Bugfix%22+-label%3A%22Category%3A+Documentation%22)\n  for existing proposed fixes.\n- [x] I have checked the [commit log](https://github.com/celery/celery/commits/main)\n  to find out if the bug was already fixed in the main branch.\n- [x] I have included all related issues and possible duplicate issues\n  in this issue (If there are none, check this box anyway).\n- [ ] I have tried to reproduce the issue with [pytest-celery](https://docs.celeryq.dev/projects/pytest-celery/en/latest/userguide/celery-bug-report.html) and added the reproduction script below.\n\nDiscussion posting and pytest-celery reproduction have not been performed.\nThe standalone test below exercises the scheduling calculation directly;\nno running broker, backend, worker, or Beat process is required.\n\n## Mandatory Debugging Information\n\n- [x] I have included the output of ``celery -A proj report`` in the issue.\n    (if you are not able to do this, then at least specify the Celery\n     version affected).\n- [x] I have verified that the issue exists against the `main` branch of Celery.\n- [x] I have included the contents of ``pip freeze`` in the issue.\n- [x] I have included all the versions of all the external dependencies required\n  to reproduce this bug.\n\n## Optional Debugging Information\n<!--\nTry some of the below if you think they are relevant.\nIt will help us figure out the scope of the bug and how many users it affects.\n-->\n- [x] I have tried reproducing the issue on more than one Python version\n  and/or implementation.\n- [ ] I have tried reproducing the issue on more than one message broker and/or\n  result backend.\n- [ ] I have tried reproducing the issue on more than one version of the message\n  broker and/or result backend.\n- [ ] I have tried reproducing the issue on more than one operating system.\n- [ ] I have tried reproducing the issue on more than one workers pool.\n- [ ] I have tried reproducing the issue with autoscaling, retries,\n  ETA/Countdown & rate limits disabled.\n- [ ] I have tried reproducing the issue after downgrading\n  and/or upgrading Celery and its dependencies.\n\n## Related Issues and Possible Duplicates\n<!--\nPlease make sure to search and mention any related issues\nor possible duplicates to this issue as requested by the checklist above.\n\nThis may or may not include issues in other repositories that the Celery project\nmaintains or other repositories that are dependencies of Celery.\n\nIf you don't know how to mention issues, please refer to Github's documentation\non the subject: https://help.github.com/en/articles/autolinked-references-and-urls#issues-and-pull-requests\n-->\n\n#### Related Issues\n\n- [PR #10769](https://github.com/celery/celery/pull/10769) introduced elapsed-time\n  interval addition. Combining that addition with daily relative rounding\n  causes this regression. The [review](https://github.com/celery/celery/pull/10769#pullrequestreview-5406888408)\n  also raised concerns about `relative=True` and `delta_resolution()`.\n- [PR #10813](https://github.com/celery/celery/pull/10813) addresses elapsed-time\n  subtraction for ETA/countdown and expiry; it does not fix this Beat deadline\n  calculation.\n- [Issue #6438](https://github.com/celery/celery/issues/6438) concerns interval\n  scheduling at DST fall-back and was addressed by #10769.\n- [PR #4403](https://github.com/celery/celery/pull/4403) and\n  [issue #1604](https://github.com/celery/celery/issues/1604) concern DST/crontab\n  behavior rather than this daily interval regression.\n- [PR #7901](https://github.com/celery/celery/pull/7901) is an earlier DST-related\n  scheduling proposal; [#7125](https://github.com/celery/celery/pull/7125)\n  discusses a broader next-scheduled-time API.\n\n#### Possible Duplicates\n\n- No exact issue, PR, or discussion was found for this regression in the\n  repository searches. Related DST reports are listed above.\n\n## Environment & Settings\n<!-- Include the contents of celery --version below -->\n**Celery version**: `5.7.0b1`, imported from the unchanged `main` source at\n[`71d1b8f89d50694ad2774ee2dcf3204dd2ae5272`](https://github.com/celery/celery/commit/71d1b8f89d50694ad2774ee2dcf3204dd2ae5272).\n\nReproduced on CPython 3.12.3 and 3.11.16, on Linux/WSL2.\nThe affected `celery/utils/time.py` blob is\n`e54b29b5d6b7dfff6f75f41473d9f460ed8ffd66`.\n\nThe environment's installed distribution metadata reports `celery==5.6.3`\nin `pip freeze`. The reproduction explicitly imports the unchanged main\ncheckout through `PYTHONPATH`; `celery.__version__` and the report below\ntherefore show the source version, `5.7.0b1`.\n\nThe configuration used by `celery -A proj report` is:\n\n```python\nfrom celery import Celery\n\napp = Celery('dst_repro', broker='memory://', backend='cache+memory://')\napp.conf.timezone = 'America/New_York'\n```\n<!-- Include the output of celery -A proj report below -->\n<details>\n<summary><b><code>celery report</code> Output:</b></summary>\n<p>\n\n```text\nsoftware -> celery:5.7.0b1 (collider) kombu:5.7.0a1 py:3.12.3\n            billiard:4.3.0 memory:N/A\nplatform -> system:Linux arch:64bit, ELF\n            kernel version:6.18.40.1-microsoft-standard-WSL2 imp:CPython\nloader   -> celery.loaders.app.AppLoader\nsettings -> transport:memory results:cache+memory://\n\nbroker_url: 'memory://:********@localhost//'\nresult_backend: 'cache+memory://'\ndeprecated_settings: None\ntimezone: 'America/New_York'\n```\n\n</p>\n</details>\n\n# Steps to Reproduce\n\n1. Use the unchanged Celery main revision linked above. The local fix is not\n   required for reproduction.\n2. Save the minimally reproducible test below as `repro.py` outside the checkout.\n3. Run `PYTHONPATH=/path/to/unchanged-celery-checkout python repro.py` with\n   Celery's dependencies installed.\n4. Observe a negative remaining duration and `is_due=True`, despite the\n   previous run occurring at the current time.\n\nThe example fixes the clock explicitly; do not change the system clock.\n\n## Required Dependencies\n<!-- Please fill the required dependencies to reproduce this issue -->\n- **Minimal Python Version**: Unknown; reproduced on CPython 3.11.16 and 3.12.3\n- **Minimal Celery Version**: Unknown release; regression introduced by #10769, reproduced on main (`5.7.0b1`)\n- **Minimal Kombu Version**: Unknown; environment uses `5.7.0a1`\n- **Minimal Broker Version**: N/A; no running broker is needed\n- **Minimal Result Backend Version**: N/A; no running result backend is needed\n- **Minimal OS and/or Kernel Version**: Unknown; reproduced on Linux/WSL2, kernel `6.18.40.1-microsoft-standard-WSL2`\n- **Minimal Broker Client Version**: N/A; no broker operations are involved\n- **Minimal Result Backend Client Version**: N/A; no backend operations are involved\n\n### Python Packages\n<!-- Please fill the contents of pip freeze below -->\n<details>\n<summary><b><code>pip freeze</code> Output:</b></summary>\n<p>\n\n```text\nalabaster==1.0.0\namqp==5.4.0\nannotated-types==0.8.0\nast_serialize==0.11.2\nattrs==26.1.0\nazure-core==1.41.0\nazure-identity==1.25.3\nazure-storage-blob==12.30.1\nbabel==2.18.0\nbandit==1.9.4\nbilliard==4.3.0\nboto3==1.43.104\nbotocore==1.43.104\nbump2version==1.0.1\nbumpversion==0.6.0\ncachetools==7.2.0\ncelery==5.6.3\ncertifi==2026.7.22\ncffi==2.1.1\ncfgv==3.5.0\ncharset-normalizer==3.5.1\nclick==8.5.0\nclick-didyoumean==0.3.1\nclick-plugins==1.1.1.2\nclick-repl==0.4.0\ncolorama==0.4.6\ncoverage==7.16.2\ncryptography==50.0.1\ndebugpy==1.8.22\ndistlib==0.4.3\ndnspython==2.8.0\ndocker==7.2.0\ndocutils==0.22.4\nfilelock==4.0.6\nflake8==7.3.0\nflake8-docstrings==1.7.0\ngevent==26.8.0\ngoogle-api-core==2.39.0\ngoogle-auth==2.59.0\ngoogle-cloud-core==2.7.0\ngoogle-cloud-firestore==2.30.0\ngoogle-cloud-storage==3.15.0\ngoogle-crc32c==1.9.0\ngoogle-resumable-media==2.10.2\ngoogleapis-common-protos==1.75.4\ngreenlet==3.5.6\ngrpcio==1.84.0\ngrpcio-status==1.84.0\nidentify==2.6.20\nidna==3.20\nimagesize==2.0.1\niniconfig==2.3.0\nisodate==0.7.2\nJinja2==3.1.6\njmespath==1.1.0\nkombu==5.7.0a1\nlibrt==0.16.0\nmarkdown-it-py==4.2.0\nMarkupSafe==3.0.3\nmccabe==0.7.0\nmdurl==0.1.2\nmock==5.2.0\nmoto==5.2.3\nmsal==1.39.0\nmsal-extensions==1.3.1\nmsgpack==1.2.2\nmypy==2.3.1\nmypy_extensions==1.1.0\nnodeenv==1.11.0\nopentelemetry-api==1.45.0\npackaging==26.3\npathspec==1.1.1\nplatformdirs==4.12.1\npluggy==1.6.0\npre_commit==4.6.2\nprompt_toolkit==3.0.53\nproto-plus==1.28.4\nprotobuf==7.36.2\npsutil==7.2.2\npyasn1==0.6.4\npyasn1_modules==0.4.2\npycodestyle==2.14.0\npycparser==3.0\npycurl==7.48.0\npydantic==2.13.5\npydantic_core==2.46.5\npydocstyle==6.3.0\npyflakes==3.4.0\nPygments==2.21.0\nPyJWT==2.15.1\npymongo==4.18.0\npyperclip==1.11.0\npyproject-api==1.11.2\npytest==9.1.1\npytest-celery==1.3.0\npytest-click==1.1.0\npytest-cov==7.1.0\npytest-order==1.5.0\npytest-rerunfailures==16.6.1\npytest-subtests==0.15.0\npytest-timeout==2.4.0\npytest_docker_tools==3.1.10\npython-dateutil==2.9.0.post0\npython-discovery==1.6.1\npython-memcached==1.62\nPyYAML==6.0.3\nredis==8.1.0\nrequests==2.34.2\nresponses==0.26.3\nrich==15.0.0\nroman-numerals==4.1.0\ns3transfer==0.19.2\nsetuptools==84.0.0\nsix==1.17.0\nsnowballstemmer==3.1.1\nSphinx==9.1.0\nsphinx-celery==2.1.3\nsphinx-click==6.2.0\nsphinx-testing==1.0.1\nsphinx2rst==1.1.0\nsphinxcontrib-applehelp==2.0.0\nsphinxcontrib-devhelp==2.0.0\nsphinxcontrib-htmlhelp==2.1.0\nsphinxcontrib-jsmath==1.0.1\nsphinxcontrib-qthelp==2.0.0\nsphinxcontrib-serializinghtml==2.0.0\nSQLAlchemy==2.0.54\nstevedore==5.9.1\ntenacity==9.1.4\ntomli_w==1.2.0\ntox==4.64.3\ntyping-inspection==0.4.4\ntyping_extensions==4.16.0\ntzdata==2026.4\ntzlocal==5.4.4\nurllib3==1.26.20\nvine==5.1.0\nvirtualenv==21.13.0\nwcwidth==0.9.1\nWerkzeug==3.1.9\nwheel==0.48.0\nxmltodict==1.0.4\nzope.event==6.2\nzope.interface==8.6\n```\n\n</p>\n</details>\n\n### Other Dependencies\n<!--\nPlease provide system dependencies, configuration files\nand other dependency information if applicable\n-->\n<details>\n<p>\n\n- IANA timezone data must contain `America/New_York`. The environment uses\n  system zoneinfo data and has `tzdata==2026.4` installed.\n- `tzlocal==5.4.4`, `billiard==4.3.0`, `vine==5.1.0`,\n  `python-dateutil==2.9.0.post0`, and other installed versions are listed above.\n- The configured in-memory broker/backend are only used to construct the app\n  and produce diagnostics. No external services or daemon logs are needed.\n\n</p>\n</details>\n\n## Minimally Reproducible Test Case\n<!--\nPlease provide a reproducible test case.\nRefer to the Reporting Bugs section in our contribution guide.\n\nWe prefer submitting test cases in the form of a PR to our integration test suite.\nIf you can provide one, please mention the PR number below.\nIf not, please attach the most minimal code example required to reproduce the issue below.\nIf the test case is too large, please include a link to a gist or a repository below.\n\nAlternatively, the pytest-celery plugin can be used to create standalone reproduction scripts\nthat can be added to this report. See the pytest-celery documentation for more information at\npytest-celery.readthedocs.io\n-->\n\n<details>\n<p>\n\n```python\nfrom datetime import datetime, timedelta\nfrom zoneinfo import ZoneInfo\n\nfrom celery import Celery\nfrom celery.schedules import schedule\n\napp = Celery('dst_repro', broker='memory://', backend='cache+memory://')\napp.conf.timezone = 'America/New_York'\nlast_run_at = datetime(2026, 11, 1, 0, 30, tzinfo=ZoneInfo('America/New_York'))\ns = schedule(\n    timedelta(days=1), relative=True, nowfun=lambda: last_run_at, app=app,\n)\n\nprint('remaining:', s.remaining_estimate(last_run_at))\nprint('is_due:', s.is_due(last_run_at))\nassert s.remaining_estimate(last_run_at) == timedelta(seconds=88200)\nassert s.is_due(last_run_at) == (False, 88200)\n```\n\n</p>\n</details>\n\n# Expected Behavior\n<!-- Describe in detail what you expect to happen -->\n\nFor `relative=True` and `timedelta(days=1)`, advance by one local calendar\nday and then round to midnight. A previous run at\n`2026-11-01 00:30 EDT` should have its next deadline at\n`2026-11-02 00:00 EST`.\n\nAt `now == last_run_at`, the expected result is:\n\n```text\nremaining: 1 day, 0:30:00\nis_due: schedstate(is_due=False, next=88200.0)\n```\n\nThe 88,200 seconds include the extra hour introduced by the DST rollback.\n\n# Actual Behavior\n<!--\nDescribe in detail what actually happened.\nPlease include a backtrace and surround it with triple backticks (```).\nIn addition, include the Celery daemon logs, the broker logs,\nthe result backend logs and system logs below if they will help us debug\nthe issue.\n-->\n\n\nOn unchanged main, the test produces:\n\n```text\nremaining: -1 day, 23:30:00\nis_due: schedstate(is_due=True, next=86400.0)\n```\n\nThe included assertion fails:\n\n```text\nTraceback (most recent call last):\n  File \"repro.py\", line 16, in <module>\n    assert s.remaining_estimate(last_run_at) == timedelta(seconds=88200)\nAssertionError\n```\n\nThe calculation adds 86,400 elapsed seconds, reaching\n`2026-11-01 23:30 EST`, then `delta_resolution()` rounds that down to\n`2026-11-01 00:00 EDT`. This deadline is 1,800 seconds before `last_run_at`,\nso `schedule.is_due()` considers the task immediately due. Beat can dispatch\nadditional runs on consecutive ticks before the deadline advances.\n\nRelated cases also fail: two-day relative intervals across DST, daily\nrelative intervals around spring-forward that round to the following date\ninstead of the intended date, and hourly relative schedules during Lord\nHowe's half-hour rollback. Hourly schedules during a full repeated hour\nmust retain elapsed-time arithmetic so both occurrences can execute.\n\nSuggested fix in PR #10818 \n\n", "hints_text": "", "created_at": "2026-10-07T08:54:53Z"}
{"repo": "celery/celery", "pull_number": 10811, "instance_id": "celery__celery-10811", "issue_numbers": ["8789"], "base_commit": "f0c6e622aa44afea3eaacd1128060351e636a7e6", "patch": "diff --git a/celery/result.py b/celery/result.py\nindex b09bc3a872b..689d39e39aa 100644\n--- a/celery/result.py\n+++ b/celery/result.py\n@@ -306,14 +306,16 @@ def B(i):\n             def pow2(i):\n                 return i ** 2\n \n+        To collect only the values returned by leaf tasks, unpack each pair\n+        and select results with no children:\n+\n         .. code-block:: pycon\n \n-            >>> from celery.result import ResultBase\n             >>> from proj.tasks import A\n \n             >>> result = A.delay(10)\n-            >>> [v for v in result.collect()\n-            ...  if not isinstance(v, (ResultBase, tuple))]\n+            >>> [value for child, value in result.collect()\n+            ...  if not child.children]\n             [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]\n \n         Note:\n", "test_patch": "diff --git a/t/unit/tasks/test_result.py b/t/unit/tasks/test_result.py\nindex a740341cf24..029f5496a38 100644\n--- a/t/unit/tasks/test_result.py\n+++ b/t/unit/tasks/test_result.py\n@@ -1,5 +1,6 @@\n import copy\n import datetime\n+import doctest\n import platform\n import traceback\n from contextlib import contextmanager\n@@ -489,6 +490,42 @@ def test_forget_remove_pending_result(self):\n         del result\n \n \n+class test_collect:\n+\n+    @pytest.mark.usefixtures('depends_on_current_app')\n+    @pytest.mark.parametrize('serializer', ['json', 'pickle'])\n+    def test_documented_example(self, serializer):\n+        self.app.conf.result_serializer = serializer\n+        children = []\n+        for i in range(10):\n+            leaf = self.app.AsyncResult(uuid())\n+            self.app.backend.mark_as_done(leaf.id, i ** 2)\n+            child = self.app.AsyncResult(uuid())\n+            request = Context()\n+            request.children.append(leaf)\n+            self.app.backend.mark_as_done(\n+                child.id, leaf, request=request,\n+            )\n+            children.append(child)\n+        group = self.app.GroupResult(uuid(), children)\n+        result = self.app.AsyncResult(uuid())\n+        request = Context()\n+        request.children.append(group)\n+        self.app.backend.mark_as_done(\n+            result.id, group, request=request,\n+        )\n+\n+        example = doctest.DocTestFinder().find(AsyncResult.collect)[0]\n+        example.examples = [\n+            item for item in example.examples\n+            if 'result.collect(' in item.source\n+        ]\n+        example.globs['result'] = result\n+        failures, attempted = doctest.DocTestRunner().run(example)\n+        assert attempted == 1\n+        assert failures == 0\n+\n+\n class test_ResultSet:\n \n     def test_resultset_repr(self):\n", "problem_statement": "result.collect() returning empty for the example in the documentation\n<!--\r\nPlease fill this template entirely and do not erase parts of it.\r\nWe reserve the right to close without a response\r\nbug reports which are incomplete.\r\n-->\r\n# Checklist\r\n<!--\r\nTo check an item on the list replace [ ] with [x].\r\n-->\r\n- [x] I have verified that the issue exists against the `main` branch of Celery.\r\n- [x] This has already been asked to the [discussions forum](https://github.com/celery/celery/discussions) first.\r\n- [x] I have read the relevant section in the\r\n  [contribution guide](https://docs.celeryq.dev/en/main/contributing.html#other-bugs)\r\n  on reporting bugs.\r\n- [x] I have checked the [issues list](https://github.com/celery/celery/issues?q=is%3Aissue+label%3A%22Issue+Type%3A+Bug+Report%22+-label%3A%22Category%3A+Documentation%22)\r\n  for similar or identical bug reports.\r\n- [x] I have checked the [pull requests list](https://github.com/celery/celery/pulls?q=is%3Apr+label%3A%22PR+Type%3A+Bugfix%22+-label%3A%22Category%3A+Documentation%22)\r\n  for existing proposed fixes.\r\n- [x] I have checked the [commit log](https://github.com/celery/celery/commits/main)\r\n  to find out if the bug was already fixed in the main branch.\r\n- [x] I have included all related issues and possible duplicate issues\r\n  in this issue (If there are none, check this box anyway).\r\n\r\n## Mandatory Debugging Information\r\n\r\n- [ ] I have included the output of ``celery -A proj report`` in the issue.\r\n    (if you are not able to do this, then at least specify the Celery\r\n     version affected).\r\n- [ ] I have verified that the issue exists against the `main` branch of Celery.\r\n- [ ] I have included the contents of ``pip freeze`` in the issue.\r\n- [x] I have included all the versions of all the external dependencies required\r\n  to reproduce this bug.\r\n\r\n## Optional Debugging Information\r\n<!--\r\nTry some of the below if you think they are relevant.\r\nIt will help us figure out the scope of the bug and how many users it affects.\r\n-->\r\n- [ ] I have tried reproducing the issue on more than one Python version\r\n  and/or implementation.\r\n- [ ] I have tried reproducing the issue on more than one message broker and/or\r\n  result backend.\r\n- [ ] I have tried reproducing the issue on more than one version of the message\r\n  broker and/or result backend.\r\n- [ ] I have tried reproducing the issue on more than one operating system.\r\n- [ ] I have tried reproducing the issue on more than one workers pool.\r\n- [ ] I have tried reproducing the issue with autoscaling, retries,\r\n  ETA/Countdown & rate limits disabled.\r\n- [ ] I have tried reproducing the issue after downgrading\r\n  and/or upgrading Celery and its dependencies.\r\n\r\n## Related Issues and Possible Duplicates\r\n<!--\r\nPlease make sure to search and mention any related issues\r\nor possible duplicates to this issue as requested by the checklist above.\r\n\r\nThis may or may not include issues in other repositories that the Celery project\r\nmaintains or other repositories that are dependencies of Celery.\r\n\r\nIf you don't know how to mention issues, please refer to Github's documentation\r\non the subject: https://help.github.com/en/articles/autolinked-references-and-urls#issues-and-pull-requests\r\n-->\r\n\r\n#### Related Issues\r\n\r\n- None\r\n\r\n#### Possible Duplicates\r\n\r\n- None\r\n\r\n## Environment & Settings\r\n<!-- Include the contents of celery --version below -->\r\n**Celery version**: 5.3.4\r\n**Python version**: 3.8.10\r\n<!-- Include the output of celery -A proj report below -->\r\n<details>\r\n<summary><b><code>celery report</code>:\r\ncelery_1  |  -------------- celery@fc9a5ae8ab17 v5.3.4 (emerald-rush)\r\ncelery_1  | --- ***** -----\r\ncelery_1  | -- ******* ---- Linux-5.4.0-150-generic-x86_64-with-glibc2.29 2024-01-10 17:28:52\r\ncelery_1  | - *** --- * ---\r\ncelery_1  | - ** ---------- [config]\r\ncelery_1  | - ** ---------- .> app:         celery_app:0x7f4f829d98e0\r\ncelery_1  | - ** ---------- .> transport:   redis://mituna_redis:6379//\r\ncelery_1  | - ** ---------- .> results:     redis://mituna_redis:6379/\r\ncelery_1  | - *** --- * --- .> concurrency: 72 (prefork)\r\ncelery_1  | -- ******* ---- .> task events: ON\r\ncelery_1  | --- ***** -----\r\ncelery_1  |  -------------- [queues]\r\ncelery_1  |                 .> celery           exchange=celery(direct) key=celery\r\ncelery_1  |\r\ncelery_1  |\r\ncelery_1  | [tasks]\r\ncelery_1  |   . tuna.celery_app.celery.A\r\ncelery_1  |   . tuna.celery_app.celery.B\r\ncelery_1  |   . tuna.celery_app.celery.async_call\r\ncelery_1  |   . tuna.celery_app.celery.group_tasks\r\ncelery_1  |   . tuna.celery_app.celery.pow2\r\n \r\n\r\ncelery_1  | [2024-01-10 15:01:14,312: INFO/MainProcess] Task tuna.celery_app.celery.pow2[78223919-cc49-4166-8546-6e4a48345478] received\r\ncelery_1  | [2024-01-10 15:01:14,312: INFO/ForkPoolWorker-63] Task tuna.celery_app.celery.pow2[77c7e134-1922-44db-9d55-e3f6b018fb89] succeeded in 0.00052880764008s: 1\r\ncelery_1  | [2