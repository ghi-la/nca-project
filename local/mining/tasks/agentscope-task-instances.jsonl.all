 def _format_agent_message(\n                 },\n             )\n \n-        if conversation_blocks and is_first:\n+        if conversation_blocks:\n+            prompt = self.conversation_history_prompt if is_first else \"\"\n             if conversation_blocks[0].get(\"text\"):\n                 conversation_blocks[0][\"text\"] = (\n-                    self.conversation_history_prompt\n-                    + \"<history>\\n\"\n-                    + conversation_blocks[0][\"text\"]\n+                    prompt + \"<history>\\n\" + conversation_blocks[0][\"text\"]\n                 )\n             else:\n                 conversation_blocks.insert(\n                     0,\n                     {\n                         \"type\": \"text\",\n-                        \"text\": self.conversation_history_prompt\n-                        + \"<history>\\n\",\n+                        \"text\": prompt + \"<history>\\n\",\n                     },\n                 )\n \n@@ -511,7 +531,6 @@ async def _format_agent_message(\n                     {\"type\": \"text\", \"text\": \"</history>\"},\n                 )\n \n-        if conversation_blocks:\n             return [\n                 {\n                     \"role\": \"user\",\ndiff --git a/src/agentscope/formatter/_dashscope_formatter.py b/src/agentscope/formatter/_dashscope_formatter.py\nindex 9ea0a2acc7..37df50502e 100644\n--- a/src/agentscope/formatter/_dashscope_formatter.py\n+++ b/src/agentscope/formatter/_dashscope_formatter.py\n@@ -477,12 +477,17 @@ async def format(self, msgs: list[Msg]) -> list[dict]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n+                        prompt_requires_text=True,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -497,6 +502,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the DashScope chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The DashScope user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_deepseek_formatter.py b/src/agentscope/formatter/_deepseek_formatter.py\nindex 845b972928..e955f30b31 100644\n--- a/src/agentscope/formatter/_deepseek_formatter.py\n+++ b/src/agentscope/formatter/_deepseek_formatter.py\n@@ -291,12 +291,16 @@ async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -311,6 +315,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the DeepSeek chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The DeepSeek user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_formatter_base.py b/src/agentscope/formatter/_formatter_base.py\nindex ff34e331a5..5a57db7332 100644\n--- a/src/agentscope/formatter/_formatter_base.py\n+++ b/src/agentscope/formatter/_formatter_base.py\n@@ -5,13 +5,14 @@\n import tempfile\n from abc import abstractmethod\n from fnmatch import fnmatch\n-from typing import Any, List, AsyncGenerator\n+from typing import Any, AsyncGenerator, Awaitable, Callable, List\n \n from pydantic import BaseModel, Field\n \n from ..message import (\n     Msg,\n     DataBlock,\n+    HintBlock,\n     TextBlock,\n     URLSource,\n )\n@@ -229,3 +230,131 @@ async def _group_messages(msgs: list[Msg]) -> AsyncGenerator:\n \n         if group_type:\n             yield group_type, group\n+\n+    @staticmethod\n+    def _split_agent_messages_at_hints(\n+        msgs: list[Msg],\n+    ) -> list[tuple[bool, list[Msg]]]:\n+        \"\"\"Split agent messages around hints while preserving message order.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                The non-tool messages in one agent-message group.\n+\n+        Returns:\n+            `list[tuple[bool, list[Msg]]]`:\n+                Ordered segments. The boolean is ``True`` for a segment that\n+                contains a single ``HintBlock`` and ``False`` for history\n+                segments. Messages without hints are returned unchanged as a\n+                single history segment.\n+        \"\"\"\n+        if not any(\n+            isinstance(block, HintBlock)\n+            for msg in msgs\n+            for block in msg.get_content_blocks()\n+        ):\n+            return [(False, msgs)] if msgs else []\n+\n+        segments: list[tuple[bool, list[Msg]]] = []\n+        history_messages: list[Msg] = []\n+\n+        for msg in msgs:\n+            history_blocks = []\n+            for block in msg.get_content_blocks():\n+                if isinstance(block, HintBlock):\n+                    if history_blocks:\n+                        history_messages.append(\n+                            msg.model_copy(update={\"content\": history_blocks}),\n+                        )\n+                        history_blocks = []\n+\n+                    if history_messages:\n+                        segments.append((False, history_messages))\n+                        history_messages = []\n+\n+                    segments.append(\n+                        (\n+                            True,\n+                            [msg.model_copy(update={\"content\": [block]})],\n+                        ),\n+                    )\n+                else:\n+                    history_blocks.append(block)\n+\n+            if history_blocks:\n+                history_messages.append(\n+                    msg.model_copy(update={\"content\": history_blocks}),\n+                )\n+\n+        if history_messages:\n+            segments.append((False, history_messages))\n+\n+        return segments\n+\n+    async def _format_agent_message_with_hints(\n+        self,\n+        msgs: list[Msg],\n+        is_first: bool,\n+        format_agent_message: Callable[\n+            [list[Msg], bool],\n+            Awaitable[list[Any]],\n+        ],\n+        *,\n+        prompt_requires_text: bool = False,\n+    ) -> tuple[list[Any], bool]:\n+        \"\"\"Format history and route each hint through its chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                The non-tool messages in one agent-message group.\n+            is_first (`bool`):\n+                Whether the first history segment should include its prompt.\n+            format_agent_message (`Callable`):\n+                The provider-specific history formatter.\n+            prompt_requires_text (`bool`):\n+                Whether media-only history omits the history prompt.\n+\n+        Returns:\n+            `tuple[list[Any], bool]`:\n+                The formatted messages and whether a history segment was\n+                eligible for the prompt.\n+        \"\"\"\n+        formatted_messages: list[Any] = []\n+        has_prompt_segment = False\n+\n+        for is_hint, segment in self._split_agent_messages_at_hints(msgs):\n+            if is_hint:\n+                formatted_messages.extend(\n+                    await self._format_hint_message(segment),\n+                )\n+                continue\n+\n+            formatted_history = await format_agent_message(segment, is_first)\n+            formatted_messages.extend(formatted_history)\n+            if formatted_history and (\n+                not prompt_requires_text\n+                or any(msg.has_content_blocks(\"text\") for msg in segment)\n+            ):\n+                is_first = False\n+                has_prompt_segment = True\n+\n+        return formatted_messages, has_prompt_segment\n+\n+    async def _format_hint_message(self, msgs: list[Msg]) -> list[Any]:\n+        \"\"\"Format a HintBlock message through the provider's chat formatter.\n+\n+        Multi-agent formatters that delegate tool sequences to a chat\n+        formatter can reuse that path. Providers with a different delegation\n+        override this method.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[Any]`:\n+                The provider-specific user-message representation.\n+        \"\"\"\n+        raise RuntimeError(\n+            \"A provider chat formatter is required for HintBlock messages.\",\n+        )\ndiff --git a/src/agentscope/formatter/_gemini_formatter.py b/src/agentscope/formatter/_gemini_formatter.py\nindex 1cee40df43..9944f60ec9 100644\n--- a/src/agentscope/formatter/_gemini_formatter.py\n+++ b/src/agentscope/formatter/_gemini_formatter.py\n@@ -348,12 +348,16 @@ async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -368,6 +372,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the Gemini chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The Gemini user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_minimax_formatter.py b/src/agentscope/formatter/_minimax_formatter.py\nindex 944b3f7762..7857bf1733 100644\n--- a/src/agentscope/formatter/_minimax_formatter.py\n+++ b/src/agentscope/formatter/_minimax_formatter.py\n@@ -9,7 +9,7 @@\n     AnthropicChatFormatter,\n     AnthropicMultiAgentFormatter,\n )\n-from ..message import DataBlock\n+from ..message import DataBlock, Msg\n \n \n class MiniMaxChatFormatter(AnthropicChatFormatter):\n@@ -48,6 +48,24 @@ class MiniMaxMultiAgentFormatter(AnthropicMultiAgentFormatter):\n         ),\n     )\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the MiniMax chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The MiniMax user-message representation.\n+        \"\"\"\n+        return await MiniMaxChatFormatter(\n+            input_types=self.input_types,\n+        ).format(msgs)\n+\n     def _format_anthropic_data_block(\n         self,\n         block: DataBlock,\ndiff --git a/src/agentscope/formatter/_moonshot_formatter.py b/src/agentscope/formatter/_moonshot_formatter.py\nindex 9ed223183d..aa0e081d57 100644\n--- a/src/agentscope/formatter/_moonshot_formatter.py\n+++ b/src/agentscope/formatter/_moonshot_formatter.py\n@@ -396,12 +396,17 @@ async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n+                        prompt_requires_text=True,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -416,6 +421,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the Moonshot chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The Moonshot user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_ollama_formatter.py b/src/agentscope/formatter/_ollama_formatter.py\nindex 56ed65ad83..9a0ac2d363 100644\n--- a/src/agentscope/formatter/_ollama_formatter.py\n+++ b/src/agentscope/formatter/_ollama_formatter.py\n@@ -382,12 +382,16 @@ async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -401,6 +405,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the Ollama chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The Ollama user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\n@@ -439,20 +459,18 @@ async def _format_agent_message(\n                 {\"text\": \"\\n\".join(accumulated_text)},\n             )\n \n-        if conversation_blocks and is_first:\n+        if conversation_blocks:\n+            prompt = self.conversation_history_prompt if is_first else \"\"\n             if conversation_blocks[0].get(\"text\"):\n                 conversation_blocks[0][\"text\"] = (\n-                    self.conversation_history_prompt\n-                    + \"<history>\\n\"\n-                    + conversation_blocks[0][\"text\"]\n+                    prompt + \"<history>\\n\" + conversation_blocks[0][\"text\"]\n                 )\n \n             else:\n                 conversation_blocks.insert(\n                     0,\n                     {\n-                        \"text\": self.conversation_history_prompt\n-                        + \"<history>\\n\",\n+                        \"text\": prompt + \"<history>\\n\",\n                     },\n                 )\n \ndiff --git a/src/agentscope/formatter/_openai_formatter.py b/src/agentscope/formatter/_openai_formatter.py\nindex f0f70282a9..5931d99d8d 100644\n--- a/src/agentscope/formatter/_openai_formatter.py\n+++ b/src/agentscope/formatter/_openai_formatter.py\n@@ -472,12 +472,17 @@ async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n+                        prompt_requires_text=True,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -492,6 +497,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the OpenAI chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The OpenAI user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_openai_response_formatter.py b/src/agentscope/formatter/_openai_response_formatter.py\nindex 5f337c6290..fa2364bcb8 100644\n--- a/src/agentscope/formatter/_openai_response_formatter.py\n+++ b/src/agentscope/formatter/_openai_response_formatter.py\n@@ -454,12 +454,16 @@ async def format(\n                     await self._format_tool_sequence(group),\n                 )\n             elif typ == \"agent_message\":\n-                formatted_group = await self._format_agent_message(\n+                (\n+                    formatted_group,\n+                    has_history,\n+                ) = await self._format_agent_message_with_hints(\n                     group,\n                     is_first_agent_message,\n+                    self._format_agent_message,\n                 )\n                 formatted_msgs.extend(formatted_group)\n-                if formatted_group:\n+                if has_history:\n                     is_first_agent_message = False\n \n         return formatted_msgs\n@@ -483,6 +487,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the OpenAI Responses formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The Responses API user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_volcengine_formatter.py b/src/agentscope/formatter/_volcengine_formatter.py\nindex 9d0e9ba1f8..3349ad540a 100644\n--- a/src/agentscope/formatter/_volcengine_formatter.py\n+++ b/src/agentscope/formatter/_volcengine_formatter.py\n@@ -339,12 +339,17 @@ async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:\n                         await self._format_tool_sequence(group),\n                     )\n                 case \"agent_message\":\n-                    formatted_group = await self._format_agent_message(\n+                    (\n+                        formatted_group,\n+                        has_history,\n+                    ) = await self._format_agent_message_with_hints(\n                         group,\n                         is_first_agent_message,\n+                        self._format_agent_message,\n+                        prompt_requires_text=True,\n                     )\n                     formatted_msgs.extend(formatted_group)\n-                    if formatted_group:\n+                    if has_history:\n                         is_first_agent_message = False\n \n         return formatted_msgs\n@@ -359,6 +364,22 @@ async def _format_tool_sequence(\n             input_types=self.input_types,\n         ).format(msgs)\n \n+    async def _format_hint_message(\n+        self,\n+        msgs: list[Msg],\n+    ) -> list[dict[str, Any]]:\n+        \"\"\"Format hint messages with the Volcengine chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[dict[str, Any]]`:\n+                The Volcengine user-message representation.\n+        \"\"\"\n+        return await self._format_tool_sequence(msgs)\n+\n     async def _format_agent_message(\n         self,\n         msgs: list[Msg],\ndiff --git a/src/agentscope/formatter/_xai_formatter.py b/src/agentscope/formatter/_xai_formatter.py\nindex 38ee4996e1..29a30677e9 100644\n--- a/src/agentscope/formatter/_xai_formatter.py\n+++ b/src/agentscope/formatter/_xai_formatter.py\n@@ -360,8 +360,9 @@ class XAIMultiAgentFormatter(FormatterBase):\n     Produces ``xai_sdk`` protobuf ``Message`` objects (same as\n     :class:`XAIChatFormatter`).  Prior agent-to-agent messages are collapsed\n     into a single ``user`` message with ``<history></history>`` tags; the\n-    images of those messages are appended to the same ``user`` message, and\n-    tool call / result sequences are delegated to :class:`XAIChatFormatter`.\n+    images of those messages are appended to the same ``user`` message.\n+    Hint blocks and tool call / result sequences are delegated to\n+    :class:`XAIChatFormatter`.\n \n     .. note:: ``format()`` returns ``list[Any]`` (protobuf messages), not\n         ``list[dict]``.\n@@ -427,29 +428,53 @@ async def format(\n                     ).format(group),\n                 )\n             elif typ == \"agent_message\":\n-                history_text = self._build_history_text(\n+                for is_hint, segment in self._split_agent_messages_at_hints(\n                     group,\n-                    is_first=is_first_agent_message,\n-                )\n-                user_args = _xai_user_args_from_blocks(\n-                    [\n-                        block\n-                        for msg in group\n-                        for block in msg.get_content_blocks()\n-                        if isinstance(block, DataBlock)\n-                    ],\n-                    image,\n-                    self.supported_input_media_types,\n-                )\n-                if history_text:\n-                    user_args.insert(0, history_text)\n-                if user_args:\n-                    xai_messages.append(user(*user_args))\n+                ):\n+                    if is_hint:\n+                        xai_messages.extend(\n+                            await self._format_hint_message(segment),\n+                        )\n+                        continue\n+\n+                    history_text = self._build_history_text(\n+                        segment,\n+                        is_first=is_first_agent_message,\n+                    )\n+                    user_args = _xai_user_args_from_blocks(\n+                        [\n+                            block\n+                            for msg in segment\n+                            for block in msg.get_content_blocks()\n+                            if isinstance(block, DataBlock)\n+                        ],\n+                        image,\n+                        self.supported_input_media_types,\n+                    )\n                     if history_text:\n-                        is_first_agent_message = False\n+                        user_args.insert(0, history_text)\n+                    if user_args:\n+                        xai_messages.append(user(*user_args))\n+                        if history_text:\n+                            is_first_agent_message = False\n \n         return xai_messages\n \n+    async def _format_hint_message(self, msgs: list[Msg]) -> list[Any]:\n+        \"\"\"Format hint messages with the xAI chat formatter.\n+\n+        Args:\n+            msgs (`list[Msg]`):\n+                One message containing a single ``HintBlock``.\n+\n+        Returns:\n+            `list[Any]`:\n+                The xAI user-message representation.\n+        \"\"\"\n+        return await XAIChatFormatter(\n+            input_types=self.input_types,\n+        ).format(msgs)\n+\n     def _build_history_text(self, msgs: list[Msg], *, is_first: bool) -> str:\n         \"\"\"Build a ``<history>\u2026</history>`` text block from agent messages.\n \n", "test_patch": "diff --git a/tests/formatter_multi_agent_hint_test.py b/tests/formatter_multi_agent_hint_test.py\nnew file mode 100644\nindex 0000000000..f8e1ff7398\n--- /dev/null\n+++ b/tests/formatter_multi_agent_hint_test.py\n@@ -0,0 +1,184 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"Regression tests for HintBlock handling in multi-agent formatters.\"\"\"\n+from unittest import IsolatedAsyncioTestCase\n+\n+from agentscope.formatter import (\n+    AnthropicChatFormatter,\n+    AnthropicMultiAgentFormatter,\n+    DashScopeChatFormatter,\n+    DashScopeMultiAgentFormatter,\n+    DeepSeekChatFormatter,\n+    DeepSeekMultiAgentFormatter,\n+    GeminiChatFormatter,\n+    GeminiMultiAgentFormatter,\n+    MiniMaxChatFormatter,\n+    MiniMaxMultiAgentFormatter,\n+    MoonshotChatFormatter,\n+    MoonshotMultiAgentFormatter,\n+    OllamaChatFormatter,\n+    OllamaMultiAgentFormatter,\n+    OpenAIChatFormatter,\n+    OpenAIMultiAgentFormatter,\n+    OpenAIResponseFormatter,\n+    OpenAIResponseMultiAgentFormatter,\n+    VolcengineChatFormatter,\n+    VolcengineMultiAgentFormatter,\n+)\n+from agentscope.message import (\n+    AssistantMsg,\n+    Base64Source,\n+    DataBlock,\n+    HintBlock,\n+    TextBlock,\n+    UserMsg,\n+)\n+\n+\n+FORMATTER_PAIRS = (\n+    (AnthropicMultiAgentFormatter, AnthropicChatFormatter),\n+    (DashScopeMultiAgentFormatter, DashScopeChatFormatter),\n+    (DeepSeekMultiAgentFormatter, DeepSeekChatFormatter),\n+    (GeminiMultiAgentFormatter, GeminiChatFormatter),\n+    (MiniMaxMultiAgentFormatter, MiniMaxChatFormatter),\n+    (MoonshotMultiAgentFormatter, MoonshotChatFormatter),\n+    (OllamaMultiAgentFormatter, OllamaChatFormatter),\n+    (OpenAIMultiAgentFormatter, OpenAIChatFormatter),\n+    (OpenAIResponseMultiAgentFormatter, OpenAIResponseFormatter),\n+    (VolcengineMultiAgentFormatter, VolcengineChatFormatter),\n+)\n+\n+\n+class TestMultiAgentHintFormatting(IsolatedAsyncioTestCase):\n+    \"\"\"Check the complete provider payload produced for HintBlock messages.\"\"\"\n+\n+    async def test_hint_only_message_matches_chat_formatter(self) -> None:\n+        \"\"\"A memory-only hint is emitted instead of disappearing.\"\"\"\n+        hint_msg = AssistantMsg(\n+            name=\"memory\",\n+            content=[HintBlock(hint=\"Remember the user's preference.\")],\n+        )\n+        question_msg = UserMsg(\n+            name=\"alice\",\n+            content=\"What should I remember?\",\n+        )\n+\n+        for multi_agent_cls, chat_cls in FORMATTER_PAIRS:\n+            with self.subTest(formatter=multi_agent_cls.__name__):\n+                multi_agent_formatter = multi_agent_cls()\n+                chat_formatter = chat_cls()\n+                actual = await multi_agent_formatter.format(\n+                    [hint_msg, question_msg],\n+                )\n+                expected = await chat_formatter.format([hint_msg])\n+                expected.extend(\n+                    await multi_agent_formatter.format([question_msg]),\n+                )\n+\n+                self.assertListEqual(expected, actual)\n+\n+    async def test_history_after_hint_keeps_its_tags(self) -> None:\n+        \"\"\"Each text segment is history, with the prompt on the first.\"\"\"\n+        messages = [\n+            UserMsg(\"user\", \"first\"),\n+            AssistantMsg(\"Alice\", [HintBlock(hint=\"note\")]),\n+            UserMsg(\"user\", \"second\"),\n+        ]\n+        for cls in (\n+            AnthropicMultiAgentFormatter,\n+            MiniMaxMultiAgentFormatter,\n+            OllamaMultiAgentFormatter,\n+        ):\n+            with self.subTest(formatter=cls.__name__):\n+                formatter = cls(conversation_history_prompt=\"Custom\\n\")\n+                separator = \"\\n\" if cls is OllamaMultiAgentFormatter else \" \"\n+                texts = [\n+                    f\"Custom\\n<history>\\nuser:{separator}first\\n</history>\",\n+                    \"note\",\n+                    f\"<history>\\nuser:{separator}second\\n</history>\",\n+                ]\n+                expected = [\n+                    {\n+                        \"role\": \"user\",\n+                        \"content\": (\n+                            text\n+                            if cls is OllamaMultiAgentFormatter\n+                            else [{\"type\": \"text\", \"text\": text}]\n+                        ),\n+                    }\n+                    for text in texts\n+                ]\n+                self.assertEqual(await formatter.format(messages), expected)\n+\n+    async def test_image_before_hint_preserves_history_prompt(self) -> None:\n+        \"\"\"An image-only segment leaves the prompt for the first text.\"\"\"\n+        source = Base64Source(media_type=\"image/png\", data=\"YQ==\")\n+        messages = [\n+            UserMsg(\"user\", [DataBlock(source=source)]),\n+            AssistantMsg(\"Alice\", [HintBlock(hint=\"note\")]),\n+            UserMsg(\"user\", \"second\"),\n+        ]\n+        image = {\n+            \"type\": \"image_url\",\n+            \"image_url\": {\"url\": \"data:image/png;base64,YQ==\"},\n+        }\n+        hint = {\"type\": \"text\", \"text\": \"note\"}\n+        history = {\n+            \"type\": \"text\",\n+            \"text\": \"Custom\\n<history>\\nuser: second\\n</history>\",\n+        }\n+        expected = [\n+            {\"role\": \"user\", \"content\": [part]}\n+            for part in (image, hint, history)\n+        ]\n+        for cls in (\n+            OpenAIMultiAgentFormatter,\n+            DashScopeMultiAgentFormatter,\n+            MoonshotMultiAgentFormatter,\n+            VolcengineMultiAgentFormatter,\n+        ):\n+            with self.subTest(formatter=cls.__name__):\n+                formatter = cls(conversation_history_prompt=\"Custom\\n\")\n+                self.assertEqual(await formatter.format(messages), expected)\n+\n+    async def test_hint_inside_message_preserves_history_order(self) -> None:\n+        \"\"\"A standalone hint separates two tagged history messages.\"\"\"\n+        mixed_msg = AssistantMsg(\n+            name=\"memory\",\n+            content=[\n+                TextBlock(text=\"Before\"),\n+                HintBlock(hint=\"Keep this instruction.\"),\n+                TextBlock(text=\"After\"),\n+            ],\n+        )\n+        for cls, _ in FORMATTER_PAIRS:\n+            with self.subTest(formatter=cls.__name__):\n+                formatter = cls(conversation_history_prompt=\"Custom\\n\")\n+                separator = \"\\n\" if cls is OllamaMultiAgentFormatter else \" \"\n+                texts = [\n+                    f\"Custom\\n<history>\\nmemory:{separator}Before\\n</history>\",\n+                    \"Keep this instruction.\",\n+                    f\"<history>\\nmemory:{separator}After\\n</history>\",\n+                ]\n+                if cls is GeminiMultiAgentFormatter:\n+                    expected = [\n+                        {\"role\": \"user\", \"parts\": [{\"text\": t}]} for t in texts\n+                    ]\n+                elif cls in (\n+                    DeepSeekMultiAgentFormatter,\n+                    OllamaMultiAgentFormatter,\n+                ):\n+                    expected = [{\"role\": \"user\", \"content\": t} for t in texts]\n+                else:\n+                    kind = (\n+                        \"input_text\"\n+                        if cls is OpenAIResponseMultiAgentFormatter\n+                        else \"text\"\n+                    )\n+                    expected = [\n+                        {\n+                            \"role\": \"user\",\n+                            \"content\": [{\"type\": kind, \"text\": t}],\n+                        }\n+                        for t in texts\n+                    ]\n+                self.assertEqual(await formatter.format([mixed_msg]), expected)\ndiff --git a/tests/formatter_xai_test.py b/tests/formatter_xai_test.py\nindex f3d2166a35..3809a2eae2 100644\n--- a/tests/formatter_xai_test.py\n+++ b/tests/formatter_xai_test.py\n@@ -622,6 +622,59 @@ async def test_multiagent_formatter_conversation_history(self) -> None:\n             res,\n         )\n \n+    async def test_multiagent_hint_only_message_precedes_history(self) -> None:\n+        \"\"\"A hint-only message is emitted before following history.\"\"\"\n+        fmt = XAIMultiAgentFormatter()\n+        msgs = [\n+            AssistantMsg(\n+                name=\"memory\",\n+                content=[HintBlock(hint=\"Remember the user's preference.\")],\n+            ),\n+            UserMsg(name=\"alice\", content=\"What should I remember?\"),\n+        ]\n+\n+        res = await fmt.format(msgs)\n+\n+        self.assertListEqual(\n+            [\n+                user(\"Remember the user's preference.\"),\n+                user(\n+                    fmt.conversation_history_prompt\n+                    + \"<history>\\nalice: What should I remember?\\n</history>\",\n+                ),\n+            ],\n+            res,\n+        )\n+\n+    async def test_multiagent_hint_splits_mixed_history_in_order(self) -> None:\n+        \"\"\"A hint embedded in a message separates ordered history segments.\"\"\"\n+        fmt = XAIMultiAgentFormatter()\n+        msg = AssistantMsg(\n+            name=\"memory\",\n+            content=[\n+                TextBlock(text=\"Context before the hint.\"),\n+                HintBlock(hint=\"Keep this instruction.\"),\n+                TextBlock(text=\"Context after the hint.\"),\n+            ],\n+        )\n+\n+        res = await fmt.format([msg])\n+\n+        self.assertListEqual(\n+            [\n+                user(\n+                    fmt.conversation_history_prompt\n+                    + \"<history>\\nmemory: Context before the hint.\\n\"\n+                    + \"</history>\",\n+                ),\n+                user(\"Keep this instruction.\"),\n+                user(\n+                    \"<history>\\nmemory: Context after the hint.\\n</history>\",\n+                ),\n+            ],\n+            res,\n+        )\n+\n     async def test_multiagent_formatter_first_group_has_hist_prompt(\n         self,\n     ) -> None:\n", "problem_statement": "[Bug]: All 11 multi-agent formatters drop HintBlock content, so memory hints never reach the LLM request\n### Prerequisites\n\n- [X] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [X] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`HintBlock`'s contract (`src/agentscope/message/_block.py:100-103`) states: \"When passed to the LLM API, the hint block is converted into a user message.\" The long-term-memory middleware relies on exactly that: `_build_memory_message` (`src/agentscope/middleware/_longterm_memory/_mem0/_middleware.py:641-662`) appends an assistant-role `Msg` whose only content is a `HintBlock`, and its docstring explains why: \"user messages cannot carry `HintBlock` content. Formatters convert the `HintBlock` itself into a user message before the model call.\"\n\nAll 11 chat formatters implement this conversion (e.g. the OpenAI chat formatter at `src/agentscope/formatter/_openai_formatter.py:288-326`, the Anthropic chat formatter at `src/agentscope/formatter/_anthropic_formatter.py:124`, the Gemini chat formatter at `src/agentscope/formatter/_gemini_formatter.py:171`). The 11 multi-agent formatters (OpenAI, Anthropic, MiniMax, Gemini, DashScope, DeepSeek, Moonshot, Ollama, OpenAIResponse, Volcengine, XAI) diverge: the agent-message walk only handles `TextBlock` and `DataBlock` (e.g. `src/agentscope/formatter/_openai_formatter.py:513-523`), so a `HintBlock` is skipped without a warning.\n\nConsequence: in a multi-agent scenario (`<Provider>MultiAgentFormatter`, the supported multi-agent path per `CONTRIBUTING.md`), a context entry injected by the mem0/reme/agentic-memory middleware \u2014 an assistant `Msg` containing only a `HintBlock` \u2014 disappears from the prompt entirely, so retrieved memories (and budget/`hint`-tool hints) never reach the model. A hint sharing a message with text is likewise swallowed.\n\n**Expected behaviour:** the multi-agent formatters convert `HintBlock` into a user message, matching their chat siblings.\n\n**Actual behaviour:** the hint is dropped silently; a hint-only message produces no output at all.\n\nHappy to be assigned and open a PR \u2014 the fix is to collect the `HintBlock`s during the agent-message walk and convert them through the provider's chat formatter (the same delegation the multi-agent formatters already use for tool sequences).\n\nRelated issues/PRs: searched open issues/PRs for \"HintBlock\" and \"multi-agent formatter hint\" \u2014 the closest are #3105/#3108/#3110/#3112 and PRs #3106/#3109/#3111/#3113 (unsupported *media* placeholders in chat formatters) and #2958 (unsupported media inside a hint in the Volcengine chat formatter); none covers the multi-agent formatters dropping `HintBlock` entirely (checked 2026-10-13).\n\nAI disclosure: this report was prepared with AI assistance to locate and reproduce the bug; I ran the reproduction below against commit `34457377b2919f69cd2cc3391552a333bc1791af` and verified each cited line in the source myself.\n\n### Error Messages\n\nNo exception is raised \u2014 the hint is dropped silently. Running the repro below on unpatched `main` shows the chat formatter honoring the contract while all multi-agent formatters lose the hint:\n\n```text\n=== OpenAIChatFormatter (contract: hint -> user message) ===\n[{'role': 'system', ...},\n {'role': 'user', 'content': [{'type': 'text', 'text': 'Remember: the user prefers metric units.'}]},\n {'role': 'user', 'name': 'alice', ...}]\n\n=== OpenAIMultiAgentFormatter ===\n[{'role': 'system', ...},\n {'role': 'user', 'content': [{'type': 'text', 'text': '# Conversation History\\n...\\n<history>\\nalice: How tall is the Eiffel Tower?\\n</history>'}]}]\nhint present: False\n\n=== DashScopeMultiAgentFormatter ===\nhint present: False\n\n=== GeminiMultiAgentFormatter ===\nhint present: False\n\n=== OpenAIMultiAgentFormatter, hint+text assistant msg ===\nhint present: False\n```\n\n### Steps to Reproduce\n\n1. Code:\n\n```python\nimport asyncio\n\nfrom agentscope.formatter import (\n    OpenAIChatFormatter,\n    OpenAIMultiAgentFormatter,\n    DashScopeMultiAgentFormatter,\n    GeminiMultiAgentFormatter,\n)\nfrom agentscope.message import AssistantMsg, HintBlock, SystemMsg, UserMsg\n\nHINT = \"Remember: the user prefers metric units.\"\nmsgs = [\n    SystemMsg(name=\"system\", content=\"You are a helpful assistant.\"),\n    # Context entry exactly as the mem0 middleware builds it.\n    AssistantMsg(name=\"memory\", content=[HintBlock(hint=HINT)]),\n    UserMsg(name=\"alice\", content=\"How tall is the Eiffel Tower?\"),\n]\n\n\nasync def main() -> None:\n    print(await OpenAIChatFormatter().format(msgs))\n    for fmt_cls in (\n        OpenAIMultiAgentFormatter,\n        DashScopeMultiAgentFormatter,\n        GeminiMultiAgentFormatter,\n    ):\n        out = await fmt_cls().format(msgs)\n        print(fmt_cls.__name__, \"hint present:\", HINT in repr(out))\n\n\nasyncio.run(main())\n```\n\n2. Run: `python repro.py`\n3. See `hint present: False` for every multi-agent formatter (the hint message vanishes from the request), while the chat formatter emits `{'role': 'user', 'content': [{'type': 'text', 'text': 'Remember: the user prefers metric units.'}]}`.\n\n### Environment\n\n- AgentScope Version: 2.0.10 (source checkout at commit `34457377b2919f69cd2cc3391552a333bc1791af`, `main`)\n- Python Version: 3.12.14\n- OS: macOS 26.6.2 (arm64)\n\n", "hints_text": "Hi maintainers \u2014 I\u2019d like to contribute a fix for #3289, but I haven\u2019t started coding. The report says its author is willing to prepare a PR if assigned; is this issue still available for me to take, or would you prefer that I coordinate with the reporter?\n\nMy understanding of the scope is to preserve the existing `HintBlock` \u2192 user-message behavior in the multi-agent formatter path, with regression coverage for hint-only and mixed text+hint messages, while leaving unsupported-media placeholder behavior to the ongoing formatter PRs #3106, #3109, #3111, #3113, and #2958. Since those PRs touch related formatter files, should I coordinate patch ordering with their authors? Would you prefer that the fix cover all 11 multi-agent formatter providers, or a narrower provider scope?\n\nIf the issue is available and this scope is appropriate, could you assign it to me before I begin?\nIt's yours, @zhengguangzhuo. If there is no pull request and no word from you by 2026-10-27 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-15T01:38:27Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3317, "instance_id": "agentscope-ai__agentscope-3317", "issue_numbers": ["3319"], "base_commit": "9b94a63407ec59881fde19300b61e469a0a7d8b2", "patch": "diff --git a/src/agentscope/console/_console.py b/src/agentscope/console/_console.py\nindex daa9219c4e..9e120684ab 100644\n--- a/src/agentscope/console/_console.py\n+++ b/src/agentscope/console/_console.py\n@@ -36,10 +36,16 @@ async def _run_reply(\n \n     async def consume() -> None:\n         nonlocal pending\n-        async for event in agent.reply_stream(inputs):\n-            renderer.render(event)\n-            if isinstance(event, RequireUserConfirmEvent):\n-                pending = event\n+        try:\n+            async for event in agent.reply_stream(inputs):\n+                renderer.render(event)\n+                if isinstance(event, RequireUserConfirmEvent):\n+                    pending = event\n+        except BaseException:\n+            # Failed streams may omit REPLY_END for several participants.\n+            pending = None\n+            renderer.reset()\n+            raise\n \n     task = asyncio.ensure_future(consume())\n     loop = asyncio.get_running_loop()\ndiff --git a/src/agentscope/console/_renderer.py b/src/agentscope/console/_renderer.py\nindex ddf68d0234..5530f1aa1a 100644\n--- a/src/agentscope/console/_renderer.py\n+++ b/src/agentscope/console/_renderer.py\n@@ -77,14 +77,18 @@ def _format_tool_input(raw: str) -> str:\n \n class ConsoleRenderer:\n     \"\"\"Render :class:`~agentscope.event.AgentEvent` streams as line-based\n-    terminal output, so that consuming :meth:`Agent.reply_stream` in the\n-    terminal becomes a one-liner:\n+    terminal output. Consume :meth:`Agent.reply_stream` and reset the\n+    renderer if the stream fails:\n \n     .. code-block:: python\n \n         renderer = ConsoleRenderer()\n-        async for event in agent.reply_stream(msg):\n-            renderer.render(event)\n+        try:\n+            async for event in agent.reply_stream(msg):\n+                renderer.render(event)\n+        except BaseException:\n+            renderer.reset()\n+            raise\n \n     The renderer prints text/thinking deltas as they arrive, buffers the\n     concurrently-streamed tool calls/results via\n@@ -120,6 +124,7 @@ def __init__(\n         self.console = console or Console(highlight=False)\n \n         self._msg: Msg | None = None\n+        self._active_msgs: dict[str, Msg] = {}\n         self._mid_stream = False\n \n     @property\n@@ -127,6 +132,17 @@ def last_msg(self) -> Msg | None:\n         \"\"\"The reply message accumulated from the rendered events.\"\"\"\n         return self._msg\n \n+    def reset(self) -> None:\n+        \"\"\"Release all accumulated messages and end any streamed line.\n+\n+        Call this when abandoning a stream or when it raises without a\n+        ``ReplyEndEvent``. ``last_msg`` becomes ``None``. Do not reset on a\n+        normal HITL pause: its pending replies are needed when resuming.\n+        \"\"\"\n+        self._active_msgs.clear()\n+        self._msg = None\n+        self._break_line(quiet_ok=True)\n+\n     def render(self, event: AgentEvent) -> None:\n         \"\"\"Render the given agent event to the console.\n \n@@ -194,12 +210,22 @@ def _accumulate(self, event: AgentEvent) -> None:\n         reply_id = getattr(event, \"reply_id\", None)\n         if reply_id is None:\n             return\n+        msg = self._active_msgs.get(reply_id)\n+        if msg is None:\n+            if self._msg is not None and self._msg.id == reply_id:\n+                msg = self._msg\n+            else:\n+                msg = AssistantMsg(name=\"agent\", content=[], id=reply_id)\n         if isinstance(event, ReplyStartEvent):\n-            self._msg = AssistantMsg(name=event.name, content=[], id=reply_id)\n-        elif self._msg is None or self._msg.id != reply_id:\n-            # A continuation (e.g. after HITL) without a ReplyStartEvent\n-            self._msg = AssistantMsg(name=\"agent\", content=[], id=reply_id)\n-        self._msg.append_event(event)\n+            msg.name = event.name\n+        self._msg = msg\n+        msg.append_event(event)\n+        # Keep paused replies across member events, without retaining every\n+        # completed reply for the lifetime of the interactive console.\n+        if msg.finished_at is None:\n+            self._active_msgs[reply_id] = msg\n+        else:\n+            self._active_msgs.pop(reply_id, None)\n \n     def _show(self, level: int) -> bool:\n         \"\"\"Whether the current verbosity covers the given level.\"\"\"\n", "test_patch": "diff --git a/tests/console_renderer_test.py b/tests/console_renderer_test.py\nindex 69bf841170..1140485061 100644\n--- a/tests/console_renderer_test.py\n+++ b/tests/console_renderer_test.py\n@@ -2,6 +2,8 @@\n \"\"\"Console renderer test cases.\"\"\"\n from io import StringIO\n from unittest import TestCase\n+from unittest.mock import patch\n+from weakref import ref\n \n from rich.console import Console\n \n@@ -82,6 +84,146 @@ def test_text_streaming(self) -> None:\n         self.assertIn(\"Friday\", self.output())\n         self.assertIn(\"hello world\", self.output())\n \n+    def test_interleaved_replies_preserve_tool_results(self) -> None:\n+        \"\"\"A member reply must not discard its leader's pending result.\"\"\"\n+        events = [\n+            ReplyStartEvent(session_id=\"s\", reply_id=\"leader\", name=\"Leader\"),\n+            ToolResultStartEvent(\n+                reply_id=\"leader\",\n+                tool_call_id=\"c1\",\n+                tool_call_name=\"TeamAssign\",\n+            ),\n+            ReplyStartEvent(session_id=\"s\", reply_id=\"member\", name=\"Member\"),\n+            ToolResultStartEvent(\n+                reply_id=\"member\",\n+                tool_call_id=\"c1\",\n+                tool_call_name=\"lookup\",\n+            ),\n+            ToolResultTextDeltaEvent(\n+                reply_id=\"member\",\n+                tool_call_id=\"c1\",\n+                delta=\"member result\",\n+            ),\n+            ToolResultTextDeltaEvent(\n+                reply_id=\"leader\",\n+                tool_call_id=\"c1\",\n+                delta=\"assigned result\",\n+            ),\n+            ToolResultEndEvent(\n+                reply_id=\"member\",\n+                tool_call_id=\"c1\",\n+                state=ToolResultState.SUCCESS,\n+            ),\n+            ReplyEndEvent(session_id=\"s\", reply_id=\"member\"),\n+            ToolResultEndEvent(\n+                reply_id=\"leader\",\n+                tool_call_id=\"c1\",\n+                state=ToolResultState.SUCCESS,\n+            ),\n+            ReplyEndEvent(session_id=\"s\", reply_id=\"leader\"),\n+        ]\n+        with patch(\"agentscope.message._base.logger.warning\") as warning:\n+            self.render_all(events)\n+        warning.assert_not_called()\n+        self.assertIn(\"\u2713 lookup\", self.output())\n+        self.assertIn(\"member result\", self.output())\n+        self.assertIn(\"\u2713 TeamAssign\", self.output())\n+        self.assertIn(\"assigned result\", self.output())\n+        self.assertEqual(self.renderer.last_msg.id, \"leader\")\n+        self.assertEqual(self.renderer.last_msg.name, \"Leader\")\n+\n+    def test_repeated_reply_start_preserves_existing_content(self) -> None:\n+        \"\"\"A resumed reply keeps text collected before an agent switch.\"\"\"\n+        self.render_all(\n+            [\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=REPLY_ID,\n+                    name=\"Friday\",\n+                ),\n+                *self.text_events(\"first part\"),\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=\"other\",\n+                    name=\"Other\",\n+                ),\n+                ReplyEndEvent(session_id=\"s\", reply_id=\"other\"),\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=REPLY_ID,\n+                    name=\"Friday\",\n+                ),\n+                *self.text_events(\"second part\", block_id=\"t2\"),\n+            ],\n+        )\n+        self.assertEqual(\n+            self.renderer.last_msg.get_text_content(),\n+            \"first part\\nsecond part\",\n+        )\n+\n+    def test_completed_replies_are_not_retained(self) -> None:\n+        \"\"\"Retain the latest reply, but release earlier completed messages.\"\"\"\n+        self.render_all(\n+            [\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=REPLY_ID,\n+                    name=\"Friday\",\n+                ),\n+                ReplyEndEvent(session_id=\"s\", reply_id=REPLY_ID),\n+            ],\n+        )\n+        previous = ref(self.renderer.last_msg)\n+        self.assertIsNotNone(previous())\n+        self.render_all(\n+            [\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=\"next\",\n+                    name=\"Friday\",\n+                ),\n+                ReplyEndEvent(session_id=\"s\", reply_id=\"next\"),\n+            ],\n+        )\n+        self.assertIsNone(previous())\n+\n+    def test_reset_releases_unfinished_replies(self) -> None:\n+        \"\"\"Discard abandoned replies and allow the renderer to be reused.\"\"\"\n+        self.renderer.verbosity = \"quiet\"\n+        messages = []\n+        for reply_id in (REPLY_ID, \"member\"):\n+            self.renderer.render(\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=reply_id,\n+                    name=\"Friday\",\n+                ),\n+            )\n+            messages.append(ref(self.renderer.last_msg))\n+\n+        self.render_all(self.text_events(\"partial\")[:-1])\n+        self.renderer.reset()\n+        self.renderer.reset()\n+\n+        self.assertIsNone(self.renderer.last_msg)\n+        self.assertEqual([message() for message in messages], [None, None])\n+        self.assertEqual(self.output(), \"partial\\n\")\n+        self.render_all(\n+            [\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=REPLY_ID,\n+                    name=\"Friday\",\n+                ),\n+                *self.text_events(\"recovered\"),\n+            ],\n+        )\n+        self.assertEqual(\n+            self.renderer.last_msg.get_text_content(),\n+            \"recovered\",\n+        )\n+        self.assertEqual(self.output(), \"partial\\nrecovered\\n\")\n+\n     def test_quiet_hides_everything_but_text(self) -> None:\n         \"\"\"Quiet verbosity only prints the streamed reply text.\"\"\"\n         self.renderer.verbosity = \"quiet\"\ndiff --git a/tests/console_test.py b/tests/console_test.py\nindex d8dc4fad67..90401933c3 100644\n--- a/tests/console_test.py\n+++ b/tests/console_test.py\n@@ -1,16 +1,32 @@\n # -*- coding: utf-8 -*-\n+# pylint: disable=protected-access\n \"\"\"Tests for the interactive console cancellation boundary.\"\"\"\n \n import asyncio\n from collections.abc import AsyncGenerator\n+from io import StringIO\n from typing import cast\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import patch\n \n+from rich.console import Console\n+\n from agentscope.agent import Agent\n from agentscope.console import ConsoleRenderer\n from agentscope.console._console import _run_reply\n-from agentscope.message import UserMsg\n+from agentscope.event import (\n+    AgentEvent,\n+    ReplyEndEvent,\n+    ReplyStartEvent,\n+    RequireUserConfirmEvent,\n+    TextBlockDeltaEvent,\n+    TextBlockStartEvent,\n+    ToolResultEndEvent,\n+    ToolResultStartEvent,\n+    ToolResultTextDeltaEvent,\n+    UserConfirmResultEvent,\n+)\n+from agentscope.message import ToolResultState, UserMsg\n \n \n class _BlockingAgent:\n@@ -22,23 +38,41 @@ def __init__(self) -> None:\n     async def reply_stream(\n         self,\n         _inputs: object,\n-    ) -> AsyncGenerator[None, None]:\n+    ) -> AsyncGenerator[AgentEvent, None]:\n         \"\"\"Wait indefinitely so the test can choose who cancels it.\"\"\"\n+        yield ReplyStartEvent(\n+            session_id=\"s\",\n+            reply_id=\"blocked\",\n+            name=\"Agent\",\n+        )\n+        yield RequireUserConfirmEvent(reply_id=\"blocked\", tool_calls=[])\n         self.started.set()\n-        while True:\n-            await asyncio.Event().wait()\n-            yield None\n+        await asyncio.Event().wait()\n+\n \n+class _EventAgent:\n+    \"\"\"Emit a scripted stream, optionally failing before the reply ends.\"\"\"\n \n-class _Renderer:\n-    \"\"\"Renderer stub for a reply stream that never yields an event.\"\"\"\n+    def __init__(self, events: list[AgentEvent | Exception]) -> None:\n+        self.events = events\n \n-    def render(self, _event: object) -> None:\n-        \"\"\"Accept an event without producing terminal output.\"\"\"\n+    async def reply_stream(\n+        self,\n+        _inputs: object,\n+    ) -> AsyncGenerator[AgentEvent, None]:\n+        \"\"\"Emit events until the script ends or raises an exception.\"\"\"\n+        for event in self.events:\n+            if isinstance(event, Exception):\n+                raise event\n+            yield event\n \n \n class ConsoleCancellationTest(IsolatedAsyncioTestCase):\n-    \"\"\"Distinguish caller cancellation from the SIGINT reply interrupt.\"\"\"\n+    \"\"\"Check cleanup on failure without changing cancellation or HITL.\"\"\"\n+\n+    def setUp(self) -> None:\n+        \"\"\"Create a real renderer with captured terminal output.\"\"\"\n+        self.renderer = ConsoleRenderer(console=Console(file=StringIO()))\n \n     async def test_run_reply_propagates_caller_cancellation(self) -> None:\n         \"\"\"Cancelling the console task must remain visible to its caller.\"\"\"\n@@ -46,7 +80,7 @@ async def test_run_reply_propagates_caller_cancellation(self) -> None:\n         task = asyncio.create_task(\n             _run_reply(\n                 cast(Agent, agent),\n-                cast(ConsoleRenderer, _Renderer()),\n+                self.renderer,\n                 UserMsg(name=\"user\", content=\"hello\"),\n             ),\n         )\n@@ -56,6 +90,8 @@ async def test_run_reply_propagates_caller_cancellation(self) -> None:\n \n         with self.assertRaises(asyncio.CancelledError):\n             await task\n+        self.assertIsNone(self.renderer.last_msg)\n+        self.assertEqual(self.renderer._active_msgs, {})\n \n     async def test_run_reply_swallows_sigint_consumer_cancellation(\n         self,\n@@ -78,7 +114,7 @@ async def test_run_reply_swallows_sigint_consumer_cancellation(\n             task = asyncio.create_task(\n                 _run_reply(\n                     cast(Agent, agent),\n-                    cast(ConsoleRenderer, _Renderer()),\n+                    self.renderer,\n                     UserMsg(name=\"user\", content=\"hello\"),\n                 ),\n             )\n@@ -86,3 +122,125 @@ async def test_run_reply_swallows_sigint_consumer_cancellation(\n             signal_callbacks[0]()\n \n             self.assertIsNone(await task)\n+        self.assertIsNone(self.renderer.last_msg)\n+        self.assertEqual(self.renderer._active_msgs, {})\n+\n+    async def test_failed_replies_are_released_before_reuse(self) -> None:\n+        \"\"\"Failed streams release every participant and preserve the error.\"\"\"\n+        failure = RuntimeError(\"model stream failed\")\n+        for index in range(3):\n+            agent = _EventAgent(\n+                [\n+                    ReplyStartEvent(\n+                        session_id=\"s\",\n+                        reply_id=f\"leader-{index}\",\n+                        name=\"Leader\",\n+                    ),\n+                    ReplyStartEvent(\n+                        session_id=\"s\",\n+                        reply_id=f\"member-{index}\",\n+                        name=\"Member\",\n+                    ),\n+                    TextBlockStartEvent(\n+                        reply_id=f\"member-{index}\",\n+                        block_id=\"t1\",\n+                    ),\n+                    TextBlockDeltaEvent(\n+                        reply_id=f\"member-{index}\",\n+                        block_id=\"t1\",\n+                        delta=\"partial response\",\n+                    ),\n+                    failure,\n+                ],\n+            )\n+            with self.assertRaises(RuntimeError) as caught:\n+                await _run_reply(\n+                    cast(Agent, agent),\n+                    self.renderer,\n+                    UserMsg(name=\"user\", content=\"hello\"),\n+                )\n+            self.assertIs(caught.exception, failure)\n+            self.assertIsNone(self.renderer.last_msg)\n+            self.assertEqual(self.renderer._active_msgs, {})\n+\n+        agent.events = [\n+            ReplyStartEvent(session_id=\"s\", reply_id=\"next\", name=\"Leader\"),\n+            ReplyEndEvent(session_id=\"s\", reply_id=\"next\"),\n+        ]\n+        await _run_reply(\n+            cast(Agent, agent),\n+            self.renderer,\n+            UserMsg(name=\"user\", content=\"retry\"),\n+        )\n+        self.assertEqual(self.renderer._active_msgs, {})\n+        self.assertEqual(self.renderer.last_msg.id, \"next\")\n+\n+    async def test_hitl_keeps_pending_replies_across_streams(self) -> None:\n+        \"\"\"A normal HITL pause retains both leader and member content.\"\"\"\n+        pending = RequireUserConfirmEvent(reply_id=\"member\", tool_calls=[])\n+        agent = _EventAgent(\n+            [\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=\"leader\",\n+                    name=\"Leader\",\n+                ),\n+                ToolResultStartEvent(\n+                    reply_id=\"leader\",\n+                    tool_call_id=\"c1\",\n+                    tool_call_name=\"TeamAssign\",\n+                ),\n+                ReplyStartEvent(\n+                    session_id=\"s\",\n+                    reply_id=\"member\",\n+                    name=\"Member\",\n+                ),\n+                TextBlockStartEvent(reply_id=\"member\", block_id=\"t1\"),\n+                TextBlockDeltaEvent(\n+                    reply_id=\"member\",\n+                    block_id=\"t1\",\n+                    delta=\"before\",\n+                ),\n+                pending,\n+            ],\n+        )\n+        result = await _run_reply(\n+            cast(Agent, agent),\n+            self.renderer,\n+            UserMsg(name=\"user\", content=\"hello\"),\n+        )\n+        self.assertIs(result, pending)\n+        member_msg = self.renderer.last_msg\n+        agent.events = [\n+            TextBlockDeltaEvent(\n+                reply_id=\"member\",\n+                block_id=\"t1\",\n+                delta=\" after\",\n+            ),\n+            ReplyEndEvent(session_id=\"s\", reply_id=\"member\"),\n+            ToolResultTextDeltaEvent(\n+                reply_id=\"leader\",\n+                tool_call_id=\"c1\",\n+                delta=\"done\",\n+            ),\n+            ToolResultEndEvent(\n+                reply_id=\"leader\",\n+                tool_call_id=\"c1\",\n+                state=ToolResultState.SUCCESS,\n+            ),\n+            ReplyEndEvent(session_id=\"s\", reply_id=\"leader\"),\n+        ]\n+        with patch(\"agentscope.message._base.logger.warning\") as warning:\n+            result = await _run_reply(\n+                cast(Agent, agent),\n+                self.renderer,\n+                UserConfirmResultEvent(\n+                    reply_id=\"member\",\n+                    confirm_results=[],\n+                ),\n+            )\n+        warning.assert_not_called()\n+        self.assertIsNone(result)\n+        self.assertEqual(member_msg.get_text_content(), \"before after\")\n+        self.assertEqual(self.renderer.last_msg.id, \"leader\")\n+        self.assertEqual(self.renderer._active_msgs, {})\n", "problem_statement": "[Bug]: ConsoleRenderer loses pending tool results when team replies interleave\n## Prerequisites\n\n- [x] I have searched existing issues and pull requests and did not find a matching report or fix other than the draft PR #3317 linked to this report.\n- [x] This reports a reproducible console-rendering defect, not a usage question. Agent execution and its tool-result context remain intact.\n\n## Background / Description\n\nWhen `launch_console` renders a `TeamPipeline` event stream, a member reply replaces the leader's accumulated console message. When the member finishes and the leader receives its `TeamAssign` result, the pending result block is no longer available in the renderer. This produces warnings and omits the assignment result from the terminal.\n\nExpected: preserve unfinished replies across agent switches and show the completed assignment result. The actual leader business context still contains a complete successful result; this report concerns console rendering, not tool execution or agent communication.\n\n## Error Messages\n\n```text\nWARNING - ToolResultBlock 'assignment' not found, skipping.\nWARNING - ToolResultBlock 'assignment' not found, skipping.\n```\n\n## Steps to Reproduce\n\nThe following reproduces the renderer failure without credentials or model calls. It is the same event ordering observed during a real `TeamPipeline` delegation: the leader opens a result, the member emits its reply, and then leader result deltas/end arrive.\n\nSave as `repro.py` and run `python repro.py` with AgentScope 2.0.10:\n\n```python\nfrom agentscope.console import ConsoleRenderer\nfrom agentscope.event import (\n    ReplyStartEvent, ReplyEndEvent, ToolResultStartEvent,\n    ToolResultTextDeltaEvent, ToolResultEndEvent,\n)\nfrom agentscope.message import ToolResultState\n\nrenderer = ConsoleRenderer()\nevents = [\n    ReplyStartEvent(session_id=\"demo\", reply_id=\"leader\", name=\"Leader\"),\n    ToolResultStartEvent(reply_id=\"leader\", tool_call_id=\"assignment\", tool_call_name=\"TeamAssign\"),\n    ReplyStartEvent(session_id=\"demo\", reply_id=\"member\", name=\"Member\"),\n    ReplyEndEvent(session_id=\"demo\", reply_id=\"member\"),\n    ToolResultTextDeltaEvent(reply_id=\"leader\", tool_call_id=\"assignment\", delta=\"Member completed\"),\n    ToolResultEndEvent(reply_id=\"leader\", tool_call_id=\"assignment\", state=ToolResultState.SUCCESS),\n]\nfor event in events:\n    renderer.render(event)\n```\n\n`TeamAssign` success/result text should be displayed. Instead, its delta and end events each produce the warning above.\n\n## Environment\n\n- AgentScope: 2.0.10; also reproduced on upstream main at `9b94a63`.\n- Python: 3.13.11.\n- OS: Linux (WSL).\n\n## Investigation / Proposed Fix\n\n`ConsoleRenderer._accumulate` stores only a single `_msg`. Switching to the member discards the unfinished leader message. Switching back creates an empty leader message, but no second `ToolResultStartEvent` is emitted, so the existing result cannot be found.\n\nRetain unfinished messages by `reply_id`, restore the matching message on agent switches, and release completed messages. Preserve the existing `last_msg` interface and avoid retaining the full conversation in the renderer.\n\nA focused fix and regression tests are already prepared in draft PR #3317. Two regressions fail on the unmodified source; after the fix, 14 upstream console/renderer tests and 41 downstream reception tests pass. No real API or database calls were used.\n\n", "hints_text": "", "created_at": "2026-10-14T15:34:56Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3316, "instance_id": "agentscope-ai__agentscope-3316", "issue_numbers": ["3315"], "base_commit": "9b94a63407ec59881fde19300b61e469a0a7d8b2", "patch": "diff --git a/src/agentscope/rag/_vdb/_mongodb.py b/src/agentscope/rag/_vdb/_mongodb.py\nindex 8ae4140260..f6029b8d6d 100644\n--- a/src/agentscope/rag/_vdb/_mongodb.py\n+++ b/src/agentscope/rag/_vdb/_mongodb.py\n@@ -321,13 +321,16 @@ async def search(\n     ) -> list[VectorSearchResult]:\n         \"\"\"Find the most similar records to a query vector.\n \n+        The search considers at least 100 candidates and targets 20 times\n+        ``top_k``, capped at MongoDB's 10,000-candidate limit.\n+\n         Args:\n             collection (`str`):\n                 The collection to search.\n             query_vector (`list[float]`):\n                 The query embedding vector.\n             top_k (`int`, defaults to ``5``):\n-                Maximum number of results to return.\n+                Maximum number of results to return. Cannot exceed 10,000.\n             metadata_filter (`dict[str, Any] | None`, optional):\n                 If provided, restrict the search to records whose\n                 ``chunk.metadata`` matches every ``key == value`` pair\n@@ -338,7 +341,13 @@ async def search(\n         Returns:\n             `list[VectorSearchResult]`:\n                 Results ordered by descending similarity score.\n+\n+        Raises:\n+            `ValueError`:\n+                If ``top_k`` exceeds MongoDB's 10,000-candidate ANN limit.\n         \"\"\"\n+        if top_k > 10_000:\n+            raise ValueError(\"top_k cannot exceed MongoDB's 10000 ANN limit\")\n         await self._ensure_index_ready(collection)\n         col = self._col(collection)\n \n@@ -346,7 +355,7 @@ async def search(\n             \"index\": self._index_name,\n             \"path\": \"vector\",\n             \"queryVector\": query_vector,\n-            \"numCandidates\": max(100, top_k * 20),\n+            \"numCandidates\": min(10_000, max(100, top_k * 20)),\n             \"limit\": top_k,\n         }\n         filter_expr = self._build_metadata_filter(metadata_filter)\n", "test_patch": "diff --git a/tests/rag_vdb_mongodb_test.py b/tests/rag_vdb_mongodb_test.py\nindex 0ac038d8c3..f8b2d7a8dd 100644\n--- a/tests/rag_vdb_mongodb_test.py\n+++ b/tests/rag_vdb_mongodb_test.py\n@@ -478,6 +478,104 @@ async def test_search_top_k(self) -> None:\n             ],\n         )\n \n+    async def test_search_candidate_limits(self) -> None:\n+        \"\"\"Search caps candidates while preserving the requested limit.\"\"\"\n+        await self.store.create_collection(\"kb-1\", dimensions=3)\n+        record = _make_record(\"A\", [1.0, 0.0, 0.0], document_id=\"doc-1\")\n+        record.chunk.metadata[\"kb_scope\"] = \"kb-a\"\n+        await self.store.insert(\"kb-1\", [record])\n+        col = self._fake_client[\"test-db\"][\"kb-1\"]\n+\n+        for top_k, num_candidates, metadata_filter in [\n+            (None, 100, None),\n+            (500, 10_000, None),\n+            (501, 10_000, {\"kb_scope\": \"kb-a\"}),\n+            (10_000, 10_000, None),\n+        ]:\n+            with self.subTest(top_k=top_k):\n+                search_kwargs: dict[str, Any] = {}\n+                if top_k is not None:\n+                    search_kwargs[\"top_k\"] = top_k\n+                if metadata_filter is not None:\n+                    search_kwargs[\"metadata_filter\"] = metadata_filter\n+\n+                with patch.object(\n+                    col,\n+                    \"aggregate\",\n+                    wraps=col.aggregate,\n+                ) as aggregate:\n+                    results = await self.store.search(\n+                        \"kb-1\",\n+                        query_vector=[1.0, 0.0, 0.0],\n+                        **search_kwargs,\n+                    )\n+\n+                vector_search: dict[str, Any] = {\n+                    \"index\": \"vector_index\",\n+                    \"path\": \"vector\",\n+                    \"queryVector\": [1.0, 0.0, 0.0],\n+                    \"numCandidates\": num_candidates,\n+                    \"limit\": 5 if top_k is None else top_k,\n+                }\n+                if metadata_filter is not None:\n+                    vector_search[\"filter\"] = {\n+                        \"$and\": [{\"chunk.metadata.kb_scope\": {\"$eq\": \"kb-a\"}}],\n+                    }\n+                aggregate.assert_awaited_once_with(\n+                    [\n+                        {\"$vectorSearch\": vector_search},\n+                        {\n+                            \"$project\": {\n+                                \"document_id\": 1,\n+                                \"chunk\": 1,\n+                                \"score\": {\"$meta\": \"vectorSearchScore\"},\n+                            },\n+                        },\n+                    ],\n+                )\n+                self.assertEqual(\n+                    _dump_results(results),\n+                    [\n+                        {\n+                            \"score\": 1.0,\n+                            \"document_id\": \"doc-1\",\n+                            \"chunk\": {\n+                                \"content\": {\n+                                    \"type\": \"text\",\n+                                    \"text\": \"A\",\n+                                    \"id\": AnyString(),\n+                                    \"created_at\": AnyString(),\n+                                    \"finished_at\": None,\n+                                },\n+                                \"source\": \"doc-1.txt\",\n+                                \"chunk_index\": 0,\n+                                \"total_chunks\": 1,\n+                                \"metadata\": {\"kb_scope\": \"kb-a\"},\n+                            },\n+                        },\n+                    ],\n+                )\n+\n+    async def test_search_top_k_exceeds_limit(self) -> None:\n+        \"\"\"An oversized search is rejected before accessing MongoDB.\"\"\"\n+        store = MongoDBStore(uri=\"mongodb://mock\", database=\"test-db\")\n+        with (\n+            patch.object(store, \"_ensure_index_ready\") as ensure_index_ready,\n+            patch.object(\n+                store,\n+                \"get_client\",\n+                return_value=self._fake_client,\n+            ) as get_client,\n+        ):\n+            with self.assertRaisesRegex(ValueError, \"top_k.*10000\"):\n+                await store.search(\n+                    \"kb-1\",\n+                    query_vector=[1.0, 0.0, 0.0],\n+                    top_k=10_001,\n+                )\n+            ensure_index_ready.assert_not_awaited()\n+            get_client.assert_not_called()\n+\n     async def test_delete_by_document_id(self) -> None:\n         \"\"\"delete removes all records of one document only.\"\"\"\n         await self.store.create_collection(\"kb-1\", dimensions=3)\n", "problem_statement": "[Bug]: MongoDBStore generates out-of-range numCandidates for top_k=501\n### Prerequisites\n\n- [x] I searched existing issues, discussions, and pull requests and did not find a matching report or fix.\n- [x] This reports a request-construction defect, not a question about ANN tuning.\n\n### Background / Description\n\n`MongoDBStore.search()` constructs `$vectorSearch.numCandidates` as `max(100, top_k * 20)` without an upper bound. At `top_k=501`, the generated request contains `limit=501` and `numCandidates=10020`.\n\nThe [MongoDB Vector Search documentation](https://www.mongodb.com/docs/vector-search/query/aggregation-stages/vector-search-stage/?deployment-type=atlas&embedding=byo&interface=driver&language=python) requires `limit <= numCandidates <= 10000`. The 20\u00d7 candidate multiplier is a recommendation for recall, not a restriction that `limit` must be at most 500. A request for 501 results could use a candidate count within the supported range, but the current calculation cannot produce one.\n\nThe same issue affects positive `top_k` values from 501 through 10000. Source: [`MongoDBStore.search` at the tested commit](https://github.com/agentscope-ai/agentscope/blob/9b94a63407ec59881fde19300b61e469a0a7d8b2/src/agentscope/rag/_vdb/_mongodb.py#L349).\n\n### Observed Output / Verification Limits\n\nCaptured from the real `search()` implementation using the repository's Fake MongoDB client:\n\n```text\ntop_k=5, limit=5, numCandidates=100\ntop_k=500, limit=500, numCandidates=10000\ntop_k=501, limit=501, numCandidates=10020\ntop_k=10000, limit=10000, numCandidates=200000\n```\n\nThis is an offline capture of the generated request, not a reproduction of a live server exception. I did not connect to MongoDB, test server versions, or measure recall. The repository Fake does not enforce the server's candidate-count limit, so it returns normally even when the captured request violates that documented bound.\n\n### Steps to Reproduce\n\nUse a development checkout at the tested commit and save the following as `repro.py`. It reuses the existing test Fake and leaves request construction and index-readiness checks unmodified; only the client is replaced and its aggregate call recorded.\n\n```python\nimport asyncio\nfrom unittest.mock import AsyncMock, patch\n\nfrom agentscope.rag import MongoDBStore\nfrom rag_vdb_mongodb_test import _FakeMongoClient\n\n\nasync def main():\n    client = _FakeMongoClient(\"offline\")\n    collection = client[\"offline\"][\"kb\"]\n    await collection.create_search_index(None)\n    capture = AsyncMock(wraps=collection.aggregate)\n    collection.aggregate = capture\n    store = MongoDBStore(uri=\"mongodb://unused\", database=\"offline\")\n\n    try:\n        with patch.object(MongoDBStore, \"get_client\", return_value=client):\n            for top_k in (5, 500, 501, 10000):\n                await store.search(\"kb\", [0.0, 1.0, 0.0], top_k=top_k)\n                stage = capture.call_args.args[0][0][\"$vectorSearch\"]\n                print(\n                    f\"top_k={top_k}, limit={stage['limit']}, \"\n                    f\"numCandidates={stage['numCandidates']}\"\n                )\n    finally:\n        await client.close()\n\n\nasyncio.run(main())\n```\n\nFrom the checkout root in PowerShell, with the development Python environment active:\n\n```powershell\n$env:PYTHONPATH = \"$PWD\\src;$PWD\\tests\"\npython -B repro.py\n```\n\nNo MongoDB driver, database, API key, or model call is used by this reproduction. Existing development dependencies needed to import the repository's test helpers must be installed. I ran the same code locally; exit 0 means the request was captured successfully, not that a server accepted it.\n\n### Expected Behavior / Proposed Scope\n\nGenerate ANN requests that satisfy `limit <= numCandidates <= 10000` for supported result counts. Please confirm the preferred handling for larger `top_k` values that cannot satisfy this bound.\n\nA minimal approach could cap the candidate count for supported inputs and explicitly validate unsupported result counts. Tests could cover 500/501 and 10000 while preserving the existing defaults and metadata filter. Capping the multiplier changes its recall/latency trade-off for larger queries; I am not proposing automatic batching or switching search modes.\n\nIs anyone already working on this, and does that scope match the intended backend behavior? No implementation patch has been prepared.\n\n### Environment\n\n- AgentScope: `2.0.11dev`, commit `9b94a63407ec59881fde19300b61e469a0a7d8b2`\n- Python: 3.11.9; Pydantic: 2.13.5\n- OS: Windows\n- The source and test-helper import paths were verified against that checkout.\n- A broader four-case capture also preserved the default-case metadata filter. The full MongoDB test module and a real server were not run.\n\n### AI Assistance\n\nCodex assisted with source inspection, duplicate searches, offline request capture, review, and drafting. The observations and limitations above are from the recorded local execution and the documented API constraints.\n\n", "hints_text": "/assign\n\nIt's yours, @shuxiachai. If there is no pull request and no word from you by 2026-10-28 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-14T11:32:55Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3309, "instance_id": "agentscope-ai__agentscope-3309", "issue_numbers": ["3307"], "base_commit": "6c60853f4237dbc237803cdee2fb96a27a6a0611", "patch": "diff --git a/src/agentscope/tool/_builtin/_bash.py b/src/agentscope/tool/_builtin/_bash.py\nindex ee493b0a2c..dcf75004e6 100644\n--- a/src/agentscope/tool/_builtin/_bash.py\n+++ b/src/agentscope/tool/_builtin/_bash.py\n@@ -122,7 +122,7 @@ class Bash(ToolBase):\n                 ),\n                 \"default\": 120000,\n                 \"maximum\": 600000,\n-                \"minimum\": 0,\n+                \"minimum\": 1,\n             },\n         },\n         \"required\": [\"command\"],\n@@ -695,6 +695,21 @@ async def call(  # type: ignore[override] # pylint: disable=unused-argument\n             ToolChunk: The tool execution result with stdout/stderr content.\n         \"\"\"\n \n+        if timeout < 1:\n+            yield ToolChunk(\n+                content=[\n+                    TextBlock(\n+                        text=(\n+                            f\"Error: timeout must be at least 1ms, \"\n+                            f\"got: {timeout}.\"\n+                        ),\n+                    ),\n+                ],\n+                state=ToolResultState.ERROR,\n+                is_last=True,\n+            )\n+            return\n+\n         # Clamp timeout to max 600000ms and convert to seconds\n         timeout_ms = min(timeout, 600000)\n         timeout_sec = timeout_ms / 1000.0\ndiff --git a/src/agentscope/tool/_builtin/_powershell.py b/src/agentscope/tool/_builtin/_powershell.py\nindex 1403dbcc75..e7db6b3b46 100644\n--- a/src/agentscope/tool/_builtin/_powershell.py\n+++ b/src/agentscope/tool/_builtin/_powershell.py\n@@ -80,7 +80,7 @@ class PowerShell(ToolBase):\n                 ),\n                 \"default\": 120000,\n                 \"maximum\": 600000,\n-                \"minimum\": 0,\n+                \"minimum\": 1,\n             },\n         },\n         \"required\": [\"command\"],\n@@ -185,6 +185,21 @@ async def call(  # type: ignore[override] # pylint: disable=unused-argument\n             `ToolChunk`:\n                 A final chunk containing the command output.\n         \"\"\"\n+        if timeout < 1:\n+            yield ToolChunk(\n+                content=[\n+                    TextBlock(\n+                        text=(\n+                            f\"Error: timeout must be at least 1ms, \"\n+                            f\"got: {timeout}.\"\n+                        ),\n+                    ),\n+                ],\n+                state=ToolResultState.ERROR,\n+                is_last=True,\n+            )\n+            return\n+\n         timeout_ms = min(timeout, 600000)\n         encoded_user_command = base64.b64encode(\n             command.encode(\"utf-16-le\"),\n", "test_patch": "diff --git a/tests/builtin_bash_test.py b/tests/builtin_bash_test.py\nindex af6e5e69c2..d101c3135c 100644\n--- a/tests/builtin_bash_test.py\n+++ b/tests/builtin_bash_test.py\n@@ -190,6 +190,52 @@ async def test_command_timeout(self) -> None:\n         self.assertEqual(chunks[0].state, \"error\")\n         self.assertIn(\"timed out\", chunks[0].content[0].text.lower())\n \n+    async def test_invalid_timeout_rejected(self) -> None:\n+        \"\"\"Reject nonpositive timeouts without calling the backend.\"\"\"\n+        for timeout in (0, -1):\n+            with self.subTest(timeout=timeout):\n+                backend = AsyncMock()\n+                tool = Bash(backend=backend)\n+                chunks = [\n+                    chunk.model_dump(\n+                        exclude={\n+                            \"id\": True,\n+                            \"content\": {\"__all__\": {\"id\", \"created_at\"}},\n+                        },\n+                    )\n+                    async for chunk in tool.call(\n+                        command='echo \"hello world\"',\n+                        timeout=timeout,\n+                    )\n+                ]\n+\n+                self.assertEqual(\n+                    chunks,\n+                    [\n+                        {\n+                            \"content\": [\n+                                {\n+                                    \"type\": \"text\",\n+                                    \"text\": (\n+                                        \"Error: timeout must be at least \"\n+                                        f\"1ms, got: {timeout}.\"\n+                                    ),\n+                                    \"finished_at\": None,\n+                                },\n+                            ],\n+                            \"state\": \"error\",\n+                            \"is_last\": True,\n+                            \"metadata\": {},\n+                        },\n+                    ],\n+                )\n+                backend.exec_shell.assert_not_awaited()\n+\n+    async def test_timeout_schema_minimum_is_one(self) -> None:\n+        \"\"\"JSON schema minimum for timeout is 1ms (#3307).\"\"\"\n+        timeout_schema = self.bash_tool.input_schema[\"properties\"][\"timeout\"]\n+        self.assertEqual(timeout_schema[\"minimum\"], 1)\n+\n \n @unittest.skipIf(\n     sys.platform == \"win32\",\ndiff --git a/tests/builtin_powershell_test.py b/tests/builtin_powershell_test.py\nindex fa84127cc5..6d7fea52a3 100644\n--- a/tests/builtin_powershell_test.py\n+++ b/tests/builtin_powershell_test.py\n@@ -25,6 +25,10 @@ async def test_public_interface_is_conservative(self) -> None:\n         self.assertFalse(tool.is_concurrency_safe)\n         self.assertIn(\"command\", tool.input_schema[\"properties\"])\n         self.assertEqual(tool.input_schema[\"required\"], [\"command\"])\n+        self.assertEqual(\n+            tool.input_schema[\"properties\"][\"timeout\"][\"minimum\"],\n+            1,\n+        )\n         self.assertEqual(tool._cwd, \"workspace\")\n         self.assertIs(tool._backend, backend)\n         self.assertIn(\"Glob\", tool.description)\n@@ -314,6 +318,53 @@ async def test_timeout_is_capped_at_ten_minutes(self) -> None:\n             600.0,\n         )\n \n+    async def test_invalid_timeout_rejected(self) -> None:\n+        \"\"\"Reject nonpositive timeouts without calling the backend.\"\"\"\n+        for timeout in (0, -5):\n+            with self.subTest(timeout=timeout):\n+                backend = AsyncMock()\n+                tool = PowerShell(backend=backend)\n+                chunks = [\n+                    chunk.model_dump(\n+                        exclude={\n+                            \"id\": True,\n+                            \"content\": {\"__all__\": {\"id\", \"created_at\"}},\n+                        },\n+                    )\n+                    async for chunk in tool.call(\n+                        command=\"Get-Location\",\n+                        timeout=timeout,\n+                    )\n+                ]\n+\n+                self.assertEqual(\n+                    chunks,\n+                    [\n+                        {\n+                            \"content\": [\n+                                {\n+                                    \"type\": \"text\",\n+                                    \"text\": (\n+                                        \"Error: timeout must be at least \"\n+                                        f\"1ms, got: {timeout}.\"\n+                                    ),\n+                                    \"finished_at\": None,\n+                                },\n+                            ],\n+                            \"state\": \"error\",\n+                            \"is_last\": True,\n+                            \"metadata\": {},\n+                        },\n+                    ],\n+                )\n+                backend.exec_shell.assert_not_awaited()\n+\n+    async def test_timeout_schema_minimum_is_one(self) -> None:\n+        \"\"\"JSON schema minimum for timeout is 1ms (#3307).\"\"\"\n+        tool = PowerShell(backend=AsyncMock())\n+        timeout_schema = tool.input_schema[\"properties\"][\"timeout\"]\n+        self.assertEqual(timeout_schema[\"minimum\"], 1)\n+\n \n @unittest.skipUnless(\n     sys.platform == \"win32\",\n", "problem_statement": "fix(tool): Bash accepts timeout=0/-1 and reports successful commands as errors\n## Prerequisites\n\n- [x] I have searched the existing issues and pull requests; this is not a duplicate.\n- [x] This is a reproducible tool-input validation bug, not a usage question.\n\n## Background / Description\n\n`Bash.call()` declares `timeout: int = 120000` (src/agentscope/tool/_builtin/_bash.py:685) and the JSON schema accepts `minimum: 0` (line 128). The runtime only clamps the *upper* end: `timeout_ms = min(timeout, 600000)` (line 696) before passing `timeout_sec` to `LocalBackend.exec_shell(... timeout=timeout_sec)`, which in turn feeds it straight into `asyncio.wait_for(process.communicate(), timeout=timeout)` (src/agentscope/tool/_builtin/_backend.py:826). `asyncio.wait_for` treats 0 and negative timeouts as 'already exceeded' and raises immediately, so any sub-millisecond LLM slip turns a successful `echo` into an opaque 'Command failed: ... Error: ' ToolChunk.\n\nTwo distinct sub-bugs share the same root cause:\n\n1. `timeout=0` is a valid JSON-schema value (minimum is 0) but never useful \u2014 there is no command whose zero-budget wait succeeds. It should be rejected as bad input, not silently turned into a fake timeout.\n2. `timeout<0` is rejected by no layer: the schema's `minimum: 0` already lets 0 through, and the runtime's `min(timeout, 600000)` clamp does nothing to a negative value. `asyncio.wait_for` then races on a negative number whose behavior is implementation-defined across Python versions (CPython 3.11 raises `TimeoutError`; some third-party event loops do not).\n\nThe same class of mistake exists in `Powershell` (a sibling tool) if its `timeout` parameter shares this pattern \u2014 the issue applies to the whole family regardless.\n\n## Error Messages\n\n```text\nstate=error text='Command failed: echo \"hello world\"\\nError: '\n```\n\nThe trailing `Error: ` is empty because the underlying exception is `asyncio.TimeoutError` (no message), so the user sees an unhelpful 'something failed' with no hint that `timeout` was the cause.\n\n## Steps to Reproduce\n\n```python\nimport asyncio\nfrom agentscope.tool import Bash\n\nasync def main():\n    bash = Bash()\n    chunks = []\n    async for chunk in bash.call(command='echo \"hello world\"', timeout=0):\n        chunks.append(chunk)\n    print(chunks[0].state, chunks[0].content[0].text)\n\nasyncio.run(main())\n```\n\nExpected (consistent with the `minimum: 1` family of fixes around `Read.tool.offset/limit` in #3291): `Bash` rejects `timeout=0` and `timeout<0` at the schema layer with a clear 'Error: timeout must be at least 1ms, got: 0.' message \u2014 the same `Grep` / `Glob` / `Read` family of pagination validations, applied to a tool that *also* takes a numeric input that can be 0.\n\nObserved on `main` (2.0.10dev) at the time of filing: the script above prints `error\\nCommand failed: echo \"hello world\"\\nError: ` even though `echo` is a successful no-op command that always exits 0 in well under a millisecond.\n\n## Environment\n\n- AgentScope Version: 2.0.10 (main at 34457377)\n- Python Version: 3.11.15\n- OS: Linux\n\n## Suggested Fix (sketch)\n\nTwo layers, smallest possible diff:\n\n1. Schema: change `minimum: 0` \u2192 `minimum: 1` on the `timeout` field in `_bash.py` (and the matching field in `Powershell` if it has one), so the JSON-schema validator rejects 0 and negative values up front.\n2. Runtime: in `Bash.call`, replace the bare `min(timeout, 600000)` with `max(1, min(timeout, 600000))` so a bad input that somehow slipped past the schema (e.g. a tool that calls `Bash.call` directly without going through pydantic) is also clamped, and the existing 'Command timed out after {ms}ms' branch never fires for a 0-budget wait.\n\nHappy to send a PR with both layers plus a regression test.\n", "hints_text": "/assign\nThis issue is still being verified. Please comment again once it is confirmed, and it is yours.\n\u770b\u5230 @RerankerGuo \u7684 /assign\uff1b\u76ee\u524d\u5c1a\u672a\u6b63\u5f0f\u6307\u6d3e\u3002\u6211\u60f3\u6309 issue \u5efa\u8bae\u505a\u4e24\u5c42\u4fee\u590d\uff08schema `minimum: 1` + \u8fd0\u884c\u65f6\u5bf9 `timeout < 1` \u8fd4\u56de\u6e05\u6670\u9519\u8bef\uff09\uff0c\u5e76\u8986\u76d6 Bash / Powershell\u3002\u82e5\u4f60\u5df2\u5728\u63a8\u8fdb\uff0c\u8bf7\u8bf4\u4e00\u58f0\uff0c\u6211\u7acb\u523b\u505c\u4e0b\u907f\u514d\u649e\u8f66\u3002\nIt's yours, @Li-john1021. If there is no pull request and no word from you by 2026-10-28 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-14T04:06:31Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3297, "instance_id": "agentscope-ai__agentscope-3297", "issue_numbers": ["3291"], "base_commit": "bdad647d2fee7d66597681ecd89e086b7800dd2a", "patch": "diff --git a/src/agentscope/tool/_builtin/_read.py b/src/agentscope/tool/_builtin/_read.py\nindex bc6463d534..8903de8655 100644\n--- a/src/agentscope/tool/_builtin/_read.py\n+++ b/src/agentscope/tool/_builtin/_read.py\n@@ -507,6 +507,30 @@ async def _read_text_file(\n     ) -> ToolChunk:\n         \"\"\"Read a text file and return with line numbers.\"\"\"\n         try:\n+            if offset < 1:\n+                return ToolChunk(\n+                    content=[\n+                        TextBlock(\n+                            text=f\"Error: offset must be at least 1, \"\n+                            f\"got: {offset}.\",\n+                        ),\n+                    ],\n+                    state=ToolResultState.ERROR,\n+                    is_last=True,\n+                )\n+\n+            if limit < 1 or limit > 2000:\n+                return ToolChunk(\n+                    content=[\n+                        TextBlock(\n+                            text=f\"Error: limit must be between 1 and 2000, \"\n+                            f\"got: {limit}.\",\n+                        ),\n+                    ],\n+                    state=ToolResultState.ERROR,\n+                    is_last=True,\n+                )\n+\n             # Read file content via backend\n             lines = None\n             if _agent_state is not None:\n", "test_patch": "diff --git a/tests/builtin_read_test.py b/tests/builtin_read_test.py\nindex bb898e6556..b75e0da75c 100644\n--- a/tests/builtin_read_test.py\n+++ b/tests/builtin_read_test.py\n@@ -6,16 +6,17 @@\n import tempfile\n import uuid\n from unittest.async_case import IsolatedAsyncioTestCase\n-from unittest.mock import patch\n+from unittest.mock import AsyncMock, patch\n from utils import AnyString\n \n-from agentscope.tool import ToolChunk, Read\n+from agentscope.tool import ToolChunk, Read, LocalBackend\n from agentscope.permission import (\n     PermissionContext,\n     PermissionBehavior,\n     PermissionRule,\n )\n from agentscope.message import TextBlock\n+from agentscope.state import AgentState, ToolContext\n \n \n # pylint: disable=too-many-public-methods\n@@ -178,6 +179,146 @@ async def test_read_with_limit(self) -> None:\n         self.assertIn(\"Line 3\", content)\n         self.assertNotIn(\"Line 4\", content)\n \n+    async def test_invalid_pagination_skips_reading_and_cache(self) -> None:\n+        \"\"\"Reject invalid pagination before reading or accessing the cache.\"\"\"\n+        state = AgentState()\n+        backend = LocalBackend()\n+        read_tool = Read(backend=backend)\n+        with (\n+            patch.object(\n+                backend,\n+                \"read_file\",\n+                new_callable=AsyncMock,\n+                return_value=b\"Line 1\\nLine 2\\n\",\n+            ) as read_file,\n+            patch.object(\n+                backend,\n+                \"stat_mtime\",\n+                new_callable=AsyncMock,\n+                return_value=1.0,\n+            ) as stat_mtime,\n+            patch.object(\n+                ToolContext,\n+                \"get_cache\",\n+                new_callable=AsyncMock,\n+                return_value=None,\n+            ) as get_cache,\n+            patch.object(\n+                ToolContext,\n+                \"cache_file\",\n+                new_callable=AsyncMock,\n+            ) as cache_file,\n+        ):\n+            for parameter, value in [\n+                (\"offset\", 0),\n+                (\"offset\", -1),\n+                (\"offset\", -3),\n+                (\"limit\", 0),\n+                (\"limit\", -1),\n+                (\"limit\", 2001),\n+            ]:\n+                with self.subTest(parameter=parameter, value=value):\n+                    invoke = (\n+                        read_tool.call if parameter == \"offset\" else read_tool\n+                    )\n+                    chunk = await invoke(\n+                        file_path=self.temp_file.name,\n+                        _agent_state=state,\n+                        **{parameter: value},\n+                    )\n+\n+                    expected_text = (\n+                        f\"Error: offset must be at least 1, got: {value}.\"\n+                        if parameter == \"offset\"\n+                        else \"Error: limit must be between 1 and 2000, \"\n+                        f\"got: {value}.\"\n+                    )\n+                    self.assertDictEqual(\n+                        chunk.model_dump(mode=\"json\"),\n+                        {\n+                            \"content\": [\n+                                {\n+                                    \"type\": \"text\",\n+                                    \"id\": AnyString(),\n+                                    \"text\": expected_text,\n+                                    \"created_at\": AnyString(),\n+                                    \"finished_at\": None,\n+                                },\n+                            ],\n+                            \"state\": \"error\",\n+                            \"is_last\": True,\n+                            \"metadata\": {},\n+                            \"id\": AnyString(),\n+                        },\n+                    )\n+                    read_file.assert_not_called()\n+                    stat_mtime.assert_not_called()\n+                    get_cache.assert_not_called()\n+                    cache_file.assert_not_called()\n+\n+    async def test_read_pagination_boundaries(self) -> None:\n+        \"\"\"Valid pagination preserves exact line numbers and content.\"\"\"\n+        all_lines = \"\\n\".join(f\"{i:6d}\\tLine {i}\" for i in range(1, 11))\n+        for offset, limit, expected in [\n+            (1, 1, \"     1\\tLine 1\"),\n+            (10, 1, \"    10\\tLine 10\"),\n+            (1, 2000, all_lines),\n+            (10, 2000, \"    10\\tLine 10\"),\n+            (11, 1, \"\"),\n+        ]:\n+            with self.subTest(offset=offset, limit=limit):\n+                chunk = await self.read_tool(\n+                    file_path=self.temp_file.name,\n+                    offset=offset,\n+                    limit=limit,\n+                )\n+\n+                self.assertDictEqual(\n+                    chunk.model_dump(mode=\"json\"),\n+                    {\n+                        \"content\": [\n+                            {\n+                                \"type\": \"text\",\n+                                \"id\": AnyString(),\n+                                \"text\": expected,\n+                                \"created_at\": AnyString(),\n+                                \"finished_at\": None,\n+                            },\n+                        ],\n+                        \"state\": \"running\",\n+                        \"is_last\": True,\n+                        \"metadata\": {},\n+                        \"id\": AnyString(),\n+                    },\n+                )\n+\n+    async def test_read_empty_file_with_valid_pagination(self) -> None:\n+        \"\"\"An empty file remains a successful empty result.\"\"\"\n+        with tempfile.NamedTemporaryFile(delete=False, suffix=\".txt\") as f:\n+            pass\n+        self.addCleanup(os.unlink, f.name)\n+\n+        chunk = await self.read_tool(file_path=f.name, offset=1, limit=1)\n+\n+        self.assertDictEqual(\n+            chunk.model_dump(mode=\"json\"),\n+            {\n+                \"content\": [\n+                    {\n+                        \"type\": \"text\",\n+                        \"id\": AnyString(),\n+                        \"text\": \"\",\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                    },\n+                ],\n+                \"state\": \"running\",\n+                \"is_last\": True,\n+                \"metadata\": {},\n+                \"id\": AnyString(),\n+            },\n+        )\n+\n     async def test_read_nonexistent_file(self) -> None:\n         \"\"\"Test reading a non-existent file.\"\"\"\n         missing_path = os.path.join(\n", "problem_statement": "[Bug]: Read tool accepts offset <= 0, negative-slicing the file and returning its tail labeled with line numbers 0 or negative\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nThe `Read` tool's parameter schema declares `offset` as a 1-based line number with `ge=1`, and `limit` with `ge=1, le=2000` (`src/agentscope/tool/_builtin/_read.py`), but nothing enforces them at runtime. When a caller passes `offset=0` (an easy 0-based off-by-one mistake for an LLM) or a negative offset, the slice `lines[start_idx:end_idx]` with a negative `start_idx` walks backwards from the end of the file, so the tool silently returns the **tail** of the file labeled with line numbers `0` or negative \u2014 with a success state. `limit=0` likewise returns empty text with a success state.\n\nSince the tool reports success, the model has no signal to self-correct; it receives content from the wrong part of the file labeled with impossible line numbers.\n\nThe sibling tools already reject this class of input at runtime: `Grep` returns `Error: offset must be non-negative.` / `Error: head_limit must be non-negative.` and `Glob` does the same for its pagination arguments.\n\n### Error Messages\n\nNo error is produced \u2014 that is the bug. On `main` (2.0.10dev), reading a 10-line file with `offset=0` succeeds and returns:\n\n```shell\n--- offset=0, state=running ---\n     0\tline 10\n--- offset=-3, state=running ---\n    -3\tline 7\n    -2\tline 8\n    -1\tline 9\n     0\tline 10\n--- limit=0, state=running ---\n''\n```\n\n### Steps to Reproduce\n\n1. Code:\n\n```python\nimport asyncio, os, tempfile\nfrom agentscope.tool import Read\n\nasync def main():\n    d = tempfile.mkdtemp()\n    p = os.path.join(d, \"sample.txt\")\n    with open(p, \"w\") as f:\n        for i in range(1, 11):\n            f.write(f\"line {i}\\n\")\n    read = Read()\n    for offset in (0, -3):\n        chunk = await read.call(file_path=p, offset=offset)\n        print(f\"offset={offset}: state={chunk.state}\")\n        print(chunk.content[0].text)\n    chunk = await read.call(file_path=p, limit=0)\n    print(f\"limit=0: state={chunk.state} text={chunk.content[0].text!r}\")\n\nasyncio.run(main())\n```\n\n2. Run: `python repro.py`\n3. See the file tail returned with line numbers `0`/negative and `state=running` instead of an error.\n\nExpected: an error chunk (like Grep/Glob pagination validation), e.g. `Error: offset must be at least 1, got: 0.`\n\n### Environment\n\n- AgentScope Version: 2.0.10 (main)\n- Python Version: 3.12.14\n- OS: macOS 15\n", "hints_text": "/assign\nIt's yours, @SSK988I. If there is no pull request and no word from you by 2026-10-27 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-13T04:06:11Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3292, "instance_id": "agentscope-ai__agentscope-3292", "issue_numbers": ["3288"], "base_commit": "9668b4c90c70cc214e1b7bb65dec2a6e70b90010", "patch": "diff --git a/src/agentscope/model/_anthropic/_model.py b/src/agentscope/model/_anthropic/_model.py\nindex 46f03e9cfe..cd2dd1194d 100644\n--- a/src/agentscope/model/_anthropic/_model.py\n+++ b/src/agentscope/model/_anthropic/_model.py\n@@ -24,6 +24,9 @@\n     AsyncStream = Any\n \n \n+_DEFAULT_MAX_TOKENS = 8192\n+\n+\n def _total_input_tokens(usage: Any) -> int:\n     \"\"\"The input tokens of an Anthropic usage, including the cached ones.\n \n@@ -209,17 +212,34 @@ def _build_thinking_config(\n         self,\n         max_tokens: int,\n     ) -> tuple[dict[str, Any] | None, int]:\n-        \"\"\"Build the provider-specific thinking configuration.\"\"\"\n+        \"\"\"Build thinking defaults and return a suggested output limit.\n+\n+        Only manual (``enabled``) thinking needs a budget. If the caller\n+        omits it, use half the effective output limit, rounded down, with\n+        a minimum of 1024 tokens. Raise ``ValueError`` if the resulting\n+        budget would reach or exceed the limit.\n+\n+        Forward an explicit budget and any explicit output limit as given\n+        for the provider to validate. If the caller omitted the limit and\n+        the budget reaches or exceeds the 8192-token default, set the limit\n+        to the budget plus 1024 to leave room for the answer.\n+        \"\"\"\n         mode = self._thinking_mode()\n         if mode is None:\n             return None, max_tokens\n \n         thinking: dict[str, Any] = {\"type\": mode}\n         if mode == \"enabled\":\n-            # Anthropic requires max_tokens > budget_tokens strictly.\n-            budget = self.parameters.thinking_budget or (max_tokens // 2)\n-            if budget >= max_tokens:\n-                # Auto-expand max_tokens to satisfy the inequality.\n+            budget = self.parameters.thinking_budget\n+            if budget is None:\n+                budget = max(1024, max_tokens // 2)\n+                if budget >= max_tokens:\n+                    raise ValueError(\n+                        \"Cannot fit an automatic thinking budget under \"\n+                        f\"max_tokens={max_tokens}. Raise max_tokens above \"\n+                        \"1024 or disable thinking for this call.\",\n+                    )\n+            elif budget >= max_tokens:\n                 max_tokens = budget + 1024\n             thinking[\"budget_tokens\"] = budget\n \n@@ -266,25 +286,20 @@ async def _call_api(\n                 enabled.\n         \"\"\"\n \n-        # Anthropic requires max_tokens; fall back to a safe default when\n-        # the user hasn't configured one explicitly.\n-        max_tokens = self.parameters.max_tokens or 8192\n-\n         kwargs: dict[str, Any] = {\n             \"model\": model_name,\n-            \"max_tokens\": max_tokens,\n             \"stream\": self.stream,\n             **generate_kwargs,\n         }\n-\n-        if \"thinking\" not in kwargs:\n-            thinking, expanded_max_tokens = self._build_thinking_config(\n-                max_tokens,\n-            )\n-            if thinking is not None:\n-                kwargs[\"thinking\"] = thinking\n-            if expanded_max_tokens != max_tokens:\n-                kwargs[\"max_tokens\"] = expanded_max_tokens\n+        # Resolve max_tokens in SDK precedence order: extra_body, per-call\n+        # argument, then model parameters. Leave it unset if none applies so\n+        # the thinking policy can distinguish the default from an explicit cap.\n+        if self.parameters.max_tokens is not None:\n+            kwargs.setdefault(\"max_tokens\", self.parameters.max_tokens)\n+        extra_body = kwargs.get(\"extra_body\") or {}\n+        if \"max_tokens\" in extra_body:\n+            # The SDK merges extra_body after validating its named arguments.\n+            kwargs[\"max_tokens\"] = extra_body[\"max_tokens\"]\n \n         # Effort travels inside ``output_config``, not as a top-level field.\n         if \"output_config\" not in kwargs:\n@@ -298,6 +313,15 @@ async def _call_api(\n         if fmt_tool_choice is not None:\n             kwargs[\"tool_choice\"] = fmt_tool_choice\n \n+        default_limit = _DEFAULT_MAX_TOKENS\n+        if \"thinking\" not in kwargs and \"thinking\" not in extra_body:\n+            thinking, default_limit = self._build_thinking_config(\n+                kwargs.get(\"max_tokens\", default_limit),\n+            )\n+            if thinking is not None:\n+                kwargs[\"thinking\"] = thinking\n+        kwargs.setdefault(\"max_tokens\", default_limit)\n+\n         formatted_messages = await self.formatter.format(messages)\n \n         # Extract the system message\n", "test_patch": "diff --git a/tests/model_anthropic_test.py b/tests/model_anthropic_test.py\nindex 8ae5177c27..82c5063445 100644\n--- a/tests/model_anthropic_test.py\n+++ b/tests/model_anthropic_test.py\n@@ -13,6 +13,9 @@\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock, patch\n \n+import httpx\n+import httpx2\n+from anthropic import DefaultAsyncHttpxClient\n from anthropic import types as anthropic_types\n \n from utils import AnyString\n@@ -547,6 +550,153 @@ async def test_budget_mode_expands_max_tokens(self) -> None:\n         self.assertEqual(kwargs[\"thinking\"][\"budget_tokens\"], 8192)\n         self.assertGreater(kwargs[\"max_tokens\"], 8192)\n \n+    async def test_per_call_max_tokens_bounds_auto_budget(self) -> None:\n+        \"\"\"The auto budget must respect a per-call max_tokens override.\"\"\"\n+        self.model.parameters.thinking_enable = True\n+\n+        await self.model([], max_tokens=4096)\n+\n+        kwargs = self.mock_create.call_args.kwargs\n+        self.assertEqual(kwargs[\"max_tokens\"], 4096)\n+        self.assertEqual(\n+            kwargs[\"thinking\"],\n+            {\"type\": \"enabled\", \"budget_tokens\": 2048},\n+        )\n+\n+    async def test_auto_budget_floors_at_provider_minimum(self) -> None:\n+        \"\"\"Half of a small cap can fall below 1024, so clamp it up.\"\"\"\n+        self.model.parameters.thinking_enable = True\n+\n+        await self.model([], max_tokens=1500)\n+\n+        kwargs = self.mock_create.call_args.kwargs\n+        self.assertEqual(kwargs[\"max_tokens\"], 1500)\n+        self.assertEqual(\n+            kwargs[\"thinking\"],\n+            {\"type\": \"enabled\", \"budget_tokens\": 1024},\n+        )\n+\n+    async def test_explicit_budget_is_forwarded(self) -> None:\n+        \"\"\"Let the provider validate the caller's explicit budget.\"\"\"\n+        self.model.parameters.thinking_enable = True\n+        self.model.parameters.thinking_budget = 512\n+\n+        await self.model([])\n+\n+        kwargs = self.mock_create.call_args.kwargs\n+        self.assertEqual(\n+            kwargs[\"thinking\"],\n+            {\"type\": \"enabled\", \"budget_tokens\": 512},\n+        )\n+\n+    async def test_unsatisfiable_cap_fails_fast(self) -> None:\n+        \"\"\"No valid budget exists while max_tokens <= 1024.\"\"\"\n+        self.model.parameters.thinking_enable = True\n+\n+        with self.assertRaises(ValueError) as ctx:\n+            await self.model([], max_tokens=1024)\n+\n+        self.assertIn(\"1024\", str(ctx.exception))\n+        self.assertIn(\"max_tokens\", str(ctx.exception))\n+        self.mock_create.assert_not_called()\n+\n+    async def test_caller_can_disable_thinking_per_call(self) -> None:\n+        \"\"\"An explicit thinking kwarg is the per-call escape hatch.\"\"\"\n+        self.model.parameters.thinking_enable = True\n+\n+        await self.model(\n+            [],\n+            max_tokens=1000,\n+            thinking={\"type\": \"disabled\"},\n+        )\n+\n+        kwargs = self.mock_create.call_args.kwargs\n+        self.assertEqual(kwargs[\"max_tokens\"], 1000)\n+        self.assertEqual(kwargs[\"thinking\"], {\"type\": \"disabled\"})\n+\n+    async def test_explicit_limits_on_wire(self) -> None:\n+        \"\"\"Exercise SDK body overrides and caller limits at the HTTP layer.\"\"\"\n+        self.model.parameters.thinking_enable = True\n+        self.model.parameters.max_tokens = 1500\n+        bodies = []\n+\n+        # Use the same HTTP types as the installed Anthropic SDK.\n+        backend = (\n+            httpx2\n+            if issubclass(DefaultAsyncHttpxClient, httpx2.AsyncClient)\n+            else httpx\n+        )\n+\n+        def capture(request: Any) -> Any:\n+            bodies.append(json.loads(request.content))\n+            return backend.Response(\n+                200,\n+                json={\n+                    \"id\": \"msg-1\",\n+                    \"type\": \"message\",\n+                    \"role\": \"assistant\",\n+                    \"model\": self.model.model,\n+                    \"content\": [],\n+                    \"usage\": {\"input_tokens\": 1, \"output_tokens\": 0},\n+                },\n+            )\n+\n+        async with DefaultAsyncHttpxClient(\n+            transport=backend.MockTransport(capture),\n+        ) as client:\n+            model = AnthropicChatModel(\n+                credential=self.model.credential,\n+                model=self.model.model,\n+                parameters=self.model.parameters,\n+                stream=False,\n+                client_kwargs={\"http_client\": client},\n+            )\n+            # (budget, call overrides, wire limit, wire thinking)\n+            cases: list[tuple[int | None, dict, int, dict]] = [\n+                (4096, {}, 1500, {\"type\": \"enabled\", \"budget_tokens\": 4096}),\n+                (\n+                    4096,\n+                    {\"max_tokens\": 1000},\n+                    1000,\n+                    {\"type\": \"enabled\", \"budget_tokens\": 4096},\n+                ),\n+                (\n+                    None,\n+                    {\"max_tokens\": 1000, \"extra_body\": {\"max_tokens\": 8192}},\n+                    8192,\n+                    {\"type\": \"enabled\", \"budget_tokens\": 4096},\n+                ),\n+                (\n+                    None,\n+                    {\"extra_body\": {\"max_tokens\": 1025}},\n+                    1025,\n+                    {\"type\": \"enabled\", \"budget_tokens\": 1024},\n+                ),\n+                (\n+                    None,\n+                    {\n+                        \"max_tokens\": 1000,\n+                        \"extra_body\": {\"thinking\": {\"type\": \"disabled\"}},\n+                    },\n+                    1000,\n+                    {\"type\": \"disabled\"},\n+                ),\n+            ]\n+            for budget, overrides, limit, thinking in cases:\n+                with self.subTest(budget=budget, overrides=overrides):\n+                    model.parameters.thinking_budget = budget\n+                    await model([], **overrides)\n+                    self.assertEqual(\n+                        bodies[-1],\n+                        {\n+                            \"model\": model.model,\n+                            \"stream\": False,\n+                            \"messages\": [],\n+                            \"max_tokens\": limit,\n+                            \"thinking\": thinking,\n+                        },\n+                    )\n+\n     def test_resolved_mode_drives_tool_choice_downgrade(self) -> None:\n         \"\"\"Only budget mode forbids forced tool use, so only it downgrades.\n \n", "problem_statement": "[Bug]: AnthropicChatModel builds thinking.budget_tokens from parameters-level max_tokens only, so a per-call max_tokens is sent with budget_tokens (4096) > max_tokens (1000) \u2014 an API-rejected request\n### Prerequisites\n\n- [X] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [X] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`AnthropicChatModel` with `thinking_enable=True` sizes `thinking.budget_tokens` from the **parameters-level** `max_tokens` only. When a caller passes a smaller per-call `max_tokens` via `generate_kwargs` \u2014 a documented public path, `ChatModelBase.__call__` forwards `**kwargs` as \"Additional keyword arguments passed to the underlying API\" (`src/agentscope/model/_base.py:202-203`) \u2014 the emitted request carries the per-call `max_tokens` but the parameters-derived `budget_tokens`, which is then larger. Such a request violates the API's requirement and is rejected with HTTP 400.\n\nConcretely: with `parameters.thinking_enable=True` (and `thinking_budget` unset, `parameters.max_tokens` unset), `await model(messages, max_tokens=1000)` sends `max_tokens=1000` together with `thinking.budget_tokens=4096` (half of the 8192 default assumed at `src/agentscope/model/_anthropic/_model.py:250`).\n\n**Expected behaviour:** the request must satisfy `max_tokens > thinking.budget_tokens`, because:\n\n- the model's own guard states it \u2014 `src/agentscope/model/_anthropic/_model.py:198`: `# Anthropic requires max_tokens > budget_tokens strictly.`\n- the repo's own test asserts it on emitted requests \u2014 `test_budget_mode_expands_max_tokens` (`tests/model_anthropic_test.py:482-491`: \"max_tokens must stay strictly above budget_tokens\"); the auto-expansion in `_build_thinking_config` exists precisely to maintain this invariant, but on this path it is evaluated against the wrong `max_tokens`;\n- the Anthropic API requires it \u2014 `thinking.budget_tokens` \"Must be \u22651024 and less than `max_tokens`\" (anthropic SDK `ThinkingConfigEnabledParam`; extended thinking docs: https://platform.claude.com/docs/en/build-with-claude/extended-thinking).\n\n**Root cause:** in `_call_api` (`src/agentscope/model/_anthropic/_model.py`), line 250 derives `max_tokens` from `self.parameters.max_tokens or 8192` *before* the caller-supplied `generate_kwargs` are merged into `kwargs` (lines 252-257); lines 259-266 then build and possibly auto-expand the thinking config against that parameters-derived value, and the expanded `max_tokens` is only written back when it differs from the parameters-derived one \u2014 the caller's `max_tokens` already sitting in `kwargs` is never considered when sizing `budget_tokens`.\n\nHappy to be assigned and open a PR \u2014 the fix is to resolve the effective cap after merging `generate_kwargs` (`kwargs.get(\"max_tokens\")` or `parameters.max_tokens` or the 8192 default) and size `budget_tokens` / any auto-expansion against that value.\n\nRelated issues/PRs: searched open issues for \"anthropic budget_tokens\", \"anthropic max_tokens thinking\", and \"thinking budget\" \u2014 no existing report found (2026-10-13).\n\nAI disclosure: this report was prepared with AI assistance to locate and reproduce the bug; I ran the reproduction below against commit `34457377b2919f69cd2cc3391552a333bc1791af` and verified each cited line in the source myself.\n\n### Error Messages\n\nThe malformed request is visible without a network call \u2014 capturing what `client.messages.create` receives (mocked client) shows the violated invariant:\n\n```text\nsent max_tokens          : 1000\nsent thinking            : {'type': 'enabled', 'budget_tokens': 4096}\nsent budget_tokens       : 4096\ninvariant max>budget     : False\nguard's assumed max_tokens: 8192\n```\n\nWith a control run added (same model, no per-call override), the override is what breaks the invariant:\n\n```text\n--- A per-call max_tokens=1000\nsent max_tokens    = 1000\nsent thinking     = {'type': 'enabled', 'budget_tokens': 4096}\ninvariant max>budget holds: False\n--- B control (no override)\nsent max_tokens    = 8192\nsent thinking     = {'type': 'enabled', 'budget_tokens': 4096}\ninvariant max>budget holds: True\nREPRODUCED: request would carry max_tokens=1000 with thinking.budget_tokens=4096 -> violates Anthropic's max_tokens > budget_tokens requirement\n```\n\nA real call with the first payload is rejected by the Messages API with HTTP 400, since `thinking.budget_tokens` (4096) is not less than `max_tokens` (1000).\n\n### Steps to Reproduce\n\n1. Code (`repro_anthropic_budget_vs_max_tokens.py`):\n\n```python\nimport asyncio\nfrom unittest.mock import AsyncMock, MagicMock\n\nfrom agentscope.model import AnthropicChatModel\nfrom agentscope.credential import AnthropicCredential\nfrom agentscope.message import UserMsg\n\n\nasync def main() -> None:\n    captured = {}\n\n    async def fake_create(**kwargs):\n        captured.update(kwargs)\n        resp = MagicMock()\n        resp.content = []\n        resp.usage = None\n        resp.id = \"msg_1\"\n        return resp\n\n    model = AnthropicChatModel(\n        credential=AnthropicCredential(api_key=\"test\"),\n        model=\"claude-opus-4-6\",\n        stream=False,\n        parameters=AnthropicChatModel.Parameters(\n            thinking_enable=True,  # budget mode, thinking_budget unset\n        ),\n    )\n    model.client = MagicMock()\n    model.client.messages.create = AsyncMock(side_effect=fake_create)\n\n    # Per-call max_tokens via generate_kwargs \u2014 public __call__ forwards it.\n    await model(\n        [UserMsg(\"user\", \"Hi\")],\n        max_tokens=1000,  # per-call override\n    )\n\n    sent_max = captured[\"max_tokens\"]\n    budget = captured[\"thinking\"][\"budget_tokens\"]\n    print(\"sent max_tokens          :\", sent_max)\n    print(\"sent thinking            :\", captured[\"thinking\"])\n    print(\"sent budget_tokens       :\", budget)\n    print(\"invariant max>budget     :\", sent_max > budget)\n    print(\"guard's assumed max_tokens:\", model.parameters.max_tokens or 8192)\n\n\nasyncio.run(main())\n```\n\n2. Run: `python repro_anthropic_budget_vs_max_tokens.py`\n3. See the output above: the request carries `max_tokens=1000` with `thinking.budget_tokens=4096`, so the invariant the model's own guard maintains elsewhere is violated on the per-call-override path.\n\n### Environment\n\n- AgentScope Version: 2.0.10 (source checkout at commit `34457377b2919f69cd2cc3391552a333bc1791af`)\n- Python Version: 3.12.14 (anthropic SDK 1.13.0)\n- OS: macOS 26.6.2 (arm64)\n\n", "hints_text": "", "created_at": "2026-10-13T02:48:19Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3282, "instance_id": "agentscope-ai__agentscope-3282", "issue_numbers": ["3281"], "base_commit": "34457377b2919f69cd2cc3391552a333bc1791af", "patch": "diff --git a/src/agentscope/tui/_ask_user.py b/src/agentscope/tui/_ask_user.py\nindex 7ef20d2e6a..ad3d805987 100644\n--- a/src/agentscope/tui/_ask_user.py\n+++ b/src/agentscope/tui/_ask_user.py\n@@ -193,8 +193,12 @@ def set_pending(\n         self,\n         pending: list[tuple[str, str, ToolCallBlock]],\n     ) -> None:\n-        previous_id = self._pending[0][2].id if self._pending else None\n-        current_id = pending[0][2].id if pending else None\n+        previous_id = (\n+            (self._pending[0][0], self._pending[0][2].id)\n+            if self._pending\n+            else None\n+        )\n+        current_id = (pending[0][0], pending[0][2].id) if pending else None\n         self._pending = pending\n         self.display = bool(pending)\n         if previous_id != current_id:\ndiff --git a/src/agentscope/tui/_chat.py b/src/agentscope/tui/_chat.py\nindex 2864907bf4..739f930935 100644\n--- a/src/agentscope/tui/_chat.py\n+++ b/src/agentscope/tui/_chat.py\n@@ -191,8 +191,12 @@ def set_pending(\n         self,\n         pending: list[tuple[str, str, ToolCallBlock]],\n     ) -> None:\n-        previous = self._pending[0][2].id if self._pending else None\n-        current = pending[0][2].id if pending else None\n+        previous = (\n+            (self._pending[0][0], self._pending[0][2].id)\n+            if self._pending\n+            else None\n+        )\n+        current = (pending[0][0], pending[0][2].id) if pending else None\n         self._pending = pending\n         if previous != current:\n             self._submitting = False\n@@ -478,7 +482,7 @@ def __init__(\n         self.show_thinking = show_thinking\n         self.show_usage = show_usage\n         self.input_enabled = input_enabled\n-        self._dismissed_call_ids: set[str] = set()\n+        self._dismissed_calls: set[tuple[str, str]] = set()\n \n     def compose(self) -> ComposeResult:\n         yield MessagesUI(\n@@ -542,7 +546,7 @@ def watch_input_enabled(self, enabled: bool) -> None:\n \n     def _pending_tools(self) -> list[tuple[str, str, ToolCallBlock]]:\n         pending: list[tuple[str, str, ToolCallBlock]] = []\n-        pending_ids: set[str] = set()\n+        pending_calls: set[tuple[str, str]] = set()\n         for message in self._current_messages():\n             if message.role != \"assistant\" or message.finished_at is not None:\n                 continue\n@@ -551,10 +555,11 @@ def _pending_tools(self) -> list[tuple[str, str, ToolCallBlock]]:\n                     ToolCallState.ASKING,\n                     ToolCallState.SUBMITTED,\n                 ):\n-                    pending_ids.add(block.id)\n-                    if block.id not in self._dismissed_call_ids:\n+                    call = (message.id, block.id)\n+                    pending_calls.add(call)\n+                    if call not in self._dismissed_calls:\n                         pending.append((message.id, message.name, block))\n-        self._dismissed_call_ids.intersection_update(pending_ids)\n+        self._dismissed_calls.intersection_update(pending_calls)\n         return pending\n \n     def _latest_running_reply_id(self) -> str | None:\n@@ -621,8 +626,9 @@ def _on_composer_interrupt(\n \n     @on(HitlUI.Confirmed)\n     def _on_hitl_confirmed(self, event: HitlUI.Confirmed) -> None:\n-        self._dismissed_call_ids.update(\n-            result.tool_call.id for result in event.value.confirm_results\n+        self._dismissed_calls.update(\n+            (event.value.reply_id, result.tool_call.id)\n+            for result in event.value.confirm_results\n         )\n         self._sync_interaction_area()\n         self.post_message(self.Confirmed(event.value))\n@@ -630,7 +636,9 @@ def _on_hitl_confirmed(self, event: HitlUI.Confirmed) -> None:\n     @on(AskUserUI.Submitted)\n     def _on_ask_user_submitted(self, event: AskUserUI.Submitted) -> None:\n         # Dismiss the form locally without changing authoritative messages.\n-        self._dismissed_call_ids.add(event.tool_call_id)\n+        self._dismissed_calls.add(\n+            (event.value.reply_id, event.tool_call_id),\n+        )\n         self._sync_interaction_area()\n         self.post_message(self.ExternalExecutionSubmitted(event.value))\n \n", "test_patch": "diff --git a/tests/tui_test.py b/tests/tui_test.py\nindex 81369693a5..6a85c28df2 100644\n--- a/tests/tui_test.py\n+++ b/tests/tui_test.py\n@@ -802,6 +802,55 @@ def hook(message: TextualMessage) -> None:\n                 str(app.query_one(\"#as-hitl-body\", Static).render()),\n             )\n \n+    async def test_reused_tool_call_id_stays_pending_in_new_reply(\n+        self,\n+    ) -> None:\n+        \"\"\"Dismissing one reply must not hide a later call with the same\n+        provider-generated id.\"\"\"\n+        first = AssistantMsg(\n+            name=\"agent\",\n+            id=\"reply-1\",\n+            content=[\n+                ToolCallBlock(\n+                    id=\"call-1\",\n+                    name=\"Read\",\n+                    input=\"{}\",\n+                    state=\"asking\",\n+                ),\n+            ],\n+        )\n+        app = _ChatApp([first])\n+        async with app.run_test() as pilot:\n+            await pilot.press(\"enter\")\n+            await pilot.pause()\n+\n+            chat = app.query_one(ChatUI)\n+            await chat.set_messages(\n+                [\n+                    AssistantMsg(\n+                        name=\"agent\",\n+                        id=\"reply-2\",\n+                        content=[\n+                            ToolCallBlock(\n+                                id=\"call-1\",\n+                                name=\"Bash\",\n+                                input=\"{}\",\n+                                state=\"asking\",\n+                            ),\n+                        ],\n+                    ),\n+                ],\n+            )\n+            await pilot.pause()\n+\n+            hitl = app.query_one(HitlUI)\n+            self.assertTrue(hitl.display)\n+            self.assertFalse(app.query_one(OptionList).disabled)\n+            self.assertIn(\n+                \"Bash\",\n+                str(app.query_one(\"#as-hitl-body\", Static).render()),\n+            )\n+\n     async def test_permission_rules_are_embedded_in_always_option(\n         self,\n     ) -> None:\n@@ -1040,6 +1089,64 @@ def hook(message: TextualMessage) -> None:\n             )\n             await AskUser().check_external_result(result)\n \n+    async def test_reused_ask_user_id_loads_the_new_reply(self) -> None:\n+        \"\"\"AskUser state is scoped by reply as well as tool-call id.\"\"\"\n+\n+        def ask(reply_id: str, question: str) -> AssistantMsg:\n+            return AssistantMsg(\n+                name=\"agent\",\n+                id=reply_id,\n+                content=[\n+                    ToolCallBlock(\n+                        id=\"ask-1\",\n+                        name=\"AskUser\",\n+                        input=json.dumps(\n+                            {\n+                                \"questions\": [\n+                                    {\n+                                        \"header\": \"Choice\",\n+                                        \"question\": question,\n+                                        \"options\": [\n+                                            {\n+                                                \"label\": \"A\",\n+                                                \"description\": \"Choose A.\",\n+                                            },\n+                                            {\n+                                                \"label\": \"B\",\n+                                                \"description\": \"Choose B.\",\n+                                            },\n+                                        ],\n+                                    },\n+                                ],\n+                            },\n+                        ),\n+                        state=\"submitted\",\n+                    ),\n+                ],\n+            )\n+\n+        app = _ChatApp([ask(\"reply-1\", \"First question?\")])\n+        async with app.run_test() as pilot:\n+            await pilot.press(\"enter\")\n+            await pilot.pause()\n+\n+            chat = app.query_one(ChatUI)\n+            await chat.set_messages([ask(\"reply-2\", \"Second question?\")])\n+            await pilot.pause()\n+\n+            ask_user = app.query_one(AskUserUI)\n+            self.assertTrue(ask_user.display)\n+            self.assertFalse(app.query_one(OptionList).disabled)\n+            self.assertIn(\n+                \"Second question?\",\n+                str(\n+                    app.query_one(\n+                        \".as-ask-user-question\",\n+                        Static,\n+                    ).render(),\n+                ),\n+            )\n+\n     async def test_invalid_ask_user_input_returns_error_result(self) -> None:\n         observed: list[ChatUI.ExternalExecutionSubmitted] = []\n \n", "problem_statement": "[Bug]: TUI hides tool interactions when IDs repeat across replies\n### Prerequisites\n\n- [x] I searched existing issues, discussions, and pull requests and did not find a duplicate.\n- [x] This is a bug, not a usage question.\n\n### Background / Description\n\nThe TUI tracks locally dismissed tool interactions only by `ToolCallBlock.id`. Tool-call IDs identify a call within a reply, but a later reply may reuse the same value. After the first interaction is confirmed or submitted, a pending call with the same ID in another reply is filtered out, so its confirmation or `AskUser` form is not shown.\n\nThe same identity comparison is used when `HitlUI` and `AskUserUI` switch between pending calls. Reusing an ID across replies can therefore retain `_submitting` or form state from the previous interaction.\n\nExpected behavior: tool interactions from different replies remain independent even when their tool-call IDs match.\n\nActual behavior: dismissing `call_1` in `reply_1` also hides `call_1` in `reply_2`.\n\n### Error Messages\n\n```shell\nNo exception is raised. The second pending interaction is silently omitted from the TUI.\n\nfirst pending: [('reply_1', 'call_1')]\nsecond pending: []\ndismissed ids: {'call_1'}\n```\n\n### Steps to Reproduce\n\n```python\nfrom agentscope.message import AssistantMsg, ToolCallBlock\nfrom agentscope.tui._chat import ChatUI\n\n\ndef pending(reply_id: str) -> AssistantMsg:\n    return AssistantMsg(\n        name=\"agent\",\n        id=reply_id,\n        content=[\n            ToolCallBlock(\n                id=\"call_1\",\n                name=\"Bash\",\n                input=\"{}\",\n                state=\"asking\",\n            ),\n        ],\n    )\n\n\nchat = ChatUI([pending(\"reply_1\")])\nprint([(reply_id, call.id) for reply_id, _, call in chat._pending_tools()])\n\n# This is what happens after the first interaction is submitted locally.\nchat._dismissed_call_ids.add(\"call_1\")\nchat._active_messages = {\"reply_2\": pending(\"reply_2\")}\n\nprint([(reply_id, call.id) for reply_id, _, call in chat._pending_tools()])\n```\n\nThe second print should contain `(\"reply_2\", \"call_1\")`, but it is empty.\n\n### Environment\n\n- AgentScope Version: 2.0.10 (`main` at `34457377`)\n- Python Version: 3.12.14\n- OS: macOS 26.6.2 arm64\n\n### Proposed fix\n\nScope local interaction identity by `(reply_id, tool_call_id)` in `ChatUI`, `HitlUI`, and `AskUserUI`, with regression tests for repeated IDs across replies. This does not change the public message schema or provider-facing tool-call IDs.\n\n", "hints_text": "", "created_at": "2026-10-12T17:15:01Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3265, "instance_id": "agentscope-ai__agentscope-3265", "issue_numbers": ["3264"], "base_commit": "654738c3daf4783e748c4dd4051bd14997c62940", "patch": "diff --git a/src/agentscope/embedding/_ollama/_model.py b/src/agentscope/embedding/_ollama/_model.py\nindex ae04111e70..901350030d 100644\n--- a/src/agentscope/embedding/_ollama/_model.py\n+++ b/src/agentscope/embedding/_ollama/_model.py\n@@ -81,6 +81,10 @@ def __init__(\n         import ollama\n \n         self.client: ollama.AsyncClient = ollama.AsyncClient(host=self.host)\n+        self._cache_endpoint: str = str(\n+            # Ollama resolves OLLAMA_HOST and its default URL here.\n+            self.client._client.base_url,  # pylint: disable=protected-access\n+        )\n \n     async def _call_api(\n         self,\n@@ -105,9 +109,16 @@ async def _call_api(\n             **kwargs,\n         }\n \n+        # Two Ollama endpoints can serve different weights under the same\n+        # model name, so the resolved endpoint is part of the cache key but\n+        # not of the request payload.\n+        cache_identifier: dict[str, Any] = {\n+            \"endpoint\": self._cache_endpoint,\n+            \"api_kwargs\": api_kwargs,\n+        }\n         if self.embedding_cache:\n             cached = await self.embedding_cache.retrieve(\n-                identifier=api_kwargs,\n+                identifier=cache_identifier,\n             )\n             if cached:\n                 return EmbeddingResponse(\n@@ -122,7 +133,7 @@ async def _call_api(\n \n         if self.embedding_cache:\n             await self.embedding_cache.store(\n-                identifier=api_kwargs,\n+                identifier=cache_identifier,\n                 embeddings=response.embeddings,\n             )\n \n", "test_patch": "diff --git a/tests/embedding_ollama_test.py b/tests/embedding_ollama_test.py\nindex 202f23d79f..fb4ae4d27c 100644\n--- a/tests/embedding_ollama_test.py\n+++ b/tests/embedding_ollama_test.py\n@@ -1,15 +1,19 @@\n # -*- coding: utf-8 -*-\n # pylint: disable=protected-access\n \"\"\"Unit tests for OllamaEmbeddingModel.\"\"\"\n+import os\n from dataclasses import asdict\n+from tempfile import TemporaryDirectory\n+from types import SimpleNamespace\n from typing import Any\n from unittest import IsolatedAsyncioTestCase\n-from unittest.mock import AsyncMock\n+from unittest.mock import AsyncMock, patch\n \n from utils import AnyValue\n \n from agentscope.credential import OllamaCredential\n from agentscope.embedding import (\n+    FileEmbeddingCache,\n     OllamaEmbeddingModel,\n     EmbeddingResponse,\n     EmbeddingUsage,\n@@ -104,3 +108,112 @@ async def _mock(inputs: list[str], **_kw: Any) -> EmbeddingResponse:\n             },\n         )\n         self.assertEqual(call_count, 2)\n+\n+\n+class OllamaEmbeddingCacheHostTest(IsolatedAsyncioTestCase):\n+    \"\"\"The embedding cache must not be shared across Ollama hosts.\"\"\"\n+\n+    def _assert_response(\n+        self,\n+        response: EmbeddingResponse,\n+        embeddings: list[list[float]],\n+        source: str,\n+    ) -> None:\n+        \"\"\"Assert the complete embedding response structure.\"\"\"\n+        usage_value = 0 if source == \"cache\" else A\n+        self.assertDictEqual(\n+            asdict(response),\n+            {\n+                \"embeddings\": embeddings,\n+                \"id\": A,\n+                \"created_at\": A,\n+                \"type\": \"embedding\",\n+                \"usage\": {\n+                    \"tokens\": usage_value,\n+                    \"time\": usage_value,\n+                    \"type\": \"embedding\",\n+                },\n+                \"source\": source,\n+            },\n+        )\n+\n+    def _make_model(\n+        self,\n+        cache: FileEmbeddingCache,\n+        host: str | None,\n+        vector: list[float],\n+    ) -> OllamaEmbeddingModel:\n+        \"\"\"Create an Ollama model with a mocked embedding response.\"\"\"\n+        model = OllamaEmbeddingModel(\n+            credential=OllamaCredential(host=host),\n+            model=\"embed\",\n+            dimensions=2,\n+            embedding_cache=cache,\n+        )\n+        self.addAsyncCleanup(model.client._client.aclose)\n+        model.client = SimpleNamespace(\n+            embed=AsyncMock(\n+                return_value=SimpleNamespace(embeddings=[vector]),\n+            ),\n+        )\n+        return model\n+\n+    async def test_cache_is_isolated_by_host(self) -> None:\n+        \"\"\"Two hosts serving the same model name must not reuse each\n+        other's cached vectors.\"\"\"\n+        with TemporaryDirectory() as cache_dir:\n+            cache = FileEmbeddingCache(cache_dir=cache_dir)\n+            model_a = self._make_model(\n+                cache,\n+                \"http://host-a:11434\",\n+                [1.0, 0.0],\n+            )\n+            model_b = self._make_model(\n+                cache,\n+                \"http://host-b:11434\",\n+                [0.0, 1.0],\n+            )\n+\n+            res_a = await model_a([\"hello\"])\n+            res_b = await model_b([\"hello\"])\n+\n+            self._assert_response(res_a, [[1.0, 0.0]], \"api\")\n+            self._assert_response(res_b, [[0.0, 1.0]], \"api\")\n+            model_b.client.embed.assert_awaited_once()\n+            # The endpoint must stay out of the Ollama request payload.\n+            self.assertNotIn(\n+                \"endpoint\",\n+                model_b.client.embed.await_args.kwargs,\n+            )\n+\n+    async def test_cache_uses_host_from_environment(self) -> None:\n+        \"\"\"The resolved OLLAMA_HOST must isolate cached vectors.\"\"\"\n+        with TemporaryDirectory() as cache_dir:\n+            cache = FileEmbeddingCache(cache_dir=cache_dir)\n+            with patch.dict(\n+                os.environ,\n+                {\"OLLAMA_HOST\": \"http://host-a:11434\"},\n+            ):\n+                model_a = self._make_model(cache, None, [1.0, 0.0])\n+            with patch.dict(\n+                os.environ,\n+                {\"OLLAMA_HOST\": \"http://host-b:11434\"},\n+            ):\n+                model_b = self._make_model(cache, None, [0.0, 1.0])\n+            with patch.dict(\n+                os.environ,\n+                {\"OLLAMA_HOST\": \"http://host-a:11434/\"},\n+            ):\n+                model_a_again = self._make_model(cache, None, [0.5, 0.5])\n+\n+            res_a = await model_a([\"hello\"])\n+            res_b = await model_b([\"hello\"])\n+            res_a_again = await model_a_again([\"hello\"])\n+\n+            self.assertEqual(model_a._cache_endpoint, \"http://host-a:11434\")\n+            self.assertEqual(model_b._cache_endpoint, \"http://host-b:11434\")\n+            self._assert_response(res_a, [[1.0, 0.0]], \"api\")\n+            self._assert_response(res_b, [[0.0, 1.0]], \"api\")\n+            model_b.client.embed.assert_awaited_once()\n+            self._assert_response(res_a_again, [[1.0, 0.0]], \"cache\")\n+            model_a_again.client.embed.assert_not_awaited()\n", "problem_statement": "[Bug]: Ollama embedding cache reuses vectors across different hosts\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nThis is the same cache-key problem reported for OpenAI in #3140 (fix in progress in #3142), but in `OllamaEmbeddingModel`.\n\n`OllamaEmbeddingModel._call_api` (`src/agentscope/embedding/_ollama/_model.py`) builds the embedding cache key from the request kwargs only (`input`, `model`, `dimensions`). The Ollama host (`OllamaCredential.host`) is not part of the key. Two Ollama servers can serve different weights under the same model name, for example a custom tag, a different quantization, or a different version behind `:latest`. When they share a `FileEmbeddingCache`, the second host receives the first host's vectors and is never called, which silently mixes embedding spaces in a knowledge base.\n\n**Expected:** the cache key includes the host, and the request payload sent to Ollama stays unchanged.\n\n### Error Messages\n\n```shell\n# No exception. Output on main (654738c) with two hosts sharing one cache:\nhost A -> [[1.0, 0.0]] api | calls: 1\nhost B -> [[1.0, 0.0]] cache | calls: 0   # expected [[0.0, 1.0]] from host B\n```\n\n### Steps to Reproduce\n\n```python\nimport asyncio, tempfile\nfrom types import SimpleNamespace\nfrom agentscope.credential import OllamaCredential\nfrom agentscope.embedding import OllamaEmbeddingModel, FileEmbeddingCache\n\nasync def main():\n    cache = FileEmbeddingCache(cache_dir=tempfile.mkdtemp())\n\n    def make(host, vector):\n        model = OllamaEmbeddingModel(\n            credential=OllamaCredential(host=host),\n            model=\"embed\",\n            dimensions=2,\n            embedding_cache=cache,\n        )\n        calls = []\n\n        async def embed(**kwargs):\n            calls.append(kwargs)\n            return SimpleNamespace(embeddings=[vector])\n\n        model.client = SimpleNamespace(embed=embed)  # stand-in for each server\n        return model, calls\n\n    a, calls_a = make(\"http://host-a:11434\", [1.0, 0.0])\n    b, calls_b = make(\"http://host-b:11434\", [0.0, 1.0])\n    ra, rb = await a([\"hello\"]), await b([\"hello\"])\n    print(\"host A ->\", ra.embeddings, ra.source, \"| calls:\", len(calls_a))\n    print(\"host B ->\", rb.embeddings, rb.source, \"| calls:\", len(calls_b))\n\nasyncio.run(main())\n```\n\n### Environment\n\n- AgentScope Version: 2.0.10.dev0 (main @ 654738c)\n- Python Version: 3.12\n- OS: Ubuntu 24.04\n\n### Proposed fix and a design question\n\nA minimal per-provider fix, following the approach of #3142, is to use `{\"host\": self.host, **api_kwargs}` as the cache identifier for both `retrieve` and `store`. Existing cache entries would miss once and be fetched again. I have this ready with a regression test.\n\nBefore opening a PR, which direction would you prefer?\n\n1. **Per provider**, like #3142: each embedding model adds its own endpoint to the cache key.\n2. **Generic**: the base class or the cache adds the endpoint to the key, so every provider is covered in one place.\n\nI'm happy to implement whichever you choose.\n\n", "hints_text": "/assign\nIt's yours, @maahumada. If there is no pull request and no word from you by 2026-10-26 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-12T06:12:47Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3263, "instance_id": "agentscope-ai__agentscope-3263", "issue_numbers": ["3262"], "base_commit": "654738c3daf4783e748c4dd4051bd14997c62940", "patch": "diff --git a/src/agentscope/middleware/_tracing/_utils.py b/src/agentscope/middleware/_tracing/_utils.py\nindex b06bbbcb81..244ea7d824 100644\n--- a/src/agentscope/middleware/_tracing/_utils.py\n+++ b/src/agentscope/middleware/_tracing/_utils.py\n@@ -36,7 +36,16 @@ def _to_serializable(\n     elif isinstance(obj, dict):\n         res = {str(key): _to_serializable(val) for (key, val) in obj.items()}\n \n-    elif isinstance(obj, (Msg, BaseModel)) or is_dataclass(obj):\n+    elif isinstance(obj, (Msg, BaseModel)):\n+        # Dump the model's fields, so the span carries readable JSON\n+        # rather than a Python repr string.\n+        try:\n+            res = _to_serializable(obj.model_dump())\n+        except Exception:\n+            # Tracing must not fail because model serialization fails.\n+            res = repr(obj)\n+\n+    elif is_dataclass(obj):\n         res = repr(obj)\n \n     elif inspect.isclass(obj) and issubclass(obj, BaseModel):\n", "test_patch": "", "problem_statement": "[Bug]: Tracing records tool results as Python reprs instead of JSON\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`TracingMiddleware` serializes span payloads with `_serialize_to_str` / `_to_serializable` (`src/agentscope/middleware/_tracing/_utils.py`). For any Pydantic object, `_to_serializable` returns `repr(obj)`, so the two most common tool-related payloads reach the exporter as Python repr strings instead of JSON:\n\n1. **`execute_tool` spans**: `gen_ai.tool.call.result` is set from the last item of the tool stream (`_get_tool_response_attributes(last_item)` in `_trace.py`), which is a `ToolResponse`.\n2. **`chat` spans**: in `gen_ai.input.messages`, every `tool_call_response` part whose `ToolResultBlock.output` is a list of blocks (the normal case) is built by `_convert_block_to_part` \u2192 `_serialize_to_str(output)`.\n\nTrace backends therefore receive values like `\"ToolResponse(content=[TextBlock(type='text', ...)], state=<ToolResultState.SUCCESS: 'success'>, ...)\"`. These are not JSON, so they cannot be parsed or rendered as structured data, and they leak Python enum reprs. `_to_serializable`'s own docstring says it converts \"an object to a JSON serializable type\", and the OTel GenAI conventions describe `gen_ai.tool.call.result` as the result returned by the tool.\n\n**Expected:** a Pydantic object is dumped to its fields, e.g. `{\"content\": [{\"type\": \"text\", \"text\": \"Wuhan: sunny, 25C\", ...}], \"state\": \"success\", ...}`.\n\n### Error Messages\n\n```shell\n# No exception. Attribute values recorded on main (654738c) with an InMemorySpanExporter:\nexecute_tool get_weather -> \"ToolResponse(content=[TextBlock(type='text', text='Wuhan: sunny, 25C', id='3b42c10226f944198c1edaee2fc76abb', created_at='2026-10-12T02:51:10.786901', finished_at=None)], state=<ToolResultState.SUCCESS: 'success'>, metadata={}, id='c1')\"\nchat mock-model input tool_call_response -> [\"TextBlock(type='text', text='Wuhan: sunny, 25C', id='3b42c10226f944198c1edaee2fc76abb', created_at='2026-10-12T02:51:10.786901', finished_at=None)\"]\n```\n\n### Steps to Reproduce\n\n```python\nfrom agentscope.message import TextBlock, ToolResultBlock, ToolResultState\nfrom agentscope.middleware._tracing._converter import _convert_block_to_part\nfrom agentscope.middleware._tracing._utils import _serialize_to_str\nfrom agentscope.tool import ToolResponse\n\nprint(_serialize_to_str(\n    ToolResponse(content=[TextBlock(text=\"sunny\")], state=ToolResultState.SUCCESS, id=\"c1\"),\n))\nprint(_convert_block_to_part(\n    ToolResultBlock(id=\"c1\", name=\"get_weather\", output=[TextBlock(text=\"sunny\")], state=ToolResultState.SUCCESS),\n)[\"response\"])\n```\n\nRunning an `Agent` with `TracingMiddleware` and a tool that returns a `ToolChunk` through an `InMemorySpanExporter` produces the span values shown above.\n\n### Environment\n\n- AgentScope Version: 2.0.10.dev0 (main @ 654738c)\n- Python Version: 3.12\n- OS: Ubuntu 24.04\n\n### Proposed fix\n\nIn `_to_serializable`, serialize `BaseModel` instances with `_to_serializable(obj.model_dump())` instead of `repr(obj)`. Dataclasses and model classes keep their current behavior. I'd like to take this and will open a PR with a regression test.\n\n", "hints_text": "", "created_at": "2026-10-12T06:01:45Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3257, "instance_id": "agentscope-ai__agentscope-3257", "issue_numbers": ["3256"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/tool/_adapters.py b/src/agentscope/tool/_adapters.py\nindex d62aa6bd87..25a882ef20 100644\n--- a/src/agentscope/tool/_adapters.py\n+++ b/src/agentscope/tool/_adapters.py\n@@ -21,6 +21,8 @@\n from ._utils import (\n     _extract_func_description,\n     _extract_input_schema,\n+    _get_callable_docstring,\n+    _get_callable_name,\n     _remove_title_field,\n )\n from .._logging import logger\n@@ -93,9 +95,9 @@ def __init__(\n                 user will be asked to confirm the tool call.\n         \"\"\"\n         super().__init__(middlewares=middlewares)\n-        self.name = name or func.__name__\n+        self.name = name or _get_callable_name(func)\n         self.description = description or _extract_func_description(\n-            func.__doc__ or \"\",\n+            _get_callable_docstring(func),\n         )\n         if isinstance(input_schema, type) and issubclass(\n             input_schema,\ndiff --git a/src/agentscope/tool/_utils.py b/src/agentscope/tool/_utils.py\nindex 672700d88c..f64046d244 100644\n--- a/src/agentscope/tool/_utils.py\n+++ b/src/agentscope/tool/_utils.py\n@@ -2,12 +2,124 @@\n \"\"\"The tool module utils.\"\"\"\n import inspect\n import typing\n+from functools import partial\n from typing import Any, Dict, Callable\n \n from docstring_parser import parse\n from pydantic import Field, create_model, ConfigDict\n \n \n+def _get_callable_name(tool_func: Callable) -> str:\n+    \"\"\"Get the effective name of a callable.\"\"\"\n+    named_func = tool_func\n+\n+    while isinstance(named_func, partial):\n+        explicit_name = vars(named_func).get(\"__name__\")\n+        if explicit_name is not None:\n+            return explicit_name\n+\n+        named_func = named_func.func\n+\n+    return named_func.__name__\n+\n+\n+def _get_callable_docstring(tool_func: Callable) -> str:\n+    \"\"\"Get the effective docstring of a callable.\n+\n+    An explicitly assigned partial docstring takes precedence. Otherwise,\n+    unwrap partial objects to avoid using ``functools.partial``'s generic\n+    documentation.\n+    \"\"\"\n+    documented_func = tool_func\n+\n+    while isinstance(documented_func, partial):\n+        if \"__doc__\" in vars(documented_func):\n+            return documented_func.__doc__ or \"\"\n+\n+        documented_func = documented_func.func\n+\n+    return documented_func.__doc__ or \"\"\n+\n+\n+def _resolve_annotation(\n+    annotation: Any,\n+    globalns: dict[str, Any] | None,\n+) -> Any:\n+    \"\"\"Resolve one annotation with the provided global namespace.\"\"\"\n+\n+    def _annotation_holder() -> None:\n+        pass\n+\n+    _annotation_holder.__annotations__ = {\n+        \"value\": annotation,\n+    }\n+    return typing.get_type_hints(\n+        _annotation_holder,\n+        globalns=globalns,\n+        include_extras=True,\n+    )[\"value\"]\n+\n+\n+def _resolve_partial_type_hints(\n+    partial_func: partial,\n+    globalns: dict[str, Any] | None,\n+) -> dict[str, Any]:\n+    \"\"\"Resolve each annotation on a partial independently.\"\"\"\n+    raw_annotations = getattr(\n+        partial_func,\n+        \"__annotations__\",\n+        {},\n+    )\n+    if not isinstance(raw_annotations, dict):\n+        return {}\n+\n+    type_hints = {}\n+    for name, annotation in raw_annotations.items():\n+        try:\n+            type_hints[name] = _resolve_annotation(\n+                annotation,\n+                globalns,\n+            )\n+        except Exception:\n+            continue\n+\n+    return type_hints\n+\n+\n+def _resolve_type_hints(tool_func: Callable) -> dict[str, Any]:\n+    \"\"\"Resolve and merge annotations from a callable and its partials.\n+\n+    Annotations are merged from the underlying callable to the outermost\n+    partial, allowing each partial to override selected annotations.\n+    \"\"\"\n+    partial_funcs = []\n+    annotated_func = tool_func\n+\n+    while isinstance(annotated_func, partial):\n+        partial_funcs.append(annotated_func)\n+        annotated_func = annotated_func.func\n+\n+    try:\n+        type_hints = typing.get_type_hints(\n+            annotated_func,\n+            include_extras=True,\n+        )\n+    except Exception:\n+        type_hints = {}\n+\n+    globalns = getattr(annotated_func, \"__globals__\", None)\n+\n+    for partial_func in reversed(partial_funcs):\n+        type_hints.update(\n+            _resolve_partial_type_hints(\n+                partial_func,\n+                globalns,\n+            ),\n+        )\n+\n+    return type_hints\n+\n+\n def _remove_title_field(schema: dict) -> dict:\n     \"\"\"Remove the title field from the JSON schema to avoid\n     misleading the LLM.\"\"\"\n@@ -95,18 +207,13 @@ def _extract_input_schema(\n         `dict`:\n             The extracted input JSON schema.\n     \"\"\"\n-    docstring = parse(tool_func.__doc__ or \"\")\n+    docstring = parse(_get_callable_docstring(tool_func))\n     params_docstring = {_.arg_name: _.description for _ in docstring.params}\n \n     # Under PEP 563 (`from __future__ import annotations`) the annotations\n     # in the signature are raw strings, which pydantic cannot resolve\n     # outside the function's own module. Resolve them here instead.\n-    try:\n-        type_hints = typing.get_type_hints(tool_func, include_extras=True)\n-    except Exception:\n-        # e.g. `functools.partial` objects, or annotations referencing\n-        # TYPE_CHECKING-only names; fall back to the raw annotations\n-        type_hints = {}\n+    type_hints = _resolve_type_hints(tool_func)\n \n     # Create a dynamic model with the function signature\n     fields = {}\n", "test_patch": "diff --git a/tests/tool_lazy_annotations_test.py b/tests/tool_lazy_annotations_test.py\nindex 6f4f50334e..8018177f98 100644\n--- a/tests/tool_lazy_annotations_test.py\n+++ b/tests/tool_lazy_annotations_test.py\n@@ -8,6 +8,7 @@\n \"\"\"\n from __future__ import annotations\n \n+from functools import partial\n from typing import Annotated\n from unittest import TestCase\n \n@@ -23,6 +24,12 @@ class Location(BaseModel):\n     city: str = Field(description=\"The city name\")\n \n \n+class SearchQuery(BaseModel):\n+    \"\"\"A structured catalog-search query.\"\"\"\n+\n+    text: str = Field(description=\"The query text\")\n+\n+\n def annotated_tool(\n     query: Annotated[str, Field(description=\"The search query\")],\n     limit: int = 5,\n@@ -44,6 +51,36 @@ def model_tool(location: Location) -> str:\n     return location.city\n \n \n+def catalog_search(\n+    catalog: str,\n+    query: Annotated[SearchQuery, Field(description=\"The search query\")],\n+    limit: Annotated[int, Field(gt=0, description=\"Maximum results\")] = 5,\n+) -> str:\n+    \"\"\"Search a catalog.\"\"\"\n+    return f\"{catalog}:{query.text}:{limit}\"\n+\n+\n+def documented_search(catalog: str, query: str) -> str:\n+    \"\"\"Search the selected catalog.\n+\n+    Args:\n+        catalog: The catalog identifier.\n+        query: The query to run.\n+    \"\"\"\n+    return f\"{catalog}:{query}\"\n+\n+\n+def primitive_parameter_with_unresolvable_return(value: int) -> str:\n+    \"\"\"Keep the parameter annotation usable when the return hint is not.\"\"\"\n+    return str(value)\n+\n+\n+primitive_parameter_with_unresolvable_return.__annotations__ = {\n+    \"value\": int,\n+    \"return\": \"NotDefined\",\n+}\n+\n+\n class LazyAnnotationsTest(TestCase):\n     \"\"\"Schema extraction must work with stringized annotations.\"\"\"\n \n@@ -143,3 +180,226 @@ def test_function_tool_registration(self) -> None:\n                 \"required\": [\"query\"],\n             },\n         )\n+\n+    def test_positional_partial_resolves_lazy_model_annotations(self) -> None:\n+        \"\"\"A partial keeps its signature while using its function's hints.\"\"\"\n+        tool_func = partial(catalog_search, \"catalog-a\")\n+        expected = {\n+            \"type\": \"object\",\n+            \"$defs\": {\n+                \"SearchQuery\": {\n+                    \"type\": \"object\",\n+                    \"description\": \"A structured catalog-search query.\",\n+                    \"properties\": {\n+                        \"text\": {\n+                            \"type\": \"string\",\n+                            \"description\": \"The query text\",\n+                        },\n+                    },\n+                    \"required\": [\"text\"],\n+                },\n+            },\n+            \"properties\": {\n+                \"query\": {\n+                    \"$ref\": \"#/$defs/SearchQuery\",\n+                    \"description\": \"The search query\",\n+                },\n+                \"limit\": {\n+                    \"type\": \"integer\",\n+                    \"exclusiveMinimum\": 0,\n+                    \"description\": \"Maximum results\",\n+                    \"default\": 5,\n+                },\n+            },\n+            \"required\": [\"query\"],\n+        }\n+\n+        self.assertDictEqual(_extract_input_schema(tool_func), expected)\n+        self.assertDictEqual(\n+            FunctionTool(tool_func, name=\"catalog_search\").input_schema,\n+            expected,\n+        )\n+\n+    def test_nested_partial_uses_remaining_keyword_default(self) -> None:\n+        \"\"\"Nested partials retain the signature-provided default.\"\"\"\n+        tool_func = partial(partial(catalog_search, \"catalog-a\"), limit=3)\n+        schema = _extract_input_schema(tool_func)\n+\n+        self.assertEqual(schema[\"required\"], [\"query\"])\n+        self.assertEqual(schema[\"properties\"][\"limit\"][\"default\"], 3)\n+        self.assertEqual(\n+            schema[\"properties\"][\"query\"][\"$ref\"],\n+            \"#/$defs/SearchQuery\",\n+        )\n+\n+    def test_partial_uses_its_own_annotations_before_underlying_function(\n+        self,\n+    ) -> None:\n+        \"\"\"Explicit annotations on a partial override its function hints.\"\"\"\n+        tool_func = partial(catalog_search, \"catalog-a\")\n+        tool_func.__annotations__ = {\"query\": str}\n+\n+        self.assertDictEqual(\n+            _extract_input_schema(tool_func),\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"query\": {\"type\": \"string\"},\n+                    \"limit\": {\n+                        \"type\": \"integer\",\n+                        \"exclusiveMinimum\": 0,\n+                        \"description\": \"Maximum results\",\n+                        \"default\": 5,\n+                    },\n+                },\n+                \"required\": [\"query\"],\n+            },\n+        )\n+\n+    def test_partial_keeps_valid_annotation_override(self) -> None:\n+        \"\"\"An invalid annotation does not discard valid overrides.\"\"\"\n+        tool_func = partial(catalog_search, \"catalog-a\")\n+        tool_func.__annotations__ = {\n+            \"query\": str,\n+            \"limit\": \"TotallyUnresolvable\",\n+        }\n+\n+        self.assertDictEqual(\n+            _extract_input_schema(tool_func),\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"query\": {\"type\": \"string\"},\n+                    \"limit\": {\n+                        \"type\": \"integer\",\n+                        \"exclusiveMinimum\": 0,\n+                        \"description\": \"Maximum results\",\n+                        \"default\": 5,\n+                    },\n+                },\n+                \"required\": [\"query\"],\n+            },\n+        )\n+\n+    def test_unresolvable_partial_annotation_keeps_function_hint(\n+        self,\n+    ) -> None:\n+        \"\"\"An invalid partial annotation does not replace valid hints.\"\"\"\n+        tool_func = partial(catalog_search, \"catalog-a\")\n+        tool_func.__annotations__ = {\n+            \"query\": \"TotallyUnresolvable\",\n+        }\n+\n+        self.assertDictEqual(\n+            _extract_input_schema(tool_func),\n+            {\n+                \"type\": \"object\",\n+                \"$defs\": {\n+                    \"SearchQuery\": {\n+                        \"type\": \"object\",\n+                        \"description\": \"A structured catalog-search query.\",\n+                        \"properties\": {\n+                            \"text\": {\n+                                \"type\": \"string\",\n+                                \"description\": \"The query text\",\n+                            },\n+                        },\n+                        \"required\": [\"text\"],\n+                    },\n+                },\n+                \"properties\": {\n+                    \"query\": {\n+                        \"$ref\": \"#/$defs/SearchQuery\",\n+                        \"description\": \"The search query\",\n+                    },\n+                    \"limit\": {\n+                        \"type\": \"integer\",\n+                        \"exclusiveMinimum\": 0,\n+                        \"description\": \"Maximum results\",\n+                        \"default\": 5,\n+                    },\n+                },\n+                \"required\": [\"query\"],\n+            },\n+        )\n+\n+    def test_partial_uses_underlying_function_name(self) -> None:\n+        \"\"\"A partial inherits its default tool name.\"\"\"\n+        tool = FunctionTool(\n+            partial(documented_search, \"catalog-a\"),\n+        )\n+\n+        self.assertEqual(tool.name, \"documented_search\")\n+\n+    def test_partial_uses_underlying_function_docstring(self) -> None:\n+        \"\"\"A partial inherits tool and parameter documentation.\"\"\"\n+        tool = FunctionTool(\n+            partial(documented_search, \"catalog-a\"),\n+            name=\"documented_search\",\n+        )\n+\n+        self.assertEqual(\n+            tool.description,\n+            \"Search the selected catalog.\",\n+        )\n+        self.assertDictEqual(\n+            tool.input_schema,\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"query\": {\n+                        \"type\": \"string\",\n+                        \"description\": \"The query to run.\",\n+                    },\n+                },\n+                \"required\": [\"query\"],\n+            },\n+        )\n+\n+    def test_partial_prefers_its_explicit_docstring(self) -> None:\n+        \"\"\"An explicitly assigned partial docstring takes precedence.\"\"\"\n+        tool_func = partial(documented_search, \"catalog-a\")\n+        tool_func.__doc__ = \"\"\"Search a custom catalog.\n+\n+        Args:\n+            query: The custom query to run.\n+        \"\"\"\n+        tool = FunctionTool(\n+            tool_func,\n+            name=\"documented_search\",\n+        )\n+\n+        self.assertEqual(\n+            tool.description,\n+            \"Search a custom catalog.\",\n+        )\n+        self.assertDictEqual(\n+            tool.input_schema,\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"query\": {\n+                        \"type\": \"string\",\n+                        \"description\": \"The custom query to run.\",\n+                    },\n+                },\n+                \"required\": [\"query\"],\n+            },\n+        )\n+\n+    def test_partial_falls_back_to_usable_raw_parameter_annotation(\n+        self,\n+    ) -> None:\n+        \"\"\"An unresolvable return hint does not discard a usable parameter.\"\"\"\n+        schema = _extract_input_schema(\n+            partial(primitive_parameter_with_unresolvable_return),\n+        )\n+\n+        self.assertDictEqual(\n+            schema,\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\"value\": {\"type\": \"integer\"}},\n+                \"required\": [\"value\"],\n+            },\n+        )\n", "problem_statement": "[Bug]: FunctionTool fails to infer schemas for partials with postponed custom annotations\n### Prerequisites\n\n- [x] I searched existing issues, pull requests, and discussions and found no matching report.\n- [x] This report includes an offline reproduction of a schema-construction failure.\n\n### Background / Description\n\n`FunctionTool` cannot infer the input schema of an explicitly named `functools.partial` when the underlying function uses postponed annotations and a custom Pydantic parameter type.\n\nA use case is prebinding a catalog name while leaving a structured search query as the tool's remaining input. The ordinary function and an equivalent eagerly annotated partial construct schemas successfully; the postponed-annotation partial raises `PydanticUserError` during construction, before any tool or model call.\n\nThis appears to be an uncovered combination in the annotation-resolution path added by #2371, rather than a regression introduced by that PR. `_extract_input_schema()` calls `typing.get_type_hints()` on the partial object, catches its `TypeError`, and falls back to the raw signature annotations. The remaining `SearchQuery` annotation is therefore a string that the generated Pydantic model cannot resolve.\n\n### Steps to Reproduce\n\nInstall the source checkout with its base dependencies (`python -m pip install -e .`), save the following as `repro.py`, and run `python repro.py`. No optional model provider, API key, or external service is required.\n\n```python\nfrom __future__ import annotations\n\nfrom functools import partial\n\nfrom pydantic import BaseModel\n\nfrom agentscope.tool import FunctionTool\n\n\nclass SearchQuery(BaseModel):\n    text: str\n\n\ndef search_catalog(catalog: str, query: SearchQuery) -> str:\n    return f\"{catalog}:{query.text}\"\n\n\nFunctionTool(partial(search_catalog, \"catalog-a\"), name=\"search_catalog\")\n```\n\n### Error Messages\n\nThe constructor reaches `_extract_input_schema()` and fails at `base_model.model_json_schema()`:\n\n```text\npydantic.errors.PydanticUserError: `_StructuredOutputDynamicClass` is not fully defined; you should define `SearchQuery`, then call `_StructuredOutputDynamicClass.model_rebuild()`.\n```\n\nThe standalone reproduction exits 1. An explicit nonempty tool name is provided, so this is separate from a partial lacking `__name__`.\n\n### Expected Behavior / Proposed Scope\n\nI would expect schema inference to expose only the remaining `query` parameter, with its `SearchQuery` definition, consistently with the successful eager-partial case. The already-bound `catalog` parameter should stay absent.\n\nWould this be an appropriate follow-up to #2371? If this combination is intended to be supported, I would like to contribute a focused fix that resolves annotations from the underlying function while retaining the partial's signature, plus regression coverage for the remaining parameters and model definition. No implementation has been started.\n\nRelated open PR #2756 adds a separate `preset_kwargs` API; its current diff does not change `_extract_input_schema()` or address annotation resolution for an existing partial.\n\n### Verification / Environment\n\n- AgentScope `2.0.10dev`, main at `e4c1e074dee3f0f6cca28ca29e934c4ec0605354`.\n- Windows, Python 3.11.9, Pydantic 2.13.5; import paths verified against this checkout.\n- Three offline controls passed: an ordinary postponed-annotation function with the custom model; an explicitly named partial with a postponed `int` annotation; an eagerly annotated partial with the same custom model.\n- Both direct schema extraction and the explicitly named `FunctionTool` reproduce the same unresolved-custom-type error.\n- Existing `tests/tool_lazy_annotations_test.py`: **4 passed**.\n- Checked on 2026-10-12. Function invocation, alternate Python/Pydantic versions, and the full test suite were not tested.\n\nCodex assisted with source inspection, reproduction, and this report. The proposed combined behavior still needs maintainer confirmation.\n\n", "hints_text": "/assign\n\nIt's yours, @shuxiachai. If there is no pull request and no word from you by 2026-10-26 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-12T02:30:45Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3254, "instance_id": "agentscope-ai__agentscope-3254", "issue_numbers": ["3252"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/workspace/_base.py b/src/agentscope/workspace/_base.py\nindex 2f782ceba0..46ad4fb55d 100644\n--- a/src/agentscope/workspace/_base.py\n+++ b/src/agentscope/workspace/_base.py\n@@ -1053,6 +1053,11 @@ async def offload_context(\n                 msg.content = content\n             lines.append(msg.model_dump_json())\n \n+        if not lines:\n+            # Nothing to append: writing the empty join would still add a\n+            # standalone blank line that is not a JSONL record.\n+            return path\n+\n         payload = \"\\n\".join(lines) + \"\\n\"\n \n         existing = b\"\"\n", "test_patch": "diff --git a/tests/workspace_local_test.py b/tests/workspace_local_test.py\nindex 725918a910..005a9e4b6a 100644\n--- a/tests/workspace_local_test.py\n+++ b/tests/workspace_local_test.py\n@@ -266,6 +266,27 @@ async def test_offload_context_multiple_calls(self) -> None:\n             msg = Msg.model_validate_json(line)\n             self.assertIsNotNone(msg)\n \n+    async def test_offload_context_empty_msgs_appends_nothing(self) -> None:\n+        \"\"\"Offloading an empty batch must not append a blank JSONL line.\n+\n+        The empty join used to be written as a standalone ``\\\\n``, which\n+        is not a JSON record and broke every line-oriented consumer of\n+        ``context.jsonl``.\n+        \"\"\"\n+        session_id = \"test_session_empty_batch\"\n+        msgs1 = [UserMsg(name=\"user\", content=\"First message\")]\n+        file_path = await self.workspace.offload_context(session_id, msgs1)\n+        await self.workspace.offload_context(session_id, [])\n+\n+        async with aiofiles.open(file_path, \"rb\") as f:\n+            content = await f.read()\n+\n+        self.assertFalse(content.endswith(b\"\\n\\n\"))\n+        for line in content.decode(\"utf-8\").splitlines():\n+            self.assertTrue(line.strip())\n+            Msg.model_validate_json(line)\n+            json.loads(line)\n+\n     async def test_offload_context_with_datablock(self) -> None:\n         \"\"\"Test offloading messages with DataBlock content.\n \n", "problem_statement": "[Bug]: offload_context with an empty batch appends a blank line that breaks context.jsonl\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`WorkspaceBase.offload_context` builds `payload = \"\n\".join(lines) + \"\n\"` and appends it unconditionally. With an empty `msgs` batch the payload is a standalone `\"\n\"` -- a blank line that is not a JSONL record -- and it is appended to `context.jsonl`.\n\nThe docstring contract is \"appends every message in `msgs` (one message per JSONL line)\"; an empty batch appends zero bytes. The internal agent caller guards `len(msgs) == 0`, but `offload_context` is a public `Offloader`-protocol method that SDK consumers can call with any batch, and any line-oriented consumer of `context.jsonl` then fails:\n\n```\nafter 1 msg : b'{...}\n'\nafter empty : b'{...}\n\n'      <- blank line appended\njson.loads('')  -> JSONDecodeError: Expecting value: line 1 column 1\n```\n\n### Steps to Reproduce\n\n```python\nimport asyncio, tempfile\nfrom agentscope.message import Msg, TextBlock\nfrom agentscope.workspace import LocalWorkspace\n\nasync def main():\n    with tempfile.TemporaryDirectory() as td:\n        ws = LocalWorkspace(workdir=td)\n        p = await ws.offload_context(\"s1\", [Msg(name=\"user\", role=\"user\", content=[TextBlock(text=\"hello\")])])\n        await ws.offload_context(\"s1\", [])\n        print(repr(open(p, \"rb\").read()[-4:]))   # b'\n\n' appended\n\nasyncio.run(main())\n```\n\nNo API key or external service needed.\n\n### Expected Behavior\n\nAn empty batch appends nothing: the file keeps one JSON record per line and stays parseable.\n\nI have a small fix plus a regression test verified locally and would like to submit a PR for this issue.\n\n", "hints_text": "", "created_at": "2026-10-11T17:43:40Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3250, "instance_id": "agentscope-ai__agentscope-3250", "issue_numbers": ["3258"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/formatter/_anthropic_formatter.py b/src/agentscope/formatter/_anthropic_formatter.py\nindex 956eb88e8f..71003c3eaf 100644\n--- a/src/agentscope/formatter/_anthropic_formatter.py\n+++ b/src/agentscope/formatter/_anthropic_formatter.py\n@@ -4,6 +4,7 @@\n import fnmatch\n from abc import ABC\n from typing import Any\n+from urllib.request import url2pathname\n \n import requests\n from pydantic import Field\n@@ -337,7 +338,10 @@ def _format_source(\n         elif isinstance(source, URLSource):\n             url = str(source.url)\n             if url.startswith(\"file://\"):\n-                with open(url.removeprefix(\"file://\"), \"rb\") as f:\n+                with open(\n+                    url2pathname(url.removeprefix(\"file://\")),\n+                    \"rb\",\n+                ) as f:\n                     data = base64.b64encode(f.read()).decode(\"utf-8\")\n             else:\n                 response = requests.get(url, timeout=30)\ndiff --git a/src/agentscope/formatter/_dashscope_formatter.py b/src/agentscope/formatter/_dashscope_formatter.py\nindex 9ea0a2acc7..9ee200f788 100644\n--- a/src/agentscope/formatter/_dashscope_formatter.py\n+++ b/src/agentscope/formatter/_dashscope_formatter.py\n@@ -5,6 +5,7 @@\n from typing import Any\n from fnmatch import fnmatch\n from abc import ABC\n+from urllib.request import url2pathname\n \n from pydantic import Field\n \n@@ -125,7 +126,7 @@ def _format_image_source(\n         elif isinstance(source, URLSource):\n             url_str = str(source.url)\n             if url_str.startswith(\"file://\"):\n-                local_path = url_str.removeprefix(\"file://\")\n+                local_path = url2pathname(url_str.removeprefix(\"file://\"))\n                 with open(local_path, \"rb\") as f: