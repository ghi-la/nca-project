    source=URLSource(\n+                                    url=path.as_uri(),\n+                                    media_type=\"audio/wav\",\n+                                ),\n+                            ),\n+                        ],\n+                    ),\n+                ],\n+            )\n+        self.assertEqual(\n+            res[0][\"content\"][0],\n+            {\n+                \"type\": \"input_audio\",\n+                \"input_audio\": {\n+                    \"data\": expected_b64,\n+                    \"format\": \"wav\",\n+                },\n+            },\n+        )\n+\n+    async def test_chat_formatter_percent_encoded_local_file(self) -> None:\n+        \"\"\"Local file:// PDF paths with spaces and '#' are decoded.\"\"\"\n+        file_bytes = b\"spaced-name-bytes\"\n+        expected_b64 = base64.b64encode(file_bytes).decode(\"utf-8\")\n+        with tempfile.TemporaryDirectory() as temp_dir:\n+            path = Path(temp_dir) / \"my file #1.pdf\"\n+            path.write_bytes(file_bytes)\n+            fmt = OpenAIChatFormatter()\n+            res = await fmt.format(\n+                [\n+                    UserMsg(\n+                        name=\"user\",\n+                        content=[\n+                            DataBlock(\n+                                source=URLSource(\n+                                    url=path.as_uri(),\n+                                    media_type=\"application/pdf\",\n+                                ),\n+                                name=\"my file #1.pdf\",\n+                            ),\n+                        ],\n+                    ),\n+                ],\n+            )\n+        self.assertEqual(\n+            res[0][\"content\"][0][\"file\"][\"file_data\"],\n+            f\"data:application/pdf;base64,{expected_b64}\",\n+        )\n+\n     async def test_chat_formatter_base64_pdf(self) -> None:\n         \"\"\"Base64-encoded PDF becomes a ``file`` content part.\"\"\"\n         fmt = OpenAIChatFormatter()\ndiff --git a/tests/formatter_xai_test.py b/tests/formatter_xai_test.py\nindex f3d2166a35..5cb2e17505 100644\n--- a/tests/formatter_xai_test.py\n+++ b/tests/formatter_xai_test.py\n@@ -7,7 +7,10 @@\n without the real package.  The stub objects support __eq__ and __repr__ so\n full assertListEqual comparisons work.\n \"\"\"\n+import base64\n import sys\n+import tempfile\n+from pathlib import Path\n from typing import Any\n from types import ModuleType\n from unittest import IsolatedAsyncioTestCase\n@@ -277,6 +280,40 @@ async def test_chat_formatter_user_assistant(self) -> None:\n             res,\n         )\n \n+    async def test_chat_formatter_percent_encoded_local_image(self) -> None:\n+        \"\"\"Local file:// image paths with spaces and '#' are decoded.\"\"\"\n+        image_bytes = b\"spaced-name-bytes\"\n+        expected_b64 = base64.b64encode(image_bytes).decode(\"utf-8\")\n+        with tempfile.TemporaryDirectory() as temp_dir:\n+            path = Path(temp_dir) / \"my file #1.png\"\n+            path.write_bytes(image_bytes)\n+            fmt = XAIChatFormatter()\n+            res = await fmt.format(\n+                [\n+                    UserMsg(\n+                        name=\"user\",\n+                        content=[\n+                            TextBlock(text=\"What's in this image?\"),\n+                            DataBlock(\n+                                source=URLSource(\n+                                    url=path.as_uri(),\n+                                    media_type=\"image/png\",\n+                                ),\n+                            ),\n+                        ],\n+                    ),\n+                ],\n+            )\n+        self.assertListEqual(\n+            [\n+                user(\n+                    \"What's in this image?\",\n+                    image(f\"data:image/png;base64,{expected_b64}\"),\n+                ),\n+            ],\n+            res,\n+        )\n+\n     async def test_chat_formatter_tool_call(self) -> None:\n         \"\"\"Assistant tool call becomes a _MessageProto with tool_calls set.\"\"\"\n         fmt = XAIChatFormatter()\n", "problem_statement": "[Bug]: Formatters cannot open local files whose names contain spaces (percent-encoded file:// paths are not decoded)\n## Prerequisites\n\n- [x] I have searched the existing issues and discussions, and this is not a duplicate. (#3104 reports the same problem for the Ollama formatter only; this issue covers the other formatters.)\n- [x] This is a bug, not a usage question.\n\n## Background / Description\n\n`URLSource` stores its URL as a pydantic `AnyUrl`, which percent-encodes characters such as spaces, `#` and `%`. A local image `/tmp/my file.png` passed as `Path(\"/tmp/my file.png\").as_uri()` is stored as `file:///tmp/my%20file.png`.\n\nWhen a formatter inlines a local file, it strips the `file://` prefix and passes the remaining, still-encoded path straight to `open()`. It therefore looks for `/tmp/my%20file.png`, which does not exist, and formatting fails before any request is sent.\n\nExpected: the formatter reads the existing file and includes its base64 data, just as it does for a file name without special characters.\n\nActual: `FileNotFoundError` for the encoded path.\n\nThe same pattern is used for local images, audio, video and files in the OpenAI, Anthropic, Gemini, xAI, Moonshot and DashScope formatters. (The Ollama formatter has the same bug and is tracked in #3104.)\n\n## Error Messages\n\n```shell\nTraceback (most recent call last):\n  ...\n  File \"src/agentscope/formatter/_openai_formatter.py\", line 284, in format\n    formatted = self._format_openai_data_block(\n  File \"src/agentscope/formatter/_openai_formatter.py\", line 64, in _format_openai_data_block\n    return self._format_image_source(block.source)\n  File \"src/agentscope/formatter/_openai_formatter.py\", line 107, in _format_image_source\n    with open(local_path, \"rb\") as f:\nFileNotFoundError: [Errno 2] No such file or directory: '/tmp/tmpuwrf1pt4/my%20file.png'\n```\n\n## Steps to Reproduce\n\n1. Code (no model, API key or network needed):\n\n```python\nimport asyncio, tempfile\nfrom pathlib import Path\nfrom agentscope.message import UserMsg, DataBlock, URLSource\nfrom agentscope.formatter import OpenAIChatFormatter\n\n# 1x1 PNG\nPNG = bytes.fromhex(\n    \"89504e470d0a1a0a0000000d4948445200000001000000010806000000\"\n    \"1f15c4890000000d49444154789c6360000002000154a24f5d0000000049454e44ae426082\"\n)\n\nasync def main():\n    path = Path(tempfile.mkdtemp()) / \"my file.png\"\n    path.write_bytes(PNG)\n    src = URLSource(url=path.as_uri(), media_type=\"image/png\")\n    print(\"stored url:\", src.url)  # file:///tmp/.../my%20file.png\n    msg = UserMsg(name=\"user\", content=[DataBlock(source=src)])\n    await OpenAIChatFormatter().format([msg])\n    print(\"ok\")\n\nasyncio.run(main())\n```\n\n2. Run: `python reproduce.py`\n3. See `FileNotFoundError` for `.../my%20file.png`. Renaming the file to `my_file.png` makes it work.\n\nA possible fix is to convert the part after `file://` with `urllib.request.url2pathname` before opening it. On POSIX that is the same as `urllib.parse.unquote`, and on Windows it also turns `/C:/Users/.../my%20file.png` into a valid `C:\\Users\\...\\my file.png`.\n\n## Environment\n\n- AgentScope Version: 2.0.10dev (main at `654738c3`)\n- Python Version: 3.12.14\n- OS: Linux x86_64\n\n", "hints_text": "", "created_at": "2026-10-11T17:17:36Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3242, "instance_id": "agentscope-ai__agentscope-3242", "issue_numbers": ["3245"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/_utils/_audio.py b/src/agentscope/_utils/_audio.py\nindex c232006c77..5019623c81 100644\n--- a/src/agentscope/_utils/_audio.py\n+++ b/src/agentscope/_utils/_audio.py\n@@ -92,3 +92,38 @@ def _build_wav_header(\n         channels,\n         bits_per_sample,\n     )\n+\n+\n+def _finalize_streaming_wav(wav_bytes: bytes) -> bytes:\n+    \"\"\"Declare real chunk sizes in a complete WAV built for streaming.\n+\n+    A buffer assembled from streaming deltas starts with the placeholder\n+    header from :func:`_build_streaming_wav_header`. Once the buffer is\n+    complete, the RIFF and ``data`` chunk sizes are rewritten with the real\n+    values, so the result is a well-formed WAV just like\n+    :func:`_build_wav_header` produces. Only the canonical 44-byte layout\n+    emitted by :func:`_build_streaming_wav_header` is rewritten; other RIFF\n+    layouts are returned unchanged.\n+\n+    Args:\n+        wav_bytes (`bytes`):\n+            The complete buffer assembled from the stream deltas.\n+\n+    Returns:\n+        `bytes`:\n+            The buffer with real chunk sizes in its WAV header.\n+    \"\"\"\n+    placeholder_size = struct.pack(\"<I\", 0xFFFFFFFF)\n+    if (\n+        len(wav_bytes) >= 44\n+        and wav_bytes[:4] == b\"RIFF\"\n+        and wav_bytes[4:8] == placeholder_size\n+        and wav_bytes[8:20] == b\"WAVEfmt \" + struct.pack(\"<I\", 16)\n+        and wav_bytes[36:44] == b\"data\" + placeholder_size\n+    ):\n+        data_len = len(wav_bytes) - 44\n+        finalized = bytearray(wav_bytes)\n+        struct.pack_into(\"<I\", finalized, 4, 36 + data_len)\n+        struct.pack_into(\"<I\", finalized, 40, data_len)\n+        return bytes(finalized)\n+    return wav_bytes\ndiff --git a/src/agentscope/model/_utils.py b/src/agentscope/model/_utils.py\nindex 10cf74a779..de7b003ef0 100644\n--- a/src/agentscope/model/_utils.py\n+++ b/src/agentscope/model/_utils.py\n@@ -8,6 +8,7 @@\n from ._model_response import ChatResponse, FinishedReason\n from ._model_usage import ChatUsage\n from .._logging import logger\n+from .._utils._audio import _finalize_streaming_wav\n from ..message import (\n     Base64Source,\n     DataBlock,\n@@ -125,8 +126,13 @@ def append(self, source: Base64Source) -> None:\n \n     def build(self) -> Base64Source:\n         \"\"\"Join the raw bytes and base64-encode them once.\"\"\"\n+        data = b\"\".join(self.data)\n+        if self.media_type == \"audio/wav\":\n+            # The stream began with the placeholder WAV header; now that\n+            # the buffer is complete, declare its real chunk sizes.\n+            data = _finalize_streaming_wav(data)\n         return Base64Source(\n-            data=base64.b64encode(b\"\".join(self.data)).decode(\"ascii\"),\n+            data=base64.b64encode(data).decode(\"ascii\"),\n             media_type=self.media_type,\n         )\n \n", "test_patch": "diff --git a/tests/model_base_test.py b/tests/model_base_test.py\nindex a79c3069de..83b712c942 100644\n--- a/tests/model_base_test.py\n+++ b/tests/model_base_test.py\n@@ -3,6 +3,7 @@\n retry / accumulation / interrupt wrapper around ``_call_api``.\"\"\"\n import asyncio\n import base64\n+import struct\n from typing import Any\n from unittest.async_case import IsolatedAsyncioTestCase\n \n@@ -873,6 +874,74 @@ async def test_stream_audio_data_block_accumulation(self) -> None:\n             ),\n         )\n \n+    async def test_stream_extended_wav_header_is_preserved(self) -> None:\n+        \"\"\"A non-canonical WAV chunk layout must not be rewritten.\"\"\"\n+        pcm = bytes([1, 2, 3, 4])\n+        extended_wav = (\n+            b\"RIFF\"\n+            + b\"\\xff\" * 4\n+            + b\"WAVE\"\n+            + b\"fmt \"\n+            + struct.pack(\n+                \"<IHHIIHHH\",\n+                18,\n+                1,\n+                1,\n+                24000,\n+                48000,\n+                2,\n+                16,\n+                0,\n+            )\n+            + b\"data\"\n+            + b\"\\xff\" * 4\n+            + pcm\n+        )\n+        deltas = [\n+            ChatResponse(\n+                content=[\n+                    DataBlock(\n+                        id=\"audio-1\",\n+                        source=Base64Source(\n+                            data=base64.b64encode(extended_wav).decode(\n+                                \"ascii\",\n+                            ),\n+                            media_type=\"audio/wav\",\n+                        ),\n+                    ),\n+                ],\n+                is_last=False,\n+            ),\n+        ]\n+        self.model.set_responses([deltas])\n+\n+        gen = await self.model(messages=self.messages)\n+        last_chunk = None\n+        async for chunk in gen:\n+            last_chunk = chunk\n+\n+        self.assertDictEqual(\n+            _dump(last_chunk),\n+            _expected(\n+                content=[\n+                    {\n+                        \"type\": \"data\",\n+                        \"id\": \"audio-1\",\n+                        \"source\": {\n+                            \"type\": \"base64\",\n+                            \"data\": base64.b64encode(extended_wav).decode(\n+                                \"ascii\",\n+                            ),\n+                            \"media_type\": \"audio/wav\",\n+                        },\n+                        \"name\": None,\n+                    },\n+                ],\n+                is_last=True,\n+                finished_reason=FinishedReason.COMPLETED,\n+            ),\n+        )\n+\n     # ------------------------------------------------------------------\n     # 11) stream non-audio data block \u2014 the latest delta wins\n     # ------------------------------------------------------------------\ndiff --git a/tests/model_dashscope_test.py b/tests/model_dashscope_test.py\nindex 89c31de246..18d560a87b 100644\n--- a/tests/model_dashscope_test.py\n+++ b/tests/model_dashscope_test.py\n@@ -6,6 +6,7 @@\n \"\"\"\n import base64\n import io\n+import struct\n import wave\n from typing import Any\n import unittest\n@@ -574,10 +575,19 @@ async def test_stream_audio_response(\n             b for b in final.content if isinstance(b, DataBlock)\n         )\n         wav_bytes = base64.b64decode(final_audio.source.data)\n+        self.assertEqual(\n+            struct.unpack(\"<I\", wav_bytes[4:8])[0],\n+            36 + len(pcm_full),\n+        )\n+        self.assertEqual(\n+            struct.unpack(\"<I\", wav_bytes[40:44])[0],\n+            len(pcm_full),\n+        )\n         with wave.open(io.BytesIO(wav_bytes), \"rb\") as wav:\n             self.assertEqual(wav.getnchannels(), 1)\n             self.assertEqual(wav.getsampwidth(), 2)\n             self.assertEqual(wav.getframerate(), 24000)\n+            self.assertEqual(wav.getnframes(), len(pcm_full) // 2)\n             frames = wav.readframes(wav.getnframes())\n         self.assertEqual(frames, pcm_full)\n \ndiff --git a/tests/model_openai_chat_test.py b/tests/model_openai_chat_test.py\nindex 004f7282ac..2a4804b374 100644\n--- a/tests/model_openai_chat_test.py\n+++ b/tests/model_openai_chat_test.py\n@@ -795,10 +795,19 @@ async def test_stream_audio_response(\n             b for b in final.content if isinstance(b, DataBlock)\n         )\n         wav_bytes = base64.b64decode(final_audio.source.data)\n+        self.assertEqual(\n+            struct.unpack(\"<I\", wav_bytes[4:8])[0],\n+            36 + len(pcm_full),\n+        )\n+        self.assertEqual(\n+            struct.unpack(\"<I\", wav_bytes[40:44])[0],\n+            len(pcm_full),\n+        )\n         with wave.open(io.BytesIO(wav_bytes), \"rb\") as wav:\n             self.assertEqual(wav.getnchannels(), 1)\n             self.assertEqual(wav.getsampwidth(), 2)\n             self.assertEqual(wav.getframerate(), 24000)\n+            self.assertEqual(wav.getnframes(), len(pcm_full) // 2)\n             frames = wav.readframes(wav.getnframes())\n         self.assertEqual(frames, pcm_full)\n \n", "problem_statement": "Streaming audio: final audio block keeps the streaming WAV header's 0xFFFFFFFF placeholder sizes\n**Describe the bug**\n\nIn streaming mode, the final `is_last` audio `DataBlock` of a response keeps the streaming WAV header's placeholder sizes \u2014 RIFF and `data` chunk sizes of `0xFFFFFFFF` \u2014 instead of the real chunk sizes, so the completed audio block is not a well-formed WAV and disagrees with what the non-streaming path produces for the same call. Consumers that trust the header (`wave.getnframes()`, duration, seeking, strict players) see 4294967295 instead of the actual audio length.\n\n**Root cause**\n\n`_build_streaming_wav_header()` (`src/agentscope/_utils/_audio.py:47-73`) deliberately sets the RIFF and `data` chunk sizes to `0xFFFFFFFF` since the total length isn't known while streaming, and its docstring states: \"For a *complete* buffer use `_build_wav_header` instead, which declares real chunk sizes\".\n\nBoth streaming parsers prefix only the **first** audio delta with that header:\n\n- `src/agentscope/model/_openai_chat/_model.py:412`\n- `src/agentscope/model/_dashscope/_model.py:412`\n\nThe stream accumulator then joins the deltas verbatim into the final `is_last` block, so the completed artifact keeps the placeholder sizes. The non-streaming path already wraps the payload in a real header (`src/agentscope/model/_openai_chat/_model.py:519`), so for the same request streaming and non-streaming responses disagree: one is a playable WAV, the other is not.\n\n**To reproduce**\n\n1. Run any streaming request that returns audio through the OpenAI chat or DashScope streaming parser (e.g. an omni-style model streamed via `stream()`).\n2. Inspect the final `is_last` audio `DataBlock` with `wave.open` / `wave.getnframes()`.\n3. The header claims 4294967295 frames; the same request served non-streaming yields a well-formed WAV with the real length.\n\n**Expected behavior**\n\nThe final streamed audio block should be finalized into a well-formed WAV (real RIFF/data sizes), matching the non-streaming path for the same call, e.g. by rewriting the header sizes once the accumulated payload is complete.\n\n**Environment**\n\n- agentscope: main @ e4c1e074 (2.0.10dev)\n- Python 3.13\n- macOS\n\n", "hints_text": "", "created_at": "2026-10-11T11:39:50Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3231, "instance_id": "agentscope-ai__agentscope-3231", "issue_numbers": ["3230"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/model/_gemini/_model.py b/src/agentscope/model/_gemini/_model.py\nindex 9c41b76ce2..1eba8481ac 100644\n--- a/src/agentscope/model/_gemini/_model.py\n+++ b/src/agentscope/model/_gemini/_model.py\n@@ -285,7 +285,7 @@ async def _call_api(\n         \"\"\"\n         formatted_messages = await self.formatter.format(messages)\n \n-        config: dict[str, Any] = {**config_kwargs}\n+        config: dict[str, Any] = {}\n \n         if self.parameters.max_tokens is not None:\n             config[\"max_output_tokens\"] = self.parameters.max_tokens\n@@ -307,6 +307,9 @@ async def _call_api(\n                 \"thinking_budget\": 0,\n             }\n \n+        # Per-call config takes precedence over model-level defaults.\n+        config.update(config_kwargs)\n+\n         fmt_tools, fmt_tool_choice = self._format_tools(tools, tool_choice)\n \n         if fmt_tools is not None:\n", "test_patch": "diff --git a/tests/model_gemini_test.py b/tests/model_gemini_test.py\nindex df5fde2f47..ea87c3f884 100644\n--- a/tests/model_gemini_test.py\n+++ b/tests/model_gemini_test.py\n@@ -152,6 +152,47 @@ async def test_text_response(self) -> None:\n             ),\n         )\n \n+    async def test_call_config_overrides_parameter_defaults(self) -> None:\n+        \"\"\"Per-call config overrides model-level defaults.\"\"\"\n+        self.model.parameters.max_tokens = 1024\n+        self.model.parameters.temperature = 0.2\n+        self.model.parameters.top_p = 0.3\n+        self.mock_client.aio.models.generate_content = AsyncMock(\n+            return_value=_mock_completion([_make_part(text=\"ok\")]),\n+        )\n+\n+        default_config = {\n+            \"max_output_tokens\": 1024,\n+            \"temperature\": 0.2,\n+            \"top_p\": 0.3,\n+            \"thinking_config\": {\n+                \"include_thoughts\": False,\n+                \"thinking_budget\": 0,\n+            },\n+        }\n+        cases = {\n+            \"max_output_tokens\": 2048,\n+            \"temperature\": 0.8,\n+            \"top_p\": 0.9,\n+            \"thinking_config\": {\n+                \"include_thoughts\": True,\n+                \"thinking_budget\": 8192,\n+            },\n+        }\n+\n+        for key, value in cases.items():\n+            with self.subTest(key=key):\n+                await self.model([], **{key: value})\n+\n+                call_args = (\n+                    self.mock_client.aio.models.generate_content.call_args\n+                )\n+                sent_config = call_args.kwargs[\"config\"]\n+                self.assertEqual(\n+                    sent_config,\n+                    {**default_config, key: value},\n+                )\n+\n     async def test_tool_call_response(self) -> None:\n         \"\"\"Non-stream tool call response creates ToolCallBlocks.\"\"\"\n         parts = [\n", "problem_statement": "[Bug]: GeminiChatModel overwrites a caller-provided thinking_config with the opposite values\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`GeminiChatModel._call_api` seeds `config` from the caller's `config_kwargs` but then unconditionally overwrites `config[\"thinking_config\"]` from the model parameters. A caller who passes their own `thinking_config` therefore reaches the API with different values \u2014 in the worst case the exact opposite of what they asked for:\n\n```python\nawait model(messages, thinking_config={\"include_thoughts\": True, \"thinking_budget\": 8192})\n# actually sent: config[\"thinking_config\"] == {\"include_thoughts\": False, \"thinking_budget\": 0}\n```\n\nEvery other thinking-capable provider treats caller kwargs as authoritative \u2014 Anthropic guards with `if \"thinking\" not in kwargs`, OpenAI chat applies defaults before caller kwargs, and Moonshot/Volcengine merge caller values over defaults (fixed in #2915). Gemini is the only one that force-injects, the same class of problem as the DashScope `enable_thinking` force-injection tracked in #3192.\n\n### Steps to Reproduce\n\n1. Create a `GeminiChatModel` and call it with `thinking_config={\"include_thoughts\": True, \"thinking_budget\": 8192}` (no network needed; inspect the captured `generate_content` kwargs with a mock client)\n2. `config[\"thinking_config\"]` arrives as `{\"include_thoughts\": False, \"thinking_budget\": 0}`\n\n### Expected Behavior\n\nA caller-provided `thinking_config` is sent as-is; the parameter-derived default only applies when the caller did not pass one.\n\nI have a small fix plus regression tests verified locally and would like to submit a PR for this issue.\n\n", "hints_text": "", "created_at": "2026-10-10T16:15:28Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3229, "instance_id": "agentscope-ai__agentscope-3229", "issue_numbers": ["3228"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/model/_openai_response/_model.py b/src/agentscope/model/_openai_response/_model.py\nindex b30bbe7d1d..2d74d57a91 100644\n--- a/src/agentscope/model/_openai_response/_model.py\n+++ b/src/agentscope/model/_openai_response/_model.py\n@@ -287,6 +287,8 @@ async def _parse_stream_response(\n         # so subsequent argument deltas can be routed to the right tool\n         # call block.\n         tool_call_mapping: dict = OrderedDict()\n+        # The item ids of the function calls that received argument text\n+        tool_calls_with_input: set[str] = set()\n \n         async with response as stream:\n             async for event in stream:\n@@ -356,7 +358,8 @@ async def _parse_stream_response(\n                         # Only record the mapping here \u2014 do NOT emit an\n                         # empty-input delta so downstream consumers don't see\n                         # a leading no-op chunk. The block is created on the\n-                        # first argument delta below.\n+                        # first argument delta below, or on the arguments-done\n+                        # event when the call carries no arguments at all.\n                         tool_call_mapping[item.id] = (\n                             item.call_id,\n                             getattr(item, \"name\", \"\") or \"unknown\",\n@@ -364,12 +367,29 @@ async def _parse_stream_response(\n \n                 elif event_type == \"response.function_call_arguments.delta\":\n                     item_id = event.item_id\n-                    if item_id in tool_call_mapping:\n+                    if item_id in tool_call_mapping and event.delta:\n                         call_id, name = tool_call_mapping[item_id]\n+                        tool_calls_with_input.add(item_id)\n                         delta_res.append_tool_call(\n                             block_id=call_id,\n                             name=name,\n-                            input=event.delta or \"\",\n+                            input=event.delta,\n+                        )\n+\n+                elif event_type == \"response.function_call_arguments.done\":\n+                    # A call without arguments streams no argument deltas, so\n+                    # the block would never be created above; close it with\n+                    # the empty object the non-streaming response carries.\n+                    item_id = event.item_id\n+                    if (\n+                        item_id in tool_call_mapping\n+                        and item_id not in tool_calls_with_input\n+                    ):\n+                        call_id, name = tool_call_mapping[item_id]\n+                        delta_res.append_tool_call(\n+                            block_id=call_id,\n+                            name=name,\n+                            input=event.arguments or \"{}\",\n                         )\n \n                 elif event_type == \"response.completed\":\n", "test_patch": "diff --git a/tests/model_openai_response_test.py b/tests/model_openai_response_test.py\nindex 0a7da8430a..b6788e68dc 100644\n--- a/tests/model_openai_response_test.py\n+++ b/tests/model_openai_response_test.py\n@@ -1388,6 +1388,106 @@ async def test_stream_function_call(\n             ],\n         )\n \n+    async def test_stream_function_call_without_arguments(self) -> None:\n+        \"\"\"A function call with no arguments still streams as a {} block.\n+\n+        Empty-argument calls may emit no argument delta or an empty one, so\n+        the block used to be dropped entirely instead of matching the\n+        non-streaming ``input or \"{}\"`` result.\n+        \"\"\"\n+        fc_item = MagicMock()\n+        fc_item.type = \"function_call\"\n+        fc_item.id = \"fc_1\"\n+        fc_item.call_id = \"call-1\"\n+        fc_item.name = \"get_current_time\"\n+        fc_item.arguments = \"\"\n+\n+        completed_resp = MagicMock()\n+        completed_resp.id = \"resp-4\"\n+        completed_resp.output = []\n+        completed_resp.usage = MagicMock()\n+        completed_resp.usage.input_tokens = 10\n+        completed_resp.usage.output_tokens = 5\n+        completed_resp.usage.input_tokens_details = None\n+\n+        non_stream_model = _make_model(stream=False)\n+        non_stream_model.client = self.mock_client\n+        non_stream_resp = _mock_completion(\n+            function_calls=[\n+                {\n+                    \"id\": \"fc_1\",\n+                    \"call_id\": \"call-1\",\n+                    \"name\": \"get_current_time\",\n+                    \"arguments\": \"\",\n+                },\n+            ],\n+            response_id=\"resp-4\",\n+        )\n+\n+        cases = {\n+            \"no_delta\": [],\n+            \"empty_delta\": [\n+                _make_event(\n+                    \"response.function_call_arguments.delta\",\n+                    item_id=\"fc_1\",\n+                    delta=\"\",\n+                ),\n+            ],\n+        }\n+        expected_block = ToolCallBlock.model_construct(\n+            id=\"call-1\",\n+            created_at=A,\n+            name=\"get_current_time\",\n+            input=\"{}\",\n+        )\n+        for name, argument_events in cases.items():\n+            with self.subTest(name=name):\n+                events = [\n+                    _make_event(\n+                        \"response.output_item.added\",\n+                        item=fc_item,\n+                        response=MagicMock(id=\"resp-4\"),\n+                    ),\n+                    *argument_events,\n+                    _make_event(\n+                        \"response.function_call_arguments.done\",\n+                        item_id=\"fc_1\",\n+                        arguments=\"\",\n+                    ),\n+                    _make_event(\n+                        \"response.completed\",\n+                        response=completed_resp,\n+                    ),\n+                ]\n+                self.mock_client.responses.create = AsyncMock(\n+                    side_effect=[\n+                        _MockAsyncEventStream(events),\n+                        non_stream_resp,\n+                    ],\n+                )\n+\n+                gen = await self.model([])\n+                responses = [r async for r in gen]\n+                non_stream = await non_stream_model([])\n+\n+                self.assertListEqual(\n+                    [(r.is_last, r.content) for r in responses],\n+                    [\n+                        (False, [expected_block]),\n+                        (True, [expected_block]),\n+                    ],\n+                )\n+                self.assertListEqual(\n+                    [\n+                        (block.id, block.name, block.input)\n+                        for block in (\n+                            responses[-1].content[0],\n+                            non_stream.content[0],\n+                        )\n+                    ],\n+                    [(\"call-1\", \"get_current_time\", \"{}\")] * 2,\n+                )\n+\n \n # ---------------------------------------------------------------------------\n # _format_tools tests\n", "problem_statement": "[Bug]: OpenAI Responses streaming drops a function call without arguments\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nIn `OpenAIResponseModel._process_stream_response`, a `function_call` output item is only recorded into `tool_call_mapping` on `response.output_item.added`; the `ToolCallBlock` itself is created exclusively by `response.function_call_arguments.delta` events. A function call with empty arguments emits no argument deltas, so its block is never created and the call vanishes from the streamed result entirely.\n\nThe non-streaming path handles this correctly (`input=getattr(item, \"arguments\", \"\") or \"{}\"` in `_parse_completion_response`), so the same logical response yields a tool call when `stream=False` and nothing when `stream=True`.\n\nThe Anthropic streaming path was fixed for the identical problem in #3008 (\"stream an Anthropic tool call without arguments as {}\"); the OpenAI Responses path is the remaining unfixed sibling.\n\n### Steps to Reproduce\n\n1. Use `OpenAIResponseModel` with `stream=True` and a tool schema\n2. Feed a fake stream (or hit a provider that emits) `response.output_item.added` with a `function_call` item whose `arguments` is `\"\"`, then `response.completed` \u2014 with no `response.function_call_arguments.delta` events\n3. The accumulated `ChatResponse.content` is empty: the tool call is lost\n\nThe same call through `stream=False` returns `ToolCallBlock(input=\"{}\")`.\n\n### Expected Behavior\n\nA function call without arguments streams a `ToolCallBlock` with `input=\"{}\"`, matching the non-streaming result and the fixed Anthropic behavior.\n\nI have a small fix plus a regression test verified locally and would like to submit a PR for this issue.\n\n", "hints_text": "", "created_at": "2026-10-10T16:15:01Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3222, "instance_id": "agentscope-ai__agentscope-3222", "issue_numbers": ["3219"], "base_commit": "6642ed61b894c4e88d283d0cd5ac5c83e10a4fd2", "patch": "diff --git a/src/agentscope/rag/_knowledge.py b/src/agentscope/rag/_knowledge.py\nindex 8534fadb73..b833387776 100644\n--- a/src/agentscope/rag/_knowledge.py\n+++ b/src/agentscope/rag/_knowledge.py\n@@ -26,7 +26,7 @@\n co-locating multiple logical knowledge bases inside the same physical\n collection \u2014 typically multi-tenant deployments where every record\n carries a ``{\"tenant_id\": \"...\"}`` payload.  It is set once at\n-construction time and **always** applied: search/list never escape\n+construction time and **always** applied: search/list/delete never escape\n it, and insert forces it onto every chunk's metadata so a malicious or\n buggy parser cannot rebind a record into another scope.\n \"\"\"\n@@ -113,6 +113,8 @@ def __init__(\n                 - :meth:`insert_document` forces these keys onto every\n                   inserted chunk's metadata, overriding caller-supplied\n                   values, so records cannot leak into another scope.\n+                - :meth:`delete_document` removes only records matching\n+                  both the document id and every filter pair.\n \n                 ``None`` disables filtering \u2014 the default for\n                 deployments where every knowledge base owns its\n@@ -361,17 +363,30 @@ async def insert_document(\n         return document_id\n \n     async def delete_document(self, document_id: str) -> None:\n-        \"\"\"Remove every record for one source document.\n+        \"\"\"Remove every record for one source document within this scope.\n+\n+        Records must also match :attr:`metadata_filter` when set.\n+        Custom vector stores must support scoped deletion; an unsupported\n+        filter raises an error instead of falling back to unscoped deletion.\n \n         Args:\n             document_id (`str`):\n                 The source document id whose records should be removed.\n         \"\"\"\n         await self.ensure_collection()\n-        await self._vector_store.delete(\n-            self._collection,\n-            document_id,\n-        )\n+        if self._metadata_filter:\n+            await self._vector_store.delete(\n+                self._collection,\n+                document_id,\n+                metadata_filter=self._metadata_filter,\n+            )\n+        else:\n+            # Preserve compatibility with custom stores using the original\n+            # delete signature when no scoping is required.\n+            await self._vector_store.delete(\n+                self._collection,\n+                document_id,\n+            )\n \n     async def list_documents(self) -> list[\"DocumentSummary\"]:\n         \"\"\"List all distinct source documents in this knowledge base.\ndiff --git a/src/agentscope/rag/_vdb/_elasticsearch.py b/src/agentscope/rag/_vdb/_elasticsearch.py\nindex d9fc9b6eed..ab1225c6d6 100644\n--- a/src/agentscope/rag/_vdb/_elasticsearch.py\n+++ b/src/agentscope/rag/_vdb/_elasticsearch.py\n@@ -159,11 +159,30 @@ async def insert(\n                 \"record(s)\",\n             )\n \n-    async def delete(self, collection: str, document_id: str) -> None:\n-        \"\"\"Delete every chunk belonging to one source document.\"\"\"\n+    async def delete(\n+        self,\n+        collection: str,\n+        document_id: str,\n+        metadata_filter: dict[str, Any] | None = None,\n+    ) -> None:\n+        \"\"\"Delete every chunk belonging to one source document.\n+\n+        Args:\n+            collection (`str`):\n+                The target collection name.\n+            document_id (`str`):\n+                The source document ID whose records should be removed.\n+            metadata_filter (`dict[str, Any] | None`, optional):\n+                Restrict deletion to records matching every metadata pair\n+                in addition to the document ID. ``None`` disables filtering.\n+        \"\"\"\n+        query: dict[str, Any] = {\"term\": {\"document_id\": document_id}}\n+        if metadata_filter:\n+            filters = [query, *self._metadata_filters(metadata_filter)]\n+            query = {\"bool\": {\"filter\": filters}}\n         await self.get_client().delete_by_query(\n             index=collection,\n-            query={\"term\": {\"document_id\": document_id}},\n+            query=query,\n             conflicts=\"proceed\",\n             refresh=self._refresh is not False,\n         )\ndiff --git a/src/agentscope/rag/_vdb/_milvus_lite.py b/src/agentscope/rag/_vdb/_milvus_lite.py\nindex fa4170e2c1..ea8bacb12e 100644\n--- a/src/agentscope/rag/_vdb/_milvus_lite.py\n+++ b/src/agentscope/rag/_vdb/_milvus_lite.py\n@@ -260,12 +260,27 @@ async def delete(\n         self,\n         collection: str,\n         document_id: str,\n+        metadata_filter: dict[str, Any] | None = None,\n     ) -> None:\n-        \"\"\"Delete all records belonging to one source document.\"\"\"\n+        \"\"\"Delete all records belonging to one source document.\n+\n+        Args:\n+            collection (`str`):\n+                The target collection name.\n+            document_id (`str`):\n+                The source document ID whose records should be removed.\n+            metadata_filter (`dict[str, Any] | None`, optional):\n+                Restrict deletion to records matching every metadata pair\n+                in addition to the document ID. ``None`` disables filtering.\n+        \"\"\"\n+        clauses = [self._build_document_filter(document_id)]\n+        meta_expr = self._build_metadata_filter(metadata_filter)\n+        if meta_expr:\n+            clauses.append(meta_expr)\n         await asyncio.to_thread(\n             self.get_client().delete,\n             collection_name=collection,\n-            filter=self._build_document_filter(document_id),\n+            filter=\" and \".join(clauses),\n         )\n \n     # ------------------------------------------------------------------\ndiff --git a/src/agentscope/rag/_vdb/_mongodb.py b/src/agentscope/rag/_vdb/_mongodb.py\nindex f6029b8d6d..450b9bc8e2 100644\n--- a/src/agentscope/rag/_vdb/_mongodb.py\n+++ b/src/agentscope/rag/_vdb/_mongodb.py\n@@ -293,6 +293,7 @@ async def delete(\n         self,\n         collection: str,\n         document_id: str,\n+        metadata_filter: dict[str, Any] | None = None,\n     ) -> None:\n         \"\"\"Delete all records belonging to one source document.\n \n@@ -305,8 +306,13 @@ async def delete(\n             document_id (`str`):\n                 The source document ID whose records should be\n                 removed.\n+            metadata_filter (`dict[str, Any] | None`, optional):\n+                Restrict deletion to records matching every metadata pair\n+                in addition to the document ID. ``None`` disables filtering.\n         \"\"\"\n-        await self._col(collection).delete_many({\"document_id\": document_id})\n+        query = {\"document_id\": document_id}\n+        query.update(self._build_metadata_filter(metadata_filter) or {})\n+        await self._col(collection).delete_many(query)\n \n     # ------------------------------------------------------------------\n     # Search\ndiff --git a/src/agentscope/rag/_vdb/_qdrant.py b/src/agentscope/rag/_vdb/_qdrant.py\nindex 09af9a69c4..a4a85bcc12 100644\n--- a/src/agentscope/rag/_vdb/_qdrant.py\n+++ b/src/agentscope/rag/_vdb/_qdrant.py\n@@ -248,6 +248,7 @@ async def delete(\n         self,\n         collection: str,\n         document_id: str,\n+        metadata_filter: dict[str, Any] | None = None,\n     ) -> None:\n         \"\"\"Delete all records belonging to one source document.\n \n@@ -260,20 +261,25 @@ async def delete(\n             document_id (`str`):\n                 The source document ID whose records should be\n                 removed.\n+            metadata_filter (`dict[str, Any] | None`, optional):\n+                Restrict deletion to records matching every metadata pair\n+                in addition to the document ID. ``None`` disables filtering.\n         \"\"\"\n         from qdrant_client import models\n \n+        conditions = [\n+            models.FieldCondition(\n+                key=\"document_id\",\n+                match=models.MatchValue(value=document_id),\n+            ),\n+        ]\n+        base_filter = self._build_metadata_filter(metadata_filter)\n+        if base_filter is not None:\n+            conditions.extend(base_filter.must)\n         await self.get_client().delete(\n             collection_name=collection,\n             points_selector=models.FilterSelector(\n-                filter=models.Filter(\n-                    must=[\n-                        models.FieldCondition(\n-                            key=\"document_id\",\n-                            match=models.MatchValue(value=document_id),\n-                        ),\n-                    ],\n-                ),\n+                filter=models.Filter(must=conditions),\n             ),\n         )\n \ndiff --git a/src/agentscope/rag/_vdb/_vector_store.py b/src/agentscope/rag/_vdb/_vector_store.py\nindex 060f9507b0..ec621a2c36 100644\n--- a/src/agentscope/rag/_vdb/_vector_store.py\n+++ b/src/agentscope/rag/_vdb/_vector_store.py\n@@ -207,6 +207,7 @@ async def delete(\n         self,\n         collection: str,\n         document_id: str,\n+        metadata_filter: dict[str, Any] | None = None,\n     ) -> None:\n         \"\"\"Delete all records belonging to one source document.\n \n@@ -221,6 +222,11 @@ async def delete(\n             document_id (`str`):\n                 The source document ID whose records should be\n                 removed.\n+            metadata_filter (`dict[str, Any] | None`, optional):\n+                Restrict deletion to records whose chunk metadata matches\n+                every ``key == value`` pair in addition to the document ID.\n+                ``None`` or an empty dict deletes all records of the\n+                document. Backends must not ignore a non-empty filter.\n         \"\"\"\n \n     # ------------------------------------------------------------------\n", "test_patch": "diff --git a/tests/rag_vdb_elasticsearch_test.py b/tests/rag_vdb_elasticsearch_test.py\nindex 883c4b693d..2ffa4c275b 100644\n--- a/tests/rag_vdb_elasticsearch_test.py\n+++ b/tests/rag_vdb_elasticsearch_test.py\n@@ -145,6 +145,42 @@ async def test_insert_surfaces_bulk_item_failures(self) -> None:\n         with self.assertRaisesRegex(RuntimeError, \"1 record\"):\n             await self.store.insert(\"kb-1\", [_record(\"doc-1\", 0)])\n \n+    async def test_elasticsearch_delete_filter(self) -> None:\n+        \"\"\"Elasticsearch uses a conjunction of exact-match filters.\"\"\"\n+        await self.store.delete(\n+            \"shared\",\n+            \"doc\",\n+            metadata_filter={\"tenant\": \"alpha\", \"project\": 2},\n+        )\n+        self.client.delete_by_query.assert_awaited_once_with(\n+            index=\"shared\",\n+            query={\n+                \"bool\": {\n+                    \"filter\": [\n+                        {\"term\": {\"document_id\": \"doc\"}},\n+                        {\"term\": {\"metadata.tenant\": \"alpha\"}},\n+                        {\"term\": {\"metadata.project\": 2}},\n+                    ],\n+                },\n+            },\n+            conflicts=\"proceed\",\n+            refresh=True,\n+        )\n+        for scope in (None, {}):\n+            with self.subTest(scope=scope):\n+                self.client.delete_by_query.reset_mock()\n+                await self.store.delete(\n+                    \"shared\",\n+                    \"doc\",\n+                    metadata_filter=scope,\n+                )\n+                self.client.delete_by_query.assert_awaited_once_with(\n+                    index=\"shared\",\n+                    query={\"term\": {\"document_id\": \"doc\"}},\n+                    conflicts=\"proceed\",\n+                    refresh=True,\n+                )\n+\n     async def test_delete_by_document_id(self) -> None:\n         await self.store.delete(\"kb-1\", \"doc-1\")\n \ndiff --git a/tests/rag_vdb_milvus_lite_test.py b/tests/rag_vdb_milvus_lite_test.py\nindex 31d01278d3..2f15405f58 100644\n--- a/tests/rag_vdb_milvus_lite_test.py\n+++ b/tests/rag_vdb_milvus_lite_test.py\n@@ -5,7 +5,9 @@\n from contextlib import AsyncExitStack\n from importlib.util import find_spec\n from pathlib import Path\n+from types import SimpleNamespace\n from unittest.async_case import IsolatedAsyncioTestCase\n+from unittest.mock import Mock, patch\n \n from utils import AnyString\n \n@@ -582,3 +584,34 @@ def _records(count: int) -> list:\n             [c.content.text for c in chunks],\n             [\"v2-chunk0\", \"v2-chunk1\"],\n         )\n+\n+\n+class MilvusDeleteFilterTest(IsolatedAsyncioTestCase):\n+    \"\"\"Check delete predicates without starting a Milvus service.\"\"\"\n+\n+    async def test_milvus_delete_filter(self) -> None:\n+        \"\"\"Milvus keeps document escaping and ANDs both metadata fields.\"\"\"\n+        store = MilvusLiteStore()\n+        client = SimpleNamespace(delete=Mock())\n+        with patch.object(store, \"get_client\", return_value=client):\n+            await store.delete(\n+                \"shared\",\n+                'doc\"id',\n+                metadata_filter={\"tenant\": \"alpha\", \"project\": 2},\n+            )\n+        client.delete.assert_called_once_with(\n+            collection_name=\"shared\",\n+            filter=(\n+                'document_id == \"doc\\\\\"id\" and '\n+                'metadata[\"tenant\"] == \"alpha\" and metadata[\"project\"] == 2'\n+            ),\n+        )\n+        for scope in (None, {}):\n+            with self.subTest(scope=scope):\n+                client.delete.reset_mock()\n+                with patch.object(store, \"get_client\", return_value=client):\n+                    await store.delete(\"shared\", \"doc\", metadata_filter=scope)\n+                client.delete.assert_called_once_with(\n+                    collection_name=\"shared\",\n+                    filter='document_id == \"doc\"',\n+                )\ndiff --git a/tests/rag_vdb_mongodb_test.py b/tests/rag_vdb_mongodb_test.py\nindex f8b2d7a8dd..9047261352 100644\n--- a/tests/rag_vdb_mongodb_test.py\n+++ b/tests/rag_vdb_mongodb_test.py\n@@ -5,9 +5,10 @@\n \n import math\n from contextlib import AsyncExitStack\n+from types import SimpleNamespace\n from typing import Any\n from unittest.async_case import IsolatedAsyncioTestCase\n-from unittest.mock import patch\n+from unittest.mock import AsyncMock, patch\n \n from utils import AnyString\n \n@@ -478,6 +479,34 @@ async def test_search_top_k(self) -> None:\n             ],\n         )\n \n+    async def test_mongodb_delete_filter(self) -> None:\n+        \"\"\"MongoDB combines the source document with metadata equality.\"\"\"\n+        store = self.store\n+        collection = SimpleNamespace(delete_many=AsyncMock())\n+        with patch.object(store, \"_col\", return_value=collection):\n+            await store.delete(\n+                \"shared\",\n+                \"doc\",\n+                metadata_filter={\"tenant\": \"alpha\", \"project\": 2},\n+            )\n+        collection.delete_many.assert_awaited_once_with(\n+            {\n+                \"document_id\": \"doc\",\n+                \"$and\": [\n+                    {\"chunk.metadata.tenant\": {\"$eq\": \"alpha\"}},\n+                    {\"chunk.metadata.project\": {\"$eq\": 2}},\n+                ],\n+            },\n+        )\n+        for scope in (None, {}):\n+            with self.subTest(scope=scope):\n+                collection.delete_many.reset_mock()\n+                with patch.object(store, \"_col\", return_value=collection):\n+                    await store.delete(\"shared\", \"doc\", metadata_filter=scope)\n+                collection.delete_many.assert_awaited_once_with(\n+                    {\"document_id\": \"doc\"},\n+                )\n+\n     async def test_search_candidate_limits(self) -> None:\n         \"\"\"Search caps candidates while preserving the requested limit.\"\"\"\n         await self.store.create_collection(\"kb-1\", dimensions=3)\ndiff --git a/tests/rag_vdb_qdrant_test.py b/tests/rag_vdb_qdrant_test.py\nindex cc39730713..42730049f9 100644\n--- a/tests/rag_vdb_qdrant_test.py\n+++ b/tests/rag_vdb_qdrant_test.py\n@@ -1,19 +1,47 @@\n # -*- coding: utf-8 -*-\n \"\"\"Unit tests for the QdrantStore class.\"\"\"\n from contextlib import AsyncExitStack\n+from importlib.util import find_spec\n+from types import SimpleNamespace\n+from unittest import skipUnless\n from unittest.async_case import IsolatedAsyncioTestCase\n+from unittest.mock import AsyncMock, patch\n \n from utils import AnyString\n \n from agentscope.message import TextBlock\n from agentscope.rag import (\n     Chunk,\n+    KnowledgeBase,\n     QdrantStore,\n     VectorRecord,\n     VectorSearchResult,\n )\n \n \n+def _knowledge_base(\n+    store: QdrantStore,\n+    metadata_filter: dict | None,\n+) -> KnowledgeBase:\n+    \"\"\"Bind a handle without needing an embedding request for deletion.\"\"\"\n+    return KnowledgeBase(\n+        name=\"test\",\n+        description=\"Test knowledge base\",\n+        embedding_model=SimpleNamespace(dimensions=3),\n+        vector_store=store,\n+        collection=\"shared\",\n+        metadata_filter=metadata_filter,\n+    )\n+\n+\n+class _LegacyStore(QdrantStore):\n+    \"\"\"Custom backend using the original, unscoped delete signature.\"\"\"\n+\n+    async def delete(self, collection: str, document_id: str) -> None:\n+        \"\"\"Record deletions so a rejected scoped call cannot mutate data.\"\"\"\n+        await self.get_client().delete(collection, document_id)\n+\n+\n def _dump_results(results: list[VectorSearchResult]) -> list[dict]:\n     \"\"\"Convert search results into plain dicts for whole-structure\n     comparison.\n@@ -698,3 +726,115 @@ def _records(count: int) -> list:\n             [c.content.text for c in chunks],\n             [\"v2-chunk0\", \"v2-chunk1\"],\n         )\n+\n+\n+class LegacyDeleteTest(IsolatedAsyncioTestCase):\n+    \"\"\"Old custom backends still work without a scope and fail closed.\"\"\"\n+\n+    async def test_legacy_backend_without_scope(self) -> None:\n+        \"\"\"No metadata keyword is sent when the handle has no scope.\"\"\"\n+        for scope in (None, {}):\n+            with self.subTest(scope=scope):\n+                store = _LegacyStore()\n+                client = SimpleNamespace(delete=AsyncMock())\n+                with (\n+                    patch.object(store, \"has_collection\", return_value=True),\n+                    patch.object(store, \"get_client\", return_value=client),\n+                ):\n+                    await _knowledge_base(store, scope).delete_document(\"doc\")\n+                client.delete.assert_awaited_once_with(\"shared\", \"doc\")\n+\n+    async def test_legacy_backend_with_scope(self) -> None:\n+        \"\"\"An unsupported scope is rejected before deleting anything.\"\"\"\n+        store = _LegacyStore()\n+        client = SimpleNamespace(delete=AsyncMock())\n+        with (\n+            patch.object(store, \"has_collection\", return_value=True),\n+            patch.object(store, \"get_client\", return_value=client),\n+        ):\n+            with self.assertRaises(TypeError):\n+                await _knowledge_base(\n+                    store,\n+                    {\"tenant\": \"alpha\"},\n+                ).delete_document(\"doc\")\n+        client.delete.assert_not_awaited()\n+\n+\n+@skipUnless(find_spec(\"qdrant_client\"), \"qdrant-client is required\")\n+class QdrantScopedDeleteTest(IsolatedAsyncioTestCase):\n+    \"\"\"Verify isolation against the real, in-memory Qdrant backend.\"\"\"\n+\n+    async def asyncSetUp(self) -> None:\n+        \"\"\"Insert chunks spanning documents and two independent scope keys.\"\"\"\n+        self._exit_stack = AsyncExitStack()\n+        self.store = await self._exit_stack.enter_async_context(\n+            QdrantStore(location=\":memory:\"),\n+        )\n+        await self.store.create_collection(\"shared\", dimensions=3)\n+        self.scope = {\"tenant\": \"alpha\", \"project\": 2}\n+        records = []\n+        for document_id, index, metadata in (\n+            (\"shared-doc\", 0, self.scope),\n+            (\"shared-doc\", 1, {\"tenant\": \"beta\", \"project\": 2}),\n+            (\"shared-doc\", 2, {\"tenant\": \"alpha\", \"project\": 3}),\n+            (\"alpha-doc\", 0, self.scope),\n+            (\"beta-doc\", 0, {\"tenant\": \"beta\", \"project\": 2}),\n+        ):\n+            records.append(\n+                VectorRecord(\n+                    vector=[1.0, 0.0, 0.0],\n+                    document_id=document_id,\n+                    chunk=Chunk(\n+                        content=TextBlock(text=f\"{document_id}-{index}\"),\n+                        source=f\"{document_id}.txt\",\n+                        chunk_index=index,\n+                        total_chunks=3,\n+                        metadata=metadata,\n+                    ),\n+                ),\n+            )\n+        await self.store.insert(\"shared\", records)\n+\n+    async def asyncTearDown(self) -> None:\n+        \"\"\"Release the ephemeral client.\"\"\"\n+        await self._exit_stack.aclose()\n+\n+    async def test_foreign_document_is_unchanged(self) -> None:\n+        \"\"\"A scoped handle cannot remove an invisible foreign document.\"\"\"\n+        before = await self.store.list_chunks(\"shared\", \"beta-doc\")\n+        await _knowledge_base(self.store, self.scope).delete_document(\n+            \"beta-doc\",\n+        )\n+        after = await self.store.list_chunks(\"shared\", \"beta-doc\")\n+        self.assertEqual(before, after)\n+        self.assertEqual(len(after), 1)\n+\n+    async def test_delete_requires_document_and_every_scope_field(\n+        self,\n+    ) -> None:\n+        \"\"\"Delete only chunks matching both the document and all scope keys.\"\"\"\n+        await _knowledge_base(self.store, self.scope).delete_document(\n+            \"shared-doc\",\n+        )\n+        chunks = await self.store.list_chunks(\"shared\", \"shared-doc\")\n+        self.assertEqual([chunk.chunk_index for chunk in chunks], [1, 2])\n+        self.assertEqual(\n+            len(await self.store.list_chunks(\"shared\", \"alpha-doc\")),\n+            1,\n+        )\n+        await _knowledge_base(self.store, self.scope).delete_document(\n+            \"alpha-doc\",\n+        )\n+        self.assertEqual(\n+            await self.store.list_chunks(\"shared\", \"alpha-doc\"),\n+            [],\n+        )\n+\n+    async def test_unscoped_handle_deletes_all_document_chunks(self) -> None:\n+        \"\"\"The default handle deletes documents across the whole collection.\"\"\"\n+        await _knowledge_base(self.store, None).delete_document(\"shared-doc\")\n+        self.assertEqual(\n+            await self.store.list_chunks(\"shared\", \"shared-doc\"),\n+            [],\n+        )\n+        self.assertEqual(len(await self.store.list_documents(\"shared\")), 2)\n", "problem_statement": "[Bug]: KnowledgeBase.delete_document ignores metadata_filter in shared collections\n### Prerequisites\r\n\r\n- [x] I searched the existing issues, pull requests, and discussions. Related RAG deletion and metadata fixes are distinguished below.\r\n- [x] This is a reproducible SDK behavior bug, rather than a usage question.\r\n\r\n### Background / Description\r\n\r\n`KnowledgeBase.delete_document()` does not apply the handle's `metadata_filter`. When multiple knowledge bases share a physical collection, a handle can delete a document outside its own scope even though its read methods correctly hide that document.\r\n\r\nThe SDK documents `metadata_filter` as a fixed scope for shared-collection deployments. For example, two handles can use the same collection with `{\"tenant_id\": \"alpha\"}` and `{\"tenant_id\": \"beta\"}`. Search and document/chunk listing apply those filters, and insertion stamps the fixed metadata onto the inserted chunks. It is reasonable for a caller to expect deletion through the same handle to respect that scope as well.\r\n\r\nThe reproduction starts by checking visibility through both handles. Only then does it call `alpha.delete_document(\"beta-doc\")`. The beta document disappears, even though it was never visible through alpha.\r\n\r\n### Steps to Reproduce\r\n\r\nUse main at `faf54fdd463b933cb29f46a80ae9f2a758d06bff` (`2.0.10dev`) and install the Qdrant extra:\r\n\r\n```bash\r\npython -m pip install -e \".[vdb-qdrant]\"\r\npython repro_rag.py\r\n```\r\n\r\nSave this as `repro_rag.py`:\r\n\r\n```python\r\nimport asyncio\r\n\r\nfrom agentscope.embedding import EmbeddingResponse\r\nfrom agentscope.message import TextBlock\r\nfrom agentscope.rag import Chunk, KnowledgeBase, QdrantStore\r\n\r\n\r\nclass LocalEmbedding:\r\n    dimensions = 3\r\n    supports_multimodal = False\r\n\r\n    async def __call__(self, inputs):\r\n        return EmbeddingResponse(embeddings=[[1.0, 0.0, 0.0] for _ in inputs])\r\n\r\n\r\ndef chunk(text, source):\r\n    return Chunk(content=TextBlock(text=text), source=source, chunk_index=0, total_chunks=1)\r\n\r\n\r\nasync def main():\r\n    async with QdrantStore(location=\":memory:\") as store:\r\n        alpha = KnowledgeBase(\r\n            name=\"alpha\", description=\"Local alpha documents\",\r\n            embedding_model=LocalEmbedding(), vector_store=store,\r\n            collection=\"shared\", metadata_filter={\"tenant_id\": \"alpha\"},\r\n        )\r\n        beta = KnowledgeBase(\r\n            name=\"beta\", description=\"Local beta documents\",\r\n            embedding_model=LocalEmbedding(), vector_store=store,\r\n            collection=\"shared\", metadata_filter={\"tenant_id\": \"beta\"},\r\n        )\r\n        await alpha.insert_document([chunk(\"alpha text\", \"alpha.txt\")], \"alpha-doc\")\r\n        await beta.insert_document([chunk(\"beta text\", \"beta.txt\")], \"beta-doc\")\r\n        print(\"alpha sees:\", [d.document_id for d in await alpha.list_documents()])\r\n        print(\"beta sees:\", [d.document_id for d in await beta.list_documents()])\r\n        print(\"beta chunks visible to alpha:\", len(await alpha.list_chunks(\"beta-doc\")))\r\n        await alpha.delete_document(\"beta-doc\")\r\n        print(\"beta sees after alpha delete:\", [d.document_id for d in await beta.list_documents()])\r\n\r\n\r\nasyncio.run(main())\r\n```\r\n\r\nThis uses a real in-memory Qdrant collection and deterministic local embeddings. The documents and tenant names are fictional. Each insertion gets a fresh `Chunk`, and the two documents have different IDs, so neither reused metadata nor an overlapping point identity is needed to reproduce the deletion.\r\n\r\n### Observed behavior\r\n\r\n```text\r\nalpha sees: ['alpha-doc']\r\nbeta sees: ['beta-doc']\r\nbeta chunks visible to alpha: 0\r\nbeta sees after alpha delete: []\r\n```\r\n\r\nNo error is raised. The last line is the problem: deleting through alpha removes a document that only beta could read.\r\n\r\n### Expected behavior\r\n\r\nThe final line should remain:\r\n\r\n```text\r\nbeta sees after alpha delete: ['beta-doc']\r\n```\r\n\r\nA scoped deletion should remove a record only when its `document_id` matches **and every fixed metadata-filter pair matches**. A matching document within alpha should still be deletable. An unscoped handle should retain its existing collection-wide document deletion behavior.\r\n\r\n### Cause\r\n\r\n[`KnowledgeBase.delete_document()`](https://github.com/agentscope-ai/agentscope/blob/faf54fdd463b933cb29f46a80ae9f2a758d06bff/src/agentscope/rag/_knowledge.py) calls `delete(collection, document_id)` without forwarding `_metadata_filter`. The abstract [`VectorStoreBase.delete()`](https://github.com/agentscope-ai/agentscope/blob/faf54fdd463b933cb29f46a80ae9f2a758d06bff/src/agentscope/rag/_vdb/_vector_store.py) contract also has no filter parameter. Consequently, the Qdrant, MongoDB, Milvus Lite, and Elasticsearch implementations build deletion predicates from the document ID alone.\r\n\r\nThe read-side helpers already know how to express metadata equality for each backend. The missing part is carrying the same fixed scope through the deletion contract and combining it with the document predicate, rather than treating the filter as an alternative condition.\r\n\r\n### Impact and boundaries\r\n\r\nThis concerns the public SDK's documented shared-collection mode. A typo, stale document ID, or cross-scope ID supplied to a scoped handle can silently remove another scope's records. Checking visibility before deletion in application code is an unreliable substitute for enforcing the condition in the backend query itself.\r\n\r\nThe default hosted application uses separate collections for knowledge bases and has service-level ownership checks. This reproduction does not establish an exploit against that default deployment. It demonstrates a mismatch between SDK read and delete scoping when the physical collection is shared.\r\n\r\nPoint identity for overlapping document IDs is a separate concern. It is not necessary for this reproduction and is outside this proposed fix.\r\n\r\n### Proposed fix and compatibility\r\n\r\nAdd optional `metadata_filter` support to the vector-store deletion contract, pass the handle's non-empty fixed filter, and reuse each backend's existing metadata-filter helper. The resulting predicate must be a conjunction of the document ID and all scope fields.\r\n\r\nFor custom stores that implement the original two-argument delete method, unscoped handles can keep using that original call. Scoped handles should require filter support and raise before deletion if the signature does not support it. Falling back to an unscoped delete would preserve the data-loss behavior.\r\n\r\n### Related work\r\n\r\n- #2523 / #2524 concern an indexing worker reinserting data after deletion. This reproduction has no indexing worker and reaches the delete predicate directly.\r\n- #2896 / #2897 concern metadata contamination when a `Chunk` is reused. Every chunk here is freshly constructed.\r\n- The Redis and RAGFlow backend proposals add integrations; they do not change the built-in scoped deletion contract covered here.\r\n\r\n### Environment\r\n\r\n- AgentScope: `2.0.10dev`, main `faf54fdd463b933cb29f46a80ae9f2a758d06bff`.\r\n- Python: `3.12.14`; OS: Windows.\r\n- Qdrant client: `1.19.1`, using `location=\":memory:\"`.\r\n- No external vector database or embedding service is required.\r\n\r\nA focused implementation is available on `dafyy321-pixel:fix/rag-scoped-delete`. It covers foreign documents, multiple scope keys, matching-scope deletion, unscoped compatibility, and the delete predicates for all four built-in stores.\r\n\n", "hints_text": "", "created_at": "2026-10-10T06:30:06Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3217, "instance_id": "agentscope-ai__agentscope-3217", "issue_numbers": ["3215"], "base_commit": "faf54fdd463b933cb29f46a80ae9f2a758d06bff", "patch": "diff --git a/src/agentscope/rag/_parser/_ppt.py b/src/agentscope/rag/_parser/_ppt.py\nindex c37802b55d..3e176f929b 100644\n--- a/src/agentscope/rag/_parser/_ppt.py\n+++ b/src/agentscope/rag/_parser/_ppt.py\n@@ -231,6 +231,7 @@ async def parse(\n \n         try:\n             from pptx import Presentation\n+            from pptx.exc import InvalidXmlError\n         except ImportError as e:\n             raise ImportError(\n                 \"Please install python-pptx to use the PowerPoint \"\n@@ -247,10 +248,15 @@ async def parse(\n             ) from e\n \n         sections: list[Section] = []\n-        for slide_idx, slide in enumerate(prs.slides):\n-            sections.extend(\n-                self._parse_slide(slide, slide_idx, filename),\n-            )\n+        try:\n+            for slide_idx, slide in enumerate(prs.slides):\n+                sections.extend(\n+                    self._parse_slide(slide, slide_idx, filename),\n+                )\n+        except InvalidXmlError as e:\n+            raise ValueError(\n+                f\"Failed to parse {filename!r} as PPTX: {e}\",\n+            ) from e\n         return sections\n \n     # ------------------------------------------------------------------\n", "test_patch": "diff --git a/tests/rag_parser_test.py b/tests/rag_parser_test.py\nindex b1ff96fd66..88eb465029 100644\n--- a/tests/rag_parser_test.py\n+++ b/tests/rag_parser_test.py\n@@ -1242,6 +1242,62 @@ async def test_table_format_validation(self) -> None:\n         with self.assertRaises(ValueError):\n             PPTParser(table_format=\"csv\")  # type: ignore[arg-type]\n \n+    async def test_deferred_invalid_xml_raises_value_error(self) -> None:\n+        \"\"\"Malformed slide XML is wrapped after the deck opens.\"\"\"\n+        import tempfile\n+        from xml.etree import ElementTree\n+\n+        from pptx import Presentation\n+        from pptx.exc import InvalidXmlError\n+\n+        original = io.BytesIO(_make_pptx_simple([\"Alpha\", \"Beta\"]))\n+        corrupted = io.BytesIO()\n+        with zipfile.ZipFile(original) as source:\n+            with zipfile.ZipFile(corrupted, \"w\") as target:\n+                for member in source.infolist():\n+                    data = source.read(member.filename)\n+                    if member.filename == \"ppt/slides/slide2.xml\":\n+                        root = ElementTree.fromstring(data)\n+                        common_slide = root.find(\n+                            \"{http://schemas.openxmlformats.org/\"\n+                            \"presentationml/2006/main}cSld\",\n+                        )\n+                        assert common_slide is not None\n+                        root.remove(common_slide)\n+                        data = ElementTree.tostring(root)\n+                    target.writestr(member, data)\n+        pptx_bytes = corrupted.getvalue()\n+\n+        # The required child is only checked when slide shapes are accessed.\n+        slides = list(Presentation(io.BytesIO(pptx_bytes)).slides)\n+        self.assertEqual(len(slides), 2)\n+        self.assertEqual(slides[0].shapes.title.text, \"Alpha\")\n+\n+        with tempfile.TemporaryDirectory() as directory:\n+            path = os.path.join(directory, \"corrupt.pptx\")\n+            with open(path, \"wb\") as fp:\n+                fp.write(pptx_bytes)\n+            for input_type, pptx_input in (\n+                (\"bytes\", pptx_bytes),\n+                (\"path\", path),\n+            ):\n+                with self.subTest(input_type=input_type):\n+                    with self.assertRaisesRegex(\n+                        ValueError,\n+                        r\"Failed to parse 'corrupt\\.pptx' as PPTX:\",\n+                    ) as context:\n+                        await PPTParser().parse(pptx_input, \"corrupt.pptx\")\n+                    self.assertIsInstance(\n+                        context.exception.__cause__,\n+                        InvalidXmlError,\n+                    )\n+\n+    async def test_invalid_slide_prefix_preserves_key_error(self) -> None:\n+        \"\"\"An unknown prefix placeholder remains a configuration error.\"\"\"\n+        parser = PPTParser(slide_prefix=\"{unknown}\")\n+        with self.assertRaisesRegex(KeyError, \"unknown\"):\n+            await parser.parse(_make_pptx_simple([\"Alpha\"]), \"demo.pptx\")\n+\n     async def test_string_input_treated_as_path(self) -> None:\n         \"\"\"``str`` is interpreted as a filesystem path to the PPTX.\"\"\"\n         import tempfile\n", "problem_statement": "[Bug]: PPTParser leaks deferred InvalidXmlError instead of ValueError\n### Prerequisites\n\n- [x] I have searched the existing issues, pull requests, and discussions and found no matching report.\n- [x] This is a reproducible bug, not a usage question.\n\n### Background / Description\n\n`PPTParser.parse()` documents `ValueError` when PPTX bytes cannot be parsed, but its exception wrapper only covers `Presentation(...)`. Required slide XML can be accessed later by `_parse_slide()`.\n\nA two-slide PPTX whose second slide lacks the required `p:cSld` element still has a readable ZIP and well-formed XML. `Presentation(...)`, slide enumeration, and reading the first slide succeed. Parsing the second slide leaks `pptx.exc.InvalidXmlError` directly. This is not a subclass of `ValueError`, and the error lacks the source filename.\n\nExpected: convert this deferred XML failure to a filename-bearing `ValueError`, preserving the original exception as `__cause__`, consistent with the existing constructor-error handling. Library callers handling the documented `ValueError` should not need to know this dependency-specific exception.\n\nThis report concerns the library exception contract. I have not demonstrated a hosted worker crash; the index worker has broader exception handling.\n\n### Error Messages\n\n```text\nConstructor succeeded; slides: 2\nFirst slide: Good slide\n...\nPPTParser.parse -> PPTParser._parse_slide -> slide.shapes\npptx.exc.InvalidXmlError: required ``<p:cSld>`` child element not present\n```\n\n### Steps to Reproduce\n\nFrom the source checkout with the declared `rag` dependencies installed, save the following as `repro.py` and run `python repro.py`. It creates the file entirely in memory and makes no model or network requests.\n\n```python\n\"\"\"Minimal offline reproduction of PPTParser's deferred XML error.\"\"\"\nimport asyncio\nimport io\nimport zipfile\nfrom xml.etree import ElementTree as ET\n\nfrom pptx import Presentation\n\nfrom agentscope.rag import PPTParser\n\ndeck = Presentation()\nfor text in (\"Good slide\", \"Broken slide\"):\n    slide = deck.slides.add_slide(deck.slide_layouts[5])\n    slide.shapes.title.text = text\noriginal = io.BytesIO()\ndeck.save(original)\n\nbroken = io.BytesIO()\nwith zipfile.ZipFile(io.BytesIO(original.getvalue())) as source:\n    with zipfile.ZipFile(broken, \"w\") as target:\n        for entry in source.infolist():\n            data = source.read(entry.filename)\n            if entry.filename == \"ppt/slides/slide2.xml\":\n                root = ET.fromstring(data)\n                child = root.find(\n                    \"{http://schemas.openxmlformats.org/presentationml/\"\n                    \"2006/main}cSld\",\n                )\n                assert child is not None\n                root.remove(child)\n                data = ET.tostring(root, encoding=\"utf-8\")\n                ET.fromstring(data)  # The XML is still well-formed.\n            target.writestr(entry, data)\n\npayload = broken.getvalue()\nreopened = Presentation(io.BytesIO(payload))\nprint(\"Constructor succeeded; slides:\", len(reopened.slides), flush=True)\nprint(\"First slide:\", reopened.slides[0].shapes.title.text, flush=True)\nasyncio.run(PPTParser().parse(payload, \"broken.pptx\"))\n```\n\n### Proposed scope and verification\n\nCatch `InvalidXmlError` around slide traversal and re-raise `ValueError` with the filename and exception chaining. Keep the current construction wrapper, missing-file behavior, optional import behavior, and configuration errors unchanged. Extending the broad `except Exception` across slide parsing would also catch unrelated errors such as an invalid `slide_prefix` placeholder, so I would avoid that.\n\nI have reproduced the same failure with bytes and a temporary file path. Controls passed for a valid two-slide deck (text, source, and slide metadata), an invalid ZIP (`ValueError`), a missing path (`FileNotFoundError`), and an invalid prefix placeholder (`KeyError`). Existing parser/chunker tests passed: `74 passed, 10 subtests passed`.\n\nI would add a real malformed-PPTX regression covering the deferred failure, filename, and chained cause, while retaining the normal-path controls. No implementation has been started.\n\nIs anyone already working on this, and would this narrow exception normalization match the maintainers' expectations? I would like to contribute the fix and regression tests after coordination.\n\n### Environment\n\n- AgentScope: `2.0.10dev`, source `faf54fdd463b933cb29f46a80ae9f2a758d06bff`\n- Python: 3.11.9\n- python-pptx: 1.0.2\n- OS: Windows\n- Verified: 2026-10-10\n\nCodex assisted with investigation, the offline reproduction, and this draft. Full CI, live models, and the hosted indexing pipeline were not run.\n\n", "hints_text": "/assign\n\nI would like to take this focused parser fix. I reproduced the deferred InvalidXmlError with both bytes and a temporary PPTX path on main at faf54fdd463b933cb29f46a80ae9f2a758d06bff. I plan to normalize this specific XML exception while preserving missing-file and configuration errors, and add a regression using real malformed PPTX bytes. Please let me know if someone is already working on it or if a different scope is preferred.\n\nIt's yours, @shuxiachai. If there is no pull request and no word from you by 2026-10-24 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-10T04:42:51Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3216, "instance_id": "agentscope-ai__agentscope-3216", "issue_numbers": ["3210"], "base_commit": "e941f946c09e3852ec5230c8cd4276c3bc3622c7", "patch": "diff --git a/src/agentscope/model/_base.py b/src/agentscope/model/_base.py\nindex 87092d6e32..d4782b2a57 100644\n--- a/src/agentscope/model/_base.py\n+++ b/src/agentscope/model/_base.py\n@@ -283,6 +283,14 @@ async def _stream() -> AsyncGenerator[ChatResponse, None]:\n             except asyncio.CancelledError:\n                 acc_res.finished_reason = FinishedReason.INTERRUPTED\n                 yield_acc_res = True\n+            finally:\n+                # Closing this wrapper does not close the delegated iterator.\n+                # Wait for provider cleanup before ``aclose`` returns.\n+                aclose = getattr(res, \"aclose\", None)\n+                if aclose is not None:\n+                    maybe_awaitable = aclose()\n+                    if inspect.isawaitable(maybe_awaitable):\n+                        await maybe_awaitable\n \n             if yield_acc_res:\n                 yield acc_res.build()\n", "test_patch": "diff --git a/tests/model_base_test.py b/tests/model_base_test.py\nindex 83b712c942..cf7780588c 100644\n--- a/tests/model_base_test.py\n+++ b/tests/model_base_test.py\n@@ -4,7 +4,7 @@\n import asyncio\n import base64\n import struct\n-from typing import Any\n+from typing import Any, AsyncGenerator\n from unittest.async_case import IsolatedAsyncioTestCase\n \n from utils import AnyString, MockModel\n@@ -1353,3 +1353,93 @@ async def test_concurrent_calls_do_not_share_strategy_state(self) -> None:\n                 (\"auto\", {}),\n             ],\n         )\n+\n+\n+class _TrackedCleanupModel(MockModel):\n+    \"\"\"Model with observable asynchronous stream cleanup.\"\"\"\n+\n+    def __init__(self) -> None:\n+        \"\"\"Initialize cleanup events.\"\"\"\n+        super().__init__(model=\"mock-model\", stream=True)\n+        self.cleanup_started = asyncio.Event()\n+        self.cleanup_finished = asyncio.Event()\n+        self.release_cleanup = asyncio.Event()\n+\n+    async def _call_api(\n+        self,\n+        *args: Any,\n+        **kwargs: Any,\n+    ) -> AsyncGenerator[ChatResponse, None]:\n+        \"\"\"Return a stream with gated cleanup.\"\"\"\n+        del args, kwargs\n+        release_cleanup = self.release_cleanup\n+        cleanup_started = self.cleanup_started\n+        cleanup_finished = self.cleanup_finished\n+\n+        async def _inner() -> AsyncGenerator[ChatResponse, None]:\n+            try:\n+                yield ChatResponse(\n+                    content=[TextBlock(text=\"hello\", id=\"t1\")],\n+                    is_last=False,\n+                )\n+                yield ChatResponse(\n+                    content=[TextBlock(text=\" world\", id=\"t1\")],\n+                    is_last=False,\n+                )\n+            finally:\n+                cleanup_started.set()\n+                await release_cleanup.wait()\n+                cleanup_finished.set()\n+\n+        return _inner()\n+\n+\n+class StreamDelegatedCloseTest(IsolatedAsyncioTestCase):\n+    \"\"\"Test delegated stream cleanup.\"\"\"\n+\n+    async def test_aclose_after_first_chunk_closes_delegated_stream(\n+        self,\n+    ) -> None:\n+        \"\"\"Close the delegated stream after one chunk.\"\"\"\n+        model = _TrackedCleanupModel()\n+        model.release_cleanup.set()\n+        messages = [UserMsg(name=\"user\", content=\"hi\")]\n+        gen = await model(messages=messages)\n+        try:\n+            first = await anext(gen)\n+            self.assertEqual(first.content[0].text, \"hello\")\n+            self.assertFalse(model.cleanup_finished.is_set())\n+            await gen.aclose()\n+            self.assertTrue(model.cleanup_started.is_set())\n+            self.assertTrue(model.cleanup_finished.is_set())\n+        finally:\n+            model.release_cleanup.set()\n+            await gen.aclose()\n+\n+    async def test_aclose_waits_for_asynchronous_cleanup(self) -> None:\n+        \"\"\"Wait for delegated asynchronous cleanup.\"\"\"\n+        model = _TrackedCleanupModel()\n+        messages = [UserMsg(name=\"user\", content=\"hi\")]\n+        gen = await model(messages=messages)\n+        returned: list[str] = []\n+\n+        async def _close() -> None:\n+            await gen.aclose()\n+            returned.append(\"returned\")\n+\n+        try:\n+            first = await anext(gen)\n+            self.assertEqual(first.content[0].text, \"hello\")\n+            close_task = asyncio.create_task(_close())\n+            await asyncio.wait_for(model.cleanup_started.wait(), timeout=1)\n+            await asyncio.sleep(0)\n+            self.assertFalse(close_task.done())\n+            self.assertFalse(model.cleanup_finished.is_set())\n+            self.assertEqual(returned, [])\n+            model.release_cleanup.set()\n+            await asyncio.wait_for(close_task, timeout=1)\n+            self.assertEqual(returned, [\"returned\"])\n+            self.assertTrue(model.cleanup_finished.is_set())\n+        finally:\n+            model.release_cleanup.set()\n+            await gen.aclose()\ndiff --git a/tests/model_openai_response_test.py b/tests/model_openai_response_test.py\nindex b6788e68dc..edae075386 100644\n--- a/tests/model_openai_response_test.py\n+++ b/tests/model_openai_response_test.py\n@@ -5,12 +5,14 @@\n Tests cover both non-streaming and streaming modes.\n OpenAI Responses API uses event-based streaming with response.completed.\n \"\"\"\n+import asyncio\n from typing import Any, cast\n import unittest\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock\n \n-from openai import APIError\n+import httpx\n+from openai import APIError, AsyncOpenAI\n from openai.types.responses import ResponseOutputMessage\n from pydantic import BaseModel\n \n@@ -1612,3 +1614,64 @@ def test_no_tool_choice(self) -> None:\n         fmt_tools, fmt_choice = self.model._format_tools(_FT_TOOLS, None)\n         self.assertEqual(fmt_tools, _FT_TOOLS_RESPONSE)\n         self.assertIsNone(fmt_choice)\n+\n+\n+class _TrackedBody(httpx.AsyncByteStream):\n+    \"\"\"HTTP body with observable cleanup.\"\"\"\n+\n+    def __init__(self) -> None:\n+        \"\"\"Initialize the body state.\"\"\"\n+        self.closed = False\n+        self.stop = asyncio.Event()\n+\n+    async def __aiter__(self) -> Any:\n+        \"\"\"Yield one SSE event and wait.\"\"\"\n+        yield (\n+            b'data: {\"type\":\"response.output_text.delta\",'\n+            b'\"sequence_number\":0,\"item_id\":\"msg_1\",\"output_index\":0,'\n+            b'\"content_index\":0,\"delta\":\"hello\"}\\n\\n'\n+        )\n+        await self.stop.wait()\n+\n+    async def aclose(self) -> None:\n+        \"\"\"Close and unblock the body.\"\"\"\n+        self.closed = True\n+        self.stop.set()\n+\n+\n+class TestPublicModelStreamClose(IsolatedAsyncioTestCase):\n+    \"\"\"Test public stream cleanup.\"\"\"\n+\n+    async def test_aclose_closes_offline_httpx_response(self) -> None:\n+        \"\"\"Test cleanup through the OpenAI SDK and HTTPX transport.\"\"\"\n+        body = _TrackedBody()\n+\n+        def _handler(_request: httpx.Request) -> httpx.Response:\n+            return httpx.Response(\n+                200,\n+                headers={\"content-type\": \"text/event-stream\"},\n+                stream=body,\n+            )\n+\n+        transport = httpx.MockTransport(_handler)\n+        client = AsyncOpenAI(\n+            api_key=\"offline-test\",\n+            http_client=httpx.AsyncClient(transport=transport),\n+        )\n+        model = _make_model(stream=True)\n+        original_client = model.client\n+        model.client = client\n+        stream = None\n+        try:\n+            stream = await model([])\n+            first = await anext(stream)\n+            self.assertEqual(first.content[0].text, \"hello\")\n+            self.assertFalse(body.closed)\n+            await stream.aclose()\n+            self.assertTrue(body.closed)\n+        finally:\n+            if stream is not None:\n+                await stream.aclose()\n+            await body.aclose()\n+            await client.close()\n+            await original_client.close()\n", "problem_statement": "[Bug]: Closing the public model stream does not await provider response cleanup\n### Prerequisites\n\n- [x] I searched existing issues and discussions; the related fixes and remaining difference are described below.\n- [x] This is a reproducible lifecycle bug, not a usage question.\n\n### Background / Description\n\nA consumer can explicitly close the async generator returned by `await OpenAIResponseModel(...)(messages)` after reading a chunk, but that awaited `aclose()` returns before the underlying provider response is closed.\n\nThis matters for callers that stop displaying a streamed reply early and use `aclose()` or `contextlib.aclosing` to release the response before leaving their request scope. The provider resource is instead left to later async-generator finalization. This report does not claim a measured permanent connection leak or provider billing impact.\n\nThe public `ChatModelBase.__call__` returns its own `_stream()` generator. Its `async for chunk in res` delegates iteration but has no `finally` that closes `res`. Consequently, closing the outer generator does not await the parser generator's `async with response` exit.\n\nRelated merged PR #2349 already put the Responses parser inside an async context manager, and #2350 did the same for Anthropic. The remaining failure reproduced here is one layer above those parsers: explicitly closing the **public returned generator**. #2757 concerns retries/fallback after iteration errors, which is a different contract. I did not find an open proposal for this exact outer-to-inner close propagation.\n\n### Error Messages\n\nThe standalone offline reproducer prints:\n\n```text\nfirst chunk: hello\nHTTP body closed after awaited aclose: False\n```\n\nExpected: `True` before the awaited public `aclose()` returns. A regression asserting that property fails on current main. A separate parser-transport mock regression fails in the same way (2 tests, 2 failures); existing Responses/formatter/accumulator tests pass (59 tests, 14 subtests).\n\n### Steps to Reproduce\n\nUse a checkout of main `a833ab9fc13e99c80f893ddefe1898d8d61335bd`, install its dependencies, and run the following with `src` on `PYTHONPATH`. It uses the real OpenAI SDK SSE parser and HTTPX response lifecycle with an in-process `MockTransport`; it makes no network/model-provider call and needs no real API key.\n\n```python\n\"\"\"Offline reproduction of public model-stream close propagation.\"\"\"\nimport asyncio\n\nimport httpx\nfrom openai import AsyncOpenAI\n\nfrom agentscope.credential import OpenAICredential\nfrom agentscope.model import OpenAIResponseModel\n\n\nclass TrackedBody(httpx.AsyncByteStream):\n    def __init__(self):\n        self.closed = False\n        self.stop = asyncio.Event()\n\n    async def __aiter__(self):\n        yield (\n            b'data: {\"type\":\"response.output_text.delta\",'\n            b'\"sequence_number\":0,\"item_id\":\"msg_1\",\"output_index\":0,'\n            b'\"content_index\":0,\"delta\":\"hello\"}\\n\\n'\n        )\n        await self.stop.wait()\n\n    async def aclose(self):\n        self.closed = True\n        self.stop.set()\n\n\nasync def main():\n    body = TrackedBody()\n    transport = httpx.MockTransport(\n        lambda request: httpx.Response(\n            200, headers={\"content-type\": \"text/event-stream\"}, stream=body\n        )\n    )\n    client = AsyncOpenAI(\n        api_key=\"offline-test\",\n        http_client=httpx.AsyncClient(transport=transport),\n    )\n    model = OpenAIResponseModel(\n        credential=OpenAICredential(api_key=\"offline-test\"),\n        model=\"o4-mini\",\n        stream=True,\n        context_size=200_000,\n    )\n    model.client = client\n    stream = await model([])\n    try:\n        first = await anext(stream)\n        print(\"first chunk:\", first.content[0].text)\n        await stream.aclose()\n        print(\"HTTP body closed after awaited aclose:\", body.closed)\n    finally:\n        await stream.aclose()\n        await body.aclose()\n        await client.close()\n        await asyncio.sleep(0)\n\n\nasyncio.run(main())\n\n```\n\n`python repro.py` produces the output above. The `finally` block explicitly cleans up the test transport so reproducing the bug does not leave it running.\n\n### Environment\n\n- AgentScope: `2.0.10dev`, main `a833ab9fc13e99c80f893ddefe1898d8d61335bd`\n- Python: 3.13.15\n- OS: Windows\n- OpenAI Python SDK: 3.14.1\n- HTTPX: 0.28.1\n- Source inspection and both regression cases were run locally; this is not a claim about every released AgentScope version.\n\n### Proposed approach\n\nHave the base stream wrapper await closure of its delegated async generator in `finally`, including consumer `aclose()`, while preserving normal accumulated final responses and existing interruption behavior. I can prepare a focused change and tests covering real SDK response closure, waiting for asynchronous cleanup, and existing cancellation/error behavior. No automatic retry or fallback change is proposed.\n\nCodex assisted with source inspection and reproduction. The code and outputs above were executed locally; no human review of a prospective implementation is claimed here.\n### Local fix progress (2026-10-10)\n\nI have prepared a focused local fix: the base wrapper awaits the delegated generator's `aclose()` in `finally` when available. Three new regressions fail against the unchanged main commit above and pass with the fix: closing after the first chunk, real SDK/HTTPX response closure using an offline transport, and waiting until asynchronous cleanup finishes. The selected model/formatter suite passes with 131 tests and 26 subtests; all applicable pre-commit hooks for the two changed files pass. The standalone reproduction now reports `HTTP body closed after awaited aclose: True`.\n\nI intend to submit this fix after completing the project's human-author review requirements and remaining submission checks. This is a local candidate, not a published PR or a claim that the full repository suite has run. Codex assisted with the implementation and test execution as well as the investigation.\n", "hints_text": "/assign\nIt's yours, @HsbcJone. If there is no pull request and no word from you by 2026-10-24 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-10T04:11:38Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3205, "instance_id": "agentscope-ai__agentscope-3205", "issue_numbers": ["3203"], "base_commit": "a833ab9fc13e99c80f893ddefe1898d8d61335bd", "patch": "diff --git a/examples/rag/README.md b/examples/rag/README.md\nindex b61842d294..8ead542f4e 100644\n--- a/examples/rag/README.md\n+++ b/examples/rag/README.md\n@@ -7,16 +7,16 @@ Two library-mode walk-throughs of `agentscope.rag` \u2014 no FastAPI service, no ma\n | [`index_and_search.py`](./index_and_search.py) | The minimal pipeline: parse \u2192 chunk \u2192 embed \u2192 insert, then `KnowledgeBase.search`. Start here. |\n | [`integrate_with_agent.py`](./integrate_with_agent.py) | Attaches the same `KnowledgeBase` to an `Agent` via `RAGMiddleware`, in both `static` (auto-inject) and `agentic` (tool-driven) modes. |\n \n-Both examples use an in-memory Qdrant store (`location=\":memory:\"`) and the DashScope `text-embedding-v4` model, so no external services are required. The sections below show how to swap in Milvus Lite, MongoDB, or Elasticsearch instead; those backends need additional setup.\n+Both examples use an in-memory Qdrant store (`location=\":memory:\"`), so no external vector database is required. They use the DashScope `text-embedding-v4` model and require DashScope API access and a `DASHSCOPE_API_KEY`. The sections below show how to swap in Milvus Lite, MongoDB, or Elasticsearch instead; those backends need additional setup.\n \n ## Install\n \n ```bash\n # From PyPI\n-uv pip install \"agentscope[rag]\"\n+uv pip install \"agentscope[rag,vdb-qdrant]\"\n \n # Or from source (repo root)\n-uv pip install -e \".[rag]\"\n+uv pip install -e \".[rag,vdb-qdrant]\"\n ```\n \n ### Milvus Lite (local persistence)\n@@ -230,7 +230,7 @@ store = ElasticsearchStore(\n \n | | Qdrant (default) | Milvus Lite | MongoDB | Elasticsearch |\n | --- | --- | --- | --- | --- |\n-| Install extra | `agentscope[rag]` | `agentscope[vdb-milvus]` | `agentscope[vdb-mongodb]` | `agentscope[vdb-elasticsearch]` |\n+| Install extra | `agentscope[vdb-qdrant]` | `agentscope[vdb-milvus]` | `agentscope[vdb-mongodb]` | `agentscope[vdb-elasticsearch]` |\n | External service | No | No | Yes | Yes |\n | Persistence | No (`:memory:`) | Yes (local `.db`) | Yes (server) | Yes (server) |\n | Best for | Quick start / tests | Local dev with persistence | Teams already on MongoDB | Teams already on Elastic or needing distributed kNN search |\n", "test_patch": "", "problem_statement": "[Bug]: RAG example setup omits the required Qdrant extra\n## Prerequisites\n\n- [x] I searched existing issues, pull requests, and publicly indexed discussions and did not find a matching report for these setup instructions.\n- [x] This is a reproducible example setup problem, not a usage question.\n\n## Background / Description\n\nThe [RAG example README](https://github.com/agentscope-ai/agentscope/blob/a833ab9fc13e99c80f893ddefe1898d8d61335bd/examples/rag/README.md) tells users to install `agentscope[rag]` or `.[rag]`, but both default scripts use `QdrantStore(location=\":memory:\")`.\n\nThe current [optional dependency definitions](https://github.com/agentscope-ai/agentscope/blob/a833ab9fc13e99c80f893ddefe1898d8d61335bd/pyproject.toml) intentionally keep document parsers in `rag` and `qdrant-client` in `vdb-qdrant`. Installing only `rag` therefore leaves the example's default vector backend unavailable. The README's backend comparison table also incorrectly lists `agentscope[rag]` as Qdrant's install extra.\n\nThe extras split introduced in #2157 is intentional; this proposal corrects the example instructions rather than changing package dependencies.\n\n## Error Messages\n\n```text\n  File \"src/agentscope/rag/_vdb/_qdrant.py\", line 104, in get_client\n    from qdrant_client import AsyncQdrantClient\nModuleNotFoundError: No module named 'qdrant_client'\n```\n\n## Steps to Reproduce\n\nFrom the repository root, use a fresh environment. The following Windows commands demonstrate the dependency required by the default example without reading an API key or making a model request:\n\n```powershell\nuv venv --python 3.11 .venv-rag-check\nuv pip install --python .venv-rag-check/Scripts/python.exe -e \".[rag]\"\n.venv-rag-check/Scripts/python.exe -c \"from agentscope.rag import QdrantStore; QdrantStore(location=':memory:').get_client()\"\n```\n\nActual: the last command raises the missing-module error above.\n\nExpected: the documented installation includes the dependencies for the example's default backend.\n\nIn the same environment, install the combined extras:\n\n```powershell\nuv pip install --python .venv-rag-check/Scripts/python.exe -e \".[rag,vdb-qdrant]\"\n.venv-rag-check/Scripts/python.exe -c \"import asyncio; from agentscope.rag import QdrantStore; client = QdrantStore(location=':memory:').get_client(); asyncio.run(client.close()); print('local client created and closed')\"\n```\n\nI verified the missing dependency in a fresh editable-install environment. After installing the combined extras, the same local probe constructed and closed `AsyncQdrantClient` successfully. No Qdrant server or provider call was used.\n\n## Environment\n\n- AgentScope `2.0.10dev`, source commit `a833ab9fc13e99c80f893ddefe1898d8d61335bd`.\n- Windows 10.0.26200, Python 3.11.9, uv 0.11.24.\n- Successful local client probe used qdrant-client 1.19.1.\n- Validation covers the editable source installation and local client creation/closure. The published PyPI installation, complete examples, model calls, and full CI were not run.\n\n## Proposed Scope\n\nI would like to contribute this focused documentation fix in `examples/rag/README.md`:\n\n1. Use `agentscope[rag,vdb-qdrant]` and `.[rag,vdb-qdrant]` in the two default install commands.\n2. List `agentscope[vdb-qdrant]` in the Qdrant column of the backend table, consistently with the other backend-specific entries.\n3. Clarify that the examples require no external vector database, while DashScope API access and `DASHSCOPE_API_KEY` are still required.\n\nPlease let me know if someone is already handling this, or if you prefer a different scope. I would like to take the documentation change once this issue is available for assignment. The runtime dependency design does not need to change.\n\nCodex assisted with investigation, local validation, and drafting. No implementation or PR has been submitted.\n\n", "hints_text": "/assign\n\nI would like to take this documentation fix. I have reproduced the missing Qdrant dependency in a fresh source-install environment and verified that the combined extras allow the local client to be created and closed. I plan to keep the change limited to the README's installation commands, backend table, and the clarification about external vector databases versus DashScope API access.\n\nIt's yours, @shuxiachai. If there is no pull request and no word from you by 2026-10-23 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-09T12:46:30Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3204, "instance_id": "agentscope-ai__agentscope-3204", "issue_numbers": ["3202"], "base_commit": "a833ab9fc13e99c80f893ddefe1898d8d61335bd", "patch": "diff --git a/src/agentscope/rag/_parser/_excel.py b/src/agentscope/rag/_parser/_excel.py\nindex 7e02149ade..0f385fc441 100644\n--- a/src/agentscope/rag/_parser/_excel.py\n+++ b/src/agentscope/rag/_parser/_excel.py\n@@ -76,6 +76,72 @@ def _extract_table_data(df: Any) -> list[list[str]]:\n     return rows\n \n \n+def _restore_native_excel_errors(\n+    df: Any,\n+    excel_file: Any,\n+    sheet_name: str,\n+) -> None:\n+    \"\"\"Restore native Excel error text that pandas converted to NaN.\n+\n+    The openpyxl reader maps cells of Excel type ``e`` (``#DIV/0!``,\n+    ``#N/A``, and the other stored error values) to NaN before\n+    ``dtype=object`` and ``keep_default_na=False`` can preserve them.\n+    Those values are copied back from the workbook pandas already\n+    opened, and only into cells that are still missing.  Blanks, text,\n+    and numbers are left as pandas read them.  Formulas are not\n+    evaluated, and ``.xls`` workbooks are left unchanged.\n+\n+    Args:\n+        df (`pandas.DataFrame`):\n+            Sheet data read with ``header=None``.\n+        excel_file (`pandas.ExcelFile`):\n+            The open Excel file whose ``book`` holds the worksheet.\n+        sheet_name (`str`):\n+            Name of the sheet ``df`` was read from.\n+    \"\"\"\n+    import pandas as pd\n+\n+    if df.empty or not df.isna().any().any():\n+        return\n+\n+    # ``sheetnames`` is openpyxl-only.  xlrd books (``.xls``) are skipped\n+    # rather than guessing which NaNs are errors.\n+    book = getattr(excel_file, \"book\", None)\n+    if book is None:\n+        return\n+    sheetnames = getattr(book, \"sheetnames\", None)\n+    if sheetnames is None or sheet_name not in sheetnames:\n+        return\n+\n+    worksheet = book[sheet_name]\n+    if not hasattr(worksheet, \"iter_rows\"):\n+        return\n+\n+    # Local import: openpyxl is an optional RAG dependency.\n+    from openpyxl.cell.cell import TYPE_ERROR\n+\n+    n_rows, n_cols = df.shape\n+    for row in worksheet.iter_rows():\n+        for cell in row:\n+            # Empty padding cells use data type \"n\", not TYPE_ERROR.\n+            if getattr(cell, \"data_type\", None) != TYPE_ERROR:\n+                continue\n+            value = getattr(cell, \"value\", None)\n+            if not isinstance(value, str) or not value:\n+                continue\n+            row_idx = getattr(cell, \"row\", 0) - 1\n+            col_idx = getattr(cell, \"column\", 0) - 1\n+            if (\n+                row_idx < 0\n+                or col_idx < 0\n+                or row_idx >= n_rows\n+                or col_idx >= n_cols\n+            ):\n+                continue\n+            if pd.isna(df.iat[row_idx, col_idx]):\n+                df.iat[row_idx, col_idx] = value\n+\n+\n def _extract_images_from_worksheet(\n     worksheet: Any,\n     filename: str,\n@@ -325,6 +391,18 @@ def _parse_sheet(\n         # Keep the first row as cell data: pandas column labels would rename\n         # duplicate headers and replace blank headers with \"Unnamed: ...\".\n         if not df.empty:\n+            # Pandas turns native Excel error cells into NaN.  Copy the\n+            # stored error text back before those NaNs are rendered as\n+            # blanks.  Other missing cells stay empty.\n+            try:\n+                _restore_native_excel_errors(df, excel_file, sheet_name)\n+            except Exception as e:\n+                logger.warning(\n+                    \"Failed to restore native Excel errors in sheet '%s': \"\n+                    \"%s\",\n+                    sheet_name,\n+                    e,\n+                )\n             table_data = _extract_table_data(df)\n \n             if self.table_format == \"markdown\":\n", "test_patch": "diff --git a/tests/rag_parser_test.py b/tests/rag_parser_test.py\nindex 314242896e..b1ff96fd66 100644\n--- a/tests/rag_parser_test.py\n+++ b/tests/rag_parser_test.py\n@@ -1602,6 +1602,139 @@ async def test_text_and_na_like_values_kept(self) -> None:\n             ],\n         )\n \n+    async def test_native_error_cells_preserved(self) -> None:\n+        \"\"\"Stored Excel error values stay visible in both renderers.\n+\n+        pandas' openpyxl reader turns type ``e`` cells into NaN.  The\n+        parser must copy those stored values back, while blanks, text,\n+        numbers, and unevaluated formulas stay as they were.\n+        \"\"\"\n+        from openpyxl import Workbook\n+\n+        workbook = Workbook()\n+        sheet = workbook.active\n+        sheet.title = \"Errors\"\n+        sheet.append([\"Case\", \"Value\", \"Note\"])\n+        sheet.append([\"#NULL!\", \"text-after\", 1])\n+        sheet.append([\"native_div0\", \"#DIV/0!\", None])\n+        sheet.append([\"blank\", None, \"still-blank\"])\n+        sheet.append([\"text_na\", \"NA\", \"00123\"])\n+        sheet.append([\"integer\", 42, None])\n+        sheet.append([\"literal\", \"#GETTING_DATA\", \"N/A\"])\n+        sheet.append([\"formula\", \"=1/0\", None])\n+        sheet.append([\"native_na\", \"#N/A\", \"#VALUE!\"])\n+        self.assertEqual(sheet[\"A2\"].data_type, \"e\")\n+        self.assertEqual(sheet[\"A2\"].value, \"#NULL!\")\n+        self.assertEqual(sheet[\"B3\"].data_type, \"e\")\n+        self.assertEqual(sheet[\"B3\"].value, \"#DIV/0!\")\n+        self.assertEqual(sheet[\"B9\"].data_type, \"e\")\n+        self.assertEqual(sheet[\"C9\"].data_type, \"e\")\n+        self.assertEqual(sheet[\"C9\"].value, \"#VALUE!\")\n+        self.assertEqual(sheet[\"B7\"].data_type, \"s\")\n+        self.assertEqual(sheet[\"B8\"].data_type, \"f\")\n+        self.assertIsNone(sheet[\"B4\"].value)\n+        buffer = io.BytesIO()\n+        workbook.save(buffer)\n+        workbook.close()\n+        payload = buffer.getvalue()\n+\n+        rows = [\n+            [\"Case\", \"Value\", \"Note\"],\n+            [\"#NULL!\", \"text-after\", \"1\"],\n+            [\"native_div0\", \"#DIV/0!\", \"\"],\n+            [\"blank\", \"\", \"still-blank\"],\n+            [\"text_na\", \"NA\", \"00123\"],\n+            [\"integer\", \"42\", \"\"],\n+            [\"literal\", \"#GETTING_DATA\", \"N/A\"],\n+            [\"formula\", \"\", \"\"],\n+            [\"native_na\", \"#N/A\", \"#VALUE!\"],\n+        ]\n+        markdown = (\n+            \"| Case | Value | Note |\\n\"\n+            \"| --- | --- | --- |\\n\"\n+            \"| #NULL! | text-after | 1 |\\n\"\n+            \"| native_div0 | #DIV/0! |  |\\n\"\n+            \"| blank |  | still-blank |\\n\"\n+            \"| text_na | NA | 00123 |\\n\"\n+            \"| integer | 42 |  |\\n\"\n+            \"| literal | #GETTING_DATA | N/A |\\n\"\n+            \"| formula |  |  |\\n\"\n+            \"| native_na | #N/A | #VALUE! |\\n\"\n+        )\n+        markdown_coords = (\n+            \"| [A1] Case | [B1] Value | [C1] Note |\\n\"\n+            \"| --- | --- | --- |\\n\"\n+            \"| [A2] #NULL! | [B2] text-after | [C2] 1 |\\n\"\n+            \"| [A3] native_div0 | [B3] #DIV/0! | [C3]  |\\n\"\n+            \"| [A4] blank | [B4]  | [C4] still-blank |\\n\"\n+            \"| [A5] text_na | [B5] NA | [C5] 00123 |\\n\"\n+            \"| [A6] integer | [B6] 42 | [C6]  |\\n\"\n+            \"| [A7] literal | [B7] #GETTING_DATA | [C7] N/A |\\n\"\n+            \"| [A8] formula | [B8]  | [C8]  |\\n\"\n+            \"| [A9] native_na | [B9] #N/A | [C9] #VALUE! |\\n\"\n+        )\n+\n+        for table_format in (\"markdown\", \"json\"):\n+            for coordinates in (False, True):\n+                with self.subTest(\n+                    table_format=table_format,\n+                    coordinates=coordinates,\n+                ):\n+                    parser = ExcelParser(\n+                        table_format=table_format,\n+                        include_cell_coordinates=coordinates,\n+                        include_sheet_names=False,\n+                    )\n+                    sections = await parser.parse(payload, \"errors.xlsx\")\n+                    self.assertEqual(len(sections), 1)\n+                    text = sections[0].content.text\n+                    if table_format == \"markdown\":\n+                        expected = markdown_coords if coordinates else markdown\n+                    elif coordinates:\n+                        body = \"\\n\".join(\n+                            json.dumps(\n+                                {\n+                                    f\"{'ABC'[col]}{row + 1}\": cell\n+                                    for col, cell in enumerate(values)\n+                                },\n+                                ensure_ascii=False,\n+                            )\n+                            for row, values in enumerate(rows)\n+                        )\n+                        expected = (\n+                            \"<system-info>A table loaded as a JSON \"\n+                            f\"array:</system-info>\\n{body}\"\n+                        )\n+                    else:\n+                        body = \"\\n\".join(\n+                            json.dumps(values, ensure_ascii=False)\n+                            for values in rows\n+                        )\n+                        expected = (\n+                            \"<system-info>A table loaded as a JSON \"\n+                            f\"array:</system-info>\\n{body}\"\n+                        )\n+                    self.assertEqual(\n+                        [section.model_dump() for section in sections],\n+                        [\n+                            {\n+                                \"content\": {\n+                                    \"type\": \"text\",\n+                                    \"text\": expected,\n+                                    \"id\": AnyString(),\n+                                    \"created_at\": AnyString(),\n+                                    \"finished_at\": None,\n+                                },\n+                                \"source\": \"errors.xlsx\",\n+                                \"metadata\": {},\n+                            },\n+                        ],\n+                    )\n+                    self.assertIn(\"#DIV/0!\", text)\n+                    self.assertIn(\"#N/A\", text)\n+                    self.assertIn(\"#VALUE!\", text)\n+                    self.assertIn(\"#NULL!\", text)\n+\n     async def test_multi_sheet_merged_by_default(self) -> None:\n         \"\"\"``separate_sheet=False`` (default) merges sheets into one\n         Section.\"\"\"\n", "problem_statement": "[Bug]: ExcelParser silently replaces native Excel error cells with empty strings\n## Prerequisites\n\n- [x] I searched existing issues, pull requests, and public discussions and did not find a duplicate of this native error-cell behavior.\n- [x] This report describes reproducible data loss, not a usage question.\n\n## Background / Description\n\n`ExcelParser` silently drops stored Excel error values such as `#DIV/0!` and `#N/A`. Both Markdown and JSON output render those cells as empty strings, so an error becomes indistinguishable from a genuinely blank cell before content reaches the RAG pipeline.\n\nThis differs from #2818, fixed by #2893: ordinary string cells are preserved by the existing `dtype=object, keep_default_na=False` options. Native error cells have Excel type `e`; pandas' openpyxl reader converts them to `NaN` before those options can preserve their contents. AgentScope's `_extract_table_data()` then maps that `NaN` to `\"\"`.\n\nI searched existing issues and pull requests for ExcelParser error cells, native Excel errors, `#DIV/0!`, and related NA handling, and rechecked on 2026-10-09. I did not find a matching fix. Please let me know if this overlaps ongoing work.\n\n## Error Messages\n\nThe parser raises no exception; it silently returns empty strings in place of stored error values. The minimal example below prints the incorrect output. A separate preservation assertion fails for the native error cells.\n\n## Steps to Reproduce\n\nNo Excel application, model, API key, network request, or formula evaluation is needed.\n\n```python\nimport asyncio\nfrom io import BytesIO\nfrom openpyxl import Workbook\nfrom agentscope.rag import ExcelParser\n\nasync def main():\n    book = Workbook()\n    sheet = book.active\n    sheet.append([\"Case\", \"Value\"])\n    sheet.append([\"native_error\", \"#DIV/0!\"])\n    sheet.append([\"blank\", None])\n    assert sheet[\"B2\"].data_type == \"e\"\n    buffer = BytesIO()\n    book.save(buffer)\n    book.close()\n    sections = await ExcelParser(include_sheet_names=False).parse(\n        buffer.getvalue(), \"errors.xlsx\"\n    )\n    print(sections[0].content.text)\n\nasyncio.run(main())\n```\n\nSave the example as `reproduce.py` and run `python reproduce.py` in an environment with AgentScope and its `rag` extra installed.\n\nActual:\n\n```text\n| Case | Value |\n| --- | --- |\n| native_error |  |\n| blank |  |\n```\n\nExpected: preserve `#DIV/0!` in the `native_error` row and keep the `blank` row empty. This follows the parser's existing source-content preservation behavior; please confirm that retaining native error text is the intended policy.\n\n## Environment and Verification\n\n- Tested AgentScope `2.0.10dev` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`.\n- On 2026-10-09, upstream `main` was `a833ab9fc13e99c80f893ddefe1898d8d61335bd`. Its [Excel parser](https://github.com/agentscope-ai/agentscope/blob/a833ab9fc13e99c80f893ddefe1898d8d61335bd/src/agentscope/rag/_parser/_excel.py) has the identical Git blob (`7e02149ade2f85581e2f10d7e65cbbfac0aaf35c`) as the tested checkout. This is a source comparison; the full updated checkout was not executed locally.\n- Windows 10.0.26200, Python 3.11.9, pandas 3.0.6, openpyxl 3.1.5.\n- An in-memory XLSX round trip through openpyxl preserves the native error cells; pandas shows NaN for those same cells. Both AgentScope renderers lose them. Literal error-looking text, `NA`, integers, and genuine blanks serve as controls.\n- Existing parser/chunker baseline on the tested commit: `python -m pytest -q tests/rag_parser_test.py tests/rag_chunker_approx_token_test.py` with `PYTEST_DISABLE_PLUGIN_AUTOLOAD=1`: **68 passed, 6 subtests passed**, re-run on 2026-10-09. No upstream code was changed.\n- `.xls` error values, other dependency versions/platforms, full CI, and real RAG retrieval were not tested.\n\n## Proposed Scope / Questions\n\nA possible focused approach is to recover only native error-cell values from the already-open workbook before rendering the table, while retaining existing blank/text/number behavior. It should not replace arbitrary NaNs with guessed errors or recalculate formulas.\n\nIs anyone already working on this? Does preserving native error text match the intended behavior, and would you prefer the first patch to cover `.xlsx` only or both `.xlsx` and `.xls`? I would add regression coverage using real workbook data for error values and normal controls, both renderers, and coordinate options, following the existing Section assertions.\n\nInvestigation and reproduction used Codex assistance. No implementation or duplicate PR has been submitted; I will review and understand any proposed patch before submitting it.\n\n", "hints_text": "/assign\nThis issue is still being verified. Please comment again once it is confirmed, and it is yours.\n/assign\nIt's yours, @HsbcJone. If there is no pull request and no word from you by 2026-10-23 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-09T12:31:03Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3201, "instance_id": "agentscope-ai__agentscope-3201", "issue_numbers": ["3200"], "base_commit": "a833ab9fc13e99c80f893ddefe1898d8d61335bd", "patch": "diff --git a/src/agentscope/workspace/_base.py b/src/agentscope/workspace/_base.py\nindex 2f782ceba0..f60d53b756 100644\n--- a/src/agentscope/workspace/_base.py\n+++ b/src/agentscope/workspace/_base.py\n@@ -80,7 +80,9 @@\n from ..mcp import MCPClient\n from ..message import (\n     Base64Source,\n+    ContentBlock,\n     DataBlock,\n+    HintBlock,\n     Msg,\n     TextBlock,\n     ToolResultBlock,\n@@ -1017,9 +1019,10 @@ async def offload_context(\n         Appends every message in ``msgs`` to\n         ``${workdir}/sessions/<session_id>/context.jsonl`` (one\n         message per JSONL line). Inline base64\n-        :class:`DataBlock` payloads are extracted into ``data/`` and\n-        rewritten as portable ``workspace://`` URL blocks before\n-        serialisation so the JSONL line size stays bounded.\n+        :class:`DataBlock` payloads, including those in tool results and\n+        hints, are extracted into ``data/`` and rewritten as portable\n+        ``workspace://`` URL sources before serialisation so the JSONL\n+        line size stays bounded.\n \n         Args:\n             session_id (`str`):\n@@ -1038,19 +1041,38 @@ async def offload_context(\n         base = backend.join_path(self._sessions_dir, session_id)\n         path = backend.join_path(base, \"context.jsonl\")\n \n+        async def offload_block(block: ContentBlock) -> ContentBlock:\n+            \"\"\"Offload inline media from a copied content block.\n+\n+            Args:\n+                block (`ContentBlock`):\n+                    The copied block to inspect.\n+\n+            Returns:\n+                `ContentBlock`:\n+                    The block with inline media replaced by workspace URLs.\n+            \"\"\"\n+            if isinstance(block, DataBlock) and isinstance(\n+                block.source,\n+                Base64Source,\n+            ):\n+                return await self.offload_data_block(block)\n+            if isinstance(block, ToolResultBlock) and isinstance(\n+                block.output,\n+                list,\n+            ):\n+                block.output = [\n+                    await offload_block(item) for item in block.output\n+                ]\n+            elif isinstance(block, HintBlock) and isinstance(block.hint, list):\n+                block.hint = [await offload_block(item) for item in block.hint]\n+            return block\n+\n         copied = deepcopy(msgs)\n         lines: list[str] = []\n         for msg in copied:\n             if not isinstance(msg.content, str):\n-                content: list = []\n-                for block in msg.content:\n-                    if isinstance(block, DataBlock) and isinstance(\n-                        block.source,\n-                        Base64Source,\n-                    ):\n-                        block = await self.offload_data_block(block)\n-                    content.append(block)\n-                msg.content = content\n+                msg.content = [await offload_block(b) for b in msg.content]\n             lines.append(msg.model_dump_json())\n \n         payload = \"\\n\".join(lines) + \"\\n\"\n", "test_patch": "diff --git a/tests/workspace_local_test.py b/tests/workspace_local_test.py\nindex 725918a910..ecdc8643d5 100644\n--- a/tests/workspace_local_test.py\n+++ b/tests/workspace_local_test.py\n@@ -40,6 +40,7 @@\n     UserMsg,\n     AssistantMsg,\n     DataBlock,\n+    HintBlock,\n     Base64Source,\n     URLSource,\n     TextBlock,\n@@ -349,6 +350,62 @@ async def test_offload_context_with_datablock(self) -> None:\n             expected_msg.model_dump_json(),\n         )\n \n+    async def test_offload_context_nested_media(self) -> None:\n+        \"\"\"Offload nested media without changing the caller's message.\"\"\"\n+        data = base64.b64encode(b\"nested media\").decode()\n+        media = DataBlock(\n+            id=\"media\",\n+            source=Base64Source(data=data, media_type=\"image/png\"),\n+            created_at=\"2026-01-01T00:00:00\",\n+        )\n+        msg = AssistantMsg(\n+            name=\"assistant\",\n+            content=[\n+                ToolResultBlock(\n+                    id=\"tool-call\",\n+                    name=\"get_media\",\n+                    output=[media],\n+                    state=ToolResultState.SUCCESS,\n+                    created_at=\"2026-01-01T00:00:00\",\n+                ),\n+                HintBlock(\n+                    id=\"hint\",\n+                    hint=[media],\n+                    created_at=\"2026-01-01T00:00:00\",\n+                ),\n+            ],\n+            id=\"message\",\n+            created_at=\"2026-01-01T00:00:00\",\n+        )\n+        original = msg.model_dump(mode=\"json\")\n+\n+        path = await self.workspace.offload_context(\"nested-media\", [msg])\n+        saved = Msg.model_validate_json(\n+            await self.workspace.get_backend().read_file(path),\n+        )\n+\n+        url = (\n+            \"workspace:///data/\"\n+            f\"{hashlib.sha256(data.encode()).hexdigest()}.png\"\n+        )\n+        expected = msg.model_dump(mode=\"json\")\n+        for index, field in ((0, \"output\"), (1, \"hint\")):\n+            expected[\"content\"][index][field][0] = {\n+                \"type\": \"data\",\n+                \"id\": \"media\",\n+                \"source\": {\n+                    \"type\": \"url\",\n+                    \"url\": url,\n+                    \"media_type\": \"image/png\",\n+                },\n+                \"name\": None,\n+                \"created_at\": AnyString(),\n+                \"finished_at\": None,\n+            }\n+\n+        self.assertEqual(saved.model_dump(mode=\"json\"), expected)\n+        self.assertEqual(msg.model_dump(mode=\"json\"), original)\n+\n     async def test_offload_data_block_deduplication(self) -> None:\n         \"\"\"Test that duplicate DataBlocks are deduplicated.\n \n", "problem_statement": "[Bug]: Nested Base64 media remains embedded when compressed context is archived\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nWhen context compression replaces older messages with a summary, `WorkspaceBase.offload_context()` can preserve the removed messages in `sessions/<session_id>/context.jsonl`.\n\nThe existing implementation extracts Base64 media from top-level `DataBlock` objects into the workspace `data/` directory and replaces the archived source with a `workspace://` URL. However, the message model also allows `DataBlock` objects inside:\n\n- `ToolResultBlock.output`\n- `HintBlock.hint`\n\nThese nested blocks are not currently inspected, so their complete Base64 payloads remain embedded in `context.jsonl`.\n\nFor example, this is a valid message structure:\n\n```python\nAssistantMsg(\n    name=\"assistant\",\n    content=[\n        ToolResultBlock(\n            id=\"call-1\",\n            name=\"get_image\",\n            output=[\n                DataBlock(\n                    source=Base64Source(\n                        data=image_base64,\n                        media_type=\"image/png\",\n                    ),\n                ),\n            ],\n            state=ToolResultState.SUCCESS,\n        ),\n    ],\n)\n```\n\nAfter `offload_context()` processes this message, the nested `source` is still serialized as:\n\n```json\n{\n  \"type\": \"base64\",\n  \"media_type\": \"image/png\",\n  \"data\": \"<complete Base64 payload>\"\n}\n```\n\nA top-level `DataBlock` containing the same media is instead stored in the workspace data directory and archived as:\n\n```json\n{\n  \"type\": \"url\",\n  \"url\": \"workspace:///data/<content-hash>.png\",\n  \"media_type\": \"image/png\"\n}\n```\n\nNested media should use the same existing offloading behavior. The archived copy should contain the `workspace://` source, while the original message supplied by the caller remains unchanged.\n\n#2146 changes only the message copies sent to context summarization and intentionally preserves the original messages used for workspace offloading. This issue covers that separate archival path.\n\n### Error Messages\n\n```shell\nNo exception is raised. The complete Base64 payload remains embedded in context.jsonl.\n```\n\n### Steps to Reproduce\n\n1. Create an `AssistantMsg` containing a Base64-backed `DataBlock` in `ToolResultBlock.output`.\n2. Pass the message to `WorkspaceBase.offload_context()`.\n3. Read the resulting `sessions/<session_id>/context.jsonl`.\n4. Observe that the nested source still has `\"type\": \"base64\"` and contains the complete payload.\n5. Move the same `DataBlock` to the top level of the message and repeat the operation.\n6. Observe that the top-level source is replaced with a `workspace://` URL.\n\nThe same omission occurs for a `DataBlock` inside `HintBlock.hint`.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev\n- Python Version: 3.14.7\n- OS: macOS 26.6.1 (arm64)\n\n", "hints_text": "", "created_at": "2026-10-09T09:14:46Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3199, "instance_id": "agentscope-ai__agentscope-3199", "issue_numbers": ["3197"], "base_commit": "a833ab9fc13e99c80f893ddefe1898d8d61335bd", "patch": "diff --git a/src/agentscope/embedding/_openai/_model.py b/src/agentscope/embedding/_openai/_model.py\nindex ee39019964..d0f95a3720 100644\n--- a/src/agentscope/embedding/_openai/_model.py\n+++ b/src/agentscope/embedding/_openai/_model.py\n@@ -126,7 +126,9 @@ async def _call_api(\n                 Extra keyword arguments forwarded to the OpenAI API.\n \n         Returns:\n-            `EmbeddingResponse`: Embedding vectors and usage info.\n+            `EmbeddingResponse`: Embedding vectors and usage info. The token\n+            count is ``None`` when a compatible endpoint omits usage, while\n+            the elapsed time is still recorded.\n         \"\"\"\n         api_kwargs: dict[str, Any] = {\n             \"input\": inputs,\n@@ -173,7 +175,11 @@ async def _call_api(\n         return EmbeddingResponse(\n             embeddings=embeddings,\n             usage=EmbeddingUsage(\n-                tokens=response.usage.total_tokens,\n+                tokens=(\n+                    response.usage.total_tokens\n+                    if response.usage is not None\n+                    else None\n+                ),\n                 time=time,\n             ),\n         )\n", "test_patch": "diff --git a/tests/embedding_openai_test.py b/tests/embedding_openai_test.py\nindex a796116913..e625140171 100644\n--- a/tests/embedding_openai_test.py\n+++ b/tests/embedding_openai_test.py\n@@ -2,6 +2,7 @@\n # pylint: disable=protected-access\n \"\"\"Unit tests for OpenAIEmbeddingModel.\"\"\"\n from dataclasses import asdict\n+import json\n from typing import Any\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock, patch\n@@ -63,6 +64,87 @@ async def test_list_models(self) -> None:\n class OpenAIEmbeddingCallTest(IsolatedAsyncioTestCase):\n     \"\"\"Test OpenAI embedding API calls with mocked responses.\"\"\"\n \n+    async def _check_sdk_usage(\n+        self,\n+        include_usage: bool,\n+        tokens: int | None,\n+    ) -> None:\n+        \"\"\"Exercise SDK parsing with an offline compatible endpoint.\"\"\"\n+        import httpx\n+        import openai\n+\n+        payload: dict[str, Any] = {\n+            \"object\": \"list\",\n+            \"model\": \"compatible-embedding\",\n+            \"data\": [\n+                {\"object\": \"embedding\", \"index\": 0, \"embedding\": [0.1, 0.2]},\n+            ],\n+        }\n+        if include_usage:\n+            payload[\"usage\"] = (\n+                {\"prompt_tokens\": tokens, \"total_tokens\": tokens}\n+                if tokens is not None\n+                else None\n+            )\n+        requests = []\n+\n+        def handle(request: httpx.Request) -> httpx.Response:\n+            self.assertEqual(request.method, \"POST\")\n+            self.assertEqual(request.url.path, \"/v1/embeddings\")\n+            self.assertEqual(json.loads(request.content)[\"input\"], [\"hello\"])\n+            requests.append(request)\n+            return httpx.Response(200, json=payload)\n+\n+        async with openai.AsyncClient(\n+            api_key=\"test-key\",\n+            base_url=\"https://embedding.invalid/v1\",\n+            http_client=httpx.AsyncClient(\n+                transport=httpx.MockTransport(handle),\n+            ),\n+            max_retries=0,\n+        ) as client:\n+            with patch(\"openai.AsyncClient\", return_value=client):\n+                model = OpenAIEmbeddingModel(\n+                    credential=OpenAICredential(api_key=\"test-key\"),\n+                    model=\"compatible-embedding\",\n+                    dimensions=2,\n+                    max_retries=0,\n+                )\n+            result = await model([\"hello\"])\n+\n+        self.assertEqual(len(requests), 1)\n+        self.assertDictEqual(\n+            asdict(result),\n+            {\n+                \"embeddings\": [[0.1, 0.2]],\n+                \"id\": A,\n+                \"created_at\": A,\n+                \"type\": \"embedding\",\n+                \"usage\": {\n+                    \"tokens\": tokens,\n+                    \"time\": A,\n+                    \"type\": \"embedding\",\n+                },\n+                \"source\": \"api\",\n+            },\n+        )\n+\n+    async def test_sdk_omitted_usage(self) -> None:\n+        \"\"\"Omitted usage must not discard otherwise valid embeddings.\"\"\"\n+        await self._check_sdk_usage(include_usage=False, tokens=None)\n+\n+    async def test_sdk_null_usage(self) -> None:\n+        \"\"\"Explicit null usage leaves the token count unknown.\"\"\"\n+        await self._check_sdk_usage(include_usage=True, tokens=None)\n+\n+    async def test_sdk_reported_usage(self) -> None:\n+        \"\"\"Reported token counts are preserved after SDK parsing.\"\"\"\n+        await self._check_sdk_usage(include_usage=True, tokens=7)\n+\n+    async def test_sdk_zero_usage(self) -> None:\n+        \"\"\"A reported zero is distinct from an unknown token count.\"\"\"\n+        await self._check_sdk_usage(include_usage=True, tokens=0)\n+\n     @patch(\"openai.AsyncClient\")\n     async def test_single_batch(self, mock_client_cls: Any) -> None:\n         \"\"\"Single batch call returns correct embeddings.\"\"\"\n", "problem_statement": "[Bug]: OpenAI embedding crashes when a compatible endpoint omits usage\n## Background / Description\n\n`OpenAIEmbeddingModel` fails after an otherwise successful embedding request when an OpenAI-compatible endpoint omits `usage`, or returns `\"usage\": null`. The OpenAI SDK represents either case as `response.usage is None`, but `_call_api` always reads `response.usage.total_tokens`.\n\nReproduced on current `main` a833ab9fc13e99c80f893ddefe1898d8d61335bd with the real OpenAI SDK and an in-memory HTTP transport. No live provider or credentials are needed. The same payload with `usage={\"prompt_tokens\": 7, \"total_tokens\": 7}` returns the expected vector and reports 7 tokens.\n\n## Error Messages\n\n```text\nAttributeError: 'NoneType' object has no attribute 'total_tokens'\n```\n\nBoth an omitted `usage` field and explicit `usage: null` produce this error.\n\n## Steps to Reproduce\n\n```python\nimport asyncio\nimport httpx\nimport openai\nfrom agentscope.credential import OpenAICredential\nfrom agentscope.embedding import OpenAIEmbeddingModel\n\nasync def main():\n    payload = {\n        \"object\": \"list\",\n        \"model\": \"compat-embedding\",\n        \"data\": [{\"object\": \"embedding\", \"index\": 0, \"embedding\": [0.1, 0.2]}],\n    }\n    transport = httpx.MockTransport(lambda request: httpx.Response(200, json=payload))\n    model = OpenAIEmbeddingModel(\n        credential=OpenAICredential(api_key=\"test-key-not-secret\"),\n        model=\"compat-embedding\",\n        dimensions=2,\n        max_retries=0,\n    )\n    await model.client.close()\n    async with httpx.AsyncClient(transport=transport) as http_client:\n        async with openai.AsyncClient(\n            api_key=\"test-key-not-secret\",\n            base_url=\"https://embedding.invalid/v1\",\n            http_client=http_client,\n        ) as client:\n            model.client = client\n            print(await model([\"hello\"]))\n\nasyncio.run(main())\n```\n\n## Expected Behavior / Proposed Scope\n\nReturn the valid embedding vectors even when usage is unavailable. `EmbeddingUsage.tokens` already supports `None` for unavailable counts, so a focused change could retain the measured request time and leave tokens unset when `response.usage is None`. Reported counts, including a reported zero, should stay unchanged.\n\nI'd like to take this on once the issue is confirmed, with offline regressions for omitted, null and reported usage. This would leave batching, caching, retry policy and vector validation unchanged.\n\nRelated downstream report: https://github.com/agentscope-ai/ReMe/issues/598. I have not tested Cloudflare itself; the reproduction above isolates the missing-usage response shape.\n\n## Environment\n\n- AgentScope: `2.0.10dev`, editable current main\n- OpenAI SDK: `3.26.1`\n- Python: `3.12.13`\n- OS: Windows 11\n\n## Prerequisites\n\n- [x] Searched existing issues and the full open-PR list; inspected related embedding diffs, which address batching, cache provenance, endpoint isolation, dimensions and incomplete vectors.\n- [x] This is a reproducible SDK failure, rather than a provider setup question.\n", "hints_text": "/assign\nIt's yours, @jipeng6036-del. If there is no pull request and no word from you by 2026-10-23 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-09T08:56:32Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3192, "instance_id": "agentscope-ai__agentscope-3192", "issue_numbers": ["3191"], "base_commit": "a833ab9fc13e99c80f893ddefe1898d8d61335bd", "patch": "diff --git a/src/agentscope/model/_dashscope/_model.py b/src/agentscope/model/_dashscope/_model.py\nindex b1a828ca91..565361371a 100644\n--- a/src/agentscope/model/_dashscope/_model.py\n+++ b/src/agentscope/model/_dashscope/_model.py\n@@ -50,10 +50,13 @@ class Parameters(BaseModel):\n             gt=0,\n         )\n \n-        thinking_enable: bool = Field(\n-            default=False,\n+        thinking_enable: bool | None = Field(\n+            default=None,\n             title=\"Thinking\",\n-            description=\"The thinking enable for the LLM output.\",\n+            description=(\n+                \"Whether to enable or disable thinking mode. When unset, \"\n+                \"DashScope uses its default behavior for the model.\"\n+            ),\n         )\n \n         thinking_budget: int | None = Field(\n", "test_patch": "diff --git a/tests/model_dashscope_test.py b/tests/model_dashscope_test.py\nindex 89c31de246..bde57ad487 100644\n--- a/tests/model_dashscope_test.py\n+++ b/tests/model_dashscope_test.py\n@@ -251,6 +251,59 @@ async def test_thinking_response(\n             ),\n         )\n \n+    async def test_thinking_enable_not_sent_when_unset(self) -> None:\n+        \"\"\"Unset thinking leaves the server default unchanged.\"\"\"\n+        self.model = DashScopeChatModel(\n+            credential=DashScopeCredential(api_key=\"test\"),\n+            model=\"qwen3-max\",\n+            stream=False,\n+        )\n+        self.model.client = self.mock_client\n+        mock_create = AsyncMock(\n+            return_value=_mock_completion(text=\"Hello!\"),\n+        )\n+        self.mock_client.chat.completions.create = mock_create\n+\n+        await self.model([])\n+\n+        self.assertEqual(\n+            (\n+                self.model.parameters.thinking_enable,\n+                mock_create.await_args.kwargs,\n+            ),\n+            (\n+                None,\n+                {\n+                    \"model\": \"qwen3-max\",\n+                    \"messages\": [],\n+                    \"stream\": False,\n+                    \"extra_body\": {},\n+                },\n+            ),\n+        )\n+\n+    async def test_thinking_enable_explicit_false_is_sent(self) -> None:\n+        \"\"\"Explicitly disabling thinking is forwarded to the API.\"\"\"\n+        self.model.parameters = DashScopeChatModel.Parameters(\n+            thinking_enable=False,\n+        )\n+        mock_create = AsyncMock(\n+            return_value=_mock_completion(text=\"Hello!\"),\n+        )\n+        self.mock_client.chat.completions.create = mock_create\n+\n+        await self.model([])\n+\n+        self.assertEqual(\n+            mock_create.await_args.kwargs,\n+            {\n+                \"model\": \"qwen3-max\",\n+                \"messages\": [],\n+                \"stream\": False,\n+                \"extra_body\": {\"enable_thinking\": False},\n+            },\n+        )\n+\n     async def test_extra_body_is_not_mutated(self) -> None:\n         \"\"\"Model defaults do not mutate the caller-owned extra body.\"\"\"\n         mock_create = AsyncMock(\n", "problem_statement": "[Bug]: DashScopeChatModel force-injects enable_thinking=False into every request even when the caller never configured it\n### Background / Description\n\n`DashScopeChatModel.Parameters.thinking_enable` is declared as a non-optional `bool` with `default=False` (`src/agentscope/model/_dashscope/_model.py:53-57`):\n\n```python\nthinking_enable: bool = Field(\n    default=False,\n    title=\"Thinking\",\n    description=\"The thinking enable for the LLM output.\",\n)\n```\n\nwhile the injection guard in `_call_api` is `is not None` (same file, `:258-262`):\n\n```python\nif self.parameters.thinking_enable is not None:\n    eb.setdefault(\n        \"enable_thinking\",\n        self.parameters.thinking_enable,\n    )\n```\n\nFor a non-optional `bool`, `is not None` is always true \u2014 so even when the caller never configures anything, **every request's `extra_body` is injected with `enable_thinking=False`**. On the DashScope OpenAI-compatible endpoint, Qwen3+ hybrid-reasoning models default to thinking enabled for streaming requests; this injection silently disables thinking for all of them, and the behavior diverges from calling the DashScope API directly.\n\nFor comparison, the volcengine model in this repo declares the same field as tri-state `thinking_enable: bool | None = Field(default=None, ...)` (`model/_volcengine/_model.py:40`) with the identical `is not None` guard \u2014 indicating the DashScope side's `bool` + `default=False` is an inconsistency rather than intent.\n\nNote on prior art: PR #2346 previously attempted a nearby fix (\"only send `enable_thinking` when thinking is enabled\"), which \u2014 as @qbc2016 pointed out \u2014 would remove the ability to *explicitly disable* thinking (some Qwen models default to thinking enabled server-side), and the PR was withdrawn. The tri-state fix below keeps every explicit configuration working and only stops misinterpreting \"caller said nothing\" as \"disable\":\n\n| caller configuration | current | after tri-state |\n|---|---|---|\n| unset (`None`) | force-injects `enable_thinking=False` | **not sent** \u2014 server default applies |\n| explicit `False` | injects `enable_thinking=False` | unchanged (disable capability preserved) |\n| explicit `True` | injects `enable_thinking=True` | unchanged |\n\nFix: declare the field tri-state, matching the volcengine model (1-line change); the existing `is not None` guard needs no change:\n\n```python\nthinking_enable: bool | None = Field(\n    default=None,\n    title=\"Thinking\",\n    description=\"Whether to enable or disable thinking mode. When unset, ...\",\n)\n```\n\nRelated: #1765/#1774 fixed `thinking_enable` pass-through for the OpenAI-compatible Qwen path \u2014 faithful toggle forwarding is already the goal on the OpenAI-compatible side; this report is about the native DashScope path. I have the patch and regression tests ready and can submit a PR once confirmed.\n\n### Error Messages\n\nNo exception is raised \u2014 the forced injection is silent. Payload captured with zero configuration (mocked transport, no API key):\n\n```text\ncaptured[\"extra_body\"] == {'enable_thinking': False}\n```\n\nExpected: `{}` (caller never configured `thinking_enable`, so the flag should not be sent).\nActual: `{'enable_thinking': False}` \u2014 thinking mode force-disabled for Qwen3+ models.\n\nRegression test: `tests/model_dashscope_thinking_enable_test.py::test_dashscope_thinking_enable_not_sent_when_unset` fails on `main` with `AssertionError: enable_thinking was force-injected even though the caller never set thinking_enable: {'enable_thinking': False}`.\n\n### Steps to Reproduce\n\n1. Code:\n\n```python\nimport asyncio\n\nfrom agentscope.credential import DashScopeCredential\nfrom agentscope.message import UserMsg\nfrom agentscope.model import DashScopeChatModel\n\nmodel = DashScopeChatModel(\n    credential=DashScopeCredential(api_key=\"sk-test\"),\n    model=\"qwen-plus\",\n    stream=False,\n)\ncaptured = {}\n\n\nasync def fake_create(**kwargs):\n    captured.update(kwargs)\n    raise RuntimeError(\"captured\")  # capture the payload, never touch network\n\n\nmodel.client.chat.completions.create = fake_create\n\ntry:\n    asyncio.run(\n        model._call_api(\"qwen-plus\", [UserMsg(name=\"user\", content=\"hi\")])\n    )\nexcept RuntimeError:\n    pass\n\nprint(captured[\"extra_body\"])\n```\n\n2. Run: `python repro.py`\n\n3. See output \u2014 the caller configured nothing, yet the flag is injected:\n\n```text\n{'enable_thinking': False}\n```\n\n### Environment\n\n- **AgentScope Version:** 2.0.10dev (main @ `72f3f6f`)\n- **Python Version:** 3.12.10\n- **OS:** Windows 11 (10.0.22621)\n", "hints_text": "", "created_at": "2026-10-09T03:29:37Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3190, "instance_id": "agentscope-ai__agentscope-3190", "issue_numbers": ["3189"], "base_commit": "906d4ef743fbc28a4a967a4ae55adda008c7f6ff", "patch": "diff --git a/src/agentscope/app/_service/_webrtc_session.py b/src/agentscope/app/_service/_webrtc_session.py\nindex 612baa3be2..53a8b0442e 100644\n--- a/src/agentscope/app/_service/_webrtc_session.py\n+++ b/src/agentscope/app/_service/_webrtc_session.py\n@@ -56,6 +56,9 @@ def __init__(\n         self._close_task: asyncio.Task[None] | None = None\n         self._close_lock = asyncio.Lock()\n         self._closing = False\n+        self._closed = False\n+        self._startup_complete = False\n+        self._finalizing = False\n         self._lock_acquired = asyncio.Event()\n         self._persisted_messages: dict[str, str] = {}\n         self._open_user_replies: set[str] = set()\n@@ -65,8 +68,12 @@ def __init__(\n \n     def start(self) -> None:\n         \"\"\"Start the agent pump after WebRTC negotiation succeeds.\"\"\"\n-        if self._task is not None:\n-            raise RuntimeError(\"The WebRTC session is already running.\")\n+        if (\n+            self._task is not None\n+            or self._closing\n+            or self._close_task is not None\n+        ):\n+            raise RuntimeError(\"The WebRTC session is running or closed.\")\n         self._task = asyncio.create_task(\n             self._run(),\n             name=f\"webrtc-session-{self.session_id}\",\n@@ -74,10 +81,10 @@ def start(self) -> None:\n \n     def request_close(self) -> None:\n         \"\"\"Schedule one owned close task from a synchronous callback.\"\"\"\n-        if self._closing or self._close_task is not None:\n+        if self._close_task is not None:\n             return\n         self._close_task = asyncio.create_task(\n-            self.close(),\n+            self._close(),\n             name=f\"webrtc-session-close-{self.session_id}\",\n         )\n         self._close_task.add_done_callback(self._on_close_done)\n@@ -96,18 +103,39 @@ def _on_close_done(self, task: asyncio.Task[None]) -> None:\n \n     async def close(self) -> None:\n         \"\"\"End the transport and wait for persistence to finish.\"\"\"\n+        self.request_close()\n+        assert self._close_task is not None\n+        await asyncio.shield(self._close_task)\n+\n+    async def _close(self) -> None:\n+        \"\"\"Own shutdown independently of cancellation of close callers.\"\"\"\n+        task = self._task\n         async with self._close_lock:\n             if not self._closing:\n                 self._closing = True\n                 await self.transport.close()\n+                if (\n+                    task is not None\n+                    and task is not asyncio.current_task()\n+                    and not self._startup_complete\n+                    and not self._finalizing\n+                ):\n+                    task.cancel()\n \n-        task = self._task\n         if task is not None and task is not asyncio.current_task():\n-            if not self._lock_acquired.is_set():\n-                task.cancel()\n-            await asyncio.gather(task, return_exceptions=True)\n-        elif task is None:\n+            await asyncio.gather(asyncio.shield(task), return_exceptions=True)\n+        # A task cancelled before its first step never enters _run's finally.\n+        await self._close_resources()\n+\n+    async def _close_resources(self) -> None:\n+        \"\"\"Close the peer and retire this session exactly once.\"\"\"\n+        async with self._close_lock:\n+            if self._closed:\n+                return\n+            self._closing = True\n+            await self.transport.close()\n             await self.peer_connection.close()\n+            self._closed = True\n             self._on_closed(self)\n \n     async def wait_until_lock_acquired(self, timeout: float) -> bool:\n@@ -123,6 +151,8 @@ async def wait_until_lock_acquired(self, timeout: float) -> bool:\n \n     async def _run(self) -> None:\n         \"\"\"Hold the session lock while forwarding events to the SSE log.\"\"\"\n+        if self._close_task is not None:\n+            return\n         try:\n             async with self.message_bus.acquire_lock(\n                 MessageBusKeys.session_lock(self.session_id),\n@@ -137,6 +167,7 @@ async def _run(self) -> None:\n                     }\n                     async with self.transport:\n                         async with self.agent:\n+                            self._startup_complete = True\n                             async for event in self.agent.reply_stream(\n                                 self.transport,\n                             ):\n@@ -195,6 +226,7 @@ async def _run(self) -> None:\n                                             exc,\n                                         )\n                 finally:\n+                    self._finalizing = True\n                     try:\n                         async with self.message_bus.acquire_lock(\n                             MessageBusKeys.session_event_checkpoint_lock(\n@@ -233,9 +265,13 @@ async def _run(self) -> None:\n             )\n             async with self._close_lock:\n                 self._closing = True\n-            await self.transport.close()\n-            await self.peer_connection.close()\n-            self._on_closed(self)\n+            try:\n+                if self.agent is not None and not self._startup_complete:\n+                    # __aexit__ is not called when provider setup is cancelled\n+                    # during the agent's __aenter__.\n+                    await self.agent.close()\n+            finally:\n+                await self._close_resources()\n \n     async def _checkpoint_state(\n         self,\n", "test_patch": "diff --git a/tests/webrtc_audio_transport_test.py b/tests/webrtc_audio_transport_test.py\nindex b83a74a549..de57699daa 100644\n--- a/tests/webrtc_audio_transport_test.py\n+++ b/tests/webrtc_audio_transport_test.py\n@@ -20,6 +20,7 @@\n from fastapi import HTTPException\n \n from agentscope.agent import RealtimeAgent\n+from agentscope.credential import GeminiCredential\n from agentscope.app._router._realtime import _create_realtime_offer\n from agentscope.app._router._schema import (\n     RealtimeOfferRequest,\n@@ -49,7 +50,9 @@\n from agentscope.realtime import (\n     AudioFrame,\n     DashScopeAudioRealtimeModel,\n+    GeminiRealtimeModel,\n     RealtimeModelBase,\n+    RealtimeModelCard,\n )\n from agentscope.realtime import _events as me\n from agentscope.tool import FunctionTool, Toolkit\n@@ -165,6 +168,34 @@ def checkpoint_snapshot(self, event: Any) -> object | None:\n         return None\n \n \n+class _UnacknowledgedSetupSocket:\n+    \"\"\"Keep a real Gemini connect waiting for its setup acknowledgement.\"\"\"\n+\n+    def __init__(self) -> None:\n+        self.setup_sent = asyncio.Event()\n+        self.closed = False\n+        self._incoming: asyncio.Queue[str | None] = asyncio.Queue()\n+\n+    async def send(self, frame: str) -> None:\n+        \"\"\"Record that the model sent its setup frame.\"\"\"\n+        del frame\n+        self.setup_sent.set()\n+\n+    def __aiter__(self) -> \"_UnacknowledgedSetupSocket\":\n+        return self\n+\n+    async def __anext__(self) -> str:\n+        frame = await self._incoming.get()\n+        if frame is None:\n+            raise StopAsyncIteration\n+        return frame\n+\n+    async def close(self) -> None:\n+        \"\"\"Close the socket and release the provider's reader.\"\"\"\n+        self.closed = True\n+        self._incoming.put_nowait(None)\n+\n+\n class _FakeTransport:\n     \"\"\"Idempotently closing transport double.\"\"\"\n \n@@ -1625,6 +1656,383 @@ async def _create_agent() -> _FakeAgent:\n             },\n         )\n \n+    async def test_closed_session_rejects_a_late_start(self) -> None:\n+        \"\"\"A retired session must not launch another provider connection.\"\"\"\n+        create_agent = AsyncMock()\n+        session = _make_session(\n+            agent_factory=create_agent,\n+            storage=_FakeStorage(),\n+            message_bus=_FakeMessageBus(),\n+            on_closed=lambda _: None,\n+        )\n+        await session.close()\n+        try:\n+            with self.assertRaises(RuntimeError):\n+                session.start()\n+            create_agent.assert_not_awaited()\n+        finally:\n+            if session._task is not None:\n+                session._task.cancel()\n+                await asyncio.gather(session._task, return_exceptions=True)\n+\n+    async def test_close_before_runner_starts_is_idempotent(self) -> None:\n+        \"\"\"Cancellation before the task's first step still owns cleanup.\"\"\"\n+        transport = _FakeTransport()\n+        peer_connection = _FakePeerConnection()\n+        create_agent = AsyncMock()\n+        closed_sessions: list[WebRTCSession] = []\n+        session = _make_session(\n+            transport=transport,\n+            peer_connection=peer_connection,\n+            agent_factory=create_agent,\n+            storage=_FakeStorage(),\n+            message_bus=_FakeMessageBus(),\n+            on_closed=closed_sessions.append,\n+        )\n+        session.start()\n+        await session.close()\n+        await session.close()\n+        create_agent.assert_not_awaited()\n+        self.assertTrue(transport.closed)\n+        self.assertTrue(peer_connection.closed)\n+        self.assertEqual(closed_sessions, [session])\n+\n+    async def test_close_cancels_agent_assembly_after_lock_acquisition(\n+        self,\n+    ) -> None:\n+        \"\"\"Owning the run lock does not make unfinished startup drainable.\"\"\"\n+        entered = asyncio.Event()\n+        cancelled = asyncio.Event()\n+        transport = _FakeTransport()\n+        peer_connection = _FakePeerConnection()\n+        message_bus = _FakeMessageBus()\n+        storage = _FakeStorage()\n+        closed_sessions: list[WebRTCSession] = []\n+\n+        async def _create_agent() -> _FakeAgent:\n+            entered.set()\n+            try:\n+                await asyncio.Event().wait()\n+            finally:\n+                cancelled.set()\n+            raise AssertionError(\"The blocked factory must be cancelled.\")\n+\n+        session = _make_session(\n+            transport=transport,\n+            peer_connection=peer_connection,\n+            agent_factory=_create_agent,\n+            storage=storage,\n+            message_bus=message_bus,\n+            on_closed=closed_sessions.append,\n+        )\n+        session.start()\n+        close_task: asyncio.Task[None] | None = None\n+        try:\n+            await asyncio.wait_for(entered.wait(), timeout=1)\n+            self.assertTrue(await session.wait_until_lock_acquired(1))\n+            close_task = asyncio.create_task(session.close())\n+            await asyncio.wait_for(asyncio.shield(close_task), timeout=1)\n+            self.assertTrue(cancelled.is_set())\n+            self.assertTrue(transport.closed)\n+            self.assertTrue(peer_connection.closed)\n+            self.assertFalse(message_bus.held_locks)\n+            self.assertEqual(storage.calls, [])\n+            self.assertEqual(closed_sessions, [session])\n+        finally:\n+            if session._task is not None:\n+                session._task.cancel()\n+                await asyncio.gather(session._task, return_exceptions=True)\n+            if close_task is not None:\n+                await asyncio.gather(close_task, return_exceptions=True)\n+\n+    async def test_close_cancels_provider_setup_and_closes_its_socket(\n+        self,\n+    ) -> None:\n+        \"\"\"A cancelled agent __aenter__ must still release its model reader.\"\"\"\n+        socket = _UnacknowledgedSetupSocket()\n+        model = GeminiRealtimeModel(\n+            \"test-gemini\",\n+            credential=GeminiCredential(api_key=\"test-key\"),\n+            model_card=RealtimeModelCard(\n+                name=\"test-gemini\",\n+                label=\"test\",\n+                input_sample_rate=16_000,\n+                output_sample_rate=24_000,\n+            ),\n+        )\n+        agent = RealtimeAgent(name=\"test\", system_prompt=\"\", model=model)\n+        transport = _FakeTransport()\n+        peer_connection = _FakePeerConnection()\n+        message_bus = _FakeMessageBus()\n+        storage = _LockAwareStorage(message_bus)\n+        closed_sessions: list[WebRTCSession] = []\n+\n+        async def _create_agent() -> RealtimeAgent:\n+            return agent\n+\n+        session = _make_session(\n+            transport=transport,\n+            peer_connection=peer_connection,\n+            agent_factory=_create_agent,\n+            storage=storage,\n+            message_bus=message_bus,\n+            on_closed=closed_sessions.append,\n+        )\n+        close_task: asyncio.Task[None] | None = None\n+        with patch(\"websockets.connect\", AsyncMock(return_value=socket)):\n+            session.start()\n+            try:\n+                await asyncio.wait_for(socket.setup_sent.wait(), timeout=1)\n+                self.assertTrue(await session.wait_until_lock_acquired(1))\n+                close_task = asyncio.create_task(session.close())\n+                await asyncio.wait_for(asyncio.shield(close_task), timeout=1)\n+                self.assertTrue(socket.closed)\n+                self.assertIsNone(model._reader)\n+                self.assertTrue(peer_connection.closed)\n+                self.assertTrue(transport.closed)\n+                self.assertFalse(message_bus.held_locks)\n+                self.assertEqual(storage.writes_under_session_lock, [True])\n+                self.assertEqual(closed_sessions, [session])\n+            finally:\n+                if session._task is not None:\n+                    session._task.cancel()\n+                    await asyncio.gather(session._task, return_exceptions=True)\n+                if close_task is not None:\n+                    await asyncio.gather(close_task, return_exceptions=True)\n+                await agent.close()\n+\n+    async def test_repeated_close_does_not_cancel_startup_cleanup(\n+        self,\n+    ) -> None:\n+        \"\"\"Concurrent close callers must share one startup cancellation.\"\"\"\n+        entered = asyncio.Event()\n+        cleanup_entered = asyncio.Event()\n+        release_cleanup = asyncio.Event()\n+        cleanup_finished = asyncio.Event()\n+        message_bus = _FakeMessageBus()\n+        peer_connection = _FakePeerConnection()\n+        closed_sessions: list[WebRTCSession] = []\n+\n+        async def _create_agent() -> _FakeAgent:\n+            entered.set()\n+            try:\n+                await asyncio.Event().wait()\n+            finally:\n+                cleanup_entered.set()\n+                await release_cleanup.wait()\n+                cleanup_finished.set()\n+            raise AssertionError(\"The blocked factory must be cancelled.\")\n+\n+        session = _make_session(\n+            peer_connection=peer_connection,\n+            agent_factory=_create_agent,\n+            storage=_FakeStorage(),\n+            message_bus=message_bus,\n+            on_closed=closed_sessions.append,\n+        )\n+        close_tasks: list[asyncio.Task[None]] = []\n+        session.start()\n+        try:\n+            await asyncio.wait_for(entered.wait(), timeout=1)\n+            close_tasks.append(asyncio.create_task(session.close()))\n+            await asyncio.wait_for(cleanup_entered.wait(), timeout=1)\n+            close_tasks.append(asyncio.create_task(session.close()))\n+            done, _ = await asyncio.wait(close_tasks, timeout=0.01)\n+            self.assertFalse(done)\n+            self.assertFalse(peer_connection.closed)\n+            release_cleanup.set()\n+            await asyncio.wait_for(asyncio.gather(*close_tasks), timeout=1)\n+            self.assertTrue(cleanup_finished.is_set())\n+            self.assertFalse(message_bus.held_locks)\n+            self.assertEqual(closed_sessions, [session])\n+        finally:\n+            release_cleanup.set()\n+            if session._task is not None:\n+                session._task.cancel()\n+                await asyncio.gather(session._task, return_exceptions=True)\n+            await asyncio.gather(*close_tasks, return_exceptions=True)\n+\n+    async def test_cancelled_close_caller_keeps_final_persistence_alive(\n+        self,\n+    ) -> None:\n+        \"\"\"Closing an active session waits for its owned persistence task.\"\"\"\n+        write_entered = asyncio.Event()\n+        release_write = asyncio.Event()\n+        message_bus = _FakeMessageBus()\n+        peer_connection = _FakePeerConnection()\n+        closed_sessions: list[WebRTCSession] = []\n+\n+        class BlockingStorage(_LockAwareStorage):\n+            \"\"\"Hold the final write until the close callers are waiting.\"\"\"\n+\n+            async def update_session_state(self, **kwargs: object) -> None:\n+                \"\"\"Wait before committing the owned final state snapshot.\"\"\"\n+                write_entered.set()\n+                await release_write.wait()\n+                await super().update_session_state(**kwargs)\n+\n+        storage = BlockingStorage(message_bus)\n+        agent = _FakeAgent({\"id\": \"existing-message\", \"role\": \"assistant\"}, [])\n+\n+        async def _create_agent() -> _FakeAgent:\n+            return agent\n+\n+        session = _make_session(\n+            peer_connection=peer_connection,\n+            agent_factory=_create_agent,\n+            storage=storage,\n+            message_bus=message_bus,\n+            on_closed=closed_sessions.append,\n+        )\n+        close_tasks: list[asyncio.Task[None]] = []\n+        session.start()\n+        try:\n+            await asyncio.wait_for(write_entered.wait(), timeout=1)\n+            close_tasks = [\n+                asyncio.create_task(session.close()),\n+                asyncio.create_task(session.close()),\n+            ]\n+            done, _ = await asyncio.wait(close_tasks, timeout=0.01)\n+            self.assertFalse(done)\n+            close_tasks[0].cancel()\n+            await asyncio.gather(close_tasks[0], return_exceptions=True)\n+            self.assertIsNotNone(session._task)\n+            self.assertFalse(session._task.done())\n+            self.assertIn(\n+                MessageBusKeys.session_lock(\"session-1\"),\n+                message_bus.held_locks,\n+            )\n+            release_write.set()\n+            await asyncio.wait_for(close_tasks[1], timeout=1)\n+            self.assertEqual(storage.writes_under_session_lock, [True])\n+            self.assertFalse(message_bus.held_locks)\n+            self.assertTrue(peer_connection.closed)\n+            self.assertEqual(closed_sessions, [session])\n+        finally:\n+            release_write.set()\n+            if session._task is not None:\n+                session._task.cancel()\n+                await asyncio.gather(session._task, return_exceptions=True)\n+            await asyncio.gather(*close_tasks, return_exceptions=True)\n+\n+    async def test_cancelled_close_caller_keeps_transport_cleanup_alive(\n+        self,\n+    ) -> None:\n+        \"\"\"Caller cancellation must not strand a partially closed transport.\"\"\"\n+        cleanup_entered = asyncio.Event()\n+        release_cleanup = asyncio.Event()\n+        transport = WebRTCAudioTransport(16_000, 24_000)\n+        peer_connection = _FakePeerConnection()\n+        closed_sessions: list[WebRTCSession] = []\n+\n+        async def _read_input() -> None:\n+            try:\n+                await asyncio.Event().wait()\n+            finally:\n+                cleanup_entered.set()\n+                await release_cleanup.wait()\n+\n+        transport._input_task = asyncio.create_task(_read_input())\n+        session = _make_session(\n+            transport=transport,\n+            peer_connection=peer_connection,\n+            agent_factory=AsyncMock(),\n+            storage=_FakeStorage(),\n+            message_bus=_BlockedMessageBus(),\n+            on_closed=closed_sessions.append,\n+        )\n+        session.start()\n+        close_tasks: list[asyncio.Task[None]] = []\n+        try:\n+            await asyncio.sleep(0)\n+            close_tasks.append(asyncio.create_task(session.close()))\n+            await asyncio.wait_for(cleanup_entered.wait(), timeout=1)\n+            close_tasks[0].cancel()\n+            await asyncio.gather(close_tasks[0], return_exceptions=True)\n+            close_tasks.append(asyncio.create_task(session.close()))\n+            release_cleanup.set()\n+            await asyncio.wait_for(asyncio.shield(close_tasks[1]), timeout=1)\n+            self.assertEqual(\n+                {\n+                    \"input_task\": transport._input_task,\n+                    \"transport_closed\": transport._closed,\n+                    \"peer_closed\": peer_connection.closed,\n+                    \"closed_sessions\": closed_sessions,\n+                },\n+                {\n+                    \"input_task\": None,\n+                    \"transport_closed\": True,\n+                    \"peer_closed\": True,\n+                    \"closed_sessions\": [session],\n+                },\n+            )\n+        finally:\n+            release_cleanup.set()\n+            if session._task is not None:\n+                session._task.cancel()\n+                await asyncio.gather(session._task, return_exceptions=True)\n+            await asyncio.gather(*close_tasks, return_exceptions=True)\n+\n+    async def test_close_preserves_final_write_after_startup_failure(\n+        self,\n+    ) -> None:\n+        \"\"\"Failed startup must finish persistence before releasing its lock.\"\"\"\n+        write_entered = asyncio.Event()\n+        release_write = asyncio.Event()\n+        message_bus = _FakeMessageBus()\n+        closed_sessions: list[WebRTCSession] = []\n+\n+        class BlockingStorage(_LockAwareStorage):\n+            \"\"\"Pause the final write after startup has failed.\"\"\"\n+\n+            async def update_session_state(self, **kwargs: object) -> None:\n+                \"\"\"Wait before committing the final snapshot.\"\"\"\n+                write_entered.set()\n+                await release_write.wait()\n+                await super().update_session_state(**kwargs)\n+\n+        agent = AsyncMock()\n+        agent.state = SimpleNamespace(context=[])\n+        agent.__aenter__.side_effect = RuntimeError(\"Setup failed.\")\n+        storage = BlockingStorage(message_bus)\n+        session = _make_session(\n+            agent_factory=AsyncMock(return_value=agent),\n+            storage=storage,\n+            message_bus=message_bus,\n+            on_closed=closed_sessions.append,\n+        )\n+        session.start()\n+        close_task: asyncio.Task[None] | None = None\n+        try:\n+            await asyncio.wait_for(write_entered.wait(), timeout=1)\n+            close_task = asyncio.create_task(session.close())\n+            done, _ = await asyncio.wait([close_task], timeout=0.01)\n+            self.assertEqual(done, set())\n+            release_write.set()\n+            await asyncio.wait_for(asyncio.shield(close_task), timeout=1)\n+            self.assertEqual(\n+                storage.calls,\n+                [\n+                    {\n+                        \"method\": \"update_session_state\",\n+                        \"user_id\": \"alice\",\n+                        \"agent_id\": \"agent-1\",\n+                        \"session_id\": \"session-1\",\n+                        \"state\": agent.state,\n+                    },\n+                ],\n+            )\n+            self.assertEqual(storage.writes_under_session_lock, [True])\n+            self.assertEqual(message_bus.held_locks, set())\n+            self.assertEqual(closed_sessions, [session])\n+            agent.close.assert_awaited_once_with()\n+        finally:\n+            release_write.set()\n+            if session._task is not None:\n+                await asyncio.gather(session._task, return_exceptions=True)\n+            if close_task is not None:\n+                await asyncio.gather(close_task, return_exceptions=True)\n+\n     async def test_checkpoint_boundaries_persist_state(self) -> None:\n         \"\"\"Persist tool boundaries but not ordinary text block endings.\"\"\"\n         message = {\"id\": \"message-1\", \"role\": \"assistant\"}\n", "problem_statement": "[Bug]: WebRTC session close hangs during startup\n## Prerequisites\n\n- [x] Existing issues, PRs, and discussions were searched for duplicate WebRTC/startup shutdown reports.\n- [x] This is a lifecycle bug, not a usage question.\n\n## Background / Description\n\nClosing a `WebRTCSession` can hang if startup acquired the session lock but is still awaiting agent construction or provider setup. Closing the transport does not unblock either await, while `close()` only cancels a runner that has not acquired the lock.\n\nRelated lifecycle edges also need to remain safe: a runner cancelled before its first step never reaches `finally`; repeated closes must not interrupt the first cancellation's cleanup; a cancelled close caller must not cancel final persistence; an already-retired session must not start again.\n\n## Expected behavior\n\n- Closing a session still initializing should cancel its owned startup work and release its agent/provider, peer, transport, registry membership, and session lock.\n- Closing an initialized session should preserve graceful final persistence under its session lock.\n- Closing repeatedly should be idempotent. Cancelling one caller must not cancel the owned runner's final write.\n\n## Error messages\n\nThe primary native regression suite fails on the unmodified implementation:\n\n```text\n5 failed, 16 passed\n```\n\nThe blocked-factory and blocked-provider cases time out while awaiting `session.close()`. The late-start regression independently fails because a closed session accepts `start()`.\n\nAfter the scoped fix: **22 WebRTC tests passed; 143 related tests plus 12 subtests passed**. The related suite was rerun on October 9, 2026.\n\n## Steps to reproduce\n\n1. Use the existing session fixture in `tests/webrtc_audio_transport_test.py` with an asynchronous agent factory that sets an `entered` event and then awaits an unset event.\n2. Call `session.start()`, wait for the factory's event, and verify `await session.wait_until_lock_acquired(1)` is true.\n3. Await `asyncio.wait_for(session.close(), timeout=1)`; it times out on the original implementation.\n4. For the provider variant, instantiate the real `RealtimeAgent` with `GeminiRealtimeModel`, mock `websockets.connect` with a socket that records the setup frame but never returns a setup acknowledgement, and close after the setup frame is sent. The original session close again fails to terminate.\n\nThe companion PR includes runnable regressions for these paths and the ownership edges above. To run the WebRTC file with the required optional dependencies installed:\n\n```sh\npython -m pytest -q tests/webrtc_audio_transport_test.py\n```\n\n## Proposed solution / alternatives\n\nTrack completed startup independently of lock acquisition and cancel only unfinished startup, once. Shield the runner when waiting for initialized-session shutdown; explicitly clean up interrupted agent context entry; centralize idempotent resource retirement.\n\nCancelling every close indiscriminately could interrupt final storage. Adding provider-wide timeouts would broaden scope and would not fix pre-run cancellation or repeated-close ownership. The prepared fix remains within `WebRTCSession` and preserves the existing public interfaces.\n\n## Environment\n\n- AgentScope: `2.0.10dev`.\n- Python: 3.12.13.\n- OS: Linux x86_64.\n- Reproduced base: `c3c1d7fad423fe20d16482df965d05266c03c33b`.\n- Refreshed upstream: `a833ab9fc13e99c80f893ddefe1898d8d61335bd` (affected files unchanged).\n- Fixed head: `e8c5fc829410ecffa8d5340bfa1cf20a5cc943e4`.\n- aiortc 1.15.0, av 17.1.0, websockets 17.2; dedicated test environment.\n\nChanged-file format/lint/type checks passed. No full repository tests, complete pre-commit wrapper, browser E2E, live provider calls, or physical audio devices were used. AI assistance was used for investigation, tests, implementation, and contribution preparation; the human author confirmed responsibility before publication.\n\nPrepared implementation and regression tests: https://github.com/agentscope-ai/agentscope/pull/3190\n\n", "hints_text": "", "created_at": "2026-10-09T02:48:59Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3177, "instance_id": "agentscope-ai__agentscope-3177", "issue_numbers": ["3176"], "base_commit": "402c3664f70cb339f397c5ee40e662bc0d99eed0", "patch": "diff --git a/src/agentscope/workspace/_base.py b/src/agentscope/workspace/_base.py\nindex ce10d213cc..ef3d60f232 100644\n--- a/src/agentscope/workspace/_base.py\n+++ b/src/agentscope/workspace/_base.py\n@@ -1247,7 +1247,8 @@ async def list_skills(\n                 continue\n             try:\n                 raw = await backend.read_file(md_path)\n-                doc = fm.loads(raw.decode(\"utf-8\"))\n+                # Strip an optional UTF-8 BOM before parsing front matter.\n+                doc = fm.loads(raw.decode(\"utf-8-sig\"))\n                 name = doc.get(\"name\")\n                 desc = doc.get(\"description\")\n                 if not name or not desc:\ndiff --git a/src/agentscope/workspace/_local_workspace.py b/src/agentscope/workspace/_local_workspace.py\nindex b51bf34cad..d890b05e64 100644\n--- a/src/agentscope/workspace/_local_workspace.py\n+++ b/src/agentscope/workspace/_local_workspace.py\n@@ -358,7 +358,8 @@ async def _validate_skill(\n \n             # Read and parse SKILL.md\n             raw = await self._backend.read_file(skill_md_path)\n-            content_str = raw.decode(\"utf-8\")\n+            # Strip an optional UTF-8 BOM before parsing front matter.\n+            content_str = raw.decode(\"utf-8-sig\")\n \n             # Parse frontmatter\n             content = frontmatter.loads(content_str)\n@@ -652,7 +653,8 @@ async def _load_single_skill(\n                 updated_at = 0.0\n \n             raw = await self._backend.read_file(skill_md_path)\n-            content_str = raw.decode(\"utf-8\")\n+            # Strip an optional UTF-8 BOM before parsing front matter.\n+            content_str = raw.decode(\"utf-8-sig\")\n             content = frontmatter.loads(content_str)\n \n             description = content.get(\"description\")\n", "test_patch": "diff --git a/tests/workspace_local_test.py b/tests/workspace_local_test.py\nindex 2b7a55eceb..121509f477 100644\n--- a/tests/workspace_local_test.py\n+++ b/tests/workspace_local_test.py\n@@ -1067,6 +1067,136 @@ async def test_list_skills_empty(self) -> None:\n         # Verify empty list is returned\n         self.assertListEqual(skills, [])\n \n+    async def test_add_skill_with_utf8_bom(self) -> None:\n+        \"\"\"Test installing and listing a skill with a UTF-8 BOM.\"\"\"\n+        skill_dir = self._create_test_skill(\n+            \"bom_skill\",\n+            \"Installed despite the BOM\",\n+        )\n+        skill_md_path = os.path.join(skill_dir, \"SKILL.md\")\n+        with open(skill_md_path, \"rb\") as f:\n+            content = f.read()\n+        with open(skill_md_path, \"wb\") as f:\n+            f.write(b\"\\xef\\xbb\\xbf\" + content)\n+\n+        workspace = LocalWorkspace(workdir=self.temp_dir.name)\n+        await workspace.initialize()\n+        await workspace.add_skill(skill_dir)\n+\n+        installed_dir = os.path.join(\n+            self.temp_dir.name,\n+            \"skills\",\n+            \"default\",\n+            \"bom_skill\",\n+        )\n+        skills = await workspace.list_skills()\n+        self.assertListEqual(\n+            [asdict(skill) for skill in skills],\n+            [\n+                {\n+                    \"name\": \"bom_skill\",\n+                    \"description\": \"Installed despite the BOM\",\n+                    \"dir\": installed_dir,\n+                    \"markdown\": \"# bom_skill\\n\\nInstalled despite the BOM\",\n+                    \"updated_at\": os.path.getmtime(\n+                        os.path.join(installed_dir, \"SKILL.md\"),\n+                    ),\n+                },\n+            ],\n+        )\n+\n+    async def test_list_skills_reconciles_utf8_bom_skill(self) -> None:\n+        \"\"\"Test indexing a manually added skill with a UTF-8 BOM.\"\"\"\n+        workspace = LocalWorkspace(workdir=self.temp_dir.name)\n+        await workspace.initialize()\n+\n+        skill_dir = os.path.join(\n+            self.temp_dir.name,\n+            \"skills\",\n+            \"default\",\n+            \"dropped_skill\",\n+        )\n+        os.makedirs(skill_dir)\n+        with open(os.path.join(skill_dir, \"SKILL.md\"), \"wb\") as f:\n+            f.write(\n+                b\"\\xef\\xbb\\xbf---\\n\"\n+                b\"name: dropped_skill\\n\"\n+                b\"description: Dropped with a BOM\\n\"\n+                b\"---\\n\\nBody.\\n\",\n+            )\n+\n+        skills = await workspace.list_skills()\n+        self.assertListEqual(\n+            [asdict(skill) for skill in skills],\n+            [\n+                {\n+                    \"name\": \"dropped_skill\",\n+                    \"description\": \"Dropped with a BOM\",\n+                    \"dir\": skill_dir,\n+                    \"markdown\": \"Body.\",\n+                    \"updated_at\": os.path.getmtime(\n+                        os.path.join(skill_dir, \"SKILL.md\"),\n+                    ),\n+                },\n+            ],\n+        )\n+\n+\n+class _UnindexedWorkspace(WorkspaceBase):  # pylint: disable=abstract-method\n+    \"\"\"Use a local backend to test the base skill listing implementation.\"\"\"\n+\n+    def __init__(self, workdir: str) -> None:\n+        \"\"\"Bind a local backend over ``workdir``.\"\"\"\n+        super().__init__()\n+        self.workdir = workdir\n+        self._backend = LocalBackend()\n+\n+    async def initialize(self) -> None:\n+        \"\"\"Nothing to provision for this workspace.\"\"\"\n+\n+    async def close(self) -> None:\n+        \"\"\"Nothing to release for this workspace.\"\"\"\n+\n+    async def _equip_partition(self, agent_id: str | None) -> str:\n+        \"\"\"Return the partition without copying the seed template.\"\"\"\n+        partition = self._skill_partition(agent_id)\n+        os.makedirs(partition, exist_ok=True)\n+        return partition\n+\n+\n+class TestWorkspaceBaseListSkills(IsolatedAsyncioTestCase):\n+    \"\"\"Front-matter parsing in the default ``WorkspaceBase.list_skills``.\"\"\"\n+\n+    async def test_list_skills_with_utf8_bom(self) -> None:\n+        \"\"\"A BOM-prefixed SKILL.md is listed, not silently dropped.\"\"\"\n+        with tempfile.TemporaryDirectory() as workdir:\n+            workspace = _UnindexedWorkspace(workdir)\n+            partition = await workspace._equip_partition(None)\n+            skill_dir = os.path.join(partition, \"bom_skill\")\n+            os.makedirs(skill_dir)\n+            with open(os.path.join(skill_dir, \"SKILL.md\"), \"wb\") as f:\n+                f.write(\n+                    b\"\\xef\\xbb\\xbf---\\n\"\n+                    b\"name: bom_skill\\n\"\n+                    b\"description: Listed despite the BOM\\n\"\n+                    b\"---\\n\\nBody.\\n\",\n+                )\n+\n+            skills = await workspace.list_skills()\n+\n+        self.assertListEqual(\n+            [asdict(skill) for skill in skills],\n+            [\n+                {\n+                    \"name\": \"bom_skill\",\n+                    \"description\": \"Listed despite the BOM\",\n+                    \"dir\": skill_dir,\n+                    \"markdown\": \"Body.\",\n+                    \"updated_at\": 0.0,\n+                },\n+            ],\n+        )\n+\n \n class TestLocalWorkspaceWithAgent(IsolatedAsyncioTestCase):\n     \"\"\"Test the local workspace class offloading with the agent.\"\"\"\n", "problem_statement": "[Bug]: a BOM-prefixed SKILL.md is rejected or skipped by the workspace skill paths\n### Prerequisites\n\n- [x] I have searched the existing issues and discussions, and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n### Background / Description\n\nA `SKILL.md` saved as UTF-8 **with a byte order mark** (what Windows\neditors such as PowerShell's `Out-File` and many GUI editors write by\ndefault) loses its YAML front matter when the workspace parses it:\n\n- `LocalWorkspace.add_skill()` rejects the directory with\n  `ValueError: Invalid skill at '...': missing or malformed SKILL.md\n  (requires 'name' and 'description' fields)`.\n- `LocalWorkspace.list_skills()` skips such a skill silently \u2014 both when\n  it is dropped into `skills/<partition>/` by hand (the reconcile pass\n  logs \"missing required fields\") and when it is loaded through the\n  partition index.\n- `WorkspaceBase.list_skills()`, the default used by every workspace\n  subclass that does not override it (Docker, E2B, K8s, AppleContainer,\n  OpenSandbox, Bubblewrap), silently omits it too.\n\nThe two earlier BOM fixes did not reach these paths:\n\n- #2735 fixed `LocalSkillLoader` (`skill/_local_loader.py`) to read with\n  `utf-8-sig`;\n- #3119 fixed `ClawSkillHub` (`app/hub/_skill/_claw_hub.py`) to strip\n  the BOM before `frontmatter.loads`.\n\nThe three workspace decode sites still use `raw.decode(\"utf-8\")`, so the\nleading `\\ufeff` hides the opening `---` and the front matter is parsed\nas body text.\n\n### Error Messages\n\n```text\nWARNING agentscope.workspace._local_workspace:_validate_skill:369 -\nInvalid skill at /path/to/skill: SKILL.md missing required fields\n(name or description)\n```\n\n`add_skill` then raises:\n\n```text\nValueError: Invalid skill at '/path/to/skill': missing or malformed\nSKILL.md (requires 'name' and 'description' fields).\n```\n\n### Steps to Reproduce\n\n```python\nimport asyncio\nimport os\nimport tempfile\n\nfrom agentscope.workspace import LocalWorkspace\n\nBOM = b\"\\xef\\xbb\\xbf\"\nSKILL = b\"---\\nname: demo\\ndescription: demo skill\\n---\\n\\nBody.\\n\"\n\n\nasync def main():\n    with tempfile.TemporaryDirectory() as work, \\\n            tempfile.TemporaryDirectory() as src:\n        skill = os.path.join(src, \"demo\")\n        os.makedirs(skill)\n        with open(os.path.join(skill, \"SKILL.md\"), \"wb\") as f:\n            f.write(BOM + SKILL)\n\n        ws = LocalWorkspace(workdir=work)\n        await ws.initialize()\n        await ws.add_skill(skill)   # ValueError on current main\n        await ws.close()\n\n\nasyncio.run(main())\n```\n\n`frontmatter.loads(\"\\ufeff---\\nname: demo\\n---...\")` returns empty\nmetadata, while the same string without the BOM parses normally.\n\n### Expected Behavior\n\nA BOM-prefixed `SKILL.md` installs and lists exactly like the same file\nwithout a BOM, across the workspace skill paths. Decoding with\n`utf-8-sig` \u2014 as `LocalSkillLoader` and `ClawSkillHub` already do \u2014\nstrips only a leading BOM and is identical to plain UTF-8 otherwise.\n\n", "hints_text": "", "created_at": "2026-10-08T11:00:47Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3174, "instance_id": "agentscope-ai__agentscope-3174", "issue_numbers": ["3167"], "base_commit": "48c4b9ce0f9a3f86e5c3385d43cd2220245eef10", "patch": "diff --git a/src/agentscope/classifier/__init__.py b/src/agentscope/classifier/__init__.py\nindex 2811148f5a..968037a156 100644\n--- a/src/agentscope/classifier/__init__.py\n+++ b/src/agentscope/classifier/__init__.py\n@@ -14,10 +14,12 @@\n     ChoiceAnswer,\n     ClassifierAnswer,\n     ClassifierResponse,\n+    RefusalAnswer,\n     ScoreAnswer,\n )\n from ._usage import ClassifierUsage\n from ._jev import JevClassifierModel\n+from ._openai import OpenAIClassifierModel\n \n __all__ = [\n     \"BinaryAnswer\",\n@@ -31,6 +33,8 @@\n     \"ClassifierResponse\",\n     \"ClassifierUsage\",\n     \"JevClassifierModel\",\n+    \"OpenAIClassifierModel\",\n+    \"RefusalAnswer\",\n     \"ScoreAnswer\",\n     \"ScoreQuestion\",\n ]\ndiff --git a/src/agentscope/classifier/_openai/__init__.py b/src/agentscope/classifier/_openai/__init__.py\nnew file mode 100644\nindex 0000000000..bf790dfce7\n--- /dev/null\n+++ b/src/agentscope/classifier/_openai/__init__.py\n@@ -0,0 +1,6 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"The OpenAI Decisions classifier model.\"\"\"\n+\n+from ._model import OpenAIClassifierModel\n+\n+__all__ = [\"OpenAIClassifierModel\"]\ndiff --git a/src/agentscope/classifier/_openai/_model.py b/src/agentscope/classifier/_openai/_model.py\nnew file mode 100644\nindex 0000000000..f5610c7c5a\n--- /dev/null\n+++ b/src/agentscope/classifier/_openai/_model.py\n@@ -0,0 +1,219 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"The OpenAI Decisions API classifier implementation.\"\"\"\n+import json\n+from time import perf_counter\n+from typing import Any, Mapping\n+\n+import openai\n+from pydantic import ConfigDict\n+\n+from .._base import ClassifierModelBase\n+from .._question import (\n+    BinaryQuestion,\n+    ChoiceQuestion,\n+    ClassifierQuestion,\n+    ScoreQuestion,\n+)\n+from .._response import (\n+    BinaryAnswer,\n+    ChoiceAnswer,\n+    ClassifierAnswer,\n+    ClassifierResponse,\n+    RefusalAnswer,\n+    ScoreAnswer,\n+)\n+from .._usage import ClassifierUsage\n+from ...credential import OpenAICredential\n+from ...message import Base64Source, DataBlock, TextBlock\n+\n+\n+def _to_sdk_question(name: str, question: ClassifierQuestion) -> dict:\n+    \"\"\"Translate a named classifier question into a Decisions question.\"\"\"\n+    instructions = question.instructions or name\n+    match question:\n+        case BinaryQuestion():\n+            if question.criteria is not None:\n+                for outcome, description in question.criteria.model_dump(\n+                    exclude_none=True,\n+                ).items():\n+                    instructions += f\"\\n{outcome.capitalize()}: {description}\"\n+            return {\n+                \"type\": \"predicate\",\n+                \"name\": name,\n+                \"instructions\": instructions,\n+            }\n+        case ChoiceQuestion():\n+            return {\n+                \"type\": \"choice\",\n+                \"name\": name,\n+                \"instructions\": instructions,\n+                \"choices\": [\n+                    {\"value\": value, **({\"description\": desc} if desc else {})}\n+                    for value, desc in question.criteria.items()\n+                ],\n+            }\n+        case ScoreQuestion():\n+            return {\n+                \"type\": \"score\",\n+                \"name\": name,\n+                \"instructions\": instructions,\n+                \"levels\": [{\"label\": label} for label in question.criteria],\n+            }\n+    raise TypeError(f\"Unsupported classifier question: {type(question)}.\")\n+\n+\n+def _from_sdk_answer(answer: Any) -> ClassifierAnswer:\n+    \"\"\"Translate a Decisions answer without changing its probabilities.\"\"\"\n+    match answer.type:\n+        case \"predicate\":\n+            return BinaryAnswer(probability=answer.probability)\n+        case \"choice\":\n+            return ChoiceAnswer(\n+                choice=answer.choice,\n+                confidence=answer.confidence,\n+                probabilities={\n+                    p.value: p.probability for p in answer.probabilities\n+                },\n+            )\n+        case \"score\":\n+            return ScoreAnswer(\n+                score=answer.score,\n+                confidence=answer.confidence,\n+                legend={p.value: p.label for p in answer.probabilities},\n+                probabilities={\n+                    p.value: p.probability for p in answer.probabilities\n+                },\n+            )\n+        case \"refusal\":\n+            return RefusalAnswer()\n+    raise ValueError(f\"Unsupported OpenAI answer type: {answer.type!r}.\")\n+\n+\n+def _to_sdk_input(state: str | dict | list[TextBlock | DataBlock]) -> Any:\n+    \"\"\"Convert text, JSON, or ordered text/image blocks to Decisions input.\"\"\"\n+    if isinstance(state, str):\n+        return state\n+    if isinstance(state, dict):\n+        return json.dumps(state, ensure_ascii=False)\n+\n+    content = []\n+    for block in state:\n+        if isinstance(block, TextBlock):\n+            content.append({\"type\": \"input_text\", \"text\": block.text})\n+        elif (\n+            isinstance(block, DataBlock)\n+            and isinstance(block.source, Base64Source)\n+            and block.source.media_type.startswith(\"image/\")\n+        ):\n+            content.append(\n+                {\n+                    \"type\": \"input_image\",\n+                    \"image_url\": (\n+                        f\"data:{block.source.media_type};base64,\"\n+                        f\"{block.source.data}\"\n+                    ),\n+                },\n+            )\n+        else:\n+            raise ValueError(\n+                \"Decisions input supports TextBlock and image DataBlock \"\n+                \"with Base64Source only.\",\n+            )\n+    return [{\"role\": \"user\", \"content\": content}]\n+\n+\n+class OpenAIClassifierModel(ClassifierModelBase):\n+    \"\"\"A classifier backed by the OpenAI Decisions API.\n+\n+    Requires ``openai>=3.26.0``. Binary questions map to predicates; choice\n+    and score questions retain their alternatives and ordered levels.\n+    When instructions are omitted, the question name is used instead.\n+    Binary criteria are appended to the instructions as true/false outcomes.\n+\n+    Refusals are returned as :class:`RefusalAnswer` for the affected question,\n+    alongside any other answers from the same request.\n+    \"\"\"\n+\n+    class Parameters(ClassifierModelBase.Parameters):\n+        \"\"\"Provider-specific classifier parameters.\"\"\"\n+\n+        model_config = ConfigDict(extra=\"forbid\")\n+\n+    def __init__(\n+        self,\n+        credential: OpenAICredential,\n+        model: str = \"gpt-6-luna\",\n+        parameters: \"OpenAIClassifierModel.Parameters | None\" = None,\n+        timeout: float = 30.0,\n+        max_retries: int = 2,\n+    ) -> None:\n+        \"\"\"Initialize the classifier and its reusable OpenAI client.\n+\n+        Args:\n+            credential (`OpenAICredential`):\n+                API key, optional organization and custom endpoint.\n+            model (`str`, defaults to ``\"gpt-6-luna\"``):\n+                The model name accepted by the Decisions endpoint.\n+            parameters (`OpenAIClassifierModel.Parameters | None`):\n+                Provider-specific classifier parameters.\n+            timeout (`float`, defaults to `30.0`):\n+                Per-request timeout in seconds.\n+            max_retries (`int`, defaults to `2`):\n+                Maximum retries after the initial request, handled by the SDK.\n+        \"\"\"\n+        super().__init__(credential, model, parameters)\n+        self.client = openai.AsyncOpenAI(\n+            api_key=credential.api_key.get_secret_value(),\n+            organization=credential.organization,\n+            base_url=credential.base_url,\n+            timeout=timeout,\n+            max_retries=max_retries,\n+        )\n+        if not hasattr(self.client, \"decisions\"):\n+            raise ImportError(\n+                \"OpenAIClassifierModel requires openai>=3.26.0. \"\n+                \"Upgrade with `pip install 'openai>=3.26.0'`.\",\n+            )\n+\n+    async def __call__(\n+        self,\n+        state: str | dict | list[TextBlock | DataBlock],\n+        questions: Mapping[str, ClassifierQuestion],\n+        **kwargs: Any,\n+    ) -> ClassifierResponse:\n+        \"\"\"Evaluate questions about text, JSON, or inline images.\n+\n+        Args:\n+            state (`str | dict | list[TextBlock | DataBlock]`):\n+                Shared evidence. Dictionaries are serialized as JSON text.\n+                Content lists preserve order and support text plus image\n+                blocks with :class:`Base64Source`. URL sources and other\n+                media types are not supported.\n+            questions (`Mapping[str, ClassifierQuestion]`):\n+                Typed questions keyed by their names.\n+            **kwargs (`Any`):\n+                Options forwarded to ``client.decisions.create``, such as\n+                ``safety_identifier``, ``extra_headers``, and ``extra_body``.\n+\n+        Returns:\n+            `ClassifierResponse`:\n+                Answers and refusals keyed by question name, with usage.\n+        \"\"\"\n+        start_time = perf_counter()\n+        response = await self.client.decisions.create(\n+            model=self.model,\n+            input=_to_sdk_input(state),\n+            questions=[\n+                _to_sdk_question(name, q) for name, q in questions.items()\n+            ],\n+            **kwargs,\n+        )\n+        return ClassifierResponse(\n+            model=response.model,\n+            content={a.name: _from_sdk_answer(a) for a in response.answers},\n+            usage=ClassifierUsage(\n+                input_tokens=response.usage.input_tokens,\n+                output_tokens=response.usage.output_tokens,\n+                time=perf_counter() - start_time,\n+            ),\n+        )\ndiff --git a/src/agentscope/classifier/_response.py b/src/agentscope/classifier/_response.py\nindex 9043025eb2..d3916e9140 100644\n--- a/src/agentscope/classifier/_response.py\n+++ b/src/agentscope/classifier/_response.py\n@@ -69,8 +69,20 @@ class ScoreAnswer(DictMixin):\n     \"\"\"The answer type discriminator.\"\"\"\n \n \n+@dataclass\n+class RefusalAnswer(DictMixin):\n+    \"\"\"A refusal to answer one question, independent of other answers.\"\"\"\n+\n+    type: Literal[\"refusal_answer\"] = field(\n+        default_factory=lambda: \"refusal_answer\",\n+    )\n+    \"\"\"The answer type discriminator.\"\"\"\n+\n+\n #: A provider-independent classifier answer.\n-ClassifierAnswer: TypeAlias = BinaryAnswer | ChoiceAnswer | ScoreAnswer\n+ClassifierAnswer: TypeAlias = (\n+    BinaryAnswer | ChoiceAnswer | ScoreAnswer | RefusalAnswer\n+)\n \n \n @dataclass\n", "test_patch": "diff --git a/tests/classifier_openai_test.py b/tests/classifier_openai_test.py\nnew file mode 100644\nindex 0000000000..1f8891bd8a\n--- /dev/null\n+++ b/tests/classifier_openai_test.py\n@@ -0,0 +1,285 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"Tests for the OpenAI Decisions classifier adapter.\"\"\"\n+from dataclasses import asdict\n+from types import SimpleNamespace\n+from unittest import IsolatedAsyncioTestCase\n+from unittest.mock import AsyncMock, MagicMock, patch\n+\n+from utils import AnyValue\n+from agentscope import classifier\n+from agentscope.classifier import (\n+    BinaryCriteria,\n+    BinaryQuestion,\n+    ChoiceQuestion,\n+    ScoreQuestion,\n+)\n+from agentscope.credential import OpenAICredential\n+from agentscope.message import Base64Source, DataBlock, TextBlock, URLSource\n+\n+\n+class OpenAIClassifierModelTest(IsolatedAsyncioTestCase):\n+    \"\"\"Exercise request and response translation without network calls.\"\"\"\n+\n+    def setUp(self) -> None:\n+        \"\"\"Replace the OpenAI client with an asynchronous stub.\"\"\"\n+        client_patch = patch(\"openai.AsyncOpenAI\")\n+        self.client_cls = client_patch.start()\n+        self.addCleanup(client_patch.stop)\n+        self.client = self.client_cls.return_value\n+        self.client.decisions.create = AsyncMock(\n+            return_value=SimpleNamespace(\n+                model=\"gpt-6-luna\",\n+                answers=[],\n+                usage=SimpleNamespace(input_tokens=12, output_tokens=0),\n+            ),\n+        )\n+        self.credential = OpenAICredential(api_key=\"secret\")\n+\n+    async def test_call_translates_all_answers(self) -> None:\n+        \"\"\"Keep all answers, including a refusal, and provider usage.\"\"\"\n+        self.client.decisions.create.return_value.answers = [\n+            SimpleNamespace(type=\"predicate\", name=\"urgent\", probability=0.8),\n+            SimpleNamespace(\n+                type=\"choice\",\n+                name=\"route\",\n+                choice=\"billing\",\n+                confidence=0.9,\n+                probabilities=[\n+                    SimpleNamespace(value=\"billing\", probability=0.9),\n+                    SimpleNamespace(value=\"support\", probability=0.1),\n+                ],\n+            ),\n+            SimpleNamespace(\n+                type=\"score\",\n+                name=\"priority\",\n+                score=1.7,\n+                confidence=0.85,\n+                probabilities=[\n+                    SimpleNamespace(value=0, label=\"low\", probability=0.05),\n+                    SimpleNamespace(value=1, label=\"medium\", probability=0.2),\n+                    SimpleNamespace(value=2, label=\"high\", probability=0.75),\n+                ],\n+            ),\n+            SimpleNamespace(type=\"refusal\", name=\"restricted\"),\n+        ]\n+        model = classifier.OpenAIClassifierModel(\n+            OpenAICredential(\n+                api_key=\"secret\",\n+                organization=\"org-test\",\n+                base_url=\"https://openai.example/v1\",\n+            ),\n+            timeout=10,\n+            max_retries=4,\n+        )\n+        response = await model(\n+            state=\"I was charged twice.\",\n+            questions={\n+                \"urgent\": BinaryQuestion(\n+                    instructions=\"Is this urgent?\",\n+                    criteria=BinaryCriteria(true=\"Urgent.\"),\n+                ),\n+                \"route\": ChoiceQuestion(\n+                    instructions=\"Select a route.\",\n+                    criteria={\"billing\": None, \"support\": None},\n+                ),\n+                \"priority\": ScoreQuestion(\n+                    instructions=\"Rate priority.\",\n+                    criteria=[\"low\", \"medium\", \"high\"],\n+                ),\n+                \"restricted\": BinaryQuestion(),\n+            },\n+            extra_headers={\"X-Test\": \"value\"},\n+        )\n+        self.assertDictEqual(\n+            self.client_cls.call_args.kwargs,\n+            {\n+                \"api_key\": \"secret\",\n+                \"organization\": \"org-test\",\n+                \"base_url\": \"https://openai.example/v1\",\n+                \"timeout\": 10,\n+                \"max_retries\": 4,\n+            },\n+        )\n+        self.assertDictEqual(\n+            self.client.decisions.create.call_args.kwargs,\n+            {\n+                \"model\": \"gpt-6-luna\",\n+                \"input\": \"I was charged twice.\",\n+                \"questions\": [\n+                    {\n+                        \"type\": \"predicate\",\n+                        \"name\": \"urgent\",\n+                        \"instructions\": \"Is this urgent?\\nTrue: Urgent.\",\n+                    },\n+                    {\n+                        \"type\": \"choice\",\n+                        \"name\": \"route\",\n+                        \"instructions\": \"Select a route.\",\n+                        \"choices\": [\n+                            {\"value\": \"billing\"},\n+                            {\"value\": \"support\"},\n+                        ],\n+                    },\n+                    {\n+                        \"type\": \"score\",\n+                        \"name\": \"priority\",\n+                        \"instructions\": \"Rate priority.\",\n+                        \"levels\": [\n+                            {\"label\": \"low\"},\n+                            {\"label\": \"medium\"},\n+                            {\"label\": \"high\"},\n+                        ],\n+                    },\n+                    {\n+                        \"type\": \"predicate\",\n+                        \"name\": \"restricted\",\n+                        \"instructions\": \"restricted\",\n+                    },\n+                ],\n+                \"extra_headers\": {\"X-Test\": \"value\"},\n+            },\n+        )\n+        self.assertDictEqual(\n+            asdict(response),\n+            {\n+                \"model\": \"gpt-6-luna\",\n+                \"content\": {\n+                    \"urgent\": {\"type\": \"binary_answer\", \"probability\": 0.8},\n+                    \"route\": {\n+                        \"type\": \"choice_answer\",\n+                        \"choice\": \"billing\",\n+                        \"confidence\": 0.9,\n+                        \"probabilities\": {\"billing\": 0.9, \"support\": 0.1},\n+                    },\n+                    \"priority\": {\n+                        \"type\": \"score_answer\",\n+                        \"score\": 1.7,\n+                        \"confidence\": 0.85,\n+                        \"legend\": {0: \"low\", 1: \"medium\", 2: \"high\"},\n+                        \"probabilities\": {0: 0.05, 1: 0.2, 2: 0.75},\n+                    },\n+                    \"restricted\": {\"type\": \"refusal_answer\"},\n+                },\n+                \"usage\": {\n+                    \"time\": AnyValue(),\n+                    \"input_tokens\": 12,\n+                    \"output_tokens\": 0,\n+                    \"type\": \"classifier\",\n+                },\n+                \"id\": AnyValue(),\n+                \"created_at\": AnyValue(),\n+                \"type\": \"classifier_response\",\n+                \"metadata\": {},\n+            },\n+        )\n+\n+    async def test_input_conversion(self) -> None:\n+        \"\"\"Convert input and retain criteria when instructions are omitted.\"\"\"\n+        model = classifier.OpenAIClassifierModel(self.credential)\n+        questions = {\n+            \"safe\": BinaryQuestion(criteria=BinaryCriteria(false=\"Unsafe.\")),\n+            \"route\": ChoiceQuestion(criteria={\"billing\": \"Payments.\"}),\n+            \"priority\": ScoreQuestion(criteria=[\"low\", \"high\"]),\n+        }\n+        for state, expected in [\n+            ({\"text\": \"\u4f60\u597d\"}, '{\"text\": \"\u4f60\u597d\"}'),\n+            (\n+                [\n+                    TextBlock(text=\"Compare.\"),\n+                    DataBlock(\n+                        source=Base64Source(\n+                            data=\"YWJj\",\n+                            media_type=\"image/png\",\n+                        ),\n+                    ),\n+                    DataBlock(\n+                        source=Base64Source(\n+                            data=\"ZGVm\",\n+                            media_type=\"image/jpeg\",\n+                        ),\n+                    ),\n+                ],\n+                [\n+                    {\n+                        \"role\": \"user\",\n+                        \"content\": [\n+                            {\"type\": \"input_text\", \"text\": \"Compare.\"},\n+                            {\n+                                \"type\": \"input_image\",\n+                                \"image_url\": \"data:image/png;base64,YWJj\",\n+                            },\n+                            {\n+                                \"type\": \"input_image\",\n+                                \"image_url\": \"data:image/jpeg;base64,ZGVm\",\n+                            },\n+                        ],\n+                    },\n+                ],\n+            ),\n+        ]:\n+            with self.subTest(state=state):\n+                await model(state, questions)\n+                self.assertDictEqual(\n+                    self.client.decisions.create.call_args.kwargs,\n+                    {\n+                        \"model\": \"gpt-6-luna\",\n+                        \"input\": expected,\n+                        \"questions\": [\n+                            {\n+                                \"type\": \"predicate\",\n+                                \"name\": \"safe\",\n+                                \"instructions\": \"safe\\nFalse: Unsafe.\",\n+                            },\n+                            {\n+                                \"type\": \"choice\",\n+                                \"name\": \"route\",\n+                                \"instructions\": \"route\",\n+                                \"choices\": [\n+                                    {\n+                                        \"value\": \"billing\",\n+                                        \"description\": \"Payments.\",\n+                                    },\n+                                ],\n+                            },\n+                            {\n+                                \"type\": \"score\",\n+                                \"name\": \"priority\",\n+                                \"instructions\": \"priority\",\n+                                \"levels\": [\n+                                    {\"label\": \"low\"},\n+                                    {\"label\": \"high\"},\n+                                ],\n+                            },\n+                        ],\n+                    },\n+                )\n+\n+    async def test_unsupported_media_is_rejected(self) -> None:\n+        \"\"\"Do not silently discard unsupported input or fetch URL sources.\"\"\"\n+        model = classifier.OpenAIClassifierModel(self.credential)\n+        for source in [\n+            Base64Source(data=\"YWJj\", media_type=\"audio/wav\"),\n+            URLSource(url=\"https://example.com/a.png\", media_type=\"image/png\"),\n+        ]:\n+            with self.subTest(source=source):\n+                with self.assertRaisesRegex(ValueError, \"Base64Source\"):\n+                    await model(\n+                        [DataBlock(source=source)],\n+                        {\"safe\": BinaryQuestion()},\n+                    )\n+        self.client.decisions.create.assert_not_awaited()\n+\n+    async def test_provider_error_is_raised(self) -> None:\n+        \"\"\"Leave retry and error handling to the SDK.\"\"\"\n+        error = RuntimeError(\"failed\")\n+        self.client.decisions.create.side_effect = error\n+        model = classifier.OpenAIClassifierModel(self.credential)\n+        with self.assertRaises(RuntimeError) as caught:\n+            await model(\"hello\", {\"safe\": BinaryQuestion()})\n+        self.assertIs(caught.exception, error)\n+\n+    async def test_old_sdk_has_clear_error(self) -> None:\n+        \"\"\"Fail with an upgrade instruction when Decisions is unavailable.\"\"\"\n+        self.client_cls.return_value = MagicMock(spec=[])\n+        with self.assertRaisesRegex(ImportError, \"openai>=3.26.0\"):\n+            classifier.OpenAIClassifierModel(self.credential)\ndiff --git a/tests/classifier_test.py b/tests/classifier_test.py\nindex 987f98f861..55f9dcb580 100644\n--- a/tests/classifier_test.py\n+++ b/tests/classifier_test.py\n@@ -14,6 +14,7 @@\n     ClassifierModelBase,\n     ClassifierQuestion,\n     ClassifierResponse,\n+    RefusalAnswer,\n     ScoreQuestion,\n )\n from agentscope.credential import CredentialBase\n@@ -90,6 +91,13 @@ def test_non_string_instructions_are_rejected(self) -> None:\n class ClassifierModelBaseTest(IsolatedAsyncioTestCase):\n     \"\"\"Test the classifier model contract.\"\"\"\n \n+    async def test_refusal_answer(self) -> None:\n+        \"\"\"A refusal carries no fabricated score or explanation.\"\"\"\n+        self.assertDictEqual(\n+            asdict(RefusalAnswer()),\n+            {\"type\": \"refusal_answer\"},\n+        )\n+\n     async def test_call(self) -> None:\n         \"\"\"A call returns the typed answers keyed by question name.\"\"\"\n         response = await _MockClassifier()(\ndiff --git a/tests/middleware_model_router_test.py b/tests/middleware_model_router_test.py\nindex 1a93668607..6e6bc8b0b7 100644\n--- a/tests/middleware_model_router_test.py\n+++ b/tests/middleware_model_router_test.py\n@@ -2,6 +2,7 @@\n \"\"\"Tests for the model router middleware.\"\"\"\n from typing import Any, Mapping\n from unittest import IsolatedAsyncioTestCase\n+from unittest.mock import AsyncMock, patch\n \n from pydantic import BaseModel\n \n@@ -12,6 +13,7 @@\n     ClassifierModelBase,\n     ClassifierQuestion,\n     ClassifierResponse,\n+    RefusalAnswer,\n )\n from agentscope.credential import CredentialBase\n from agentscope.event import ModelCallStartEvent, ReplyStartEvent\n@@ -341,6 +343,32 @@ async def test_failures_keep_the_agents_model(self) -> None:\n             {\"ModelRouterMiddleware\": {agent.state.reply_id: None}},\n         )\n \n+    async def test_refusal_keeps_the_agents_model(self) -> None:\n+        \"\"\"A classifier refusal leaves the reply on the original model.\"\"\"\n+        middleware = ModelRouterMiddleware(\n+            _MockClassifier([]),\n+            self.candidates,\n+        )\n+        with patch.object(\n+            _MockClassifier,\n+            \"__call__\",\n+            new=AsyncMock(\n+                return_value=ClassifierResponse(\n+                    model=\"classifier\",\n+                    content={\"chat_model\": RefusalAnswer()},\n+                ),\n+            ),\n+        ):\n+            agent, called = await self._reply(\n+                middleware,\n+                [TextBlock(text=\"Hi.\")],\n+            )\n+        self.assertListEqual(called, [\"primary\"])\n+        self.assertDictEqual(\n+            agent.state.middle_context,\n+            {\"ModelRouterMiddleware\": {agent.state.reply_id: None}},\n+        )\n+\n     def test_duplicate_candidates_are_rejected(self) -> None:\n         \"\"\"Candidate names must be unique.\"\"\"\n         with self.assertRaisesRegex(ValueError, \"Duplicate\"):\n", "problem_statement": "feat: support OpenAI Decisions API through the classifier interface\n\n### Discussed in https://github.com/agentscope-ai/agentscope/discussions/3166\n\n<div type='discussions-op-text'>\n\n<sup>Originally posted by **YingchaoX** October  8, 2026</sup>\nOpenAI released the [Decisions API](https://developers.openai.com/api/docs/guides/decisions) in public beta on October 6. It returns typed answers for classification, choice, and scoring tasks.\n\nWith the classifier interface and Jev support introduced in #2758, would it make sense to add an OpenAI adapter under `agentscope.classifier`? This would let users with OpenAI credentials use the same interface for classification and model routing.\n\nI propose keeping the contribution focused on:\n- An adapter based on `ClassifierModelBase`, reusing `OpenAICredential`.\n- Mapping supported questions and answers to the existing classifier types.\n- Tests, a usage example, and companion documentation.\n\nA couple of API differences may need discussion first, particularly refusal responses and image inputs, which the current classifier types may not fully represent.\n\nIs this already planned by the core team, and would a community contribution be welcome? I\u2019d be happy to work on it once the scope and direction are agreed.</div>\n", "hints_text": "@YingchaoX Plz leave a message here so that we can assign this issue.\nI'd be happy to take this on. Please assign this issue to me.\n\nI propose the following scope:\n\n**Adapter**\n\nAdd `OpenAIClassifierModel` under `agentscope.classifier`, extending `ClassifierModelBase` and reusing `OpenAICredential`. Use a reusable `AsyncOpenAI` client to call `client.decisions.create()`, with retries and API errors handled by the SDK.\n\nMap the existing question types as follows:\n\n| AgentScope | OpenAI Decisions API |\n| --- | --- |\n| `BinaryQuestion` | `predicate` |\n| `ChoiceQuestion` | `choice` |\n| `ScoreQuestion` | `score` |\n\nUse question dictionary keys as names and normalize responses into the existing answer types and `ClassifierResponse`. Preserve provider-reported probabilities, confidence, scores, and usage. Document how optional instructions and binary criteria map to OpenAI's required instructions.\n\n**Refusals**\n\nAdd a provider-independent `RefusalAnswer` to `ClassifierAnswer`. The API can return normal answers and refusals in the same request, so refusals should be represented per question while preserving the other results.\n\nThe existing router already falls back for non-`ChoiceAnswer` results; add regression coverage for refusal handling.\n\n**Inputs and dependencies**\n\nKeep the first PR within the existing `state: str | dict` contract: pass text directly and serialize dictionary input as JSON. Propose multimodal inputs separately, since the classifier interface currently has no typed image input contract.\n\nAdd a `classifier-openai` extra requiring `openai>=3.26.0`, include it in the `classifiers` extra, and provide a clear compatibility error when the adapter is used with an older SDK.\n\n**Tests and documentation**\n\nAdd deterministic tests for question/answer mapping, JSON input, multiple questions, refusals, SDK errors, and router fallback, using complete-structure assertions. Include a concise example and a companion documentation PR.\n\nThe proposed mappings and per-question refusal behavior have been verified against the live API through the OpenAI SDK.\n\nDoes this scope look right, particularly the shared `RefusalAnswer`, dependency handling, and deferring multimodal input to a follow-up?\nIt's yours, @YingchaoX. If there is no pull request and no word from you by 2026-10-22 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-08T08:55:38Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3161, "instance_id": "agentscope-ai__agentscope-3161", "issue_numbers": ["3160"], "base_commit": "faf54fdd463b933cb29f46a80ae9f2a758d06bff", "patch": "diff --git a/src/agentscope/tool/_builtin/_read.py b/src/agentscope/tool/_builtin/_read.py\nindex 72f023430e..b36b8a8a45 100644\n--- a/src/agentscope/tool/_builtin/_read.py\n+++ b/src/agentscope/tool/_builtin/_read.py\n@@ -166,7 +166,7 @@ def __init__(\n         super().__init__(middlewares=middlewares)\n         self._max_line_characters = max_line_characters\n         self.model_input_types = (\n-            _DEFAULT_MODEL_INPUT_TYPES\n+            _DEFAULT_MODEL_INPUT_TYPES.copy()\n             if model_input_types is None\n             else model_input_types\n         )\n", "test_patch": "diff --git a/tests/builtin_read_test.py b/tests/builtin_read_test.py\nindex 617d84ba92..b24e634322 100644\n--- a/tests/builtin_read_test.py\n+++ b/tests/builtin_read_test.py\n@@ -295,6 +295,26 @@ async def test_read_image_file_returns_data_block(self) -> None:\n             },\n         )\n \n+    async def test_default_model_input_types_are_isolated(self) -> None:\n+        \"\"\"Changing one default tool must not affect other instances.\"\"\"\n+        existing = Read()\n+        self.read_tool.model_input_types.append(\"image/bmp\")\n+        self.addCleanup(self.read_tool.model_input_types.remove, \"image/bmp\")\n+\n+        defaults = [\"image/png\", \"image/jpeg\", \"image/gif\", \"image/webp\"]\n+        self.assertDictEqual(\n+            {\n+                \"configured\": self.read_tool.model_input_types,\n+                \"existing\": existing.model_input_types,\n+                \"later\": Read().model_input_types,\n+            },\n+            {\n+                \"configured\": defaults + [\"image/bmp\"],\n+                \"existing\": defaults,\n+                \"later\": defaults,\n+            },\n+        )\n+\n     async def test_read_image_unsupported_type(self) -> None:\n         \"\"\"Test images outside ``model_input_types`` return an error.\"\"\"\n         with tempfile.NamedTemporaryFile(delete=False, suffix=\".bmp\") as f:\n", "problem_statement": "[Bug]: Read instances share the default media input types list\n## Prerequisites\n\n- [x] I searched the existing issues, pull requests, and discussions for `model_input_types`, shared defaults, and mutable `Read` configuration; I did not find this problem. #2856 / #2857 concern explicit empty lists, which is a different case.\n- [x] This is a bug report, not a usage question.\n\n## Background / Description\n\nDefault `Read` instances share the same mutable `model_input_types` list. Configuring one instance in place changes the media types accepted by other existing instances and by instances created later.\n\nFor example, enabling BMP on one tool makes another tool configured with the defaults accept BMP too. Adding `application/pdf` similarly changes another tool from extracting PDF text to returning native PDF data, even if its downstream model does not support PDF input.\n\nThe constructor assigns `_DEFAULT_MODEL_INPUT_TYPES` directly to the instance when the argument is omitted. The public attribute is intended to remain configurable after construction, as covered by `tests/builtin_read_test.py`.\n\nExpected: changing one default-created tool's list should not change another tool's defaults. Explicit caller-supplied lists, including `[]`, can retain their current behavior.\n\n## Observed Result\n\nThe reproducer below was run against the real editable package, including the public tool call and local backend:\n\n```text\n{'configured': 'running', 'existing': 'running', 'later': 'running'}\n```\n\nExpected:\n\n```text\n{'configured': 'running', 'existing': 'error', 'later': 'error'}\n```\n\nHere `running` is the existing state returned by a successful image read; the chunk is also marked `is_last=True`.\n\n## Steps to Reproduce\n\n```python\nimport asyncio\nimport tempfile\nfrom pathlib import Path\n\nfrom agentscope.tool import Read\n\n\nasync def main():\n    configured = Read()\n    existing = Read()\n    configured.model_input_types.append(\"image/bmp\")\n    later = Read()\n\n    with tempfile.TemporaryDirectory() as directory:\n        path = Path(directory) / \"sample.bmp\"\n        path.write_bytes(b\"BM\" + b\"\\x00\" * 100)\n        states = {}\n        for name, tool in [\n            (\"configured\", configured),\n            (\"existing\", existing),\n            (\"later\", later),\n        ]:\n            states[name] = (await tool(file_path=str(path))).state\n        print(states)\n\n\nasyncio.run(main())\n```\n\nThe fixture follows the existing BMP test; this exercises media admission and does not require an image decoder or a model API.\n\n## Environment\n\n- AgentScope: `2.0.10dev`, editable checkout at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`\n- Python: `3.12.14`\n- OS: Windows\n\n## Proposed Fix\n\nCopy the default list when constructing a `Read` instance. Keep the explicit-list branch unchanged and add a regression covering existing and subsequently created default instances. I would like to contribute this focused fix.\n\nAI assistance: Codex helped inspect the source and reproduce this report; the observed output above came from running the actual package.\n\n", "hints_text": "", "created_at": "2026-10-08T03:24:51Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3158, "instance_id": "agentscope-ai__agentscope-3158", "issue_numbers": ["3157"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/app/message_bus/_redis_message_bus.py b/src/agentscope/app/message_bus/_redis_message_bus.py\nindex 89adcb0c03..c4d77f9a63 100644\n--- a/src/agentscope/app/message_bus/_redis_message_bus.py\n+++ b/src/agentscope/app/message_bus/_redis_message_bus.py\n@@ -614,8 +614,9 @@ async def subscribe(\n                     continue\n                 yield json.loads(data)\n         finally:\n-            await pubsub.unsubscribe(key)\n-            await pubsub.aclose()\n+            # Closing drops the subscription and returns the connection to\n+            # the pool; shield it so a cancelled consumer cannot leak it.\n+            await asyncio.shield(pubsub.aclose())\n \n     # ------------------------------------------------------------------\n     # Mode E \u2014 distributed lock\n", "test_patch": "diff --git a/tests/service_message_bus_test.py b/tests/service_message_bus_test.py\nindex 5484eb6fe9..4b9a6a83ab 100644\n--- a/tests/service_message_bus_test.py\n+++ b/tests/service_message_bus_test.py\n@@ -12,6 +12,7 @@\n from contextlib import AsyncExitStack\n from typing import Any\n from unittest import IsolatedAsyncioTestCase\n+from unittest.mock import patch\n \n import fakeredis.aioredis\n from utils import AnyString\n@@ -252,6 +253,37 @@ async def _consumer() -> None:\n         await asyncio.wait_for(task, timeout=2.0)\n         self.assertEqual([p[\"i\"] for p in received], [1, 2])\n \n+    async def test_subscribe_cleanup_survives_cancellation(self) -> None:\n+        \"\"\"A consumer cancelled again while closing the pubsub must not\n+        abort the close, otherwise the connection leaks from the pool.\"\"\"\n+        ready, closing = asyncio.Event(), asyncio.Event()\n+        finish, released = asyncio.Event(), asyncio.Event()\n+        pubsub = self.fr.pubsub()\n+        original_aclose = pubsub.aclose\n+\n+        async def _slow_aclose() -> None:\n+            closing.set()\n+            await finish.wait()\n+            await original_aclose()\n+            released.set()\n+\n+        async def _consumer() -> None:\n+            async for _ in self.bus.subscribe(\"ch\", on_ready=ready.set):\n+                pass\n+\n+        pubsub.aclose = _slow_aclose\n+        with patch.object(self.fr, \"pubsub\", return_value=pubsub):\n+            task = asyncio.create_task(_consumer())\n+            await asyncio.wait_for(ready.wait(), timeout=2.0)\n+            task.cancel()\n+            await asyncio.wait_for(closing.wait(), timeout=2.0)\n+            task.cancel()\n+            with self.assertRaises(asyncio.CancelledError):\n+                await task\n+\n+        finish.set()\n+        await asyncio.wait_for(released.wait(), timeout=2.0)\n+\n \n class TestLockPrimitive(IsolatedAsyncioTestCase):\n     \"\"\"Mode E \u2014 distributed mutex semantics.\"\"\"\n", "problem_statement": "[Bug]: Repeated SSE disconnects permanently exhaust RedisMessageBus connection pool\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nWhen an HTTP SSE client disconnects after a Redis Pub/Sub subscription becomes ready, the subscription's Redis connection is not returned to the asyncio ConnectionPool. Each disconnect permanently increases `_in_use_connections` by one. After `max_connections` disconnects, unrelated RedisMessageBus operations (including ChatService session-lock acquisition) fail with `Too many connections` until the process is restarted.\n\nExpected behavior: after the SSE response is closed and cleanup completes, the Pub/Sub connection should be returned to the pool and `in_use` should return to its baseline.\n\nObserved behavior with `max_connections=5`:\n\n~~~text\nattempt=1 in_use=1 available=1\nattempt=2 in_use=2 available=1\nattempt=3 in_use=3 available=1\nattempt=4 in_use=4 available=1\nattempt=5 in_use=5 available=0\nfinal_ping=ConnectionError: Too many connections\n~~~\n\nThe Redis server itself has few connected clients because the TCP sockets are disconnected; the stale connection objects remain counted as in-use in redis-py's local pool.\n\nThe likely failure path is the cleanup in `RedisMessageBus.subscribe()`:\n\n~~~python\nfinally:\n    await pubsub.unsubscribe(key)\n    await pubsub.aclose()\n~~~\n\nDuring SSE cancellation, cleanup is not cancellation-safe. Once the pool is exhausted, `unsubscribe()` itself attempts to acquire a connection and raises, so `aclose()` is never reached. A nested `try/finally` plus cancellation-shielded close appears necessary.\n\nThis is distinct from #2677, which concerns an unbounded WakeupDispatcher retry storm. This reproduction only creates and disconnects SSE subscriptions.\n\n### Error Messages\n\n```shell\n~~~text\nredis.exceptions.ConnectionError: Too many connections\n\n  File \"agentscope/app/message_bus/_redis_message_bus.py\", line 617, in subscribe\n    await pubsub.unsubscribe(key)\n  File \"redis/asyncio/client.py\", line 924, in execute_command\n    await self.connect()\n  File \"redis/asyncio/client.py\", line 934, in connect\n    self.connection = await self.connection_pool.get_connection()\n  File \"redis/asyncio/connection.py\", line 1162, in get_available_connection\n    raise ConnectionError(\"Too many connections\") from None\n~~~\n\nAfter the pool is exhausted, an unrelated command fails too:\n\n~~~text\nfinal_ping=ConnectionError: Too many connections\n~~~\n```\n\n### Steps to Reproduce\n\n1. Start a local Redis server.\n2. Run the following script with AgentScope 2.0.8, redis-py 6.4.0, FastAPI, Uvicorn, and HTTPX installed.\n3. The script opens an SSE connection, waits until the Pub/Sub subscription is live, receives one event, and disconnects. It repeats with an isolated pool of size 5.\n\n~~~python\nimport asyncio\nimport json\nimport uuid\n\nimport httpx\nimport uvicorn\nfrom fastapi import FastAPI\nfrom fastapi.responses import StreamingResponse\nfrom agentscope.app.message_bus import RedisMessageBus\n\n\nasync def main():\n    bus = RedisMessageBus(\n        host=\"127.0.0.1\",\n        port=6379,\n        max_connections=5,\n        socket_timeout=5,\n        socket_connect_timeout=5,\n    )\n    await bus.__aenter__()\n    app = FastAPI()\n\n    @app.get(\"/stream\")\n    async def stream():\n        key = f\"repro:sse:{uuid.uuid4().hex}\"\n        ready = asyncio.Event()\n\n        async def publish_ready():\n            await ready.wait()\n            await bus.publish(key, {\"ready\": True})\n\n        async def events():\n            publisher = asyncio.create_task(publish_ready())\n            try:\n                async for event in bus.subscribe(key, on_ready=ready.set):\n                    yield f\"data: {json.dumps(event)}\\n\\n\"\n            finally:\n                publisher.cancel()\n                await asyncio.gather(publisher, return_exceptions=True)\n\n        return StreamingResponse(events(), media_type=\"text/event-stream\")\n\n    server = uvicorn.Server(\n        uvicorn.Config(app, host=\"127.0.0.1\", port=18765, log_level=\"warning\", lifespan=\"off\")\n    )\n    server_task = asyncio.create_task(server.serve())\n    while not server.started:\n        await asyncio.sleep(0.01)\n\n    pool = bus._owned_pool\n    try:\n        async with httpx.AsyncClient(timeout=2.0) as client:\n            for attempt in range(1, 9):\n                try:\n                    async with client.stream(\"GET\", \"http://127.0.0.1:18765/stream\") as response:\n                        async for line in response.aiter_lines():\n                            if line.startswith(\"data:\"):\n                                break\n                except Exception as exc:\n                    print(f\"attempt={attempt} error={type(exc).__name__}: {exc}\")\n                await asyncio.sleep(0.15)\n                print(\n                    f\"attempt={attempt} in_use={len(pool._in_use_connections)} \"\n                    f\"available={len(pool._available_connections)}\"\n                )\n\n            try:\n                await bus.get_client().ping()\n                print(\"final_ping=ok\")\n            except Exception as exc:\n                print(f\"final_ping={type(exc).__name__}: {exc}\")\n    finally:\n        server.should_exit = True\n        await server_task\n        await bus.aclose()\n\n\nasyncio.run(main())\n~~~\n\n### Environment\n\n- AgentScope Version: 2.0.8\n- redis-py Version: 6.4.0\n- Python Version: 3.12.4\n- OS: Windows 11\n- ASGI stack: FastAPI + Uvicorn + Starlette\n- Redis: standalone local server\n\nThe installed `_redis_message_bus.py` matches the official 2.0.8 wheel RECORD hash, and the same cleanup sequence is still present on the current main branch.\n", "hints_text": "Hi, @laygithub, I tested the reproduction with redis-py 8.0.1 and did not observe the connection leak, while keeping the same FastAPI/Starlette/Uvicorn versions. Could you try upgrading with `pip install --upgrade \"redis==8.0.1\"` and rerun the reproduction?\nI took a quick look: in redis-py 6.4.0, cleanup waits for the socket to close before returning the connection to the pool. An SSE disconnect can cancel that wait, so the connection never gets returned.\nIn 8.0.1, it uses `disconnect(nowait=True)` to skip that wait and return the connection to the pool. That seems to explain why upgrading fixed the reproduction in my test.\n/assign\nAlso, we should add cleanup protection on the AgentScope side: ensure `aclose()` runs even if `unsubscribe()` fails, and protect the close operation against cancellation so the connection is returned to the pool.\nIt's yours, @iluv7. If there is no pull request and no word from you by 2026-10-21 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-07T07:09:18Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3151, "instance_id": "agentscope-ai__agentscope-3151", "issue_numbers": ["3150"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/workspace/_base.py b/src/agentscope/workspace/_base.py\nindex db64755d1d..2f782ceba0 100644\n--- a/src/agentscope/workspace/_base.py\n+++ b/src/agentscope/workspace/_base.py\n@@ -1018,8 +1018,8 @@ async def offload_context(\n         ``${workdir}/sessions/<session_id>/context.jsonl`` (one\n         message per JSONL line). Inline base64\n         :class:`DataBlock` payloads are extracted into ``data/`` and\n-        rewritten as ``file://`` URL blocks before serialisation so\n-        the JSONL line size stays bounded.\n+        rewritten as portable ``workspace://`` URL blocks before\n+        serialisation so the JSONL line size stays bounded.\n \n         Args:\n             session_id (`str`):\n", "test_patch": "diff --git a/tests/workspace_bubblewrap_test.py b/tests/workspace_bubblewrap_test.py\nindex 523d0410de..71bf547033 100644\n--- a/tests/workspace_bubblewrap_test.py\n+++ b/tests/workspace_bubblewrap_test.py\n@@ -920,7 +920,7 @@ async def test_offload_context_and_datablock(self) -> None:\n         )\n         async with aiofiles.open(host_path, \"r\") as f:\n             content = await f.read()\n-        self.assertIn(\"file:///workspace/data/\", content)\n+        self.assertIn(\"workspace:///data/\", content)\n         self.assertTrue(\n             os.path.isdir(os.path.join(self._shared_workdir.name, \"data\")),\n         )\n", "problem_statement": "[Bug]: the Bubblewrap offload test still asserts the pre-migration file:// reference\n**Describe the bug**\n\n`tests/workspace_bubblewrap_test.py:923` asserts that the offloaded context\nfile contains `file:///workspace/data/`, but the only implementation the\nBubblewrap workspace uses \u2014 `WorkspaceBase.offload_data_block` \u2014 emits a\nportable `workspace:///data/<sha256>.<ext>` reference. The assertion can\ntherefore never pass, in any environment.\n\n**Why it is invisible today (and why that is not \"harmless\")**\n\n`TestBubblewrapWorkspace` is gated on `_BWRAP_OK and _BWRAP_INTEGRATION_ENABLED`\n(a Linux host with a working `bwrap`, plus `AGENTSCOPE_BWRAP_INTEGRATION_TEST=1`),\nso CI skips the whole class. The gate is the only thing hiding the stale string:\nthe next contributor who follows the documented opt-in flag to check a sandbox\nchange gets a red test inside the offload path that has nothing to do with their\nchange, and no cheap way to tell it is pre-existing.\n\n**Mechanism / history**\n\n* `7af58b119b` (#2051, 2026-07-23) added the Bubblewrap workspace *and* this\n  test in one commit. At that ref the producer was\n  `WorkspaceBase._offload_data_block` returning\n  `url=AnyUrl(self._path_to_file_uri(path))` (`_base.py:566` at that ref), which\n  for `SANDBOX_WORKDIR = \"/workspace\"` yields exactly\n  `file:///workspace/data/<sha>.<ext>` \u2014 the assertion was correct as written.\n* `efba74eda3` (#1997, 2026-08-06) landed the migration to the portable form,\n  `url=AnyUrl(f\"workspace:///{rel}\")`, and renamed the method to\n  `offload_data_block`. Every other backend's test tracks the new form \u2014\n  `workspace_local_test.py:310`, `:1080`, `:1291`, `workspace_docker_test.py:290`,\n  `:439`, `workspace_daytona_test.py:1286`, `compress_context_test.py:2159` \u2014\n  the Bubblewrap one was left behind. It was even touched again in\n  `1d97e9647d` (#2283) fourteen lines below the stale string without the string\n  being updated.\n\n**Measured**\n\nRunning main's `WorkspaceBase.offload_context` (`_base.py` blob `db64755d`,\nmain `72f3f6fa`) against an in-memory backend, with the real\n`SANDBOX_WORKDIR = \"/workspace\"` constant that the test imports, writes\n`/workspace/sessions/s1/context.jsonl` containing:\n\n```\n{\"name\":\"user\",\"content\":[{\"type\":\"data\",\"id\":\"\u2026\",\"source\":{\"type\":\"url\",\n\"url\":\"workspace:///data/9d1e81569f715\u2026txt\"} \u2026\n```\n\n| producer state | main's `assertIn(\"file:///workspace/data/\")` | `assertIn(\"workspace:///data/\")` |\n| --- | --- | --- |\n| main's bytes | **FAIL** | PASS |\n| mutant: producer reverted to `AnyUrl(f\"file://{path}\")` | PASS | **FAIL** |\n| control re-run after restoring main's bytes | **FAIL** | PASS |\n\nThe mutant row is what makes this a measurement instead of a tautology: the\nverdict tracks the producer, and main's producer emits `workspace://`.\n`BubblewrapWorkspace` does not override the method (MRO:\n`BubblewrapWorkspace \u2192 SandboxedWorkspaceBase \u2192 WorkspaceBase`, and\n`offload_data_block` appears only in `WorkspaceBase.__dict__`), so this is the\nproducer the skipped test would call.\n\n**Two further leftovers of the same migration**\n\n1. `offload_context`'s docstring (`_base.py:1021`) still says payloads are\n   \"rewritten as ``file://`` URL blocks\" \u2014 the same method it delegates to\n   emits `workspace://`.\n2. `WorkspaceBase._path_to_file_uri` (`_base.py:475-487`) now has **no caller\n   anywhere in the repository**; its only user was the pre-migration producer.\n   Reported, not proposed: deleting a protected method is an API decision, not\n   part of a test fix.\n\n**Suggested fix**\n\nPoint the assertion at the portable reference and correct the docstring. I'll\nsend it as a PR (2 files, one assertion line + one docstring line).\n\n", "hints_text": "", "created_at": "2026-10-06T19:34:34Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3148, "instance_id": "agentscope-ai__agentscope-3148", "issue_numbers": ["3146"], "base_commit": "d74b833943d84ba8e6b8440b0fd4d46bcdc59569", "patch": "diff --git a/src/agentscope/embedding/_embedding_base.py b/src/agentscope/embedding/_embedding_base.py\nindex a103a795cb..f5db83843f 100644\n--- a/src/agentscope/embedding/_embedding_base.py\n+++ b/src/agentscope/embedding/_embedding_base.py\n@@ -253,9 +253,38 @@ async def __call__(\n             )\n \n         # Dispatch all batches concurrently, each with retry.\n-        results: list[EmbeddingResponse] = await asyncio.gather(\n-            *(self._call_with_retry(batch, **kwargs) for batch in batches),\n-        )\n+        tasks = [\n+            asyncio.create_task(self._call_with_retry(batch, **kwargs))\n+            for batch in batches\n+        ]\n+        batches_result = asyncio.gather(*tasks)\n+        try:\n+            results: list[EmbeddingResponse] = await asyncio.shield(\n+                batches_result,\n+            )\n+        except BaseException as error:\n+            # gather propagates a batch error without stopping its siblings.\n+            # Finish owned coroutine cleanup before returning to the caller.\n+            for task in tasks:\n+                if not task.done() and not task.cancelling():\n+                    task.cancel()\n+            # Retrieve the original gather's exception on caller cancellation.\n+            cleanup = asyncio.gather(\n+                batches_result,\n+                *tasks,\n+                return_exceptions=True,\n+            )\n+            cancellation: asyncio.CancelledError | None = None\n+            while True:\n+                try:\n+                    await asyncio.shield(cleanup)\n+                    break\n+                except asyncio.CancelledError as exc:\n+                    # Finish cleanup before propagating caller cancellation.\n+                    cancellation = exc\n+            if cancellation is not None:\n+                raise cancellation from error\n+            raise\n \n         return self._merge_responses(results)\n \n", "test_patch": "diff --git a/tests/embedding_base_test.py b/tests/embedding_base_test.py\nindex 8de90fde68..8babba7fdd 100644\n--- a/tests/embedding_base_test.py\n+++ b/tests/embedding_base_test.py\n@@ -1,12 +1,15 @@\n # -*- coding: utf-8 -*-\n # pylint: disable=protected-access\n \"\"\"Unit tests for EmbeddingModelBase.\"\"\"\n+import asyncio\n from dataclasses import asdict\n-from typing import Literal\n-from unittest import TestCase\n+from typing import Any, Literal\n+from unittest import IsolatedAsyncioTestCase, TestCase\n+from unittest.mock import AsyncMock, patch\n \n from utils import AnyString\n \n+from agentscope.credential import OpenAICredential\n from agentscope.embedding import (\n     EmbeddingModelBase,\n     EmbeddingResponse,\n@@ -119,3 +122,261 @@ def test_merge_empty_responses_reports_api(self) -> None:\n                 ),\n             ),\n         )\n+\n+\n+class _RetryableError(RuntimeError):\n+    \"\"\"A provider error eligible for retry.\"\"\"\n+\n+\n+class _LocalEmbedding(EmbeddingModelBase[str]):\n+    \"\"\"Exercise the base implementation without a provider connection.\"\"\"\n+\n+    def __init__(self, max_retries: int = 0) -> None:\n+        super().__init__(\n+            credential=OpenAICredential(api_key=\"unused-test-key\"),\n+            model=\"local\",\n+            dimensions=1,\n+            parameters=None,\n+            context_size=100,\n+            batch_size=1,\n+            max_retries=max_retries,\n+            retry_delay=0,\n+        )\n+\n+    @classmethod\n+    def _get_retryable_exceptions(cls) -> tuple[type[Exception], ...]:\n+        return (_RetryableError,)\n+\n+    async def _call_api(\n+        self,\n+        inputs: list[str],\n+        **_kwargs: Any,\n+    ) -> EmbeddingResponse:\n+        raise NotImplementedError\n+\n+\n+class EmbeddingBatchLifecycleTest(IsolatedAsyncioTestCase):\n+    \"\"\"A failed call must finish its cooperative batch tasks.\"\"\"\n+\n+    async def test_batch_failure_waits_for_sibling_cleanup(self) -> None:\n+        \"\"\"Join async cleanup and preserve the original provider error.\"\"\"\n+        for retryable in (False, True):\n+            for inputs in ([\"fail\", \"slow\"], [\"slow\", \"fail\"]):\n+                with self.subTest(retryable=retryable, inputs=inputs):\n+                    model = _LocalEmbedding(max_retries=1 if retryable else 0)\n+                    started = asyncio.Event()\n+                    cleaning = asyncio.Event()\n+                    release = asyncio.Event()\n+                    finished = asyncio.Event()\n+                    error = (\n+                        _RetryableError(\"failed\")\n+                        if retryable\n+                        else ValueError(\"failed\")\n+                    )\n+                    attempts = 0\n+\n+                    async def call_api(\n+                        batch: list[str],\n+                        *,\n+                        call_started: asyncio.Event = started,\n+                        call_error: Exception = error,\n+                        call_cleaning: asyncio.Event = cleaning,\n+                        call_release: asyncio.Event = release,\n+                        call_finished: asyncio.Event = finished,\n+                        **_kwargs: Any,\n+                    ) -> None:\n+                        nonlocal attempts\n+                        if batch == [\"fail\"]:\n+                            await call_started.wait()\n+                            attempts += 1\n+                            raise call_error\n+                        call_started.set()\n+                        try:\n+                            await asyncio.Event().wait()\n+                        finally:\n+                            call_cleaning.set()\n+                            await call_release.wait()\n+                            call_finished.set()\n+\n+                    with patch.object(\n+                        model,\n+                        \"_call_api\",\n+                        side_effect=call_api,\n+                    ):\n+                        call = asyncio.create_task(model(inputs))\n+                        try:\n+                            await asyncio.wait_for(cleaning.wait(), 1)\n+                            self.assertFalse(call.done())\n+                            release.set()\n+                            with self.assertRaises(type(error)) as caught:\n+                                await asyncio.wait_for(call, 1)\n+                            self.assertIs(caught.exception, error)\n+                            self.assertTrue(finished.is_set())\n+                            self.assertEqual(attempts, 2 if retryable else 1)\n+                        finally:\n+                            release.set()\n+                            call.cancel()\n+                            await asyncio.gather(call, return_exceptions=True)\n+\n+    async def test_parent_cancellation_joins_batches(self) -> None:\n+        \"\"\"Repeated cancellation waits for all batch cleanup to finish.\"\"\"\n+        model = _LocalEmbedding()\n+        started = [asyncio.Event(), asyncio.Event()]\n+        finished = []\n+        cleaning = asyncio.Event()\n+        release = asyncio.Event()\n+\n+        async def call_api(batch: list[str], **_kwargs: Any) -> None:\n+            index = int(batch[0])\n+            started[index].set()\n+            try:\n+                await asyncio.Event().wait()\n+            finally:\n+                if index == 1:\n+                    cleaning.set()\n+                await release.wait()\n+                finished.append(index)\n+\n+        with patch.object(model, \"_call_api\", side_effect=call_api):\n+            call = asyncio.create_task(model([\"0\", \"1\"]))\n+            try:\n+                await asyncio.wait_for(\n+                    asyncio.gather(*(event.wait() for event in started)),\n+                    1,\n+                )\n+                call.cancel()\n+                await asyncio.wait_for(cleaning.wait(), 1)\n+                await asyncio.sleep(0)\n+                self.assertFalse(call.done())\n+                for _ in range(2):\n+                    call.cancel()\n+                    await asyncio.sleep(0)\n+                    self.assertFalse(call.done())\n+                release.set()\n+                with self.assertRaises(asyncio.CancelledError):\n+                    await asyncio.wait_for(call, 1)\n+                self.assertCountEqual(finished, [0, 1])\n+            finally:\n+                release.set()\n+                call.cancel()\n+                await asyncio.gather(call, return_exceptions=True)\n+\n+    async def test_cancelled_batch_joins_sibling(self) -> None:\n+        \"\"\"A child cancellation also cleans up the other batch.\"\"\"\n+        model = _LocalEmbedding()\n+        started = asyncio.Event()\n+        finished = asyncio.Event()\n+\n+        async def call_api(batch: list[str], **_kwargs: Any) -> None:\n+            if batch == [\"cancel\"]:\n+                await started.wait()\n+                raise asyncio.CancelledError\n+            started.set()\n+            try:\n+                await asyncio.Event().wait()\n+            finally:\n+                await asyncio.sleep(0)\n+                finished.set()\n+\n+        with patch.object(model, \"_call_api\", side_effect=call_api):\n+            with self.assertRaises(asyncio.CancelledError):\n+                await asyncio.wait_for(model([\"cancel\", \"slow\"]), 1)\n+        self.assertTrue(finished.is_set())\n+\n+    async def test_success_preserves_input_order(self) -> None:\n+        \"\"\"Merge in input order even when batches finish in reverse order.\"\"\"\n+        model = _LocalEmbedding()\n+        second_finished = asyncio.Event()\n+\n+        async def call_api(\n+            batch: list[str],\n+            **_kwargs: Any,\n+        ) -> EmbeddingResponse:\n+            if batch == [\"first\"]:\n+                await second_finished.wait()\n+                return EmbeddingResponse(embeddings=[[1.0]])\n+            second_finished.set()\n+            return EmbeddingResponse(embeddings=[[2.0]])\n+\n+        with patch.object(model, \"_call_api\", side_effect=call_api):\n+            response = await asyncio.wait_for(model([\"first\", \"second\"]), 1)\n+        self.assertEqual(\n+            asdict(response),\n+            asdict(\n+                EmbeddingResponse(\n+                    embeddings=[[1.0], [2.0]],\n+                    id=AnyString(),\n+                    created_at=AnyString(),\n+                    usage=EmbeddingUsage(tokens=0, time=0),\n+                ),\n+            ),\n+        )\n+\n+    async def test_empty_input_does_not_call_provider(self) -> None:\n+        \"\"\"Empty input creates no batch work.\"\"\"\n+        model = _LocalEmbedding()\n+        with patch.object(model, \"_call_api\", new_callable=AsyncMock) as call:\n+            response = await model([])\n+        self.assertEqual(\n+            asdict(response),\n+            asdict(\n+                EmbeddingResponse(\n+                    embeddings=[],\n+                    id=AnyString(),\n+                    created_at=AnyString(),\n+                    usage=EmbeddingUsage(tokens=0, time=0),\n+                ),\n+            ),\n+        )\n+        call.assert_not_awaited()\n+\n+    async def test_parent_cancellation_during_failure_cleanup(self) -> None:\n+        \"\"\"Finish sibling cleanup despite repeated caller cancellation.\"\"\"\n+        for cancel_count in (1, 3):\n+            with self.subTest(cancel_count=cancel_count):\n+                model = _LocalEmbedding()\n+                started = asyncio.Event()\n+                cleaning = asyncio.Event()\n+                release = asyncio.Event()\n+                finished = asyncio.Event()\n+\n+                async def call_api(\n+                    batch: list[str],\n+                    *,\n+                    call_started: asyncio.Event = started,\n+                    call_cleaning: asyncio.Event = cleaning,\n+                    call_release: asyncio.Event = release,\n+                    call_finished: asyncio.Event = finished,\n+                    **_kwargs: Any,\n+                ) -> None:\n+                    if batch == [\"fail\"]:\n+                        await call_started.wait()\n+                        raise ValueError(\"failed\")\n+                    call_started.set()\n+                    try:\n+                        await asyncio.Event().wait()\n+                    finally:\n+                        call_cleaning.set()\n+                        await call_release.wait()\n+                        call_finished.set()\n+\n+                with patch.object(model, \"_call_api\", side_effect=call_api):\n+                    call = asyncio.create_task(model([\"fail\", \"slow\"]))\n+                    try:\n+                        await asyncio.wait_for(cleaning.wait(), 1)\n+                        for _ in range(cancel_count):\n+                            call.cancel()\n+                            await asyncio.sleep(0)\n+                            self.assertFalse(call.done())\n+                        self.assertFalse(finished.is_set())\n+                        release.set()\n+                        with self.assertRaises(asyncio.CancelledError):\n+                            await asyncio.wait_for(call, 1)\n+                        self.assertEqual(\n+                            (cleaning.is_set(), finished.is_set()),\n+                            (True, True),\n+                        )\n+                    finally:\n+                        release.set()\n+                        call.cancel()\n+                        await asyncio.gather(call, return_exceptions=True)\ndiff --git a/tests/embedding_openai_test.py b/tests/embedding_openai_test.py\nindex f84b9e0f26..88a2abb64a 100644\n--- a/tests/embedding_openai_test.py\n+++ b/tests/embedding_openai_test.py\n@@ -114,23 +114,26 @@ async def test_existing_cache_with_extra_kwargs(\n         self,\n         mock_client_cls: Any,\n     ) -> None:\n-        \"\"\"Unchanged requests must still hit cache keys from older versions.\"\"\"\n+        \"\"\"Requests with extra arguments hit the endpoint-specific cache.\"\"\"\n         embeddings = [[0.1, 0.2]]\n         mock_client = mock_client_cls.return_value\n+        mock_client.base_url = \"https://api.openai.com/v1/\"\n         mock_client.embeddings.create = AsyncMock(\n             return_value=_make_response(embeddings, 1),\n         )\n         with TemporaryDirectory() as cache_dir:\n             cache = FileEmbeddingCache(cache_dir=cache_dir)\n-            # Older requests appended dimensions after per-call arguments.\n             await cache.store(\n                 embeddings=embeddings,\n                 identifier={\n-                    \"input\": [\"hello\"],\n-                    \"model\": \"text-embedding-3-small\",\n-                    \"encoding_format\": \"float\",\n-                    \"user\": \"test-user\",\n-                    \"dimensions\": 2,\n+                    \"base_url\": \"https://api.openai.com/v1/\",\n+                    \"api_kwargs\": {\n+                        \"input\": [\"hello\"],\n+                        \"model\": \"text-embedding-3-small\",\n+                        \"encoding_format\": \"float\",\n+                        \"user\": \"test-user\",\n+                        \"dimensions\": 2,\n+                    },\n                 },\n             )\n             model = OpenAIEmbeddingModel(\n", "problem_statement": "[Bug]: Embedding batch tasks continue running after a sibling batch fails\n<!-- reposteward-proposal:v1 repository=agentscope-ai/agentscope draft_id=aada352c3bef478bb16b405c1eace7c8 -->\n## Summary\n\nEmbeddingModelBase.__call__ launches batches with asyncio.gather. If one batch raises, the call propagates that exception while other batches remain active. Their work can outlive the operation that owns them, including when the caller catches the exception and starts another attempt.\n\n## Actual behavior\n\nA deterministic local fixture starts two batches and makes one fail after the other has started. When the exception reaches the caller, the sibling has not finished. Releasing the sibling afterwards lets it complete successfully after the aggregate call has already failed. This occurs both for a non-retryable error and after retry exhaustion. The fixture exercises the real base-class batching/retry implementation; it makes no provider requests.\n\n## Expected behavior\n\nProposed behavior: before propagating a batch failure, cancel and await the other coroutine tasks owned by this call, allowing their cleanup to finish. Preserve the original exception. Please confirm whether this failure-lifetime contract is intended; I would be happy to contribute a focused fix and regression tests.\n\n## Steps to reproduce\n\nOn the commit below, install the development dependencies, save this as tests/embedding_batch_lifecycle_repro_test.py, then run:\n\n```sh\npython -m pytest tests/embedding_batch_lifecycle_repro_test.py -q -s\n```\n\n```python\nimport asyncio\nimport unittest\n\nfrom agentscope.credential import OpenAICredential\nfrom agentscope.embedding import EmbeddingModelBase, EmbeddingResponse\n\n\nclass RetryableError(RuntimeError):\n    pass\n\n\nclass LocalEmbedding(EmbeddingModelBase[str]):\n    def __init__(self, retryable=False):\n        super().__init__(\n            credential=OpenAICredential(api_key=\"unused-local-fixture\"),\n            model=\"local-fixture\", dimensions=1, parameters=None,\n            context_size=100, batch_size=1,\n            max_retries=1 if retryable else 0, retry_delay=0,\n        )\n        self.started = asyncio.Event()\n        self.release = asyncio.Event()\n        self.finished = asyncio.Event()\n        self.completed_late = False\n        self.retryable = retryable\n        self.attempts = 0\n\n    @classmethod\n    def _get_retryable_exceptions(cls):\n        return (RetryableError,)\n\n    async def _call_api(self, inputs, **kwargs):\n        if inputs == [\"fail\"]:\n            await self.started.wait()\n            self.attempts += 1\n            if self.retryable:\n                raise RetryableError(\"batch failed\")\n            raise ValueError(\"batch failed\")\n        self.started.set()\n        try:\n            await self.release.wait()\n            self.completed_late = True\n            return EmbeddingResponse(embeddings=[[1.0]])\n        finally:\n            self.finished.set()\n\n\nclass BatchLifecycleTest(unittest.IsolatedAsyncioTestCase):\n    async def check_failed_call(self, retryable):\n        model = LocalEmbedding(retryable=retryable)\n        try:\n            with self.assertRaisesRegex((ValueError, RetryableError), \"batch failed\"):\n                await model([\"fail\", \"slow\"])\n            finished_at_return = model.finished.is_set()\n            model.release.set()\n            await asyncio.wait_for(model.finished.wait(), 1)\n            print({\"retryable\": retryable, \"failure_attempts\": model.attempts,\n                   \"sibling_finished_when_error_returned\": finished_at_return,\n                   \"sibling_completed_after_error\": model.completed_late})\n            self.assertTrue(finished_at_return,\n                            \"The embedding call returned while a sibling batch was still running\")\n        finally:\n            model.release.set()\n            await asyncio.wait_for(model.finished.wait(), 1)\n\n    async def test_nonretryable_failure_joins_siblings(self):\n        await self.check_failed_call(False)\n\n    async def test_exhausted_retry_joins_siblings(self):\n        await self.check_failed_call(True)\n\n    async def test_parent_cancellation_already_cleans_up(self):\n        model = LocalEmbedding()\n        call = asyncio.create_task(model([\"slow\"]))\n        await model.started.wait()\n        call.cancel()\n        with self.assertRaises(asyncio.CancelledError):\n            await call\n        self.assertTrue(model.finished.is_set())\n        self.assertFalse(model.completed_late)\n\n    async def test_success_control(self):\n        model = LocalEmbedding()\n        model.release.set()\n        response = await model([\"slow\", \"slow\"])\n        self.assertEqual(response.embeddings, [[1.0], [1.0]])\n```\n\nObserved: **2 failed, 2 passed**. The failing assertions express the proposed cleanup contract. Both failure cases print `sibling_finished_when_error_returned=False` and `sibling_completed_after_error=True`. The retryable case makes two attempts. Success and parent cancellation are passing controls. Events establish the ordering; the one-second waits are only teardown/test bounds.\n\n## Environment\n\n- AgentScope main: 72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6 (2.0.10dev)\n- Linux, Python 3.12.14\n- Isolated container, test execution without network access\n- Local simulated provider; no external service or real API key required\n\n## Acceptance criteria\n\n- [ ] A non-retryable batch failure cancels and joins cooperative sibling tasks before returning the original error.\n- [ ] Retry exhaustion has the same cleanup behavior without changing the retry count.\n- [ ] Successful result ordering and caller-initiated cancellation remain intact.\n\n## Additional context\n\nThe relevant code is `src/agentscope/embedding/_embedding_base.py`, in `__call__` and `_call_with_retry`. Related PR #2982 handles sibling cleanup for team pipelines; this report concerns embedding batching. #2967 concerns merged response metadata, and #3036 concerns partial provider responses. I searched existing issues and PRs and did not find the same embedding task-lifetime report.\n\nScope: cancelling a coroutine cannot undo a remote request or guarantee termination of an already-running blocking SDK call dispatched through asyncio.to_thread. The proposed fix concerns owned coroutine lifetime and cleanup, not rollback of provider-side work.\n\nAI assistance was used for the investigation and report. The reproduction was executed against the actual base-class implementation.\n\n", "hints_text": "/assign\nIt's yours, @sxh313. If there is no pull request and no word from you by 2026-10-20 the claim is released so nobody is blocked \u2014 a comment here renews it.\nHi @sxh313, thanks for taking an interest in this! I opened this issue after reproducing the batch-lifetime problem and have already been working on a focused fix. I should have posted a progress update and claimed it earlier \u2014 sorry for the coordination gap.\n\nThe local change cancels and joins sibling batch tasks before propagating the original failure, and avoids cancelling tasks again when they are already cleaning up. The focused tests pass (5 tests and 4 subtests), covering failures, retry exhaustion, cancellation, ordering, and empty input. The full pre-commit checks also pass; the full test suite is still running. No PR for this issue has been opened yet.\n\nWould you be comfortable with me finishing and submitting this fix? If you have already started, please let me know so we can coordinate and avoid duplicate work. I can share the current patch and test cases. The work is AI-assisted and will be submitted as a draft for author review.\n\nThis issue is already claimed by @sxh313. The claim is released after 14 days with no pull request and no word from them, and you are welcome to take it then.", "created_at": "2026-10-06T11:03:09Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3142, "instance_id": "agentscope-ai__agentscope-3142", "issue_numbers": ["3140"], "base_commit": "e4c1e074dee3f0f6cca28ca29e934c4ec0605354", "patch": "diff --git a/src/agentscope/embedding/_openai/_model.py b/src/agentscope/embedding/_openai/_model.py\nindex d0f95a3720..81963d2a49 100644\n--- a/src/agentscope/embedding/_openai/_model.py\n+++ b/src/agentscope/embedding/_openai/_model.py\n@@ -139,9 +139,13 @@ async def _call_api(\n         if self.pass_dimensions:\n             api_kwargs[\"dimensions\"] = self.dimensions\n \n+        cache_identifier: dict[str, Any] = {\n+            \"base_url\": str(self.client.base_url),\n+            \"api_kwargs\": api_kwargs,\n+        }\n         if self.embedding_cache:\n             cached = await self.embedding_cache.retrieve(\n-                identifier=api_kwargs,\n+                identifier=cache_identifier,\n             )\n             if cached:\n                 return EmbeddingResponse(\n@@ -168,7 +172,7 @@ async def _call_api(\n \n         if self.embedding_cache:\n             await self.embedding_cache.store(\n-                identifier=api_kwargs,\n+                identifier=cache_identifier,\n                 embeddings=embeddings,\n             )\n \n", "test_patch": "diff --git a/tests/embedding_openai_test.py b/tests/embedding_openai_test.py\nindex e625140171..d7e7e84424 100644\n--- a/tests/embedding_openai_test.py\n+++ b/tests/embedding_openai_test.py\n@@ -3,6 +3,7 @@\n \"\"\"Unit tests for OpenAIEmbeddingModel.\"\"\"\n from dataclasses import asdict\n import json\n+from tempfile import TemporaryDirectory\n from typing import Any\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock, patch\n@@ -10,7 +11,7 @@\n from utils import AnyValue\n \n from agentscope.credential import OpenAICredential\n-from agentscope.embedding import OpenAIEmbeddingModel\n+from agentscope.embedding import FileEmbeddingCache, OpenAIEmbeddingModel\n \n A = AnyValue()\n \n@@ -263,3 +264,77 @@ async def test_retry_on_transient_error(\n \n         self.assertEqual(result[\"embeddings\"], [[0.1]])\n         self.assertEqual(mock_client.embeddings.create.await_count, 2)\n+\n+    async def test_cache_isolated_by_base_url(self) -> None:\n+        \"\"\"Different endpoints do not share cached embedding vectors.\"\"\"\n+        import httpx\n+        import openai\n+\n+        requests = []\n+\n+        def handle_request(request: httpx.Request) -> httpx.Response:\n+            requests.append(request)\n+            self.assertEqual(request.url.path, \"/v1/embeddings\")\n+            self.assertEqual(\n+                json.loads(request.content),\n+                {\n+                    \"input\": [\"hello\"],\n+                    \"model\": \"shared-name\",\n+                    \"encoding_format\": \"float\",\n+                    \"dimensions\": 2,\n+                },\n+            )\n+            vector = (\n+                [1.0, 0.0]\n+                if request.url.host == \"endpoint-a.test\"\n+                else [0.0, 1.0]\n+            )\n+            return httpx.Response(\n+                200,\n+                json={\n+                    \"object\": \"list\",\n+                    \"model\": \"shared-name\",\n+                    \"data\": [\n+                        {\n+                            \"object\": \"embedding\",\n+                            \"index\": 0,\n+                            \"embedding\": vector,\n+                        },\n+                    ],\n+                    \"usage\": {\"prompt_tokens\": 1, \"total_tokens\": 1},\n+                },\n+            )\n+\n+        def create_client(**kwargs: Any) -> openai.AsyncOpenAI:\n+            return openai.AsyncOpenAI(\n+                http_client=httpx.AsyncClient(\n+                    transport=httpx.MockTransport(handle_request),\n+                ),\n+                **kwargs,\n+            )\n+\n+        cases = [\n+            (\"https://endpoint-a.test/v1\", [[1.0, 0.0]], \"api\"),\n+            (\"https://endpoint-b.test/v1\", [[0.0, 1.0]], \"api\"),\n+            (\"https://endpoint-a.test/v1/\", [[1.0, 0.0]], \"cache\"),\n+            (\"https://endpoint-b.test/v1/\", [[0.0, 1.0]], \"cache\"),\n+        ]\n+        with TemporaryDirectory() as cache_dir:\n+            with patch(\"openai.AsyncClient\", side_effect=create_client):\n+                for base_url, vectors, source in cases:\n+                    with self.subTest(base_url=base_url):\n+                        model = OpenAIEmbeddingModel(\n+                            credential=OpenAICredential(\n+                                api_key=\"local-test-key\",\n+                                base_url=base_url,\n+                            ),\n+                            model=\"shared-name\",\n+                            dimensions=2,\n+                            embedding_cache=FileEmbeddingCache(cache_dir),\n+                        )\n+                        async with model.client:\n+                            result = await model([\"hello\"])\n+                        self.assertEqual(result.embeddings, vectors)\n+                        self.assertEqual(result.source, source)\n+\n+        self.assertEqual(len(requests), 2)\n", "problem_statement": "OpenAI embedding cache reuses vectors across different API endpoints\n### What happened\n\n`OpenAIEmbeddingModel` keys its embedding cache only by the API request parameters. The endpoint is missing from that identifier. Two OpenAI-compatible endpoints using the same model name, dimensions and input therefore share a cache entry, even when they serve different embedding models.\n\nWith a shared `FileEmbeddingCache`, changing the endpoint returns the first endpoint's vectors without making a request to the second endpoint. This can silently mix embedding spaces when switching a RAG backend.\n\n### Reproduction\n\nTested on `main` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`, AgentScope `2.0.10.dev0`, Python 3.14.3 and OpenAI 3.24.0. The check uses the real OpenAI SDK and two local HTTP servers; no provider credentials or external API calls are needed.\n\nThe two servers both expose `/v1/embeddings` and accept `model=\"shared-name\"`, `dimensions=2`, `input=[\"hello\"]`. Server A returns `[[1.0, 0.0]]`; server B returns `[[0.0, 1.0]]`.\n\n```python\ncache = FileEmbeddingCache(cache_dir)\n\nmodel_a = OpenAIEmbeddingModel(\n    credential=OpenAICredential(api_key=\"local-test-key\", base_url=url_a),\n    model=\"shared-name\", dimensions=2, embedding_cache=cache,\n)\nmodel_b = OpenAIEmbeddingModel(\n    credential=OpenAICredential(api_key=\"local-test-key\", base_url=url_b),\n    model=\"shared-name\", dimensions=2, embedding_cache=cache,\n)\n\nfirst = await model_a([\"hello\"])\nsecond = await model_b([\"hello\"])\n```\n\nActual result:\n\n```\nfirst:  embeddings=[[1.0, 0.0]], source='api'\nsecond: embeddings=[[1.0, 0.0]], source='cache'\nserver A requests: 1\nserver B requests: 0\n```\n\nExpected: the second call reaches server B and returns `[[0.0, 1.0]]`. A subsequent call to the same endpoint should still hit its cache.\n\n### Proposed fix\n\nInclude the SDK's resolved `client.base_url` in the cache identifier, using a separate identifier from the API kwargs. This also accounts for the SDK's default/environment-provided URL and trailing-slash normalization. API request parameters should stay unchanged, and API keys should not be part of the identifier.\n\nExisting endpoint-agnostic entries cannot safely be attributed to a provider, so treating them as cache misses is preferable to reusing potentially wrong vectors. I can submit a focused fix with endpoint isolation and same-endpoint reuse tests.\n\n", "hints_text": "", "created_at": "2026-10-05T16:47:37Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3141, "instance_id": "agentscope-ai__agentscope-3141", "issue_numbers": ["3104"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/formatter/_ollama_formatter.py b/src/agentscope/formatter/_ollama_formatter.py\nindex 56ed65ad83..3d7eb9a59f 100644\n--- a/src/agentscope/formatter/_ollama_formatter.py\n+++ b/src/agentscope/formatter/_ollama_formatter.py\n@@ -4,6 +4,7 @@\n import fnmatch\n from abc import ABC\n from typing import Any\n+from urllib.request import url2pathname\n \n import requests\n from pydantic import Field\n@@ -85,7 +86,7 @@ def _format_image_source(source: URLSource | Base64Source) -> str:\n             url = str(source.url)\n             if url.startswith(\"file://\"):\n                 # Local file - read and convert to base64\n-                file_path = url.removeprefix(\"file://\")\n+                file_path = url2pathname(url.removeprefix(\"file://\"))\n                 with open(file_path, \"rb\") as f:\n                     data = base64.b64encode(f.read()).decode(\"utf-8\")\n                 return data\n", "test_patch": "diff --git a/tests/formatter_ollama_test.py b/tests/formatter_ollama_test.py\nindex f7b6a90f68..9c1587bfbb 100644\n--- a/tests/formatter_ollama_test.py\n+++ b/tests/formatter_ollama_test.py\n@@ -2,6 +2,9 @@\n \"\"\"Comprehensive formatter unit tests for OllamaChatFormatter and\n OllamaMultiAgentFormatter, with exact ground-truth comparisons.\n \"\"\"\n+import base64\n+from pathlib import Path\n+from tempfile import TemporaryDirectory\n from unittest import IsolatedAsyncioTestCase\n \n from agentscope.formatter import OllamaChatFormatter, OllamaMultiAgentFormatter\n@@ -15,6 +18,7 @@\n     ToolResultBlock,\n     ToolResultState,\n     Base64Source,\n+    URLSource,\n     ThinkingBlock,\n     HintBlock,\n )\n@@ -296,6 +300,55 @@ async def test_chat_formatter_base64_image(self) -> None:\n             res,\n         )\n \n+    async def test_formatters_read_percent_encoded_file_urls(self) -> None:\n+        \"\"\"Local file URLs are decoded before their paths are opened.\"\"\"\n+        with TemporaryDirectory() as directory:\n+            image_path = Path(directory) / \"image #1.png\"\n+            image_path.write_bytes(base64.b64decode(self.image_b64))\n+            msgs = [\n+                UserMsg(\n+                    name=\"user\",\n+                    content=[\n+                        TextBlock(text=\"What is this?\"),\n+                        DataBlock(\n+                            source=URLSource(\n+                                url=image_path.as_uri(),\n+                                media_type=\"image/png\",\n+                            ),\n+                        ),\n+                    ],\n+                ),\n+            ]\n+\n+            chat_result = await OllamaChatFormatter().format(msgs)\n+            multiagent_result = await OllamaMultiAgentFormatter().format(msgs)\n+\n+        self.assertListEqual(\n+            [\n+                {\n+                    \"role\": \"user\",\n+                    \"content\": \"What is this?\",\n+                    \"images\": [self.image_b64],\n+                },\n+            ],\n+            chat_result,\n+        )\n+        self.assertListEqual(\n+            [\n+                {\n+                    \"role\": \"user\",\n+                    \"content\": (\n+                        \"# Conversation History\\n\"\n+                        \"The content between <history></history> tags \"\n+                        \"contains your conversation history\\n\"\n+                        \"<history>\\nuser:\\nWhat is this?\\n</history>\"\n+                    ),\n+                    \"images\": [self.image_b64],\n+                },\n+            ],\n+            multiagent_result,\n+        )\n+\n     async def test_chat_formatter_base64_image_in_tool_result(\n         self,\n     ) -> None:\n", "problem_statement": "[Bug]: Ollama formatter cannot read percent-encoded local file URLs\n# [Bug]: Ollama formatter cannot read percent-encoded local file URLs\n\n## Prerequisites\n\n- [x] I have searched existing issues and discussions and found no report of this behavior.\n- [x] This is a bug report, not a usage question.\n\n## Background / Description\n\nPassing a local image whose filename contains a space to `OllamaChatFormatter` raises `FileNotFoundError`, even though the image exists. `Path.as_uri()` correctly encodes the space as `%20`, and `URLSource` accepts the resulting URI.\n\nExpected: the formatter reads the existing image and includes its base64 contents in the formatted message, just as it does for a filename without spaces.\n\nActual: the shared image formatter removes `file://` and passes the remaining encoded path directly to `open()`. It therefore tries to read `a%20b.png` instead of `a b.png`. The same helper is used by `OllamaMultiAgentFormatter`.\n\n## Error Messages\n\n```text\nFileNotFoundError: [Errno 2] No such file or directory: '.../a%20b.png'\n```\n\n## Steps to Reproduce\n\nSave the following as `reproduce.py` and run `python reproduce.py` in an environment with AgentScope installed. No model, API key, or Ollama server is needed.\n\n```python\nimport asyncio\nimport base64\nimport tempfile\nfrom pathlib import Path\n\nfrom agentscope.formatter import OllamaChatFormatter\nfrom agentscope.message import DataBlock, Msg, URLSource\n\nPNG = \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC\"\n\nasync def main():\n    with tempfile.TemporaryDirectory() as directory:\n        for filename in (\"image.png\", \"a b.png\"):\n            path = Path(directory) / filename\n            path.write_bytes(base64.b64decode(PNG))\n            msg = Msg(\n                name=\"user\",\n                role=\"user\",\n                content=[DataBlock(source=URLSource(\n                    url=path.as_uri(), media_type=\"image/png\",\n                ))],\n            )\n            result = await OllamaChatFormatter().format([msg])\n            assert result[0][\"images\"] == [PNG]\n            print(filename, \"OK\")\n\nasyncio.run(main())\n```\n\nThe first filename succeeds; the second raises the error above.\n\n## Environment\n\n- AgentScope version: `2.0.10dev`\n- Source: `main` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`\n- Python: 3.12.4\n- OS: macOS 26.4.1, arm64\n- Verified through the public formatter API with local files; no model request was made.\n\n## Proposed Fix\n\nDecode the local file URI path before opening it in `_OllamaFormatterBase._format_image_source`. Keep this change scoped to the shared Ollama helper and add regression tests for both formatter variants using a percent-encoded filename and a plain filename.\n\nI would be happy to contribute a focused fix and tests if this approach fits the intended behavior.\n\n", "hints_text": "/assign\nIt's yours, @qingshungLI. If there is no pull request and no word from you by 2026-10-19 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-05T16:19:34Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3136, "instance_id": "agentscope-ai__agentscope-3136", "issue_numbers": ["3132"], "base_commit": "c3c1d7fad423fe20d16482df965d05266c03c33b", "patch": "diff --git a/src/agentscope/model/_openai_response/_model.py b/src/agentscope/model/_openai_response/_model.py\nindex 569ba12b70..b30bbe7d1d 100644\n--- a/src/agentscope/model/_openai_response/_model.py\n+++ b/src/agentscope/model/_openai_response/_model.py\n@@ -281,7 +281,7 @@ async def _parse_stream_response(\n         \"\"\"\n         usage: ChatUsage | None = None\n         response_id: str = _generate_id()\n-        text_id: str = _generate_id()\n+        text_block_ids: dict[tuple[str, int], str] = {}\n         reasoning_block_ids: dict[str, dict[tuple[str, int], str]] = {}\n         # Mapping from Responses API item id (fc_xxx) to (call_id, name)\n         # so subsequent argument deltas can be routed to the right tool\n@@ -333,8 +333,19 @@ async def _parse_stream_response(\n                         ),\n                     )\n \n-                elif event_type == \"response.output_text.delta\":\n-                    delta_res.append_text(event.delta, block_id=text_id)\n+                elif event_type in (\n+                    \"response.output_text.delta\",\n+                    \"response.refusal.delta\",\n+                ):\n+                    # Keep message content parts separate while accumulating\n+                    # fragmented deltas into their original ordered blocks.\n+                    delta_res.append_text(\n+                        event.delta,\n+                        block_id=text_block_ids.setdefault(\n+                            (event.item_id, event.content_index),\n+                            _generate_id(),\n+                        ),\n+                    )\n \n                 elif event_type == \"response.output_item.added\":\n                     item = event.item\n@@ -476,6 +487,10 @@ def _parse_completion_response(\n                         content_blocks.append(\n                             TextBlock(type=\"text\", text=part.text),\n                         )\n+                    elif getattr(part, \"type\", None) == \"refusal\":\n+                        content_blocks.append(\n+                            TextBlock(type=\"text\", text=part.refusal),\n+                        )\n \n             elif item_type == \"function_call\":\n                 content_blocks.append(\n", "test_patch": "diff --git a/tests/model_openai_response_test.py b/tests/model_openai_response_test.py\nindex b2547fe0d1..0a7da8430a 100644\n--- a/tests/model_openai_response_test.py\n+++ b/tests/model_openai_response_test.py\n@@ -5,15 +5,16 @@\n Tests cover both non-streaming and streaming modes.\n OpenAI Responses API uses event-based streaming with response.completed.\n \"\"\"\n-from typing import Any\n+from typing import Any, cast\n import unittest\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock\n \n from openai import APIError\n+from openai.types.responses import ResponseOutputMessage\n from pydantic import BaseModel\n \n-from utils import AnyString\n+from utils import AnyString, AnyValue\n \n from agentscope.message import (\n     AssistantMsg,\n@@ -26,7 +27,7 @@\n     ToolResultState,\n     ThinkingBlock,\n )\n-from agentscope.model import OpenAIResponseModel\n+from agentscope.model import ChatResponse, ChatUsage, OpenAIResponseModel\n from agentscope.credential import OpenAICredential\n from agentscope.tool import ToolChoice\n \n@@ -127,6 +128,9 @@ def _mock_completion(\n \n def _make_event(event_type: str, **kwargs: Any) -> MagicMock:\n     \"\"\"Build a mock Responses API streaming event.\"\"\"\n+    if event_type in (\"response.output_text.delta\", \"response.refusal.delta\"):\n+        kwargs.setdefault(\"item_id\", \"msg_test123\")\n+        kwargs.setdefault(\"content_index\", 0)\n     event = MagicMock()\n     event.type = event_type\n     for key, val in kwargs.items():\n@@ -137,6 +141,27 @@ def _make_event(event_type: str, **kwargs: Any) -> MagicMock:\n     return event\n \n \n+def _mock_message(\n+    item_id: str,\n+    parts: list[tuple[str, str]],\n+) -> ResponseOutputMessage:\n+    \"\"\"Build SDK message parts for text/refusal parser comparisons.\"\"\"\n+    return ResponseOutputMessage.model_validate(\n+        {\n+            \"id\": item_id,\n+            \"type\": \"message\",\n+            \"role\": \"assistant\",\n+            \"status\": \"completed\",\n+            \"content\": [\n+                {\"type\": kind, \"text\": text, \"annotations\": []}\n+                if kind == \"output_text\"\n+                else {\"type\": kind, \"refusal\": text}\n+                for kind, text in parts\n+            ],\n+        },\n+    )\n+\n+\n class _MockAsyncEventStream:\n     \"\"\"Mock async iterator over Response events.\"\"\"\n \n@@ -620,6 +645,132 @@ def setUp(self) -> None:\n         self.mock_client = MagicMock()\n         self.model.client = self.mock_client\n \n+    async def test_stream_text_and_refusal_part_boundaries(self) -> None:\n+        \"\"\"Mixed parts match non-streaming without repeating done text.\"\"\"\n+        for output in (\n+            [_mock_message(\"msg_one\", [(\"refusal\", \"Cannot help.\")])],\n+            [\n+                _mock_message(\n+                    \"msg_one\",\n+                    [\n+                        (\"output_text\", \"Before.\"),\n+                        (\"refusal\", \"Cannot help.\"),\n+                        (\"output_text\", \"After.\"),\n+                    ],\n+                ),\n+            ],\n+            [\n+                _mock_message(\"msg_one\", [(\"output_text\", \"First.\")]),\n+                _mock_message(\"msg_two\", [(\"refusal\", \"Cannot help.\")]),\n+            ],\n+            [\n+                _mock_message(\n+                    \"msg_one\",\n+                    [(\"output_text\", \"First.\"), (\"output_text\", \"Second.\")],\n+                ),\n+            ],\n+        ):\n+            with self.subTest(output=output):\n+                completed = _mock_completion()\n+                completed.output = output\n+                completed.usage.input_tokens_details = MagicMock(\n+                    cached_tokens=3,\n+                )\n+                parts = [\n+                    (item.id, index, part.type, part.text)\n+                    if part.type == \"output_text\"\n+                    else (item.id, index, part.type, part.refusal)\n+                    for item in output\n+                    for index, part in enumerate(item.content)\n+                ]\n+                expected = ChatResponse(\n+                    id=A,\n+                    created_at=A,\n+                    is_last=True,\n+                    content=[\n+                        TextBlock.model_construct(\n+                            id=A,\n+                            created_at=A,\n+                            text=text,\n+                        )\n+                        for _, _, _, text in parts\n+                    ],\n+                    usage=ChatUsage(\n+                        input_tokens=10,\n+                        output_tokens=5,\n+                        cache_input_tokens=3,\n+                        time=cast(float, AnyValue()),\n+                    ),\n+                )\n+                self.model.stream = False\n+                self.mock_client.responses.create = AsyncMock(\n+                    return_value=completed,\n+                )\n+                self.assertEqual(await self.model([]), expected)\n+                self.mock_client.responses.create.assert_awaited_once()\n+\n+                events = [\n+                    _make_event(\n+                        f\"response.{kind}.delta\",\n+                        item_id=item_id,\n+                        content_index=index,\n+                        delta=text[:2] if fragment == 0 else text[2:],\n+                    )\n+                    for fragment in range(2)\n+                    for item_id, index, kind, text in parts\n+                ]\n+                events.extend(\n+                    _make_event(\n+                        f\"response.{kind}.done\",\n+                        item_id=item_id,\n+                        content_index=index,\n+                        **(\n+                            {\"text\": text}\n+                            if kind == \"output_text\"\n+                            else {\"refusal\": text}\n+                        ),\n+                    )\n+                    for item_id, index, kind, text in parts\n+                )\n+                events.append(\n+                    _make_event(\"response.completed\", response=completed),\n+                )\n+                self.model.stream = True\n+                self.mock_client.responses.create = AsyncMock(\n+                    return_value=_MockAsyncEventStream(events),\n+                )\n+                responses = [r async for r in await self.model([])]\n+                self.assertEqual(\n+                    responses[:-1],\n+                    [\n+                        ChatResponse(\n+                            id=A,\n+                            created_at=A,\n+                            is_last=False,\n+                            content=[\n+                                TextBlock.model_construct(\n+                                    id=A,\n+                                    created_at=A,\n+                                    text=text[:2]\n+                                    if fragment == 0\n+                                    else text[2:],\n+                                ),\n+                            ],\n+                        )\n+                        for fragment in range(2)\n+                        for _, _, _, text in parts\n+                    ],\n+                )\n+                self.assertEqual(responses[-1], expected)\n+                self.mock_client.responses.create.assert_awaited_once()\n+                self.assertEqual(\n+                    AssistantMsg(\n+                        name=\"assistant\",\n+                        content=responses[-1].content,\n+                    ).get_text_content(),\n+                    \"\\n\".join(text for _, _, _, text in parts),\n+                )\n+\n     async def test_stream_errors_propagate(self) -> None:\n         \"\"\"Failed stream events raise APIError instead of a partial reply.\"\"\"\n         body = {\"code\": \"server_error\", \"message\": \"Generation failed.\"}\n", "problem_statement": "[Bug]: OpenAIResponseModel drops standard refusal explanations\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nOn current main at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`, `OpenAIResponseModel` drops standard OpenAI Responses refusal explanations. A completed response with `message.content=[{\"type\":\"refusal\",\"refusal\":\"...\"}]` returns empty AgentScope content. Streaming `response.refusal.delta` fragments are also dropped. Mixed ordinary text and refusal output retains only the ordinary text.\n\nThis is an actual installed-package public model call through the real OpenAI SDK and its JSON/SSE decoder, with a deterministic local `httpx.MockTransport`. It does not extract methods or replace the production parser. No real API or paid model is called; the SDK receives a dummy non-secret auth string and a mock-only `.invalid` endpoint.\n\nExpected: the refusal explanation reaches the caller as visible output, with usage retained and without duplicating the full content when done snapshots arrive.\n\n\n## Proposed Minimal Fix\n\nUse the existing `TextBlock` representation:\n\n- Non-streaming: convert standard refusal content to `TextBlock(text=part.refusal)`, alongside existing ordinary-text handling.\n- Streaming: consume `response.refusal.delta` through the existing text accumulation path.\n- Keep done events as snapshots rather than append their complete text again.\n- Preserve usage, ordinary text, mixed-content order and existing completion behavior.\n\nThis proposal adds no public type or API, and does not change refusal status, history replay, done-only fallback, reasoning parsing or stream-error handling. It is independent of the ReMe proposal.\n\nRelated work was checked: #2907 / #2916 address reasoning text, #3081 / #3086 stream errors, and #3029 response IDs. Their patches do not handle refusals; this report does not expand into those issues.\n\nImplemented in #3136.\n\n\n### Error Messages\n\n```shell\n{'stream': False, 'content': [], 'is_last': True, 'input_tokens': 11, 'output_tokens': 7, 'cached_tokens': 3}\n{'stream': True, 'content': [], 'is_last': True, 'input_tokens': 11, 'output_tokens': 7, 'cached_tokens': 3}\n\nThe server fixture carries `I cannot help with that request.` in both modes. The returned content is empty even though the response completes and usage is retained.\n```\n\n### Steps to Reproduce\n\nSave as `reproduce_refusal.py` in an environment with AgentScope and its OpenAI extra, then run `python reproduce_refusal.py`. No genuine API key or external server is required.\n\n```python\n\"\"\"Reproduce both modes through the public model with no real API call.\"\"\"\n\nimport asyncio\nimport json\n\nimport httpx\n\nfrom agentscope.credential import OpenAICredential\nfrom agentscope.message import UserMsg\nfrom agentscope.model import OpenAIResponseModel\n\n\nasync def reproduce(stream):\n    \"\"\"Return a completed refusal using the real SDK JSON/SSE decoder.\"\"\"\n    body = {\n        \"id\": \"resp_local\",\n        \"object\": \"response\",\n        \"created_at\": 0,\n        \"status\": \"completed\",\n        \"error\": None,\n        \"incomplete_details\": None,\n        \"instructions\": None,\n        \"model\": \"gpt-4.1-mini\",\n        \"output\": [{\n            \"id\": \"msg_local\",\n            \"type\": \"message\",\n            \"role\": \"assistant\",\n            \"status\": \"completed\",\n            \"content\": [{\n                \"type\": \"refusal\",\n                \"refusal\": \"I cannot help with that request.\",\n            }],\n        }],\n        \"parallel_tool_calls\": True,\n        \"temperature\": 1.0,\n        \"tool_choice\": \"auto\",\n        \"tools\": [],\n        \"top_p\": 1.0,\n        \"usage\": {\n            \"input_tokens\": 11,\n            \"input_tokens_details\": {\"cached_tokens\": 3, \"cache_write_tokens\": 0},\n            \"output_tokens\": 7,\n            \"output_tokens_details\": {\"reasoning_tokens\": 0},\n            \"total_tokens\": 18,\n        },\n    }\n\n    async def handle(request):\n        assert str(request.url) == \"https://responses.test.invalid/v1/responses\"\n        if not stream:\n            return httpx.Response(200, json=body)\n        events = [{\n            \"type\": \"response.refusal.delta\",\n            \"sequence_number\": 0,\n            \"content_index\": 0,\n            \"item_id\": \"msg_local\",\n            \"output_index\": 0,\n            \"delta\": \"I cannot help with that request.\",\n        }, {\n            \"type\": \"response.refusal.done\",\n            \"sequence_number\": 1,\n            \"content_index\": 0,\n            \"item_id\": \"msg_local\",\n            \"output_index\": 0,\n            \"refusal\": \"I cannot help with that request.\",\n        }, {\n            \"type\": \"response.completed\",\n            \"sequence_number\": 2,\n            \"response\": body,\n        }]\n        sse = \"\".join(\n            f\"event: {event['type']}\\ndata: {json.dumps(event)}\\n\\n\"\n            for event in events\n        ) + \"data: [DONE]\\n\\n\"\n        return httpx.Response(\n            200,\n            headers={\"content-type\": \"text/event-stream\"},\n            content=sse,\n        )\n\n    async with httpx.AsyncClient(transport=httpx.MockTransport(handle)) as client:\n        model = OpenAIResponseModel(\n            credential=OpenAICredential(\n                api_key=\"local-transport-only\",\n                base_url=\"https://responses.test.invalid/v1\",\n            ),\n            model=\"gpt-4.1-mini\",\n            stream=stream,\n            max_retries=0,\n            client_kwargs={\"http_client\": client},\n        )\n        result = await model([UserMsg(name=\"tester\", content=\"Local test.\")])\n        if stream:\n            result = [chunk async for chunk in result][-1]\n        print({\n            \"stream\": stream,\n            \"content\": result.content,\n            \"is_last\": result.is_last,\n            \"input_tokens\": result.usage.input_tokens,\n            \"output_tokens\": result.usage.output_tokens,\n            \"cached_tokens\": result.usage.cache_input_tokens,\n        })\n\n\nasync def main():\n    \"\"\"Reproduce non-streaming and streaming refusal loss.\"\"\"\n    await reproduce(False)\n    await reproduce(True)\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n```\n\n\n## Additional Local Qualification\n\nA separate seven-case public-runtime harness tests ordinary non-streaming text and fragmented text streaming controls; refusal-only non-streaming, single-delta and fragmented streaming; and mixed content in both modes. SSE bytes are fragmented independently of semantic deltas. Refusal/text done, content-part done, output-item done and response-completed snapshots are included.\n\nBaseline: **2 controls passed, 5 refusal/mixed cases failed**. Usage remains input 11/output 7/cached 3; each case makes one mock request. All three completion fixtures and 43 SSE events pass the installed OpenAI SDK's strict schema validation. Ordinary-text done snapshots do not duplicate output.\n\nExisting Responses model and formatter regression tests: **37 passed, 4 subtests passed**. Evidence was independently reviewed.\n\n\n### Environment\n\n- AgentScope: `2.0.10.dev0`, current main `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`\n- Python: `3.11.16`\n- OpenAI SDK: `3.24.0`\n- httpx: `0.28.1`\n- OS: cloud Linux x86_64\n", "hints_text": "/assign\nIt's yours, @GoldArowana. If there is no pull request and no word from you by 2026-10-19 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-05T09:20:40Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3135, "instance_id": "agentscope-ai__agentscope-3135", "issue_numbers": ["3134"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/tool/_adapters.py b/src/agentscope/tool/_adapters.py\nindex 67f6e0acf3..d62aa6bd87 100644\n--- a/src/agentscope/tool/_adapters.py\n+++ b/src/agentscope/tool/_adapters.py\n@@ -144,10 +144,9 @@ async def call(\n             `ToolChunk` or `AsyncGenerator[ToolChunk, None]`:\n                 The normalized result of the function execution.\n         \"\"\"\n-        if inspect.iscoroutinefunction(self._func):\n-            result = await self._func(**kwargs)\n-        else:\n-            result = self._func(**kwargs)\n+        result = self._func(**kwargs)\n+        if inspect.isawaitable(result):\n+            result = await result\n \n         if isinstance(result, AsyncGenerator):\n \n", "test_patch": "diff --git a/tests/toolkit_test.py b/tests/toolkit_test.py\nindex bb9d6acc22..0865310e12 100644\n--- a/tests/toolkit_test.py\n+++ b/tests/toolkit_test.py\n@@ -3,7 +3,7 @@\n \"\"\"Toolkit test case.\"\"\"\n import base64\n import json\n-from typing import Any, AsyncGenerator, Generator, Literal\n+from typing import Any, AsyncGenerator, Awaitable, Generator, Literal\n from unittest import TestCase\n from unittest.async_case import IsolatedAsyncioTestCase\n \n@@ -494,6 +494,87 @@ async def test_tool_response_merges_base64_chunks_by_bytes(self) -> None:\n class RegisterFunctionTest(IsolatedAsyncioTestCase):\n     \"\"\"Test registering different functions in the toolkit.\"\"\"\n \n+    async def test_sync_function_returning_awaitable(self) -> None:\n+        \"\"\"Await the coroutine returned by a sync function.\"\"\"\n+\n+        async def finish(value: str) -> ToolChunk:\n+            \"\"\"Create the deferred tool result.\"\"\"\n+            return ToolChunk(content=[TextBlock(text=value)])\n+\n+        def deferred(value: str) -> Awaitable[ToolChunk]:\n+            \"\"\"Return a coroutine without executing it.\"\"\"\n+            return finish(value)\n+\n+        toolkit = Toolkit(tools=[FunctionTool(deferred)])\n+        results = [\n+            item\n+            async for item in toolkit.call_tool(\n+                ToolCallBlock(\n+                    id=\"awaitable\",\n+                    name=\"deferred\",\n+                    input='{\"value\": \"completed\"}',\n+                ),\n+                AgentState(),\n+            )\n+        ]\n+        self.assertDictEqual(\n+            results[-1].model_dump(),\n+            {\n+                \"content\": [\n+                    {\n+                        \"type\": \"text\",\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                        \"id\": AnyString(),\n+                        \"text\": \"completed\",\n+                    },\n+                ],\n+                \"state\": \"success\",\n+                \"metadata\": {},\n+                \"id\": \"awaitable\",\n+            },\n+        )\n+\n+    async def test_async_callable_tool(self) -> None:\n+        \"\"\"Await an async callable object.\"\"\"\n+\n+        class Deferred:\n+            \"\"\"A callable tool that resolves asynchronously.\"\"\"\n+\n+            async def __call__(self, value: str) -> ToolChunk:\n+                \"\"\"Create a tool result asynchronously.\n+\n+                Args:\n+                    value (`str`):\n+                        The text to include in the result.\n+\n+                Returns:\n+                    `ToolChunk`:\n+                        The completed tool result.\n+                \"\"\"\n+                return ToolChunk(content=[TextBlock(text=value)])\n+\n+        tool = FunctionTool(Deferred(), name=\"deferred\")\n+        result = await tool.call(value=\"completed\")\n+        self.assertDictEqual(\n+            result.model_dump(),\n+            {\n+                \"content\": [\n+                    {\n+                        \"type\": \"text\",\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                        \"id\": AnyString(),\n+                        \"text\": \"completed\",\n+                    },\n+                ],\n+                \"state\": \"running\",\n+                \"is_last\": True,\n+                \"metadata\": {},\n+                \"id\": AnyString(),\n+            },\n+        )\n+\n     async def test_sync_non_streaming_function(self) -> None:\n         \"\"\"Test registering a synchronous non-streaming function.\"\"\"\n \n", "problem_statement": "[Bug]: FunctionTool returns coroutine text instead of awaiting deferred tools\n### Description\n\n`FunctionTool` turns a coroutine returned by a regular function into a text tool result instead of awaiting it. The async work never runs, and `Toolkit.call_tool()` reports success with `<coroutine object ...>` as the answer. The declared `Function` type includes callables returning `Awaitable[ToolChunk]`, so these wrappers should work like an `async def` tool.\n\n### Reproduction\n\n```python\nimport asyncio\nimport json\nfrom agentscope.message import ToolCallBlock\nfrom agentscope.state import AgentState\nfrom agentscope.tool import FunctionTool, Toolkit, ToolResponse\n\nasync def finish(value: str):\n    return \"completed: \" + value\n\ndef deferred(value: str):\n    return finish(value)\n\nasync def main():\n    toolkit = Toolkit(tools=[FunctionTool(deferred)])\n    call = ToolCallBlock(id=\"deferred-1\", name=\"deferred\", input=json.dumps({\"value\": \"hello\"}))\n    async for item in toolkit.call_tool(call, AgentState()):\n        if isinstance(item, ToolResponse):\n            print(item.content[0].text)\n\nasyncio.run(main())\n```\n\nExpected: `completed: hello`.\n\nObserved on main at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`, Windows x86-64, Python 3.12.2: a coroutine repr plus `RuntimeWarning: coroutine ... was never awaited`. No model or external service is involved.\n\n### Proposed fix\n\nIn `FunctionTool.call`, invoke the callable once, then await its result when `inspect.isawaitable(result)` is true before normalizing it. This also covers `Future` results and async callable objects. The existing handling of synchronous and asynchronous streams stays in place. I plan to add public Toolkit regression tests for successful results, streams, and exceptions.\n\n", "hints_text": "", "created_at": "2026-10-05T09:07:15Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3131, "instance_id": "agentscope-ai__agentscope-3131", "issue_numbers": ["3130"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/app/rag/index_worker/__main__.py b/src/agentscope/app/rag/index_worker/__main__.py\nindex 8addeddfcf..05eb3b1a93 100644\n--- a/src/agentscope/app/rag/index_worker/__main__.py\n+++ b/src/agentscope/app/rag/index_worker/__main__.py\n@@ -87,7 +87,7 @@ def main() -> None:\n     because backend selection is a deployment concern.\n     \"\"\"\n     logging.basicConfig(\n-        level=os.environ.get(\"LOG_LEVEL\", \"INFO\"),\n+        level=os.environ.get(\"LOG_LEVEL\", \"INFO\").strip().upper() or \"INFO\",\n         format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n     )\n     bootstrap_path = os.environ.get(\"AGENTSCOPE_WORKER_BOOTSTRAP\")\n", "test_patch": "diff --git a/tests/index_worker_main_test.py b/tests/index_worker_main_test.py\nnew file mode 100644\nindex 0000000000..80e977569a\n--- /dev/null\n+++ b/tests/index_worker_main_test.py\n@@ -0,0 +1,33 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"Unit tests for the index worker entry point.\"\"\"\n+import logging\n+import os\n+import unittest\n+from unittest.mock import patch\n+\n+from agentscope.app.rag.index_worker.__main__ import main\n+\n+\n+class IndexWorkerMainTest(unittest.TestCase):\n+    \"\"\"Tests for the index worker entry point.\"\"\"\n+\n+    def test_lowercase_log_level(self) -> None:\n+        \"\"\"A lowercase ``LOG_LEVEL`` configures logging instead of crashing.\"\"\"\n+        # basicConfig is a no-op while the root logger has handlers\n+        handlers, level = logging.root.handlers[:], logging.root.level\n+        logging.root.handlers.clear()\n+        try:\n+            with patch.dict(os.environ, {\"LOG_LEVEL\": \"debug\"}, clear=True):\n+                with self.assertRaises(SystemExit) as ctx:\n+                    main()\n+            self.assertListEqual(\n+                [ctx.exception.code, logging.root.level],\n+                [2, logging.DEBUG],\n+            )\n+        finally:\n+            logging.root.handlers[:] = handlers\n+            logging.root.setLevel(level)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n", "problem_statement": "[Bug]: index worker dies on LOG_LEVEL=info / empty / numeric before it can report a missing bootstrap\n### Prerequisites\n\n- [x] I searched existing issues, discussions, PRs, and relevant history. This is not a duplicate.\n- [x] This is a defect report with a deterministic reproduction, not a usage question.\n\n### Background / Description\n\n`python -m agentscope.app.rag.index_worker` passes the `LOG_LEVEL` environment variable straight into `logging.basicConfig` without resolving it, so any spelling that `logging` does not accept kills the worker at startup.\n\n`src/agentscope/app/rag/index_worker/__main__.py:89-92` (the only `logging.basicConfig` call site in `src/` \u2014 `grep -rn \"logging.basicConfig\" src` returns this one hit):\n\n```python\n    logging.basicConfig(\n        level=os.environ.get(\"LOG_LEVEL\", \"INFO\"),\n        format=\"%(asctime)s %(levelname)s %(name)s %(message)s\",\n    )\n```\n\n`logging.basicConfig` reaches `_checkLevel`, which accepts an `int` or a string that is a **key of `_nameToLevel`** \u2014 those keys are upper-case (`\"CRITICAL\"`, `\"ERROR\"`, `\"WARNING\"`, `\"INFO\"`, `\"DEBUG\"`). A string is never case-folded and never converted from digits, so the three shapes operators actually write into env files and container log drivers all raise:\n\n- `LOG_LEVEL=info` \u2014 lower-case, the commonest spelling outside Python\n- `LOG_LEVEL=\"\"` \u2014 an unset key rendered as empty by a compose/k8s `env:` block or a templated `.env`\n- `LOG_LEVEL=20` \u2014 numeric strings, which is how many log drivers and `systemd` units express a level\n\nThe value is also not stripped, so a YAML scalar like `LOG_LEVEL: \" debug \"` fails the same way.\n\n### Actual behaviour\n\nMeasured on `main` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`, Python 3.11, against the installed package:\n\n```text\nLOG_LEVEL=''    -> ValueError: Unknown level: ''\nLOG_LEVEL='info'-> ValueError: Unknown level: 'info'\nLOG_LEVEL='20'  -> ValueError: Unknown level: '20'\nLOG_LEVEL='INFO'-> no error, proceeds to the bootstrap check\n```\n\nTwo things are lost at once. The process dies with an unhandled traceback instead of starting, and because `basicConfig` runs *above* the bootstrap check, the operator never sees the actionable message the module deliberately writes for a missing `AGENTSCOPE_WORKER_BOOTSTRAP` (`__main__.py:93-99`, exit code `2`). A typo in a log setting therefore looks like a crash inside AgentScope rather than a misconfiguration, and points the operator at the wrong file.\n\n### Steps to Reproduce\n\n```bash\nLOG_LEVEL=info python -m agentscope.app.rag.index_worker\n```\n\nor, without the module entry point:\n\n```python\nimport os\nfrom agentscope.app.rag.index_worker.__main__ import main\nos.environ[\"LOG_LEVEL\"] = \"info\"\nos.environ.pop(\"AGENTSCOPE_WORKER_BOOTSTRAP\", None)\nmain()   # ValueError: Unknown level: 'info'\n```\n\n### Expected behaviour\n\nAn unusable `LOG_LEVEL` should not be able to stop the worker. A readable spelling should take effect; anything unreadable should fall back to `INFO` and say so once on the log, the way the module already reports a missing bootstrap on stderr rather than raising.\n\n### Scope of a fix\n\nA small resolver used at this one call site, covering: case-insensitive names, surrounding whitespace, numeric strings, and an empty/unset value meaning \"not configured\" (\u2192 `INFO`). Unparseable values fall back to `INFO` with one warning naming the rejected value. No public schema changes, no new dependency, and `LOG_LEVEL=INFO`/`WARNING`/etc. keep working exactly as before.\n\nOne note for whoever writes the test: `logging.basicConfig` returns early once the root logger has any handler, and pytest's logging plugin installs one \u2014 so a test that exercises this under pytest passes without the fix unless it clears `logging.root.handlers` first. A plain `assert root.level == INFO` is also not enough to prove a numeric string was parsed rather than rescued, since `20` and the fallback are the same number; the assertion needs to pair with \"no warning was emitted\".\n\n### Duplicate check\n\nDumped every issue and PR in the repository (`--paginate repos/agentscope-ai/agentscope/issues?state=all`, 2991 rows, numbers 1\u20133129) and grepped titles plus bodies: `LOG_LEVEL` \u2014 0 hits, `Unknown level` \u2014 0 hits.\n\n### Environment\n\n- AgentScope: `main` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`\n- Python: 3.11\n- OS: Windows 11 for the measurement above; the defect is plain environment-string handling and reproduces identically on Linux and macOS\n\n", "hints_text": "", "created_at": "2026-10-05T06:04:58Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3119, "instance_id": "agentscope-ai__agentscope-3119", "issue_numbers": ["3118"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/app/hub/_skill/_claw_hub.py b/src/agentscope/app/hub/_skill/_claw_hub.py\nindex a009a1c0ba..4f703f8d2f 100644\n--- a/src/agentscope/app/hub/_skill/_claw_hub.py\n+++ b/src/agentscope/app/hub/_skill/_claw_hub.py\n@@ -641,7 +641,10 @@ async def get_skill(self, user_id: str, card_id: str) -> SkillCard:\n         item[\"owner\"] = payload.get(\"owner\")\n \n         card = self._to_card(item)\n-        parsed = await asyncio.to_thread(frontmatter.loads, markdown.text)\n+        parsed = await asyncio.to_thread(\n+            frontmatter.loads,\n+            markdown.text.removeprefix(\"\\ufeff\"),\n+        )\n         card.markdown = parsed.content\n         if not card.description:\n             card.description = str(parsed.get(\"description\", \"\"))\n", "test_patch": "diff --git a/tests/hub_claw_test.py b/tests/hub_claw_test.py\nindex f3f458c120..b920008985 100644\n--- a/tests/hub_claw_test.py\n+++ b/tests/hub_claw_test.py\n@@ -1,10 +1,62 @@\n # -*- coding: utf-8 -*-\n \"\"\"ClawHub card-building test case, without any network.\"\"\"\n-from unittest import TestCase\n+from unittest import IsolatedAsyncioTestCase, TestCase\n+from unittest.mock import patch\n+\n+import httpx\n \n from agentscope.app.hub import ClawSkillHub\n \n \n+class ClawSkillContentTest(IsolatedAsyncioTestCase):\n+    \"\"\"Parsing skill content returned by the ClawHub file endpoint.\"\"\"\n+\n+    async def test_skill_frontmatter_with_utf8_bom(self) -> None:\n+        \"\"\"A BOM-prefixed ``SKILL.md`` still has its frontmatter parsed.\"\"\"\n+        skill_md = (\n+            \"\\ufeff---\\nname: demo\\ndescription: Frontmatter description\\n\"\n+            \"---\\n\\n# Demo\\nRun the demo.\"\n+        )\n+\n+        def respond(request: httpx.Request) -> httpx.Response:\n+            if request.url.path.endswith(\"/file\"):\n+                return httpx.Response(200, text=skill_md)\n+            return httpx.Response(\n+                200,\n+                json={\n+                    \"skill\": {\"slug\": \"demo\"},\n+                    \"owner\": {\"handle\": \"alice\"},\n+                    \"latestVersion\": {\"version\": \"1.2.3\"},\n+                },\n+            )\n+\n+        client = httpx.AsyncClient(transport=httpx.MockTransport(respond))\n+        with patch(\"httpx.AsyncClient\", return_value=client):\n+            async with ClawSkillHub() as hub:\n+                card = await hub.get_skill(\"user\", \"alice/demo\")\n+\n+        self.assertDictEqual(\n+            card.model_dump(),\n+            {\n+                \"hub_id\": \"clawhub\",\n+                \"id\": \"alice/demo\",\n+                \"name\": \"demo\",\n+                \"description\": \"Frontmatter description\",\n+                \"display_name\": None,\n+                \"tags\": [],\n+                \"version\": \"1.2.3\",\n+                \"updated_at\": None,\n+                \"author\": \"alice\",\n+                \"icon_url\": None,\n+                \"installs\": None,\n+                \"downloads\": None,\n+                \"url\": \"https://clawhub.ai/skills/demo\",\n+                \"markdown\": \"# Demo\\nRun the demo.\",\n+                \"metadata\": {},\n+            },\n+        )\n+\n+\n class ClawCardTest(TestCase):\n     \"\"\"Turning an upstream catalog record into a ``SkillCard``.\"\"\"\n \n", "problem_statement": "[Bug]: ClawSkillHub keeps BOM-prefixed SKILL.md frontmatter in the body\n### Prerequisites\n\n- [x] I have searched existing issues and pull requests and have not found an open report or fix for this ClawHub parsing path.\n- [x] This is a reproducible bug, not a usage question.\n\n### Background / Description\n\n`ClawSkillHub.get_skill()` passes the decoded `SKILL.md` response directly to `frontmatter.loads()`. When the UTF-8 file starts with a byte order mark (`EF BB BF`, decoded as `U+FEFF`), the opening `---` delimiter is not recognized. The returned `SkillCard.markdown` contains the BOM and the entire YAML frontmatter. If the catalog has no description, the fallback description from the frontmatter is also lost.\n\nThe same file works without a BOM. `LocalSkillLoader` already supports BOM-prefixed files following #2735; this is a separate HTTP file-reading path.\n\n### Error Messages\n\nThere is no exception. With the reproduction below, the returned values are:\n\n```python\ncard.description == \"\"\ncard.markdown == \"\\ufeff---\\nname: demo\\ndescription: Frontmatter description\\n---\\n\\n# Demo\\nRun the demo.\"\n```\n\nExpected: description `\"Frontmatter description\"` and markdown `\"# Demo\\nRun the demo.\"`.\n\n### Steps to Reproduce\n\nThis uses the public hub API against a local HTTP server; no ClawHub token or external service is needed. Install AgentScope with its service extra, then run:\n\n```python\nimport asyncio\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom threading import Thread\n\nfrom agentscope.app.hub import ClawSkillHub\n\nskill_md = (\n    \"\\ufeff---\\nname: demo\\ndescription: Frontmatter description\\n\"\n    \"---\\n\\n# Demo\\nRun the demo.\"\n)\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        if self.path.startswith(\"/api/v1/skills/demo/file\"):\n            payload = skill_md.encode(\"utf-8\")\n            content_type = \"text/plain; charset=utf-8\"\n        else:\n            payload = json.dumps({\"skill\": {\"slug\": \"demo\"}}).encode()\n            content_type = \"application/json\"\n        self.send_response(200)\n        self.send_header(\"Content-Type\", content_type)\n        self.send_header(\"Content-Length\", str(len(payload)))\n        self.end_headers()\n        self.wfile.write(payload)\n\n    def log_message(self, *_):\n        pass\n\n\nasync def main():\n    with ThreadingHTTPServer((\"127.0.0.1\", 0), Handler) as server:\n        worker = Thread(target=server.serve_forever, daemon=True)\n        worker.start()\n        try:\n            url = f\"http://127.0.0.1:{server.server_port}\"\n            async with ClawSkillHub(base_url=url) as hub:\n                card = await hub.get_skill(\"user\", \"demo\")\n            print(repr(card.description))\n            print(repr(card.markdown))\n        finally:\n            server.shutdown()\n            worker.join()\n\n\nasyncio.run(main())\n```\n\n### Proposed Fix\n\nRemove one leading `U+FEFF` from the decoded file text before parsing its frontmatter. Keep BOM-less inputs, BOM characters within the body, and existing catalog-description precedence unchanged. I would like to take this fix and add regression tests for those cases.\n\n### Environment\n\n- AgentScope: `2.0.10dev`, main commit `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`\n- Python: 3.11.15\n- OS: macOS, Apple Silicon\n\n", "hints_text": "/assign\n\nIt's yours, @GoldArowana. If there is no pull request and no word from you by 2026-10-18 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-04T05:41:01Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3103, "instance_id": "agentscope-ai__agentscope-3103", "issue_numbers": ["3102"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/app/_manager/_scheduler/_scheduler_manager.py b/src/agentscope/app/_manager/_scheduler/_scheduler_manager.py\nindex 2c3f641244..c2f40f7aa2 100644\n--- a/src/agentscope/app/_manager/_scheduler/_scheduler_manager.py\n+++ b/src/agentscope/app/_manager/_scheduler/_scheduler_manager.py\n@@ -615,6 +615,7 @@ async def list_tools(\n                 scheduler=self._scheduler,\n                 storage=self._storage,\n                 message_bus=self._message_bus,\n+                scheduler_manager=self,\n             ),\n             ScheduleList(\n                 user_id=user_id,\ndiff --git a/src/agentscope/app/_manager/_scheduler/_tools/_schedule_delete.py b/src/agentscope/app/_manager/_scheduler/_tools/_schedule_delete.py\nindex aa1a8605ee..f4edfacca7 100644\n--- a/src/agentscope/app/_manager/_scheduler/_tools/_schedule_delete.py\n+++ b/src/agentscope/app/_manager/_scheduler/_tools/_schedule_delete.py\n@@ -55,6 +55,7 @@ def __init__(\n         scheduler: Any,\n         storage: StorageBase,\n         message_bus: MessageBus,\n+        scheduler_manager: Any,\n     ) -> None:\n         \"\"\"Initialize the schedule delete tool.\n \n@@ -69,11 +70,16 @@ def __init__(\n                 The message bus used to cancel in-flight chat runs for\n                 any execution session spawned by this schedule and to\n                 purge their per-session bus state.\n+            scheduler_manager (`Any`):\n+                The scheduler manager, used to tell the timer-owning node\n+                that a schedule changed. Must expose a\n+                ``notify_changed(schedule_id)`` coroutine.\n         \"\"\"\n         self._user_id = user_id\n         self._scheduler = scheduler\n         self._storage = storage\n         self._message_bus = message_bus\n+        self._scheduler_manager = scheduler_manager\n \n     async def check_permissions(\n         self,\n@@ -141,6 +147,8 @@ async def __call__(\n                 state=ToolResultState.ERROR,\n             )\n \n+        await self._scheduler_manager.notify_changed(schedule_id)\n+\n         return ToolChunk(\n             content=[\n                 TextBlock(\n", "test_patch": "diff --git a/tests/service_scheduler_test.py b/tests/service_scheduler_test.py\nindex ca90ab8cc5..f48ec407a2 100644\n--- a/tests/service_scheduler_test.py\n+++ b/tests/service_scheduler_test.py\n@@ -24,6 +24,7 @@\n from contextlib import AsyncExitStack\n from datetime import datetime\n from unittest import IsolatedAsyncioTestCase, TestCase\n+from unittest.mock import patch\n \n import fakeredis.aioredis\n from fastapi.testclient import TestClient\n@@ -42,6 +43,7 @@\n )\n from agentscope.app.workspace_manager import LocalWorkspaceManager\n from agentscope.permission import PermissionMode\n+from agentscope.message import ToolResultState\n \n \n def _make_storage(\n@@ -438,6 +440,59 @@ async def test_a_write_on_one_node_reaches_the_owner(self) -> None:\n             self.assertListEqual(self.job_ids(owner), [record.id])\n \n \n+class TestScheduleDeleteNotification(_SchedulerOwnershipTestBase):\n+    \"\"\"Agent-facing deletes notify the node that owns the timers.\"\"\"\n+\n+    async def asyncSetUp(self) -> None:\n+        \"\"\"Create a writer that does not own the timers.\"\"\"\n+        await super().asyncSetUp()\n+        self.writer = SchedulerManager(\n+            storage=self.storage,\n+            message_bus=self.bus,\n+            workspace_manager=FakeWorkspaceManager(),\n+            enabled=False,\n+        )\n+        self.delete_tool = next(\n+            tool\n+            for tool in await self.writer.list_tools(\n+                user_id=\"u\",\n+                agent_id=\"a\",\n+                chat_model_config=_make_record().data.chat_model_config,\n+            )\n+            if tool.name == \"ScheduleDelete\"\n+        )\n+\n+    async def test_non_owner_delete_removes_owner_job(self) -> None:\n+        \"\"\"Subscription removes the owner's job before the periodic pass.\"\"\"\n+        record = _make_record()\n+        await self.storage.upsert_schedule(\"u\", record)\n+        async with self.writer, self.manager:\n+            self.assertListEqual(self.job_ids(self.writer), [])\n+            self.assertListEqual(self.job_ids(), [record.id])\n+\n+            result = await self.delete_tool(schedule_id=record.id)\n+\n+            self.assertEqual(result.state, ToolResultState.SUCCESS)\n+            self.assertIsNone(await self.storage.get_schedule(\"u\", record.id))\n+            for _ in range(50):\n+                if not self.job_ids():\n+                    break\n+                await asyncio.sleep(0.02)\n+            self.assertListEqual(self.job_ids(), [])\n+\n+    async def test_missing_delete_does_not_notify(self) -> None:\n+        \"\"\"A missing record returns an error without a lifecycle event.\"\"\"\n+        with patch.object(\n+            self.bus,\n+            \"publish\",\n+            wraps=self.bus.publish,\n+        ) as publish:\n+            result = await self.delete_tool(schedule_id=\"missing\")\n+\n+        self.assertEqual(result.state, ToolResultState.ERROR)\n+        publish.assert_not_awaited()\n+\n+\n class TestSchedulerFlag(TestCase):\n     \"\"\"``enable_scheduler`` decides whether a process owns the timers.\"\"\"\n \n", "problem_statement": "[Bug]: ScheduleDelete does not notify the timer owner\n### Prerequisites\n\n- [x] I have searched the existing issues and discussions and have not found a report of this missing deletion notification.\n- [x] This is a bug, not a usage question.\n\n### Background / Description\n\n`SchedulerManager` holds timers on one enabled node. Other nodes persist schedule changes and call `notify_changed()` so that the timer owner reconciles its jobs against storage. This writer notification contract was introduced in [PR #2477](https://github.com/agentscope-ai/agentscope/pull/2477).\n\nThe HTTP deletion route sends the notification. The agent-facing `ScheduleDelete` tool only removes its local job and deletes the storage record through `SessionService`. On a node with scheduling disabled, the tool reports success but leaves the timer owner's job registered until periodic reconciliation. The interval is 60 seconds, and an old job can still fire within that window.\n\nExpected: notify the timer owner after a successful deletion, using the existing lifecycle mechanism. A notification is best-effort; it does not provide an atomic stop guarantee for an already running callback.\n\n### Error Messages\n\nNo exception is raised. The controlled reproduction reports:\n\n```json\n{\"delete_succeeded\": true, \"record_deleted\": true, \"owner_job_registered\": true, \"lifecycle_notifications\": 0}\n```\n\n### Steps to Reproduce\n\nFrom an AgentScope checkout with development/test dependencies installed, save the following as `schedule_delete_repro.py`. It reuses the fixture helpers already in `tests/service_scheduler_test.py`, with fakeredis-backed storage and a message bus:\n\n```python\nimport asyncio\nimport json\nfrom datetime import datetime, timedelta\nfrom unittest.mock import patch\n\nimport fakeredis.aioredis\nfrom service_scheduler_test import _make_bus, _make_record, _make_storage\nfrom utils import FakeWorkspaceManager\n\nfrom agentscope.app._manager import SchedulerManager\nfrom agentscope.message import ToolResultState\n\n\nasync def main():\n    fr = fakeredis.aioredis.FakeRedis(decode_responses=True)\n    try:\n        async with _make_storage(fr) as storage, _make_bus(fr) as bus:\n            owner = SchedulerManager(storage, bus, FakeWorkspaceManager())\n            writer = SchedulerManager(\n                storage, bus, FakeWorkspaceManager(), enabled=False,\n            )\n            record = _make_record()\n            record.data.started_at = datetime.now() + timedelta(days=1)\n            await storage.upsert_schedule(\"u\", record)\n            async with owner, writer:\n                delete = next(\n                    tool for tool in await writer.list_tools(\n                        user_id=\"u\", agent_id=\"a\",\n                        chat_model_config=record.data.chat_model_config,\n                    ) if tool.name == \"ScheduleDelete\"\n                )\n                with patch.object(bus, \"publish\", wraps=bus.publish) as publish:\n                    result = await delete(schedule_id=record.id)\n                    for _ in range(50):\n                        if owner._scheduler.get_job(record.id) is None:\n                            break\n                        await asyncio.sleep(0.02)\n                    print(json.dumps({\n                        \"delete_succeeded\": result.state == ToolResultState.SUCCESS,\n                        \"record_deleted\": await storage.get_schedule(\"u\", record.id) is None,\n                        \"owner_job_registered\": owner._scheduler.get_job(record.id) is not None,\n                        \"lifecycle_notifications\": publish.await_count,\n                    }))\n    finally:\n        await fr.aclose()\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n```\n\nRun from the repository root:\n\n```bash\nPYTHONPATH=src:tests python schedule_delete_repro.py\n```\n\nOn the unfixed source, deletion succeeds but the owner's job remains and no notification is published. With the proposed fix, `owner_job_registered` becomes `false` and `lifecycle_notifications` becomes `1`.\n\n### Environment\n\n- AgentScope: `2.0.10dev`, unfixed `main` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`.\n- Python: `3.11.14`.\n- Verification scope: two manager instances in one process using fakeredis. Live Redis and deployment across separate processes have not been tested.\n\n", "hints_text": "", "created_at": "2026-10-03T06:22:50Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3098, "instance_id": "agentscope-ai__agentscope-3098", "issue_numbers": ["3099"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/app/workspace_manager/_docker_workspace_manager.py b/src/agentscope/app/workspace_manager/_docker_workspace_manager.py\nindex c0f9af04eb..e2153cdaf4 100644\n--- a/src/agentscope/app/workspace_manager/_docker_workspace_manager.py\n+++ b/src/agentscope/app/workspace_manager/_docker_workspace_manager.py\n@@ -231,7 +231,12 @@ async def _build_and_start(\n             default_mcps=self._default_mcps,\n             skill_paths=self._skill_paths,\n         )\n-        await ws.initialize()\n+        try:\n+            await ws.initialize()\n+        except BaseException:\n+            # The container may already be running and nothing holds it.\n+            await self._dispose_prewarmed(ws)\n+            raise\n         return ws\n \n     # \u2500\u2500 public API \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n", "test_patch": "diff --git a/tests/workspace_manager_docker_test.py b/tests/workspace_manager_docker_test.py\nindex 9cd8cf6dfa..3a476f79fc 100644\n--- a/tests/workspace_manager_docker_test.py\n+++ b/tests/workspace_manager_docker_test.py\n@@ -6,7 +6,7 @@\n import os\n import tempfile\n from unittest.async_case import IsolatedAsyncioTestCase\n-from unittest.mock import patch\n+from unittest.mock import AsyncMock, patch\n \n from agentscope.app.workspace_manager import (\n     PrewarmConfig,\n@@ -169,6 +169,22 @@ async def test_prewarmed_container_is_handed_over_without_rebuild(\n         await asyncio.sleep(0.05)\n         self.assertEqual(len(_FakeWorkspace.created), 2)\n \n+    async def test_failed_initialize_closes_the_workspace(self) -> None:\n+        \"\"\"A workspace whose ``initialize`` fails is closed, not leaked.\"\"\"\n+        manager = DockerWorkspaceManager(self.basedir)\n+        with patch.object(\n+            _FakeWorkspace,\n+            \"initialize\",\n+            AsyncMock(side_effect=RuntimeError(\"gateway failed\")),\n+        ):\n+            with self.assertRaisesRegex(RuntimeError, \"gateway failed\"):\n+                await manager.get_workspace(\"u1\", \"a1\", \"s1\", \"ws-id\")\n+\n+        self.assertListEqual(\n+            [ws.closed for ws in _FakeWorkspace.created],\n+            [True],\n+        )\n+\n     async def test_aexit_closes_buffered_and_cached_workspaces(self) -> None:\n         \"\"\"Neither the buffer nor the cache survives shutdown.\"\"\"\n         manager = DockerWorkspaceManager(\n", "problem_statement": "[Bug]: DockerWorkspaceManager does not clean up failed initialization\n### Prerequisites\n\n- [x] I have searched the existing issues and discussions and have not found a report of this initialization cleanup failure.\n- [x] This is a bug, not a usage question.\n\n### Background / Description\n\n`DockerWorkspaceManager._build_and_start()` constructs a `DockerWorkspace` and awaits `initialize()` before the workspace is added to the manager cache. If initialization fails or is cancelled after backend provisioning, the exception leaves the manager without closing the unreturned workspace.\n\nFor example, gateway initialization can fail after a container has been created and started. A subsequent `close_all()` only visits cached workspaces, so it cannot clean up this failed initialization.\n\nExpected behavior: attempt to close the workspace when initialization fails or is cancelled, while preserving the original initialization error or cancellation if cleanup also fails. Successful initialization, retry, and cache reuse should retain their existing behavior.\n\n### Error Messages\n\nThe controlled regression injects `RuntimeError(\"gateway initialization failed\")` after the Docker SDK double has created and started a container. The exception is propagated, but the unfixed version records these lifecycle counts:\n\n```json\n{\n  \"created\": 1,\n  \"started\": 1,\n  \"killed\": 0,\n  \"deleted\": 0,\n  \"client_closed\": 0,\n  \"error_preserved\": true\n}\n```\n\nThis is a cleanup omission; there is no additional error message reporting the unclosed workspace.\n\n### Steps to Reproduce\n\nUse the [regression tests from PR #3098](https://github.com/agentscope-ai/agentscope/blob/50f1bc65ab82c88540d83caf42fb8f0e5cb5d240/tests/workspace_manager_docker_init_test.py) with the unfixed product code. From an AgentScope checkout with its test dependencies installed:\n\n```bash\ngit fetch https://github.com/agentscope-ai/agentscope.git pull/3098/head\ngit worktree add --detach ../docker-init-repro 72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6\ngit show FETCH_HEAD:tests/workspace_manager_docker_init_test.py > ../docker-init-repro/tests/workspace_manager_docker_init_test.py\ncd ../docker-init-repro\nPYTHONPATH=src pytest tests/workspace_manager_docker_init_test.py -q\n```\n\nThe three regressions fail on the unfixed baseline. They cover ordinary initialization failure, actual task cancellation, and preservation of the initialization error when cleanup also fails. The tests use a Docker SDK double and do not require a running Docker daemon.\n\nWith the proposed fix, the failed workspace is closed before the original error is propagated. The related initialization, manager, and prewarm tests pass: 20 passed.\n\n### Environment\n\n- AgentScope: `2.0.10dev`, unfixed `main` at `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`.\n- Python: `3.11.14`.\n- Verification scope: mocked Docker SDK lifecycle tests; live Docker integration has not been run.\n\nRelated pull request: #3098.\n\n", "hints_text": "", "created_at": "2026-10-03T01:54:27Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3090, "instance_id": "agentscope-ai__agentscope-3090", "issue_numbers": ["3089"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/tool/_utils.py b/src/agentscope/tool/_utils.py\nindex bb364c0315..672700d88c 100644\n--- a/src/agentscope/tool/_utils.py\n+++ b/src/agentscope/tool/_utils.py\n@@ -111,8 +111,8 @@ def _extract_input_schema(\n     # Create a dynamic model with the function signature\n     fields = {}\n     for name, param in inspect.signature(tool_func).parameters.items():\n-        # Skip the `self` and `cls` parameters\n-        if name in [\"self\", \"cls\"]:\n+        # Skip `self`, `cls` and the toolkit-injected `_agent_state`\n+        if name in [\"self\", \"cls\", \"_agent_state\"]:\n             continue\n \n         annotation = type_hints.get(name, param.annotation)\n", "test_patch": "diff --git a/tests/toolkit_test.py b/tests/toolkit_test.py\nindex bb9d6acc22..5a3a6d584a 100644\n--- a/tests/toolkit_test.py\n+++ b/tests/toolkit_test.py\n@@ -1136,6 +1136,65 @@ async def stream_status() -> AsyncGenerator[Any, None]:\n             f\"started{expected_dict_text}\",\n         )\n \n+    async def test_state_injected_function(self) -> None:\n+        \"\"\"Infer business parameters and inject state at invocation.\"\"\"\n+\n+        def echo(value: str, _agent_state: AgentState) -> str:\n+            \"\"\"Return a value with the current session.\n+\n+            Args:\n+                value: The value to return.\n+                _agent_state: The agent state injected by the toolkit.\n+            \"\"\"\n+            return f\"{value}:{_agent_state.session_id}\"\n+\n+        tool = FunctionTool(echo, is_state_injected=True)\n+        self.assertDictEqual(\n+            tool.input_schema,\n+            {\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"value\": {\n+                        \"type\": \"string\",\n+                        \"description\": \"The value to return.\",\n+                    },\n+                },\n+                \"required\": [\"value\"],\n+            },\n+        )\n+\n+        state = AgentState(session_id=\"test-session\")\n+        toolkit = Toolkit(tools=[tool])\n+        response = None\n+        async for result in toolkit.call_tool(\n+            ToolCallBlock(\n+                id=\"test_state_injection\",\n+                name=\"echo\",\n+                input=json.dumps({\"value\": \"hello\"}),\n+            ),\n+            state,\n+        ):\n+            if isinstance(result, ToolResponse):\n+                response = result\n+\n+        self.assertDictEqual(\n+            response.model_dump(),\n+            {\n+                \"content\": [\n+                    {\n+                        \"type\": \"text\",\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                        \"id\": AnyString(),\n+                        \"text\": \"hello:test-session\",\n+                    },\n+                ],\n+                \"state\": \"success\",\n+                \"metadata\": {},\n+                \"id\": \"test_state_injection\",\n+            },\n+        )\n+\n     async def test_custom_input_schema(self) -> None:\n         \"\"\"Test overriding the auto-extracted schema with a custom one.\"\"\"\n \n", "problem_statement": "[Bug]: FunctionTool cannot infer schemas for state-injected functions\n### Prerequisites\n\n- [x] I searched existing issues, pull requests, and discussions for this symptom and root cause.\n- [x] This is a reproducible bug rather than a usage question.\n\n### Background / Description\n\n`FunctionTool` supports both automatic schema inference and `is_state_injected=True`. A function using the documented `_agent_state` parameter cannot combine these features: construction fails before the tool can be registered or invoked.\n\nThe injected parameter should be omitted from the inferred model-facing input schema. Ordinary business parameters should remain unchanged, and `Toolkit` should still supply the current `AgentState` at invocation. Providing an explicit business-only `input_schema` works as a workaround.\n\n### Error Messages\n\n```text\nNameError: Fields must not use names with leading underscores; e.g., use 'agent_state' instead of '_agent_state'.\n```\n\n### Steps to Reproduce\n\n```python\nfrom agentscope.state import AgentState\nfrom agentscope.tool import FunctionTool\n\n\ndef echo(value: str, _agent_state: AgentState) -> str:\n    return value\n\n\nFunctionTool(echo, is_state_injected=True)\n```\n\nRun the example against current `main`. `_extract_input_schema` treats `_agent_state` as a normal Pydantic field, which raises the error above.\n\n### Environment\n\n- AgentScope: `2.0.10dev`, commit `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`\n- Python: `3.11.14`\n- Pydantic: `2.13.5`\n- OS: Linux\n\nI can submit a focused fix with regression coverage for inferred schemas and runtime state injection.\n\n", "hints_text": "", "created_at": "2026-10-02T12:40:11Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3086, "instance_id": "agentscope-ai__agentscope-3086", "issue_numbers": ["3081"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/model/_openai_response/_model.py b/src/agentscope/model/_openai_response/_model.py\nindex 1e80595293..e283e5ba2a 100644\n--- a/src/agentscope/model/_openai_response/_model.py\n+++ b/src/agentscope/model/_openai_response/_model.py\n@@ -4,6 +4,7 @@\n from datetime import datetime\n from typing import Literal, Any, AsyncGenerator, List, TYPE_CHECKING, Type\n \n+import openai\n from pydantic import BaseModel, Field\n \n from ..._utils._common import _generate_id\n@@ -153,8 +154,6 @@ def __init__(\n         self.formatter = formatter or OpenAIResponseFormatter()\n         self.client_kwargs = client_kwargs or {}\n \n-        import openai\n-\n         self.client: openai.AsyncClient = openai.AsyncClient(\n             api_key=self.credential.api_key.get_secret_value(),\n             organization=self.credential.organization,\n@@ -164,8 +163,6 @@ def __init__(\n \n     @classmethod\n     def _get_retryable_exceptions(cls) -> tuple[Type[Exception], ...]:\n-        import openai\n-\n         return (\n             openai.APIConnectionError,\n             openai.APITimeoutError,\n@@ -177,8 +174,6 @@ def _get_retryable_exceptions(cls) -> tuple[Type[Exception], ...]:\n     def _get_structured_output_fallback_exceptions(\n         cls,\n     ) -> tuple[Type[Exception], ...]:\n-        import openai\n-\n         return (openai.BadRequestError,)\n \n     async def _call_api(\n@@ -296,6 +291,19 @@ async def _parse_stream_response(\n         async with response as stream:\n             async for event in stream:\n                 event_type = event.type\n+                # The SDK doesn't raise on these events, so surface them here\n+                if event_type in (\"response.failed\", \"error\"):\n+                    error = (\n+                        event.response.error\n+                        if event_type == \"response.failed\"\n+                        else event\n+                    )\n+                    raise openai.APIError(\n+                        message=error.message if error else \"Response failed\",\n+                        request=stream.response.request,\n+                        body=error.model_dump() if error else None,\n+                    )\n+\n                 delta_res = ChatResponse(\n                     content=[],\n                     is_last=False,\n", "test_patch": "diff --git a/tests/model_openai_response_test.py b/tests/model_openai_response_test.py\nindex fb36adedd0..a1a79226cc 100644\n--- a/tests/model_openai_response_test.py\n+++ b/tests/model_openai_response_test.py\n@@ -10,6 +10,7 @@\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock\n \n+from openai import APIError\n from pydantic import BaseModel\n \n from utils import AnyString\n@@ -143,6 +144,7 @@ def __init__(self, events: list) -> None:\n         self._events = events\n         self._index = 0\n         self.exited = False\n+        self.response = MagicMock()\n \n     async def __aenter__(self) -> \"_MockAsyncEventStream\":\n         return self\n@@ -526,6 +528,39 @@ def setUp(self) -> None:\n         self.mock_client = MagicMock()\n         self.model.client = self.mock_client\n \n+    async def test_stream_errors_propagate(self) -> None:\n+        \"\"\"Failed stream events raise APIError instead of a partial reply.\"\"\"\n+        body = {\"code\": \"server_error\", \"message\": \"Generation failed.\"}\n+        error = _make_event(\"error\", message=\"Generation failed.\")\n+        error.model_dump.return_value = body\n+        for failure in (\n+            error,\n+            _make_event(\"response.failed\", response=MagicMock(error=error)),\n+        ):\n+            with self.subTest(event_type=failure.type):\n+                self.mock_client.responses.create = AsyncMock(\n+                    return_value=_MockAsyncEventStream(\n+                        [\n+                            _make_event(\n+                                \"response.output_text.delta\",\n+                                delta=\"Partial\",\n+                            ),\n+                            failure,\n+                        ],\n+                    ),\n+                )\n+                gen = await self.model([])\n+                await anext(gen)\n+                with self.assertRaises(APIError) as ctx:\n+                    await anext(gen)\n+                self.assertDictEqual(\n+                    {\n+                        \"message\": ctx.exception.message,\n+                        \"body\": ctx.exception.body,\n+                    },\n+                    {\"message\": \"Generation failed.\", \"body\": body},\n+                )\n+\n     async def test_stream_text(self) -> None:\n         \"\"\"Stream text yields deltas then final with full content.\"\"\"\n         completed_resp = MagicMock()\n", "problem_statement": "[Bug]: OpenAIResponseModel turns a failed stream into a completed reply\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nWhen a Responses API stream fails partway through, the agent keeps the cut-off text as a finished answer.\n\nThe server reports the failure inside the stream, with a `response.failed` or `error` event. The openai SDK passes both on. It only raises when a payload has a top-level error key. `OpenAIResponseModel` handles five event types and skips the rest, in [`_model.py:305-346`](https://github.com/agentscope-ai/agentscope/blob/72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6/src/agentscope/model/_openai_response/_model.py#L305-L346). So the loop ends normally, and the reply is built as completed.\n\nThe partial text becomes the agent's answer and is saved in the context. Nothing raises, so the user sees no error. Streaming is on by default for this model, so this is the normal path.\n\nExpected: the stream raises the server's error, the way the SDK does for other errors in a stream.\n\n### Error Messages\n\n```shell\nresponse.failed: the reply finished as completed\n  answer: 'The refund policy allows returns within'\n  saved in the context: 'The refund policy allows returns within'\nerror: the reply finished as completed\n  answer: 'The refund policy allows returns within'\n  saved in the context: 'The refund policy allows returns within'\n```\n\n### Steps to Reproduce\n\n```python\nimport asyncio\nimport json\nimport httpx\n\nfrom agentscope.agent import Agent\nfrom agentscope.credential import OpenAICredential\nfrom agentscope.message import UserMsg\nfrom agentscope.model import OpenAIResponseModel\n\nRESPONSE = {\n    \"id\": \"resp_1\",\n    \"object\": \"response\",\n    \"created_at\": 1,\n    \"model\": \"o4-mini\",\n    \"status\": \"in_progress\",\n    \"output\": [],\n    \"parallel_tool_calls\": True,\n    \"tool_choice\": \"auto\",\n    \"tools\": [],\n}\nTEXT = {\n    \"type\": \"response.output_text.delta\",\n    \"item_id\": \"msg_1\",\n    \"output_index\": 0,\n    \"content_index\": 0,\n    \"logprobs\": [],\n    \"delta\": \"The refund policy allows returns within\",\n}\nERROR = {\"code\": \"server_error\", \"message\": \"The server had an error.\"}\nFAILED = {\n    \"type\": \"response.failed\",\n    \"response\": {**RESPONSE, \"status\": \"failed\", \"error\": ERROR},\n}\nERROR_EVENT = {\"type\": \"error\", **ERROR, \"param\": None}\n\ndef server(last_event: dict) -> httpx.AsyncClient:\n    events = [{\"type\": \"response.created\", \"response\": RESPONSE}, TEXT, last_event]\n    body = \"\".join(\n        f\"event: {e['type']}\\ndata: {json.dumps({**e, 'sequence_number': i})}\\n\\n\"\n        for i, e in enumerate(events)\n    )\n\n    def handler(request: httpx.Request) -> httpx.Response:\n        headers = {\"content-type\": \"text/event-stream\"}\n        return httpx.Response(200, content=body, headers=headers)\n\n    return httpx.AsyncClient(transport=httpx.MockTransport(handler))\n\n\nasync def main() -> None:\n    for last_event in (FAILED, ERROR_EVENT):\n        model = OpenAIResponseModel(\n            credential=OpenAICredential(api_key=\"none\"),\n            model=\"o4-mini\",\n            client_kwargs={\"http_client\": server(last_event)},\n        )\n        agent = Agent(name=\"Friday\", system_prompt=\"You are helpful.\", model=model)\n        name = last_event[\"type\"]\n        try:\n            reply = await agent.reply(UserMsg(\"user\", \"What is the refund policy?\"))\n        except Exception as e:\n            print(f\"{name}: the reply raised {type(e).__name__}: {e}\")\n            continue\n        saved = agent.state.context[-1].get_text_content()\n        print(f\"{name}: the reply finished as {reply.finished_reason.value}\")\n        print(f\"  answer: {reply.get_text_content()!r}\")\n        print(f\"  saved in the context: {saved!r}\")\n\n\nasyncio.run(main())\n```\n\nRun on main at `72f3f6fa`. No API key, because a mock transport serves the stream to the real openai client. It prints the lines under Error Messages.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at 72f3f6fa), and 2.0.9 has the same code\n- Python Version: 3.12.3 with openai 3.19.2, and 3.11.15 with openai 3.21.0 behaves the same\n- OS: Linux (aarch64)\n", "hints_text": "/assign\nI'd like to take this on. I reproduced both failure cases locally.\nMy plan is to handle response.failed and error in OpenAIResponseModel by raising openai.APIError, with regression tests to verify that failed streams don't return a completed reply or save partial output to the context. The fix should stay within the Responses adapter and its tests.\nIt's yours, @Tsubaki-01. If there is no pull request and no word from you by 2026-10-15 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-10-01T15:09:49Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3079, "instance_id": "agentscope-ai__agentscope-3079", "issue_numbers": ["3077"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/model/_gemini/_model.py b/src/agentscope/model/_gemini/_model.py\nindex c07902f03a..9c41b76ce2 100644\n--- a/src/agentscope/model/_gemini/_model.py\n+++ b/src/agentscope/model/_gemini/_model.py\n@@ -526,7 +526,8 @@ def _extract_usage(\n                     usage_metadata,\n                     \"cached_content_token_count\",\n                     0,\n-                ),\n+                )\n+                or 0,\n             )\n         return None\n \n", "test_patch": "diff --git a/tests/model_gemini_test.py b/tests/model_gemini_test.py\nindex 5a419b632b..df5fde2f47 100644\n--- a/tests/model_gemini_test.py\n+++ b/tests/model_gemini_test.py\n@@ -15,6 +15,7 @@\n from utils import AnyString\n \n from agentscope.message import TextBlock, ToolCallBlock, ThinkingBlock\n+from agentscope.message._base import Usage\n from agentscope.model import GeminiChatModel\n from agentscope.model._gemini._model import _sanitize_schema_for_gemini\n from agentscope._utils._common import _flatten_json_schema\n@@ -254,6 +255,49 @@ async def test_thinking_response(self) -> None:\n             ),\n         )\n \n+    async def test_usage_normalizes_optional_cache_count(self) -> None:\n+        \"\"\"SDK cache counts remain integer-valued in raw model usage.\"\"\"\n+        from google.genai.types import GenerateContentResponseUsageMetadata\n+\n+        for cache_count, expected in [(None, 0), (0, 0), (5, 5)]:\n+            with self.subTest(cache_count=cache_count):\n+                resp = _mock_completion([_make_part(text=\"hello\")])\n+                resp.usage_metadata = GenerateContentResponseUsageMetadata(\n+                    prompt_token_count=10,\n+                    candidates_token_count=5,\n+                    total_token_count=15,\n+                    cached_content_token_count=cache_count,\n+                )\n+                self.mock_client.aio.models.generate_content = AsyncMock(\n+                    return_value=resp,\n+                )\n+\n+                result = await self.model([])\n+\n+                self.assertEqual(\n+                    dict(result.usage),\n+                    {\n+                        \"input_tokens\": 10,\n+                        \"output_tokens\": 5,\n+                        \"time\": result.usage.time,\n+                        \"cache_creation_input_tokens\": 0,\n+                        \"cache_input_tokens\": expected,\n+                        \"type\": \"chat\",\n+                        \"metadata\": None,\n+                    },\n+                )\n+                self.assertIs(type(result.usage.cache_input_tokens), int)\n+                usage = Usage(**dict(result.usage))\n+                self.assertEqual(\n+                    usage.model_dump(),\n+                    {\n+                        \"input_tokens\": 10,\n+                        \"output_tokens\": 5,\n+                        \"cache_input_tokens\": expected,\n+                        \"cache_creation_input_tokens\": 0,\n+                    },\n+                )\n+\n     async def test_usage_classifies_tool_use_tokens_as_input(self) -> None:\n         \"\"\"Usage classifies tool-use tokens as input, not output.\"\"\"\n         parts = [_make_part(text=\"hello\")]\n@@ -382,6 +426,54 @@ async def test_stream_text(self) -> None:\n             ],\n         )\n \n+    async def test_stream_usage_normalizes_optional_cache_count(self) -> None:\n+        \"\"\"Delta and final usage normalize optional SDK cache counts.\"\"\"\n+        from google.genai.types import GenerateContentResponseUsageMetadata\n+\n+        for cache_count, expected in [(None, 0), (0, 0), (5, 5)]:\n+            with self.subTest(cache_count=cache_count):\n+                chunk = _make_stream_chunk([_make_part(text=\"hello\")])\n+                chunk.usage_metadata = GenerateContentResponseUsageMetadata(\n+                    prompt_token_count=10,\n+                    candidates_token_count=5,\n+                    total_token_count=15,\n+                    cached_content_token_count=cache_count,\n+                )\n+                self.mock_client.aio.models.generate_content_stream = (\n+                    AsyncMock(\n+                        return_value=_MockAsyncStream([chunk]),\n+                    )\n+                )\n+\n+                gen = await self.model([])\n+                responses = [r async for r in gen]\n+\n+                self.assertEqual(len(responses), 2)\n+                for response in responses:\n+                    self.assertEqual(\n+                        dict(response.usage),\n+                        {\n+                            \"input_tokens\": 10,\n+                            \"output_tokens\": 5,\n+                            \"time\": response.usage.time,\n+                            \"cache_creation_input_tokens\": 0,\n+                            \"cache_input_tokens\": expected,\n+                            \"type\": \"chat\",\n+                            \"metadata\": None,\n+                        },\n+                    )\n+                    self.assertIs(type(response.usage.cache_input_tokens), int)\n+                    usage = Usage(**dict(response.usage))\n+                    self.assertEqual(\n+                        usage.model_dump(),\n+                        {\n+                            \"input_tokens\": 10,\n+                            \"output_tokens\": 5,\n+                            \"cache_input_tokens\": expected,\n+                            \"cache_creation_input_tokens\": 0,\n+                        },\n+                    )\n+\n     async def test_stream_usage_classifies_tool_use_tokens(self) -> None:\n         \"\"\"Streaming usage classifies tool-use tokens as input.\"\"\"\n         chunk = _make_stream_chunk([_make_part(text=\"hello\")])\n", "problem_statement": "[Bug]: Gemini usage exposes None for absent cached token count\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nGeminiChatModel returns ChatUsage(cache_input_tokens=None) when usage_metadata.cached_content_token_count is None. ChatUsage declares an int defaulting to 0; converting this raw model usage to agentscope.message.Usage fails validation. Ordinary Agent calls currently normalize the field themselves, so this report does not claim those calls crash. Expected: None/absent cache count becomes integer 0; explicit positive counts remain unchanged in stream and non-stream modes. The SDK defines this field as optional (https://googleapis.github.io/python-genai/genai.html). A minimal normalization with `or 0` would match other optional token fields; dropping all usage would discard valid input/output counts. Targeted issues, PR and discussion searches found no matching cache-count fix. #1243 concerns missing prompt/total counts and its original failure is already fixed. Investigated with Codex assistance; I can prepare a focused regression and fix.\n\n### Error Messages\n\n```shell\ncache_input_tokens: None\ncache_input_tokens_type: NoneType\nValidationError: cache_input_tokens Input should be a valid integer [type=int_type, input_value=None, input_type=NoneType]\n```\n\n### Steps to Reproduce\n\nRun the following without an API key or network request:\n```python\nfrom datetime import datetime\nfrom types import SimpleNamespace\nfrom agentscope.model import GeminiChatModel\nfrom agentscope.message._base import Usage\n\nmodel = object.__new__(GeminiChatModel)\nmetadata = SimpleNamespace(\n    prompt_token_count=10, total_token_count=15,\n    candidates_token_count=5, cached_content_token_count=None,\n)\nusage = model._extract_usage(metadata, datetime.now())\nprint(usage.cache_input_tokens)  # None; expected integer 0\nUsage(**dict(usage))  # ValidationError\n```\n\n### Environment\n\n- AgentScope Version: 2.0.10dev, main at 72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6\n- Python Version: 3.13.11\n- OS: Windows\n", "hints_text": "", "created_at": "2026-10-01T12:43:32Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3075, "instance_id": "agentscope-ai__agentscope-3075", "issue_numbers": ["3074"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/workspace/_local_workspace.py b/src/agentscope/workspace/_local_workspace.py\nindex 5aa8c4716a..b51bf34cad 100644\n--- a/src/agentscope/workspace/_local_workspace.py\n+++ b/src/agentscope/workspace/_local_workspace.py\n@@ -223,7 +223,9 @@ async def initialize(self) -> None:\n             base_dir = _sanitize_dir_name(raw_name)\n             dir_name = base_dir\n             counter = 1\n-            while dir_name in existing_dir_names:\n+            while dir_name in existing_dir_names or os.path.exists(\n+                os.path.join(skills_dir, dir_name),\n+            ):\n                 dir_name = f\"{base_dir}_{counter}\"\n                 counter += 1\n \n@@ -834,7 +836,9 @@ async def add_skill(\n             base_dir = _sanitize_dir_name(raw_name)\n             dir_name = base_dir\n             counter = 1\n-            while dir_name in existing_dir_names:\n+            while dir_name in existing_dir_names or os.path.exists(\n+                os.path.join(skills_dir, dir_name),\n+            ):\n                 dir_name = f\"{base_dir}_{counter}\"\n                 counter += 1\n \n", "test_patch": "diff --git a/tests/workspace_local_test.py b/tests/workspace_local_test.py\nindex 9f5ee154c7..725918a910 100644\n--- a/tests/workspace_local_test.py\n+++ b/tests/workspace_local_test.py\n@@ -8,6 +8,7 @@\n import tempfile\n from types import SimpleNamespace\n from typing import Any\n+from unittest import skipUnless\n from unittest.async_case import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, patch\n from dataclasses import asdict\n@@ -47,6 +48,9 @@\n     ToolCallBlock,\n )\n \n+# Probe the temp filesystem rather than assuming case rules from the OS.\n+_CASE_INSENSITIVE_FS = os.path.exists(tempfile.gettempdir().swapcase())\n+\n \n class _LongResultTool(ToolBase):\n     \"\"\"A mock tool that returns a long string result for offload testing.\"\"\"\n@@ -1902,6 +1906,43 @@ async def test_agent_installs_are_isolated(self) -> None:\n             os.path.isdir(os.path.join(self.skills_dir, \"A\", \"a-skill\")),\n         )\n \n+    @skipUnless(_CASE_INSENSITIVE_FS, \"requires case-insensitive FS\")\n+    async def test_add_skill_case_only_directory_collision(self) -> None:\n+        \"\"\"Case-only names get distinct paths without renaming the skills.\"\"\"\n+        ws = await self._workspace()\n+        await ws.add_skill(self._make_skill(\"source-a\", \"Example\"))\n+        await ws.add_skill(self._make_skill(\"source-b\", \"example\"))\n+\n+        self.assertDictEqual(\n+            {\n+                s.name: (os.path.basename(s.dir), s.markdown)\n+                for s in await ws.list_skills()\n+            },\n+            {\"Example\": (\"Example\", \"body\"), \"example\": (\"example_1\", \"body\")},\n+        )\n+\n+    @skipUnless(_CASE_INSENSITIVE_FS, \"requires case-insensitive FS\")\n+    async def test_seed_skill_case_only_directory_collision(self) -> None:\n+        \"\"\"Seed population keeps both skills on insensitive filesystems.\"\"\"\n+        ws = await self._workspace(\n+            skill_paths=[\n+                self._make_skill(\"source-a\", \"Example\"),\n+                self._make_skill(\"source-b\", \"example\"),\n+            ],\n+        )\n+\n+        for agent_id in (\"A\", \"B\"):\n+            self.assertDictEqual(\n+                {\n+                    s.name: (os.path.basename(s.dir), s.markdown)\n+                    for s in await ws.list_skills(agent_id=agent_id)\n+                },\n+                {\n+                    \"Example\": (\"Example\", \"body\"),\n+                    \"example\": (\"example_1\", \"body\"),\n+                },\n+            )\n+\n     async def test_seeds_equip_each_agent_with_its_own_copy(self) -> None:\n         \"\"\"``skill_paths`` reach every agent, but as separate copies.\"\"\"\n         ws = await self._workspace(\n", "problem_statement": "[Bug]: LocalWorkspace.add_skill fails on case-only directory-name collisions on Windows\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nLocalWorkspace documents resolving skill directory-name conflicts by adding a numeric suffix. On Windows, installing two valid skills named Example and example raises FileExistsError on the second install instead. The index stores case-sensitive strings, while the filesystem treats the paths as the same directory. Both _populate_skills and add_skill choose destinations using exact string membership.\n\nExpected: both skills install into distinct directories, with a numeric suffix on the second path. Proposed repair: check actual destination filesystem existence alongside the index, keeping agent-facing names unchanged. No repair code has been written before this issue.\n\nCodex assisted with reproduction and preparing this report.\n\n### Error Messages\n\n```shell\nFileExistsError: [WinError 183] Cannot create a file when that file already exists: '<temporary workspace>\\skills\\default\\example'\n\nThe first add_skill succeeds; the second fails in shutil.copytree while creating its destination.\n```\n\n### Steps to Reproduce\n\nSave the following as reproduce.py and run `python reproduce.py` on Windows. It requires no model API or sandbox service.\n\n```python\nimport asyncio\nimport tempfile\nfrom pathlib import Path\nfrom agentscope.workspace import LocalWorkspace\n\nasync def main():\n    with tempfile.TemporaryDirectory() as root:\n        root = Path(root)\n        workspace = LocalWorkspace(workdir=str(root / \"workspace\"))\n        await workspace.initialize()\n        try:\n            for index, name in enumerate([\"Example\", \"example\"]):\n                source = root / f\"source-{index}\"\n                source.mkdir()\n                (source / \"SKILL.md\").write_text(\n                    f\"---\\nname: {name}\\ndescription: Fixture {index}\\n---\\nBody\\n\",\n                    encoding=\"utf-8\",\n                )\n                await workspace.add_skill(str(source))\n        finally:\n            await workspace.close()\n\nasyncio.run(main())\n```\n\n### Environment\n\n- AgentScope Version: 2.0.10dev, main commit 72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6\n- Python Version: 3.13.11\n- OS: Windows\n- Filesystem: case-insensitive local filesystem\n", "hints_text": "", "created_at": "2026-10-01T11:02:42Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3069, "instance_id": "agentscope-ai__agentscope-3069", "issue_numbers": ["2914"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/model/_deepseek/_model.py b/src/agentscope/model/_deepseek/_model.py\nindex ff6c5f41f4..880c37294b 100644\n--- a/src/agentscope/model/_deepseek/_model.py\n+++ b/src/agentscope/model/_deepseek/_model.py\n@@ -207,9 +207,15 @@ async def _call_api(\n         thinking_type = (\n             \"enabled\" if self.parameters.thinking_enable else \"disabled\"\n         )\n-        kwargs.setdefault(\"extra_body\", {})\n-        kwargs[\"extra_body\"].setdefault(\"thinking\", {})\n-        kwargs[\"extra_body\"][\"thinking\"].setdefault(\"type\", thinking_type)\n+        # Build a new dict so the caller's extra_body is never mutated\n+        extra_body = kwargs.get(\"extra_body\") or {}\n+        kwargs[\"extra_body\"] = {\n+            **extra_body,\n+            \"thinking\": {\n+                \"type\": thinking_type,\n+                **extra_body.get(\"thinking\", {}),\n+            },\n+        }\n \n         fmt_tools, fmt_tool_choice = self._format_tools(tools, tool_choice)\n \ndiff --git a/src/agentscope/model/_moonshot/_model.py b/src/agentscope/model/_moonshot/_model.py\nindex eff22c8e32..dd93f7dbc0 100644\n--- a/src/agentscope/model/_moonshot/_model.py\n+++ b/src/agentscope/model/_moonshot/_model.py\n@@ -212,12 +212,15 @@ async def _call_api(\n             thinking_type = (\n                 \"enabled\" if self.parameters.thinking_enable else \"disabled\"\n             )\n-            kwargs.setdefault(\"extra_body\", {})\n-            kwargs[\"extra_body\"].setdefault(\"thinking\", {})\n-            kwargs[\"extra_body\"][\"thinking\"].setdefault(\n-                \"type\",\n-                thinking_type,\n-            )\n+            # Build a new dict so the caller's extra_body is never mutated\n+            extra_body = kwargs.get(\"extra_body\") or {}\n+            kwargs[\"extra_body\"] = {\n+                **extra_body,\n+                \"thinking\": {\n+                    \"type\": thinking_type,\n+                    **extra_body.get(\"thinking\", {}),\n+                },\n+            }\n \n         fmt_tools, fmt_tool_choice = self._format_tools(tools, tool_choice)\n \ndiff --git a/src/agentscope/model/_volcengine/_model.py b/src/agentscope/model/_volcengine/_model.py\nindex b2eb4a6d9f..7233272a78 100644\n--- a/src/agentscope/model/_volcengine/_model.py\n+++ b/src/agentscope/model/_volcengine/_model.py\n@@ -210,12 +210,15 @@ async def _call_api(\n             thinking_type = (\n                 \"enabled\" if self.parameters.thinking_enable else \"disabled\"\n             )\n-            kwargs.setdefault(\"extra_body\", {})\n-            kwargs[\"extra_body\"].setdefault(\"thinking\", {})\n-            kwargs[\"extra_body\"][\"thinking\"].setdefault(\n-                \"type\",\n-                thinking_type,\n-            )\n+            # Build a new dict so the caller's extra_body is never mutated\n+            extra_body = kwargs.get(\"extra_body\") or {}\n+            kwargs[\"extra_body\"] = {\n+                **extra_body,\n+                \"thinking\": {\n+                    \"type\": thinking_type,\n+                    **extra_body.get(\"thinking\", {}),\n+                },\n+            }\n \n         fmt_tools, fmt_tool_choice = self._format_tools(tools, tool_choice)\n \n", "test_patch": "diff --git a/tests/model_deepseek_test.py b/tests/model_deepseek_test.py\nindex 155c95c908..e761f6a07c 100644\n--- a/tests/model_deepseek_test.py\n+++ b/tests/model_deepseek_test.py\n@@ -183,6 +183,28 @@ async def test_text_response(self) -> None:\n         )\n         self.assertEqual(result.id, \"deepseek-1\")\n \n+    async def test_extra_body_is_not_mutated(self) -> None:\n+        \"\"\"Defaulting thinking.type leaves the caller's extra_body intact.\"\"\"\n+        mock_create = AsyncMock(\n+            return_value=_mock_completion(text=\"Hello!\"),\n+        )\n+        self.mock_client.chat.completions.create = mock_create\n+        extra_body = {\"custom\": \"value\", \"thinking\": {\"budget_tokens\": 1024}}\n+\n+        await self.model([], extra_body=extra_body)\n+\n+        self.assertDictEqual(\n+            extra_body,\n+            {\"custom\": \"value\", \"thinking\": {\"budget_tokens\": 1024}},\n+        )\n+        self.assertDictEqual(\n+            mock_create.await_args.kwargs[\"extra_body\"],\n+            {\n+                \"custom\": \"value\",\n+                \"thinking\": {\"budget_tokens\": 1024, \"type\": \"disabled\"},\n+            },\n+        )\n+\n     async def test_tool_call_response(\n         self,\n     ) -> None:\ndiff --git a/tests/model_moonshot_test.py b/tests/model_moonshot_test.py\nindex 71dc098d5d..864f6530b2 100644\n--- a/tests/model_moonshot_test.py\n+++ b/tests/model_moonshot_test.py\n@@ -170,6 +170,28 @@ async def test_text_response(self) -> None:\n         )\n         self.assertEqual(result.id, \"kimi-1\")\n \n+    async def test_extra_body_is_not_mutated(self) -> None:\n+        \"\"\"Defaulting thinking.type leaves the caller's extra_body intact.\"\"\"\n+        mock_create = AsyncMock(\n+            return_value=_mock_completion(text=\"Hello!\"),\n+        )\n+        self.mock_client.chat.completions.create = mock_create\n+        extra_body = {\"custom\": \"value\", \"thinking\": {\"budget_tokens\": 1024}}\n+\n+        await self.model([], extra_body=extra_body)\n+\n+        self.assertDictEqual(\n+            extra_body,\n+            {\"custom\": \"value\", \"thinking\": {\"budget_tokens\": 1024}},\n+        )\n+        self.assertDictEqual(\n+            mock_create.await_args.kwargs[\"extra_body\"],\n+            {\n+                \"custom\": \"value\",\n+                \"thinking\": {\"budget_tokens\": 1024, \"type\": \"disabled\"},\n+            },\n+        )\n+\n     async def test_tool_call_response(\n         self,\n     ) -> None:\ndiff --git a/tests/model_volcengine_test.py b/tests/model_volcengine_test.py\nindex 312b2c4d36..79edbfddb4 100644\n--- a/tests/model_volcengine_test.py\n+++ b/tests/model_volcengine_test.py\n@@ -184,6 +184,29 @@ async def test_text_response(self) -> None:\n         )\n         self.assertEqual(result.id, \"volcengine-1\")\n \n+    async def test_extra_body_is_not_mutated(self) -> None:\n+        \"\"\"Defaulting thinking.type leaves the caller's extra_body intact.\"\"\"\n+        mock_create = AsyncMock(\n+            return_value=_mock_completion(text=\"Hello!\"),\n+        )\n+        self.mock_client.chat.completions.create = mock_create\n+        self.model.parameters.thinking_enable = False\n+        extra_body = {\"custom\": \"value\", \"thinking\": {\"budget_tokens\": 1024}}\n+\n+        await self.model([], extra_body=extra_body)\n+\n+        self.assertDictEqual(\n+            extra_body,\n+            {\"custom\": \"value\", \"thinking\": {\"budget_tokens\": 1024}},\n+        )\n+        self.assertDictEqual(\n+            mock_create.await_args.kwargs[\"extra_body\"],\n+            {\n+                \"custom\": \"value\",\n+                \"thinking\": {\"budget_tokens\": 1024, \"type\": \"disabled\"},\n+            },\n+        )\n+\n     async def test_tool_call_response(\n         self,\n     ) -> None:\n", "problem_statement": "[Bug]: DeepSeek/Moonshot/Volcengine chat models mutate the caller's extra_body dict\n**<u>AgentScope is an open-source project. To involve a broader community, we recommend asking your questions in English.</u>**\n\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`DeepSeekChatModel`, `MoonshotChatModel` and `VolcengineChatModel` each default\n`extra_body[\"thinking\"][\"type\"]` while assembling the request. They do it by\n`setdefault` on the dict the caller supplied, so **the caller's own dict is\nmutated in place**:\n\n```python\n# src/agentscope/model/_deepseek/_model.py (and the Moonshot/Volcengine twins)\nkwargs.update(generate_kwargs)          # kwargs[\"extra_body\"] IS the caller's dict\n\nthinking_type = \"enabled\" if self.parameters.thinking_enable else \"disabled\"\nkwargs.setdefault(\"extra_body\", {})\nkwargs[\"extra_body\"].setdefault(\"thinking\", {})\nkwargs[\"extra_body\"][\"thinking\"].setdefault(\"type\", thinking_type)\n```\n\nTwo consequences:\n\n1. **Silent mutation of caller state.** A dict reused across calls\n   (a loop, a session, a config dict held by the application) is silently\n   grown with an `agentscope`-specific `thinking` key it never asked for.\n2. **The thinking toggle sticks.** Because the subsequent `setdefault` calls\n   only fill in *missing* keys, once the first call has inserted\n   `thinking.type`, any later call with the same dict reuses it. Turning\n   `thinking_enable` back on has no effect, and the model keeps sending the\n   value from the first call.\n\n`DashScopeChatModel` already avoids this - it copies first\n(`src/agentscope/model/_dashscope/_model.py`):\n\n```python\neb = dict(request_kwargs.get(\"extra_body\") or {})\nrequest_kwargs[\"extra_body\"] = eb\n```\n\nThe three models above are the odd ones out.\n\n### Error Messages\n\nNo exception is raised; the wrong behaviour is silent. Observed by capturing\nthe kwargs handed to `client.chat.completions.create` with a mocked client:\n\n```python\nextra = {\"top_k\": 5}\nawait model(msgs, extra_body=extra)\nprint(extra)\n# mutated: {'top_k': 5, 'thinking': {'type': 'disabled'}}\n\nmodel.parameters.thinking_enable = True\nawait model(msgs, extra_body=extra)   # same dict\n# sent extra_body[\"thinking\"][\"type\"] is still \"disabled\"\n```\n\n### Steps to Reproduce\n\n1. Code:\n\n```python\nfrom unittest.mock import AsyncMock, MagicMock\n\nfrom agentscope.credential import DeepSeekCredential\nfrom agentscope.model import DeepSeekChatModel\n\nmodel = DeepSeekChatModel(\n    credential=DeepSeekCredential(api_key=\"test\"),\n    model=\"deepseek-v4-pro\",\n    stream=False,\n    context_size=65_536,\n)\nclient = MagicMock()\ncreate = AsyncMock(return_value=MagicMock())\nclient.chat.completions.create = create\nmodel.client = client\n\nextra = {\"top_k\": 5}\nmodel.parameters.thinking_enable = False\nawait model([], extra_body=extra)\nprint(\"caller dict after call 1:\", extra)\n\nmodel.parameters.thinking_enable = True\nawait model([], extra_body=extra)\nprint(\"sent thinking type:\", create.call_args.kwargs[\"extra_body\"][\"thinking\"][\"type\"])\n```\n\n2. Run: `python repro.py`\n\n3. See:\n\n```\ncaller dict after call 1: {'top_k': 5, 'thinking': {'type': 'disabled'}}\nsent thinking type: disabled\n```\n\nExpected: the caller dict is unchanged, and the second request carries\n`type: \"enabled\"`.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at `6109dd0`)\n- Python Version: 3.11\n- OS: Linux\n\nReproduced with a mocked client, so no credentials and no network are needed.\n\n", "hints_text": "", "created_at": "2026-10-01T03:28:22Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3064, "instance_id": "agentscope-ai__agentscope-3064", "issue_numbers": ["3059"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/rag/_parser/_word.py b/src/agentscope/rag/_parser/_word.py\nindex 44f729d3e3..26a080d85d 100644\n--- a/src/agentscope/rag/_parser/_word.py\n+++ b/src/agentscope/rag/_parser/_word.py\n@@ -350,20 +350,50 @@ def flush_text() -> None:\n                     if self.table_format == \"markdown\"\n                     else _table_to_json(table_data)\n                 )\n-                if not rendered:\n-                    continue\n-\n-                if self.separate_table:\n-                    flush_text()\n-                    sections.append(\n-                        Section(\n-                            content=TextBlock(text=rendered),\n-                            source=filename,\n-                            metadata={},\n-                        ),\n-                    )\n-                else:\n-                    text_buffer.append(rendered)\n+\n+                if rendered:\n+                    if self.separate_table:\n+                        flush_text()\n+                        sections.append(\n+                            Section(\n+                                content=TextBlock(text=rendered),\n+                                source=filename,\n+                                metadata={},\n+                            ),\n+                        )\n+                    else:\n+                        text_buffer.append(rendered)\n+\n+                # Images pasted into table cells live under the table's\n+                # ``w:p`` elements, not under body-level paragraphs; without\n+                # this pass they are silently dropped.\n+                if self.include_image:\n+                    image_blocks: list[DataBlock] = []\n+                    for p_elem in element.findall(\".//\" + qn(\"w:p\")):\n+                        # The outer paragraph scan already covers images in\n+                        # nested text-box paragraphs.\n+                        if p_elem.xpath(\"ancestor::w:p\"):\n+                            continue\n+                        image_blocks.extend(\n+                            _extract_image_blocks(\n+                                Paragraph(p_elem, doc),\n+                                filename,\n+                            ),\n+                        )\n+                    if image_blocks:\n+                        flush_text()\n+                        for block in image_blocks:\n+                            sections.append(\n+                                Section(\n+                                    content=block,\n+                                    source=filename,\n+                                    metadata={\n+                                        \"media_type\": (\n+                                            block.source.media_type\n+                                        ),\n+                                    },\n+                                ),\n+                            )\n \n         flush_text()\n         return sections\n", "test_patch": "diff --git a/tests/rag_parser_test.py b/tests/rag_parser_test.py\nindex f8660e9639..3dcb3530f9 100644\n--- a/tests/rag_parser_test.py\n+++ b/tests/rag_parser_test.py\n@@ -306,6 +306,71 @@ def _make_docx_with_image() -> bytes:\n     return buffer.getvalue()\n \n \n+def _make_docx_with_image_in_table_cell() -> bytes:\n+    \"\"\"Build a DOCX whose 1x1 table cell contains text and an embedded\n+    PNG image.\"\"\"\n+    from docx import Document as DocxDocument\n+    from docx.shared import Inches\n+\n+    doc = DocxDocument()\n+    doc.add_paragraph(\"Before table\")\n+    table = doc.add_table(rows=1, cols=1)\n+    cell = table.cell(0, 0)\n+    cell.text = \"see screenshot\"\n+    cell.add_paragraph().add_run().add_picture(\n+        io.BytesIO(_PNG_PIXEL),\n+        width=Inches(1),\n+    )\n+    doc.add_paragraph(\"After table\")\n+\n+    buffer = io.BytesIO()\n+    doc.save(buffer)\n+    return buffer.getvalue()\n+\n+\n+def _make_docx_with_image_in_table_text_box() -> bytes:\n+    \"\"\"Build a DOCX with an image nested in a table-cell text box.\"\"\"\n+    from docx import Document as DocxDocument\n+    from docx.oxml import parse_xml\n+    from docx.oxml.ns import nsdecls, qn\n+    from docx.shared import Inches\n+\n+    doc = DocxDocument()\n+    doc.add_paragraph(\"Before table\")\n+    cell = doc.add_table(rows=1, cols=1).cell(0, 0)\n+    outer_paragraph = cell.paragraphs[0]\n+\n+    image_paragraph = cell.add_paragraph()\n+    image_paragraph.add_run().add_picture(\n+        io.BytesIO(_PNG_PIXEL),\n+        width=Inches(1),\n+    )\n+    image_element = image_paragraph._p  # pylint: disable=protected-access\n+    image_element.getparent().remove(image_element)\n+\n+    text_box_run = parse_xml(\n+        f\"<w:r {nsdecls('w')} \"\n+        f'xmlns:v=\"urn:schemas-microsoft-com:vml\">'\n+        f\"<w:pict><v:shape><v:textbox>\"\n+        f\"<w:txbxContent/>\"\n+        f\"</v:textbox></v:shape></w:pict>\"\n+        f\"</w:r>\",\n+    )\n+    text_box_content = text_box_run.find(\n+        \".//\" + qn(\"w:txbxContent\"),\n+    )\n+    assert text_box_content is not None\n+    text_box_content.append(image_element)\n+    outer_paragraph._p.append(  # pylint: disable=protected-access\n+        text_box_run,\n+    )\n+    doc.add_paragraph(\"After table\")\n+\n+    buffer = io.BytesIO()\n+    doc.save(buffer)\n+    return buffer.getvalue()\n+\n+\n def _make_xlsx_simple(\n     sheets: dict[str, list[list[str]]],\n ) -> bytes:\n@@ -2030,6 +2095,90 @@ async def test_image_emits_data_block(self) -> None:\n         self.assertEqual(ds.content.name, \"rich.docx\")\n         self.assertIn(\"media_type\", ds.metadata)\n \n+    async def test_image_inside_table_cell_emits_data_block(self) -> None:\n+        \"\"\"Images pasted into table cells are not dropped.\"\"\"\n+        docx_bytes = _make_docx_with_image_in_table_cell()\n+        parser = WordParser(include_image=True)\n+        sections = await parser.parse(docx_bytes, \"table.docx\")\n+\n+        data_sections = [s for s in sections if s.content.type == \"data\"]\n+        self.assertEqual(len(data_sections), 1)\n+        ds = data_sections[0]\n+        self.assertEqual(ds.source, \"table.docx\")\n+        self.assertEqual(ds.metadata[\"media_type\"], \"image/png\")\n+\n+        texts = [s.content.text for s in sections if s.content.type == \"text\"]\n+        joined = \"\\n\".join(texts)\n+        self.assertIn(\"Before table\", joined)\n+        self.assertIn(\"see screenshot\", joined)\n+        self.assertIn(\"After table\", joined)\n+\n+    async def test_image_in_table_text_box_emitted_once(self) -> None:\n+        \"\"\"An image in a nested text-box paragraph is emitted once.\"\"\"\n+        docx_bytes = _make_docx_with_image_in_table_text_box()\n+        sections = await WordParser(include_image=True).parse(\n+            docx_bytes,\n+            \"text-box.docx\",\n+        )\n+\n+        self.assertEqual(\n+            [section.model_dump() for section in sections],\n+            [\n+                {\n+                    \"content\": {\n+                        \"type\": \"text\",\n+                        \"text\": \"Before table\\n|  |\\n| --- |\\n\",\n+                        \"id\": AnyString(),\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                    },\n+                    \"source\": \"text-box.docx\",\n+                    \"metadata\": {},\n+                },\n+                {\n+                    \"content\": {\n+                        \"type\": \"data\",\n+                        \"id\": AnyString(),\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                        \"source\": {\n+                            \"type\": \"base64\",\n+                            \"data\": _PNG_PIXEL_B64,\n+                            \"media_type\": \"image/png\",\n+                        },\n+                        \"name\": \"text-box.docx\",\n+                    },\n+                    \"source\": \"text-box.docx\",\n+                    \"metadata\": {\"media_type\": \"image/png\"},\n+                },\n+                {\n+                    \"content\": {\n+                        \"type\": \"text\",\n+                        \"text\": \"After table\",\n+                        \"id\": AnyString(),\n+                        \"created_at\": AnyString(),\n+                        \"finished_at\": None,\n+                    },\n+                    \"source\": \"text-box.docx\",\n+                    \"metadata\": {},\n+                },\n+            ],\n+        )\n+\n+    async def test_image_inside_table_cell_excluded_when_disabled(\n+        self,\n+    ) -> None:\n+        \"\"\"``include_image=False`` keeps only text sections.\"\"\"\n+        docx_bytes = _make_docx_with_image_in_table_cell()\n+        parser = WordParser(include_image=False)\n+        sections = await parser.parse(docx_bytes, \"table.docx\")\n+\n+        self.assertEqual([s.content.type for s in sections], [\"text\"])\n+        self.assertIn(\n+            \"see screenshot\",\n+            \"\\n\".join(s.content.text for s in sections),\n+        )\n+\n     async def test_image_excluded_when_disabled(self) -> None:\n         \"\"\"``include_image=False`` keeps only text sections.\"\"\"\n         docx_bytes = _make_docx_with_image()\n", "problem_statement": "[Bug]: WordParser silently drops images embedded inside table cells\n## Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions) and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n## Description\n\nIn `WordParser.parse()` (`src/agentscope/rag/_parser/_word.py`, body-walk loop, lines 311\u2013366 on `e101864`), the `CT_P` branch extracts embedded images via `_extract_image_blocks()` when `include_image=True`. The `CT_Tbl` branch, however, only renders cell **text** (markdown/JSON) and never touches images:\n\n```python\nelif isinstance(element, CT_Tbl):\n    table_data = _extract_table_data(Table(element, doc))\n    rendered = (...)\n    if not rendered:\n        continue\n    ...\n```\n\nAny `w:drawing` / `w:pict` located inside a table cell is therefore silently discarded, although the class docstring states that embedded images are emitted as their own `Section` instances with no table exclusion. Pasting screenshots into table cells is common (spec sheets, test reports, financial documents), so RAG indexing of such DOCX files permanently loses every image under the default `include_image=True`.\n\n## Reproduce\n\nNo error is raised; the parser silently returns altered content.\n\n```python\nimport asyncio, io, base64\nfrom docx import Document\nfrom agentscope.rag import WordParser\n\npng = base64.b64decode(\n    \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJ\"\n    \"AAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n)  # 1x1 PNG\n\ndoc = Document()\ndoc.add_paragraph(\"Intro\")\ndoc.add_paragraph().add_run().add_picture(io.BytesIO(png))   # body image \u2014 extracted\ncell = doc.add_table(rows=1, cols=1).cell(0, 0)\ncell.text = \"see screenshot\"\ncell.add_paragraph().add_run().add_picture(io.BytesIO(png))  # cell image \u2014 dropped\ndoc.add_paragraph(\"Outro\")\nbuf = io.BytesIO()\ndoc.save(buf)\n\nsections = asyncio.run(WordParser().parse(buf.getvalue(), \"a.docx\"))\n# Actual:   3 sections, exactly one DataBlock (the body-level image)\n# Expected: 4 sections, two DataBlocks (the cell image is preserved)\n```\n\n## Environment\n\n- agentscope `main` @ `e101864` (2026-09-30)\n- Python 3.12.14\n- Windows 10 (19045); behavior is platform-independent\n- python-docx 1.1+ (`agentscope[rag]` extra)\n\n", "hints_text": "", "created_at": "2026-09-30T17:41:12Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3062, "instance_id": "agentscope-ai__agentscope-3062", "issue_numbers": ["3061"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/workspace/_opensandbox/_opensandbox_backend.py b/src/agentscope/workspace/_opensandbox/_opensandbox_backend.py\nindex fb3f6bed10..5289c9bffb 100644\n--- a/src/agentscope/workspace/_opensandbox/_opensandbox_backend.py\n+++ b/src/agentscope/workspace/_opensandbox/_opensandbox_backend.py\n@@ -90,14 +90,17 @@ async def exec_shell(\n             `ExecResult`:\n                 The captured exit code, stdout, and stderr. A non-zero\n                 command exit is returned as a normal result; transport\n-                errors yield an ``exit_code`` of ``-1``.\n+                errors, and an exit code the provider leaves unset, yield\n+                an ``exit_code`` of ``-1``.\n         \"\"\"\n         command_line = \" \".join(shlex.quote(arg) for arg in command)\n         opts = self._make_run_opts(cwd=cwd or self._workdir, timeout=timeout)\n         try:\n             res = await self._sandbox.commands.run(command_line, opts=opts)\n+            # The SDK leaves ``exit_code`` unset when the run's outcome is\n+            # unknown (e.g. killed); report it as -1 rather than success.\n             return ExecResult(\n-                exit_code=int(getattr(res, \"exit_code\", 0) or 0),\n+                exit_code=-1 if res.exit_code is None else res.exit_code,\n                 stdout=self._execution_stream_bytes(res, \"stdout\"),\n                 stderr=self._execution_stream_bytes(res, \"stderr\"),\n             )\n", "test_patch": "diff --git a/tests/backend_opensandbox_test.py b/tests/backend_opensandbox_test.py\nindex 1be34dfbc1..6f655325a1 100644\n--- a/tests/backend_opensandbox_test.py\n+++ b/tests/backend_opensandbox_test.py\n@@ -19,7 +19,9 @@\n \n import os\n import unittest\n+from types import SimpleNamespace\n from unittest.async_case import IsolatedAsyncioTestCase\n+from unittest.mock import AsyncMock\n \n from agentscope.tool import ExecResult\n from agentscope.workspace import OpenSandboxWorkspace\n@@ -153,3 +155,22 @@ async def test_delete_path(self) -> None:\n \n         # Deleting a non-existent path must not raise.\n         await self.backend.delete_path(f\"{SANDBOX_WORKDIR}/missing\")\n+\n+\n+class TestOpenSandboxBackendExitCode(IsolatedAsyncioTestCase):\n+    \"\"\"Exit-code mapping, without a live sandbox.\"\"\"\n+\n+    async def test_unset_exit_code_is_not_success(self) -> None:\n+        \"\"\"An execution the SDK leaves without an exit code reports -1.\"\"\"\n+        execution = SimpleNamespace(exit_code=None, stdout=b\"\", stderr=b\"\")\n+        sandbox = SimpleNamespace(\n+            commands=SimpleNamespace(run=AsyncMock(return_value=execution)),\n+        )\n+        backend = OpenSandboxBackend(sandbox, workdir=\"/workspace\")\n+\n+        result = await backend.exec_shell([\"python\", \"-c\", \"pass\"])\n+\n+        self.assertEqual(\n+            result,\n+            ExecResult(exit_code=-1, stdout=b\"\", stderr=b\"\"),\n+        )\n", "problem_statement": "[Bug]: OpenSandboxBackend reads an unset exit code as success, so a failed bootstrap is reported as clean\n## Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n## Background / Description\n\n`OpenSandboxBackend.exec_shell` collapses \"the provider gave me no exit code\" into `0`:\n\n```python\n# src/agentscope/workspace/_opensandbox/_opensandbox_backend.py:100\nexit_code=int(getattr(res, \"exit_code\", 0) or 0),\n```\n\n`opensandbox.models.execd.Execution.exit_code` is declared `int | None` with `default=None`\n(`opensandbox/models/execd.py:166-170`, opensandbox 1.1.0 \u2014 which `.[dev]` installs via\n`full` \u2192 `workspace` \u2192 `workspace-opensandbox`, see `pyproject.toml:181` and `:93`). For a\n**foreground** command the SDK always recomputes that field with\n`_infer_foreground_exit_code` (`opensandbox/adapters/command_adapter.py:73-81`, applied\nunconditionally for foreground runs at `:242-243`), and the helper has two `return None`\nbranches:\n\n```python\ndef _infer_foreground_exit_code(execution: Execution) -> int | None:\n    if execution.error is not None:\n        try:\n            return int(execution.error.value)\n        except (TypeError, ValueError):\n            return None          # <- the error message is not a bare integer\n    if execution.complete is not None:\n        return 0\n    return None                  # <- the event stream carried no terminal event\n```\n\nSo a run that died with a textual error (`\"signal: killed\"`, `\"command not found: \u2026\"`) \u2014 or\nwhose stream ends without an `execution_complete` event \u2014 reaches this repo as\n`exit_code=None`, and `or 0` turns it into a **successful** command.\n\nThe contract the repo declares for this value says the opposite:\n\n- `ExecResult.exit_code` is a *required* `int`, and its own docstring states that `-1`\n  conventionally indicates an internal failure (`src/agentscope/tool/_builtin/_backend.py:66-67`);\n- `ExecResult.ok()` is `exit_code == 0` (`_backend.py:76-83`);\n- the method's own docstring promises that transport problems come back as `-1`\n  (`_opensandbox_backend.py:91-93`).\n\nThe Docker sibling already resolves the same question the other way round \u2014 it maps a missing\nor `None` code to the sentinel (`src/agentscope/workspace/_docker/_docker_backend.py:114-116`):\n\n```python\ncode = inspect.get(\"ExitCode\", -1)\nif code is None:\n    code = -1\n```\n\nThe remaining backends do not face the same input: bwrap and Apple Container only read\n`process.returncode` after `await process.communicate()`\n(`src/agentscope/workspace/_bubblewrap/_bubblewrap_backend.py:154-167`,\n`src/agentscope/workspace/_applecontainer/_applecontainer_backend.py:110-122`), Daytona's\n`int(res.exit_code)` raises on a `None` into its existing `except Exception` \u2192 `-1` branch\n(`src/agentscope/workspace/_daytona/_daytona_backend.py:111-122`), and E2B's\n`CommandResult.exit_code` is a required `int` (`e2b/sandbox/commands/command_handle.py:50`).\nOpenSandbox is the only backend whose SDK hands it an explicit \"no exit code\" value \u2014 and the\nonly place where that value currently becomes a success.\n\nNothing pins today's behaviour: the whole of `tests/backend_opensandbox_test.py` is\n`@unittest.skipUnless(_DOMAIN, \u2026)` (`:37`, class at `:38`), i.e. it only runs against a live\nsandbox, and no test in `tests/` constructs an execution with `exit_code=None` (the only\n`exit_code` assertion there is `assertEqual(result.exit_code, 4)` at `:74`).\n\n## Error Messages\n\nNo exception is raised \u2014 that is the bug. The observable output of the script below on `main`\nat `72f3f6fa` (`python repro.py`):\n\n```\nSDK Execution.exit_code      : None\nOpenSandboxBackend.exec_shell: 0 ok() = True\nfile_exists('/nope.txt')     : True\nDockerBackend.exec_shell     : -1 ok() = False\n```\n\nThe last line is the Docker backend driven through its own real `exec_shell` with the\nequivalent \"no exit code\" state, included as the in-repo reference for what an unknown code\nshould look like.\n\n## Steps to Reproduce\n\n1. Code \u2014 save as `repro.py`:\n\n```python\n\"\"\"Minimal repro: OpenSandboxBackend reads an unset exit code as success.\n\nRuns on `main` with `pip install -e \".[dev]\"` \u2014 no live sandbox, no network.\nPrints what the opensandbox SDK leaves behind and what the backend makes of it.\n\"\"\"\nimport asyncio\nfrom types import SimpleNamespace\n\nfrom opensandbox.adapters.command_adapter import _infer_foreground_exit_code\nfrom opensandbox.models.execd import Execution, ExecutionError\n\nfrom agentscope.workspace import OpenSandboxBackend\nfrom agentscope.workspace._docker._docker_backend import DockerBackend\n\n\ndef execution_left_by_the_sdk() -> Execution:\n    \"\"\"The object ``commands.run`` returns for a killed foreground command.\"\"\"\n    execution = Execution(id=None, execution_count=None, result=[], error=None)\n    execution.error = ExecutionError(\n        name=\"RuntimeError\",\n        value=\"signal: killed\",\n        timestamp=0,\n        traceback=[],\n    )\n    # command_adapter.py:242-243 applies this to every foreground run.\n    execution.exit_code = _infer_foreground_exit_code(execution)\n    return execution\n\n\ndef opensandbox_backend(execution: object) -> OpenSandboxBackend:\n    \"\"\"A backend whose one command answers with ``execution``.\"\"\"\n\n    async def run(*args: object, **kwargs: object) -> object:\n        return execution\n\n    sandbox = SimpleNamespace(commands=SimpleNamespace(run=run))\n    return OpenSandboxBackend(sandbox, workdir=\"/workspace\")\n\n\nclass _DockerStream:\n    async def read_out(self) -> None:\n        return None\n\n\nclass _DockerStart:\n    async def __aenter__(self) -> _DockerStream:\n        return _DockerStream()\n\n    async def __aexit__(self, *exc: object) -> bool:\n        return False\n\n\nclass _DockerExec:\n    def start(self) -> _DockerStart:\n        return _DockerStart()\n\n    async def inspect(self) -> dict:\n        return {\"ExitCode\": None}\n\n\nclass _DockerContainer:\n    async def exec(self, cmd: list, workdir=None) -> object:\n        return _DockerExec()\n\n\nasync def main() -> None:\n    \"\"\"Compare the two backends on the same 'no exit code' state.\"\"\"\n    execution = execution_left_by_the_sdk()\n    print(\"SDK Execution.exit_code      :\", repr(execution.exit_code))\n\n    backend = opensandbox_backend(execution)\n    result = await backend.exec_shell([\"python\", \"-c\", \"pass\"])\n    print(\"OpenSandboxBackend.exec_shell:\", result.exit_code, \"ok() =\", result.ok())\n    print(\"file_exists('/nope.txt')     :\",\n          await backend.file_exists(\"/nope.txt\"))\n\n    docker = DockerBackend(_DockerContainer(), workdir=\"/workspace\")\n    dresult = await docker.exec_shell([\"true\"])\n    print(\"DockerBackend.exec_shell     :\", dresult.exit_code,\n          \"ok() =\", dresult.ok())\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n```\n\n2. Run: `python repro.py` from a checkout installed with `pip install -e \".[dev]\"`.\n3. See `OpenSandboxBackend.exec_shell: 0 ok() = True` for a command the SDK marked as having\n   no exit code, while `DockerBackend` returns `-1` for the same state.\n\nThe second unknown state behaves identically: an `Execution` with `error=None` and\n`complete=None` also comes back from `_infer_foreground_exit_code` as `None`\n(`command_adapter.py:81`), and `exec_shell` again reports `0` / `ok() = True`.\n\n## Expected behavior\n\n```\nSDK Execution.exit_code      : None\nOpenSandboxBackend.exec_shell: -1 ok() = False\nfile_exists('/nope.txt')     : False\nDockerBackend.exec_shell     : -1 ok() = False\n```\n\nAn exit code the provider never reported is unknown, not zero \u2014 the same conclusion the Docker\nbackend already reaches with `if code is None: code = -1`.\n\n## Impact\n\nEvery filesystem helper is derived from `exec_shell`\n(`BackendBase.file_exists` \u2192 `exec_shell([\"test\", \"-e\", path]).ok()`,\n`src/agentscope/tool/_builtin/_backend.py:475-476`), so one unset code means:\n\n- `file_exists` / `is_dir` / `stat_mtime` answer for paths that do not exist;\n- `SandboxedWorkspaceBase._setup_mcp_gateway` sees\n  `await backend.file_exists(self._gateway_script)` as `True` and **skips the whole venv +\n  script bootstrap** (`src/agentscope/workspace/_sandboxed_base.py:456`), after which a later\n  gateway launch fails with no way to tell the user the sandbox was never provisioned;\n- the bootstrap loop's own guard, `if not r.ok(): raise RuntimeError(...)`\n  (`_sandboxed_base.py:467-472`), never fires, so a failed `apt`/`pip install` inside the\n  sandbox is recorded as success and the workspace is marked initialized.\n\nThis is a silent wrong-result path, not a crash: the workspace reports ready and every later\nbuiltin tool call fails somewhere else, far from the cause.\n\n## Environment\n\n- AgentScope Version: `2.0.10dev` (checked out at `main` = `72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6`)\n- Python Version: 3.12.12 (repo requires >= 3.11; triage CI's 3.11 path is unaffected \u2014 no version-specific behaviour is involved)\n- OS: macOS 15.6 (the reproduction needs no sandbox, no container runtime and no network, so it is not OS-specific)\n- opensandbox: 1.1.0, installed by `.[dev]` through `full` \u2192 `workspace` \u2192 `workspace-opensandbox`\n\n## Suggested fix\n\nMap `None` to the same `-1` sentinel a transport error already gets \u2014 one expression in one\nfile, mirroring `_docker_backend.py:114-116`.\n\n", "hints_text": "", "created_at": "2026-09-30T17:19:26Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3057, "instance_id": "agentscope-ai__agentscope-3057", "issue_numbers": ["3056"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/tool/_builtin/_read.py b/src/agentscope/tool/_builtin/_read.py\nindex 72f023430e..24678998a0 100644\n--- a/src/agentscope/tool/_builtin/_read.py\n+++ b/src/agentscope/tool/_builtin/_read.py\n@@ -313,7 +313,15 @@ async def call(  # type: ignore[override]\n         ext = os.path.splitext(self._backend.basename(file_path))[1].lower()\n \n         if ext == \".pdf\":\n-            return await self._read_pdf(file_path, pages)\n+            # PDF decoding and page serialization can fail after opening.\n+            try:\n+                return await self._read_pdf(file_path, pages)\n+            except Exception as e:\n+                return ToolChunk(\n+                    content=[TextBlock(text=f\"Error reading PDF: {str(e)}\")],\n+                    state=ToolResultState.ERROR,\n+                    is_last=True,\n+                )\n         if ext in _IMAGE_EXTENSIONS:\n             return await self._read_image_file(file_path, ext)\n \n", "test_patch": "diff --git a/tests/builtin_read_test.py b/tests/builtin_read_test.py\nindex 617d84ba92..a7bb46b56a 100644\n--- a/tests/builtin_read_test.py\n+++ b/tests/builtin_read_test.py\n@@ -6,6 +6,7 @@\n import tempfile\n import uuid\n from unittest.async_case import IsolatedAsyncioTestCase\n+from unittest.mock import patch\n from utils import AnyString\n \n from agentscope.tool import ToolChunk, Read\n@@ -422,6 +423,55 @@ async def test_read_pdf_file(self) -> None:\n             },\n         )\n \n+    async def test_read_pdf_deferred_errors(self) -> None:\n+        \"\"\"Late extraction and PDF-writing errors become final error chunks.\"\"\"\n+        from pypdf import PdfWriter\n+\n+        writer = PdfWriter()\n+        writer.add_blank_page(width=72, height=72)\n+        writer.add_blank_page(width=72, height=72)\n+        with tempfile.NamedTemporaryFile(delete=False, suffix=\".pdf\") as fp:\n+            writer.write(fp)\n+        self.addCleanup(os.unlink, fp.name)\n+\n+        # Malformed streams may be tolerated by different pypdf versions.\n+        # Inject failures at the actual deferred operations instead.\n+        for method, message, native_pdf in (\n+            (\"PageObject.extract_text\", \"cannot extract text\", False),\n+            (\"PdfWriter.add_page\", \"cannot copy page\", True),\n+            (\"PdfWriter.write\", \"cannot write PDF\", True),\n+        ):\n+            with self.subTest(method=method):\n+                tool = Read(\n+                    model_input_types=[\"application/pdf\"]\n+                    if native_pdf\n+                    else [],\n+                )\n+                with patch(\n+                    f\"pypdf.{method}\",\n+                    side_effect=ValueError(message),\n+                ) as failure:\n+                    chunk = await tool(file_path=fp.name, pages=\"1\")\n+                failure.assert_called_once()\n+                self.assertDictEqual(\n+                    chunk.model_dump(mode=\"json\"),\n+                    {\n+                        \"content\": [\n+                            {\n+                                \"type\": \"text\",\n+                                \"text\": f\"Error reading PDF: {message}\",\n+                                \"id\": AnyString(),\n+                                \"created_at\": AnyString(),\n+                                \"finished_at\": None,\n+                            },\n+                        ],\n+                        \"state\": \"error\",\n+                        \"is_last\": True,\n+                        \"metadata\": {},\n+                        \"id\": AnyString(),\n+                    },\n+                )\n+\n     async def test_read_pdf_with_pages_param(self) -> None:\n         \"\"\"Test reading a page range and a single page from a PDF.\"\"\"\n         from pypdf import PdfWriter\n", "problem_statement": "[Bug]: Read tool leaks errors from deferred PDF extraction and page writing\nRead._read_pdf catches failures while opening a PDF and counting pages, but text extraction and writing a selected-page PDF occur outside that error boundary.\n\nA real reproducer is a one-page PDF whose /Contents stream contains b\"BT (unterminated\". PdfReader and len(reader.pages) succeed, but extract_text() raises PdfStreamError(\"Stream has ended unexpectedly\"), which escapes the Read tool rather than producing its normal error ToolChunk. Failures when copying or serializing requested pages also escape.\n\nExpected: report these failures as a final error ToolChunk, consistent with initial PDF-read errors, while preserving valid PDF text extraction and native PDF output.\n\nI will add a regression using real malformed PDF bytes and fault-injection tests for page copying/writing. This affects the builtin Read tool, separate from the RAG PDFParser fix in #2975. Codex-assisted investigation.\n", "hints_text": "", "created_at": "2026-09-30T12:40:51Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3055, "instance_id": "agentscope-ai__agentscope-3055", "issue_numbers": ["3054"], "base_commit": "72f3f6fa0b2fc38b8517f408ab616f0f2bd229e6", "patch": "diff --git a/src/agentscope/rag/_vdb/_qdrant.py b/src/agentscope/rag/_vdb/_qdrant.py\nindex 09af9a69c4..404ac25824 100644\n--- a/src/agentscope/rag/_vdb/_qdrant.py\n+++ b/src/agentscope/rag/_vdb/_qdrant.py\n@@ -478,6 +478,7 @@ def _build_metadata_filter(\n         ``chunk.metadata.<key>`` written by :meth:`insert`.  Returns\n         ``None`` when ``metadata_filter`` is empty so that callers\n         skip the filter argument entirely.\n+        A ``None`` value matches an explicitly null field, not a missing key.\n \n         Args:\n             metadata_filter (`dict[str, Any] | None`):\n@@ -495,6 +496,13 @@ def _build_metadata_filter(\n         conditions = []\n         for key, value in metadata_filter.items():\n             field = f\"chunk.metadata.{key}\"\n+            if value is None:\n+                conditions.append(\n+                    models.IsNullCondition(\n+                        is_null=models.PayloadField(key=field),\n+                    ),\n+                )\n+                continue\n             if isinstance(value, float):\n                 if not math.isfinite(value):\n                     raise ValueError(\n", "test_patch": "diff --git a/tests/rag_vdb_qdrant_test.py b/tests/rag_vdb_qdrant_test.py\nindex cc39730713..377158afde 100644\n--- a/tests/rag_vdb_qdrant_test.py\n+++ b/tests/rag_vdb_qdrant_test.py\n@@ -444,6 +444,69 @@ def _record(\n         )\n         self.assertEqual([r.document_id for r in results], [\"doc-2\"])\n \n+    async def test_null_metadata_filters(self) -> None:\n+        \"\"\"Null means an explicit null, and composes with other predicates.\"\"\"\n+        await self.store.create_collection(\"kb-null\", dimensions=3)\n+        records = []\n+        for index, metadata in enumerate(\n+            [\n+                {\"reviewer\": None, \"scope\": \"a\"},\n+                {\"scope\": \"a\"},\n+                {\"reviewer\": \"\", \"scope\": \"a\"},\n+                {\"reviewer\": False, \"scope\": \"a\"},\n+                {\"reviewer\": 0, \"scope\": \"a\"},\n+                {\"reviewer\": \"None\", \"scope\": \"a\"},\n+                {\"reviewer\": None, \"scope\": \"b\"},\n+            ],\n+        ):\n+            record = _make_record(\"text\", [1.0, 0.0, 0.0], f\"doc-{index}\")\n+            record.chunk.metadata = metadata\n+            records.append(record)\n+        await self.store.insert(\"kb-null\", records)\n+        metadata_filter = {\"reviewer\": None, \"scope\": \"a\"}\n+        results = await self.store.search(\n+            \"kb-null\",\n+            [1.0, 0.0, 0.0],\n+            top_k=10,\n+            metadata_filter=metadata_filter,\n+        )\n+        self.assertEqual(\n+            _dump_results(results),\n+            [\n+                {\n+                    \"score\": 1.0,\n+                    \"document_id\": \"doc-0\",\n+                    \"chunk\": records[0].chunk.model_dump(),\n+                },\n+            ],\n+        )\n+        documents = await self.store.list_documents(\n+            \"kb-null\",\n+            metadata_filter=metadata_filter,\n+        )\n+        self.assertEqual(\n+            [document.model_dump() for document in documents],\n+            [\n+                {\n+                    \"document_id\": \"doc-0\",\n+                    \"source\": \"doc-0.txt\",\n+                    \"chunk_count\": 1,\n+                    \"metadata\": metadata_filter,\n+                },\n+            ],\n+        )\n+        for index, record in enumerate(records):\n+            with self.subTest(document_id=record.document_id):\n+                chunks = await self.store.list_chunks(\n+                    \"kb-null\",\n+                    record.document_id,\n+                    metadata_filter=metadata_filter,\n+                )\n+                self.assertEqual(\n+                    [chunk.model_dump() for chunk in chunks],\n+                    [record.chunk.model_dump()] if index == 0 else [],\n+                )\n+\n     async def test_float_metadata_filters(self) -> None:\n         \"\"\"Every read operation matches finite floats without rounding.\"\"\"\n         await self.store.create_collection(\"kb-1\", dimensions=3)\n", "problem_statement": "[Bug]: Qdrant metadata filters reject explicit null values\nPassing metadata_filter={\"reviewer\": None} to QdrantStore.search, list_documents, or list_chunks raises a Pydantic ValidationError while constructing MatchValue, before the database is queried. MatchValue accepts string/integer/boolean values but not null.\n\nMetadata can contain JSON null, and the store exposes equality filtering over metadata. Null filters should use Qdrant IsNullCondition so an explicitly null field is matched without also matching missing fields or other falsey values. This should compose with other filter conditions.\n\nReproduced on main 72f3f6f by calling QdrantStore._build_metadata_filter({\"reviewer\": None}). I will provide a focused fix and in-memory Qdrant regression tests for all three read methods. Codex-assisted investigation.\n", "hints_text": "", "created_at": "2026-09-30T12:35:12Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3042, "instance_id": "agentscope-ai__agentscope-3042", "issue_numbers": ["3041"], "base_commit": "c0a576249a5d97ccb58db937c00c13f68c3b5c1d", "patch": "diff --git a/src/agentscope/tts/_dashscope/_cosyvoice_utils.py b/src/agentscope/tts/_dashscope/_cosyvoice_utils.py\nindex b1573b5978..904cc7645a 100644\n--- a/src/agentscope/tts/_dashscope/_cosyvoice_utils.py\n+++ b/src/agentscope/tts/_dashscope/_cosyvoice_utils.py\n@@ -53,11 +53,13 @@ def __init__(self) -> None:\n             self.finish_event = threading.Event()\n             self._pcm_bytes: bytearray = bytearray()\n             self._consumed: int = 0\n+            self._error: RuntimeError | None = None\n \n         def on_open(self) -> None:\n             \"\"\"Handle WebSocket open by resetting audio state.\"\"\"\n             self._pcm_bytes = bytearray()\n             self._consumed = 0\n+            self._error = None\n             self.finish_event.clear()\n             self.chunk_event.clear()\n \n@@ -81,6 +83,7 @@ def on_close(self) -> None:\n         def on_error(self, message: Any) -> None:\n             \"\"\"Handle synthesis error.\"\"\"\n             logger.error(\"CosyVoice TTS error: %s\", message)\n+            self._error = RuntimeError(f\"CosyVoice TTS error: {message}\")\n             self.finish_event.set()\n             self.chunk_event.set()\n \n@@ -102,6 +105,8 @@ def get_audio_response(self, block: bool) -> TTSResponse:\n             \"\"\"Return incremental audio delta.\"\"\"\n             if block:\n                 self.finish_event.wait()\n+            if self._error is not None:\n+                raise self._error\n             delta = self._take_delta(header=self._consumed == 0)\n             if delta:\n                 return _build_audio_response(delta, _MEDIA_TYPE)\n@@ -113,6 +118,8 @@ async def get_audio_chunks(\n             \"\"\"Yield incremental audio chunks as they arrive.\"\"\"\n             header_sent = self._consumed > 0\n             while True:\n+                if self._error is not None:\n+                    raise self._error\n                 if self.finish_event.is_set():\n                     delta = self._take_delta(header=not header_sent)\n                     if delta:\n@@ -149,6 +156,7 @@ def reset(self) -> None:\n             self.chunk_event.clear()\n             self._pcm_bytes = bytearray()\n             self._consumed = 0\n+            self._error = None\n \n         def has_audio_data(self) -> bool:\n             \"\"\"Return whether any audio data has been received.\"\"\"\n", "test_patch": "diff --git a/tests/tts_dashscope_test.py b/tests/tts_dashscope_test.py\nindex 39d27c2ac8..5fbb8f4f37 100644\n--- a/tests/tts_dashscope_test.py\n+++ b/tests/tts_dashscope_test.py\n@@ -1443,6 +1443,55 @@ async def test_get_audio_response_skips_header_after_partial_push(\n             self.assertFalse(raw.startswith(b\"RIFF\"))\n             self.assertEqual(raw, b\"MOREPCM\")\n \n+    async def test_callback_errors_reach_audio_consumers(self) -> None:\n+        \"\"\"Failure must not finalize empty or partial audio successfully.\"\"\"\n+        with patch.dict(\"sys.modules\", self.mock_modules):\n+            from agentscope.tts._dashscope._cosyvoice_utils import (\n+                _make_cosyvoice_callback_class,\n+            )\n+\n+            callback_cls = _make_cosyvoice_callback_class()\n+            for audio in (b\"\", b\"PCMPCM\"):\n+                for consumer in (\"stream\", \"blocking\", \"polling\"):\n+                    with self.subTest(audio=audio, consumer=consumer):\n+                        cb = callback_cls()\n+                        cb.on_data(audio)\n+                        cb.on_error(\"synthesis failed\")\n+                        cb.on_close()\n+                        with self.assertRaisesRegex(\n+                            RuntimeError,\n+                            \"^CosyVoice TTS error: synthesis failed$\",\n+                        ):\n+                            if consumer == \"stream\":\n+                                _ = [c async for c in cb.get_audio_chunks()]\n+                            else:\n+                                cb.get_audio_response(\n+                                    block=consumer == \"blocking\",\n+                                )\n+\n+    async def test_callback_new_utterance_clears_error(self) -> None:\n+        \"\"\"Resetting or reopening must not carry a stale provider error.\"\"\"\n+        with patch.dict(\"sys.modules\", self.mock_modules):\n+            from agentscope.tts._dashscope._cosyvoice_utils import (\n+                _make_cosyvoice_callback_class,\n+            )\n+\n+            callback_cls = _make_cosyvoice_callback_class()\n+            for reset_method in (\"reset\", \"on_open\"):\n+                with self.subTest(reset_method=reset_method):\n+                    cb = callback_cls()\n+                    cb.on_data(b\"OLDPCM\")\n+                    cb.on_error(\"old failure\")\n+                    getattr(cb, reset_method)()\n+                    cb.on_data(b\"NEWPCM\")\n+                    cb.on_complete()\n+                    response = cb.get_audio_response(block=True)\n+                    self.assertEqual(\n+                        base64.b64decode(response.content.source.data)[44:],\n+                        b\"NEWPCM\",\n+                    )\n+                    self.assertTrue(response.is_last)\n+\n     async def test_callback_reset(self) -> None:\n         \"\"\"reset() clears all state.\"\"\"\n         with patch.dict(\"sys.modules\", self.mock_modules):\n", "problem_statement": "[Bug]: CosyVoice callback errors turn partial audio into successful completion\n### Reproduction\nOn main c0a5762, instantiate the CosyVoice callback from `_make_cosyvoice_callback_class()`, call `on_data(b\"PCMPCM\")`, then `on_error(\"synthesis failed\")` followed by `on_close()`. Collect `get_audio_chunks()` or call `get_audio_response(block=True)`.\n\n### Actual behavior\nThe callback logs the error but returns the partial audio as a successful final result. With no preceding audio, the streaming path yields a normal empty final response. The caller cannot distinguish provider failure from successful completion.\n\n### Expected behavior\nRetain and surface the callback error to both audio consumers, even when partial audio was received or on_close follows on_error. Clear the error when the callback is reset or reopened for a new utterance.\n\nI can provide an offline callback regression and a focused fix. This concerns the CosyVoice WebSocket callback, separate from the previously fixed MultiModalConversation HTTP response handling. Codex-assisted investigation.\n", "hints_text": "", "created_at": "2026-09-30T07:01:34Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3038, "instance_id": "agentscope-ai__agentscope-3038", "issue_numbers": ["3037"], "base_commit": "c0a576249a5d97ccb58db937c00c13f68c3b5c1d", "patch": "diff --git a/src/agentscope/tool/_builtin/_glob.py b/src/agentscope/tool/_builtin/_glob.py\nindex f58f17c5eb..02ed896c35 100644\n--- a/src/agentscope/tool/_builtin/_glob.py\n+++ b/src/agentscope/tool/_builtin/_glob.py\n@@ -326,10 +326,24 @@ async def call(  # type: ignore[override]\n \n         try:\n             matches = json.loads(\n-                result.stdout.decode(\"utf-8\", errors=\"replace\"),\n+                result.stdout.decode(\"utf-8\"),\n+            )\n+        except ValueError:\n+            matches = None\n+\n+        if not isinstance(matches, list) or not all(\n+            isinstance(path, str) for path in matches\n+        ):\n+            return ToolChunk(\n+                content=[\n+                    TextBlock(\n+                        text=\"Glob helper returned invalid output: \"\n+                        \"expected a JSON array of file paths.\",\n+                    ),\n+                ],\n+                state=ToolResultState.ERROR,\n+                is_last=True,\n             )\n-        except (json.JSONDecodeError, ValueError):\n-            matches = []\n \n         if len(matches) == 0:\n             return ToolChunk(\n", "test_patch": "diff --git a/tests/builtin_glob_test.py b/tests/builtin_glob_test.py\nindex 771d765142..c6150dfbc1 100644\n--- a/tests/builtin_glob_test.py\n+++ b/tests/builtin_glob_test.py\n@@ -3,9 +3,10 @@\n import os\n import tempfile\n from unittest.async_case import IsolatedAsyncioTestCase\n+from unittest.mock import AsyncMock\n \n from utils import AnyString\n-from agentscope.tool import Glob\n+from agentscope.tool import ExecResult, Glob, LocalBackend\n from agentscope.permission import (\n     PermissionContext,\n     PermissionBehavior,\n@@ -73,6 +74,45 @@ async def test_check_permissions(self) -> None:\n         # Read/Glob/Grep are read-only, return PASSTHROUGH\n         self.assertEqual(decision.behavior, PermissionBehavior.PASSTHROUGH)\n \n+    async def test_invalid_helper_output(self) -> None:\n+        \"\"\"Malformed helper output must not masquerade as no matches.\"\"\"\n+        backend = LocalBackend()\n+        backend.is_dir = AsyncMock(return_value=True)\n+        backend.exec_shell = AsyncMock()\n+        tool = Glob(backend=backend)\n+        for output in (\n+            b\"not-json\",\n+            b\"null\",\n+            b\"{}\",\n+            b'\"path.py\"',\n+            b\"[1]\",\n+            b\"[null]\",\n+        ):\n+            with self.subTest(output=output):\n+                backend.exec_shell.return_value = ExecResult(0, output, b\"\")\n+                chunk = await tool(pattern=\"*.py\", path=self.temp_dir)\n+                self.assertEqual(\n+                    chunk.model_dump(\n+                        exclude={\n+                            \"id\": True,\n+                            \"content\": {\"__all__\": {\"id\", \"created_at\"}},\n+                        },\n+                    ),\n+                    {\n+                        \"content\": [\n+                            {\n+                                \"type\": \"text\",\n+                                \"text\": \"Glob helper returned invalid output: \"\n+                                \"expected a JSON array of file paths.\",\n+                                \"finished_at\": None,\n+                            },\n+                        ],\n+                        \"state\": \"error\",\n+                        \"is_last\": True,\n+                        \"metadata\": {},\n+                    },\n+                )\n+\n     async def test_simple_pattern(self) -> None:\n         \"\"\"Test simple glob pattern.\"\"\"\n         chunk = await self.glob_tool(\n", "problem_statement": "[Bug]: Glob masks malformed helper output as no matching files\n### Reproduction\nOn main c0a5762, configure a backend whose successful helper invocation returns `ExecResult(0, b\"not-json\", b\"\")`, with `is_dir()` returning true, then call `Glob(backend=backend)(pattern=\"*.py\", path=\"/workspace\")`.\n\n### Actual behavior\nThe tool returns a normal final result saying `No files found matching pattern: *.py`. Invalid JSON is caught and replaced with an empty list. Valid JSON of the wrong shape is also unchecked: `null` raises TypeError and a string is treated as a sequence of matching paths.\n\n### Expected behavior\nReport an error for invalid helper output, reserving the no-matches result for a valid empty array. Validate that the decoded output is an array of strings before pagination.\n\nI can submit a focused fix with offline regression tests. Reproduction was assisted by Codex.\n", "hints_text": "", "created_at": "2026-09-30T06:56:09Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3033, "instance_id": "agentscope-ai__agentscope-3033", "issue_numbers": ["3032"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/tool/_base.py b/src/agentscope/tool/_base.py\nindex b0a61517c7..3ea982e458 100644\n--- a/src/agentscope/tool/_base.py\n+++ b/src/agentscope/tool/_base.py\n@@ -467,8 +467,8 @@ def _is_dangerous_path(self, file_path: str) -> bool:\n             False\n         \"\"\"\n \n-        # Normalize path\n-        abs_path = os.path.abspath(os.path.expanduser(file_path))\n+        # Resolve symlinks so an alias is judged by its target\n+        abs_path = os.path.realpath(os.path.expanduser(file_path))\n \n         # Split path into segments\n         path_parts = Path(abs_path).parts\n", "test_patch": "diff --git a/tests/permission_engine_test.py b/tests/permission_engine_test.py\nindex ee71c1f962..14294fa2c9 100644\n--- a/tests/permission_engine_test.py\n+++ b/tests/permission_engine_test.py\n@@ -6,7 +6,9 @@\n path detection, suggestion generation, Bash read-only command analysis,\n and bypass-immune safety checks.\n \"\"\"\n+import os\n import sys\n+import tempfile\n import unittest\n from unittest.async_case import IsolatedAsyncioTestCase\n \n@@ -439,6 +441,39 @@ async def test_safe_file_allows_write(self) -> None:\n         # Should NOT be a safety check\n         self.assertNotIn(\"safety\", decision.decision_reason.lower())\n \n+    async def test_symlink_to_dangerous_file_still_asks(self) -> None:\n+        \"\"\"A symlink aliasing a sensitive file is judged by its target.\"\"\"\n+        with tempfile.TemporaryDirectory() as tmp:\n+            real = os.path.join(tmp, \".bashrc\")\n+            with open(real, \"w\", encoding=\"utf-8\") as f:\n+                f.write(\"export PATH=/tmp\\n\")\n+            link = os.path.join(tmp, \"innocent.txt\")\n+            os.symlink(real, link)\n+\n+            decision = await self.engine.check_permission(\n+                Write(),\n+                {\"file_path\": link},\n+            )\n+\n+        self.assertEqual(decision.behavior, PermissionBehavior.ASK)\n+        self.assertIn(\"safety\", decision.decision_reason.lower())\n+\n+    async def test_symlink_into_dangerous_directory_asks(self) -> None:\n+        \"\"\"A symlinked path into ``.ssh`` is judged as dangerous too.\"\"\"\n+        with tempfile.TemporaryDirectory() as tmp:\n+            real_dir = os.path.join(tmp, \".ssh\")\n+            os.mkdir(real_dir)\n+            link = os.path.join(tmp, \"innocent\")\n+            os.symlink(real_dir, link)\n+\n+            decision = await self.engine.check_permission(\n+                Write(),\n+                {\"file_path\": os.path.join(link, \"authorized_keys\")},\n+            )\n+\n+        self.assertEqual(decision.behavior, PermissionBehavior.ASK)\n+        self.assertIn(\"safety\", decision.decision_reason.lower())\n+\n     async def asyncTearDown(self) -> None:\n         \"\"\"Clean up test fixtures.\"\"\"\n         self.engine = None\n", "problem_statement": "[Bug]: a symlink alias bypasses the dangerous-path safety check, so writes to ~/.ssh/authorized_keys, .netrc and .env skip the bypass_immune ASK\n### Prerequisites\n\n- [x] I have searched the existing issues and discussions, and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n### Background / Description\n\n`ToolBase._is_dangerous_path` normalizes the candidate path with `os.path.abspath` ([`_base.py:471`](https://github.com/agentscope-ai/agentscope/blob/fa47b07706150962c2a2957998fdbb7cc83dacf0/src/agentscope/tool/_base.py#L153)):\n\n```python\n# Normalize path\nabs_path = os.path.abspath(os.path.expanduser(file_path))\n\n# Split path into segments\npath_parts = Path(abs_path).parts\n```\n\n`os.path.abspath` is a pure string operation: it prepends the current working directory and collapses `.` / `..`, but it never touches the filesystem and therefore never resolves a symbolic link. A symlink named after something harmless is judged by its *name*, not by its *target*.\n\n`Write` and `Edit` call this helper before anything else and raise a `bypass_immune` ASK when it returns `True` ([`_edit.py:154-162`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47/src/agentscope/tool/_builtin/_edit.py#L154-L162), [`_write.py:133-140`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47/src/agentscope/tool/_builtin/_write.py#L133-L140)):\n\n```python\nif self._is_dangerous_path(file_path):\n    return PermissionDecision(\n        behavior=PermissionBehavior.ASK,\n        decision_reason=\"Safety check: dangerous file or directory\",\n        bypass_immune=True,\n    )\n```\n\n`bypass_immune=True` is documented as a guardrail that must hold \"regardless of allow rules\" \u2014 `ACCEPT_EDITS` honors it over its working-directory auto-allow, and `DONT_ASK` turns it into a DENY ([`_engine.py:638-644`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47/src/agentscope/permission/_engine.py#L638-L644)). A symlink skips that guardrail entirely, so the operation falls through to `PASSTHROUGH` and then to the ordinary allow rules.\n\nThe same module already gets this right elsewhere. `_path_in_allowed_working_path` compares both sides with `os.path.realpath` precisely so that aliases compare equal ([`_base.py:422-427`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47/src/agentscope/tool/_base.py#L422-L427)), and its docstring says so explicitly:\n\n> \"Paths are compared via :func:`os.path.realpath` so that aliases like macOS's `/tmp` \u2192 `/private/tmp` and symlinked working directories compare equal on both sides.\"\n\nThat was introduced by #1767 as the fix for #1649. #1649 was the *opposite* failure \u2014 `abspath` there caused a **false positive** (a legitimate in-directory file was asked about). This report is the **false negative**: `abspath` here lets a real sensitive target through. The two are not the same defect; #1649's fix left this call site untouched.\n\n### Error Messages\n\nNo exception is raised. The permission decision itself is the evidence:\n\n```text\n$ python repro_symlink_bypass.py\ntarget      : /tmp/tmpXXXX/.bashrc\nalias       : /tmp/tmpXXXX/innocent.txt  -> /tmp/tmpXXXX/.bashrc\n\n_is_dangerous_path(target) = True\n_is_dangerous_path(alias)  = False\n\nos.path.abspath(alias)  = /tmp/tmpXXXX/innocent.txt\nos.path.realpath(alias) = /tmp/tmpXXXX/.bashrc\n\ncheck_permissions(Write, alias,  DONT_ASK).behavior = PASSTHROUGH\ncheck_permissions(Write, target, DONT_ASK).behavior = ASK\n   -> \"Permission required: Write operation on sensitive file ...\"\n```\n\n`PASSTHROUGH` for the alias and `ASK` for the file it points at is the bypass: the engine never sees a safety concern, so no allow rule has to be bypassed \u2014 there is simply nothing to ask about.\n\n### Steps to Reproduce\n\nRuns in a few seconds, no API key, no network, no MCP.\n\n```python\nimport asyncio\nimport os\nimport tempfile\n\nfrom agentscope.permission import PermissionContext, PermissionMode\nfrom agentscope.tool import Write\n\n\nasync def main() -> None:\n    with tempfile.TemporaryDirectory() as tmp:\n        target = os.path.join(tmp, \".bashrc\")\n        with open(target, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"export PATH=/tmp\n\")\n        alias = os.path.join(tmp, \"innocent.txt\")\n        os.symlink(target, alias)\n\n        write = Write()\n        context = PermissionContext(mode=PermissionMode.DONT_ASK)\n\n        print(\"target     :\", target)\n        print(\"alias      :\", alias, \"->\", os.readlink(alias))\n        print()\n        print(\"_is_dangerous_path(target) =\",\n              write._is_dangerous_path(target))\n        print(\"_is_dangerous_path(alias)  =\",\n              write._is_dangerous_path(alias))\n        print()\n        print(\"abspath(alias)  =\", os.path.abspath(alias))\n        print(\"realpath(alias) =\", os.path.realpath(alias))\n        print()\n\n        for label, path in ((\"alias\", alias), (\"target\", target)):\n            decision = await write.check_permissions(\n                tool_input={\"file_path\": path, \"content\": \"pwned\"},\n                context=context,\n            )\n            print(f\"check_permissions({label}) = {decision.behavior}\")\n\n\nasyncio.run(main())\n```\n\nOn main at `78c4ec47` this prints `PASSTHROUGH` for the alias and `ASK` for the target. The same shape works for a symlinked directory \u2014 `innocent -> ~/.ssh`, then `innocent/authorized_keys` \u2014 because the segment scan also runs on the unresolved name.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at `78c4ec47`)\n- Python Version: 3.11\n- OS: Linux (x86_64)\n- Verified on: main, unmodified; the three regression tests added with the fix fail on this baseline\n\n### Suggested Fix\n\nNormalize with the same function the rest of the module uses:\n\n```diff\n-        # Normalize path\n-        abs_path = os.path.abspath(os.path.expanduser(file_path))\n+        # Normalize path, resolving symlinks so an alias cannot smuggle a\n+        # dangerous target past the check below.\n+        abs_path = os.path.realpath(os.path.expanduser(file_path))\n```\n\nA residual TOCTOU window remains \u2014 the link can still be swapped between the check and the `open` \u2014 so this is necessary, not sufficient. What it removes is the case where the path is *already* a symlink at check time, which is the shape this bypass takes. The accompanying tests cover the dangerous-file alias, a symlinked `.ssh` directory, and a symlink to an ordinary file so the change does not start over-blocking.\n\nPR: coming.\n", "hints_text": "", "created_at": "2026-09-30T02:37:10Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3031, "instance_id": "agentscope-ai__agentscope-3031", "issue_numbers": ["3030"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/tool/_builtin/_bash_parser.py b/src/agentscope/tool/_builtin/_bash_parser.py\nindex 30635e9391..23c41be9ab 100644\n--- a/src/agentscope/tool/_builtin/_bash_parser.py\n+++ b/src/agentscope/tool/_builtin/_bash_parser.py\n@@ -788,10 +788,11 @@ def check_sed_constraints(\n                 # consumed as the remainder above.\n                 if flag_chars.endswith(\"i\") and i + 1 < len(args):\n                     next_arg = args[i + 1]\n+                    # A sed script never starts with a dot, e.g. BSD \".bak\"\n                     if (\n                         not next_arg.startswith(\"-\")\n                         and not next_arg.startswith(\"s\")\n-                        and \".\" not in next_arg\n+                        and (next_arg.startswith(\".\") or \".\" not in next_arg)\n                     ):\n                         i += 1\n             elif name == \"--in-place\":\n@@ -803,7 +804,7 @@ def check_sed_constraints(\n                     if (\n                         not next_arg.startswith(\"-\")\n                         and not next_arg.startswith(\"s\")\n-                        and \".\" not in next_arg\n+                        and (next_arg.startswith(\".\") or \".\" not in next_arg)\n                     ):\n                         i += 1\n             elif not arg.startswith(\"-\"):\n", "test_patch": "diff --git a/tests/permission_bash_parser_test.py b/tests/permission_bash_parser_test.py\nindex 4581022515..3c493a74d5 100644\n--- a/tests/permission_bash_parser_test.py\n+++ b/tests/permission_bash_parser_test.py\n@@ -1045,6 +1045,45 @@ async def test_short_option_with_attached_value(self) -> None:\n                     expected,\n                 )\n \n+    async def test_separated_backup_suffix(self) -> None:\n+        \"\"\"A separated dotted -i suffix is a backup suffix, not a script.\"\"\"\n+        cases = [\n+            (\n+                \"sed -i .bak 's/x/y/' notes.txt\",\n+                None,\n+            ),\n+            (\n+                \"sed -i .orig 's/x/y/' notes.txt\",\n+                None,\n+            ),\n+            (\n+                \"sed --in-place .bak 's/x/y/' notes.txt\",\n+                None,\n+            ),\n+            (\n+                \"sed -i .bak 's/x/y/' .env\",\n+                \"sed -i modifying dangerous file: .env\",\n+            ),\n+            (\n+                \"sed -i bak 's/x/y/' notes.txt\",\n+                None,\n+            ),\n+            (\n+                # A dot inside a script keeps the token unconsumed.\n+                \"sed -i '/example.com/d' notes.txt\",\n+                \"sed expression '/example.com/d' not in allowlist\",\n+            ),\n+        ]\n+        for cmd, expected in cases:\n+            with self.subTest(cmd=cmd):\n+                self.assertEqual(\n+                    self.parser.check_sed_constraints(\n+                        cmd,\n+                        self.dangerous_files,\n+                    ),\n+                    expected,\n+                )\n+\n     async def test_denylist_execute_operations(self) -> None:\n         \"\"\"Test denylist: execute operations (e/E).\"\"\"\n         test_cases = [\n", "problem_statement": "[Bug]: sed -i with a separated dotted backup suffix is misparsed as the sed script\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\n`BashCommandParser.check_sed_constraints` only consumes a separated `-i` /\n`--in-place` backup suffix when the next argument contains no dot. The\nstandard BSD/macOS spelling therefore breaks:\n\n```bash\nsed -i .bak 's/x/y/' notes.txt\n```\n\n`.bak` is analyzed as the sed script and the command is rejected with\n`sed expression '.bak' not in allowlist`, while the real substitution and\nfile arguments are never checked. Legitimate commands can never be\nauto-allowed by the Bash permission system.\n\nA token starting with a dot can never begin a sed script (scripts start\nwith `s`, an address, `$`, `/`, `{`, etc.), so consuming a leading-dot\ntoken as the backup suffix is safe. A dot elsewhere can still belong to a\nscript such as `/example.com/d` and must stay unconsumed \u2014 the current\nbehavior for that case is preserved.\n\nThe attached forms (`-i.bak`, `--in-place=.bak`) and the dotless separated\nform (`-i bak`) already work; #2795 and #2824 covered the inline-value\ncases and missed this separated dotted form.\n\n### Steps to Reproduce\n\n1. Enable the Bash tool with the default permission checks\n2. Ask an agent to run `sed -i .bak 's/x/y/' notes.txt` (no API key or\n   external service needed; the rejection happens in\n   `check_sed_constraints` before execution)\n3. The command is blocked with: `sed expression '.bak' not in allowlist`\n\n### Expected Behavior\n\n`sed -i .bak 's/x/y/' notes.txt` passes the constraint check (`None`),\nand `sed -i .bak 's/x/y/' .env` is still rejected as a dangerous-file\nmodification.\n\nI have a small fix plus a regression test verified locally and would like\nto submit a PR for this issue.\n\n", "hints_text": "", "created_at": "2026-09-30T02:15:47Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3027, "instance_id": "agentscope-ai__agentscope-3027", "issue_numbers": ["3026"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/middleware/_budget.py b/src/agentscope/middleware/_budget.py\nindex b97429a7b0..a34ae50494 100644\n--- a/src/agentscope/middleware/_budget.py\n+++ b/src/agentscope/middleware/_budget.py\n@@ -2,6 +2,7 @@\n \"\"\"Budget control middleware for AgentScope agents.\"\"\"\n from typing import AsyncGenerator, Callable, TYPE_CHECKING\n \n+from ..agent._structured_output_tool import _GenerateStructuredOutput\n from ..event import ModelCallEndEvent, ReplyStartEvent\n from ..message import AssistantMsg, HintBlock\n from ..tool import ToolChoice\n@@ -17,6 +18,13 @@\n     \"</system-reminder>\"\n )\n \n+_STRUCTURED_OUTPUT_HINT_MESSAGE = (\n+    \"<system-reminder>You have reached the maximum token budget set by the \"\n+    \"user. Now you MUST wrap up immediately by calling the '{tool_name}' \"\n+    \"tool with the final structured output, without invoking any other \"\n+    \"tools.</system-reminder>\"\n+)\n+\n \n class ReplyBudgetControlMiddleware(MiddlewareBase):\n     \"\"\"Middleware that enforces a weighted token budget per reply.\n@@ -30,7 +38,8 @@ class ReplyBudgetControlMiddleware(MiddlewareBase):\n     Once the accumulated cost reaches ``token_budget``, a hint message is\n     injected into the agent's context before the next reasoning step, and\n     ``tool_choice`` is forced to ``\"none\"`` so the agent wraps up without\n-    invoking any further tools.\n+    invoking any further tools. A reply that still owes a structured output\n+    is offered only the structured output tool instead.\n \n     Budget state is stored in\n     :attr:`~agentscope.agent.AgentState.middle_context`\n@@ -153,7 +162,9 @@ async def on_reasoning(\n         :class:`~agentscope.message.HintBlock` to the last assistant message\n         in context (or creates a new\n         :class:`~agentscope.message.AssistantMsg`) and overrides\n-        ``tool_choice`` to ``ToolChoice(mode=\"none\")``.\n+        ``tool_choice`` to ``ToolChoice(mode=\"none\")``, or, while a\n+        structured output is still owed, restricts it to the structured\n+        output tool.\n \n         Args:\n             agent (`Agent`):\n@@ -177,7 +188,20 @@ async def on_reasoning(\n \n         # Insert hint block if exceeded budget\n         if used >= self.token_budget:\n-            hint_block = HintBlock(hint=self.hint_message)\n+            # A structured reply can only end by calling this tool\n+            tool_name = _GenerateStructuredOutput.name\n+            reply_context = agent.state.reply_context\n+            structured_output_pending = (\n+                reply_context.structured_schema is not None\n+                and reply_context.structured_output is None\n+            )\n+            hint_block = HintBlock(\n+                hint=(\n+                    _STRUCTURED_OUTPUT_HINT_MESSAGE.format(tool_name=tool_name)\n+                    if structured_output_pending\n+                    else self.hint_message\n+                ),\n+            )\n             if (\n                 len(agent.state.context) > 0\n                 and agent.state.context[-1].role == \"assistant\"\n@@ -193,7 +217,17 @@ async def on_reasoning(\n                         content=[hint_block],\n                     ),\n                 )\n-            input_kwargs[\"tool_choice\"] = ToolChoice(mode=\"none\")\n+            if structured_output_pending:\n+                # Don't force it unless the agent did: providers reject a\n+                # forced tool_choice in thinking mode\n+                tool_choice = input_kwargs.get(\"tool_choice\")\n+                forced = getattr(tool_choice, \"mode\", None) == tool_name\n+                input_kwargs[\"tool_choice\"] = ToolChoice(\n+                    mode=tool_name if forced else \"auto\",\n+                    tools=[tool_name],\n+                )\n+            else:\n+                input_kwargs[\"tool_choice\"] = ToolChoice(mode=\"none\")\n \n         async for event in next_handler(**input_kwargs):\n             yield event\n", "test_patch": "diff --git a/tests/middleware_budget_test.py b/tests/middleware_budget_test.py\nindex 4dc0cc193b..5f1d470f64 100644\n--- a/tests/middleware_budget_test.py\n+++ b/tests/middleware_budget_test.py\n@@ -3,8 +3,10 @@\n from typing import Any, AsyncGenerator, Callable\n from unittest.async_case import IsolatedAsyncioTestCase\n \n+from pydantic import BaseModel\n+\n from utils import MockModel\n-from agentscope.agent import Agent\n+from agentscope.agent import Agent, ReActConfig\n from agentscope.message import UserMsg, TextBlock, ToolCallBlock, HintBlock\n from agentscope.middleware import MiddlewareBase, ReplyBudgetControlMiddleware\n from agentscope.model import ChatResponse, ChatUsage\n@@ -18,7 +20,7 @@\n     ReplyEndEvent,\n     UserConfirmResultEvent,\n )\n-from agentscope.tool import ToolBase, Toolkit, ToolChunk\n+from agentscope.tool import ToolBase, Toolkit, ToolChoice, ToolChunk\n \n \n def _response(\n@@ -94,6 +96,44 @@ async def __call__(self, **kwargs: Any) -> ToolChunk:\n         return ToolChunk(content=[TextBlock(text=\"confirmed result\")])\n \n \n+class Answer(BaseModel):\n+    \"\"\"The structured output schema used in the tests.\"\"\"\n+\n+    city: str\n+\n+\n+class ToolChoiceModel(MockModel):\n+    \"\"\"Model that follows ``tool_choice`` as a provider does: text only\n+    under ``\"none\"``. The first call runs the dummy tool for 300 tokens.\"\"\"\n+\n+    def __init__(self, calls_offered_tool: bool) -> None:\n+        \"\"\"Initialize the recorded tool choices.\"\"\"\n+        super().__init__()\n+        self.stream = False\n+        self.calls_offered_tool = calls_offered_tool\n+        self.tool_choices: list = []\n+\n+    async def _call_api(self, *args: Any, **kwargs: Any) -> ChatResponse:\n+        \"\"\"Record tool_choice and answer by it.\"\"\"\n+        tool_choice = kwargs.get(\"tool_choice\")\n+        self.tool_choices.append(tool_choice)\n+        mode = getattr(tool_choice, \"mode\", None)\n+        usage = ChatUsage(input_tokens=200, output_tokens=100, time=0.0)\n+        if len(self.tool_choices) == 1:\n+            block = ToolCallBlock(id=\"tc_1\", name=\"dummy\", input=\"{}\")\n+        elif mode == \"GenerateStructuredOutput\" or (\n+            mode != \"none\" and self.calls_offered_tool\n+        ):\n+            block = ToolCallBlock(\n+                id=f\"tc_{len(self.tool_choices)}\",\n+                name=\"GenerateStructuredOutput\",\n+                input='{\"city\": \"Paris\"}',\n+            )\n+        else:\n+            block = TextBlock(text=\"Paris\")\n+        return ChatResponse(content=[block], is_last=True, usage=usage)\n+\n+\n def _has_hint_block(msg: Any, hint_message: str) -> bool:\n     \"\"\"Return True if *msg* contains a HintBlock with *hint_message*.\"\"\"\n     content = getattr(msg, \"content\", None)\n@@ -535,3 +575,65 @@ async def test_token_accumulation_persists_across_hitl(self) -> None:\n             agent.state.middle_context[middleware_key],\n             {reply_id: 370},\n         )\n+\n+    async def test_budget_exceeded_keeps_structured_output_tool(self) -> None:\n+        \"\"\"A spent budget still lets a structured reply end.\"\"\"\n+        model = ToolChoiceModel(calls_offered_tool=True)\n+        agent = Agent(\n+            name=\"test_agent\",\n+            system_prompt=\"you are helpful\",\n+            model=model,\n+            toolkit=Toolkit(tools=[DummyTool()]),\n+            middlewares=[ReplyBudgetControlMiddleware(token_budget=300)],\n+        )\n+\n+        res = await agent.reply(\n+            UserMsg(\"user\", \"Capital of France?\"),\n+            structured_schema=Answer,\n+        )\n+\n+        self.assertEqual(res.structured_output, {\"city\": \"Paris\"})\n+        self.assertListEqual(\n+            model.tool_choices,\n+            [\n+                None,\n+                ToolChoice(\n+                    mode=\"auto\",\n+                    tools=[\"GenerateStructuredOutput\"],\n+                ),\n+            ],\n+        )\n+\n+    async def test_budget_exceeded_keeps_forced_structured_output(\n+        self,\n+    ) -> None:\n+        \"\"\"The agent's forced structured output call is kept.\"\"\"\n+        model = ToolChoiceModel(calls_offered_tool=False)\n+        agent = Agent(\n+            name=\"test_agent\",\n+            system_prompt=\"you are helpful\",\n+            model=model,\n+            toolkit=Toolkit(tools=[DummyTool()]),\n+            middlewares=[ReplyBudgetControlMiddleware(token_budget=300)],\n+            react_config=ReActConfig(max_iters=3),\n+        )\n+\n+        res = await agent.reply(\n+            UserMsg(\"user\", \"Capital of France?\"),\n+            structured_schema=Answer,\n+        )\n+\n+        self.assertEqual(res.structured_output, {\"city\": \"Paris\"})\n+        offered = ToolChoice(mode=\"auto\", tools=[\"GenerateStructuredOutput\"])\n+        self.assertListEqual(\n+            model.tool_choices,\n+            [\n+                None,\n+                offered,\n+                offered,\n+                ToolChoice(\n+                    mode=\"GenerateStructuredOutput\",\n+                    tools=[\"GenerateStructuredOutput\"],\n+                ),\n+            ],\n+        )\n", "problem_statement": "[Bug]: ReplyBudgetControlMiddleware blocks every tool after the budget, so a structured reply never ends\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nWhen the reply budget runs out, a reply that needs a structured output can never finish.\n\nOnce the token budget is spent, `ReplyBudgetControlMiddleware.on_reasoning` sets `tool_choice` to `\"none\"` on every reasoning step, in [`_budget.py:179-196`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33/src/agentscope/middleware/_budget.py#L179-L196). It also adds a hint that tells the model to answer \"without invoking any tools\". But a reply started with `structured_schema` can only end by calling the `GenerateStructuredOutput` tool.\n\nIn [`_agent.py:3580-3653`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33/src/agentscope/agent/_agent.py#L3580-L3653), `Agent._next_action` ignores a text answer while the structured output is missing. It asks for another round instead. At `max_iters` it forces the tool, and it gives up at `max_iters + structured_output_grace_iters`. The middleware overrides that forced choice too.\nSo after the budget runs out, the model is asked again and again with no tool allowed. The reply ends with `exceed_max_iters` and `structured_output=None`. With the default `ReActConfig`, that's 55 model calls, and 54 of them come after the budget was spent. The budget multiplies the cost it is meant to cap.\n\nYou get this with `Agent(middlewares=[ReplyBudgetControlMiddleware(...)])` and `agent.reply(msg, structured_schema=...)`. Both are exported and documented. The middleware's docstring says the agent should wrap up, in [`_budget.py:30-33`](https://github.com/agentscope-ai/agentscope/blob/78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33/src/agentscope/middleware/_budget.py#L30-L33). The budget tests never use a structured schema, and `MockModel` ignores `tool_choice`. So the loop doesn't show in `tests/middleware_budget_test.py`.\nI also tried it on a real model, Ollama 0.32.0 with `qwen3.5:2b` and `max_iters=4`. Ollama ignores `tool_choice`, but the model follows the hint. It answered in text five times, and the reply ended with no structured output.\n\nExpected: once the budget is spent, a reply that still owes a structured output can still call `GenerateStructuredOutput`. Only that tool is allowed, so the reply ends in one more call.\n\n### Error Messages\n\n```shell\nrequests: 55\ntool_choice sent: {'-': 1, 'none': 54}\ntools in the last request: ['lookup', 'GenerateStructuredOutput']\nfinished_reason: exceed_max_iters\nstructured_output: None\n```\n\n### Steps to Reproduce\n\nNo API key is needed. The real `openai` client talks to a fake Chat Completions endpoint behind `httpx.MockTransport`. Like the API, it can only answer with text when `tool_choice` is `\"none\"`. It runs in a few seconds.\n\n```python\nimport asyncio\nimport json\nfrom collections import Counter\n\nimport httpx\nfrom pydantic import BaseModel\n\nfrom agentscope.agent import Agent\nfrom agentscope.credential import OpenAICredential\nfrom agentscope.message import TextBlock, UserMsg\nfrom agentscope.middleware import ReplyBudgetControlMiddleware\nfrom agentscope.model import OpenAIChatModel\nfrom agentscope.tool import FunctionTool, ToolChunk, Toolkit\n\nrequests = []\n\n\nclass Answer(BaseModel):\n    city: str\n\n\ndef reply(message: dict, prompt_tokens: int) -> httpx.Response:\n    return httpx.Response(200, json={\n        \"id\": f\"chatcmpl-{len(requests)}\", \"object\": \"chat.completion\",\n        \"created\": 0, \"model\": \"gpt-4.1\",\n        \"choices\": [{\"index\": 0, \"message\": message,\n                     \"finish_reason\": \"stop\"}],\n        \"usage\": {\"prompt_tokens\": prompt_tokens, \"completion_tokens\": 20,\n                  \"total_tokens\": prompt_tokens + 20},\n    })\n\ndef tool_call(name: str, arguments: dict) -> dict:\n    return {\"role\": \"assistant\", \"content\": None, \"tool_calls\": [{\n        \"id\": f\"call_{len(requests)}\", \"type\": \"function\",\n        \"function\": {\"name\": name, \"arguments\": json.dumps(arguments)}}]}\n\ndef fake_openai(request: httpx.Request) -> httpx.Response:\n    # Behaves like the API: with tool_choice \"none\" it can only answer text\n    body = json.loads(request.content)\n    requests.append(body)\n    if len(requests) == 1:\n        return reply(tool_call(\"lookup\", {\"country\": \"France\"}), 1200)\n    if body.get(\"tool_choice\") == \"none\":\n        return reply({\"role\": \"assistant\", \"content\": \"Paris\"}, 1300)\n    return reply(tool_call(\"GenerateStructuredOutput\", {\"city\": \"Paris\"}), 1300)\n\nasync def lookup(country: str) -> ToolChunk:\n    \"\"\"Look up the capital of a country.\"\"\"\n    return ToolChunk(content=[TextBlock(text=\"Paris\")])\n\n\nasync def main() -> None:\n    model = OpenAIChatModel(\n        credential=OpenAICredential(api_key=\"sk-test\"),\n        model=\"gpt-4.1\",\n        stream=False,\n        client_kwargs={\"http_client\": httpx.AsyncClient(\n            transport=httpx.MockTransport(fake_openai))},\n    )\n    agent = Agent(\n        name=\"Friday\",\n        system_prompt=\"You are a helpful assistant.\",\n        model=model,\n        toolkit=Toolkit(tools=[FunctionTool(lookup, is_read_only=True)]),\n        middlewares=[ReplyBudgetControlMiddleware(token_budget=1000)],\n    )\n    res = await agent.reply(\n        UserMsg(\"user\", \"What is the capital of France?\"),\n        structured_schema=Answer,\n    )\n    print(\"requests:\", len(requests))\n    print(\"tool_choice sent:\",\n          dict(Counter(str(r.get(\"tool_choice\", \"-\")) for r in requests)))\n    print(\"tools in the last request:\",\n          [t[\"function\"][\"name\"] for t in requests[-1][\"tools\"]])\n    print(\"finished_reason:\", res.finished_reason)\n    print(\"structured_output:\", res.structured_output)\n\n\nasyncio.run(main())\n```\n\nRun with `python repro.py` on main at `78c4ec47`. The first call spends the budget on a `lookup` tool call. Every request after it carries `\"tool_choice\": \"none\"`. So the model can never call `GenerateStructuredOutput`, and the reply stops at `max_iters` plus the grace iterations.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at 78c4ec47), and 2.0.9 has the same code\n- Python Version: 3.12.3\n- OS: Linux (aarch64)\n- openai 3.19.2 for the reproduction\n- Ollama server 0.32.0 with qwen3.5:2b \n", "hints_text": "/assign\nThis issue is still being verified. Please comment again once it is confirmed, and it is yours.\n/assign\nIt's yours, @zaher-m. If there is no pull request and no word from you by 2026-10-13 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-09-29T17:58:58Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3025, "instance_id": "agentscope-ai__agentscope-3025", "issue_numbers": ["3024"], "base_commit": "78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33", "patch": "diff --git a/src/agentscope/app/_router/_mcp.py b/src/agentscope/app/_router/_mcp.py\nindex 697db23f2c..71b4fcdfd9 100644\n--- a/src/agentscope/app/_router/_mcp.py\n+++ b/src/agentscope/app/_router/_mcp.py\n@@ -7,11 +7,13 @@\n stays a separate, explicit act.\n \"\"\"\n from fastapi import APIRouter, Depends, HTTPException, status\n+from pydantic import ValidationError\n \n from ..deps import get_current_user_id, get_mcp_hubs, get_storage\n from ..hub import MCPHubBase\n from .._service import MCPRenderError, render_mcp\n from ..storage import StorageBase\n+from ...mcp import MCPClient\n from ._schema import MCPView, UpdateMCPRequest\n \n mcp_router = APIRouter(prefix=\"/mcp\", tags=[\"mcp\"])\n@@ -44,6 +46,12 @@ async def update_mcp(\n     sit anywhere in the config \u2014 inside a URL, a header, an env var \u2014 so\n     the card's template plus the merged answers is the only thing that\n     knows where to put it.\n+\n+    Raises:\n+        `HTTPException`: 404 if the MCP is not in the caller's library,\n+            400 if the MCP has no card to re-render from, 409 if the new\n+            name is taken, or 422 if the name is not made of\n+            ``[a-zA-Z0-9_-]``.\n     \"\"\"\n     record = await storage.get_mcp(user_id, mcp_id)\n     if record is None:\n@@ -90,7 +98,20 @@ async def update_mcp(\n         record.values = merged\n         record.version = card.version\n     elif body.name is not None:\n-        record.client.name = body.name\n+        # ``MCPClient`` checks its name in ``model_post_init``, which a\n+        # plain attribute assignment skips; rebuild the client through\n+        # ``model_validate`` so an illegal name is refused here. Stored\n+        # as-is it would fail the same check on the next read, turning\n+        # every route that loads the library into a 500.\n+        try:\n+            record.client = MCPClient.model_validate(\n+                {**record.client.model_dump(), \"name\": body.name},\n+            )\n+        except ValidationError as exc:\n+            raise HTTPException(\n+                status_code=status.HTTP_422_UNPROCESSABLE_CONTENT,\n+                detail=str(exc),\n+            ) from exc\n \n     if body.enabled is not None:\n         record.enabled = body.enabled\n", "test_patch": "diff --git a/tests/mcp_rename_test.py b/tests/mcp_rename_test.py\nnew file mode 100644\nindex 0000000000..b69db8d411\n--- /dev/null\n+++ b/tests/mcp_rename_test.py\n@@ -0,0 +1,128 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"MCP library rename test cases.\"\"\"\n+import tempfile\n+from typing import Any\n+from unittest import IsolatedAsyncioTestCase\n+\n+import fakeredis.aioredis\n+from fastapi.testclient import TestClient\n+\n+from agentscope.app import create_app\n+from agentscope.app.message_bus import RedisMessageBus\n+from agentscope.app.storage import MCPRecord, RedisStorage\n+from agentscope.app.workspace_manager import LocalWorkspaceManager\n+from agentscope.mcp import HttpMCPConfig, MCPClient\n+\n+HEADERS = {\"X-User-ID\": \"alice\"}\n+\n+\n+def _fake_storage() -> Any:\n+    \"\"\"Build a fakeredis-backed storage and message bus.\"\"\"\n+    redis = fakeredis.aioredis.FakeRedis(decode_responses=True)\n+\n+    class _Storage(RedisStorage):\n+        \"\"\"Storage sharing the in-memory client.\"\"\"\n+\n+        async def __aenter__(self) -> Any:\n+            self._client = redis\n+            return self\n+\n+        async def aclose(self) -> None:\n+            self._client = None\n+\n+    class _Bus(RedisMessageBus):\n+        \"\"\"Message bus sharing the in-memory client.\"\"\"\n+\n+        async def __aenter__(self) -> Any:\n+            self._client = redis\n+            return self\n+\n+        async def aclose(self) -> None:\n+            self._client = None\n+\n+    return _Storage(), _Bus()\n+\n+\n+class MCPLibraryRenameTest(IsolatedAsyncioTestCase):\n+    \"\"\"``PATCH /mcp/{mcp_id}`` must not store a name the library cannot\n+    load back.\"\"\"\n+\n+    def setUp(self) -> None:\n+        \"\"\"Start an app holding one installed MCP named ``echo``.\"\"\"\n+        # pylint: disable=consider-using-with\n+        workdir = self.enterContext(tempfile.TemporaryDirectory())\n+        self._storage, bus = _fake_storage()\n+        app = create_app(\n+            storage=self._storage,\n+            message_bus=bus,\n+            workspace_manager=LocalWorkspaceManager(workdir),\n+            enable_index_worker=False,\n+        )\n+        self._client = self.enterContext(TestClient(app))\n+\n+    async def asyncSetUp(self) -> None:\n+        \"\"\"Install the fixture MCP straight into storage.\"\"\"\n+        record = MCPRecord(\n+            user_id=\"alice\",\n+            client=MCPClient(\n+                name=\"echo\",\n+                is_stateful=False,\n+                mcp_config=HttpMCPConfig(url=\"https://example.com/mcp\"),\n+            ),\n+        )\n+        await self._storage.upsert_mcp(\"alice\", record)\n+        self._mcp_id = record.id\n+\n+    def _view(self, name: str) -> dict:\n+        \"\"\"The expected ``MCPView`` of the fixture MCP under *name*.\"\"\"\n+        return {\n+            \"id\": self._mcp_id,\n+            \"name\": name,\n+            \"is_stateful\": False,\n+            \"enabled\": True,\n+            \"display_name\": None,\n+            \"description\": \"\",\n+            \"tags\": [],\n+            \"author\": None,\n+            \"icon_url\": None,\n+            \"url\": None,\n+            \"hub_id\": None,\n+            \"card_id\": None,\n+            \"version\": None,\n+        }\n+\n+    async def test_rename_to_unloadable_name_is_rejected(self) -> None:\n+        \"\"\"A name ``MCPClient`` would refuse on load answers 422 and leaves\n+        the library readable.\"\"\"\n+        response = self._client.patch(\n+            f\"/mcp/{self._mcp_id}\",\n+            json={\"name\": \"io.github.upstash/context7\"},\n+            headers=HEADERS,\n+        )\n+        self.assertEqual(response.status_code, 422)\n+\n+        listing = self._client.get(\"/mcp\", headers=HEADERS)\n+        self.assertEqual(listing.status_code, 200)\n+        self.assertEqual(listing.json(), [self._view(\"echo\")])\n+\n+    async def test_rename_to_empty_name_is_rejected(self) -> None:\n+        \"\"\"An empty name is rejected rather than stored.\"\"\"\n+        response = self._client.patch(\n+            f\"/mcp/{self._mcp_id}\",\n+            json={\"name\": \"\"},\n+            headers=HEADERS,\n+        )\n+        self.assertEqual(response.status_code, 422)\n+\n+    async def test_legal_rename_persists(self) -> None:\n+        \"\"\"A name within ``[a-zA-Z0-9_-]+`` still renames the MCP.\"\"\"\n+        response = self._client.patch(\n+            f\"/mcp/{self._mcp_id}\",\n+            json={\"name\": \"echo_2\"},\n+            headers=HEADERS,\n+        )\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json(), self._view(\"echo_2\"))\n+\n+        listing = self._client.get(\"/mcp\", headers=HEADERS)\n+        self.assertEqual(listing.json(), [self._view(\"echo_2\")])\n", "problem_statement": "[Bug]: PATCH /mcp/{id} stores a name MCPClient rejects, making the whole library return 500\n## Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n## Background / Description\n\n`MCPClient` requires its `name` to match `[a-zA-Z0-9_-]+`, because the name is\nspliced into the model-facing tool name `mcp__{name}__{tool}`\n(`src/agentscope/tool/_adapters.py:247`). The check lives in\n`MCPClient.model_post_init` (`src/agentscope/mcp/_mcp_client.py:144-153`), and\nthe invariant is written down in plain text on the card model\n(`src/agentscope/app/hub/_mcp/_card.py:22-26`):\n\n> :attr:`name` is the default name of the *installed* client, which must match\n> ``[a-zA-Z0-9_-]+`` because it composes the model-facing tool name\n> ``mcp__{name}__{tool}``. Cards are not rejected for a bad name \u2014 **the install\n> call is**, so browsing a registry with odd slugs still works.\n\nThe hub layer slugs registry names to keep it true\n(`src/agentscope/app/hub/_mcp/_github_hub.py:341`, pinned by\n`tests/hub_github_test.py::test_name_is_slugged_for_the_mcp_client`).\n\n`PATCH /mcp/{mcp_id}` is the only write path that takes a caller-chosen name\nwithout building a client: `src/agentscope/app/_router/_mcp.py:93` is a bare\nattribute assignment.\n\n```python\nelif body.name is not None:\n    record.client.name = body.name\n```\n\nPydantic does not run `model_post_init` on attribute assignment\n(`validate_assignment` is off), so the illegal name is accepted and persisted by\n`storage.upsert_mcp`. Reading the record back *does* construct an `MCPClient`, so\nevery route that loads the library now raises.\n\nThis is not cosmetic: the poisoned record makes the library unrecoverable through\nthe API, because `PATCH` and `DELETE` both read it first \u2014 `update_mcp` calls\n`storage.get_mcp` (`_router/_mcp.py:51`) and `RedisStorage.delete_mcp` calls\n`self.get_mcp` before deleting anything\n(`src/agentscope/app/storage/_redis_storage.py:556`, whose `MCPRecord.model_validate_json`\nat `:532` is what raises).\n\n**Actual vs expected**, one run of the script below on `main` at `78c4ec47`:\n\n```\n1) GET /mcp before        -> 200\n2) PATCH illegal name     -> 200  stored name = 'bad name/../x'\n3) GET /mcp after         -> 500\n4) PATCH back to 'echo'   -> 500\n5) DELETE the record      -> 500\n6) GET /mcp again         -> 500\n```\n\nExpected: the rename is refused at write time, the way the sibling write paths\nalready refuse it. Both other ways a caller-chosen name reaches `MCPClient` go\nthrough its constructor, so the same check fires there \u2014 installing renders\n`render_mcp` \u2192 `MCPClient(...)` (and a rename *with* `values`,\n`_router/_mcp.py:78-82`, re-renders through that same call). Verified on the\nsame checkout with the card from `tests/hub_card_test.py`:\n\n```\n1) MCPClient(name='bad name/../x')   -> ValidationError (model_post_init fires)\n2) render_mcp(card, {}, 'bad name/../x')\n                                    -> MCPRenderError: MCP 'echo' produced an invalid client: \u2026\n3) client.name = 'bad name/../x'     -> accepted silently, stored name = 'bad name/../x'\n   MCPClient.model_validate(client.model_dump())\n                                    -> ValidationError  # this is what every read does\n```\n\nOnly the bare-rename branch skips the check, which reads as an omission rather\nthan a design decision \u2014 and no test covers `PATCH /mcp/{id}` today (`grep -rn\n'\\.patch(' tests/*.py | grep -i mcp` returns nothing), so nothing pins the\ncurrent behaviour either.\n\nThe repo has already written down this exact lesson for the same class of\nfailure in `src/agentscope/app/_router/_agent.py:254-267`, where the comment\nreads *\"``model_copy(update=...)`` skips validators; re-run\n``AgentData.model_validate`` on the merged shape\"* and the route answers 422 for\na stored-but-invalid record. `PATCH /mcp/{id}` is the one route that never got\nthat treatment. #2742 (`PATCH /channels/{id}` with an explicit null) is the same\nshape and was confirmed.\n\n## Error Messages\n\n```\n$ python repro.py\n1) GET /mcp before        -> 200\n2) PATCH illegal name     -> 200  stored name = 'bad name/../x'\n3) GET /mcp after         -> 500\n4) PATCH back to 'echo'   -> 500\n5) DELETE the record      -> 500\n6) GET /mcp again         -> 500\n   raw record still in redis: '{\"id\":\"9c6a29ec3b974bba9621cd0df4f048c3\",...,\"client\":{\"name\"\n\nTraceback (most recent call last):\n  File \".../src/agentscope/app/_router/_mcp.py\", line 26, in list_mcps\n    records = await storage.list_mcps(user_id)\n  File \".../src/agentscope/app/storage/_redis_storage.py\", line 521, in list_mcps\n    records.append(MCPRecord.model_validate_json(raw))\npydantic_core._pydantic_core.ValidationError: 1 validation error for MCPRecord\nclient\n  Value error, MCPClient name 'bad name/../x' contains characters not allowed by\n  LLM providers (only [a-zA-Z0-9_-] are permitted). Please rename it.\n  [type=value_error, input_value={'name': 'bad name/../x',...xecution_timeout': None}, input_type=dict]\n```\n\nThe script needs no network and no Redis server \u2014 it uses `fakeredis`, which\n`.[dev]` already installs.\n\n## Steps to Reproduce\n\n1. Code (`repro.py`, from a checkout of `main`):\n\n```python\n# -*- coding: utf-8 -*-\n\"\"\"Rename an installed MCP through PATCH /mcp/{id} to a name MCPClient\nitself refuses, then show that no route can read, repair, or delete it.\"\"\"\nimport asyncio\nimport tempfile\n\nimport fakeredis.aioredis\nfrom fastapi.testclient import TestClient\n\nfrom agentscope.app import create_app\nfrom agentscope.app.message_bus import RedisMessageBus\nfrom agentscope.app.storage import MCPRecord, RedisStorage\nfrom agentscope.app.workspace_manager import LocalWorkspaceManager\nfrom agentscope.mcp import HttpMCPConfig, MCPClient\n\nHEADERS = {\"X-User-ID\": \"alice\"}\nREDIS = fakeredis.aioredis.FakeRedis(decode_responses=True)\n\n\nclass _Storage(RedisStorage):\n    \"\"\"Redis storage on the shared in-memory client.\"\"\"\n\n    async def __aenter__(self):\n        self._client = REDIS\n        return self\n\n    async def aclose(self):\n        self._client = None\n\n\nclass _Bus(RedisMessageBus):\n    \"\"\"Message bus on the shared in-memory client.\"\"\"\n\n    async def __aenter__(self):\n        self._client = REDIS\n        return self\n\n    async def aclose(self):\n        self._client = None\n\n\nasync def _seed(storage: _Storage) -> str:\n    \"\"\"Install one MCP named ``echo`` and return its record id.\"\"\"\n    record = MCPRecord(\n        user_id=\"alice\",\n        client=MCPClient(\n            name=\"echo\",\n            is_stateful=False,\n            mcp_config=HttpMCPConfig(url=\"https://example.com/mcp\"),\n        ),\n    )\n    await storage.upsert_mcp(\"alice\", record)\n    return record.id\n\n\ndef main() -> None:\n    \"\"\"Poison the name, then try every API route that could recover.\"\"\"\n    storage, bus = _Storage(), _Bus()\n    with tempfile.TemporaryDirectory() as workdir:\n        app = create_app(\n            storage=storage,\n            message_bus=bus,\n            workspace_manager=LocalWorkspaceManager(workdir),\n            enable_index_worker=False,\n        )\n        with TestClient(app, raise_server_exceptions=False) as client:\n            mcp_id = asyncio.run(_seed(storage))\n\n            before = client.get(\"/mcp\", headers=HEADERS)\n            print(\"1) GET /mcp before        ->\", before.status_code)\n\n            patch = client.patch(\n                f\"/mcp/{mcp_id}\",\n                json={\"name\": \"bad name/../x\"},\n                headers=HEADERS,\n            )\n            print(\n                \"2) PATCH illegal name     -> %s  stored name = %r\"\n                % (patch.status_code, patch.json().get(\"name\")),\n            )\n\n            after = client.get(\"/mcp\", headers=HEADERS)\n            print(\"3) GET /mcp after         ->\", after.status_code)\n\n            repair = client.patch(\n                f\"/mcp/{mcp_id}\",\n                json={\"name\": \"echo\"},\n                headers=HEADERS,\n            )\n            print(\"4) PATCH back to 'echo'   ->\", repair.status_code)\n\n            remove = client.delete(f\"/mcp/{mcp_id}\", headers=HEADERS)\n            print(\"5) DELETE the record      ->\", remove.status_code)\n\n            still = client.get(\"/mcp\", headers=HEADERS)\n            print(\"6) GET /mcp again         ->\", still.status_code)\n\n            raw = asyncio.run(\n                REDIS.get(f\"agentscope:user:alice:mcp:{mcp_id}\"),\n            )\n            print(\"   raw record still in redis:\", repr(raw)[:160])\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n2. Run:\n\n```bash\npip install -e \".[dev]\"\npython repro.py\n```\n\n3. See the output above: step 2 answers 200, and steps 3\u20136 all answer 500.\n\n## Environment\n\n- AgentScope Version: 2.0.10dev (main @ `78c4ec47`)\n- Python Version: 3.12.12\n- OS: macOS 15.6 arm64\n\n", "hints_text": "", "created_at": "2026-09-29T17:16:34Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3023, "instance_id": "agentscope-ai__agentscope-3023", "issue_numbers": ["3022"], "base_commit": "78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33", "patch": "diff --git a/src/agentscope/middleware/_tracing/_attributes.py b/src/agentscope/middleware/_tracing/_attributes.py\nindex 26992cfcb9..f9d06a2e12 100644\n--- a/src/agentscope/middleware/_tracing/_attributes.py\n+++ b/src/agentscope/middleware/_tracing/_attributes.py\n@@ -189,6 +189,9 @@ class ProviderNameValues:\n     MOONSHOT = \"moonshot\"\n     \"\"\"The moonshot provider name.\"\"\"\n \n+    MINIMAX = \"minimax\"\n+    \"\"\"The MiniMax provider name.\"\"\"\n+\n     VOLCENGINE = \"volcengine\"\n     \"\"\"The Volcengine provider name.\"\"\"\n \ndiff --git a/src/agentscope/middleware/_tracing/_extractor.py b/src/agentscope/middleware/_tracing/_extractor.py\nindex a46b5b8e2c..96ad84c61a 100644\n--- a/src/agentscope/middleware/_tracing/_extractor.py\n+++ b/src/agentscope/middleware/_tracing/_extractor.py\n@@ -31,6 +31,7 @@\n     \"deepseek\": ProviderNameValues.DEEPSEEK,\n     \"xai\": ProviderNameValues.XAI,\n     \"moonshot\": ProviderNameValues.MOONSHOT,\n+    \"minimax\": ProviderNameValues.MINIMAX,\n     \"volcengine\": ProviderNameValues.VOLCENGINE,\n }\n \n", "test_patch": "diff --git a/tests/tracing_test.py b/tests/tracing_test.py\nindex 89301a35dc..5d51a3ca4d 100644\n--- a/tests/tracing_test.py\n+++ b/tests/tracing_test.py\n@@ -16,7 +16,11 @@\n from utils import MockModel\n \n from agentscope.agent import Agent, InjectionConfig\n-from agentscope.credential import OpenAICredential, VolcengineCredential\n+from agentscope.credential import (\n+    MiniMaxCredential,\n+    OpenAICredential,\n+    VolcengineCredential,\n+)\n from agentscope.event import (\n     ConfirmResult,\n     ExternalExecutionResultEvent,\n@@ -40,6 +44,7 @@\n     ChatResponse,\n     ChatUsage,\n     FinishedReason,\n+    MiniMaxChatModel,\n     OpenAIChatModel,\n     VolcengineChatModel,\n )\n@@ -162,6 +167,17 @@ def test_volcengine_provider_name_from_model_class(self) -> None:\n \n         self.assertEqual(_get_provider_name(model), \"volcengine\")\n \n+    def test_minimax_provider_name_from_model_class(self) -> None:\n+        \"\"\"MiniMax models should use the MiniMax provider name, not\n+        ``unknown`` \u2014 MiniMax subclasses the Anthropic model, so its class\n+        name is the only thing that identifies it.\"\"\"\n+        model = MiniMaxChatModel(\n+            credential=MiniMaxCredential(api_key=\"test\"),\n+            model=\"abab6.5s-chat\",\n+        )\n+\n+        self.assertEqual(_get_provider_name(model), \"minimax\")\n+\n     def test_volcengine_provider_name_from_openai_base_url(self) -> None:\n         \"\"\"Ark's OpenAI-compatible endpoint should map to Volcengine.\"\"\"\n         model = OpenAIChatModel(\n", "problem_statement": "Tracing reports gen_ai.provider.name = unknown for MiniMax models\n## Prerequisites\n\n- [x] I have searched the existing issues, pull requests, and discussions, and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n## Background / Description\n\n`_get_provider_name` maps a chat model's class name to an OpenTelemetry\nGenAI provider name, and every shipped model resolves except MiniMax:\n\n```text\nAnthropicChatModel  -> anthropic\nDashScopeChatModel  -> dashscope\nDeepSeekChatModel   -> deepseek\nGeminiChatModel     -> gcp.gemini\nMiniMaxChatModel    -> unknown      <--\nMoonshotChatModel   -> moonshot\nOllamaChatModel     -> ollama\nVolcengineChatModel -> volcengine\nXAIChatModel        -> xai\n```\n\nMiniMax support landed in #1764, but `_CLASS_NAME_MAP` was never given\na `minimax` entry and `ProviderNameValues` has no `MINIMAX` member, so\nevery chat span from a `MiniMaxChatModel` carries\n`gen_ai.provider.name = \"unknown\"`. Any dashboard, cost report or filter\nkeyed on the provider silently drops MiniMax traffic.\n\n`MiniMaxChatModel` subclasses `AnthropicChatModel` (MiniMax's API is\nAnthropic-compatible), so its class name is the only thing that\nidentifies it \u2014 the base-URL branch below the map is not even reached.\n\n## Steps to Reproduce\n\n```python\nfrom agentscope.credential import MiniMaxCredential\nfrom agentscope.model import MiniMaxChatModel\nfrom agentscope.middleware._tracing._extractor import _get_provider_name\n\nmodel = MiniMaxChatModel(\n    credential=MiniMaxCredential(api_key=\"test\"),\n    model=\"abab6.5s-chat\",\n)\nprint(_get_provider_name(model))  # \"unknown\", expected \"minimax\"\n```\n\n## Proposed fix\n\nAdd `MINIMAX = \"minimax\"` to `ProviderNameValues` and a `\"minimax\"`\nentry to `_CLASS_NAME_MAP`, mirroring how Moonshot and Volcengine are\ndeclared, plus a test next to the existing Volcengine one.\n\nI have this implemented and will link the PR.\n\n## Environment\n\n- AgentScope Version: 2.0.10dev (main at `78c4ec47`)\n- Python Version: 3.11\n- OS: Linux\n\n", "hints_text": "", "created_at": "2026-09-29T15:07:56Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3021, "instance_id": "agentscope-ai__agentscope-3021", "issue_numbers": ["3020"], "base_commit": "78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33", "patch": "diff --git a/src/agentscope/rag/_parser/_excel.py b/src/agentscope/rag/_parser/_excel.py\nindex 7e02149ade..2c3e332e92 100644\n--- a/src/agentscope/rag/_parser/_excel.py\n+++ b/src/agentscope/rag/_parser/_excel.py\n@@ -237,7 +237,7 @@ async def parse(\n             `FileNotFoundError`: If ``file`` is a ``str`` pointing to\n                 a path that does not exist.\n             `ImportError`: If :mod:`pandas` is not installed.\n-            `ValueError`: If the bytes cannot be parsed.\n+            `ValueError`: If the workbook or any worksheet cannot be parsed.\n         \"\"\"\n         try:\n             import pandas as pd\n@@ -319,8 +319,9 @@ def _parse_sheet(\n                 keep_default_na=False,\n             )\n         except Exception as e:\n-            logger.warning(\"Failed to parse sheet '%s': %s\", sheet_name, e)\n-            return sheet_sections\n+            raise ValueError(\n+                f\"Failed to parse sheet {sheet_name!r} in {filename!r}: {e}\",\n+            ) from e\n \n         # Keep the first row as cell data: pandas column labels would rename\n         # duplicate headers and replace blank headers with \"Unnamed: ...\".\n", "test_patch": "diff --git a/tests/rag_parser_test.py b/tests/rag_parser_test.py\nindex 212d5ed6fa..4e5a896352 100644\n--- a/tests/rag_parser_test.py\n+++ b/tests/rag_parser_test.py\n@@ -1110,6 +1110,38 @@ async def test_nested_group_shape_text_is_read(self) -> None:\n class ExcelParserTest(IsolatedAsyncioTestCase):\n     \"\"\"Behavioural coverage for :class:`ExcelParser`.\"\"\"\n \n+    async def test_corrupt_sheet_does_not_return_partial_content(self) -> None:\n+        \"\"\"A deferred worksheet error fails the whole workbook parse.\"\"\"\n+        from xml.etree.ElementTree import ParseError\n+\n+        xlsx_bytes = _make_xlsx_simple(\n+            {\n+                \"Good\": [[\"Key\"], [\"visible\"]],\n+                \"Broken\": [[\"Key\"], [\"must not disappear\"]],\n+            },\n+        )\n+        buffer = io.BytesIO()\n+        with zipfile.ZipFile(io.BytesIO(xlsx_bytes)) as source:\n+            with zipfile.ZipFile(buffer, \"w\") as target:\n+                for entry in source.infolist():\n+                    data = source.read(entry.filename)\n+                    if entry.filename == \"xl/worksheets/sheet2.xml\":\n+                        data = data.replace(\n+                            b\"</sheetData>\",\n+                            b\"</brokenSheetData>\",\n+                        )\n+                    target.writestr(entry, data)\n+\n+        for separate_sheet in (False, True):\n+            with self.subTest(separate_sheet=separate_sheet):\n+                parser = ExcelParser(separate_sheet=separate_sheet)\n+                with self.assertRaisesRegex(\n+                    ValueError,\n+                    \"Failed to parse sheet 'Broken' in 'corrupt.xlsx'\",\n+                ) as raised:\n+                    await parser.parse(buffer.getvalue(), \"corrupt.xlsx\")\n+                self.assertIsInstance(raised.exception.__cause__, ParseError)\n+\n     async def test_duplicate_and_blank_headers(self) -> None:\n         \"\"\"Headers remain cell values, without pandas-generated labels.\"\"\"\n         from openpyxl import Workbook\n", "problem_statement": "[Bug]: ExcelParser returns partial content when a worksheet cannot be read\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nExcelParser.parse() can return a successful, incomplete result for an XLSX whose workbook metadata is readable but whose worksheet XML is malformed. The error occurs during the deferred ExcelFile.parse() call, after pd.ExcelFile() has opened the workbook.\n\nOn main at 78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33, _parse_sheet() logs the error and returns an empty list. A workbook containing a readable Good sheet and an unreadable Broken sheet therefore returns only Good without raising. The indexing worker can subsequently index that partial result and mark the document ready.\n\nExpected: raise ValueError identifying the workbook and failed worksheet, preserving the original exception as its cause. I would like to submit a small fix and a real XLSX regression test covering both separate_sheet modes. An explicit recovery mode with skipped-sheet metadata would be an alternative, but the current list[Section] result does not indicate incompleteness.\n\nThe earlier #2881 normalizes workbook-opening errors; this deferred worksheet error still reaches a separate empty-list fallback. This report and the proposed fix were prepared with Codex assistance and verified locally.\n\n### Error Messages\n\n```shell\nWarning excerpt: Failed to parse sheet 'Broken': mismatched tag\n\nBoth separate_sheet=False and separate_sheet=True return one section containing Good. Broken is absent and no exception reaches the caller.\n\nA regression test expecting ValueError fails against the original implementation in both modes with: AssertionError: ValueError not raised\n```\n\n### Steps to Reproduce\n\nInstall agentscope[rag], save the following as reproduce.py, and run python reproduce.py. No API key or external service is required.\n\n```python\nimport asyncio\nimport io\nimport zipfile\n\nfrom openpyxl import Workbook\nfrom agentscope.rag import ExcelParser\n\nworkbook = Workbook()\nworkbook.active.title = \"Good\"\nworkbook.active.append([\"Key\"])\nworkbook.active.append([\"visible\"])\nbroken = workbook.create_sheet(\"Broken\")\nbroken.append([\"Key\"])\nbroken.append([\"must not disappear\"])\noriginal = io.BytesIO()\nworkbook.save(original)\nworkbook.close()\n\ncorrupt = io.BytesIO()\nwith zipfile.ZipFile(io.BytesIO(original.getvalue())) as source:\n    with zipfile.ZipFile(corrupt, \"w\") as target:\n        for entry in source.infolist():\n            data = source.read(entry.filename)\n            if entry.filename == \"xl/worksheets/sheet2.xml\":\n                assert b\"</sheetData>\" in data\n                data = data.replace(b\"</sheetData>\", b\"</brokenSheetData>\")\n            target.writestr(entry, data)\n\n\nasync def main():\n    for separate_sheet in (False, True):\n        parser = ExcelParser(separate_sheet=separate_sheet)\n        try:\n            sections = await parser.parse(corrupt.getvalue(), \"corrupt.xlsx\")\n        except ValueError as error:\n            print(f\"separate_sheet={separate_sheet}: {error}\")\n        else:\n            print(f\"separate_sheet={separate_sheet}: returned {len(sections)} section(s)\")\n            print(sections[0].content.text)\n\n\nasyncio.run(main())\n```\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at 78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33)\n- Python Version: 3.11.15\n- OS: macOS, arm64\n- pandas: 3.0.6\n- openpyxl: 3.1.5\n", "hints_text": "", "created_at": "2026-09-29T14:47:16Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3015, "instance_id": "agentscope-ai__agentscope-3015", "issue_numbers": ["3014"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/tool/_builtin/_write.py b/src/agentscope/tool/_builtin/_write.py\nindex 4b016c7613..54f3910af9 100644\n--- a/src/agentscope/tool/_builtin/_write.py\n+++ b/src/agentscope/tool/_builtin/_write.py\n@@ -2,7 +2,6 @@\n \"\"\"The write tool in agentscope.\"\"\"\n import difflib\n import fnmatch\n-from pathlib import Path\n from typing import Any, List\n \n from .._base import ToolBase, ToolMiddlewareBase\n@@ -292,12 +291,6 @@ async def call(  # type: ignore[override]\n                 # render a best-effort \"add\" diff in the UI.\n                 previous_content = \"\"\n \n-        # Create parent directories if they don't exist\n-        parent_dir = Path(file_path).parent\n-        await self._backend.exec_shell(\n-            [\"mkdir\", \"-p\", str(parent_dir)],\n-        )\n-\n         # Write content to file (backend handles parent dir creation)\n         await self._backend.write_file(\n             file_path,\n", "test_patch": "", "problem_statement": "Write spawns a redundant mkdir -p, with host path semantics, before every write\n## Background / Description\n\n`Write.call` shells out to `mkdir -p` for the target's parent directory before every write:\n\n```python\n# src/agentscope/tool/_builtin/_write.py\nparent_dir = Path(file_path).parent\nawait self._backend.exec_shell([\"mkdir\", \"-p\", str(parent_dir)])\n\n# Write content to file (backend handles parent dir creation)\nawait self._backend.write_file(file_path, content.encode(\"utf-8\"))\n```\n\nThe comment on the next line already states the reality: parent creation is the backend's job. Every `write_file` implementation does it \u2014 `LocalBackend` with `os.makedirs`, and each sandbox backend (`docker`, `k8s`, `e2b`, `daytona`, `applecontainer`, `bubblewrap`, `opensandbox`) with its own `mkdir -p` / `container cp` / `put_archive` step. So the call is a wasted subprocess on every write, and the result is discarded \u2014 including its failure.\n\nIt is worse than wasted on Windows hosts: `Path(file_path).parent` uses the *host's* path semantics, while the path belongs to the backend's environment. A Windows host driving a POSIX sandbox passes `\\workspace\\x` to `mkdir -p` inside a Linux container, which creates a directory literally named `\\workspace\\x` in the working directory instead of the intended parent.\n\n## Proposed fix\n\nDrop the call and let the backend do what it already does, as the adjacent comment says. `tests/builtin_write_test.py::test_write_creates_directory` already covers that parent directories appear, so no behavior is lost; I am adding a test that records the commands a write issues and asserts none of them is a `mkdir`.\n\n## Checklist\n\n- [x] Searched existing issues\n- [x] Single focused fix\n- [x] Will add tests\n\n", "hints_text": "", "created_at": "2026-09-29T11:51:48Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3011, "instance_id": "agentscope-ai__agentscope-3011", "issue_numbers": ["2971"], "base_commit": "78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33", "patch": "diff --git a/src/agentscope/model/_ollama/_model.py b/src/agentscope/model/_ollama/_model.py\nindex 0bc8ff69e5..63e205222c 100644\n--- a/src/agentscope/model/_ollama/_model.py\n+++ b/src/agentscope/model/_ollama/_model.py\n@@ -272,10 +272,11 @@ async def _parse_stream_response(\n                     text=msg.content,\n                 )\n \n-            # Tool call\n-            for idx, tool_call in enumerate(msg.tool_calls or []):\n+            # Tool call. The ollama client drops the server's call id, and\n+            # one built from the position repeats in the next round\n+            for tool_call in msg.tool_calls or []:\n                 delta_res.append_tool_call(\n-                    block_id=f\"{idx}_{tool_call.function.name}\",\n+                    block_id=_generate_id(),\n                     name=tool_call.function.name,\n                     input=json.dumps(\n                         tool_call.function.arguments,\n@@ -318,10 +319,10 @@ async def _parse_completion_response(\n         if response.message.content:\n             content_blocks.append(TextBlock(text=response.message.content))\n \n-        for idx, tool_call in enumerate(response.message.tool_calls or []):\n+        for tool_call in response.message.tool_calls or []:\n             content_blocks.append(\n                 ToolCallBlock(\n-                    id=f\"{idx}_{tool_call.function.name}\",\n+                    id=_generate_id(),\n                     name=tool_call.function.name,\n                     input=json.dumps(\n                         tool_call.function.arguments,\n", "test_patch": "diff --git a/tests/model_ollama_test.py b/tests/model_ollama_test.py\nindex a357b2d251..03d091c385 100644\n--- a/tests/model_ollama_test.py\n+++ b/tests/model_ollama_test.py\n@@ -11,11 +11,13 @@\n from unittest import IsolatedAsyncioTestCase\n from unittest.mock import AsyncMock, MagicMock\n \n+import httpx\n from utils import AnyString\n \n-from agentscope.message import TextBlock, ToolCallBlock, ThinkingBlock\n+from agentscope.agent import Agent\n+from agentscope.message import TextBlock, ToolCallBlock, ThinkingBlock, UserMsg\n from agentscope.model import OllamaChatModel\n-from agentscope.tool import ToolChoice\n+from agentscope.tool import FunctionTool, ToolChoice, ToolChunk, Toolkit\n \n A = AnyString()\n \n@@ -158,7 +160,7 @@ async def test_tool_call_response(self) -> None:\n                 True,\n                 [\n                     ToolCallBlock.model_construct(\n-                        id=\"0_get_weather\",\n+                        id=A,\n                         created_at=A,\n                         name=\"get_weather\",\n                         input=json.dumps({\"city\": \"SH\"}),\n@@ -330,7 +332,7 @@ async def test_stream_tool_call(self) -> None:\n         responses = [r async for r in gen]\n \n         tool_block = ToolCallBlock.model_construct(\n-            id=\"0_search\",\n+            id=A,\n             created_at=A,\n             name=\"search\",\n             input=json.dumps({\"q\": \"hello\"}),\n@@ -399,3 +401,147 @@ def test_tools_filtered(self) -> None:\n         self.assertEqual(len(fmt_tools), 1)\n         self.assertEqual(fmt_tools[0][\"function\"][\"name\"], \"get_weather\")\n         self.assertIsNone(fmt_choice)\n+\n+\n+def _api_chat_transport(\n+    messages: list[dict | list[dict]],\n+    stream: bool,\n+) -> httpx.MockTransport:\n+    \"\"\"Fake ``/api/chat``; a list streams as chunks.\"\"\"\n+    replies = iter(messages)\n+\n+    def handler(_request: httpx.Request) -> httpx.Response:\n+        message = next(replies)\n+        body = {\n+            \"model\": \"qwen3:8b\",\n+            \"created_at\": \"2026-09-28T00:00:00Z\",\n+            \"message\": message,\n+            \"done\": True,\n+            \"done_reason\": \"stop\",\n+            \"prompt_eval_count\": 10,\n+            \"eval_count\": 5,\n+        }\n+        if not stream:\n+            return httpx.Response(200, json=body)\n+        chunks = [\n+            {**body, \"message\": _, \"done\": False, \"done_reason\": None}\n+            for _ in (message if isinstance(message, list) else [message])\n+        ]\n+        chunks.append(\n+            {**body, \"message\": {\"role\": \"assistant\", \"content\": \"\"}},\n+        )\n+        return httpx.Response(\n+            200,\n+            content=\"\".join(json.dumps(_) + \"\\n\" for _ in chunks),\n+            headers={\"content-type\": \"application/x-ndjson\"},\n+        )\n+\n+    return httpx.MockTransport(handler)\n+\n+\n+def _weather_call(city: str, index: int = 0) -> dict:\n+    \"\"\"A ``get_weather`` call as Ollama sends it.\"\"\"\n+    return {\n+        \"role\": \"assistant\",\n+        \"content\": \"\",\n+        \"tool_calls\": [\n+            {\n+                \"id\": f\"call_{city.lower()}\",\n+                \"function\": {\n+                    \"index\": index,\n+                    \"name\": \"get_weather\",\n+                    \"arguments\": {\"city\": city},\n+                },\n+            },\n+        ],\n+    }\n+\n+\n+class TestOllamaRepeatedToolCall(IsolatedAsyncioTestCase):\n+    \"\"\"Repeated tool calls within one reply.\"\"\"\n+\n+    async def _reply(\n+        self,\n+        stream: bool,\n+        messages: list[dict | list[dict]],\n+    ) -> tuple[list[str], Any]:\n+        \"\"\"Run one reply.\"\"\"\n+        cities: list[str] = []\n+\n+        async def get_weather(city: str) -> ToolChunk:\n+            \"\"\"Get the weather.\"\"\"\n+            cities.append(city)\n+            return ToolChunk(content=[TextBlock(text=f\"sunny in {city}\")])\n+\n+        model = OllamaChatModel(\n+            model=\"qwen3:8b\",\n+            stream=stream,\n+            client_kwargs={\n+                \"transport\": _api_chat_transport(messages, stream),\n+            },\n+        )\n+        agent = Agent(\n+            name=\"Friday\",\n+            system_prompt=\"You are a helpful assistant.\",\n+            model=model,\n+            toolkit=Toolkit(\n+                tools=[FunctionTool(get_weather, is_read_only=True)],\n+            ),\n+        )\n+        await agent.reply(UserMsg(\"user\", \"Paris, then London?\"))\n+        return cities, agent.state.context[-1]\n+\n+    async def test_same_tool_in_two_rounds(self) -> None:\n+        \"\"\"Both calls run and pair with their results.\"\"\"\n+        for stream in (False, True):\n+            with self.subTest(stream=stream):\n+                cities, msg = await self._reply(\n+                    stream,\n+                    [\n+                        _weather_call(\"Paris\"),\n+                        _weather_call(\"London\"),\n+                        {\"role\": \"assistant\", \"content\": \"Sunny.\"},\n+                    ],\n+                )\n+\n+                calls = msg.get_content_blocks(\"tool_call\")\n+                results = msg.get_content_blocks(\"tool_result\")\n+                self.assertListEqual(cities, [\"Paris\", \"London\"])\n+                self.assertListEqual(\n+                    [(_.name, json.loads(_.input)) for _ in calls],\n+                    [\n+                        (\"get_weather\", {\"city\": \"Paris\"}),\n+                        (\"get_weather\", {\"city\": \"London\"}),\n+                    ],\n+                )\n+                self.assertNotEqual(calls[0].id, calls[1].id)\n+                self.assertListEqual(\n+                    [_.id for _ in results],\n+                    [_.id for _ in calls],\n+                )\n+\n+    async def test_same_tool_in_two_chunks(self) -> None:\n+        \"\"\"Parallel calls in two chunks both run.\"\"\"\n+        cities, msg = await self._reply(\n+            True,\n+            [\n+                [_weather_call(\"Paris\", 0), _weather_call(\"London\", 1)],\n+                {\"role\": \"assistant\", \"content\": \"Sunny.\"},\n+            ],\n+        )\n+\n+        calls = msg.get_content_blocks(\"tool_call\")\n+        results = msg.get_content_blocks(\"tool_result\")\n+        self.assertCountEqual(cities, [\"Paris\", \"London\"])\n+        self.assertListEqual(\n+            [(_.name, json.loads(_.input)) for _ in calls],\n+            [\n+                (\"get_weather\", {\"city\": \"Paris\"}),\n+                (\"get_weather\", {\"city\": \"London\"}),\n+            ],\n+        )\n+        self.assertNotEqual(calls[0].id, calls[1].id)\n+        self.assertCountEqual(\n+            [_.id for _ in results],\n+            [_.id for _ in calls],\n+        )\n", "problem_statement": "[Bug]: OllamaChatModel reuses tool call ids, so a tool called again in the same reply never runs\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nWhen the model calls the same tool twice in one reply, the second call never runs.\n\n`OllamaChatModel` makes up its own tool call ids, in [`_ollama/_model.py:276-278`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/model/_ollama/_model.py#L276-L278) and [`:321-324`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/model/_ollama/_model.py#L321-L324). It builds each id from the call's position in the response and the tool name, like `0_get_weather`. The Ollama server does send a real id with each call, but the `ollama` Python client 0.6.2 drops it. So the first call in every response gets the same id.\n\nIn [`_state.py:310-316`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/state/_state.py#L310-L316), the agent keeps all the rounds of a reply in one message. Before each round, `_next_action` in [`_agent.py:3515-3534`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/agent/_agent.py#L3515-L3534) skips any call whose id already has a tool result. So when the model calls the same tool again in a later round, the new call has the id of the old one. The agent thinks it is done and never runs it. The call stays `pending`, and the next request sends it to Ollama with no tool result. If the model asks again, the same thing happens until `max_iters`.\n\nIt also happens inside one round. Ollama 0.32.0 streams two parallel calls in separate chunks. Both get `0_<tool>`, their arguments are joined into one call, and one of the two calls is lost.\n\nI saw this on real Ollama servers, 0.32.0 and 0.20.3, with `qwen3.5:2b`. I asked for the weather in Paris and then in London. The tool ran for Paris only, and the answer was empty. It's the same with and without streaming.\n\nThis affects any agent on `OllamaChatModel`, including the agent service with an Ollama credential. The other adapters use the id the provider sends. When there is none, `GeminiChatModel` makes a new one with `_generate_id()` in [`_gemini/_model.py:402`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/model/_gemini/_model.py#L402). The DingTalk channel already works around these Ollama ids in [`_card.py:24-30`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/app/channel/_dingtalk/_card.py#L24-L30).\n\nExpected: each tool call gets its own id, and every call runs.\n\n### Error Messages\n\n```shell\nget_weather ran for Paris\ntool_call 0_get_weather finished\ntool_result 0_get_weather success\ntool_call 0_get_weather pending\nrequest 3 ends with: ['tool', 'assistant']\n```\n\n### Steps to Reproduce\n\nNo need for API key or an Ollama server. The script uses a fake `/api/chat` that sends the same tool calls as a real Ollama server, with the `id`. It needs `agentscope[ollama]` and runs in a few seconds.\n\n```python\nimport asyncio\nimport json\n\nimport httpx\n\nfrom agentscope.agent import Agent\nfrom agentscope.message import TextBlock, UserMsg\nfrom agentscope.model import OllamaChatModel\nfrom agentscope.tool import FunctionTool, ToolChunk, Toolkit\n\n# What Ollama 0.20.3 sends back from /api/chat in three rounds\nROUNDS = [\n    {\"role\": \"assistant\", \"content\": \"\", \"tool_calls\": [{\n        \"id\": \"call_wjbmbf9z\",\n        \"function\": {\"index\": 0, \"name\": \"get_weather\",\n                     \"arguments\": {\"city\": \"Paris\"}}}]},\n    {\"role\": \"assistant\", \"content\": \"\", \"tool_calls\": [{\n        \"id\": \"call_ycie444h\",\n        \"function\": {\"index\": 0, \"name\": \"get_weather\",\n                     \"arguments\": {\"city\": \"London\"}}}]},\n    {\"role\": \"assistant\", \"content\": \"Both are sunny.\"},\n]\nrequests = []\n\n\ndef fake_ollama(request: httpx.Request) -> httpx.Response:\n    requests.append(json.loads(request.content))\n    return httpx.Response(200, json={\n        \"model\": \"qwen3:8b\", \"created_at\": \"2026-09-28T00:00:00Z\",\n        \"message\": ROUNDS[len(requests) - 1], \"done\": True,\n        \"done_reason\": \"stop\", \"prompt_eval_count\": 10, \"eval_count\": 5,\n    })\n\n\nasync def get_weather(city: str) -> ToolChunk:\n    \"\"\"Get the weather of a city.\"\"\"\n    print(\"get_weather ran for\", city)\n    return ToolChunk(content=[TextBlock(text=f\"sunny in {city}\")])\n\n\nasync def main() -> None:\n    model = OllamaChatModel(\n        model=\"qwen3:8b\",\n        stream=False,\n        client_kwargs={\"transport\": httpx.MockTransport(fake_ollama)},\n    )\n    agent = Agent(\n        name=\"Friday\",\n        system_prompt=\"You are a helpful assistant.\",\n        model=model,\n        toolkit=Toolkit(tools=[FunctionTool(get_weather, is_read_only=True)]),\n    )\n    await agent.reply(UserMsg(\"user\", \"Weather in Paris, then London?\"))\n    for block in agent.state.context[-1].get_content_blocks():\n        if block.type in (\"tool_call\", \"tool_result\"):\n            print(block.type, block.id, getattr(block, \"state\", \"\"))\n    last_two = requests[2][\"messages\"][-2:]\n    print(\"request 3 ends with:\", [m[\"role\"] for m in last_two])\n\n\nasyncio.run(main())\n```\n\nRun it with `python repro.py` on main at `cb7e1705`. `get_weather` runs for Paris only. The London call gets the same id, `0_get_weather`, and stays `pending` with no tool result. The third request ends with that unanswered call. The output is the same with `stream=True`.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at cb7e1705). 2.0.9 has the same code.\n- Python Version: 3.12.3\n- OS: Linux (aarch64)\n- ollama Python client 0.6.2. Real-server check on Ollama 0.32.0 and 0.20.3 with qwen3.5:2b.\n", "hints_text": "/assign\nIt's yours, @zaher-m. If there is no pull request and no word from you by 2026-10-12 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-09-29T11:34:50Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3010, "instance_id": "agentscope-ai__agentscope-3010", "issue_numbers": ["3009"], "base_commit": "68a027fac4c8e7aafa62b3fa73103ac73a68f152", "patch": "diff --git a/src/agentscope/mcp/_mcp_client.py b/src/agentscope/mcp/_mcp_client.py\nindex 8205723141..d8f48adf49 100644\n--- a/src/agentscope/mcp/_mcp_client.py\n+++ b/src/agentscope/mcp/_mcp_client.py\n@@ -234,13 +234,15 @@ async def _create_streamable_http_client(\n     ) -> AsyncGenerator[Any, None]:\n         \"\"\"Create an owned HTTP client that runtime headers can update.\"\"\"\n         config = self.mcp_config\n-        if config.headers or config.timeout:\n-            client = httpx.AsyncClient(\n-                headers=config.headers,\n-                timeout=config.timeout,\n-            )\n-        else:\n-            client = create_mcp_http_client()\n+        # Use the SDK factory to keep the transport's own client defaults\n+        client = create_mcp_http_client(\n+            headers=config.headers,\n+            timeout=(\n+                httpx.Timeout(config.timeout)\n+                if config.timeout is not None\n+                else None\n+            ),\n+        )\n         # Snapshot before overlaying: clearing runtime headers restores it.\n         self._static_headers = httpx.Headers(client.headers)\n         client.headers.update(self._runtime_headers)\n", "test_patch": "diff --git a/tests/mcp_runtime_headers_test.py b/tests/mcp_runtime_headers_test.py\nindex 6dbf6452df..2bd2d61ade 100644\n--- a/tests/mcp_runtime_headers_test.py\n+++ b/tests/mcp_runtime_headers_test.py\n@@ -174,6 +174,14 @@ async def test_owning_the_client_keeps_transport_defaults(self) -> None:\n                 \"untimed\",\n                 HttpMCPConfig(url=\"https://example.com/mcp\", timeout=None),\n             ),\n+            (\n+                \"untimed_with_headers\",\n+                HttpMCPConfig(\n+                    url=\"https://example.com/mcp\",\n+                    headers={\"X-Static\": \"static\"},\n+                    timeout=None,\n+                ),\n+            ),\n         ):\n             client = MCPClient(\n                 name=\"runtime_headers\",\n@@ -185,16 +193,25 @@ async def test_owning_the_client_keeps_transport_defaults(self) -> None:\n                 defaults[label] = {\n                     \"follow_redirects\": http_client.follow_redirects,\n                     \"read_timeout\": http_client.timeout.read,\n+                    \"static_header\": http_client.headers.get(\"X-Static\"),\n                 }\n \n         self.assertDictEqual(\n             defaults,\n             {\n                 \"configured\": {\n-                    \"follow_redirects\": False,\n+                    \"follow_redirects\": transport_defaults[\"follow_redirects\"],\n                     \"read_timeout\": 30.0,\n+                    \"static_header\": \"static\",\n+                },\n+                \"untimed\": {\n+                    **transport_defaults,\n+                    \"static_header\": None,\n+                },\n+                \"untimed_with_headers\": {\n+                    **transport_defaults,\n+                    \"static_header\": \"static\",\n                 },\n-                \"untimed\": transport_defaults,\n             },\n         )\n \n", "problem_statement": "[Bug]: MCPClient's owned streamable-HTTP client replaces the transport timeout defaults\n## Prerequisites\n\n- [x] I have searched the existing issues, pull requests, and discussions, and this is not a duplicate.\n- [x] This is a bug, not a usage question.\n\n## Background / Description\n\n`MCPClient._create_streamable_http_client` (`src/agentscope/mcp/_mcp_client.py`) builds the httpx client itself whenever `headers` or `timeout` is set, and only falls back to the SDK factory when both are unset:\n\n```python\nif config.headers or config.timeout:\n    client = httpx.AsyncClient(\n        headers=config.headers,\n        timeout=config.timeout,\n    )\nelse:\n    client = create_mcp_http_client()\n```\n\n`streamable_http_client()` takes that client as-is, so the owned client replaces the transport's defaults with httpx's. `create_mcp_http_client()` uses `httpx.Timeout(30, read=300)` \u2014 the 300s read timeout exists because a server may hold a response stream open.\n\nThree concrete divergences:\n\n1. **`headers` set + `timeout=None` \u2192 every timeout is disabled.** `httpx.AsyncClient(timeout=None)` produces `Timeout(None)` (all four fields `None`), not the 5s default. A hung MCP server then hangs the caller forever instead of failing after the transport's timeouts.\n2. **`headers` set + the default `timeout=30.0` \u2192 the read timeout drops from 300s to 30s.** This is the common case (any server needing an `Authorization` header), so the transport's long-read default is effectively never in effect.\n3. **`follow_redirects` silently follows httpx instead of the installed SDK.** mcp 1.30 documents that the transport follows redirects within the endpoint's origin itself and \"the client's `follow_redirects` setting is not consulted\", while its factory leaves it at the httpx default (off). Older SDKs set it to `True` in the factory. Either way the owned client should not decide this on its own.\n\n#2542 fixed the regression test to derive the untimed expectations from `create_mcp_http_client()`, but the branch above is still in place, so the owned client can still differ from the factory client the test compares against.\n\n## Steps to Reproduce\n\nNo network, no API key \u2014 the transport is patched, exactly as `tests/mcp_runtime_headers_test.py` does:\n\n```python\nimport asyncio\nfrom unittest.mock import patch\n\nfrom agentscope.mcp import HttpMCPConfig, MCPClient\n\n\nasync def main():\n    for label, config in (\n        (\"headers + timeout=None\", HttpMCPConfig(\n            url=\"https://example.com/mcp\", headers={\"A\": \"b\"}, timeout=None)),\n        (\"headers + default timeout\", HttpMCPConfig(\n            url=\"https://example.com/mcp\", headers={\"A\": \"b\"})),\n    ):\n        client = MCPClient(name=\"t\", is_stateful=False, mcp_config=config)\n        async with client._create_http_client():\n            http_client = client._http_client\n            print(label, \"->\",\n                  \"read:\", http_client.timeout.read,\n                  \"connect:\", http_client.timeout.connect,\n                  \"write:\", http_client.timeout.write,\n                  \"pool:\", http_client.timeout.pool)\n\nasyncio.run(main())\n```\n\nObserved on `main` (`78c4ec47`), Python 3.11, mcp 1.30.0:\n\n```text\nheaders + timeout=None       -> read: None connect: None write: None pool: None\nheaders + default timeout    -> read: 30.0 connect: 30.0 write: 30.0 pool: 30.0\n```\n\nExpected: the transport defaults (`connect: 30.0, read: 300.0`) in the first case, and the configured request timeout in the second without the read timeout collapsing with it.\n\n## Proposed fix\n\nBuild the owned client through the SDK factory in all cases, mapping an explicit `timeout` onto it:\n\n```python\nclient = create_mcp_http_client(\n    headers=config.headers,\n    timeout=(\n        httpx.Timeout(config.timeout)\n        if config.timeout is not None\n        else None\n    ),\n)\n```\n\nThis keeps the user's request timeout as the connect/write/pool timeout, restores the 300s read timeout when no timeout is configured, and leaves `follow_redirects` to whichever policy the installed SDK ships. No public API change.\n\nI have this implemented with a regression test that covers `headers` + `timeout=None` (previously untested, and the case that hangs), and will link the PR here.\n\n## Environment\n\n- AgentScope Version: 2.0.10dev (main at `78c4ec47`)\n- Python Version: 3.11\n- OS: Linux\n- mcp Version: 1.30.0\n\n", "hints_text": "", "created_at": "2026-09-29T11:25:32Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3008, "instance_id": "agentscope-ai__agentscope-3008", "issue_numbers": ["2970"], "base_commit": "78c4ec47f5f76c44d762ef7b5ddac55dd89c7f33", "patch": "diff --git a/src/agentscope/model/_anthropic/_model.py b/src/agentscope/model/_anthropic/_model.py\nindex 28093009ed..96f37f5798 100644\n--- a/src/agentscope/model/_anthropic/_model.py\n+++ b/src/agentscope/model/_anthropic/_model.py\n@@ -439,6 +439,8 @@ async def _parse_anthropic_stream_completion_response(\n         block_id_mapping: dict[int, str] = {}\n         # The mapping from index to tool call id\n         tool_call_mapping: dict = OrderedDict()\n+        # The indexes of the tool calls that received argument text\n+        tool_call_with_input: set[int] = set()\n \n         async with response as stream:\n             async for event in stream:\n@@ -537,12 +539,28 @@ async def _parse_anthropic_stream_completion_response(\n                         and block_index in tool_call_mapping\n                     ):\n                         block_id, name = tool_call_mapping[block_index]\n+                        if delta.partial_json:\n+                            tool_call_with_input.add(block_index)\n                         delta_res.append_tool_call(\n                             block_id=block_id,\n                             name=name,\n                             input=delta.partial_json or \"\",\n                         )\n \n+                # A call without arguments streams no JSON text, so close it\n+                # with the empty object the non-streaming response carries\n+                elif (\n+                    event.type == \"content_block_stop\"\n+                    and event.index in tool_call_mapping\n+                    and event.index not in tool_call_with_input\n+                ):\n+                    block_id, name = tool_call_mapping[event.index]\n+                    delta_res.append_tool_call(\n+                        block_id=block_id,\n+                        name=name,\n+                        input=\"{}\",\n+                    )\n+\n                 elif event.type == \"message_delta\":\n                     if event.usage and usage:\n                         usage.output_tokens = event.usage.output_tokens\n", "test_patch": "diff --git a/tests/model_anthropic_test.py b/tests/model_anthropic_test.py\nindex 3e6e06e376..1f6f32d5cc 100644\n--- a/tests/model_anthropic_test.py\n+++ b/tests/model_anthropic_test.py\n@@ -1013,6 +1013,70 @@ async def test_stream_preserves_content_blocks(self) -> None:\n                     [{\"role\": \"assistant\", \"content\": content}],\n                 )\n \n+    async def test_stream_tool_call_without_arguments(self) -> None:\n+        \"\"\"A tool call without arguments streams as ``{}``, as without\n+        streaming.\"\"\"\n+        completion = anthropic_types.Message.model_validate(\n+            {\n+                \"id\": \"msg-no-args\",\n+                \"type\": \"message\",\n+                \"role\": \"assistant\",\n+                \"model\": self.model.model,\n+                \"content\": [\n+                    {\n+                        \"type\": \"tool_use\",\n+                        \"id\": \"toolu_1\",\n+                        \"name\": \"list_tasks\",\n+                        \"input\": {},\n+                    },\n+                ],\n+                \"stop_reason\": \"tool_use\",\n+                \"stop_sequence\": None,\n+                \"usage\": {\"input_tokens\": 10, \"output_tokens\": 20},\n+            },\n+        )\n+        events = _completion_events(completion)\n+        tool_delta = next(_ for _ in events if _.type == \"content_block_delta\")\n+        non_stream_model = _make_model(stream=False)\n+        non_stream_model.client = self.mock_client\n+\n+        cases = {\n+            \"no_delta\": [_ for _ in events if _ is not tool_delta],\n+            \"empty_delta\": [\n+                (\n+                    _.model_copy(\n+                        update={\n+                            \"delta\": _.delta.model_copy(\n+                                update={\"partial_json\": \"\"},\n+                            ),\n+                        },\n+                    )\n+                    if _ is tool_delta\n+                    else _\n+                )\n+                for _ in events\n+            ],\n+        }\n+        for name, case_events in cases.items():\n+            with self.subTest(name=name):\n+                self.mock_client.messages.create = AsyncMock(\n+                    side_effect=[\n+                        _MockAsyncEventStream(case_events),\n+                        completion,\n+                    ],\n+                )\n+\n+                final = [r async for r in await self.model([])][-1]\n+                non_stream = await non_stream_model([])\n+\n+                self.assertListEqual(\n+                    [\n+                        (_.id, _.name, _.input)\n+                        for _ in (final.content[0], non_stream.content[0])\n+                    ],\n+                    [(\"toolu_1\", \"list_tasks\", \"{}\")] * 2,\n+                )\n+\n \n # ---------------------------------------------------------------------------\n # _format_tools tests\n", "problem_statement": "[Bug]: A streamed Anthropic tool call with no arguments gets an empty input and always fails\n### Prerequisites\n\n- [x] I have searched the existing [issues](https://github.com/agentscope-ai/agentscope/issues) and [discussions](https://github.com/agentscope-ai/agentscope/discussions), and this is not a duplicate.\n- [x] This is a bug, not a usage question. (For questions, please use [Discussions](https://github.com/agentscope-ai/agentscope/discussions/new?category=general) instead.)\n\n### Background / Description\n\nWhen Claude calls a tool that takes no arguments, the call fails if the response is streamed. Streaming is the default.\n\nIn [`_anthropic/_model.py:482-494`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/model/_anthropic/_model.py#L482-L494), the stream parser in `AnthropicChatModel` starts each tool call with an empty input, `\"\"`. Then it adds the `input_json_delta` pieces as they arrive, in [`:535-544`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/model/_anthropic/_model.py#L535-L544). A call with no arguments sends no JSON text, so nothing is added and the input stays `\"\"`. LiteLLM saw this from the live API in [LiteLLM issue 5063](https://github.com/BerriAI/litellm/issues/5063). There, streaming gave `\"arguments\": \"\"` and non-streaming gave `\"{}\"`. LangChain hit the same bug in [LangChain issue 23911](https://github.com/langchain-ai/langchain/issues/23911). Without streaming, `AnthropicChatModel` gives `\"{}\"` for the same call, in [`:373-380`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/model/_anthropic/_model.py#L373-L380). The SDK's own stream helper in `anthropic/lib/streaming/_messages.py` also keeps `{}` when no argument text arrives.\n\nThe agent then tries to read `\"\"` as JSON, in [`_agent.py:2489-2492`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/agent/_agent.py#L2489-L2492). That fails with `ToolJSONDecodeError`, so the tool doesn't run and the model gets an error about bad arguments. With Claude, this breaks every tool without parameters. That includes the built-in `TaskList`, which the agent service adds to every session in [`_service/_toolkit.py:143`](https://github.com/agentscope-ai/agentscope/blob/cb7e1705874d09f5b8b201884089fe07189f6f3b/src/agentscope/app/_service/_toolkit.py#L143). It also includes the `CompressContext` tool and MCP tools without parameters. `MiniMaxChatModel` uses the same parser, so it has the same problem.\n\nExpected: a streamed call with no arguments gets `\"{}\"`, the same as without streaming.\n\n### Error Messages\n\n```shell\ntool call input: ''\ntool result state: error\ntool result: <system-reminder>Error: When decoding your tool arguments from JSON format to a Python dictionary, a JSONDecodeError\n```\n\n### Steps to Reproduce\n\nYou don't need an API key. The script sends the `anthropic` SDK's own stream events to `AnthropicChatModel` through a fake `client.messages.create`. It runs in about a second.\n\n```python\nimport asyncio\nfrom unittest.mock import AsyncMock\n\nfrom anthropic import types as t\n\nfrom agentscope.agent import Agent\nfrom agentscope.credential import AnthropicCredential\nfrom agentscope.message import UserMsg\nfrom agentscope.model import AnthropicChatModel\nfrom agentscope.tool import TaskList, Toolkit\n\n\ndef message(content, stop_reason):\n    return t.Message.model_validate({\n        \"id\": \"msg_1\", \"type\": \"message\", \"role\": \"assistant\",\n        \"model\": \"claude-sonnet-4-5\", \"content\": content,\n        \"stop_reason\": stop_reason, \"stop_sequence\": None,\n        \"usage\": {\"input_tokens\": 10, \"output_tokens\": 5},\n    })\n\n\nclass Stream:\n    \"\"\"The events of one streamed answer, as the SDK yields them.\"\"\"\n\n    def __init__(self, events):\n        self.events = events\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, *args):\n        return None\n\n    def __aiter__(self):\n        return self._iter()\n\n    async def _iter(self):\n        for event in self.events:\n            yield event\n\n\n# Claude calls TaskList, which takes no arguments: the tool_use block\n# starts with input {} and no input_json_delta carries any text\ntool_call_stream = Stream([\n    t.RawMessageStartEvent(type=\"message_start\", message=message([], None)),\n    t.RawContentBlockStartEvent.model_validate({\n        \"type\": \"content_block_start\", \"index\": 0,\n        \"content_block\": {\"type\": \"tool_use\", \"id\": \"toolu_1\",\n                          \"name\": \"TaskList\", \"input\": {}},\n    }),\n    t.RawContentBlockStopEvent(type=\"content_block_stop\", index=0),\n    t.RawMessageDeltaEvent.model_validate({\n        \"type\": \"message_delta\",\n        \"delta\": {\"stop_reason\": \"tool_use\", \"stop_sequence\": None},\n        \"usage\": {\"output_tokens\": 5},\n    }),\n    t.RawMessageStopEvent(type=\"message_stop\"),\n])\n# The next answer, after the tool result, is empty; it ends the reply\nend_stream = Stream([\n    t.RawMessageStartEvent(type=\"message_start\", message=message([], None)),\n    t.RawMessageStopEvent(type=\"message_stop\"),\n])\n\n\nasync def main() -> None:\n    model = AnthropicChatModel(\n        credential=AnthropicCredential(api_key=\"unused\"),\n        model=\"claude-sonnet-4-5\",\n    )\n    model.client.messages.create = AsyncMock(\n        side_effect=[tool_call_stream, end_stream],\n    )\n    agent = Agent(\n        name=\"Friday\",\n        system_prompt=\"You are a helpful assistant.\",\n        model=model,\n        toolkit=Toolkit(tools=[TaskList()]),\n    )\n    await agent.reply(UserMsg(\"user\", \"Which tasks are open?\"))\n    msg = agent.state.context[-1]\n    call = msg.get_content_blocks(\"tool_call\")[0]\n    result = msg.get_content_blocks(\"tool_result\")[0]\n    print(\"tool call input:\", repr(call.input))\n    print(\"tool result state:\", result.state)\n    output = result.output\n    text = output if isinstance(output, str) else output[0].text\n    print(\"tool result:\", text.split(\" was raised\")[0])\n\n\nasyncio.run(main())\n```\n\nRun it with `python repro.py` on main at `cb7e1705`. The call's input is `''`, so the tool result is the JSON error and `TaskList` never runs. It's the same when one `input_json_delta` arrives with an empty `partial_json`. With `stream=False` the input is `\"{}\"` and the tool runs.\n\n### Environment\n\n- AgentScope Version: 2.0.10dev (main at cb7e1705). 2.0.9 has the same code.\n- Python Version: 3.12.3\n- OS: Linux (aarch64)\n- anthropic 1.8.0\n", "hints_text": "/assign\nIt's yours, @zaher-m. If there is no pull request and no word from you by 2026-10-12 the claim is released so nobody is blocked \u2014 a comment here renews it.", "created_at": "2026-09-29T11:08:52Z"}
{"repo": "agentscope-ai/agentscope", "pull_number": 3006, "instance_id": "agentscope-ai__agentscope-3006", "issue_numbers": ["3005"], "base_commit": "13a855be5cc1b0b99efcd9933993a2117be60860", "patch": "diff --git a/src/agentscope/tool/_builtin/_backend.py b/src/agentscope/tool/_builtin/_backend.py\nindex ecc2a21e78..4e139da11b 100644\n--- a/src/agentscope/tool/_builtin/_backend.py\n+++ b/src/agentscope/tool/_builtin/_backend.py\n@@ -1070,12 +1070,17 @@ async def stat_mtime(self, path: str) -> float | None:\n     async def delete_path(self, path: str) -> None:\n         \"\"\"Delete a local file or directory tree.\n \n-        No-op if *path* does not exist.\n+        Symbolic links are removed without following their targets,\n+        including when the target no longer exists. No-op if *path*\n+        does not exist.\n \n         Args:\n             path (`str`):\n                 Path to delete.\n         \"\"\"\n+        if os.path.islink(path):\n+            os.remove(path)\n+            return\n         if not os.path.exists(path):\n             return\n         if os.path.isdir(path):\n", "test_patch": "diff --git a/tests/backend_local_test.py b/tests/backend_local_test.py\nindex c146d15268..3cd8692ad5 100644\n--- a/tests/backend_local_test.py\n+++ b/tests/backend_local_test.py\n@@ -369,6 +369,40 @@ async def test_delete_path_missing_is_noop(self) -> None:\n             os.path.join(self.temp_dir.name, \"missing\"),\n         )\n \n+    async def test_delete_path_symlinks_preserves_targets(self) -> None:\n+        \"\"\"Remove links, including dangling ones, without touching targets.\"\"\"\n+        for kind in (\"file\", \"directory\", \"broken-file\", \"broken-directory\"):\n+            with self.subTest(kind=kind):\n+                target = os.path.join(self.temp_dir.name, kind + \"-target\")\n+                link = os.path.join(self.temp_dir.name, kind + \"-link\")\n+                payload_path = target\n+                if kind == \"directory\":\n+                    os.makedirs(target)\n+                    payload_path = os.path.join(target, \"child.txt\")\n+                if not kind.startswith(\"broken\"):\n+                    await self.backend.write_file(payload_path, b\"preserve me\")\n+                try:\n+                    os.symlink(\n+                        target,\n+                        link,\n+                        target_is_directory=\"directory\" in kind,\n+                    )\n+                except OSError as exc:\n+                    if _IS_WINDOWS and exc.winerror == 1314:\n+                        self.skipTest(\"Creating symlinks requires permission\")\n+                    raise\n+\n+                await self.backend.delete_path(link)\n+                self.assertFalse(os.path.lexists(link))\n+                if not kind.startswith(\"broken\"):\n+                    self.assertEqual(\n+                        await self.backend.read_file(payload_path),\n+                        b\"preserve me\",\n+                    )\n+                else:\n+                    self.assertFalse(os.path.exists(target))\n+                await self.backend.delete_path(link)\n+\n \n @unittest.skipIf(\n     _IS_WINDOWS,\n", "problem_statement": "[Bug]: LocalBackend.delete_path cannot remove directory or dangling symlinks\nReproduced with the production LocalBackend on Linux: deleting a directory symlink calls shutil.rmtree and raises OSError (Cannot call rmtree on a symbolic link); deleting a dangling symlink returns early because os.path.exists follows the missing target. This differs from BackendBase delete_path using rm -rf and leaves workspace cleanup incomplete. Proposed fix: unlink symbolic links before the existing missing-path / directory handling, preserving their targets. Real Linux tests cover file links, directory links, dangling links and repeated deletion; targets must remain intact. Windows tests should skip only when symlink creation is unavailable. Codex is assisting with this focused fix.\n", "hints_text": "", "created_at": "2026-09-29T09:26:52Z"}
