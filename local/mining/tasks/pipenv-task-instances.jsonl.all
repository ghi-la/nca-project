[],\n             \"extras\": [],\n@@ -144,7 +144,7 @@ def from_lockfile(\n \n         # Process packages\n         default_packages = lockfile_data.get(\"default\", {})\n-        default_entries = {}\n+        default_entries: Dict[str, Any] = {}\n         for section in [\"default\", \"develop\"]:\n             packages = lockfile_data.get(section, {})\n             for name, package_data in packages.items():\n@@ -163,7 +163,7 @@ def from_lockfile(\n                     )\n                     continue\n \n-                package = {\"name\": name}\n+                package: Dict[str, Any] = {\"name\": name}\n                 if section == \"default\":\n                     default_entries[name] = package\n \n@@ -330,7 +330,7 @@ def from_path(cls, path: Union[str, Path]) -> \"PylockFile\":\n     def from_pyproject(\n         cls,\n         pyproject_path: Union[str, Path],\n-        pylock_path: Union[str, Path] = None,\n+        pylock_path: Optional[Union[str, Path]] = None,\n     ) -> \"PylockFile\":\n         \"\"\"Create a PylockFile skeleton from a pyproject.toml file.\n \n@@ -493,7 +493,7 @@ def write(self) -> None:\n         try:\n             # Ensure all values are properly formatted for TOML\n             # Create a deep copy of the data to avoid modifying the original\n-            data_copy = {}\n+            data_copy: Dict[str, Any] = {}\n             for key, value in self.data.items():\n                 if isinstance(value, dict):\n                     data_copy[key] = value.copy()\n@@ -872,7 +872,7 @@ def convert_to_pipenv_lockfile(\n             A dictionary in Pipfile.lock format\n         \"\"\"\n         # Create the basic structure\n-        lockfile = {\n+        lockfile: Dict[str, Any] = {\n             \"_meta\": {\n                 \"hash\": {\"sha256\": \"\"},  # We don't have a hash in pylock.toml\n                 \"pipfile-spec\": 6,\n@@ -940,7 +940,7 @@ def convert_to_pipenv_lockfile(\n                 package_entry[\"version\"] = \"*\"\n \n             # Add hashes if present\n-            hashes = []\n+            hashes: List[str] = []\n             if \"wheels\" in package:\n                 hashes.extend(\n                     f\"sha256:{wheel['hashes']['sha256']}\"\n@@ -1081,7 +1081,7 @@ def _pylock_source_from_lockfile_entry(package_data: Dict[str, Any]) -> Dict[str\n     if \"path\" not in package_data and \"file\" not in package_data:\n         return {}\n \n-    location = package_data.get(\"path\") or package_data.get(\"file\")\n+    location = package_data.get(\"path\") or package_data[\"file\"]\n     if \"file\" in package_data or location.lower().endswith(ARCHIVE_SUFFIXES):\n         archive = {\"path\" if \"path\" in package_data else \"url\": location}\n         hashes = {\n@@ -1151,7 +1151,7 @@ def _lockfile_source_from_pylock_package(package: Dict[str, Any]) -> Dict[str, A\n     return {}\n \n \n-def find_pylock_file(directory: Union[str, Path] = None) -> Optional[Path]:\n+def find_pylock_file(directory: Optional[Union[str, Path]] = None) -> Optional[Path]:\n     \"\"\"Find a pylock.toml file in the given directory.\n \n     Args:\ndiff --git a/pipenv/utils/resolver.py b/pipenv/utils/resolver.py\nindex e598b8123d..b36b9efca0 100644\n--- a/pipenv/utils/resolver.py\n+++ b/pipenv/utils/resolver.py\n@@ -11,7 +11,7 @@\n import warnings\n from concurrent.futures import ThreadPoolExecutor\n from pathlib import Path\n-from typing import Any, Dict, List, Tuple, Union\n+from typing import Any, Dict, List, Optional, Tuple, Union\n \n from pipenv import environments\n from pipenv.exceptions import ResolutionFailure\n@@ -392,15 +392,15 @@ def create(\n         cls,\n         deps: Dict[str, str],\n         project,\n-        index_lookup: Dict[str, str] = None,\n-        markers_lookup: Dict[str, str] = None,\n-        sources: List[str] = None,\n-        req_dir: str = None,\n+        index_lookup: Optional[Dict[str, str]] = None,\n+        markers_lookup: Optional[Dict[str, str]] = None,\n+        sources: Optional[List[str]] = None,\n+        req_dir: Optional[Union[str, Path]] = None,\n         clear: bool = False,\n         pre: bool = False,\n-        pipfile_category: str = None,\n-        resolved_default_deps: Dict[str, Any] = None,\n-        extra_pip_args: List[str] = None,\n+        pipfile_category: Optional[str] = None,\n+        resolved_default_deps: Optional[Dict[str, Any]] = None,\n+        extra_pip_args: Optional[List[str]] = None,\n     ) -> \"Resolver\":\n         if not req_dir:\n             req_dir = create_tracked_tempdir(suffix=\"-requirements\", prefix=\"pipenv-\")\n@@ -1137,8 +1137,8 @@ def clean_results(self) -> List[Dict[str, Any]]:\n \n \n # Global cache for resolution results to avoid repeated expensive subprocess calls\n-_resolution_cache = {}\n-_resolution_cache_timestamp = {}\n+_resolution_cache: Dict[str, Any] = {}\n+_resolution_cache_timestamp: Dict[str, float] = {}\n \n \n def _generate_resolution_cache_key(\ndiff --git a/pipenv/utils/toml.py b/pipenv/utils/toml.py\nindex 5630d0f857..7232d4b5a3 100644\n--- a/pipenv/utils/toml.py\n+++ b/pipenv/utils/toml.py\n@@ -1,4 +1,4 @@\n-from typing import Union\n+from typing import Any, Dict, Union\n \n from pipenv.vendor.plette.models import Package, PackageCollection\n from pipenv.vendor.tomlkit.container import Container, OutOfOrderTableProxy\n@@ -111,8 +111,7 @@ def convert_toml_table(section):\n     return parsed\n \n \n-def tomlkit_value_to_python(toml_value):\n-    # type: (Union[Array, AoT, TOML_DICT_TYPES, Item]) -> Union[List, Dict]\n+def tomlkit_value_to_python(toml_value: Union[Array, AoT, TOML_DICT_TYPES, Item]) -> Any:\n     value_type = type(toml_value).__name__\n     if (\n         isinstance(toml_value, TOML_DICT_OBJECTS + (dict,))\n@@ -132,12 +131,11 @@ def tomlkit_value_to_python(toml_value):\n     return toml_value\n \n \n-def tomlkit_dict_to_python(toml_dict):\n-    # type: (TOML_DICT_TYPES) -> Dict\n+def tomlkit_dict_to_python(toml_dict: TOML_DICT_TYPES) -> Dict:\n     value_type = type(toml_dict).__name__\n     if toml_dict is None:\n         raise TypeError(\"Invalid type NoneType when converting toml dict to python\")\n-    converted = None  # type: Optional[Dict]\n+    converted: Any = None\n     if isinstance(toml_dict, (InlineTable, Table)) or value_type in (\n         \"InlineTable\",\n         \"Table\",\ndiff --git a/pipenv/utils/unpack.py b/pipenv/utils/unpack.py\nindex 1ab1085ea4..d042f87cdb 100644\n--- a/pipenv/utils/unpack.py\n+++ b/pipenv/utils/unpack.py\n@@ -44,7 +44,7 @@ def unpack_url(\n     verbosity: int,\n     download_dir: Optional[str] = None,\n     hashes: Optional[Hashes] = None,\n-) -> Optional[File]:\n+) -> File:\n     \"\"\"Unpack link into location, downloading if required.\n \n     :param hashes: A Hashes object, one of whose embedded hashes must match,\ndiff --git a/pyproject.toml b/pyproject.toml\nindex 2354be87bf..9f820a846e 100644\n--- a/pyproject.toml\n+++ b/pyproject.toml\n@@ -333,6 +333,8 @@ showcontent = true\n [tool.mypy]\n ignore_missing_imports = true\n follow_imports = \"skip\"\n-html_report = \"mypyhtml\"\n-python_version = \"3.7\"\n-mypy_path = \"typeshed/pyi:typeshed/imports\"\n+python_version = \"3.10\"\n+files = [ \"pipenv\" ]\n+exclude = [ \"^pipenv/vendor/\", \"^pipenv/patched/\" ]\n+# Bodies of unannotated functions are not checked yet; silence the reminder.\n+disable_error_code = [ \"annotation-unchecked\" ]\n", "test_patch": "", "problem_statement": "Get mypy type checking enabled in pipenv\nSimilar to linting or vendoring, we should have a a build step that is for running the mypy type checker.   This will mean cleaning up the type annotations and eliminating type errors so we can make the build depend on passing type checks.   Doing so will help prevent some class of spurious coding errors.\r\n\n", "hints_text": "**Triage update:** Enabling mypy across the whole pipenv codebase is a significant long-term initiative. The main challenges are:\n\n1. **Vendored libraries** \u2014 `pipenv/vendor/` and `pipenv/patched/` contain hundreds of thousands of lines of third-party code (click, pip, packaging, pythonfinder, etc.) that have no stubs or have stubs that conflict with vendored versions. Each would need inline `# type: ignore` annotations or stub packages.\n\n2. **Dynamic patterns** \u2014 pipenv makes heavy use of `__dict__` introspection, dynamic attribute access on `plette` objects, and conditional imports that are hard to type statically.\n\n3. **Incremental approach needed** \u2014 A realistic path would be:\n   - Start with a `mypy.ini` configured to `ignore_missing_imports = true` and `exclude` vendor directories\n   - Enable mypy on one module at a time (e.g. `pipenv/utils/` first)\n   - Gradually tighten strictness\n\nThis is tracked and welcome as a community contribution. It's unlikely to land as a single PR \u2014 incremental PRs per module are the preferred approach. Keeping this open as a tracking issue.", "created_at": "2026-10-18T18:20:27Z"}
{"repo": "pypa/pipenv", "pull_number": 6740, "instance_id": "pypa__pipenv-6740", "issue_numbers": ["6738"], "base_commit": "ee2eb7237f0aa198d01bd3428942ebbbd8ddd55c", "patch": "diff --git a/news/6738.bugfix.rst b/news/6738.bugfix.rst\nnew file mode 100644\nindex 0000000000..d2cec47fa7\n--- /dev/null\n+++ b/news/6738.bugfix.rst\n@@ -0,0 +1,3 @@\n+Write actual distribution filenames and URLs to generated ``pylock.toml`` files\n+by matching locked hashes against the package index.\n+Avoid fabricated wheel entries when an artifact cannot be identified.\ndiff --git a/pipenv/utils/pylock.py b/pipenv/utils/pylock.py\nindex 3a46fe89de..75c9bc272b 100644\n--- a/pipenv/utils/pylock.py\n+++ b/pipenv/utils/pylock.py\n@@ -12,6 +12,7 @@\n from dataclasses import dataclass, field\n from pathlib import Path\n from typing import Any, Dict, List, Optional, Set, Union\n+from urllib.parse import urljoin\n \n from pipenv.utils import err\n from pipenv.utils.locking import atomic_open_for_write\n@@ -124,6 +125,7 @@ def from_lockfile(\n         # Extract sources and build index URL map\n         sources = meta.get(\"sources\", [])\n         index_url_map = {}  # Map source name to URL\n+        source_map = {}\n         default_index = \"https://pypi.org/simple/\"\n         if sources:\n             for source in sources:\n@@ -132,6 +134,7 @@ def from_lockfile(\n                 if source_name and source_url:\n                     # Convert to simple API URL format\n                     index_url_map[source_name] = source_url.rstrip(\"/\") + \"/\"\n+                    source_map[source_name] = source\n             # Use the first source as default\n             if sources and sources[0].get(\"url\"):\n                 default_index = sources[0][\"url\"].rstrip(\"/\") + \"/\"\n@@ -191,24 +194,35 @@ def from_lockfile(\n                 else:\n                     package[\"index\"] = default_index\n \n-                # Add hashes if present, with proper wheel/sdist structure\n-                if \"hashes\" in package_data:\n-                    wheels = []\n-                    for hash_value in package_data[\"hashes\"]:\n-                        if hash_value.startswith(\"sha256:\"):\n-                            hash_hex = hash_value[7:]  # Remove \"sha256:\" prefix\n-                            version_str = package.get(\"version\", \"0.0.0\")\n-                            wheel_name = (\n-                                f\"{name.replace('-', '_')}-{version_str}-py3-none-any.whl\"\n-                            )\n-                            wheel = {\n-                                \"name\": wheel_name,\n-                                \"url\": f\"{package['index']}{name}/{wheel_name}\",\n-                                \"hashes\": {\"sha256\": hash_hex},\n-                            }\n-                            wheels.append(wheel)\n+                # A Pipfile.lock hash does not identify a filename or URL. Match\n+                # it against the actual files in the package's Simple API page.\n+                hashes = package_data.get(\"hashes\", [])\n+                if hashes:\n+                    source_info = source_map.get(package_data.get(\"index\"))\n+                    if source_info is None and sources:\n+                        source_info = sources[0]\n+                    files = _files_for_lockfile_hashes(\n+                        name, package[\"index\"], hashes, source_info\n+                    )\n+                    wheels = [item for item in files if item[\"name\"].endswith(\".whl\")]\n+                    sdists = [item for item in files if not item[\"name\"].endswith(\".whl\")]\n                     if wheels:\n                         package[\"wheels\"] = wheels\n+                    if sdists:\n+                        package[\"sdist\"] = sdists[0]\n+\n+                    # Keep hashes that could not be assigned to a real file for\n+                    # Pipenv's round trip. They cannot be portable PEP 751 file\n+                    # entries without an artifact identity.\n+                    recorded_files = wheels + sdists[:1]\n+                    matched = {\n+                        f\"{algorithm}:{digest}\"\n+                        for item in recorded_files\n+                        for algorithm, digest in item[\"hashes\"].items()\n+                    }\n+                    unmatched = sorted(set(hashes) - matched)\n+                    if unmatched:\n+                        package[\"tool\"] = {\"pipenv\": {\"hashes\": unmatched}}\n \n                 pylock_data[\"packages\"].append(package)\n \n@@ -920,8 +934,9 @@ def convert_to_pipenv_lockfile(\n                 and \"sha256\" in package[\"sdist\"][\"hashes\"]\n             ):\n                 hashes.append(f\"sha256:{package['sdist']['hashes']['sha256']}\")\n+            hashes.extend(package.get(\"tool\", {}).get(\"pipenv\", {}).get(\"hashes\", []))\n             if hashes:\n-                package_entry[\"hashes\"] = hashes\n+                package_entry[\"hashes\"] = sorted(set(hashes))\n \n             # Add marker if present\n             if marker:\n@@ -934,6 +949,76 @@ def convert_to_pipenv_lockfile(\n         return lockfile\n \n \n+def _files_for_lockfile_hashes(name, index_url, hashes, source=None):\n+    \"\"\"Find actual distribution files for hashes in a Pipfile.lock entry.\n+\n+    The Simple API supplies file identities and hashes for both PyPI and\n+    private indexes. A hash with no matching index file cannot be represented\n+    as a PEP 751 wheel or sdist.\n+    \"\"\"\n+    from pipenv.patched.pip._internal.index.collector import IndexContent, parse_links\n+    from pipenv.patched.pip._internal.utils.misc import remove_auth_from_url\n+    from pipenv.patched.pip._vendor.packaging.utils import canonicalize_name\n+    from pipenv.patched.pip._vendor.requests.exceptions import RequestException\n+    from pipenv.utils.internet import get_requests_session\n+    from pipenv.utils.shell import expand_url_credentials\n+\n+    wanted = {value[7:].lower() for value in hashes if value.startswith(\"sha256:\")}\n+    if not wanted:\n+        return []\n+\n+    project_url = urljoin(\n+        expand_url_credentials(index_url.rstrip(\"/\") + \"/\"),\n+        canonicalize_name(name) + \"/\",\n+    )\n+    try:\n+        with get_requests_session(\n+            max_retries=0,\n+            verify_ssl=source.get(\"verify_ssl\", True) if source else True,\n+            source=expand_url_credentials(index_url),\n+        ) as session:\n+            response = session.get(\n+                project_url,\n+                headers={\n+                    \"Accept\": \"application/vnd.pypi.simple.v1+json, \"\n+                    \"application/vnd.pypi.simple.v1+html;q=0.2, text/html;q=0.1\"\n+                },\n+                timeout=5,\n+            )\n+            response.raise_for_status()\n+            page = IndexContent(\n+                response.content,\n+                response.headers.get(\"Content-Type\", \"text/html\"),\n+                response.encoding,\n+                response.url,\n+                cache_link_parsing=False,\n+            )\n+            links = list(parse_links(page))\n+    except (RequestException, ValueError, OSError):\n+        return []\n+\n+    files = []\n+    seen = set()\n+    for link in links:\n+        digest = link._hashes.get(\"sha256\")\n+        if not digest or digest.lower() not in wanted:\n+            continue\n+        filename = link.filename\n+        if not filename.endswith((\".whl\", \".tar.gz\", \".zip\", \".tar.bz2\", \".tar.xz\", \".tgz\")):\n+            continue\n+        if digest.lower() in seen:\n+            continue\n+        seen.add(digest.lower())\n+        files.append(\n+            {\n+                \"name\": filename,\n+                \"url\": remove_auth_from_url(link.url_without_fragment),\n+                \"hashes\": {\"sha256\": digest.lower()},\n+            }\n+        )\n+    return sorted(files, key=lambda item: item[\"name\"])\n+\n+\n VCS_TYPES = (\"git\", \"hg\", \"svn\", \"bzr\")\n ARCHIVE_SUFFIXES = (\".whl\", \".zip\", \".tar.gz\", \".tgz\", \".tar.bz2\", \".tar.xz\", \".tar\")\n \n", "test_patch": "diff --git a/tests/unit/test_pylock_artifacts.py b/tests/unit/test_pylock_artifacts.py\nnew file mode 100644\nindex 0000000000..5c16ed3bd0\n--- /dev/null\n+++ b/tests/unit/test_pylock_artifacts.py\n@@ -0,0 +1,146 @@\n+import json\n+\n+from pipenv.utils.pylock import PylockFile, _files_for_lockfile_hashes\n+\n+WHEEL_HASH = \"a\" * 64\n+SDIST_HASH = \"b\" * 64\n+\n+\n+def test_from_lockfile_uses_real_simple_api_files(tmp_path, monkeypatch):\n+    class Response:\n+        content = json.dumps(\n+            {\n+                \"files\": [\n+                    {\n+                        \"filename\": \"six-1.17.0-py2.py3-none-any.whl\",\n+                        \"url\": \"https://files.pythonhosted.org/six-1.17.0-py2.py3-none-any.whl\",\n+                        \"hashes\": {\"sha256\": WHEEL_HASH},\n+                    },\n+                    {\n+                        \"filename\": \"six-1.17.0.tar.gz\",\n+                        \"url\": \"https://files.pythonhosted.org/six-1.17.0.tar.gz\",\n+                        \"hashes\": {\"sha256\": SDIST_HASH},\n+                    },\n+                ]\n+            }\n+        ).encode()\n+        headers = {\"Content-Type\": \"application/vnd.pypi.simple.v1+json\"}\n+        encoding = \"utf-8\"\n+        url = \"https://pypi.org/simple/six/\"\n+\n+        def raise_for_status(self):\n+            pass\n+\n+    class Session:\n+        def __enter__(self):\n+            return self\n+\n+        def __exit__(self, *args):\n+            pass\n+\n+        def get(self, url, **kwargs):\n+            assert url == \"https://pypi.org/simple/six/\"\n+            return Response()\n+\n+    monkeypatch.setattr(\n+        \"pipenv.utils.internet.get_requests_session\", lambda **kwargs: Session()\n+    )\n+    lockfile = tmp_path / \"Pipfile.lock\"\n+    lockfile.write_text(\n+        json.dumps(\n+            {\n+                \"_meta\": {\"sources\": [{\"name\": \"pypi\", \"url\": \"https://pypi.org/simple\"}]},\n+                \"default\": {\n+                    \"six\": {\n+                        \"version\": \"==1.17.0\",\n+                        \"hashes\": [f\"sha256:{WHEEL_HASH}\", f\"sha256:{SDIST_HASH}\"],\n+                    }\n+                },\n+                \"develop\": {},\n+            }\n+        )\n+    )\n+\n+    pylock = PylockFile.from_lockfile(lockfile)\n+    package = pylock.packages[0]\n+    assert package[\"wheels\"] == [\n+        {\n+            \"name\": \"six-1.17.0-py2.py3-none-any.whl\",\n+            \"url\": \"https://files.pythonhosted.org/six-1.17.0-py2.py3-none-any.whl\",\n+            \"hashes\": {\"sha256\": WHEEL_HASH},\n+        }\n+    ]\n+    assert package[\"sdist\"][\"name\"] == \"six-1.17.0.tar.gz\"\n+    assert package[\"sdist\"][\"hashes\"] == {\"sha256\": SDIST_HASH}\n+    assert \"tool\" not in package\n+\n+    pylock.write()\n+    converted = PylockFile.from_path(pylock.path).convert_to_pipenv_lockfile()\n+    assert set(converted[\"default\"][\"six\"][\"hashes\"]) == {\n+        f\"sha256:{WHEEL_HASH}\", f\"sha256:{SDIST_HASH}\"\n+    }\n+\n+\n+def test_unknown_hash_does_not_create_a_fake_wheel(tmp_path, monkeypatch):\n+    monkeypatch.setattr(\n+        \"pipenv.utils.pylock._files_for_lockfile_hashes\", lambda *args: []\n+    )\n+    lockfile = tmp_path / \"Pipfile.lock\"\n+    lockfile.write_text(\n+        json.dumps(\n+            {\n+                \"_meta\": {\"sources\": [{\"name\": \"pypi\", \"url\": \"https://pypi.org/simple\"}]},\n+                \"default\": {\"six\": {\"version\": \"==1.17.0\", \"hashes\": [f\"sha256:{SDIST_HASH}\"]}},\n+                \"develop\": {},\n+            }\n+        )\n+    )\n+\n+    pylock = PylockFile.from_lockfile(lockfile)\n+    package = pylock.packages[0]\n+    assert \"wheels\" not in package\n+    assert \"sdist\" not in package\n+    assert package[\"tool\"][\"pipenv\"][\"hashes\"] == [f\"sha256:{SDIST_HASH}\"]\n+\n+    pylock.write()\n+    converted = PylockFile.from_path(pylock.path).convert_to_pipenv_lockfile()\n+    assert converted[\"default\"][\"six\"][\"hashes\"] == [f\"sha256:{SDIST_HASH}\"]\n+\n+\n+def test_html_simple_index_matches_hash_and_strips_url_credentials(monkeypatch):\n+    class Response:\n+        content = (\n+            f'<a href=\"https://user:secret@files.example/six-1.17.0.tar.gz'\n+            f'#sha256={SDIST_HASH}\">six</a>'\n+        ).encode()\n+        headers = {\"Content-Type\": \"text/html\"}\n+        encoding = \"utf-8\"\n+        url = \"https://index.example/simple/six/\"\n+\n+        def raise_for_status(self):\n+            pass\n+\n+    class Session:\n+        def __enter__(self):\n+            return self\n+\n+        def __exit__(self, *args):\n+            pass\n+\n+        def get(self, url, **kwargs):\n+            assert url == \"https://index.example/simple/six/\"\n+            return Response()\n+\n+    monkeypatch.setattr(\n+        \"pipenv.utils.internet.get_requests_session\", lambda **kwargs: Session()\n+    )\n+    files = _files_for_lockfile_hashes(\n+        \"six\", \"https://index.example/simple\", [f\"sha256:{SDIST_HASH}\"]\n+    )\n+    assert files == [\n+        {\n+            \"name\": \"six-1.17.0.tar.gz\",\n+            \"url\": \"https://files.example/six-1.17.0.tar.gz\",\n+            \"hashes\": {\"sha256\": SDIST_HASH},\n+        }\n+    ]\n", "problem_statement": "pylock.toml written by pipenv lists made-up wheel files, so other installers can't use it\n### Issue description\n\nWith `use_pylock = true`, `PylockFile.from_lockfile()` (`pipenv/utils/pylock.py`) turns every `sha256` hash of a Pipfile.lock entry into a `packages.wheels` entry. It invents the file name and URL:\n\n- the name is always `<name>-<version>-py3-none-any.whl`, whatever the real file is, so a package with an sdist and a wheel gets two \"wheels\" with the same name, one carrying the sdist's hash;\n- the URL is `<index>/<name>/<file name>`, e.g. `https://pypi.org/simple/six/six-1.17.0-py3-none-any.whl`. That isn't a file URL on PyPI (`/simple/` is the index API) and returns 404.\n\nPipenv itself only reads the hashes back, so `pipenv sync` from the file works. But PEP 751 lockfiles are meant to be installable by other tools, and those use the listed files. For example, `uv pip install -r pylock.toml` (uv 0.12.7) on a pipenv-written lock:\n\n```\n\u00d7 Failed to download `six==1.17.0`\n\u251c\u2500\u25b6 Failed to fetch:\n\u2502   `https://pypi.org/simple/six/six-1.17.0-py3-none-any.whl`\n\u2570\u2500\u25b6 HTTP status client error (404 Not Found) for url\n    (https://pypi.org/simple/six/six-1.17.0-py3-none-any.whl)\n```\n\nPackages with compiled wheels get the same `py3-none-any` name for every platform wheel, so their tags are wrong too.\n\n### Expected result\n\n`packages.wheels` / `packages.sdist` entries with the real file names and URLs (and hashes matched to the right file), or no file entries when pipenv can't know them, rather than invented ones.\n\n### Actual result\n\nFor `six = \"==1.17.0\"` (one wheel + one sdist on PyPI):\n\n```toml\n[[packages]]\nname = \"six\"\nversion = \"1.17.0\"\nindex = \"https://pypi.org/simple/\"\nwheels = [\n    {name = \"six-1.17.0-py3-none-any.whl\", url = \"https://pypi.org/simple/six/six-1.17.0-py3-none-any.whl\", hashes = {sha256 = \"4721f391ed90541fddacab5acf947aa0d3dc7d27b2e1e8eda2be8970586c3274\"}},\n    {name = \"six-1.17.0-py3-none-any.whl\", url = \"https://pypi.org/simple/six/six-1.17.0-py3-none-any.whl\", hashes = {sha256 = \"ff70335d468e7eb6ec65b95b99d3a2836546063f63acc5171de367e834932a81\"}},\n]\n```\n\nThe second hash (`ff70335d\u2026`) belongs to `six-1.17.0.tar.gz`.\n\n### Steps to replicate\n\n1. Pipfile with `six = \"==1.17.0\"` and `[pipenv] use_pylock = true`.\n2. `pipenv lock`.\n3. Look at `pylock.toml`, or run `uv venv && uv pip install -r pylock.toml`.\n\nPipfile.lock only stores hashes, so the real file names would have to come from the index at lock time (the resolver already sees them). That's why this is an issue rather than a PR.\n\nThis issue was drafted with Claude Code; the reproduction above was run on `main` to confirm the output.\n\n", "hints_text": "", "created_at": "2026-10-17T11:13:40Z"}
{"repo": "pypa/pipenv", "pull_number": 6733, "instance_id": "pypa__pipenv-6733", "issue_numbers": ["6732"], "base_commit": "97625022b58c69e0bdef220e96bd5252a6ba537b", "patch": "diff --git a/news/6732.bugfix.rst b/news/6732.bugfix.rst\nnew file mode 100644\nindex 000000000..eb71bbc5c\n--- /dev/null\n+++ b/news/6732.bugfix.rst\n@@ -0,0 +1,1 @@\n+Raise an error when installing from a ``pylock.toml`` whose ``requires-python``, ``environments``, or a package's ``requires-python`` excludes the target Python, as PEP 751 requires.\ndiff --git a/pipenv/routines/install.py b/pipenv/routines/install.py\nindex 5ec8aed90..25beb5b6a 100644\n--- a/pipenv/routines/install.py\n+++ b/pipenv/routines/install.py\n@@ -33,6 +33,7 @@\n )\n from pipenv.utils.pipfile import ensure_pipfile\n from pipenv.utils.project import ensure_project\n+from pipenv.utils.pylock import PylockError, PylockFile\n from pipenv.utils.shell import temp_environ\n \n _LOGGER = logging.getLogger(__name__)\n@@ -83,6 +84,30 @@ def _target_marker_environment(project, allow_global=False):\n     }\n \n \n+def _check_pylock_environment(project, categories, allow_global=False):\n+    \"\"\"Raise if ``pylock.toml`` doesn't apply to the target Python environment.\n+\n+    PEP 751 requires installers to error when the lock's ``requires-python``,\n+    its ``environments``, or the ``requires-python`` of a package that would\n+    be installed excludes the environment being installed for.\n+    \"\"\"\n+    pylock = PylockFile.from_path(project.lockfile.pylock_location)\n+    dependency_groups = set(pylock.default_groups)\n+    if \"dev-packages\" in categories:\n+        dependency_groups |= set(pylock.dependency_groups)\n+    environment = _target_marker_environment(project, allow_global=allow_global)\n+    try:\n+        pylock.check_environment(\n+            extras=set(pylock.extras),\n+            dependency_groups=dependency_groups,\n+            environment=environment,\n+        )\n+    except PylockError as e:\n+        raise exceptions.PipenvException(\n+            f\"{project.lockfile.pylock_location} can't be installed: {e}\"\n+        )\n+\n+\n def _should_use_no_binary(pkg_name, extra_pip_args):\n     \"\"\"Return True if --no-binary should be recorded in the Pipfile for pkg_name.\n \n@@ -770,6 +795,15 @@ def do_install_dependencies(\n         else:\n             categories = [\"packages\"]\n \n+    if (\n+        not policy.skip_lock\n+        and project.lockfile.pylock_exists\n+        and (project.settings.use_pylock or not project.lockfile.exists)\n+    ):\n+        _check_pylock_environment(\n+            project, categories, allow_global=target.allow_global\n+        )\n+\n     # ``skip_lock`` implicitly forces ``ignore_hashes`` ON (you cannot hash\n     # packages you never resolved). Compute the effective flag locally so\n     # the frozen ``ctx`` is not mutated mid-loop.\ndiff --git a/pipenv/utils/pylock.py b/pipenv/utils/pylock.py\nindex a4b35cc36..3a46fe89d 100644\n--- a/pipenv/utils/pylock.py\n+++ b/pipenv/utils/pylock.py\n@@ -36,6 +36,12 @@ class PylockFormatError(PylockError):\n     pass\n \n \n+class PylockEnvironmentError(PylockError):\n+    \"\"\"Raised when the pylock.toml file does not apply to the target environment.\"\"\"\n+\n+    pass\n+\n+\n # pylock.toml is read several times per command; warn about a newer minor\n # lock-version once per file.\n _warned_newer_lock_versions: Set[Path] = set()\n@@ -624,12 +630,15 @@ def get_packages_for_environment(\n         self,\n         extras: Optional[Set[str]] = None,\n         dependency_groups: Optional[Set[str]] = None,\n+        environment: Optional[Dict[str, str]] = None,\n     ) -> List[Dict[str, Any]]:\n         \"\"\"Get packages that should be installed for the given environment.\n \n         Args:\n             extras: Set of extras to include\n             dependency_groups: Set of dependency groups to include\n+            environment: Marker variables that override the running\n+                interpreter's (e.g. the target virtualenv's Python version)\n \n         Returns:\n             List of package dictionaries that should be installed\n@@ -657,11 +666,14 @@ def get_packages_for_environment(\n                     marker = Marker(marker_str)\n                     # Evaluate the marker with the lock_file context\n                     # which supports extras and dependency_groups as sets\n-                    environment = {\n+                    marker_environment = {\n+                        **(environment or {}),\n                         \"extras\": _extras,\n                         \"dependency_groups\": _dependency_groups,\n                     }\n-                    if not marker.evaluate(environment=environment, context=\"lock_file\"):\n+                    if not marker.evaluate(\n+                        environment=marker_environment, context=\"lock_file\"\n+                    ):\n                         # Marker does not match, skip this package\n                         continue\n                 except InvalidMarker:\n@@ -673,6 +685,81 @@ def get_packages_for_environment(\n \n         return result\n \n+    def check_environment(\n+        self,\n+        extras: Optional[Set[str]] = None,\n+        dependency_groups: Optional[Set[str]] = None,\n+        environment: Optional[Dict[str, str]] = None,\n+    ) -> None:\n+        \"\"\"Check that the lock applies to the environment being installed for.\n+\n+        PEP 751 requires installers to raise an error when the top-level\n+        ``requires-python``, the ``environments`` list, or the\n+        ``requires-python`` of a package that would be installed excludes the\n+        environment.\n+\n+        Args:\n+            extras: Set of extras to include\n+            dependency_groups: Set of dependency groups to include\n+            environment: Marker variables that override the running\n+                interpreter's (e.g. the target virtualenv's Python version)\n+\n+        Raises:\n+            PylockEnvironmentError: If the lock doesn't apply to the environment\n+            PylockFormatError: If a ``requires-python`` or environment marker\n+                is invalid\n+        \"\"\"\n+        from pipenv.patched.pip._vendor.packaging.markers import (\n+            InvalidMarker,\n+            Marker,\n+            default_environment,\n+        )\n+        from pipenv.patched.pip._vendor.packaging.specifiers import (\n+            InvalidSpecifier,\n+            SpecifierSet,\n+        )\n+\n+        target_environment = {**default_environment(), **(environment or {})}\n+        python_version = target_environment[\"python_full_version\"]\n+\n+        def satisfies(requires_python: str) -> bool:\n+            try:\n+                specifier = SpecifierSet(requires_python)\n+            except InvalidSpecifier:\n+                raise PylockFormatError(f\"Invalid requires-python: {requires_python!r}\")\n+            return specifier.contains(python_version, prereleases=True)\n+\n+        if self.requires_python and not satisfies(self.requires_python):\n+            raise PylockEnvironmentError(\n+                f\"Python {python_version} does not satisfy the lock file's \"\n+                f\"requires-python {self.requires_python!r}\"\n+            )\n+\n+        if self.environments:\n+            try:\n+                markers = [Marker(marker) for marker in self.environments]\n+            except InvalidMarker as e:\n+                raise PylockFormatError(f\"Invalid marker in environments: {e}\")\n+            if not any(\n+                marker.evaluate(environment=target_environment) for marker in markers\n+            ):\n+                raise PylockEnvironmentError(\n+                    \"The environment does not match any of the lock file's \"\n+                    f\"environments: {self.environments}\"\n+                )\n+\n+        for package in self.get_packages_for_environment(\n+            extras=extras,\n+            dependency_groups=dependency_groups,\n+            environment=environment,\n+        ):\n+            requires_python = package.get(\"requires-python\")\n+            if requires_python and not satisfies(requires_python):\n+                raise PylockEnvironmentError(\n+                    f\"Python {python_version} does not satisfy the requires-python \"\n+                    f\"{requires_python!r} of package {package.get('name')!r}\"\n+                )\n+\n     def _narrow_package_entries(\n         self, environment: Optional[Dict[str, str]] = None\n     ) -> List[Dict[str, Any]]:\n", "test_patch": "diff --git a/tests/unit/test_pylock.py b/tests/unit/test_pylock.py\nindex c7337c333..208014a40 100644\n--- a/tests/unit/test_pylock.py\n+++ b/tests/unit/test_pylock.py\n@@ -4,7 +4,13 @@\n \n import pytest\n \n-from pipenv.utils.pylock import PylockFile, PylockFormatError, PylockVersionError, find_pylock_file\n+from pipenv.utils.pylock import (\n+    PylockEnvironmentError,\n+    PylockFile,\n+    PylockFormatError,\n+    PylockVersionError,\n+    find_pylock_file,\n+)\n \n \n @pytest.fixture\n@@ -890,3 +896,91 @@ def test_get_or_create_lockfile_from_pylock(tmp_path):\n         assert lockfile.lockfile is not None\n     finally:\n         os.chdir(old_cwd)\n+\n+\n+PY310 = {\"python_version\": \"3.10\", \"python_full_version\": \"3.10.20\"}\n+PY312 = {\"python_version\": \"3.12\", \"python_full_version\": \"3.12.4\"}\n+\n+\n+def _write_pylock(tmp_path, content):\n+    path = tmp_path / \"pylock.toml\"\n+    path.write_text(\"lock-version = '1.0'\\ncreated-by = 'test-tool'\\n\" + content)\n+    return PylockFile.from_path(path)\n+\n+\n+@pytest.mark.parametrize(\n+    \"content, message\",\n+    [\n+        (\"requires-python = '>=3.12'\\n\", \"requires-python '>=3.12'\"),\n+        (\"environments = [\\\"python_version >= '3.12'\\\"]\\n\", \"environments\"),\n+        (\n+            \"[[packages]]\\nname = 'click'\\nversion = '8.5.0'\\nrequires-python = '>=3.12'\\n\",\n+            \"of package 'click'\",\n+        ),\n+    ],\n+)\n+def test_check_environment_rejects_lock_that_excludes_target_python(\n+    tmp_path, content, message\n+):\n+    pylock = _write_pylock(tmp_path, content)\n+\n+    with pytest.raises(PylockEnvironmentError, match=message):\n+        pylock.check_environment(environment=PY310)\n+\n+\n+def test_check_environment_accepts_matching_python(tmp_path):\n+    pylock = _write_pylock(\n+        tmp_path,\n+        \"requires-python = '>=3.12'\\n\"\n+        \"environments = [\\\"python_version >= '3.12'\\\"]\\n\"\n+        \"[[packages]]\\nname = 'click'\\nversion = '8.5.0'\\nrequires-python = '>=3.12'\\n\",\n+    )\n+\n+    pylock.check_environment(environment=PY312)\n+\n+\n+def test_check_environment_skips_packages_excluded_by_marker(tmp_path):\n+    pylock = _write_pylock(\n+        tmp_path,\n+        \"[[packages]]\\nname = 'tomli'\\nversion = '2.2.1'\\n\"\n+        \"marker = \\\"python_version < '3.11'\\\"\\nrequires-python = '<3.11'\\n\",\n+    )\n+\n+    pylock.check_environment(environment=PY312)\n+\n+\n+def test_check_environment_only_checks_selected_dependency_groups(tmp_path):\n+    pylock = _write_pylock(\n+        tmp_path,\n+        \"dependency-groups = ['dev']\\n\"\n+        \"[[packages]]\\nname = 'pytest'\\nversion = '9.0.0'\\n\"\n+        \"marker = \\\"'dev' in dependency_groups\\\"\\nrequires-python = '>=3.12'\\n\",\n+    )\n+\n+    pylock.check_environment(environment=PY310)\n+    with pytest.raises(PylockEnvironmentError, match=\"of package 'pytest'\"):\n+        pylock.check_environment(dependency_groups={\"dev\"}, environment=PY310)\n+\n+\n+def test_check_environment_rejects_invalid_requires_python(tmp_path):\n+    pylock = _write_pylock(tmp_path, \"requires-python = 'not a specifier'\\n\")\n+\n+    with pytest.raises(PylockFormatError, match=\"Invalid requires-python\"):\n+        pylock.check_environment(environment=PY312)\n+\n+\n+def test_install_aborts_when_pylock_excludes_target_python(tmp_path):\n+    from unittest import mock\n+\n+    from pipenv.exceptions import PipenvException\n+    from pipenv.routines.install import _check_pylock_environment\n+\n+    path = tmp_path / \"pylock.toml\"\n+    path.write_text(\n+        \"lock-version = '1.0'\\ncreated-by = 'test-tool'\\nrequires-python = '<3'\\n\"\n+    )\n+    project = mock.Mock()\n+    project.lockfile.pylock_location = str(path)\n+\n+    with pytest.raises(PipenvException, match=\"requires-python '<3'\"):\n+        _check_pylock_environment(project, [\"packages\"], allow_global=True)\ndiff --git a/tests/unit/test_pylock_duplicate_entries.py b/tests/unit/test_pylock_duplicate_entries.py\nindex 4af338b2a..59232d601 100644\n--- a/tests/unit/test_pylock_duplicate_entries.py\n+++ b/tests/unit/test_pylock_duplicate_entries.py\n@@ -39,6 +39,27 @@ def test_convert_picks_the_entry_matching_the_environment(\n     assert lockfile[\"default\"][\"numpy\"][\"version\"] == version\n \n \n+@pytest.mark.parametrize(\"reverse\", [False, True])\n+@pytest.mark.parametrize(\n+    \"environment, version\", [(PY310, \"==1.26.4\"), (PY312, \"==2.3.0\")]\n+)\n+def test_environment_check_and_conversion_select_the_same_entry(\n+    tmp_path, reverse, environment, version\n+):\n+    entries = [\n+        NUMPY_OLD + \"requires-python = '<3.12'\\n\",\n+        NUMPY_NEW + \"requires-python = '>=3.12'\\n\",\n+    ]\n+    if reverse:\n+        entries.reverse()\n+    pylock = _write_pylock(tmp_path, \"\".join(entries))\n+\n+    pylock.check_environment(environment=environment)\n+    lockfile = pylock.convert_to_pipenv_lockfile(environment=environment)\n+\n+    assert lockfile[\"default\"][\"numpy\"][\"version\"] == version\n+\n+\n def test_convert_keeps_an_excluded_entry_when_none_matches(tmp_path):\n     pylock = _write_pylock(\n         tmp_path,\n", "problem_statement": "pipenv sync from pylock.toml does not check requires-python or environments\n### Issue description\n\n`pipenv sync` from a `pylock.toml` does not check whether the lock applies to the target Python. It installs with exit 0 and no warning when the lock's top-level `requires-python`, its `environments`, or a package's `requires-python` excludes the interpreter.\n\nThe pylock spec's Installation section requires an error in all three cases (https://packaging.python.org/en/latest/specifications/pylock-toml/#installation):\n\n> If `requires-python` is specified, check that the environment being installed for meets the requirement; an error MUST be raised if it is not met.\n\nIt says the same for `environments` and for `[[packages]] requires-python`.\n\nThis matters for the documented use of pylock.toml as a handoff between tools. A lock made on 3.12 can drop packages that only older Pythons need. If pipenv installs it on 3.10, the environment is missing those packages and nothing reports it. In our test, `uv pip compile --universal` wrote `requires-python = \">=3.12\"` and left out `tomli` (needed below 3.11). pip and uv refused that file on 3.10. `pipenv sync` installed it without `tomli`.\n\n### Expected result\n\nAn error and non-zero exit for each of the three locks below on Python 3.10, as pip 26.2.1 gives.\n\n### Actual result\n\npipenv 2026.9.1 installs `click==8.5.0` from all three, exit 0, no warning.\n\nFor comparison, pip 26.2.1 (`pip install -r pylock.toml`) on the same container:\n\n```text\nA: ERROR: Cannot select requirements from pylock file 'pylock.toml': python_full_version '3.10.20' in provided environment does not satisfy the Python version requirement '>=3.12'\nB: ERROR: Cannot select requirements from pylock file 'pylock.toml': Provided environment does not satisfy any of the environments specified in the lock file\nC: ERROR: Cannot select requirements from pylock file 'pylock.toml': python_full_version '3.10.20' in provided environment does not satisfy the Python version requirement '>=3.12' for package 'click' at packages[0]\n```\n\nReading `pipenv/utils/pylock.py` (2026.9.1, same on `main` today): `convert_to_pipenv_lockfile()` copies `requires-python` into `_meta.requires.python_version` and does not read `environments` or a package's `requires-python`. Nothing on the `sync` path compares them with the target interpreter. `get_packages_for_environment()` evaluates package markers only.\n\n### Steps to replicate\n\n`docker run --rm -it python:3.10-slim-bookworm bash`, then:\n\n```sh\npip install -q pipenv==2026.9.1\nW='wheels = [{ url = \"https://files.pythonhosted.org/packages/58/50/6c0d534c5f134586a8e1ba4e330569e32f057e33372ae556463212fb4cd3/click-8.5.0-py3-none-any.whl\", hashes = { sha256 = \"255bc9599cf7748b4b1a446ccc735421bd08a2ae529a8b88597d3de5664ee360\" } }]'\nmkdir A B C\nprintf 'lock-version = \"1.0\"\\ncreated-by = \"hand\"\\nrequires-python = \">=3.12\"\\n\\n[[packages]]\\nname = \"click\"\\nversion = \"8.5.0\"\\n%s\\n' \"$W\" > A/pylock.toml\nprintf 'lock-version = \"1.0\"\\ncreated-by = \"hand\"\\nenvironments = [\"python_version >= '\"'\"'3.12'\"'\"'\"]\\n\\n[[packages]]\\nname = \"click\"\\nversion = \"8.5.0\"\\n%s\\n' \"$W\" > B/pylock.toml\nprintf 'lock-version = \"1.0\"\\ncreated-by = \"hand\"\\n\\n[[packages]]\\nname = \"click\"\\nversion = \"8.5.0\"\\nrequires-python = \">=3.12\"\\n%s\\n' \"$W\" > C/pylock.toml\nfor c in A B C; do (cd $c && PIPENV_VENV_IN_PROJECT=1 PIPENV_YES=1 pipenv sync --python python3.10 >/dev/null 2>&1; echo \"$c exit=$? $(.venv/bin/python -m pip list --format=freeze 2>/dev/null | grep -i click)\"); done\n```\n\nOutput:\n\n```text\nA exit=0 click==8.5.0\nB exit=0 click==8.5.0\nC exit=0 click==8.5.0\n```\n\nNo Pipfile or Pipfile.lock in the directory.\n\n### Environment\n\npipenv 2026.9.1 (vendored pip 26.2.1), CPython 3.10.20, `python:3.10-slim-bookworm`, Linux x86-64. `pipenv --support` available on request.\n\nFound while testing pylock.toml handoffs between tools (uv, pdm, poetry, pip lock \u2192 pip, uv, pipenv).\n\nPrepared by CyberNative AI LLC, an AI-run company, using AI agents.\n", "hints_text": "", "created_at": "2026-10-16T02:58:32Z"}
{"repo": "pypa/pipenv", "pull_number": 6729, "instance_id": "pypa__pipenv-6729", "issue_numbers": ["5270"], "base_commit": "8f6783c5b841456fe8e0788ca2d6c07cbebbd827", "patch": "diff --git a/news/5270.bugfix.rst b/news/5270.bugfix.rst\nnew file mode 100644\nindex 000000000..d201335fa\n--- /dev/null\n+++ b/news/5270.bugfix.rst\n@@ -0,0 +1,2 @@\n+Fixed requirements export to respect an explicitly selected PyPI mirror without\n+changing the Pipfile or lockfile, while retaining private package indexes.\ndiff --git a/pipenv/cli/command.py b/pipenv/cli/command.py\nindex 1a1ba0842..bb96a33a1 100644\n--- a/pipenv/cli/command.py\n+++ b/pipenv/cli/command.py\n@@ -531,6 +531,7 @@ def cmd_requirements(args, state):\n         from_pipfile=from_pipfile,\n         no_lock=no_lock,\n         include_index=not args.exclude_index,\n+        pypi_mirror=state.pypi_mirror,\n     )\n \n \ndiff --git a/pipenv/cli/options.py b/pipenv/cli/options.py\nindex 537da09ac..15aeb03d8 100644\n--- a/pipenv/cli/options.py\n+++ b/pipenv/cli/options.py\n@@ -912,6 +912,7 @@ def build_parser():\n         \"--from-pipfile\", dest=\"from_pipfile\", action=\"store_true\", default=False\n     )\n     p.add_argument(\"--no-lock\", dest=\"no_lock\", action=\"store_true\", default=False)\n+    _add_pypi_mirror_option(p)\n \n     # \u2500\u2500 pylock \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n     p = subs.add_parser(\ndiff --git a/pipenv/routines/requirements.py b/pipenv/routines/requirements.py\nindex 6dab95b9d..075293efe 100644\n--- a/pipenv/routines/requirements.py\n+++ b/pipenv/routines/requirements.py\n@@ -6,6 +6,7 @@\n     requirements_from_lockfile,\n     requirements_from_pipfile,\n )\n+from pipenv.utils.internet import create_mirror_source, replace_pypi_sources\n \n \n def generate_requirements(\n@@ -18,6 +19,7 @@ def generate_requirements(\n     from_pipfile=False,\n     no_lock=False,\n     include_index=True,\n+    pypi_mirror=None,\n ):\n     # If --no-lock, generate from Pipfile directly without using lockfile versions\n     if no_lock:\n@@ -28,6 +30,7 @@ def generate_requirements(\n             include_markers=include_markers,\n             categories=categories,\n             include_index=include_index,\n+            pypi_mirror=pypi_mirror,\n         )\n         return\n \n@@ -41,7 +44,12 @@ def generate_requirements(\n     # We *do* normalise bare ``$VAR`` to ``${VAR}`` because pip only supports\n     # the braced form (#5272).\n     if include_index:\n-        for i, package_index in enumerate(lockfile[\"_meta\"][\"sources\"]):\n+        sources = lockfile[\"_meta\"][\"sources\"]\n+        if pypi_mirror:\n+            sources = replace_pypi_sources(\n+                sources, create_mirror_source(pypi_mirror, \"pypi\")\n+            )\n+        for i, package_index in enumerate(sources):\n             prefix = \"-i\" if i == 0 else \"--extra-index-url\"\n             url = re.sub(\n                 r\"\\$([A-Za-z_][A-Za-z0-9_]*)\",\n@@ -104,6 +112,7 @@ def _generate_requirements_from_pipfile(\n     include_markers=True,\n     categories=\"\",\n     include_index=True,\n+    pypi_mirror=None,\n ):\n     \"\"\"Generate requirements directly from Pipfile using flexible version specifiers.\n \n@@ -115,6 +124,10 @@ def _generate_requirements_from_pipfile(\n     # Print index URLs from Pipfile sources (unless excluded)\n     if include_index:\n         sources = parsed_pipfile.get(\"source\", [])\n+        if pypi_mirror:\n+            sources = replace_pypi_sources(\n+                sources, create_mirror_source(pypi_mirror, \"pypi\")\n+            )\n         for i, source in enumerate(sources):\n             url = source.get(\"url\", \"\")\n             if url:\n", "test_patch": "diff --git a/tests/unit/test_requirements_mirror.py b/tests/unit/test_requirements_mirror.py\nnew file mode 100644\nindex 000000000..75cf31179\n--- /dev/null\n+++ b/tests/unit/test_requirements_mirror.py\n@@ -0,0 +1,55 @@\n+\"\"\"Offline public CLI regression for requirements mirror selection (#5270).\"\"\"\n+\n+import json\n+import os\n+import subprocess\n+import sys\n+from pathlib import Path\n+\n+import pytest\n+\n+\n+@pytest.mark.parametrize(\"no_lock\", [False, True])\n+@pytest.mark.parametrize(\"selection\", [\"flag\", \"env\", \"precedence\", \"none\", \"excluded\"])\n+def test_requirements_mirror(tmp_path, no_lock, selection):\n+    source = Path(__file__).resolve().parents[2]\n+    sources = [\n+        {\"url\": \"https://pypi.org/simple\", \"name\": \"pypi\", \"verify_ssl\": True},\n+        {\"url\": \"https://private.example/simple\", \"name\": \"private\", \"verify_ssl\": True},\n+    ]\n+    pipfile = (\n+        \"\\n\".join(f'[[source]]\\nurl = \"{s[\"url\"]}\"\\nname = \"{s[\"name\"]}\"\\nverify_ssl = true\\n' for s in sources)\n+        + '\\n[packages]\\nexample = \"==1.2.3\"\\n'\n+    )\n+    lock = json.dumps(\n+        {\n+            \"_meta\": {\"sources\": sources, \"hash\": {\"sha256\": \"0\" * 64}, \"pipfile-spec\": 6},\n+            \"default\": {\"example\": {\"version\": \"==1.2.3\"}},\n+            \"develop\": {},\n+        }\n+    )\n+    (tmp_path / \"Pipfile\").write_text(pipfile)\n+    (tmp_path / \"Pipfile.lock\").write_text(lock)\n+    env = os.environ.copy()\n+    env.pop(\"PIPENV_PYPI_MIRROR\", None)\n+    env.update(PYTHONPATH=str(source), PIPENV_PIPFILE=str(tmp_path / \"Pipfile\"), PIPENV_IGNORE_VIRTUALENVS=\"1\", PIPENV_DONT_LOAD_ENV=\"1\")\n+    args = [sys.executable, \"-m\", \"pipenv\", \"requirements\"]\n+    if no_lock:\n+        args.append(\"--no-lock\")\n+    if selection in (\"env\", \"precedence\"):\n+        env[\"PIPENV_PYPI_MIRROR\"] = \"https://env.example/simple\"\n+    if selection in (\"flag\", \"precedence\", \"excluded\"):\n+        args.extend([\"--pypi-mirror\", \"https://flag.example/simple\"])\n+    if selection == \"excluded\":\n+        args.append(\"--exclude-index\")\n+    result = subprocess.run(args, cwd=tmp_path, env=env, text=True, capture_output=True, check=False)\n+    assert result.returncode == 0, result.stderr\n+    lines = result.stdout.splitlines()\n+    if selection == \"excluded\":\n+        assert lines == [\"example==1.2.3\"]\n+    else:\n+        host = \"env\" if selection == \"env\" else \"flag\"\n+        index = \"https://pypi.org/simple\" if selection == \"none\" else f\"https://{host}.example/simple\"\n+        assert lines == [f\"-i {index}\", \"--extra-index-url https://private.example/simple\", \"example==1.2.3\"]\n+    assert (tmp_path / \"Pipfile\").read_text() == pipfile\n+    assert (tmp_path / \"Pipfile.lock\").read_text() == lock\n", "problem_statement": "pipenv requirements should support the usage of pypi-mirror\n_pipenv requirements_, that replaced _pipenv lock --requirements..._ does not support the usage of pypi-mirrors anymore\r\n\r\n### Problem\r\n\r\nSometimes one needs to install packages from a different index than pypi.org\r\n\r\n### Desired Solution\r\n\r\n A pypi mirror can be used with the pipenv requirements command as with other commands by supporting the --pypi-mirror flag and/or the environment variable PIPENV_PYPI_MIRROR\r\n\r\n\n", "hints_text": "@mtreffert-bhs Could you provide an example of what the desired output looks like with a sample `Pipfile.lock`?\n@matteius sure. Please find attached a minimal Pipfile.lock without any packages. I just added a \".txt\" suffix, so that the file is accepted by the upload function.\r\n[Pipfile.lock.txt](https://github.com/pypa/pipenv/files/9372633/Pipfile.lock.txt)\r\n\r\n# Desired Output without mirror:\r\n`pipenv requirements > requirements.txt` \r\nshould result in\r\n`-i https://pypi.org/simple`\r\n\r\n# Desired Output with mirror:\r\n`pipenv requirements --pypi-mirror https://example.com/simple > requirements.txt` \r\nshould result in\r\n`-i https://example.com/simple` \r\n\r\n\r\n\r\n\n`pipenv lock --requirements` locking before printing out requirements, `pypi-mirror` could be checked. Since the new `pipenv requirements` doesn\u2019t rely on locking, it just get ouput from `Pipfile.lock`, it might be dangerous to have `pypi-mirror` as an option. For example in case passed `pypi-mirror` isn\u2019t usable.\nI think there is an alternative solution that is : \r\n\r\n`pipenv lock --pypi-mirror` should write `pypi-mirror` into `Pipfile.lock`.\r\n\r\n Then `pipenv requirement` could use that mirror since it\u2019s written in `Pipfile.lock`.\nWriting the mirror into Pipfile.lock might not always be sufficiant, e. G. if the mirror-link contains a token. Then the Pipfile.lock cannot be added to version-control anymore without leaking sensitive information.\r\n\r\nIn my opinion it makes totally sense, that `pipenv requirements` just overrides the mirror if the parameter is passed or the environment-variable is set, no matter if it locks before or not. But maybe i miss something\n`pipenv requirements` have to resolve dependencies to generate correctly requirements. It should either resolve by itself, or depend on `Pipfile.lock`, so locking before generate requirements makes sense.\r\n\r\nEven if we pass in a mirror, I think it should not overrides without knowing if that mirror is valid or not.\r\n\r\nAnd we could use environment variable inside `Pipfile.lock`, so no sensitive information would be leaked.\nActually the environment-variable is the solution that i currently use as a \"workaround\". I works, but i still think that overriding is legitimate, when it is explicitely passed through the parameter.\nWe cannot automatically allow credentials into the Pipfile and Pipfile lock for security reasons.  See also #5298 because we just did something similar there to only pull in the index unredacted if the credentials are not revealed.\n@mtreffert-bhs Can you explain how you use the environment-variable workaround so that I have a better understanding of the current behavior?", "created_at": "2026-10-11T06:15:52Z"}
{"repo": "pypa/pipenv", "pull_number": 6728, "instance_id": "pypa__pipenv-6728", "issue_numbers": ["6727"], "base_commit": "e7ea4012b25075d09c37748928d44ec7201b89ae", "patch": "diff --git a/news/6727.bugfix.rst b/news/6727.bugfix.rst\nnew file mode 100644\nindex 0000000000..9b7452f6a5\n--- /dev/null\n+++ b/news/6727.bugfix.rst\n@@ -0,0 +1,8 @@\n+``Requires-Python`` exclusions such as ``!=3.0.*, !=3.1.*`` are now translated\n+into one ``python_version != '...'`` clause per version instead of being\n+collapsed into ``python_version not in '3.0, 3.1'``.  Multiple ``==`` versions\n+are likewise rendered as a parenthesized ``or`` group rather than ``in``.\n+Marker ``in``/``not in`` use string containment, so the collapsed forms were\n+not valid version comparisons (for example ``'3.1' in '3.10, 3.11'`` is true).\n+Existing markers that use ``not in`` with ``python_version`` are now parsed\n+correctly when merging markers, keeping exactly the listed versions.\ndiff --git a/pipenv/utils/markers.py b/pipenv/utils/markers.py\nindex 416405514a..c5d8bc914a 100644\n--- a/pipenv/utils/markers.py\n+++ b/pipenv/utils/markers.py\n@@ -14,7 +14,6 @@\n )\n \n MAX_VERSIONS = {1: 7, 2: 7, 3: 11, 4: 0}\n-DEPRECATED_VERSIONS = [\"3.0\", \"3.1\", \"3.2\", \"3.3\"]\n \n \n class RequirementError(Exception):\n@@ -212,7 +211,10 @@ def normalize_specifier_set(specs):\n # And rename it to something meaningful\n def get_sorted_version_string(version_set):\n     # type: (Set[AnyStr]) -> AnyStr\n-    version_list = sorted(f\"{_format_version(version)}\" for version in version_set)\n+    version_list = [\n+        _format_version(version)\n+        for version in sorted(version_set, key=_version_sort_key)\n+    ]\n     version = \", \".join(version_list)\n     return version\n \n@@ -245,8 +247,12 @@ def cleanup_pyspecs(specs, joiner=\"or\"):\n             \"and\": get_sorted_version_string,\n         },\n     }\n+    # Multiple ``==`` versions become an ``in`` group, which\n+    # :func:`format_pyversion` renders as a parenthesized ``or`` of ``==``\n+    # clauses.  Multiple ``!=`` versions are emitted as separate clauses rather\n+    # than ``not in``: marker ``in``/``not in`` use string containment, so\n+    # ``'3.1' in '3.10, 3.11'`` would be true (see #6727).\n     op_translations = {\n-        \"!=\": lambda x: \"not in\" if len(x) > 1 else \"!=\",\n         \"==\": lambda x: \"in\" if len(x) > 1 else \"==\",\n     }\n     translation_keys = list(translation_map.keys())\n@@ -258,10 +264,27 @@ def cleanup_pyspecs(specs, joiner=\"or\"):\n         version_value = versions\n         if op_key is not None:\n             version_value = translation_map[op_key][joiner](versions)\n+        if op == \"!=\":\n+            for version in versions:\n+                results[(op, _format_version(version))] = _format_version(version)\n+            continue\n         if op in op_translations:\n             op = op_translations[op](versions)\n         results[(op, op_and_version_type[1])] = version_value\n-    return sorted([(k[0], v) for k, v in results.items()], key=operator.itemgetter(1))\n+    return sorted(\n+        [(k[0], v) for k, v in results.items()],\n+        key=lambda item: _version_sort_key(item[1]),\n+    )\n+\n+\n+def _version_sort_key(value):\n+    # type: (Union[AnyStr, Tuple]) -> Tuple\n+    value = _format_version(value)\n+    first = value.split(\",\")[0].strip()\n+    try:\n+        return (0, tuple(int(part) for part in first.split(\".\")), value)\n+    except ValueError:\n+        return (1, (), value)\n \n \n # TODO: Rename this to something meaningful\n@@ -491,8 +514,6 @@ def _split_specifierset_str(specset_str, prefix=\"==\"):\n         values = [v.strip() for v in specset_str.split()]\n     else:\n         values = [v.strip() for v in specset_str.split(\",\")]\n-    if prefix == \"!=\" and any(v in values for v in DEPRECATED_VERSIONS):\n-        values += DEPRECATED_VERSIONS[:]\n     for value in sorted(values):\n         specifiers.add(Specifier(f\"{prefix}{value}\"))\n     return specifiers\n@@ -590,7 +611,7 @@ def parse_marker_dict(marker_dict):\n         # to be smashed together\n         specs = set()\n         if lhs == \"python_version\":\n-            marker = Marker(\"{lhs}{op}{rhs}\".format(**marker_dict))\n+            marker = Marker(\"{lhs} {op} {rhs}\".format(**marker_dict))\n             marker_parts = getattr(marker, \"_markers\", [])\n             _set = get_specset(marker_parts)\n             if _set:\n@@ -649,6 +670,9 @@ def marker_from_specifier(spec) -> Marker:\n \n def format_pyversion(parts):\n     op, val = parts\n+    if op == \"in\":\n+        clauses = [format_pyversion((\"==\", v.strip())) for v in val.split(\",\")]\n+        return \"({})\".format(\" or \".join(clauses))\n     version_marker = (\n         \"python_full_version\" if _contains_micro_version(val) else \"python_version\"\n     )\n", "test_patch": "diff --git a/tests/integration/fixtures/resolver_protocol/response.json b/tests/integration/fixtures/resolver_protocol/response.json\nindex b0f382e753..e49faab5f1 100644\n--- a/tests/integration/fixtures/resolver_protocol/response.json\n+++ b/tests/integration/fixtures/resolver_protocol/response.json\n@@ -18,7 +18,7 @@\n           \"sha256:8abb2f1d86890a2dfb989f9a77cfcfd3e47c2a354b01111771326f8aa26e0254\"\n         ],\n         \"index\": \"pypi\",\n-        \"markers\": \"python_version >= '2.7' and python_version not in '3.0, 3.1, 3.2'\",\n+        \"markers\": \"python_version >= '2.7' and python_version != '3.0' and python_version != '3.1' and python_version != '3.2'\",\n         \"name\": \"six\",\n         \"version\": \"==1.16.0\"\n       }\ndiff --git a/tests/unit/test_markers.py b/tests/unit/test_markers.py\nnew file mode 100644\nindex 0000000000..5c9722bab0\n--- /dev/null\n+++ b/tests/unit/test_markers.py\n@@ -0,0 +1,88 @@\n+import pytest\n+\n+from pipenv.patched.pip._vendor.packaging.markers import Marker\n+from pipenv.utils.markers import (\n+    marker_from_specifier,\n+    merge_markers,\n+    normalize_marker_str,\n+)\n+\n+\n+def _evaluate(marker, python_version, python_full_version=None):\n+    return Marker(str(marker)).evaluate(\n+        {\n+            \"python_version\": python_version,\n+            \"python_full_version\": python_full_version or f\"{python_version}.0\",\n+        }\n+    )\n+\n+\n+@pytest.mark.utils\n+def test_requires_python_exclusions_do_not_use_string_containment():\n+    # colorama 0.4.6 Requires-Python (#6727)\n+    marker = marker_from_specifier(\n+        \"!=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*, !=3.4.*, !=3.5.*, !=3.6.*, >=2.7\"\n+    )\n+    marker_str = str(marker)\n+    assert \" in \" not in marker_str\n+    assert marker_str == (\n+        'python_version >= \"2.7\" and python_version != \"3.0\" and '\n+        'python_version != \"3.1\" and python_version != \"3.2\" and '\n+        'python_version != \"3.3\" and python_version != \"3.4\" and '\n+        'python_version != \"3.5\" and python_version != \"3.6\"'\n+    )\n+    assert _evaluate(marker, \"2.7\")\n+    assert not _evaluate(marker, \"3.1\")\n+    assert _evaluate(marker, \"3.10\")\n+    assert _evaluate(marker, \"3.11\")\n+\n+\n+@pytest.mark.utils\n+def test_requires_python_exclusions_sort_by_version():\n+    marker = marker_from_specifier(\"!=3.10.*, !=3.9.*, !=3.2.*, >=2.7\")\n+    assert str(marker) == (\n+        'python_version >= \"2.7\" and python_version != \"3.2\" and '\n+        'python_version != \"3.9\" and python_version != \"3.10\"'\n+    )\n+    assert not _evaluate(marker, \"3.10\")\n+    assert _evaluate(marker, \"3.1\")\n+\n+\n+@pytest.mark.utils\n+def test_normalize_legacy_not_in_marker():\n+    marker_str = normalize_marker_str(\n+        \"python_version not in '3.0, 3.1' and python_version >= '2.7'\"\n+    )\n+    assert marker_str == (\n+        \"python_version >= '2.7' and python_version != '3.0' and \"\n+        \"python_version != '3.1'\"\n+    )\n+    assert not _evaluate(marker_str, \"3.1\")\n+    assert _evaluate(marker_str, \"3.2\")\n+    assert _evaluate(marker_str, \"3.10\")\n+\n+\n+@pytest.mark.utils\n+def test_normalize_multiple_equals_uses_or_group():\n+    marker_str = normalize_marker_str(\"python_version in '3.6, 3.7'\")\n+    assert marker_str == \"(python_version == '3.6' or python_version == '3.7')\"\n+    assert _evaluate(marker_str, \"3.7\")\n+    assert not _evaluate(marker_str, \"3.8\")\n+\n+\n+@pytest.mark.utils\n+def test_normalize_multiple_equals_sorts_by_version():\n+    marker_str = normalize_marker_str(\"python_version in '3.10, 3.9'\")\n+    assert marker_str == \"(python_version == '3.9' or python_version == '3.10')\"\n+\n+\n+@pytest.mark.utils\n+def test_merge_markers_keeps_individual_exclusions():\n+    merged = merge_markers(\n+        \"python_version >= '3.7'\",\n+        \"python_version != '3.8' and sys_platform == 'linux'\",\n+    )\n+    assert str(merged) == (\n+        'python_version >= \"3.7\" and python_version != \"3.8\" and '\n+        'sys_platform == \"linux\"'\n+    )\n", "problem_statement": "Semantically dubious `python_requires` environment markers\n### Issue description\n\nThe environment marker handling in `pipenv` collapses long sequences of multiple `!=` checks in `Requires-Python` into a string `not in` subsequence comparison.\n\nFor example, `colorama` 0.4.6 has a `Requires-Python` field which specifies `!=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*, !=3.4.*, !=3.5.*, !=3.6.*, >=2.7`. When added to `Pipfile`, `pipenv` translates this to `python_version >= '2.7' and python_version not in '3.0, 3.1, 3.2, 3.3, 3.4, 3.5, 3.6'` (and that transformed marker is also used when exporting to the `requirements.txt` format with `pipenv requirements`).\n\nWhile not explicitly disallowed by the original wording of the environment marker specification, this string subsequence translation isn't semantically valid because version numbers may be subsequences of other version numbers while remaining distinct (for example, `\"3.1\" in \"3.9, 3.10\"` would be true using string semantics, but is not true under correct version set semantics).\n\nThe specification wording was clarified in https://github.com/pypa/packaging.python.org/pull/1988, but the portability problem for environment marker evaluation existed even prior to that update.\n\n(Originally posted for discussion at https://discuss.python.org/t/dependency-specifiers-in-and-not-in-on-version-fields/108340, since the environment marker specification didn't explicitly disallow this until the clarifications published earlier in 2026. I eventually decided it was outright incorrect behaviour due to the subsequence matching problem)\n\n### Expected result\n\nEven if it makes for incredibly verbose environment markers, `pipenv` should not rely on invalid version number comparisons falling back to semantically dubious (and potentially non-portable) string subsequence checks.\n\n### Actual result\n\n`pipenv` attempts to \"simplify\" long sequences of `python_version` comparisons in translated Python version requirements, giving the problematic result described above.\n\n### Steps to replicate\n\n1. In a non-project folder, run `pipenv install colorama==0.4.6`\n2. Inspect the `colorama` entry in the generated `Pipfile.lock`\n\n-------------------------------------------------------------------------------\n\n```\n$ pipenv --version\npipenv, version 2026.8.0\n```\n", "hints_text": "", "created_at": "2026-10-09T06:15:18Z"}
{"repo": "pypa/pipenv", "pull_number": 6725, "instance_id": "pypa__pipenv-6725", "issue_numbers": ["6723"], "base_commit": "31c088c81841127254003d589dd1861d834e8234", "patch": "diff --git a/docs/cli.md b/docs/cli.md\nindex 5f6b5730e..0258eb856 100644\n--- a/docs/cli.md\n+++ b/docs/cli.md\n@@ -160,6 +160,16 @@ $ pipenv lock --categories=\"docs,tests\"\n \n Installs all packages specified in Pipfile.lock.\n \n+> **Note**: `pipenv sync` only installs and updates packages. It does not\n+> uninstall packages that are present in the virtualenv but missing from\n+> `Pipfile.lock` (for example, a transitive dependency dropped by an upgrade).\n+> To make the environment match the lock file exactly, follow it with\n+> [`pipenv clean`](#clean):\n+>\n+> ```bash\n+> $ pipenv sync && pipenv clean\n+> ```\n+\n ```bash\n pipenv sync [OPTIONS]\n ```\n@@ -414,7 +424,7 @@ $ pipenv graph --json\n \n ### clean\n \n-Uninstalls all packages not specified in Pipfile.lock.\n+Uninstalls all packages not specified in Pipfile.lock. Use it after [`sync`](#sync), which installs packages but never removes them.\n \n ```bash\n pipenv clean [OPTIONS]\ndiff --git a/docs/commands.md b/docs/commands.md\nindex 86e4a84f1..1d766e3b7 100644\n--- a/docs/commands.md\n+++ b/docs/commands.md\n@@ -92,7 +92,7 @@ The `--ignore-pipfile` flag is similar to `pipenv sync`, but with an important d\n \n - **`pipenv install --ignore-pipfile`**: Installs packages from `Pipfile.lock`, ignoring the `Pipfile`. However, it may still attempt to re-lock your dependencies unless you also use the `--deploy` flag.\n \n-- **`pipenv sync`**: Installs packages exactly as specified in `Pipfile.lock` without ever attempting to re-lock. This is considered an atomic operation.\n+- **`pipenv sync`**: Installs packages exactly as specified in `Pipfile.lock` without ever attempting to re-lock. Like `install`, it does not remove packages that are installed but absent from the lock file; see [`clean`](#clean).\n \n **For deployment scenarios, `pipenv sync` is the recommended command** because it guarantees that no modifications will be made to your lock file.\n \n@@ -103,14 +103,27 @@ $ pipenv install --ignore-pipfile\n # Production: never re-locks, fails if lock is out of date\n $ pipenv install --ignore-pipfile --deploy\n \n-# Production (recommended): atomic install from lock file\n+# Production (recommended): install from lock file without re-locking\n $ pipenv sync\n+\n+# Long-lived environments: also remove packages no longer in the lock file\n+$ pipenv sync && pipenv clean\n ```\n \n ## sync\n \n The `sync` command installs dependencies from the Pipfile.lock without making any changes to the lockfile. This is useful for deployment scenarios where you want to ensure exact package versions are installed.\n \n+> **Note**: `pipenv sync` only installs and updates packages. It does not\n+> uninstall packages that are present in the virtualenv but missing from\n+> `Pipfile.lock` (for example, a transitive dependency dropped by an upgrade).\n+> To make the environment match the lock file exactly, follow it with\n+> [`pipenv clean`](#clean):\n+>\n+> ```bash\n+> $ pipenv sync && pipenv clean\n+> ```\n+\n ### Basic Usage\n \n ```bash\n@@ -491,7 +504,9 @@ You can then recreate it with `pipenv install`.\n \n ## clean\n \n-The `clean` command uninstalls all packages not specified in Pipfile.lock.\n+The `clean` command uninstalls all packages not specified in Pipfile.lock. Packages locked in any category are kept, regardless of which categories were installed.\n+\n+Since [`sync`](#sync) and `install` never remove packages, run `clean` after them when an environment is reused rather than rebuilt from scratch (for example, a long-lived dev virtualenv or a non-containerised server).\n \n ### Basic Usage\n \ndiff --git a/docs/workflows.md b/docs/workflows.md\nindex 9782d789a..b490eeb86 100644\n--- a/docs/workflows.md\n+++ b/docs/workflows.md\n@@ -141,6 +141,9 @@ $ pipenv clean\n $ pipenv clean --dry-run\n ```\n \n+`pipenv install` and `pipenv sync` never uninstall anything, so packages dropped from\n+`Pipfile.lock` stay installed until you run `pipenv clean`.\n+\n ## Deployment Workflows\n \n ### Preparing for Deployment\n@@ -164,6 +167,10 @@ $ pipenv install --deploy\n \n # For systems that don't support virtual environments\n $ pipenv install --system --deploy\n+\n+# If the virtualenv is reused between deploys (not rebuilt from scratch),\n+# also remove packages that are no longer in the lock file\n+$ pipenv sync && pipenv clean\n ```\n \n ### Continuous Integration\ndiff --git a/news/6723.doc.rst b/news/6723.doc.rst\nnew file mode 100644\nindex 000000000..be862e55c\n--- /dev/null\n+++ b/news/6723.doc.rst\n@@ -0,0 +1,3 @@\n+Documented that ``pipenv sync`` does not uninstall packages missing from\n+``Pipfile.lock``, cross-linked ``sync`` and ``clean``, and added the\n+``pipenv sync && pipenv clean`` pattern to the deployment workflow docs.\n", "test_patch": "", "problem_statement": "Document that `pipenv sync` does not uninstall packages missing from `Pipfile.lock`\n`pipenv sync` only installs packages from `Pipfile.lock`. It never removes packages that are installed in the virtualenv but absent from the lockfile (for example, a dependency dropped by a library update). This is currently the expected (albeit counter-intuitive) behaviour (see #3365 and #4621), but it isn't mentioned anywhere in the docs.\n\nUsers coming from `uv sync`, `poetry sync` or `pip-sync` expect `sync` to make the environment match the lockfile, and the current docs reinforce that expectation:\n\n- [`docs/commands.md`](https://github.com/pypa/pipenv/blob/31c088c81841127254003d589dd1861d834e8234/docs/commands.md?plain=1#L95) recommends `pipenv sync` for production and calls it an \"atomic operation\", without saying that extraneous packages are left in place.\n- `pipenv clean` is [documented](https://github.com/pypa/pipenv/blob/31c088c81841127254003d589dd1861d834e8234/docs/commands.md?plain=1#L492) (\"uninstalls all packages not specified in Pipfile.lock\"), but neither the `sync` nor the `clean` section cross-references the other, and [`docs/workflows.md`](https://github.com/pypa/pipenv/blob/31c088c81841127254003d589dd1861d834e8234/docs/workflows.md?plain=1#L134) only lists `clean` under \"Cleaning Up Dependencies\".\n\nSuggested changes:\n\n1. Add a note to the `sync` section ([`docs/commands.md`](https://github.com/pypa/pipenv/blob/31c088c81841127254003d589dd1861d834e8234/docs/commands.md?plain=1#L110) and [`docs/cli.md`](https://github.com/pypa/pipenv/blob/31c088c81841127254003d589dd1861d834e8234/docs/cli.md?plain=1#L159)) that it currently only adds/updates packages and doesn't remove ones missing from the lockfile.\n2. Add the `pipenv sync && pipenv clean` pattern to the deployment workflows, for environments that aren't rebuilt from scratch.\n3. Cross-link `sync` and `clean`.\n4. Reword \"atomic operation\" so it doesn't imply the environment ends up matching the lockfile.\n\n", "hints_text": "", "created_at": "2026-10-08T20:39:25Z"}
{"repo": "pypa/pipenv", "pull_number": 6717, "instance_id": "pypa__pipenv-6717", "issue_numbers": ["5740"], "base_commit": "3f1b272abd51d7d7ab7f5935bb6b25da86e93e8b", "patch": "diff --git a/docs/advanced.md b/docs/advanced.md\nindex 49dfeae6e5..48f27bda14 100644\n--- a/docs/advanced.md\n+++ b/docs/advanced.md\n@@ -22,6 +22,19 @@ This is particularly useful for:\n - Controlling cache behavior\n - Specifying platform-specific wheels\n \n+### Persisting Build Backend Settings\n+\n+For editable packages, use `--config-settings` to pass a PEP 517 build-backend\n+setting and record it with the package in the `Pipfile`:\n+\n+```bash\n+$ pipenv install --editable . --config-settings editable_mode=strict\n+```\n+\n+Pipenv stores the setting as package-level `pip_args`, and reuses it during\n+future installs and syncs. Repeat the option when a backend needs more than\n+one setting.\n+\n ### Common Use Cases\n \n #### Using System Certificate Stores\ndiff --git a/news/5740.feature.rst b/news/5740.feature.rst\nnew file mode 100644\nindex 0000000000..2fd13d7066\n--- /dev/null\n+++ b/news/5740.feature.rst\n@@ -0,0 +1,3 @@\n+Persist per-package pip build arguments from ``pipenv install --config-settings``\n+in the Pipfile and lockfile so editable builds can be reproduced by later\n+installs and syncs.\ndiff --git a/pipenv/cli/command.py b/pipenv/cli/command.py\nindex f427d6a729..bdf6ab3075 100644\n--- a/pipenv/cli/command.py\n+++ b/pipenv/cli/command.py\n@@ -93,6 +93,7 @@ def cmd_install(args, state):\n         requirementstxt=state.installstate.requirementstxt,\n         # execution_options\n         extra_pip_args=state.installstate.extra_pip_args,\n+        config_settings=state.installstate.config_settings,\n         resolver=state.resolver,\n     )\n     do_install(state.project, ctx)\ndiff --git a/pipenv/cli/options.py b/pipenv/cli/options.py\nindex 6b289b518b..7010e75494 100644\n--- a/pipenv/cli/options.py\n+++ b/pipenv/cli/options.py\n@@ -43,6 +43,7 @@ def __init__(self):\n         self.packages = []\n         self.editables = []\n         self.extra_pip_args = []\n+        self.config_settings = []\n         self.categories = []\n         self.skip_lock = False\n         self.all_categories = False\n@@ -183,6 +184,17 @@ def _add_extra_pip_args(p):\n     )\n \n \n+def _add_config_settings_option(p):\n+    p.add_argument(\n+        \"--config-settings\",\n+        dest=\"config_settings\",\n+        action=\"append\",\n+        default=None,\n+        metavar=\"KEY=VALUE\",\n+        help=\"Pass a build-backend configuration setting to pip for this package.\",\n+    )\n+\n+\n def _add_python_option(p):\n     p.add_argument(\n         \"--python\",\n@@ -362,6 +374,7 @@ def _add_sync_options(p):\n \n def _add_install_options(p):\n     _add_sync_options(p)\n+    _add_config_settings_option(p)\n     _add_index_option(p)\n     _add_requirementstxt_option(p)\n     _add_ignore_pipfile_option(p)\n@@ -947,6 +960,10 @@ def build_state(args):\n     if raw_extra_pip_args:\n         state.installstate.extra_pip_args = raw_extra_pip_args.split()\n \n+    state.installstate.config_settings = list(\n+        getattr(args, \"config_settings\", None) or []\n+    )\n+\n     state.installstate.packages = list(getattr(args, \"packages\", []))\n     state.installstate.editables = list(getattr(args, \"editables\", None) or [])\n \ndiff --git a/pipenv/routines/context.py b/pipenv/routines/context.py\nindex 0c3b8eec16..7fb2e322f6 100644\n--- a/pipenv/routines/context.py\n+++ b/pipenv/routines/context.py\n@@ -124,6 +124,7 @@ class ExecutionOptions:\n     \"\"\"\n \n     extra_pip_args: Sequence[str] = ()\n+    config_settings: Sequence[str] = ()\n     requirements_directory: str | None = None\n     no_deps: bool = False\n     ignore_hashes: bool = False\n@@ -185,6 +186,7 @@ def from_cli(  # noqa: PLR0913 \u2014 single CLI-defaults materialization point; se\n         requirementstxt: str | None = None,\n         # execution_options\n         extra_pip_args: Sequence[str] = (),\n+        config_settings: Sequence[str] = (),\n         requirements_directory: str | None = None,\n         no_deps: bool = False,\n         ignore_hashes: bool = False,\n@@ -203,7 +205,8 @@ def from_cli(  # noqa: PLR0913 \u2014 single CLI-defaults materialization point; se\n         by passing ``allow_global=`` explicitly.\n \n         Sequence-typed inputs (``packages``, ``editable_packages``,\n-        ``categories``, ``extra_pip_args``) are tuple-coerced so the\n+        ``categories``, ``extra_pip_args``, and ``config_settings``) are\n+        tuple-coerced so the\n         resulting dataclasses stay genuinely immutable even if the\n         caller hands in a list.\n         \"\"\"\n@@ -241,6 +244,7 @@ def from_cli(  # noqa: PLR0913 \u2014 single CLI-defaults materialization point; se\n             ),\n             execution_options=ExecutionOptions(\n                 extra_pip_args=tuple(extra_pip_args),\n+                config_settings=tuple(config_settings),\n                 requirements_directory=requirements_directory,\n                 no_deps=no_deps,\n                 ignore_hashes=ignore_hashes,\ndiff --git a/pipenv/routines/install.py b/pipenv/routines/install.py\nindex 160afe6309..41c88878eb 100644\n--- a/pipenv/routines/install.py\n+++ b/pipenv/routines/install.py\n@@ -18,6 +18,7 @@\n     import_requirements,\n     install_req_from_pipfile,\n     normalize_editable_path_for_pip,\n+    requirement_from_lockfile,\n )\n from pipenv.utils.dependencies import (\n     python_version as _python_version_for_path,\n@@ -129,6 +130,80 @@ def _name_matches(value):\n     return False\n \n \n+def _split_config_settings_pip_args(config_settings, extra_pip_args):\n+    \"\"\"Separate package build settings from generic pip arguments.\n+\n+    ``--config-settings`` is a per-package build option. Keep it separate\n+    from the generic passthrough arguments so it can be recorded in the\n+    package's Pipfile entry and replayed on later installs. Returning the\n+    remaining arguments prevents legacy ``--extra-pip-args`` forms from\n+    leaking the setting into every package in a later install phase.\n+    \"\"\"\n+    pip_args = []\n+    passthrough_args = []\n+    for setting in config_settings or ():\n+        pip_args.extend((\"--config-settings\", setting))\n+\n+    args = list(extra_pip_args or ())\n+    index = 0\n+    while index < len(args):\n+        arg = args[index]\n+        if arg == \"--config-settings\" and index + 1 < len(args):\n+            pip_args.extend((arg, args[index + 1]))\n+            index += 2\n+        elif arg.startswith(\"--config-settings=\"):\n+            pip_args.extend((\"--config-settings\", arg.split(\"=\", 1)[1]))\n+            index += 1\n+        else:\n+            passthrough_args.append(arg)\n+            index += 1\n+    return pip_args, passthrough_args\n+\n+\n+def _config_settings_pip_args(config_settings, extra_pip_args):\n+    \"\"\"Return normalized pip arguments for package build settings.\"\"\"\n+    pip_args, _ = _split_config_settings_pip_args(config_settings, extra_pip_args)\n+    return pip_args\n+\n+\n+def _pip_args_for_dependency(dependency, lockfile_section, pip_line=None):\n+    \"\"\"Read reproducible, package-scoped pip arguments from a lock entry.\"\"\"\n+    dependency_name = getattr(dependency, \"name\", None)\n+\n+    def normalize(name):\n+        return str(name).lower().replace(\"-\", \"_\").replace(\".\", \"_\")\n+\n+    normalized_dependency_name = (\n+        normalize(dependency_name) if dependency_name else None\n+    )\n+    for package_name, entry in lockfile_section.items():\n+        matches_name = normalized_dependency_name and (\n+            normalize(package_name) == normalized_dependency_name\n+        )\n+        matches_requirement = False\n+        if not matches_name and pip_line and isinstance(entry, dict):\n+            generated_line = requirement_from_lockfile(\n+                package_name,\n+                entry,\n+                include_hashes=False,\n+                include_markers=False,\n+            )\n+            matches_requirement = generated_line == pip_line\n+        if not (matches_name or matches_requirement):\n+            continue\n+        if not isinstance(entry, dict):\n+            return ()\n+        pip_args = entry.get(\"pip_args\", ())\n+        if isinstance(pip_args, str):\n+            return (pip_args,)\n+        if isinstance(pip_args, (list, tuple)) and all(\n+            isinstance(arg, str) for arg in pip_args\n+        ):\n+            return tuple(pip_args)\n+        return ()\n+    return ()\n+\n+\n def handle_new_packages(\n     project,\n     ctx: RoutineContext,\n@@ -154,6 +229,9 @@ def handle_new_packages(\n     editable_packages = list(sel.editable_packages) if sel.editable_packages else []\n     pipfile_categories = list(sel.categories) if sel.categories else []\n     extra_pip_args = list(exec_opts.extra_pip_args) if exec_opts.extra_pip_args else []\n+    package_pip_args, extra_pip_args = _split_config_settings_pip_args(\n+        getattr(exec_opts, \"config_settings\", ()), extra_pip_args\n+    )\n     index = sel.index\n \n     new_packages = []\n@@ -206,12 +284,17 @@ def handle_new_packages(\n                                 sel.dev,\n                                 category,\n                                 no_binary=no_binary,\n+                                pip_args=package_pip_args or None,\n                             )\n                             if added:\n                                 new_packages.append((normalized_name, cat))\n                     else:\n                         added, cat, normalized_name = project.pipfile.add_package(\n-                            pkg_requirement, pkg_line, sel.dev, no_binary=no_binary\n+                            pkg_requirement,\n+                            pkg_line,\n+                            sel.dev,\n+                            no_binary=no_binary,\n+                            pip_args=package_pip_args or None,\n                         )\n                         if added:\n                             new_packages.append((normalized_name, cat))\n@@ -852,8 +935,8 @@ def batch_install(\n         for pkg_name, entry in lockfile_section.items()\n         if isinstance(entry, dict) and entry.get(\"no_binary\")\n     ]\n-    extra_pip_args = (\n-        list(exec_opts.extra_pip_args) if exec_opts.extra_pip_args else []\n+    _, extra_pip_args = _split_config_settings_pip_args(\n+        getattr(exec_opts, \"config_settings\", ()), exec_opts.extra_pip_args\n     )\n     if no_binary_packages:\n         extra_pip_args = list(extra_pip_args)\n@@ -906,40 +989,68 @@ def batch_install(\n     )\n \n     if search_all_sources:\n-        dependencies = [pip_line for _, pip_line in deps_to_install]\n-        batch_install_iteration(\n-            project,\n-            iter_ctx,\n-            dependencies,\n-            sources,\n-            procs,\n-            requirements_dir,\n-        )\n+        deps_by_pip_args = defaultdict(list)\n+        for dependency, pip_line in deps_to_install:\n+            deps_by_pip_args[\n+                _pip_args_for_dependency(dependency, lockfile_section, pip_line)\n+            ].append(pip_line)\n+        for package_pip_args, dependencies in deps_by_pip_args.items():\n+            phase_ctx = replace(\n+                iter_ctx,\n+                execution_options=replace(\n+                    iter_ctx.execution_options,\n+                    extra_pip_args=tuple(extra_pip_args) + package_pip_args,\n+                ),\n+            )\n+            batch_install_iteration(\n+                project,\n+                phase_ctx,\n+                dependencies,\n+                sources,\n+                procs,\n+                requirements_dir,\n+            )\n     else:\n         # Sort the dependencies out by index -- include editable/vcs in the default group\n-        deps_by_index = defaultdict(list)\n+        deps_by_index = defaultdict(lambda: defaultdict(list))\n         for dependency, pip_line in deps_to_install:\n             index = project.sources.default[\"name\"]\n             if dependency.name and dependency.name in lockfile_section:\n                 entry = lockfile_section[dependency.name]\n                 if isinstance(entry, dict) and \"index\" in entry:\n                     index = entry[\"index\"]\n-            deps_by_index[index].append(pip_line)\n+            package_pip_args = _pip_args_for_dependency(\n+                dependency, lockfile_section, pip_line\n+            )\n+            deps_by_index[index][package_pip_args].append(pip_line)\n         # Treat each index as its own pip install phase\n-        for index_name, dependencies in deps_by_index.items():\n+        for index_name, dependencies_by_args in deps_by_index.items():\n             try:\n                 install_source = next(filter(lambda s: s[\"name\"] == index_name, sources))\n-                batch_install_iteration(\n-                    project,\n-                    iter_ctx,\n-                    dependencies,\n-                    [install_source],\n-                    procs,\n-                    requirements_dir,\n-                )\n+                for package_pip_args, dependencies in dependencies_by_args.items():\n+                    phase_ctx = replace(\n+                        iter_ctx,\n+                        execution_options=replace(\n+                            iter_ctx.execution_options,\n+                            extra_pip_args=tuple(extra_pip_args) + package_pip_args,\n+                        ),\n+                    )\n+                    batch_install_iteration(\n+                        project,\n+                        phase_ctx,\n+                        dependencies,\n+                        [install_source],\n+                        procs,\n+                        requirements_dir,\n+                    )\n             except StopIteration:  # noqa: PERF203\n+                missing_dependencies = [\n+                    dependency\n+                    for dependencies in dependencies_by_args.values()\n+                    for dependency in dependencies\n+                ]\n                 console.print(\n-                    f\"Unable to find {index_name} in sources, please check dependencies: {dependencies}\",\n+                    f\"Unable to find {index_name} in sources, please check dependencies: {missing_dependencies}\",\n                     style=\"bold red\",\n                 )\n                 sys.exit(1)\ndiff --git a/pipenv/utils/dependencies.py b/pipenv/utils/dependencies.py\nindex 9a3f80331d..52f56257af 100644\n--- a/pipenv/utils/dependencies.py\n+++ b/pipenv/utils/dependencies.py\n@@ -412,6 +412,12 @@ def clean_resolved_dep(  # noqa: PLR0912\n     if dep.get(\"no_binary\"):\n         lockfile[\"no_binary\"] = True\n \n+    # Preserve per-package pip arguments (for example, ``--config-settings``\n+    # needed by editable build backends) so installs from the lockfile remain\n+    # reproducible.\n+    if dep.get(\"pip_args\"):\n+        lockfile[\"pip_args\"] = list(dep[\"pip_args\"])\n+\n     # In case we lock a uri or a file when the user supplied a path\n     # remove the uri or file keys from the entry and keep the path\n     if dep and isinstance(dep, dict):\n@@ -1379,7 +1385,7 @@ def _validate_pipfile_entry(name: str, pipfile_dict: Dict[str, Any]) -> None:\n             f\"Unrecognized option(s) in Pipfile for package '{name}': \"\n             f\"{', '.join(sorted(unknown))}. \"\n             \"Valid options include: version, extras, editable, markers, \"\n-            \"ref, git, svn, hg, bzr, path, file, index, subdirectory, \"\n+            \"ref, git, svn, hg, bzr, path, file, index, subdirectory, pip_args, \"\n             \"hashes, no_binary, skip_resolver, and PEP 508 marker keys.\"\n         )\n \ndiff --git a/pipenv/utils/pipfile.py b/pipenv/utils/pipfile.py\nindex 9ddc28a8a5..d9a8984221 100644\n--- a/pipenv/utils/pipfile.py\n+++ b/pipenv/utils/pipfile.py\n@@ -945,7 +945,13 @@ def remove_packages(self, packages) -> None:\n         self.write_toml(parsed)\n \n     def generate_entry(\n-        self, package, pip_line, category=None, index_name=None, no_binary=False\n+        self,\n+        package,\n+        pip_line,\n+        category=None,\n+        index_name=None,\n+        no_binary=False,\n+        pip_args=None,\n     ):\n         \"\"\"Build a Pipfile entry dict from an ``InstallRequirement`` and the\n         raw pip-install line that produced it.\n@@ -1037,16 +1043,31 @@ def generate_entry(\n         if no_binary:\n             entry[\"no_binary\"] = True\n \n+        if pip_args:\n+            entry[\"pip_args\"] = list(pip_args)\n+\n         if len(entry) == 1 and \"version\" in entry:\n             return name, normalized_name, specifier\n         else:\n             return name, normalized_name, entry\n \n-    def add_package(self, package, pip_line, dev=False, category=None, no_binary=False):\n+    def add_package(\n+        self,\n+        package,\n+        pip_line,\n+        dev=False,\n+        category=None,\n+        no_binary=False,\n+        pip_args=None,\n+    ):\n         \"\"\"Add a single package \u2014 generate entry + add to Pipfile.\"\"\"\n         category = category if category else \"dev-packages\" if dev else \"packages\"\n         name, normalized_name, entry = self.generate_entry(\n-            package, pip_line, category=category, no_binary=no_binary\n+            package,\n+            pip_line,\n+            category=category,\n+            no_binary=no_binary,\n+            pip_args=pip_args,\n         )\n         return self.add_entry(name, normalized_name, entry, category=category)\n \ndiff --git a/pipenv/vendor/plette/models/packages.py b/pipenv/vendor/plette/models/packages.py\nindex 2ec820d0f6..e5185f02d2 100644\n--- a/pipenv/vendor/plette/models/packages.py\n+++ b/pipenv/vendor/plette/models/packages.py\n@@ -25,6 +25,7 @@\n         \"hashes\",\n         \"index\",\n         \"no_binary\",\n+        \"pip_args\",\n         # Pipenv resolver control\n         \"skip_resolver\",\n         # Path / file source\n@@ -53,7 +54,8 @@ class PackageSpecfiers(DataModel):\n     __OPTIONAL__ = {\n         \"editable\": bool,\n         \"version\": str,\n-        \"extras\": list\n+        \"extras\": list,\n+        \"pip_args\": list,\n     }\n \n     @classmethod\n@@ -68,7 +70,7 @@ def validate(cls, data):\n                     f\"Unrecognized Pipfile option(s): {', '.join(sorted(unknown))}. \"\n                     \"Valid options include: version, extras, editable, markers, \"\n                     \"ref, git, svn, hg, bzr, path, file, index, subdirectory, \"\n-                    \"hashes, no_binary, skip_resolver, and PEP 508 marker keys.\"\n+                    \"pip_args, hashes, no_binary, skip_resolver, and PEP 508 marker keys.\"\n                 )\n \n \n", "test_patch": "diff --git a/tests/unit/test_core.py b/tests/unit/test_core.py\nindex 94a0c9e8ab..d6ad368079 100644\n--- a/tests/unit/test_core.py\n+++ b/tests/unit/test_core.py\n@@ -969,6 +969,27 @@ def test_python_flag_defaults_to_none_when_absent():\n     assert args.python is None\n \n \n+@pytest.mark.core\n+def test_install_accepts_repeatable_config_settings():\n+    \"\"\"Build backend settings should be parsed as package install options.\"\"\"\n+    from pipenv.cli.options import build_parser\n+\n+    parser = build_parser()\n+    args = parser.parse_args(\n+        [\n+            \"install\",\n+            \"--editable\",\n+            \".\",\n+            \"--config-settings\",\n+            \"editable_mode=strict\",\n+            \"--config-settings\",\n+            \"build_number=42\",\n+        ]\n+    )\n+\n+    assert args.config_settings == [\"editable_mode=strict\", \"build_number=42\"]\n+\n+\n @pytest.mark.core\n def test_run_passes_verbose_to_remaining():\n     \"\"\"Regression test for GH-6626: ``pipenv run ./manage.py test --verbose``\ndiff --git a/tests/unit/test_dependencies.py b/tests/unit/test_dependencies.py\nindex a48e313cd0..c4ad5feca1 100644\n--- a/tests/unit/test_dependencies.py\n+++ b/tests/unit/test_dependencies.py\n@@ -531,6 +531,24 @@ def test_no_binary_absent_is_not_written(self):\n \n         assert \"no_binary\" not in result.get(\"requests\", {})\n \n+    def test_pip_args_are_preserved(self):\n+        \"\"\"Per-package build arguments must survive lockfile generation.\"\"\"\n+        project = MagicMock()\n+        project.pipfile.project_directory = None\n+\n+        dep = {\n+            \"name\": \"local-project\",\n+            \"path\": \".\",\n+            \"editable\": True,\n+            \"pip_args\": [\"--config-settings\", \"editable_mode=strict\"],\n+        }\n+        result = clean_resolved_dep(project, dep)\n+\n+        assert result[\"local-project\"][\"pip_args\"] == [\n+            \"--config-settings\",\n+            \"editable_mode=strict\",\n+        ]\n+\n \n class TestShouldUseNoBinary:\n     \"\"\"Tests for the _should_use_no_binary helper in routines/install.py.\"\"\"\n@@ -586,6 +604,75 @@ def test_none_pkg_name(self):\n         assert self._call(None, [\"--no-binary\", \"cartopy\"]) is False\n \n \n+class TestConfigSettingsPipArgs:\n+    def test_explicit_settings_are_converted_to_pip_args(self):\n+        from pipenv.routines.install import _config_settings_pip_args\n+\n+        assert _config_settings_pip_args([\"editable_mode=strict\"], []) == [\n+            \"--config-settings\",\n+            \"editable_mode=strict\",\n+        ]\n+\n+    def test_legacy_extra_pip_args_are_recordable(self):\n+        from pipenv.routines.install import _config_settings_pip_args\n+\n+        assert _config_settings_pip_args(\n+            [], [\"--config-settings=editable_mode=strict\"]\n+        ) == [\"--config-settings\", \"editable_mode=strict\"]\n+\n+    def test_config_settings_are_removed_from_generic_pip_args(self):\n+        from pipenv.routines.install import _split_config_settings_pip_args\n+\n+        assert _split_config_settings_pip_args(\n+            [\"editable_mode=strict\"],\n+            [\"--no-build-isolation\", \"--config-settings=build_number=42\"],\n+        ) == (\n+            [\n+                \"--config-settings\",\n+                \"editable_mode=strict\",\n+                \"--config-settings\",\n+                \"build_number=42\",\n+            ],\n+            [\"--no-build-isolation\"],\n+        )\n+\n+    def test_package_args_match_normalized_lockfile_name(self):\n+        from pipenv.routines.install import _pip_args_for_dependency\n+\n+        dependency = MagicMock(name=\"local-package\")\n+        dependency.name = \"local_package\"\n+        lockfile = {\n+            \"local-package\": {\n+                \"path\": \".\",\n+                \"editable\": True,\n+                \"pip_args\": [\"--config-settings\", \"editable_mode=strict\"],\n+            }\n+        }\n+\n+        assert _pip_args_for_dependency(dependency, lockfile) == (\n+            \"--config-settings\",\n+            \"editable_mode=strict\",\n+        )\n+\n+    def test_path_requirement_args_match_without_requirement_name(self):\n+        from pipenv.routines.install import _pip_args_for_dependency\n+\n+        dependency = MagicMock()\n+        dependency.name = None\n+        lockfile = {\n+            \"local-project\": {\n+                \"path\": \".\",\n+                \"editable\": True,\n+                \"pip_args\": [\"--config-settings\", \"editable_mode=strict\"],\n+            }\n+        }\n+\n+        assert _pip_args_for_dependency(dependency, lockfile, \"-e .\") == (\n+            \"--config-settings\",\n+            \"editable_mode=strict\",\n+        )\n+\n+\n # ---------------------------------------------------------------------------\n # Tests for ensure_path_is_relative (issue #5925)\n # ---------------------------------------------------------------------------\ndiff --git a/tests/unit/test_install.py b/tests/unit/test_install.py\nnew file mode 100644\nindex 0000000000..f5709d7b69\n--- /dev/null\n+++ b/tests/unit/test_install.py\n@@ -0,0 +1,30 @@\n+import queue\n+from unittest.mock import MagicMock\n+\n+import pytest\n+\n+from pipenv.routines.context import RoutineContext\n+from pipenv.routines import install\n+\n+\n+def test_batch_install_reports_missing_index_without_masking_error(monkeypatch):\n+    project = MagicMock()\n+    project.settings = {}\n+    project.sources.default = {\"name\": \"missing\"}\n+    project.environment.is_satisfied.return_value = False\n+\n+    dependency = MagicMock()\n+    dependency.name = \"example\"\n+    dependency.markers = None\n+\n+    monkeypatch.setattr(install, \"get_source_list\", lambda *args, **kwargs: [])\n+\n+    with pytest.raises(SystemExit):\n+        install.batch_install(\n+            project,\n+            RoutineContext.from_cli(system=True),\n+            [(dependency, \"example==1.0\")],\n+            {},\n+            queue.Queue(maxsize=1),\n+            None,\n+        )\ndiff --git a/tests/unit/test_pipfile_entry_validation.py b/tests/unit/test_pipfile_entry_validation.py\nindex 360952360a..2634fadca8 100644\n--- a/tests/unit/test_pipfile_entry_validation.py\n+++ b/tests/unit/test_pipfile_entry_validation.py\n@@ -12,6 +12,16 @@ def test_plette_accepts_skip_resolver():\n     )\n \n \n+def test_plette_accepts_per_package_pip_args():\n+    PackageSpecfiers.validate(\n+        {\n+            \"path\": \".\",\n+            \"editable\": True,\n+            \"pip_args\": [\"--config-settings\", \"editable_mode=strict\"],\n+        }\n+    )\n+\n+\n def test_install_requirement_accepts_skip_resolver():\n     _, _, requirement = install_req_from_pipfile(\n         \"example\", {\"version\": \"*\", \"skip_resolver\": True}\n@@ -20,6 +30,19 @@ def test_install_requirement_accepts_skip_resolver():\n     assert requirement == \"example\"\n \n \n+def test_install_requirement_accepts_per_package_pip_args():\n+    _, _, requirement = install_req_from_pipfile(\n+        \"example\",\n+        {\n+            \"path\": \".\",\n+            \"editable\": True,\n+            \"pip_args\": [\"--config-settings\", \"editable_mode=strict\"],\n+        },\n+    )\n+\n+    assert requirement == \"-e .\"\n+\n+\n def test_plette_rejects_unrecognized_key():\n     with pytest.raises(DataValidationError, match=r\"Unrecognized.*commit\"):\n         PackageSpecfiers.validate({\"git\": \"https://example.test/repo.git\", \"commit\": \"abc\"})\ndiff --git a/tests/unit/test_pipfile_subsystem.py b/tests/unit/test_pipfile_subsystem.py\nindex 8209ff96fb..13113a4dc2 100644\n--- a/tests/unit/test_pipfile_subsystem.py\n+++ b/tests/unit/test_pipfile_subsystem.py\n@@ -432,6 +432,21 @@ def test_add_entry_appends_to_category(project_with_packages, tmp_path):\n     assert \"django\" in on_disk\n \n \n+@pytest.mark.utils\n+def test_add_package_records_per_package_pip_args(project_bare):\n+    from pipenv.utils.dependencies import expansive_install_req_from_line\n+\n+    package, _ = expansive_install_req_from_line(\"requests\")\n+    project_bare.pipfile.add_package(\n+        package,\n+        \"requests\",\n+        pip_args=[\"--config-settings\", \"editable_mode=strict\"],\n+    )\n+\n+    entry = project_bare.pipfile.parsed[\"packages\"][\"requests\"]\n+    assert entry[\"pip_args\"] == [\"--config-settings\", \"editable_mode=strict\"]\n+\n+\n # ---- hash ----------------------------------------------------------------\n \n \n", "problem_statement": "Feature request: `--config-settings` options with `pipenv install`\n### Is your feature request related to a problem? Please describe.\r\n\r\n`pip install` accepts `--config-settings X=Y` options, but it seems not possible to pass it using `pipenv install`.\r\n\r\n### Describe the solution you'd like\r\n\r\nI would like to be able to run `pipenv install` as following:\r\n```\r\n$ pipenv install --editable . --config-settings X=Y\r\n```\r\n\r\nThe `--config-settings` should be reflected in the `Pipfile`. So, `pipenv install` can reproduce it elsewhere.\r\n\r\n### Describe alternatives you've considered\r\n\r\nI uninstall the package and reinstall it with `pip` within the pipenv shell.\r\n```\r\n$ pip3 uninstall X\r\n$ pip3 install --editable . --config-settings X=Y\r\n```\r\n\r\n### Additional context\r\n\r\nThe motivation was to use `pip3 install --editable . --config-settings editable_mode=strict` to control setuptools.\r\n(See https://setuptools.pypa.io/en/latest/userguide/development_mode.html)\r\n\r\n-------------------------------------------------------------------------------\r\n\r\n<details><summary>$ pipenv --support</summary>\r\n\r\nPipenv version: `'2022.4.8'`\r\n\r\nPipenv location: `'/opt/homebrew/lib/python3.9/site-packages/pipenv'`\r\n\r\nPython location: `'/opt/homebrew/opt/python@3.9/bin/python3.9'`\r\n\r\nPython installations found:\r\n\r\n  - `3.10.9`: `/opt/homebrew/bin/python3`\r\n  - `3.9.16`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin/python3`\r\n  - `3.9.16`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin/python`\r\n  - `3.9.16`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin/python3.9`\r\n  - `3.9.16`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin/python3`\r\n  - `3.9.16`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin/python`\r\n  - `3.9.16`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin/python3.9`\r\n  - `3.9.16`: `/opt/homebrew/opt/python@3.9/libexec/bin/python3`\r\n  - `3.9.16`: `/opt/homebrew/opt/python@3.9/libexec/bin/python`\r\n  - `3.9.16`: `/opt/homebrew/bin/python3.9`\r\n  - `3.9.6`: `/usr/bin/python3`\r\n\r\nPEP 508 Information:\r\n\r\n```\r\n{'implementation_name': 'cpython',\r\n 'implementation_version': '3.9.16',\r\n 'os_name': 'posix',\r\n 'platform_machine': 'arm64',\r\n 'platform_python_implementation': 'CPython',\r\n 'platform_release': '21.6.0',\r\n 'platform_system': 'Darwin',\r\n 'platform_version': 'Darwin Kernel Version 21.6.0: Thu Mar  9 20:12:21 PST '\r\n                     '2023; root:xnu-8020.240.18.700.8~1/RELEASE_ARM64_T6000',\r\n 'python_full_version': '3.9.16',\r\n 'python_version': '3.9',\r\n 'sys_platform': 'darwin'}\r\n```\r\n\r\nSystem environment variables:\r\n\r\n  - `TERM_SESSION_ID`\r\n  - `SSH_AUTH_SOCK`\r\n  - `LC_TERMINAL_VERSION`\r\n  - `COLORFGBG`\r\n  - `ITERM_PROFILE`\r\n  - `XPC_FLAGS`\r\n  - `LANG`\r\n  - `PWD`\r\n  - `SHELL`\r\n  - `__CFBundleIdentifier`\r\n  - `SECURITYSESSIONID`\r\n  - `TERM_PROGRAM_VERSION`\r\n  - `TERM_PROGRAM`\r\n  - `PATH`\r\n  - `DISPLAY`\r\n  - `LC_TERMINAL`\r\n  - `COLORTERM`\r\n  - `COMMAND_MODE`\r\n  - `TERM`\r\n  - `HOME`\r\n  - `TMPDIR`\r\n  - `USER`\r\n  - `XPC_SERVICE_NAME`\r\n  - `LOGNAME`\r\n  - `LaunchInstanceID`\r\n  - `__CF_USER_TEXT_ENCODING`\r\n  - `ITERM_SESSION_ID`\r\n  - `SHLVL`\r\n  - `OLDPWD`\r\n  - `HOMEBREW_PREFIX`\r\n  - `HOMEBREW_CELLAR`\r\n  - `HOMEBREW_REPOSITORY`\r\n  - `MANPATH`\r\n  - `INFOPATH`\r\n  - `RIPGREP_CONFIG_PATH`\r\n  - `ZSH`\r\n  - `PAGER`\r\n  - `LESS`\r\n  - `LSCOLORS`\r\n  - `VIRTUALENVWRAPPER_PROJECT_FILENAME`\r\n  - `VIRTUALENVWRAPPER_WORKON_CD`\r\n  - `VIRTUALENVWRAPPER_SCRIPT`\r\n  - `WORKON_HOME`\r\n  - `VIRTUALENVWRAPPER_HOOK_DIR`\r\n  - `OPAM_SWITCH_PREFIX`\r\n  - `CAML_LD_LIBRARY_PATH`\r\n  - `OCAML_TOPLEVEL_PATH`\r\n  - `PIP_DISABLE_PIP_VERSION_CHECK`\r\n  - `PIP_PYTHON_PATH`\r\n  - `PYTHONDONTWRITEBYTECODE`\r\n  - `PIPENV_ACTIVE`\r\n  - `VIRTUAL_ENV`\r\n  - `PS1`\r\n  - `_`\r\n  - `PIP_SHIMS_BASE_MODULE`\r\n  - `PYTHONFINDER_IGNORE_UNSUPPORTED`\r\n\r\nPipenv\u2013specific environment variables:\r\n\r\n - `PIPENV_ACTIVE`: `1`\r\n\r\nDebug\u2013specific environment variables:\r\n\r\n  - `PATH`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU/bin:/Users/duckki/.opam/default/bin:/Users/duckki/.poetry/bin:/Users/duckki/.poetry/bin:/Users/duckki/local/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/opt/python@3.9/libexec/bin:/Users/duckki/.opam/default/bin:/Users/duckki/.poetry/bin:/Users/duckki/.poetry/bin:/Users/duckki/local/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/opt/python@3.9/libexec/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/X11/bin:/Users/duckki/.foundry/bin:/Users/duckki/.foundry/bin`\r\n  - `SHELL`: `/bin/zsh`\r\n  - `LANG`: `en_US.UTF-8`\r\n  - `PWD`: `/Users/duckki/work/slither-task`\r\n  - `VIRTUAL_ENV`: `/Users/duckki/.virtualenvs/slither-task-6QVhErCU`\r\n\r\n\r\n---------------------------\r\n\r\nContents of `Pipfile` ('/Users/duckki/work/slither-task/Pipfile'):\r\n\r\n```toml\r\n[[source]]\r\nurl = \"https://pypi.org/simple\"\r\nverify_ssl = true\r\nname = \"pypi\"\r\n\r\n[packages]\r\ntoml = \"*\"\r\nsemver = \"*\"\r\nsolc-select = \"*\"\r\nurllib3 = \"*\"\r\nantlr4-python3-runtime = \"==4.9\"\r\nslither-analyzer = {editable = true, path = \"./utilities/slither\"}\r\ncertik-slither-plugin = {editable = true, path = \"./slither-plugin\"}\r\n\r\n[dev-packages]\r\n\r\n[requires]\r\npython_version = \"3.9\"\r\n\r\n```\r\n\r\n\r\n</details>\r\n\n", "hints_text": "Is this different from what you can do with `` --extra-pip-args=\"\"`?\nThanks for suggestion. I didn't know `--extra-pip-args`.\r\n\r\nI updated pipenv to version `2023.6.12` and ran\r\n`pipenv install --editable . --extra-pip-args=\"--config-settings editable_mode=strict\"`\r\n\r\nIt finished without an error. However, the \"editable_mode=strict\" was not effective. The result was the same as installing without the `--config-settings` option. Also, the Pipfile didn't change, either.\nI think this has to do with parsing of `extra-pip-args` if I'm remembering correctly. While spaces can be used in Python between an optional command-line argument and its value, in order to properly parse multiple `extra-pip-args`, you need to make sure there's an equal sign between the argument and its value, e.g. `--extra-pip-args=\"--pip-arg=value\"`. In your case, you may need to add an extra set of escaped quotation marks to ensure the argument is parsed properly. Let me know if this works for you, and I'll re-familiarize myself with this part of the codebase.\nI tried: `pipenv install --editable <path> --extra-pip-args=\"--config-settings=editable_mode=strict\"`\r\nIt finished to completion. But, `editable_mode=strict` wasn't effective. Also, the Pipfile didn't change, either.\nBecause of the complicated syntax, this may be something that has to be updated via environment variable instead. @matteius any ideas?\nIt needs to be supported at the `Pipfile` as a new dictionary key for specifying additional pip install args -- it will get complicated determining if the install arg needs to be done in its own install phase or if it can be provided at the per requirement level in the existing install phases.\nFYI, installing a python package using `--config-settings editable_mode=compat` or `--config-settings editable_mode=strict` is a workaround for fixing unresolved reference issues for editable packages when using Pycharm. See [this comment](https://youtrack.jetbrains.com/issue/PY-976/Unresolved-references-to-editable-packages-pip-install-e-after-installing-before-restart-due-to-.egg-link-and-new-entries-in#focus=Comments-27-7867417.0-0) on [PY-976](https://youtrack.jetbrains.com/issue/PY-976/Unresolved-references-to-editable-packages-pip-install-e-after-installing-before-restart-due-to-.egg-link-and-new-entries-in) for more information.\ndid anyone work out a solution for this? It appears to be an unresolved issue 1.5 years later still", "created_at": "2026-09-07T06:36:52Z"}
{"repo": "pypa/pipenv", "pull_number": 6713, "instance_id": "pypa__pipenv-6713", "issue_numbers": ["6711", "6704", "6712"], "base_commit": "63b5abf1cbd776cbc3e84563741edcb9fd2a42d2", "patch": "diff --git a/news/6704.bugfix.rst b/news/6704.bugfix.rst\nnew file mode 100644\nindex 0000000000..b13c3470ce\n--- /dev/null\n+++ b/news/6704.bugfix.rst\n@@ -0,0 +1,1 @@\n+Python-version mismatch warnings now recommend ``pipenv remove`` instead of the deprecated ``pipenv --rm`` flag.\ndiff --git a/news/6711.bugfix.rst b/news/6711.bugfix.rst\nnew file mode 100644\nindex 0000000000..fb7c8b9c1d\n--- /dev/null\n+++ b/news/6711.bugfix.rst\n@@ -0,0 +1,1 @@\n+Hash-lookup sessions now use pip's combined certificate trust configuration, so custom CA bundles do not discard the public roots trusted by pip.\ndiff --git a/news/6712.bugfix.rst b/news/6712.bugfix.rst\nnew file mode 100644\nindex 0000000000..3a3b256866\n--- /dev/null\n+++ b/news/6712.bugfix.rst\n@@ -0,0 +1,1 @@\n+PyPI hash collection now handles requests and pip network exceptions and falls back to the resolver's other hash sources.\ndiff --git a/pipenv/utils/internet.py b/pipenv/utils/internet.py\nindex ef93a078b5..8364b20a61 100644\n--- a/pipenv/utils/internet.py\n+++ b/pipenv/utils/internet.py\n@@ -4,6 +4,9 @@\n from typing import Optional, Tuple\n from urllib.parse import unquote, urlparse, urlunsplit\n \n+from pipenv.patched.pip._internal.cli.index_command import (\n+    _create_truststore_ssl_context,\n+)\n from pipenv.patched.pip._internal.locations import USER_CACHE_DIR\n from pipenv.patched.pip._internal.network.download import PipSession\n from pipenv.patched.pip._vendor.urllib3 import util as urllib3_util\n@@ -16,7 +19,10 @@ def get_requests_session(\n     pip_client_cert = os.environ.get(\"PIP_CLIENT_CERT\")\n     index_urls = [source] if source else None\n     requests_session = PipSession(\n-        cache=cache_dir, retries=max_retries, index_urls=index_urls\n+        cache=cache_dir,\n+        retries=max_retries,\n+        index_urls=index_urls,\n+        ssl_context=_create_truststore_ssl_context(),\n     )\n     if pip_client_cert:\n         requests_session.cert = pip_client_cert\ndiff --git a/pipenv/utils/project.py b/pipenv/utils/project.py\nindex 670e290366..c3179f4c5f 100644\n--- a/pipenv/utils/project.py\n+++ b/pipenv/utils/project.py\n@@ -165,7 +165,7 @@ def ensure_project(\n             )\n             if not (system or project.s.PIPENV_USE_SYSTEM):\n                 err.print(\n-                    \"[green]$ pipenv --rm[/green] and rebuilding the virtual environment \"\n+                    \"[green]$ pipenv remove[/green] and rebuilding the virtual environment \"\n                     \"may resolve the issue.\"\n                 )\n             if not deploy:\ndiff --git a/pipenv/utils/sources.py b/pipenv/utils/sources.py\nindex ac4521769a..56f0240118 100644\n--- a/pipenv/utils/sources.py\n+++ b/pipenv/utils/sources.py\n@@ -28,8 +28,10 @@\n from urllib import parse\n from urllib.parse import urljoin\n \n+from pipenv.patched.pip._internal.exceptions import PipError\n from pipenv.patched.pip._internal.models.link import Link\n from pipenv.patched.pip._internal.utils.hashes import FAVORITE_HASH\n+from pipenv.patched.pip._vendor.requests.exceptions import RequestException\n from pipenv.utils import err\n from pipenv.utils.dependencies import clean_pkg_version, pep423_name\n from pipenv.utils.fileutils import open_file\n@@ -133,7 +135,7 @@ def get_hashes_from_pypi(self, ireq, source):\n             for release in cleaned_releases[version]:\n                 collected_hashes.add(release[\"digests\"][FAVORITE_HASH])\n             return self._prepend_hash_types(collected_hashes, FAVORITE_HASH)\n-        except (ValueError, KeyError, ConnectionError):\n+        except (ValueError, KeyError, RequestException, PipError):\n             return None\n \n     def get_hashes_from_remote_index_urls(self, ireq, source):\n", "test_patch": "diff --git a/tests/unit/test_sources.py b/tests/unit/test_sources.py\nindex 203ff20ccb..9799f1c934 100644\n--- a/tests/unit/test_sources.py\n+++ b/tests/unit/test_sources.py\n@@ -10,8 +10,12 @@\n \n from __future__ import annotations\n \n+from unittest import mock\n+\n import pytest\n \n+from pipenv.patched.pip._internal.exceptions import PipError\n+from pipenv.patched.pip._vendor.requests.exceptions import RequestException\n from pipenv.project import Project\n from pipenv.utils.sources import SourceNotFound, Sources\n \n@@ -77,6 +81,31 @@ def test_project_sources_returns_sources_subsystem(project_single):\n     assert project_single.sources is project_single.sources\n \n \n+@pytest.mark.utils\n+@pytest.mark.parametrize(\n+    \"network_error\",\n+    [RequestException(\"requests failure\"), PipError(\"pip network failure\")],\n+)\n+def test_get_hashes_from_pypi_handles_network_errors(project_single, network_error):\n+    \"\"\"PyPI API failures fall through to the resolver's other hash sources.\"\"\"\n+    session = mock.Mock()\n+    session.get.side_effect = network_error\n+    requirement = mock.Mock()\n+    requirement.name = \"example\"\n+    requirement.specifier = None\n+\n+    with mock.patch.object(\n+        project_single.sources,\n+        \"get_requests_session_for_source\",\n+        return_value=session,\n+    ):\n+        result = project_single.sources.get_hashes_from_pypi(\n+            requirement, project_single.sources.default\n+        )\n+\n+    assert result is None\n+\n+\n @pytest.mark.utils\n def test_sources_all_returns_list_of_dicts(project_single):\n     \"\"\"``project.sources.all`` exposes the source list (formerly the\ndiff --git a/tests/unit/test_utils.py b/tests/unit/test_utils.py\nindex 00e48662e7..04553ca0b6 100644\n--- a/tests/unit/test_utils.py\n+++ b/tests/unit/test_utils.py\n@@ -324,6 +324,30 @@ def test_is_valid_url(self):\n         assert internet.is_valid_url(url)\n         assert internet.is_valid_url(not_url) is False\n \n+    @pytest.mark.utils\n+    def test_get_requests_session_uses_pip_truststore_context(self, monkeypatch):\n+        ssl_context = object()\n+        session = mock.MagicMock()\n+        pip_session = mock.Mock(return_value=session)\n+        monkeypatch.setattr(internet, \"PipSession\", pip_session)\n+        monkeypatch.setattr(\n+            internet, \"_create_truststore_ssl_context\", lambda: ssl_context\n+        )\n+\n+        result = internet.get_requests_session(\n+            max_retries=2,\n+            cache_dir=\"cache-dir\",\n+            source=\"https://example.org/simple\",\n+        )\n+\n+        assert result is session\n+        pip_session.assert_called_once_with(\n+            cache=\"cache-dir\",\n+            retries=2,\n+            index_urls=[\"https://example.org/simple\"],\n+            ssl_context=ssl_context,\n+        )\n+\n     @pytest.mark.utils\n     def test_download_file(self, tmp_path):\n         url = \"https://example.com/test.md\"\n@@ -987,6 +1011,30 @@ def test_no_python_arg_skips_version_check(self, monkeypatch):\n             \"ensure_virtualenv should not be called when no --python is given and venv exists\"\n         )\n \n+    @pytest.mark.utils\n+    def test_version_warning_recommends_current_remove_command(self, monkeypatch):\n+        project = self._make_project(monkeypatch)\n+        project.required_python_version = \"3.12\"\n+        project.venv_locator._which.return_value = \"/fake/venv/bin/python\"\n+\n+        monkeypatch.setattr(\n+            \"pipenv.utils.project.python_version\",\n+            lambda path: \"3.11.9\",\n+        )\n+        monkeypatch.setattr(\n+            \"pipenv.utils.project.ensure_pipfile\",\n+            lambda *a, **kw: None,\n+        )\n+\n+        from pipenv.utils.project import ensure_project\n+\n+        with mock.patch(\"pipenv.utils.project.err.print\") as err_print:\n+            ensure_project(project, python=None, system=False)\n+\n+        output = \"\\n\".join(call.args[0] for call in err_print.call_args_list)\n+        assert \"$ pipenv remove\" in output\n+        assert \"$ pipenv --rm\" not in output\n+\n \n class TestPythonVersionMatchesRequired:\n     \"\"\"Tests for _python_version_matches_required.\n", "problem_statement": "`pipenv lock` fails with `SSLCertVerificationError` under `REQUESTS_CA_BUNDLE`\n\n### Issue description\n\nOur environment sits behind a TLS-inspecting proxy that re-signs outbound HTTPS traffic. We trust its certificate by setting the `REQUESTS_CA_BUNDLE` environment variable to a file containing that proxy's CA certificate.\n\nRunning `pipenv lock` fails while creating `Pipfile.lock`, with an `SSLCertVerificationError: [SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate` error. Running the same command with `--skip-lock` succeeds.\n\n`pip` is configured the same way (same `REQUESTS_CA_BUNDLE` value) and installs packages without any error.\n\n### Expected result\n\n`pipenv lock` should succeed under our `REQUESTS_CA_BUNDLE` configuration.\n\n### Actual result\n\n`pipenv lock` fails with `SSLCertVerificationError: [SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate`, ending with `Locking Failed!`.\n\n<details><summary>Verbose output / traceback (<code>pipenv lock -v</code>)</summary>\n\n````\nPS C:\\temp\\pipenv-repro> C:\\temp\\pipenv-repro\\.venv\\Scripts\\pipenv.exe --support\n<details><summary>$ pipenv --support</summary>\n\nPipenv version: `'2026.7.1'`\n\nPipenv location: `'C:\\\\temp\\\\pipenv-repro\\\\.venv\\\\lib\\\\site-packages\\\\pipenv'`\n\nPython location: `'C:\\\\temp\\\\pipenv-repro\\\\.venv\\\\Scripts\\\\python.exe'`\n\nOS Name: `'nt'`\n\nUser pip version: `'26.1.2'`\n\nuser Python installations found:\n\n  - `3.12.0`: `C:\\Users\\tnemh\\AppData\\Local\\Programs\\Python\\Python312\\python.exe`\n  - `3.11.9`: `C:\\Users\\tnemh\\AppData\\Local\\Programs\\Python\\Python311\\python.exe`\n  - `3.10.11`: `C:\\Users\\tnemh\\AppData\\Local\\Programs\\Python\\Python310\\python.exe`\n\nPEP 508 Information:\n\n```\n{'implementation_name': 'cpython',\n 'implementation_version': '3.10.11',\n 'os_name': 'nt',\n 'platform_machine': 'AMD64',\n 'platform_python_implementation': 'CPython',\n 'platform_release': '10',\n 'platform_system': 'Windows',\n 'platform_version': '10.0.26200',\n 'python_full_version': '3.10.11',\n 'python_version': '3.10',\n 'sys_platform': 'win32'}\n```\n\n(omitted: contains personal information)\n\n---------------------------\n\nContents of `Pipfile` ('C:\\\\temp\\\\pipenv-repro\\\\Pipfile'):\n\n```toml\n[[source]]\nurl = \"https://pypi.org/simple\"\nverify_ssl = true\nname = \"pypi\"\n\n[packages]\nrequests = \"*\"\n\n[requires]\npython_version = \"3.12\"\n\n```\n</details>\nPS C:\\temp\\pipenv-repro>\nPS C:\\temp\\pipenv-repro>\nPS C:\\temp\\pipenv-repro> C:\\temp\\pipenv-repro\\.venv\\Scripts\\pipenv.exe lock -v\nWarning: Your Pipfile requires \"python_version\" 3.12, but you are using 3.10.11 from C:\\temp\\p\\.venv\\S\\python.exe.\n$ pipenv --rm and rebuilding the virtual environment may resolve the issue.\n$ pipenv check will surely fail.\nLocking  dependencies...\nBuilding requirements...\nResolving dependencies...\n[==  ] Locking packages...\n--- resolver log ---\n[INFO] Reporter.starting()\n[INFO] Reporter.adding_requirement(SpecifierRequirement('requests'), None)\n[INFO] Collecting requests (from -r\nC:\\Users\\tnemh\\AppData\\Local\\Temp\\pipenv-qm9md4d5-requirements\\pipenv-mknwme55-constraints.txt (line 2))\n[INFO] Downloading requests-2.34.2-py3-none-any.whl.metadata (4.8 kB)\n[INFO] Reporter.starting_round(0)\n[INFO] Reporter.adding_requirement(RequiresPythonRequirement('>=3.10'),\nLinkCandidate('https://files.pythonhosted.org/packages/a0/f4/c67b0b3f1b9245e8d266f0f112c500d50e5b4e83cb6f3b71b6528104182\na/requests-2.34.2-py3-none-any.whl (from https://pypi.org/simple/requests/) (requires-python:>=3.10)'))\n[INFO] Reporter.adding_requirement(SpecifierRequirement(